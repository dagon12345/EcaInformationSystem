<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- Forward all requests to the ASP.NET Core app via the AspNetCore module -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\EcaInformationSystem.API.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Do NOT add IIS-level CORS headers here.
        The ASP.NET Core CORS middleware (UseCors) handles all CORS responses,
        including OPTIONS preflight. IIS-level headers would duplicate or
        conflict with the middleware-generated headers.
      -->

    </system.webServer>
  </location>
</configuration>
