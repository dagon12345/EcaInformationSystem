<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- Forward all requests to the ASP.NET Core app via the AspNetCore module -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>

      <!--
        startupTimeLimit: seconds IIS waits for the process to respond before
        killing it. Default is 120 s. EF Core migrations can take a few seconds
        on first run; set to 300 s as a safe margin. Geography seeding no longer
        runs during startup (it is a BackgroundService) so this only needs to
        cover the time for app init + migrations.

        stdoutLogEnabled: set to true temporarily to capture startup errors in
        .\logs\stdout_*.log. Turn off again once the app is stable.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\EcaInformationSystem.API.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess"
                  startupTimeLimit="300">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Do NOT add IIS-level CORS headers here.
        The ASP.NET Core CORS middleware (UseCors) handles all CORS responses,
        including OPTIONS preflight. IIS-level headers would duplicate or
        conflict with the middleware-generated headers.
      -->

    </system.webServer>
  </location>
</configuration>
