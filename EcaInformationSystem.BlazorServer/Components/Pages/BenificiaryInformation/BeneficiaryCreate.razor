    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;
        successMessage = null;
        importResult = null;

        excelSheetNames.Clear();
        selectedSheetName = null;
        uploadedExcelBytes = null;
        uploadedExcelFileName = null;

        if (selectedFile == null)
            return;

        try
        {
            isLoadingSheets = true;

            await using var uploadStream = selectedFile.OpenReadStream(10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await uploadStream.CopyToAsync(memoryStream);

            uploadedExcelBytes = memoryStream.ToArray();
            uploadedExcelFileName = selectedFile.Name;

            using var readSheetStream = new MemoryStream(uploadedExcelBytes);
            excelSheetNames = await BeneficiaryInformationService.GetExcelSheetNamesAsync(
                readSheetStream,
                uploadedExcelFileName);

            if (excelSheetNames.Any())
            {
                selectedSheetName = excelSheetNames.First();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to read Excel sheets: {ex.Message}";
            ShowErrorToast(errorMessage);
        }
        finally
        {
            isLoadingSheets = false;
            StateHasChanged();
        }
    }

    private async Task UpdateExcelAsync()
    {
        if (uploadedExcelBytes == null || string.IsNullOrWhiteSpace(selectedSheetName))
            return;

        isUpdating = true;
        importResult = null;

        try
        {
            using var stream = new MemoryStream(uploadedExcelBytes);
            var userName = await GetCurrentUserNameAsync();
            importResult = await BeneficiaryInformationService.UpdateExcelAsync(
                stream,
                uploadedExcelFileName!,
                selectedSheetName,
                userName
            );
        }
        catch (Exception ex)
        {
            importResult = new BeneficiaryImportResultDto
            {
                TotalRows = 0,
                ImportedCount = 0,
                ErrorCount = 1,
                Errors = new List<BeneficiaryImportErrorDto>
            {
                new BeneficiaryImportErrorDto
                {
                    RowNumber = 0,
                    Field = "System",
                    Message = ex.Message,
                    RawValue = null
                }
            }
            };
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    private async Task UploadExcelAsync()
    {
        errorMessage = null;
        successMessage = null;
        importResult = null;

        if (uploadedExcelBytes == null || string.IsNullOrWhiteSpace(uploadedExcelFileName))
        {
            errorMessage = "Please select an Excel file first.";
            ShowErrorToast(errorMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedSheetName))
        {
            errorMessage = "Please select a worksheet first.";
            ShowErrorToast(errorMessage);
            return;
        }

        try
        {
            isUploading = true;

            var userName = await GetCurrentUserNameAsync();

            using var memoryStream = new MemoryStream(uploadedExcelBytes);

            importResult = await BeneficiaryInformationService.ImportExcelAsync(
                memoryStream,
                uploadedExcelFileName,
                selectedSheetName,
                userName);

            if (importResult.HasErrors)
            {
                ShowErrorToast($"Import validation failed. Found {importResult.ErrorCount} error(s). No records were saved.");
                errorMessage = $"Import validation failed. Found {importResult.ErrorCount} error(s). Please fix the Excel file and upload again.";
                return;
            }

            ShowSuccessToast($"Import completed successfully from worksheet '{selectedSheetName}'. {importResult.ImportedCount} record(s) saved.");
            successMessage = $"Import completed successfully from worksheet '{selectedSheetName}'. {importResult.ImportedCount} record(s) saved.";
        }
        catch (Exception ex)
        {
            ShowErrorToast($"Import failed: {ex.Message}");
            errorMessage = $"Import failed: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }


