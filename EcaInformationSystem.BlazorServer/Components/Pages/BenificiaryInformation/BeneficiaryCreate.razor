@page "/beneficiary-create"
@rendermode InteractiveServer
@inject IJSRuntime JS
@using System.Net.Http.Json
@using EcaInformationSystem.Application.DTOs
@inject HttpClient Http

<PageTitle>Beneficiary Information</PageTitle>
<div class="container-fluid py-4">
    @if(!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="ClearMessages"></button>
        </div>
    }
    @if(!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="ClearMessages"></button>
        </div>
    }
    
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">Beneficiary Information Entry</h4>
                            <small class="opacity-75">Create a new beneficiary record</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <EditForm Model="@model" OnValidSubmit="@OpenSaveConfirmationModal">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />
                        <!-- Identity Information -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Identity Information</h5>
                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Batch Code</label>
                                    <InputText class="form-control" @bind-Value="model.BatchCode" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">OSCA ID Number</label>
                                    <InputText class="form-control" @bind-Value="model.OscaIdNumber" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">NCSC RRN</label>
                                    <InputNumber class="form-control" @bind-Value="model.NcscRrn" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Last Name</label>
                                    <InputText class="form-control" @bind-Value="model.LastName" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">First Name <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="model.FirstName" />
                                    <ValidationMessage For="@(() => model.FirstName)" class="text-danger small" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Middle Name</label>
                                    <InputText class="form-control" @bind-Value="model.MiddleName" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Extension</label>
                                    <InputText class="form-control" @bind-Value="model.Extension" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Birth Date <span class="text-danger">*</span></label>
                                    <InputDate class="form-control" @bind-Value="model.BirthDate" />
                                    <ValidationMessage For="@(() => model.BirthDate)" class="text-danger small" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Age</label>
                                   <input class="form-control" value="@(GetAge(model.BirthDate)?.ToString() ?? "")" readonly />
                                </div>

                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Sex</label>
                                    <InputSelect class="form-select" @bind-Value="model.Sex">
                                        <option value="0">Select Sex</option>
                                        <option value="1">Male</option>
                                        <option value="2">Female</option>
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                        <!-- Demographic Information -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Demographic Information</h5>
                            <div class="row g-3">
                        
                                <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.IsIndigenousPeople"/>
                                        <label class="form-check-label">Indigenous People</label>
                                    </div>
                                </div>
                        
                                <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.IsPersonWithDisability" />
                                        <label class="form-check-label">Person with Disability</label>
                                    </div>
                                </div>
                        
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Civil Status</label>
                                    <InputSelect class="form-select" @bind-Value="model.CivilStatus">
                                        <option value="0">Select Civil Status</option>
                                        <option value="1">Single</option>
                                        <option value="2">Widowed</option>
                                        <option value="3">Married</option>
                                        <option value="4">Live in</option>
                                    </InputSelect>
                                </div>
                        
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Citizenship</label>
                                    <InputSelect class="form-select" @bind-Value="model.Citizenship">
                                        <option value="0">Select Citizenship</option>
                                        <option value="1">Filipino</option>
                                        <option value="2">Dual Citizenship</option>
                                    </InputSelect>
                                </div>
                        
                            </div>
                        </div>

                        <!-- Address Information -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Address Information</h5>
                            <div class="row g-3">

                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Region</label>
                                    <select class="form-select" value="@model.PsgcCodeRegion" @onchange="OnRegionChanged">
                                        <option value="0">Select Region</option>
                                        @foreach (var region in regions)
                                        {
                                            <option value="@region.PsgcCodeRegion">@region.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Province</label>
                                    <select class="form-select" value="@model.PsgcCodeProvince" @onchange="OnProvinceChanged" disabled="@(model.PsgcCodeRegion == 0)">
                                        <option value="0">Select Province</option>
                                        @foreach (var province in provinces)
                                        {
                                            <option value="@province.PsgcCodeProvince">@province.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Municipality</label>
                                    <select class="form-select" value="@model.PsgcCodeMunicipality" @onchange="OnMunicipalityChanged" disabled="@(model.PsgcCodeProvince == 0)">
                                        <option value="0">Select Municipality</option>
                                        @foreach (var municipality in municipalities)
                                        {
                                            <option value="@municipality.PsgcCodeMunicipality">@municipality.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Barangay</label>
                                    <select class="form-select" value="@model.PsgcCodeBarangay" @onchange="OnBarangayChanged" disabled="@(model.PsgcCodeMunicipality == 0)">
                                        <option value="0">Select Barangay</option>
                                        @foreach (var barangay in barangays)
                                        {
                                            <option value="@barangay.PsgcCodeBarangay">@barangay.Name</option>
                                        }
                                    </select>
                                </div>

                            </div>
                        </div>
                        <!-- Validation Information -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Validation Information</h5>
                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Validator <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="model.Validator" />
                                    <ValidationMessage For="@(() => model.Validator)" class="text-danger small" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Validation Date <span class="text-danger">*</span></label>
                                    <InputDate class="form-control" @bind-Value="model.ValidationDate" />
                                    <ValidationMessage For="@(() => model.ValidationDate)" class="text-danger small" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4 d-flex align-items-end">
                                    <div class="form-check mt-4">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.isCompliant" />
                                        <label class="form-check-label">Is Compliant</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Payment Information -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Payment Information</h5>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Payment Status <span class="text-danger">*</span></label>
                                    <InputSelect class="form-select" @bind-Value="model.PaymentStatus">
                                        <option value="0">Select Payment Status</option>
                                        <option value="1">Unpaid</option>
                                        <option value="2">Paid</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => model.PaymentStatus)" class="text-danger small" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Payment Date</label>
                                    <InputDate class="form-control" @bind-Value="model.PaymentDate" disabled="@(model.PaymentStatus != 2)" />
                                </div>
                            </div>
                        </div>
                       <!-- Status & Remarks -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Status & Remarks</h5>
                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.isDeceased" />
                                        <label class="form-check-label">Is Deceased</label>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Date of Death</label>
                                    <InputDate class="form-control" @bind-Value="model.DateOfDeath" disabled="@(!model.isDeceased)" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.isEligible" />
                                        <label class="form-check-label">Is Eligible</label>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Remark Category</label>
                                    <InputSelect class="form-select" @bind-Value="model.RemarkCategory">
                                        <option value="0">Select Remark</option>
                                        <option value="1">Deceased prior reaching milestone age</option>
                                        <option value="2">Out of town/Country</option>
                                        <option value="3">Incomplete required documents</option>
                                        <option value="4">Inconsistent documents</option>
                                    </InputSelect>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Remarks</label>
                                    <InputTextArea class="form-control" @bind-Value="model.Remarks" rows="3" />
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-2">
                            @if(isEditMode)
                            {
                                <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@isSaving">
                                    Cancel Edit
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm" disabled="@isSaving">
                                    Clear
                                </button>
                            }
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if(isSaving)
                                {
                                    <span class="spinner-border spinner-boder-sm me-2"></span>
                                    <span>@(isEditMode ? "Updating...": "Saving...")</span>
                                }
                                else
                                {
                                    <span>@(isEditMode ? "Update Beneficiary": "Add Beneficiary")</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Card Filtering-->
    <div class="row mb-4">
        <div class="col-12">
            <Card Class="shadow-sm border-0">
                <CardHeader Class="bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Filter Beneficiaries</h5>
                            <small class="text-muted">Search and narrow down beneficiary records</small>
                        </div>
                        <div class="d-flex gap-2">
                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="ClearFilterAsync">
                                Clear Filters
                            </Button>
                            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="ApplyFiltersAsync">
                                Apply Filters
                            </Button>
                        </div>
                    </div>
                </CardHeader>

                <CardBody>
                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">Region</label>
                            <select class="form-select" value="@filterModel.PsgcCodeRegion" @onchange="OnFilterRegionChanged">
                                <option value="0">Select Region</option>
                                @foreach (var region in regions)
                                {
                                    <option value="@region.PsgcCodeRegion">@region.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">Province</label>
                            <select class="form-select" value="@filterModel.PsgcCodeProvince" @onchange="OnFilterProvinceChanged" disabled="@(filterModel.PsgcCodeRegion == 0)">
                                <option value="0">Select Province</option>
                                @foreach (var province in filterProvinces)
                                {
                                    <option value="@province.PsgcCodeProvince">@province.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">Municipality</label>
                            <select class="form-select" value="@filterModel.PsgcCodeMunicipality" @onchange="OnFilterMunicipalityChanged" disabled="@(filterModel.PsgcCodeProvince == 0)">
                                <option value="0">Select Municipality</option>
                                @foreach (var municipality in filterMunicipalities)
                                {
                                    <option value="@municipality.PsgcCodeMunicipality">@municipality.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">Barangay</label>
                            <select class="form-select" value="@filterModel.PsgcCodeBarangay" @onchange="OnFilterBarangayChanged" disabled="@(filterModel.PsgcCodeMunicipality == 0)">
                                <option value="0">Select Barangay</option>
                                @foreach (var barangay in filterBarangays)
                                {
                                    <option value="@barangay.PsgcCodeBarangay">@barangay.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">Last Name</label>
                            <input type="text" class="form-control" placeholder="Enter last name" @bind="filterModel.LastName"/>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">First Name</label>
                            <input type="text" class="form-control" placeholder="Enter first name" @bind="filterModel.FirstName"/>
                        </div>

                        <div class="col-12 col-md-6 col-lg-2">
                            <label class="form-label">Specific Age</label>
                            <input type="number" class="form-control" placeholder="e.g. 80" @bind="filterModel.SpecificAge" />
                        </div>

                        <div class="col-12 col-md-6 col-lg-2">
                            <label class="form-label">Age From</label>
                            <input type="number" class="form-control" placeholder="Min age" @bind="filterModel.AgeFrom" />
                        </div>

                        <div class="col-12 col-md-6 col-lg-2">
                            <label class="form-label">Age To</label>
                            <input type="number" class="form-control" placeholder="Max age" @bind="filterModel.AgeTo" />
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">Sex</label>
                            <select class="form-select" @bind="filterModel.Sex">
                                <option value="0">Select Sex</option>
                                <option value="1">Male</option>
                                <option value="2">Female</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">Specific Birthday</label>
                            <input type="date" class="form-control" @bind="filterModel.SpecificBirthday" />
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">Birthday From</label>
                            <input type="date" class="form-control" @bind="filterModel.BirthdayFrom" />
                        </div>

                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label">Birthday To</label>
                            <input type="date" class="form-control" @bind="filterModel.BirthdayTo" />
                        </div>

                    </div>
                </CardBody>
            </Card>
        </div>
    </div>


    <!-- List/Grid Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Beneficiary List</h5>
                        <span class="badge bg-primary">@beneficiaries.Count Record(s)</span>
                        <button class="btn btn-sm btn-outline-primary" @onclick="LoadBeneficiariesAsync">
                            Refresh
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if(isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 mb-0">Loading beneficiaries...</p>
                        </div>   
                    }
                    else if(!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">
                            @errorMessage
                        </div>
                    }
                    else if (!beneficiaries.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="mb-0">No beneficiary record found.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Batch Code</th>
                                        <th>OSCA ID</th>
                                        <th>Full Name</th>
                                        <th>Birth Date</th>
                                        <th>Age</th>
                                        <th>Sex</th>
                                        <th>Municipality</th>
                                        <th>Barangay</th>
                                        <th>Validator</th>
                                        <th>Payment Status</th>
                                        <th>Eligible</th>
                                        <th>Compliant</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in beneficiaries)
                                    {
                                        <tr>
                                            <td>@item.BatchCode</td>
                                            <td>@item.OscaIdNumber</td>
                                            <td>@GetFullName(item)</td>
                                            <td>@item.BirthDate.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <span class="badge @GetAgeBadgeClass(item.BirthDate)">
                                                    @item.Age
                                                </span>
                                            </td>

                                            <td>@GetSexText(item.Sex)</td>
                                            <td>@item.Municipality</td>
                                            <td>@item.Barangay</td>
                                            <td>@item.Validator</td>
                                            <td>
                                                <span class="badge @GetPaymentBadgeClass(item.PaymentStatus)">
                                                    @GetPaymentStatusText(item.PaymentStatus)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(item.isEligible ? "bg-success" : "bg-secondary")">
                                                    @(item.isEligible ? "Yes" : "No")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(item.isCompliant ? "bg-info" : "bg-warning text-dark")">
                                                    @(item.isCompliant ? "Yes" : "No")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="async () => await EditItem(item)">
                                                        Edit
                                                    </button>

                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteConfirmationModal(item)">
                                                        Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<Modal @ref="confirmModal">
    <HeaderTemplate>
        <h5 class="modal-title">@confirmationTitle</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-0">@confirmationMessage</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="CloseConfirmationModal">
            Cancel
        </Button>
        <Button Type="ButtonType.Button" Color="ButtonColor.Primary" @onclick="ConfirmActionAsync" Disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Yes, Confirm</span>
            }
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private BeneficiaryInformationDto model = new()
    {
        BirthDate = DateTime.Today,
        ValidationDate = DateTime.Today
    };
    private Modal confirmModal = default!;
    private string confirmationTitle = "Confirm Action";
    private string confirmationMessage = string.Empty;
    private string pendingAction = string.Empty; //"add", "edit", "delete"
    private BeneficiaryInformationDto? selectedDeleteItem;
    private List<BeneficiaryInformationDto> beneficiaries = new();
    private BeneficiaryFilterDto filterModel = new();
    private bool isLoading;
    private bool isSaving;
    private bool isEditMode;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegionsAsync();
        await LoadBeneficiariesAsync();
    }

    public class RegionLookupDto
    {
        public int PsgcCodeRegion { get; set; }
        public string Name { get; set; } = string.Empty;
    }
    public class ProvinceLookupDto
    {
        public int PsgcCodeRegion { get; set; }
        public int PsgcCodeProvince { get; set; }
        public string Name { get; set; } = string.Empty;
    }
    public class MunicipalityLookupDto
    {
        public int PsgcCodeProvince { get; set; }
        public int PsgcCodeMunicipality { get; set; }
        public string Name { get; set; } = string.Empty;
    }
    public class BarangayLookupDto
    {
        public int PsgcCodeMunicipality { get; set; }
        public int PsgcCodeBarangay { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private async Task LoadRegionsAsync()
    {
        try
        {
            regions = await Http.GetFromJsonAsync<List<RegionLookupDto>>("api/Region")
                      ?? new List<RegionLookupDto>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load regions. {ex.Message}";
        }
    }
    private async Task LoadProvincesAsync(int psgcCodeRegion)
    {
        provinces = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>($"api/Province/by-region/{psgcCodeRegion}")
                    ?? new List<ProvinceLookupDto>();
    }

    private async Task LoadMunicipalitiesAsync(int psgcCodeProvince)
    {
        municipalities = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>($"api/Municipality/by-province/{psgcCodeProvince}")
                         ?? new List<MunicipalityLookupDto>();
    }

    private async Task LoadBarangaysAsync(int psgcCodeMunicipality)
    {
