    private bool IsFilterEmpty(BeneficiaryFilterDto f)
    {
        return
            f.PsgcCodeProvince == null &&
            f.PsgcCodeMunicipality == null &&
            f.PsgcCodeBarangay == null &&

            string.IsNullOrWhiteSpace(f.LastName) &&
            string.IsNullOrWhiteSpace(f.FirstName) &&
            string.IsNullOrWhiteSpace(f.Validator) &&
            string.IsNullOrWhiteSpace(f.BatchCode) &&

            f.SpecificAge == null &&
            f.SpecificBirthday == null &&
            f.BirthdayFrom == null &&
            f.BirthdayTo == null &&
            f.MilestoneYear == null &&
            f.Sex == null &&
            f.PaymentStatuses == null &&

            (f.PsgcCodeProvinces == null || !f.PsgcCodeProvinces.Any()) &&
            (f.PsgcCodeMunicipalities == null || !f.PsgcCodeMunicipalities.Any()) &&
            (f.PsgcCodeBarangays == null || !f.PsgcCodeBarangays.Any()) &&
            (f.Sexes == null || !f.Sexes.Any()) &&           // ✅ separate condition
            (f.PaymentStatuses == null || !f.PaymentStatuses.Any()); // ✅ separate condition
    }

