    private string GetSexButtonText()
    {
        if (selectedSexes.Count == 0) return "Select Sex";
        if (selectedSexes.Count == 2) return "All Sexes";
        if (selectedSexes.Contains(1)) return "Male";
        if (selectedSexes.Contains(2)) return "Female";
        return "Select Sex";
    }
    private bool AreAllSexesSelected() =>
    selectedSexes.Contains(1) && selectedSexes.Contains(2);
