            await BeneficiaryInformationService.UpdateAsync(model.Id, model, userName);

            ShowSuccessToast($"Grantee '{model.FirstName} {model.LastName}' was updated successfully.");

            await LoadBeneficiariesAsync();
            ResetForm();

        }
        catch (Exception ex)
        {
            ShowErrorToast($"Failed to update Grantee record. {ex.Message}");

        }
    }

    //Soft delete - set isDeleted to true
    private async Task SoftDeleteBeneficiaryAsync()
    {
        if (selectedDeleteItem is null)
        {
            ShowErrorToast($"Failed to delete Grantee record. Item not found.");
            return;
        }

        try
        {
            var userName = await GetCurrentUserNameAsync();
            await BeneficiaryInformationService.SoftDeleteAsync(selectedDeleteItem.Id, userName);

            ShowSuccessToast($"Grantee '{selectedDeleteItem.FirstName} {selectedDeleteItem.LastName}' was deleted successfully.");
            await LoadBeneficiariesAsync();
            if (isEditMode && model.Id == selectedDeleteItem.Id)
            {
                ResetForm();
            }

        }
        catch (Exception ex)
        {
            ShowErrorToast($"Failed to delete Grantee record. {ex.Message}");
        }
    }

    private async Task ConfirmActionAsync()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;

            await confirmModal.HideAsync();

            if (string.IsNullOrWhiteSpace(pendingAction))
            {
                errorMessage = "No action selected.";
                return;
            }

            switch (pendingAction)
            {
                case "add":
                    await AddBeneficiaryAsync();
                    break;

                case "edit":
                    await UpdateBeneficiaryAsync();
                    break;

                case "delete":
                    await SoftDeleteBeneficiaryAsync();
                    break;

                default:
                    errorMessage = "Unknown action.";
                    break;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while processing. {ex.Message}";
        }
        finally
        {
            isSaving = false;
            pendingAction = string.Empty;
            selectedDeleteItem = null;
        }
    }

