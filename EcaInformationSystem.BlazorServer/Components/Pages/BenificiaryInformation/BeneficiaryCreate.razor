    private string GetFullName(BeneficiaryInformationDto item)
    {
        var middle = string.IsNullOrWhiteSpace(item.MiddleName) ? "" : $" {item.MiddleName}";
        var extension = string.IsNullOrWhiteSpace(item.Extension) ? "" : $" {item.Extension}";
        return $"{item.LastName}, {item.FirstName}{middle}{extension}";
    }
