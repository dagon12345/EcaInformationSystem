    private async Task ApplyFiltersAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var queryParams = new List<string>();

            if (filterModel.PsgcCodeRegion.HasValue && filterModel.PsgcCodeRegion > 0)
                queryParams.Add($"PsgcCodeRegion={filterModel.PsgcCodeRegion}");

            if (filterModel.PsgcCodeProvince.HasValue && filterModel.PsgcCodeProvince > 0)
                queryParams.Add($"PsgcCodeProvince={filterModel.PsgcCodeProvince}");

            if (filterModel.PsgcCodeMunicipality.HasValue && filterModel.PsgcCodeMunicipality > 0)
                queryParams.Add($"PsgcCodeMunicipality={filterModel.PsgcCodeMunicipality}");

            if (filterModel.PsgcCodeBarangay.HasValue && filterModel.PsgcCodeBarangay > 0)
                queryParams.Add($"PsgcCodeBarangay={filterModel.PsgcCodeBarangay}");

            if (!string.IsNullOrWhiteSpace(filterModel.LastName))
                queryParams.Add($"LastName={Uri.EscapeDataString(filterModel.LastName)}");

            if (!string.IsNullOrWhiteSpace(filterModel.FirstName))
                queryParams.Add($"FirstName={Uri.EscapeDataString(filterModel.FirstName)}");

            if (filterModel.SpecificAge.HasValue)
                queryParams.Add($"SpecificAge={filterModel.SpecificAge}");

            if (filterModel.AgeFrom.HasValue)
                queryParams.Add($"AgeFrom={filterModel.AgeFrom}");

            if (filterModel.AgeTo.HasValue)
                queryParams.Add($"AgeTo={filterModel.AgeTo}");

            if (filterModel.Sex.HasValue && filterModel.Sex > 0)
                queryParams.Add($"Sex={filterModel.Sex}");

            if (filterModel.SpecificBirthday.HasValue)
                queryParams.Add($"SpecificBirthday={filterModel.SpecificBirthday.Value:yyyy-MM-dd}");

            if (filterModel.BirthdayFrom.HasValue)
                queryParams.Add($"BirthdayFrom={filterModel.BirthdayFrom.Value:yyyy-MM-dd}");

            if (filterModel.BirthdayTo.HasValue)
                queryParams.Add($"BirthdayTo={filterModel.BirthdayTo.Value:yyyy-MM-dd}");

            var url = "api/BeneficiaryInformation/filter";

            if (queryParams.Any())
                url += "?" + string.Join("&", queryParams);

            beneficiaries = await Http.GetFromJsonAsync<List<BeneficiaryInformationDto>>(url)
                ?? new List<BeneficiaryInformationDto>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to filter beneficiary records. {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

