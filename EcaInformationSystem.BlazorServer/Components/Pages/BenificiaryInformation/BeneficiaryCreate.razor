@page "/beneficiary-create"

@attribute [Authorize]
@rendermode InteractiveServer

@using System.Net.Http.Json
@using EcaInformationSystem.Application.DTOs
@using EcaInformationSystem.Application.Interfaces
@using EcaInformationSystem.Application.Services
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims


@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IBeneficiaryInformationService BeneficiaryInformationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject ToastService ToastService


<PageTitle>Grantee Information</PageTitle>
<!--Toast Notification pop up-->
<Toasts class="p-3"
        AutoHide="true"
        Delay="6000"
        Placement="ToastsPlacement.TopRight" />
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">Grantee Information Entry</h4>
                            <small class="opacity-75">Create a new Grantee record</small>
                        </div>
                    </div>
                </div>
                <!-- Fill up fields -->
                <div class="card-body">
                    <EditForm Model="@model"  OnValidSubmit="@OpenSaveConfirmationModal" FormName="BeneficiaryCreateForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />
                        <!-- Identity Information -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Identity Information</h5>
                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Date Applied (Day/Month/Year)</label>
                                    <InputDate class="form-control" @bind-Value="model.DateApplied" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Date Endorsed (Day/Month/Year)</label>
                                    <InputDate class="form-control" @bind-Value="model.DateEndorsed" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Batch Code</label>
                                    <input class="form-control" @bind="model.BatchCode" @ref="batchCodeInput"/>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">OSCA ID Number</label>
                                    <InputText class="form-control" @bind-Value="model.OscaIdNumber" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">OSCA ID Date Issued (Day/Month/Year)</label>
                                    <InputDate class="form-control" @bind-Value="model.OscaIdDateIssued" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">NCSC RRN</label>
                                    <InputNumber class="form-control" @bind-Value="model.NcscRrn" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Last Name</label>
                                    <InputText class="form-control" @bind-Value="model.LastName" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">First Name <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="model.FirstName" />
                                    <ValidationMessage For="@(() => model.FirstName)" class="text-danger small" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Middle Name</label>
                                    <InputText class="form-control" @bind-Value="model.MiddleName" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Extension</label>
                                    <InputSelect class="form-select" @bind-Value="model.Extension">
                                        <option value="">Select Extension</option>
                                        <option value="">N/A</option>
                                        <option value="Sr.">Sr.</option>
                                        <option value="Jr.">Jr.</option>
                                        <option value="II.">II</option>
                                        <option value="III">III</option>
                                        <option value="IV">IV</option>
                                        <option value="V">V</option>
                                    </InputSelect>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Birth Date (Day/Month/Year) <span class="text-danger">*</span></label>
                                    <input type="date"
                                           class="form-control"
                                           value="@model.BirthDate.ToString("yyyy-MM-dd")"
                                           @onchange="OnBirthDateChanged" />
                                    <ValidationMessage For="@(() => model.BirthDate)" class="text-danger small" />
                                </div>

                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Age</label>
                                   <input class="form-control" value="@(GetAge(model.BirthDate)?.ToString() ?? "")" readonly />
                                </div>

                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Phone Number</label>
                                    <InputText class="form-control" @bind-Value="model.PhoneNumber" placeholder="09171234567, 0917...." />
                                    <ValidationMessage For="@(() => model.PhoneNumber)" />
                                </div>

                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Sex</label>
                                    <InputSelect class="form-select" @bind-Value="model.Sex">
                                        <option value="0">Select Sex</option>
                                        <option value="1">Male</option>
                                        <option value="2">Female</option>
                                    </InputSelect>
                                </div>
                                <div class="col-12">
                                    <div class="border rounded p-3 mt-2 bg-light">
                                        <h6 class="text-primary mb-3">Other Information</h6>
                                        <div class="row g-3">
                                             <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                                 <div class="form-check">
                                                     <input type="checkbox"
                                                            class="form-check-input"    
                                                            checked="@model.IsDeceased"
                                                            @onchange="OnIsDeceasedChanged" />
                                                     <label class="form-check-label">Is Deceased</label>
                                                 </div>
                                             </div>
                                             <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                                 <label class="form-label">Date of Death (Day/Month/Year)</label>
                                                 <input type="date"
                                                        class="form-control"
                                                        value="@(model.DateOfDeath?.ToString("yyyy-MM-dd"))"
                                                        max="@TodayDateString"
                                                        @onchange="OnDateOfDeathChanged"
                                                        disabled="@(!model.IsDeceased)" />
                                             </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Demographic Information -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Demographic Information</h5>
                            <div class="row g-3">
                        
                                <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.IsIndigenousPeople"/>
                                        <label class="form-check-label">Indigenous People</label>
                                    </div>
                                </div>
                        
                                <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.IsPersonWithDisability" />
                                        <label class="form-check-label">Person with Disability</label>
                                    </div>
                                </div>
                        
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Civil Status</label>
                                    <InputSelect class="form-select" @bind-Value="model.CivilStatus">
                                        <option value="0">Select Civil Status</option>
                                        <option value="1">Single</option>
                                        <option value="2">Widowed</option>
                                        <option value="3">Married</option>
                                        <option value="4">Live in</option>
                                    </InputSelect>
                                </div>
                        
                                <div class="col-12 col-md-6 col-lg-3">
                                    <label class="form-label">Citizenship</label>
                                    <select class="form-select"
                                            value="@model.Citizenship"
                                            @onchange="OnCitizenshipChanged">
                                        <option value="0">Select Citizenship</option>
                                        <option value="1">Filipino</option>
                                        <option value="2">Dual Citizenship</option>
                                    </select>
                                </div>
                        
                            </div>
                        </div>

                        <!-- Address Information -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Address Information</h5>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Region</label>
                                    <input type="text" class="form-control" value="@DefaultRegionName" readonly />
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label">Province</label>
                                    <select class="form-select"
                                            value="@model.PsgcCodeProvince"
                                            @onchange="OnProvinceChanged"
                                            disabled="@isProvinceLoading">
                                        <option value="0">Select Province</option>
                                        @foreach (var province in provinces)
                                        {
                                            <option value="@province.PsgcCodeProvince">@province.Name</option>
                                        }
                                    </select>

                                    @if (isProvinceLoading)
                                    {
                                        <div class="small text-primary mt-1">
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                            Loading provinces...
                                        </div>
                                    }
                                </div>

                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Municipality</label>
                                    <select class="form-select"
                                            value="@model.PsgcCodeMunicipality"
                                            @onchange="OnMunicipalityChanged"
                                            disabled="@(model.PsgcCodeProvince == 0 || isMunicipalityLoading)">
                                        <option value="0">Select Municipality</option>
                                        @foreach (var municipality in municipalities)
                                        {
                                            <option value="@municipality.PsgcCodeMunicipality">@municipality.Name</option>
                                        }
                                    </select>

                                    @if (isMunicipalityLoading)
                                    {
                                        <div class="small text-primary mt-1">
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                            Loading municipalities...
                                        </div>
                                    }
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label">Barangay</label>
                                    <select class="form-select"
                                            value="@model.PsgcCodeBarangay"
                                            @onchange="OnBarangayChanged"
                                            disabled="@(model.PsgcCodeMunicipality == 0 || isBarangayLoading)">
                                        <option value="0">Select Barangay</option>
                                        @foreach (var barangay in barangays)
                                        {
                                            <option value="@barangay.PsgcCodeBarangay">@barangay.Name</option>
                                        }
                                    </select>

                                    @if (isBarangayLoading)
                                    {
                                        <div class="small text-primary mt-1">
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                            Loading barangays...
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>

                        <!-- Validation Information -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Validation Information</h5>
                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Validator <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="model.Validator" />
                                    <ValidationMessage For="@(() => model.Validator)" class="text-danger small" />
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Validation Date (Day/Month/Year)<span class="text-danger">*</span></label>
                                    <InputDate class="form-control" @bind-Value="model.ValidationDate" />
                                    <ValidationMessage For="@(() => model.ValidationDate)" class="text-danger small" />
                                </div>
                                <div class="col-12">
                                    <div class="border rounded p-3 mt-2 bg-light">
                                        <h6 class="text-primary mb-3">Assessment</h6>

                                        <div class="row g-3">
                                            <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                                <div class="form-check">
                                                    <InputCheckbox class="form-check-input" @bind-Value="model.IsEligible" />
                                                    <label class="form-check-label">Is Eligible</label>
                                                </div>
                                            </div>

                                            <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                                <div class="form-check">
                                                    <InputCheckbox class="form-check-input" @bind-Value="model.IsCompliant" />
                                                    <label class="form-check-label">Is Compliant</label>
                                                </div>
                                            </div>
                                                <div class="col-12">
                                                    <label class="form-label">Assessment Remarks</label>
                                                    <InputTextArea class="form-control"
                                                                   @bind-Value="model.AssessmentRemarks"
                                                                   rows="3"
                                                                   placeholder="Enter assessment remarks if beneficiary is not eligible..." />
                                                </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <!-- Payment Information & Remarks -->
                        <div class="border rounded p-3 mb-4">
                            <h5 class="text-primary mb-3">Payment Information & Remarks</h5>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Payment Status <span class="text-danger">*</span></label>
                                    <InputSelect class="form-select" @bind-Value="model.PaymentStatus">
                                        <option value="0">Select Payment Status</option>
                                        <option value="1">Unpaid</option>
                                        <option value="2">Paid</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => model.PaymentStatus)" class="text-danger small" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Mode of Payment </label>
                                    <InputSelect class="form-select" @bind-Value="model.ModeOfPayment">
                                        <option value="0">Select Mode of Payment</option>
                                        <option value="1">Cash Advance by SDO</option>
                                        <option value="2">Bank Transfer</option>
                                    </InputSelect>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Payment Date</label>
                                    <InputDate class="form-control" @bind-Value="model.PaymentDate" disabled="@(model.PaymentStatus != 2)" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Remark Category</label>
                                    <InputSelect class="form-select" @bind-Value="model.RemarkCategory">
                                        <option value="0">Select Remark</option>
                                        <option value="1">Deceased prior reaching milestone age</option>
                                        <option value="2">Out of town/Country</option>
                                        <option value="3">Incomplete required documents</option>
                                        <option value="4">Inconsistent documents</option>
                                        <option value="5">Cannot be reached/Located</option>
                                        <option value="6">Did not reach the milestone age</option>
                                        <option value="7">Lacking of documents/Requirements</option>
                                        <option value="8">For Correction</option>
                                        <option value="9">Waived</option>
                                        <option value="10">Lacking Proof of Relationship</option>
                                        <option value="11">Now show</option>
                                        <option value="12">Double Application with Different Surename used</option>
                                        <option value="13">For CGD Island Municipality</option>
                                    </InputSelect>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Remarks</label>
                                    <InputTextArea class="form-control" @bind-Value="model.Remarks" rows="3" />
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-2">
                            @if(isEditMode)
                            {
                                <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@isSaving">
                                    Cancel Edit
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm" disabled="@isSaving">
                                    Clear
                                </button>
                            }
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if(isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>@(isEditMode ? "Updating...": "Saving...")</span>
                                }
                                else
                                {
                                    <span>@(isEditMode ? "Update Grantee" : "Add Grantee")</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <Card Class="shadow-sm border-0">
                <CardHeader Class="bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Import Excel File</h5>
                            <small class="text-muted">Bulk adding of grantees</small>
                        </div>
                    </div>
                </CardHeader>
                <CardBody>
                    <!--Importing-->
                    <div class="mb-3">
                        <InputFile OnChange="HandleFileSelected" accept=".xlsx" class="form-control" />
                    </div>
                    @if (isLoadingSheets)
                    {
                        <div class="mb-3 text-primary">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Reading workbook sheets...
                        </div>
                    }
                    @if (excelSheetNames.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label">Select Worksheet</label>
                            <InputSelect class="form-select" @bind-Value="selectedSheetName">
                                @foreach (var sheet in excelSheetNames)
                                {
                                    <option value="@sheet">@sheet</option>
                                }
                            </InputSelect>
                            @if (!string.IsNullOrWhiteSpace(uploadedExcelFileName) && excelSheetNames.Any())
                            {
                                <div class="alert alert-light border mb-3">
                                    <div><strong>File:</strong> @uploadedExcelFileName</div>
                                    <div><strong>Worksheets found:</strong> @excelSheetNames.Count</div>
                                </div>
                            }
                        </div>
                    }
                    <div class="small text-muted mb-3">
                        The system will validate all rows first. If any error is found, no records will be saved.
                    </div>

                    <button class="btn btn-success"
                            @onclick="UploadExcelAsync"
                            disabled="@(isUploading || uploadedExcelBytes == null || !excelSheetNames.Any() || string.IsNullOrWhiteSpace(selectedSheetName))">
                        @if (isUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Validating...</span>
                        }
                        else
                        {
                            <span>Validate and Import Excel</span>
                        }
                    </button>
                    <Tooltip Title="Matches existing records by Name, Birth Date, OSCA ID, and NCSC RRN. Only updates: Payment Status, Eligibility, Payment Date, Date of Death, and Validation Date."
                             Placement="TooltipPlacement.Top">
                        <button class="btn btn-warning"
                                @onclick="UpdateExcelAsync"
                                disabled="@(isUpdating || uploadedExcelBytes == null || !excelSheetNames.Any() || string.IsNullOrWhiteSpace(selectedSheetName))">
                            @if (isUpdating)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Updating...</span>
                            }
                            else
                            {
                                <span>Update Existing Records</span>
                            }
                        </button>
                    </Tooltip>

                    @if (importResult != null)
                    {
                        <div class="mt-3">
                            @if (importResult.HasErrors)
                            {
                                <div class="alert alert-danger">
                                    <h6 class="mb-2">Import Validation Failed</h6>
                                    <div>Total Rows Checked: <strong>@importResult.TotalRows</strong></div>
                                    <div>Valid Rows: <strong>@importResult.ValidRows</strong></div>
                                    <div>Error Count: <strong>@importResult.ErrorCount</strong></div>
                                    <div class="mt-2">
                                        <strong>No records were saved.</strong> Please correct the Excel file and upload again.
                                    </div>
                                </div>

                                <div class="card border-danger shadow-sm">
                                    <div class="card-header bg-danger text-white">
                                        <strong>Import Errors</strong>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                            <table class="table table-sm table-striped table-hover mb-0">
                                                <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                                                    <tr>
                                                        <th>Row</th>
                                                        <th>Field</th>
                                                        <th>Message</th>
                                                        <th>Value</th>
                                                        <th>Suggestion</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var err in importResult.Errors)
                                                    {
                                                        <tr>
                                                            <td>@err.RowNumber</td>
                                                            <td>@err.Field</td>
                                                            <td>@err.Message</td>
                                                            <td>@err.RawValue</td>
                                                            <td>@err.Suggestion</td>
                                                        </tr>
                                                    }
                                                </tbody>

                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success">
                                    <h6 class="mb-2">Import Successful</h6>
                                    <div>Total Rows Checked: <strong>@importResult.TotalRows</strong></div>
                                    <div>Imported Rows: <strong>@importResult.ImportedCount</strong></div>
                                </div>
                            }
                        </div>
                    }
                    
                </CardBody>
            </Card>
        </div>
    </div>

    <!-- Search Card Filtering-->
    <div class="row mb-4">
        <div class="col-12">
            <Card Class="shadow-sm border-0">
                <CardHeader Class="bg-light">
                        <div class="card-header bg-primary text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="mb-0">Filter Grantees to show Records</h4>
                                    <small class="opacity-75">Search and narrow down Grantee records</small>
                                </div>
                            </div>
                        </div>
                </CardHeader>

                <CardBody>
                    <!--Location-->
                    <div class="mb-4">
                        <h6 class="text-primary mb-3">Location</h6>
                        <div class="row g-3">

                            <!-- Province -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">Province</label>
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                            @onclick="() => ToggleDropdown(nameof(showProvinceDropdown))"
                                            disabled="@(isLoading || isFilterProvinceLoading)">
                                        @GetProvinceButtonText()
                                    </button>

                                    @if (showProvinceDropdown)
                                    {
                                        <div class="dropdown-menu show w-100 p-2 multi-select-dropdown">
                                            @if (isFilterProvinceLoading)
                                            {
                                                <div class="small text-primary mt-1">
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                    Loading provinces...
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="form-check border-bottom pb-2 mb-2">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@AreAllProvincesSelected()"
                                                           @onclick="async () => await ToggleSelectAllProvinces()"
                                                           @onclick:stopPropagation="true" />
                                                    <label class="form-check-label fw-semibold">Select All</label>
                                                </div>

                                                @foreach (var province in filterProvinces)
                                                {
                                                    <div class="form-check">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@selectedProvinceIds.Contains(province.PsgcCodeProvince)"
                                                               @onclick="async () => await OnProvinceCheckboxClicked(province.PsgcCodeProvince)"
                                                               @onclick:stopPropagation="true" />
                                                        <label class="form-check-label">@province.Name</label>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }

                                </div>
                                <div class="small text-muted mt-1">
                                    Selected: @selectedProvinceIds.Count | Loaded municipalities: @filterMunicipalities.Count
                                </div>
                            </div>

                            <!-- Municipality -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">Municipality</label>
                                <div class="dropdown">
                                    @if (IsMunicipalityDisabled)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                                disabled>
                                            @GetMunicipalityButtonText()
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                                @onclick="() => ToggleDropdown(nameof(showMunicipalityDropdown))">
                                            @GetMunicipalityButtonText()
                                        </button>
                                    }

                                    @if (showMunicipalityDropdown && filterMunicipalities.Any())
                                    {
                                        @if (isFilterMunicipalityLoading)
                                        {
                                            <div class="small text-primary mt-1">
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                Loading municipalities...
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="dropdown-menu show w-100 p-2 multi-select-dropdown">
                                                <div class="form-check border-bottom pb-2 mb-2">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@AreAllMunicipalitiesSelected()"
                                                           @onclick="async () => await ToggleSelectAllMunicipalities()"
                                                           @onclick:stopPropagation="true" />
                                                    <label class="form-check-label fw-semibold">Select All</label>
                                                </div>

                                                @foreach (var municipality in filterMunicipalities)
                                                {

                                                    <div class="form-check">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@selectedMunicipalityIds.Contains(municipality.PsgcCodeMunicipality)"
                                                               @onclick="async () => await OnMunicipalityCheckboxClicked(municipality.PsgcCodeMunicipality)"
                                                               @onclick:stopPropagation="true" />
                                                        <label class="form-check-label">@municipality.Name</label>
                                                    </div>

                                                }
                                            </div>
                                        }

                                    }
                                </div>

                                <div class="small text-muted mt-1">
                                    Selected: @selectedMunicipalityIds.Count | Loaded barangays: @filterBarangays.Count
                                </div>
                            </div>

                            <!-- Barangay -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">Barangay</label>
                                <div class="dropdown">
                                    @if (IsBarangayDisabled)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                                disabled>
                                            @GetBarangayButtonText()
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                                @onclick="() => ToggleDropdown(nameof(showBarangayDropdown))">
                                            @GetBarangayButtonText()
                                        </button>
                                    }

                                    @if (showBarangayDropdown && filterBarangays.Any())
                                    {
                                        @if (isFilterBarangayLoading)
                                        {
                                            <div class="small text-primary mt-1">
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                Loading barangays...
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="dropdown-menu show w-100 p-2 multi-select-dropdown">
                                                <div class="form-check border-bottom pb-2 mb-2">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@AreAllBarangaysSelected()"
                                                           @onclick="ToggleSelectAllBarangays"
                                                           @onclick:stopPropagation="true" />
                                                    <label class="form-check-label fw-semibold">Select All</label>
                                                </div>

                                                @foreach (var barangay in filterBarangays)
                                                {
                                                    <div class="form-check">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@selectedBarangayIds.Contains(barangay.PsgcCodeBarangay)"
                                                               @onclick="() => ToggleBarangay(barangay.PsgcCodeBarangay)"
                                                               @onclick:stopPropagation="true" />
                                                        <label class="form-check-label">@barangay.Name</label>
                                                    </div>
                                                }
                                            </div>
                                        }

                                    }
                                </div>

                                <div class="small text-muted mt-1">
                                    Selected: @selectedBarangayIds.Count | Loaded barangays: @filterBarangays.Count
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Personal Filters -->
                    <div class="mb-4">
                        <h6 class="text-primary mb-3">Personal Filters</h6>
                        <div class="row g-3">
                            <!--Full name-->
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">Full Name</label>
                                <input type="text"
                                       class="form-control"
                                       placeholder="Search by name..."
                                       @bind="filterModel.FullName"
                                       @bind:event="oninput" />
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">Last Name</label>
                                <input type="text" class="form-control" placeholder="Enter last name" @bind="filterModel.LastName" />
                            </div>

                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">First Name</label>
                                <input type="text" class="form-control" placeholder="Enter first name" @bind="filterModel.FirstName" />
                            </div>
     
                            <!-- Sex -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">Sex</label>
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                            @onclick="() => ToggleDropdown(nameof(showSexDropdown))"
                                            disabled="@isLoading">
                                        @GetSexButtonText()
                                    </button>

                                    @if (showSexDropdown)
                                    {
                                        <div class="dropdown-menu show w-100 p-2 multi-select-dropdown">
                                            <div class="form-check border-bottom pb-2 mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@AreAllSexesSelected()"
                                                       @onclick="ToggleSelectAllSexes"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label fw-semibold">Select All</label>
                                            </div>

                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@selectedSexes.Contains(1)"
                                                       @onclick="() => ToggleSex(1)"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label">Male</label>
                                            </div>

                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@selectedSexes.Contains(2)"
                                                       @onclick="() => ToggleSex(2)"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label">Female</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="form-label">Payment Status</label>
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                            @onclick="() => ToggleDropdown(nameof(showPaymentStatusDropdown))"
                                            disabled="@isLoading">
                                        @GetPaymentStatusButtonText()
                                    </button>

                                    @if (showPaymentStatusDropdown)
                                    {
                                        <div class="dropdown-menu show w-100 p-2 multi-select-dropdown">
                                            <div class="form-check border-bottom pb-2 mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@AreAllPaymentStatusesSelected()"
                                                       @onclick="ToggleSelectAllPaymentStatuses"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label fw-semibold">Select All</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@selectedPaymentStatuses.Contains(0)"
                                                       @onclick="() => TogglePaymentStatus(0)"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label">N/A</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@selectedPaymentStatuses.Contains(1)"
                                                       @onclick="() => TogglePaymentStatus(1)"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label">Unpaid</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@selectedPaymentStatuses.Contains(2)"
                                                       @onclick="() => TogglePaymentStatus(2)"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label">Paid</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>


                        </div>
                    </div>

                    <!-- Age Filters -->
                    <div class="mb-4">
                        <h6 class="text-primary mb-3">Age Filters</h6>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label">Specific Age</label>
                                <input type="number" class="form-control" placeholder="e.g. 80" @bind="filterModel.SpecificAge" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Validator</label>
                                <input type="text" class="form-control" placeholder="Validator" @bind="filterModel.Validator" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">BatchCode</label>
                                <input type="text" class="form-control" placeholder="Batch Code" @bind="filterModel.BatchCode" />
                            </div>
                        </div>
                    </div>

                    <!-- Birthday Filters -->
                    <div>
                        <h6 class="text-primary mb-3">Birthday Filters</h6>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label">Specific Birthday</label>
                                <input type="date" class="form-control" @bind="filterModel.SpecificBirthday" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Birthday From</label>
                                <input type="date" class="form-control" @bind="filterModel.BirthdayFrom" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Birthday To</label>
                                <input type="date" class="form-control" @bind="filterModel.BirthdayTo" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Milestone Year</label>
                            <InputSelect @bind-Value="filterModel.MilestoneYear" class="form-select">
                                <option value="">-- Select Year --</option>
                                @for (int year = DateTime.Now.Year; year >= 1900; year--)
                                {
                                    <option value="@year">@year</option>
                                }
                            </InputSelect>
                            </div>

                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="ClearFilterAsync">
                            Clear Filters
                        </Button>
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="ApplyFiltersAsync" Disabled="@(isApplyingFilters || isLoading)">
                            @if (isApplyingFilters)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Applying...</span>
                            }
                            else
                            {
                                <span>Apply Filters</span>
                            }
                        </Button>

                    </div>
                </CardBody>

            </Card>
        </div>
    </div>
    <!-- List/Grid Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0">Showing</h5>
                            <span class="badge bg-primary">@totalCount Record(s)</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-info" @onclick="GoToDashboardSummary">
                                Dashboard Summary
                            </button>

                            <button class="btn btn-success"
                                    @onclick="ExportExcel"
                                    disabled="@IsExporting">

                                @if (IsExporting)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>Exporting...</span>
    }
                                else
                                {
                                    <span class="bi bi-file-earmark-excel">Export Excel</span>
                                }
                            </button>
                        </div>
                    </div>

                </div>
                <div class="card-body">
                    @if(isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 mb-0">Loading grantees...</p>
                        </div>   
                    }
                    else if(!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">
                            @errorMessage
                        </div>
                    }
                    else if (!beneficiaries.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="mb-0">No grantee record found.</p>
                        </div>
                    }
                    else
                    {
                        @if (checkedIds.Any())
                        {
                            <div class="d-flex align-items-center gap-2 mb-3 p-2 bg-light border rounded">
                                <span class="text-muted small">@checkedIds.Count selected</span>
                                <select class="form-select form-select-sm w-auto" @bind="bulkPaymentStatus">
                                    <option value="0">-- Set Payment Status --</option>
                                    <option value="1">Unpaid</option>
                                    <option value="2">Paid</option>
                                </select>
                                <button class="btn btn-sm btn-primary"
                                        @onclick="OpenBulkUpdateModal"
                                        disabled="@(bulkPaymentStatus == 0 || isBulkUpdating)">
                                    @if (isBulkUpdating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>Updating...</span>
                                    }
                                    else
                                    {
                                        <span>Apply to Selected</span>
                                    }
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">
                                    Clear Selection
                                </button>
                            </div>
                        }
                        <div class="table-responsive" style="height: 500px; overflow-y: auto;">
                            <table class="table table-hover table-striped align-middle">
                                <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                                    <tr>
                                        <th style="width: 40px">
                                            <!-- Select all checkbox-->
                                            <input type="checkbox"
                                                class="form-check-input"
                                                checked="@AreAllChecked()"
                                                @onchange="ToggleSelectAll"/>
                                        </th>
                                        <th>Batch Code</th>
                                        <th>Phone Number</th>
                                        <th>
                                            <div>Full Name</div>
                                                <input type="text"
                                                    class="form-control form-control-sm mt-1"
                                                    placeholder="Search name..."
                                                    @oninput="OnFullNameFilterInput"/>
                                         </th>
                                        <th>Birth Date</th>
                                        <th>Age</th>
                                        <th>Milestone Year</th>
                                        <th>Sex</th>
                                        <th>Municipality</th>
                                        <th>Barangay</th>
                                        <th>Validator</th>
                                        <th>Payment Status</th>
                                        <th>Eligible</th>
                                        <th>Compliant</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in FilteredBeneficiaries)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox"
                                                    class="form-check-input"
                                                    checked="@checkedIds.Contains(item.Id)"
                                                    @onchange="() => ToggleCheck(item.Id)"/>
                                            </td>
                                            <td>@item.BatchCode</td>
                                            <td>@item.PhoneNumber</td>
                                            <td>@GetFullName(item)</td>
                                            <td>@item.BirthDate.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <span class="badge @GetAgeBadgeClass(item.BirthDate)">
                                                    @item.Age
                                                </span>
                                            </td>
                                            <td>@item.MilestoneYear</td>
                                            <td>@GetSexText(item.Sex)</td>
                                            <td>@item.Municipality</td>
                                            <td>@item.Barangay</td>
                                            <td>@item.Validator</td>
                                            <td>
                                                <span class="badge @GetPaymentBadgeClass(item.PaymentStatus)">
                                                    @GetPaymentStatusText(item.PaymentStatus)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(item.IsEligible ? "bg-success" : "bg-secondary")">
                                                    @(item.IsEligible ? "Yes" : "No")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(item.IsCompliant ? "bg-info" : "bg-warning text-dark")">
                                                    @(item.IsCompliant ? "Yes" : "No")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="async () => await EditItem(item)" title="Edit">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>

                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteConfirmationModal(item)" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                    <button class="btn btn-sm btn-outline-info" @onclick="() => OpenLogModal(item)" title="Logs">
                                                        <i class="bi bi-clock-history"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <!--Pagination controls-->
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-3">
                            <div class="text-muted">
                                Showing
                                <strong>@(((filterModel.PageNumber - 1) * filterModel.PageSize) + 1)</strong>
                                to
                                <strong>@Math.Min(filterModel.PageNumber * filterModel.PageSize, totalCount)</strong>
                                of
                                <strong>@totalCount</strong>
                                record(s)
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="GoToPreviousPageAsync"
                                        disabled="@(filterModel.PageNumber <= 1 || isLoading)">
                                    Previous
                                </button>

                                <span class="small text-muted">
                                    Page @filterModel.PageNumber of @totalPages
                                </span>

                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="GoToNextPageAsync"
                                        disabled="@(filterModel.PageNumber >= totalPages || isLoading)">
                                    Next
                                </button>
                                <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChanged">
                                    <option value="10" selected="@(filterModel.PageSize == 10)">10</option>
                                    <option value="20" selected="@(filterModel.PageSize == 20)">20</option>
                                    <option value="50" selected="@(filterModel.PageSize == 50)">50</option>
                                    <option value="100" selected="@(filterModel.PageSize == 100)">100</option>
                                    <option value="500" selected="@(filterModel.PageSize == 500)">500</option>
                                    <option value="1000" selected="@(filterModel.PageSize == 1000)">1000</option>
                                </select>

                            </div>
                        </div>

                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!--Bulk update Modal-->
<Modal @ref="bulkUpdateModal">
    <HeaderTemplate>
        <h5 class="modal-title">Confirm Bulk Update</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>
            You are about to set <strong>@checkedIds.Count</strong> record(s) to
            <strong>@GetPaymentStatusText(bulkPaymentStatus)</strong>.
            This action cannot be undone easily. Proceed?
        </p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="() => bulkUpdateModal.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Primary" @onclick="ExecuteBulkUpdateAsync" Disabled="@isBulkUpdating">
            @if (isBulkUpdating)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Updating...</span>
            }
            else
            {

                <span>Yes, Update</span>
            }
        </Button>
    </FooterTemplate>
</Modal>
<!--Confirmation Modal-->
<Modal @ref="confirmModal">
    <HeaderTemplate>
        <h5 class="modal-title">@confirmationTitle</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-0">@confirmationMessage</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="CloseConfirmationModal">
            Cancel
        </Button>
        <Button Type="ButtonType.Button" Color="ButtonColor.Primary" @onclick="ConfirmActionAsync" Disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Yes, Confirm</span>
            }
        </Button>
    </FooterTemplate>
</Modal>
<!--Log Modal-->
<Modal @ref="logModal" Size="ModalSize.ExtraLarge">
    <HeaderTemplate>
        <h5 class="modal-title">Logs - @selectedBeneficiaryName</h5>
    </HeaderTemplate>

    <BodyTemplate>
        @if (isLogsLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 mb-0">Loading logs...</p>
            </div>
        }
        else if (logs == null || !logs.Any())
        {
            <div class="alert alert-info mb-0">
                No logs found for this beneficiary.
            </div>
        }
        else
        {
            <div style="max-height: 500px; overflow-y: auto;">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th style="width: 70px;">#</th>
                                <th>Activity</th>
                                <th style="width: 180px;">User</th>
                                <th style="width: 200px;">Date Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < logs.Count; i++)
                            {
                                var log = logs[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@log.Activity</td>
                                    <td>@log.UserName</td>
                                    <td>@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </BodyTemplate>

    <FooterTemplate>
        <Button Type="ButtonType.Button"
                Color="ButtonColor.Secondary"
                @onclick="CloseLogModal">
            Close
        </Button>
    </FooterTemplate>
</Modal>




@code {
    private BeneficiaryInformationDto model = new()
    {
        BirthDate = DateTime.UtcNow,
        ValidationDate = DateTime.UtcNow
    };
    private BeneficiaryFilterDto filterModel = new()
    {
        PageNumber = 1,
        PageSize = 1000

    };
    private BeneficiaryImportResultDto? importResult;
    private List<BeneficiaryInformationDto> beneficiaries = new();
    private int totalPages;
    private int totalCount;
    private ElementReference batchCodeInput;
    private bool shouldFocusBatchCode;
    private IBrowserFile? selectedFile;
    private bool isUploading;
    private bool isUpdating;
    private Modal confirmModal = default!;
    private Modal logModal = default!;
    private string confirmationTitle = "Confirm Action";
    private string confirmationMessage = string.Empty;
    private string pendingAction = string.Empty; //"add", "edit", "delete"
    private BeneficiaryInformationDto? selectedDeleteItem;
    private const int DefaultRegionCode = 1600000000;
    private const string DefaultRegionName = "Region XIII (Caraga)";
    private bool isLoading;
    private bool isSaving;
    private bool isEditMode;
    private string? successMessage;
    private string? errorMessage;

    private HashSet<int> selectedProvinceIds = new();
    private HashSet<int> selectedMunicipalityIds = new();
