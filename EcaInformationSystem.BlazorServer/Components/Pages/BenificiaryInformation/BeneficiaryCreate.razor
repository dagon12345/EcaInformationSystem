    private string GetFullName(BeneficiaryInformationDto item)
    {
        var middle = string.IsNullOrWhiteSpace(item.MiddleName) ? "" : $" {item.MiddleName}";
        var extension = string.IsNullOrWhiteSpace(item.Extension) ? "" : $" {item.Extension}";
        return $"{item.LastName}, {item.FirstName}{middle}{extension}";
    }
    #region for cascading comboboxes
    private void ToggleDropdown(string dropdownName)
    {
        showProvinceDropdown = dropdownName == nameof(showProvinceDropdown) && !showProvinceDropdown;
        showMunicipalityDropdown = dropdownName == nameof(showMunicipalityDropdown) && !showMunicipalityDropdown;
        showBarangayDropdown = dropdownName == nameof(showBarangayDropdown) && !showBarangayDropdown;
        showSexDropdown = dropdownName == nameof(showSexDropdown) && !showSexDropdown;
        showPaymentStatusDropdown = dropdownName == nameof(showPaymentStatusDropdown) && !showPaymentStatusDropdown;
    }
    private string GetProvinceButtonText()
  => selectedProvinceIds.Count == 0 ? "Select Province(s)" : $"{selectedProvinceIds.Count} province(s) selected";

    private bool AreAllProvincesSelected() =>
      filterProvinces.Any() &&
      filterProvinces.All(x => selectedProvinceIds.Contains(x.PsgcCodeProvince));
    private async Task ToggleSelectAllProvinces()
    {
        if (AreAllProvincesSelected())
        {
            selectedProvinceIds.Clear();
        }
        else
        {
            selectedProvinceIds = filterProvinces
                .Select(x => x.PsgcCodeProvince)
                .ToHashSet();
        }

        await LoadMunicipalitiesForSelectedProvincesAsync();
        StateHasChanged();
    }
    private async Task LoadMunicipalitiesForSelectedProvincesAsync()
    {
        try
        {
            errorMessage = null;

            filterMunicipalities = new List<MunicipalityLookupDto>();
            filterBarangays = new List<BarangayLookupDto>();
            selectedMunicipalityIds.Clear();
            selectedBarangayIds.Clear();

            if (!selectedProvinceIds.Any())
            {
                StateHasChanged();
                return;
            }

            var cacheKey = string.Join(",", selectedProvinceIds.OrderBy(x => x));

            if (filterMunicipalityCache.TryGetValue(cacheKey, out var cachedMunicipalities))
            {
                filterMunicipalities = cachedMunicipalities;
                StateHasChanged();
                return;
            }

            isFilterMunicipalityLoading = true;

            var request = new LookupMultiRequestDto
            {
                Ids = selectedProvinceIds.ToList()
            };

            var response = await Http.PostAsJsonAsync("api/Municipality/by-provinces", request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Failed to load municipalities. Status: {response.StatusCode}";
                StateHasChanged();
                return;
            }

            filterMunicipalities =
                await response.Content.ReadFromJsonAsync<List<MunicipalityLookupDto>>()
                ?? new List<MunicipalityLookupDto>();

            filterMunicipalityCache[cacheKey] = filterMunicipalities;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Municipality load error: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            isFilterMunicipalityLoading = false;
        }
    }

    private async Task OnProvinceCheckboxClicked(int provinceId)
    {
        if (selectedProvinceIds.Contains(provinceId))
            selectedProvinceIds.Remove(provinceId);
        else
            selectedProvinceIds.Add(provinceId);

        showMunicipalityDropdown = false;
        showBarangayDropdown = false;

        await LoadMunicipalitiesForSelectedProvincesAsync();
        StateHasChanged();
    }

