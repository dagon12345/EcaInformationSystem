    private async Task EditItem(BeneficiaryInformationDto item)
    {
        ClearMessages();
        isEditMode = true;
        model = new BeneficiaryInformationDto
        {
            Id = item.Id,
            DateApplied = item.DateApplied,
            DateEndorsed = item.DateEndorsed,
            BatchCode = item.BatchCode,
            OscaIdNumber = item.OscaIdNumber,
            OscaIdDateIssued = item.OscaIdDateIssued,
            NcscRrn = item.NcscRrn,
            LastName = item.LastName,
            FirstName = item.FirstName,
            MiddleName = item.MiddleName,
            Extension = item.Extension,
            BirthDate = item.BirthDate,
            PhoneNumber = item.PhoneNumber,
            Sex = item.Sex,
            IsIndigenousPeople = item.IsIndigenousPeople,
            IsPersonWithDisability = item.IsPersonWithDisability,
            CivilStatus = item.CivilStatus,
            Citizenship = item.Citizenship,
            Region = item.Region,
            PsgcCodeRegion = DefaultRegionCode,
            Province = item.Province,
            PsgcCodeProvince = item.PsgcCodeProvince,
            Municipality = item.Municipality,
            PsgcCodeMunicipality = item.PsgcCodeMunicipality,
            Barangay = item.Barangay,
            PsgcCodeBarangay = item.PsgcCodeBarangay,
            IsCompliant = item.IsCompliant,
            Validator = item.Validator,
            ValidationDate = item.ValidationDate,
            PaymentStatus = item.PaymentStatus,
            ModeOfPayment = item.ModeOfPayment,
            PaymentDate = item.PaymentDate,
            IsDeceased = item.IsDeceased,
            DateOfDeath = item.DateOfDeath,
            IsEligible = item.IsEligible,
            AssessmentRemarks = item.AssessmentRemarks,
            RemarkCategory = item.RemarkCategory,
            Remarks = item.Remarks,

            IsDeleted = item.IsDeleted
        };

        ApplyEligibilityRules();

        //Focus first name once edit button was toggled
        shouldFocusBatchCode = true;
        provinces.Clear();
        municipalities.Clear();
        barangays.Clear();

        await LoadProvincesAsync(DefaultRegionCode);
        if (model.PsgcCodeProvince > 0)
            await LoadMunicipalitiesAsync(model.PsgcCodeProvince);
        if (model.PsgcCodeMunicipality > 0)
            await LoadBarangaysAsync(model.PsgcCodeMunicipality);

        StateHasChanged();
    }
    private void CancelEdit()
    {
