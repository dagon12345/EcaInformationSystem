@page "/products"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using EcaInformationSystem.Application.DTOs
@inject HttpClient Http

<h3>Products</h3>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card p-3 mb-3">
    <h5>@(isEditMode ? "Edit Product" : "Add Product")</h5>

    <div class="mb-2">
        <label>Name</label>
        <input class="form-control" @bind="form.Name" />
    </div>

    <div class="mb-2">
        <label>Price</label>
        <input class="form-control" type="number" step="0.01" @bind="form.Price" />
    </div>

    <button type="button" class="btn btn-primary me-2" @onclick="SaveProductAsync">
        @(isEditMode ? "Update" : "Add")
    </button>

    @if (isEditMode)
    {
        <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
    }
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th style="width:200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (products.Count == 0)
        {
            <tr>
                <td colspan="3">No products found.</td>
            </tr>
        }
        else
        {
            @foreach (var p in products)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Price.ToString("N2")</td>
                    <td>
                        <button type="button" class="btn btn-warning btn-sm me-2" @onclick="() => StartEdit(p)">Edit</button>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteProductAsync(p.Id)">Delete</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<ProductDto> products = new();
    private ProductFormModel form = new();

    private bool isEditMode = false;
    private Guid editingId = Guid.Empty;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        errorMessage = null;
        products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products") ?? new();
    }

    private async Task SaveProductAsync()
    {
        try
        {
            successMessage = null;
            errorMessage = null;

            if (string.IsNullOrWhiteSpace(form.Name))
            {
                errorMessage = "Name is required.";
                return;
            }

            if (form.Price <= 0)
            {
                errorMessage = "Price must be greater than zero.";
                return;
            }

            HttpResponseMessage response;

            if (isEditMode)
            {
                var dto = new UpdateProductDto
                {
                    Id = editingId,
                    Name = form.Name,
                    Price = form.Price
                };

                response = await Http.PutAsJsonAsync($"api/products/{editingId}", dto);
            }
            else
            {
                var dto = new CreateProductDto
                {
                    Name = form.Name,
                    Price = form.Price
                };

                response = await Http.PostAsJsonAsync("api/products", dto);
            }

            if (response.IsSuccessStatusCode)
            {
                successMessage = isEditMode
                    ? "Product updated successfully."
                    : "Product added successfully.";

                form = new ProductFormModel();
                isEditMode = false;
                editingId = Guid.Empty;

                await LoadProductsAsync();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void StartEdit(ProductDto product)
    {
        successMessage = null;
        errorMessage = null;

        isEditMode = true;
        editingId = product.Id;

        form = new ProductFormModel
        {
            Name = product.Name,
            Price = product.Price
        };
    }

    private void CancelEdit()
    {
        successMessage = null;
        errorMessage = null;

        isEditMode = false;
        editingId = Guid.Empty;
        form = new ProductFormModel();
    }

    private async Task DeleteProductAsync(Guid id)
    {
        try
        {
            successMessage = null;
            errorMessage = null;

            var response = await Http.DeleteAsync($"api/products/{id}");

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Product deleted successfully.";

                if (isEditMode && editingId == id)
                {
                    CancelEdit();
                }

                await LoadProductsAsync();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    public class ProductFormModel
    {
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
    }
}
