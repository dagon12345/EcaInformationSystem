@page "/products"
@using EcaInformationSystem.Application.DTOs
@using EcaInformationSystem.Application.Interfaces
@inject IProductService ProductService
@rendermode InteractiveServer

<h3>Products</h3>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">@message</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card p-3 mb-3">
    <h5>@(isEditing ? "Edit Product" : "Add Product")</h5>

    <div class="mb-2">
        <label>Name</label>
        <input class="form-control" @bind="form.Name" />
    </div>

    <div class="mb-2">
        <label>Price</label>
        <input class="form-control" type="number" step="0.01" @bind="form.Price" />
    </div>

    <button class="btn btn-primary me-2" @onclick="SaveProduct">
        @(isEditing ? "Update" : "Add")
    </button>

    @if (isEditing)
    {
        <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
    }
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th style="width: 180px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (products.Count == 0)
        {
            <tr>
                <td colspan="3">No products found.</td>
            </tr>
        }
        else
        {
            @foreach (var p in products)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Price.ToString("N2")</td>
                    <td>
                        <button class="btn btn-warning btn-sm me-2" @onclick="() => EditProduct(p)">Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteProduct(p.Id)">Delete</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<ProductDto> products = new();

    private ProductFormModel form = new();

    private bool isEditing = false;
    private Guid editingId;

    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await ProductService.GetAllAsync();
    }

    private async Task SaveProduct()
    {
        try
        {
            errorMessage = null;
            message = null;

            if (string.IsNullOrWhiteSpace(form.Name))
            {
                errorMessage = "Name is required.";
                return;
            }

            if (form.Price <= 0)
            {
                errorMessage = "Price must be greater than zero.";
                return;
            }

            if (isEditing)
            {
                await ProductService.UpdateAsync(new UpdateProductDto
                {
                    Id = editingId,
                    Name = form.Name,
                    Price = form.Price
                });

                message = "Product updated successfully.";
            }
            else
            {
                await ProductService.CreateAsync(new CreateProductDto
                {
                    Name = form.Name,
                    Price = form.Price
                });

                message = "Product added successfully.";
            }

            form = new ProductFormModel();
            isEditing = false;
            editingId = Guid.Empty;

            await LoadProducts();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void EditProduct(ProductDto product)
    {
        errorMessage = null;
        message = null;

        isEditing = true;
        editingId = product.Id;

        form = new ProductFormModel
        {
            Name = product.Name,
            Price = product.Price
        };
    }

    private async Task DeleteProduct(Guid id)
    {
        try
        {
            errorMessage = null;
            message = null;

            await ProductService.DeleteAsync(id);
            message = "Product deleted successfully.";

            if (isEditing && editingId == id)
            {
                CancelEdit();
            }

            await LoadProducts();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
        editingId = Guid.Empty;
        form = new ProductFormModel();
        errorMessage = null;
        message = null;
    }

    public class ProductFormModel
    {
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
    }
}
