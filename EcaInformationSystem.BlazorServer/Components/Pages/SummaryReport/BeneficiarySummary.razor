@page "/beneficiary-summary"
@attribute [Authorize]
@rendermode InteractiveServer

@using EcaInformationSystem.Application.DTOs
@using EcaInformationSystem.Application.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IBeneficiaryInformationService BeneficiaryInformationService
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Grantee Dashboard Summary</PageTitle>

<div class="container-fluid py-4">

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="ClearMessages"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h3 class="mb-0">Grantee Dashboard Summary</h3>
                    <small class="text-muted">Overview of grantee records, age groups, provinces, and municipalities</small>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" @onclick="GoBackToBeneficiaries" disabled="@isLoading">
                        Back to Grantee List
                    </button>

                    <button class="btn btn-primary" @onclick="LoadSummaryAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Loading...</span>
                        }
                        else
                        {
                            <span>Refresh Summary</span>
                        }
                    </button>

                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="row mb-4">
        <div class="col-12">
            <Card Class="shadow-sm border-0">
                <CardHeader Class="bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Filter Grantees to show Records</h5>
                            <small class="text-muted">Search and narrow down summary records</small>
                        </div>
                    </div>
                </CardHeader>

                <CardBody>
                    <!--Location and Demographics-->
                    <div class="mb-4">
                        <h6 class="text-primary mb-3">Location & Demographics</h6>
                        <div class="row g-3">

                            <!-- Province -->
                            <div class="col-12 col-md-6 col-lg-3">
                                <label class="form-label">Province</label>
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                            @onclick="() => ToggleDropdown(nameof(showProvinceDropdown))"
                                            disabled="@isLoading">
                                        @GetProvinceButtonText()
                                    </button>

                                    @if (showProvinceDropdown)
                                    {
                                        <div class="dropdown-menu show w-100 p-2 multi-select-dropdown">
                                            <div class="form-check border-bottom pb-2 mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@AreAllProvincesSelected()"
                                                       @onclick="async () => await ToggleSelectAllProvinces()"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label fw-semibold">Select All</label>
                                            </div>

                                            @foreach (var province in filterProvinces)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@selectedProvinceIds.Contains(province.PsgcCodeProvince)"
                                                           @onclick="async () => await OnProvinceCheckboxClicked(province.PsgcCodeProvince)"
                                                           @onclick:stopPropagation="true" />
                                                    <label class="form-check-label">@province.Name</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="small text-muted mt-1">
                                    Selected: @selectedProvinceIds.Count | Loaded municipalities: @filterMunicipalities.Count
                                </div>
                            </div>

                            <!-- Municipality -->
                            <div class="col-12 col-md-6 col-lg-3">
                                <label class="form-label">Municipality</label>
                                <div class="dropdown">
                                    @if (IsMunicipalityDisabled)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                                disabled>
                                            @GetMunicipalityButtonText()
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                                @onclick="() => ToggleDropdown(nameof(showMunicipalityDropdown))">
                                            @GetMunicipalityButtonText()
                                        </button>
                                    }

                                    @if (showMunicipalityDropdown && filterMunicipalities.Any())
                                    {
                                        <div class="dropdown-menu show w-100 p-2 multi-select-dropdown">
                                            <div class="form-check border-bottom pb-2 mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@AreAllMunicipalitiesSelected()"
                                                       @onclick="async () => await ToggleSelectAllMunicipalities()"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label fw-semibold">Select All</label>
                                            </div>

                                            @foreach (var municipality in filterMunicipalities)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@selectedMunicipalityIds.Contains(municipality.PsgcCodeMunicipality)"
                                                           @onclick="async () => await OnMunicipalityCheckboxClicked(municipality.PsgcCodeMunicipality)"
                                                           @onclick:stopPropagation="true" />
                                                    <label class="form-check-label">@municipality.Name</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="small text-muted mt-1">
                                    Selected: @selectedMunicipalityIds.Count | Loaded barangays: @filterBarangays.Count
                                </div>
                            </div>

                            <!-- Barangay -->
                            <div class="col-12 col-md-6 col-lg-3">
                                <label class="form-label">Barangay</label>
                                <div class="dropdown">
                                    @if (IsBarangayDisabled)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                                disabled>
                                            @GetBarangayButtonText()
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                                @onclick="() => ToggleDropdown(nameof(showBarangayDropdown))">
                                            @GetBarangayButtonText()
                                        </button>
                                    }

                                    @if (showBarangayDropdown && filterBarangays.Any())
                                    {
                                        <div class="dropdown-menu show w-100 p-2 multi-select-dropdown">
                                            <div class="form-check border-bottom pb-2 mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@AreAllBarangaysSelected()"
                                                       @onclick="ToggleSelectAllBarangays"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label fw-semibold">Select All</label>
                                            </div>

                                            @foreach (var barangay in filterBarangays)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@selectedBarangayIds.Contains(barangay.PsgcCodeBarangay)"
                                                           @onclick="() => ToggleBarangay(barangay.PsgcCodeBarangay)"
                                                           @onclick:stopPropagation="true" />
                                                    <label class="form-check-label">@barangay.Name</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="small text-muted mt-1">
                                    Selected: @selectedBarangayIds.Count | Loaded barangays: @filterBarangays.Count
                                </div>
                            </div>

                            <!-- Sex -->
                            <div class="col-12 col-md-6 col-lg-3">
                                <label class="form-label">Sex</label>
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                            @onclick="() => ToggleDropdown(nameof(showSexDropdown))"
                                            disabled="@isLoading">
                                        @GetSexButtonText()
                                    </button>

                                    @if (showSexDropdown)
                                    {
                                        <div class="dropdown-menu show w-100 p-2 multi-select-dropdown">
                                            <div class="form-check border-bottom pb-2 mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@AreAllSexesSelected()"
                                                       @onclick="ToggleSelectAllSexes"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label fw-semibold">Select All</label>
                                            </div>

                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@selectedSexes.Contains(1)"
                                                       @onclick="() => ToggleSex(1)"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label">Male</label>
                                            </div>

                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@selectedSexes.Contains(2)"
                                                       @onclick="() => ToggleSex(2)"
                                                       @onclick:stopPropagation="true" />
                                                <label class="form-check-label">Female</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Birthday Filters -->
                    <div>
                        <h6 class="text-primary mb-3">Birthday Filters</h6>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label">Specific Age</label>
                                <input type="number" class="form-control" placeholder="e.g. 80" @bind="filterModel.SpecificAge" disabled="@isLoading" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Specific Birthday</label>
                                <input type="date" class="form-control" @bind="filterModel.SpecificBirthday" disabled="@isLoading" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Birthday From</label>
                                <input type="date" class="form-control" @bind="filterModel.BirthdayFrom" disabled="@isLoading" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Birthday To</label>
                                <input type="date" class="form-control" @bind="filterModel.BirthdayTo" disabled="@isLoading" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Milestone Year</label>
                                <InputSelect @bind-Value="filterModel.MilestoneYear" class="form-select" disabled="@isLoading">
                                    <option value="">-- Select Year --</option>
                                    @for (int year = DateTime.Now.Year; year >= 1900; year--)
                                    {
                                        <option value="@year">@year</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <Button Color="ButtonColor.Secondary"
                                Size="ButtonSize.Small"
                                @onclick="ClearFilterAsync"
                                Disabled="@isLoading">
                            Clear Filters
                        </Button>

                        <Button Color="ButtonColor.Primary"
                                Size="ButtonSize.Small"
                                @onclick="ApplyFiltersAsync"
                                Disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Applying...</span>
                            }
                            else
                            {
                                <span>Apply Filters</span>
                            }
                        </Button>

                    </div>
                </CardBody>
            </Card>
        </div>
    </div>

    <!-- Summary Content -->
    <div class="row mb-4">
        <div class="col-12">
            <Card Class="shadow-sm border-0">
                <CardHeader Class="bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="mb-0">Dashboard Summary</h4>
                        @if (isLoading)
                        {
                            <span class="badge bg-warning text-dark">Loading...</span>
                        }
                    </div>
                </CardHeader>

                <CardBody>
                    @if (isLoading)
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center py-5">
                            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <h5 class="mb-1">Loading dashboard summary...</h5>
                            <p class="text-muted mb-0">Please wait while we retrieve the filtered summary data.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">

                            <!-- Beneficiary Summary -->
                            <div class="col-12">
                                <div class="border rounded shadow-sm p-3 bg-white">
                                    <h5 class="mb-3 text-primary">Grantee Summary</h5>
                                    <div class="row g-3">
                                        <div class="col-12 col-md-4">
                                            <div class="border rounded p-3 h-100 bg-primary-subtle">
                                                <h6 class="text-muted mb-2">Total Grantees</h6>
                                                <h3 class="mb-0 text-primary">@summaryResult.TotalBeneficiaries</h3>
                                            </div>
                                        </div>

                                        <div class="col-12 col-md-4">
                                            <div class="border rounded p-3 h-100 bg-info-subtle">
                                                <h6 class="text-muted mb-2">Male</h6>
                                                <h3 class="mb-0 text-info">@summaryResult.TotalMale</h3>
                                            </div>
                                        </div>

                                        <div class="col-12 col-md-4">
                                            <div class="border rounded p-3 h-100 bg-danger-subtle">
                                                <h6 class="text-muted mb-2">Female</h6>
                                                <h3 class="mb-0 text-danger">@summaryResult.TotalFemale</h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Province and Municipality Summary -->
                            <div class="col-12">
                                <div class="row g-3">

                                    <div class="col-12 col-lg-6">
                                        <div class="border rounded p-3 h-100 bg-white">
                                            <h5 class="mb-3 text-primary">Province Count Summary</h5>

                                            @if (summaryResult.ProvinceCounts?.Any() == true)
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover align-middle mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Province</th>
                                                                <th class="text-end">Count</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var item in summaryResult.ProvinceCounts)
                                                            {
                                                                <tr>
                                                                    <td>@item.Province</td>
                                                                    <td class="text-end">
                                                                        <span class="badge bg-primary">@item.Count</span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-0">No province data available.</p>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-12 col-lg-6">
                                        <div class="border rounded p-3 h-100 bg-white">
                                            <h5 class="mb-3 text-primary">Municipality Count Summary</h5>

                                            @if (summaryResult.MunicipalityCounts?.Any() == true)
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover align-middle mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Municipality</th>
                                                                <th class="text-end">Count</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var item in summaryResult.MunicipalityCounts)
                                                            {
                                                                <tr>
                                                                    <td>@item.Municipality</td>
                                                                    <td class="text-end">
                                                                        <span class="badge bg-success">@item.Count</span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-0">No municipality data available.</p>
                                            }
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    }
                </CardBody>
            </Card>
        </div>
    </div>
</div>
<style>
    .multi-select-dropdown {
        max-height: 260px;
        overflow-y: auto;
        min-width: 100%;
    }

    .dropdown .btn {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {
    private const int DefaultRegionCode = 1600000000;

    private BeneficiaryFilterDto filterModel = new()
    {
        PsgcCodeRegion = DefaultRegionCode
    };
    private bool isLoading;
    private BeneficiarySummaryResultDto summaryResult = new();
    private string? errorMessage;

    private List<ProvinceLookupDto> filterProvinces = new();
    private List<MunicipalityLookupDto> filterMunicipalities = new();
    private List<BarangayLookupDto> filterBarangays = new();

    private HashSet<int> selectedProvinceIds = new();
    private HashSet<int> selectedMunicipalityIds = new();
    private HashSet<int> selectedBarangayIds = new();
    private HashSet<int> selectedSexes = new();

    private bool showProvinceDropdown;
    private bool showMunicipalityDropdown;
    private bool showBarangayDropdown;
    private bool showSexDropdown;
    private bool IsMunicipalityDisabled => isLoading || filterMunicipalities.Count == 0;
    private bool IsBarangayDisabled => isLoading || filterBarangays.Count == 0;


    private string GetProvinceButtonText()
    => selectedProvinceIds.Count == 0 ? "Select Province(s)" : $"{selectedProvinceIds.Count} province(s) selected";

    private string GetMunicipalityButtonText()
    {
        return selectedMunicipalityIds.Count == 0
            ? "Select Municipality(s)"
            : $"{selectedMunicipalityIds.Count} municipality(s) selected";
    }
    private string GetBarangayButtonText()
    {
        return selectedBarangayIds.Count == 0
            ? "Select Barangay(s)"
            : $"{selectedBarangayIds.Count} barangay(s) selected";
    }
    private string GetSexButtonText()
    {
        if (selectedSexes.Count == 0) return "Select Sex";
        if (selectedSexes.Count == 2) return "All Sexes";
        if (selectedSexes.Contains(1)) return "Male";
        if (selectedSexes.Contains(2)) return "Female";
        return "Select Sex";
    }

    private void ToggleDropdown(string dropdownName)
    {
        showProvinceDropdown = dropdownName == nameof(showProvinceDropdown) && !showProvinceDropdown;
        showMunicipalityDropdown = dropdownName == nameof(showMunicipalityDropdown) && !showMunicipalityDropdown;
        showBarangayDropdown = dropdownName == nameof(showBarangayDropdown) && !showBarangayDropdown;
        showSexDropdown = dropdownName == nameof(showSexDropdown) && !showSexDropdown;
    }
    private bool AreAllBarangaysSelected()
    {
        return filterBarangays.Any() &&
               filterBarangays.All(x => selectedBarangayIds.Contains(x.PsgcCodeBarangay));
    }

    private async Task LoadSummaryAsync()
    {
        if (isLoading)
            return;

        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            summaryResult = await BeneficiaryInformationService.GetSummaryAsync(filterModel)
                ?? new BeneficiarySummaryResultDto();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load dashboard summary. {ex.Message}";
            summaryResult = new BeneficiarySummaryResultDto();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    private async Task ClearFilterAsync()
    {
        if (isLoading)
            return;

        selectedProvinceIds.Clear();
        selectedMunicipalityIds.Clear();
        selectedBarangayIds.Clear();
        selectedSexes.Clear();

        filterModel = new BeneficiaryFilterDto
        {
            PsgcCodeRegion = DefaultRegionCode
        };

        filterMunicipalities.Clear();
        filterBarangays.Clear();
        errorMessage = null;
        summaryResult = new BeneficiarySummaryResultDto();
        await LoadFilterProvincesAsync();
        StateHasChanged();
    }


    private void GoBackToBeneficiaries()
    {
        if (isLoading)
            return;

        Navigation.NavigateTo("/beneficiary-create");
    }

    private void ClearMessages()
    {
        errorMessage = null;
    }
    private async Task LoadFilterProvincesAsync()
    {
        filterProvinces = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>($"api/Province/by-region/{DefaultRegionCode}")
            ?? new List<ProvinceLookupDto>();
    }

    #region Fresh Methods below for cascading multi-select dropdowns - can be refactored later

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterProvincesAsync();
    }


    private async Task OnProvinceCheckboxClicked(int provinceId)
    {
        if (selectedProvinceIds.Contains(provinceId))
            selectedProvinceIds.Remove(provinceId);
        else
            selectedProvinceIds.Add(provinceId);

        await LoadMunicipalitiesForSelectedProvincesAsync();
        StateHasChanged();
    }

    private async Task OnMunicipalityCheckboxClicked(int municipalityId)
    {
        if (selectedMunicipalityIds.Contains(municipalityId))
            selectedMunicipalityIds.Remove(municipalityId);
        else
            selectedMunicipalityIds.Add(municipalityId);

        await LoadBarangaysForSelectedMunicipalitiesAsync();
        StateHasChanged();
    }

    private void ToggleBarangay(int barangayId)
    {
        if (selectedBarangayIds.Contains(barangayId))
            selectedBarangayIds.Remove(barangayId);
        else
            selectedBarangayIds.Add(barangayId);
    }

    private void ToggleSex(int sexValue)
    {
        if (selectedSexes.Contains(sexValue))
            selectedSexes.Remove(sexValue);
        else
            selectedSexes.Add(sexValue);
    }

    private async Task ToggleSelectAllProvinces()
    {
        if (AreAllProvincesSelected())
        {
            selectedProvinceIds.Clear();
        }
        else
        {
            selectedProvinceIds = filterProvinces
                .Select(x => x.PsgcCodeProvince)
                .ToHashSet();
        }

        await LoadMunicipalitiesForSelectedProvincesAsync();
        StateHasChanged();
    }

    private async Task ToggleSelectAllMunicipalities()
    {
        if (AreAllMunicipalitiesSelected())
        {
            selectedMunicipalityIds.Clear();
        }
        else
        {
            selectedMunicipalityIds = filterMunicipalities
                .Select(x => x.PsgcCodeMunicipality)
                .ToHashSet();
        }

        await LoadBarangaysForSelectedMunicipalitiesAsync();
        StateHasChanged();
    }

    private void ToggleSelectAllBarangays()
    {
        if (AreAllBarangaysSelected())
        {
            selectedBarangayIds.Clear();
        }
        else
        {
            selectedBarangayIds = filterBarangays
                .Select(x => x.PsgcCodeBarangay)
                .ToHashSet();
        }
    }

    private void ToggleSelectAllSexes()
    {
        if (AreAllSexesSelected())
        {
            selectedSexes.Clear();
        }
        else
        {
            selectedSexes.Clear();
            selectedSexes.Add(1);
            selectedSexes.Add(2);
        }
    }

    private bool AreAllProvincesSelected() =>
        filterProvinces.Any() &&
        filterProvinces.All(x => selectedProvinceIds.Contains(x.PsgcCodeProvince));

    private bool AreAllMunicipalitiesSelected() =>
        filterMunicipalities.Any() &&
        filterMunicipalities.All(x => selectedMunicipalityIds.Contains(x.PsgcCodeMunicipality));

    private bool AreAllSexesSelected() =>
        selectedSexes.Contains(1) && selectedSexes.Contains(2);


    private async Task LoadMunicipalitiesForSelectedProvincesAsync()
{
    try
    {
        errorMessage = null;

        filterMunicipalities = new List<MunicipalityLookupDto>();
        filterBarangays = new List<BarangayLookupDto>();
        selectedMunicipalityIds.Clear();
        selectedBarangayIds.Clear();

        if (!selectedProvinceIds.Any())
        {
            StateHasChanged();
            return;
        }

        var request = new LookupMultiRequestDto
        {
            Ids = selectedProvinceIds.ToList()
        };

        var response = await Http.PostAsJsonAsync("api/Municipality/by-provinces", request);

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = $"Failed to load municipalities. Status: {response.StatusCode}";
            StateHasChanged();
            return;
        }

        filterMunicipalities =
            await response.Content.ReadFromJsonAsync<List<MunicipalityLookupDto>>()
            ?? new List<MunicipalityLookupDto>();

        StateHasChanged();
    }
    catch (Exception ex)
    {
        errorMessage = $"Municipality load error: {ex.Message}";
        StateHasChanged();
    }
}

private async Task LoadBarangaysForSelectedMunicipalitiesAsync()
{
    try
    {
        errorMessage = null;

        filterBarangays = new List<BarangayLookupDto>();
        selectedBarangayIds.Clear();

        if (!selectedMunicipalityIds.Any())
        {
            StateHasChanged();
            return;
        }

        var request = new LookupMultiRequestDto
        {
            Ids = selectedMunicipalityIds.ToList()
        };

        var response = await Http.PostAsJsonAsync("api/Barangay/by-municipalities", request);

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = $"Failed to load barangays. Status: {response.StatusCode}";
            StateHasChanged();
            return;
        }

        filterBarangays =
            await response.Content.ReadFromJsonAsync<List<BarangayLookupDto>>()
            ?? new List<BarangayLookupDto>();

        StateHasChanged();
    }
    catch (Exception ex)
    {
        errorMessage = $"Barangay load error: {ex.Message}";
        StateHasChanged();
    }
}

    private async Task ApplyFiltersAsync()
    {
        if (isLoading)
            return;

        filterModel.PsgcCodeProvinces = selectedProvinceIds.ToList();
        filterModel.PsgcCodeMunicipalities = selectedMunicipalityIds.ToList();
        filterModel.PsgcCodeBarangays = selectedBarangayIds.ToList();
        filterModel.Sexes = selectedSexes.ToList();

        await LoadSummaryAsync();
    }


    #endregion

    public class ProvinceLookupDto
    {
        public int PsgcCodeRegion { get; set; }
        public int PsgcCodeProvince { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    public class MunicipalityLookupDto
    {
        public int PsgcCodeProvince { get; set; }
        public int PsgcCodeMunicipality { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    public class BarangayLookupDto
    {
        public int PsgcCodeMunicipality { get; set; }
        public int PsgcCodeBarangay { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
