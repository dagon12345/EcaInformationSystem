<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<system.webServer>

		<!-- Prevent IIS from trying to run ASP.NET Core -->
		<handlers>
			<remove name="aspNetCore" />
		</handlers>

		<rewrite>
			<rules>

				<!-- Serve pre-compressed Brotli files when the browser supports it and
             a .br sibling exists on disk, with the correct Content-Encoding
             header so the browser actually decompresses it. Without this rule,
             the .br/.gz files published alongside your .wasm/.dll files are
             just dead weight on disk — nothing ever requests or serves them. -->
				<rule name="Serve Brotli compressed files" stopProcessing="true">
					<match url="(.+\.(?:wasm|dll|js|json|dat|blat|pdb))$" />
					<conditions>
						<add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />
						<add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
					</conditions>
					<serverVariables>
						<set name="RESPONSE_Content_Encoding" value="br" />
					</serverVariables>
					<action type="Rewrite" url="{R:1}.br" />
				</rule>

				<!-- Fallback to gzip if Brotli isn't accepted/available for this file -->
				<rule name="Serve Gzip compressed files" stopProcessing="true">
					<match url="(.+\.(?:wasm|dll|js|json|dat|blat|pdb))$" />
					<conditions>
						<add input="{HTTP_ACCEPT_ENCODING}" pattern="gzip" />
						<add input="{REQUEST_FILENAME}.gz" matchType="IsFile" />
					</conditions>
					<serverVariables>
						<set name="RESPONSE_Content_Encoding" value="gzip" />
					</serverVariables>
					<action type="Rewrite" url="{R:1}.gz" />
				</rule>

				<!-- Blazor WASM SPA fallback routing -->
				<rule name="BlazorRouting" stopProcessing="true">
					<match url=".*" />
					<conditions logicalGrouping="MatchAll">
						<add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
						<add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
					</conditions>
					<action type="Rewrite" url="/index.html" />
				</rule>

			</rules>
		</rewrite>

		<!-- Required MIME types -->
		<staticContent>

			<remove fileExtension=".wasm" />
			<mimeMap fileExtension=".wasm" mimeType="application/wasm" />

			<remove fileExtension=".dll" />
			<mimeMap fileExtension=".dll" mimeType="application/octet-stream" />

			<remove fileExtension=".json" />
			<mimeMap fileExtension=".json" mimeType="application/json" />

			<remove fileExtension=".js" />
			<mimeMap fileExtension=".js" mimeType="application/javascript" />

			<remove fileExtension=".dat" />
			<mimeMap fileExtension=".dat" mimeType="application/octet-stream" />

			<remove fileExtension=".blat" />
			<mimeMap fileExtension=".blat" mimeType="application/octet-stream" />

			<remove fileExtension=".br" />
			<mimeMap fileExtension=".br" mimeType="application/octet-stream" />

			<remove fileExtension=".gz" />
			<mimeMap fileExtension=".gz" mimeType="application/octet-stream" />

		</staticContent>

		<!-- SharedArrayBuffer support -->
		<httpProtocol>
			<customHeaders>
				<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
				<add name="Cross-Origin-Opener-Policy" value="same-origin" />
			</customHeaders>
		</httpProtocol>

		<!-- Default page -->
		<defaultDocument>
			<files>
				<clear />
				<add value="index.html" />
			</files>
		</defaultDocument>

		<httpErrors existingResponse="PassThrough" />

	</system.webServer>

	<!-- ✅ CHANGED — _framework assets are content-hash-fingerprinted
       (WasmFingerprintAssets=true), meaning the URL itself changes whenever
       the content changes. That's exactly what makes it SAFE — and important
       for load speed — to cache these forever instead of forbidding caching.
       The previous no-cache/no-store override here defeated fingerprinting
       entirely and forced a full runtime re-download on every single visit,
       not just first-time. -->
	<location path="_framework">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="public, max-age=31536000, immutable" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<!-- ✅ NEW — blazor.boot.json and blazor.webassembly.js both live UNDER
	       _framework but, unlike the .dll/.wasm/.pdb files next to them, they are
	       NOT content-hash-fingerprinted — same filename every deploy. boot.json
	       is the actual manifest listing the current hashed filenames; without
	       this override both inherited the blanket _framework rule above
	       (1-year, immutable), so a normal reload kept replaying a year-old
	       manifest that still pointed at the OLD hashed files — silently stale
	       until something bypassed the disk cache entirely (Ctrl+Shift+R, or
	       this app's in-app "Refresh Now"). These two are tiny, so revalidating
	       them on every load costs nothing; the actual heavy runtime files right
	       next to them are unaffected and keep their full 1-year cache. -->
	<location path="_framework/blazor.boot.json">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<location path="_framework/blazor.webassembly.js">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<!-- Also always fresh — the entry document that references
	       _framework/blazor.webassembly.js in the first place. -->
	<location path="index.html">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<!-- css/js are plain wwwroot static files, NOT fingerprinted like
	       _framework — WasmFingerprintAssets only hashes the runtime under
	       _framework. Without this block they fell through to IIS's default
	       static file caching, so browsers kept serving stale CSS/JS from the
	       same URL after every deploy, which is why a hard refresh was needed
	       instead of a normal reload. -->
	<location path="css">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<location path="js">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<location path="service-worker.js">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

</configuration>