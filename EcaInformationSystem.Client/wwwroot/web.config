<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<system.webServer>

		<!-- Prevent IIS from trying to run ASP.NET Core -->
		<handlers>
			<remove name="aspNetCore" />
		</handlers>

		<!-- ✅ FIX — replaces a manual "rewrite requests to the pre-built .br/.gz
		     sibling file" scheme that used to live here. Those rules got
		     Content-Encoding right (via the RESPONSE_Content_Encoding
		     serverVariables trick) but NOT Content-Type: IIS's static file
		     module re-derives Content-Type from the REWRITTEN file's real
		     extension (".br"/".gz") after the rewrite runs, silently
		     overwriting whatever RESPONSE_Content_Type a rule set earlier in
		     the pipeline. An <outboundRules> based fix doesn't work either -
		     this host (MonsterASP/shared IIS) appears to silently no-op
		     outbound rules. Net effect: every compressed .wasm/.js/.json asset
		     was served as application/octet-stream, which browsers reject
		     outright for JS module imports ("Failed to load module script").
		     urlCompression sidesteps all of this: IIS compresses/decompresses
		     on the fly against the ORIGINAL file, so the extension - and
		     therefore Content-Type - never changes. -->
		<urlCompression doStaticCompression="true" doDynamicCompression="true" />

		<rewrite>
			<rules>

				<!-- Blazor WASM SPA fallback routing -->
				<rule name="BlazorRouting" stopProcessing="true">
					<match url=".*" />
					<conditions logicalGrouping="MatchAll">
						<add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
						<add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
					</conditions>
					<action type="Rewrite" url="/index.html" />
				</rule>

			</rules>
		</rewrite>

		<!-- Required MIME types -->
		<staticContent>

			<remove fileExtension=".wasm" />
			<mimeMap fileExtension=".wasm" mimeType="application/wasm" />

			<remove fileExtension=".dll" />
			<mimeMap fileExtension=".dll" mimeType="application/octet-stream" />

			<remove fileExtension=".json" />
			<mimeMap fileExtension=".json" mimeType="application/json" />

			<remove fileExtension=".js" />
			<mimeMap fileExtension=".js" mimeType="application/javascript" />

			<remove fileExtension=".dat" />
			<mimeMap fileExtension=".dat" mimeType="application/octet-stream" />

			<remove fileExtension=".blat" />
			<mimeMap fileExtension=".blat" mimeType="application/octet-stream" />

		</staticContent>

		<!-- SharedArrayBuffer support -->
		<httpProtocol>
			<customHeaders>
				<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
				<add name="Cross-Origin-Opener-Policy" value="same-origin" />
			</customHeaders>
		</httpProtocol>

		<!-- Default page -->
		<defaultDocument>
			<files>
				<clear />
				<add value="index.html" />
			</files>
		</defaultDocument>

		<httpErrors existingResponse="PassThrough" />

	</system.webServer>

	<!-- ✅ CHANGED — _framework assets are content-hash-fingerprinted
       (WasmFingerprintAssets=true), meaning the URL itself changes whenever
       the content changes. That's exactly what makes it SAFE — and important
       for load speed — to cache these forever instead of forbidding caching.
       The previous no-cache/no-store override here defeated fingerprinting
       entirely and forced a full runtime re-download on every single visit,
       not just first-time. -->
	<location path="_framework">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="public, max-age=31536000, immutable" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<!-- ✅ NEW — blazor.boot.json and blazor.webassembly.js both live UNDER
	       _framework but, unlike the .dll/.wasm/.pdb files next to them, they are
	       NOT content-hash-fingerprinted — same filename every deploy. boot.json
	       is the actual manifest listing the current hashed filenames; without
	       this override both inherited the blanket _framework rule above
	       (1-year, immutable), so a normal reload kept replaying a year-old
	       manifest that still pointed at the OLD hashed files — silently stale
	       until something bypassed the disk cache entirely (Ctrl+Shift+R, or
	       this app's in-app "Refresh Now"). These two are tiny, so revalidating
	       them on every load costs nothing; the actual heavy runtime files right
	       next to them are unaffected and keep their full 1-year cache. -->
	<location path="_framework/blazor.boot.json">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<location path="_framework/blazor.webassembly.js">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<!-- ✅ NEW — dotnet.js is the same situation as blazor.webassembly.js
	       above: NOT content-hash-fingerprinted, same URL every deploy, but it
	       inherits the blanket _framework rule's 1-year immutable cache unless
	       excepted here. Concretely this bit: while the site was serving it
	       with the wrong Content-Type (before the urlCompression fix), every
	       browser that loaded it cached that broken response against this
	       exact URL for a year — a plain reload doesn't re-request an
	       "immutable" resource, so those visitors needed one hard refresh to
	       pick up the fix. Excepting it here means a future dotnet.js change
	       (SDK upgrade, etc.) revalidates on every normal reload instead of
	       silently going stale the same way. -->
	<location path="_framework/dotnet.js">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<!-- Also always fresh — the entry document that references
	       _framework/blazor.webassembly.js in the first place. -->
	<location path="index.html">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<!-- css/js are plain wwwroot static files, NOT fingerprinted like
	       _framework — WasmFingerprintAssets only hashes the runtime under
	       _framework. Without this block they fell through to IIS's default
	       static file caching, so browsers kept serving stale CSS/JS from the
	       same URL after every deploy, which is why a hard refresh was needed
	       instead of a normal reload. -->
	<location path="css">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<location path="js">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, must-revalidate" />
					<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
					<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

	<location path="service-worker.js">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="DisableCache" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<clear />
					<add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>

</configuration>
