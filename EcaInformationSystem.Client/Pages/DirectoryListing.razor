@* Shared province/people grid — used by both the staff-facing Provincial
   Focals page (under MainLayout) and the Focal-only home page (under
   FocalLayout), so the listing/call-button logic exists in exactly one
   place instead of being duplicated across the two shells.

   Online status updates live via VoiceCallHub's "VoiceCallPresenceChanged"
   broadcast (same pattern ChatHub already uses for its own presence dot) —
   no page refresh needed to see someone come online/offline. ── *@
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject VoiceCallStateService CallState
@inject VoiceCallClientService VoiceCallClient
@inject ChatStateService ChatState
@inject ToastService toast
@inject NavigationManager Navigation
@inject HttpClient Http
@implements IDisposable

@{
    // One person row — reused for both a PDO branch's own header and each
    // Focal nested under it, so the avatar/online-dot/message/call markup
    // exists in exactly one place regardless of where it's rendered.
    RenderFragment<DirectoryPersonDto> PersonRow = person =>
        @<text>
            <button type="button" class="focal-person-avatar-btn" title="View profile" @onclick="() => GoToProfile(person.UserId)">
                <img src="@AvatarUrl(person.UserId)" alt="" class="focal-person-avatar avatar-img"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="focal-person-avatar focal-person-avatar-fallback" style="display:none;">@GetInitials(person.FullName)</div>
            </button>
            <span class="focal-person-dot @(person.IsOnline ? "focal-person-dot--online" : "")"></span>
            <div class="focal-person-info" style="cursor:pointer;" @onclick="() => GoToProfile(person.UserId)">
                <div class="focal-person-name">
                    @person.FullName
                    @if (_recentlyChangedIds.Contains(person.UserId) && person.IsOnline)
                    {
                        <i class="bi bi-lightning-charge-fill focal-person-live-icon" title="Just came online"></i>
                    }
                </div>
                <div class="focal-person-role">@person.Role</div>
                @if (!string.IsNullOrWhiteSpace(person.MunicipalityName))
                {
                    <div class="focal-person-municipality">@person.MunicipalityName</div>
                }
            </div>
            @{ var isSelf = person.UserId == ChatState.CurrentUserId; }
            <button type="button" class="focal-call-btn focal-message-btn" title="Send a message"
                    disabled="@isSelf"
                    @onclick="() => MessageAsync(person.UserId)">
                <i class="bi bi-chat-dots-fill"></i>
            </button>
            <button type="button" class="focal-call-btn" title="@CallButtonTitle(person, isSelf)"
                    disabled="@(isSelf || !person.IsOnline || CallState.CurrentState != VoiceCallState.Idle)"
                    @onclick="() => CallState.StartCallAsync(person.UserId, person.FullName)">
                <i class="bi bi-telephone-fill"></i>
            </button>
        </text>;
}

@if (Loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (!Groups.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox" style="font-size:32px;"></i>
        <p class="mt-2">No provinces with assigned PDOs/focals yet.</p>
    </div>
}
else
{
    <div class="focal-directory-grid">
        @foreach (var group in Groups)
        {
            <div class="focal-province-card">
                <div class="focal-province-header">
                    <i class="bi bi-geo-alt-fill me-1"></i>@group.ProvinceName
                </div>

                @if (!group.PdoBranches.Any())
                {
                    <div class="focal-branch-empty">No PDOs or focals assigned here yet.</div>
                }

                @foreach (var branch in group.PdoBranches)
                {
                    var isAdminBucket = branch.PdoUserId is null;
                    var branchKey = branch.PdoUserId ?? Guid.Empty;
                    var expanded = IsBranchExpanded(branchKey);

                    <div class="focal-branch @(isAdminBucket ? "focal-branch--admin" : "")">
                        <div class="focal-branch-header" @onclick="() => ToggleBranch(branchKey)">
                            <i class="bi @(expanded ? "bi-chevron-down" : "bi-chevron-right") focal-branch-toggle"></i>

                            @if (isAdminBucket)
                            {
                                <span class="focal-branch-admin-icon"><i class="bi bi-shield-fill"></i></span>
                                <div class="focal-person-info">
                                    <div class="focal-person-name">@branch.PdoName</div>
                                    <div class="focal-person-role">Not tied to a specific PDO</div>
                                </div>
                            }
                            else
                            {
                                <div class="focal-person-row focal-person-row--branch" @onclick:stopPropagation="true">
                                    @{ var pdoPerson = new DirectoryPersonDto { UserId = branch.PdoUserId!.Value, FullName = branch.PdoName, Role = branch.BranchRole ?? "PDO", IsOnline = branch.IsOnline }; }
                                    @PersonRow(pdoPerson)
                                </div>
                            }

                            <span class="focal-branch-count" title="@branch.Focals.Count focal(s) under this PDO">
                                <i class="bi bi-person-fill"></i>@branch.Focals.Count
                            </span>
                        </div>

                        @if (expanded)
                        {
                            <div class="focal-branch-focals">
                                @if (!branch.Focals.Any())
                                {
                                    <div class="focal-branch-empty">No focals invited yet.</div>
                                }
                                else
                                {
                                    @foreach (var focal in branch.Focals)
                                    {
                                        <div class="focal-person-row focal-branch-focal-row @(_recentlyChangedIds.Contains(focal.UserId) ? "focal-person-row--live" : "")">
                                            @PersonRow(focal)
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<ProvinceDirectoryGroupDto> Groups { get; set; } = new();
    [Parameter] public bool Loading { get; set; }
    // Staff (ProvincialFocalDirectory, under MainLayout) use the default
    // "/profile" — Focal (FocalHome, under FocalLayout) doesn't have that
    // route available and uses "/focal-profile" instead (see FocalProfile.razor).
    [Parameter] public string ProfileRouteBase { get; set; } = "/profile";

    private HashSet<Guid> _recentlyChangedIds = new();

    // Branches start expanded — this only tracks ones the user has manually
    // collapsed. Keyed by PdoUserId, or Guid.Empty for the Admin-Invited bucket.
    private HashSet<Guid> _collapsedBranches = new();
    private bool IsBranchExpanded(Guid branchKey) => !_collapsedBranches.Contains(branchKey);
    private void ToggleBranch(Guid branchKey)
    {
        if (!_collapsedBranches.Add(branchKey))
            _collapsedBranches.Remove(branchKey);
    }

    private void GoToProfile(Guid userId) => Navigation.NavigateTo($"{ProfileRouteBase}/{userId}");

    // Absolute URL — see Profile.razor's AvatarUrl for why a relative <img src>
    // 404s (API is on a different origin than the client).
    private string AvatarUrl(Guid userId) => $"{Http.BaseAddress}api/UserProfile/{userId}/avatar/thumb";

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][0].ToString().ToUpper() : $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    protected override void OnInitialized()
    {
        CallState.OnChanged += HandleCallStateChanged;
        VoiceCallClient.OnPresenceChanged += HandlePresenceChanged;
    }

    private void HandleCallStateChanged() => InvokeAsync(StateHasChanged);

    // Explains WHY the call button is greyed out — otherwise "disabled with no
    // reason" reads as broken rather than "they're just not online right now".
    private string CallButtonTitle(DirectoryPersonDto person, bool isSelf)
    {
        if (isSelf) return "You can't call yourself";
        if (!person.IsOnline) return $"{person.FullName} is offline — they need to be logged in to receive a call";
        if (CallState.CurrentState != VoiceCallState.Idle) return "You're already on a call";
        return "Voice call";
    }

    // Starts (or resumes) a direct chat with this person and opens the chat
    // widget straight into it — same flow ChatWidget's own "new chat" picker
    // uses, just triggered from here instead.
    private async Task MessageAsync(Guid userId)
    {
        try
        {
            await ChatState.StartAndOpenDirectConversationAsync(userId);
            ChatState.OpenWidget();
        }
        catch (Exception ex)
        {
            // HubException.Message carries the real reason (e.g. the Focal
            // "only a PDO" rule below) through to the client as-is — surface
            // it instead of a generic message so it's actionable.
            var message = ex.InnerException?.Message ?? ex.Message;
            toast.ShowError(string.IsNullOrWhiteSpace(message) ? "Couldn't start a conversation. Please try again." : message);
        }
    }

    private void HandlePresenceChanged(Guid userId, bool isOnline)
    {
        // A person can appear in more than one province group (e.g. a PDO
        // covering multiple provinces), and a PDO also appears both as its
        // own branch header AND inside group.People — update every occurrence.
        DirectoryPersonDto? match = null;
        string? matchName = null;
        foreach (var group in Groups)
        {
            foreach (var person in group.People.Where(p => p.UserId == userId))
            {
                person.IsOnline = isOnline;
                match = person;
                matchName = person.FullName;
            }

            foreach (var branch in group.PdoBranches)
            {
                if (branch.PdoUserId == userId)
                {
                    branch.IsOnline = isOnline;
                    matchName ??= branch.PdoName;
                    match ??= new DirectoryPersonDto { UserId = userId, FullName = branch.PdoName };
                }

                foreach (var focal in branch.Focals.Where(f => f.UserId == userId))
                {
                    focal.IsOnline = isOnline;
                    match = focal;
                    matchName = focal.FullName;
                }
            }
        }

        if (match is null) return; // this person isn't in the current directory view

        _recentlyChangedIds.Add(userId);
        if (isOnline)
        {
            toast.ShowSuccess($"{match.FullName} is now online.", "Provincial Directory");
        }

        InvokeAsync(StateHasChanged);

        _ = ClearRecentlyChangedAfterDelayAsync(userId);
    }

    // Same 2.8s live-highlight duration used elsewhere in this app (see the
    // transaction leaderboard's "just updated" pulse) — long enough to
    // notice, short enough not to linger as clutter.
    private async Task ClearRecentlyChangedAfterDelayAsync(Guid userId)
    {
        await Task.Delay(2800);
        _recentlyChangedIds.Remove(userId);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CallState.OnChanged -= HandleCallStateChanged;
        VoiceCallClient.OnPresenceChanged -= HandlePresenceChanged;
    }
}
