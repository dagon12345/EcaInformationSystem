@page "/features"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Features — ECA-InFORMS</PageTitle>

@* Same pattern as About.razor — standalone public chrome for an anonymous
   visitor (reached from the login page's navbar), just the article when
   already signed in and reached from inside the app. *@
<AuthorizeView>
    <NotAuthorized>
        <div class="auth-page-wrapper">
            <PublicNavbar Current="features" />

            <FeaturesArticle />

            <ScrollToTopButton />
        </div>
    </NotAuthorized>
    <Authorized>
        <FeaturesArticle />
    </Authorized>
</AuthorizeView>
