    private int? GetAge(DateTime? birthDate)
    {
        if (birthDate == null)
            return null;

        var today = DateTime.Today;
        var age = today.Year - birthDate.Value.Year;

        if (birthDate.Value.Date > today.AddYears(-age))
            age--;

        return age;
    }
    private string GetAgeBadgeClass(DateTime birthDate)
    {
        var age = GetAge(birthDate);

        if (age == null || age < 80) return "bg-danger"; // not eligible

        int currentYear = DateTime.Today.Year;
        int windowStart = Math.Max(2024, currentYear - 2);
        int windowEnd = currentYear;

        // Find the highest milestone already reached since program start 2024
        int[] milestones = new[] { 100, 95, 90, 85, 80 }; // highest first
        int milestoneYear = 0;
        foreach (var m in milestones)
        {
            int my = birthDate.Year + m;
            if (my <= currentYear && my >= 2024)
            {
                milestoneYear = my;
                break;
            }
        }

        if (milestoneYear == 0) return "bg-warning text-dark"; // eligible age but no milestone since 2024 yet

        if (milestoneYear >= windowStart && milestoneYear <= windowEnd)
            return "bg-success";           // 🟢 within active window

        return "bg-secondary";             // ⚫ milestone hit before the rolling window
    }
    private string GetFullName(BeneficiaryInformationDto item)
    {
        var middle = string.IsNullOrWhiteSpace(item.MiddleName) ? "" : $" {item.MiddleName}";
        var extension = string.IsNullOrWhiteSpace(item.Extension) ? "" : $" {item.Extension}";
        return $"{item.LastName}, {item.FirstName}{middle}{extension}";
    }
