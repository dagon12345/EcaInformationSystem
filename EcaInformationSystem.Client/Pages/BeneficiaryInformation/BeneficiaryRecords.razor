    private async Task ExecuteBulkUpdateAsync()
    {
        try
        {
            IsBulkUpdating = true;

            // 1. Create the request object matching the Controller's DTO
            var request = new
            {
                Ids = checkedIds.ToList(),
                PaymentStatus = bulkPaymentStatus
            };

            // 2. Call the API directly using HttpClient
            var response = await Http.PostAsJsonAsync("api/beneficiary/bulk-payment-status", request);

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess(
                    $"Successfully updated {checkedIds.Count} record(s) to {GetPaymentStatusText(bulkPaymentStatus)}.");

                ClearSelection();
                await State.LoadAsync();
                if (bulkUpdateModal != null)
                    await bulkUpdateModal.HideAsync();

            }
            else
            {
                // Try to extract the error message from the API response
                var errorMsg = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Bulk update failed: {errorMsg}");
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"An error occurred: {ex.Message}");
        }
        finally
        {
            IsBulkUpdating = false;
        }
    }


    // ✅ FIX
    private async Task ExportExcel()
    {
        if (!State.Beneficiaries.Any())
        {
            toast.ShowError("No records to export. Apply filters first.");
            return;
        }

        try
        {
            IsExporting = true;
            StateHasChanged(); // ← make spinner appear immediately

            var response = await Http.PostAsJsonAsync("api/beneficiary/export", State.Filter);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Export failed: {error}");
                return;
            }

            var exportBytes = await response.Content.ReadAsByteArrayAsync();
            if (exportBytes == null || exportBytes.Length == 0)
            {
                toast.ShowError("No data returned from export.");
                return;
            }

            var base64 = Convert.ToBase64String(exportBytes);
            await JS.InvokeVoidAsync("downloadFile", $"Beneficiaries_{DateTime.Now:yyyy-MM-dd}.xlsx", base64);
        }
        catch (Exception ex)
        {
            toast.ShowError($"Export failed: {ex.Message}");
        }
        finally
        {
            IsExporting = false;
        }
    }
