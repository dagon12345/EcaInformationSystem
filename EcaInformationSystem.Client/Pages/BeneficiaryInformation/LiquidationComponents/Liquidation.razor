@page "/liquidation"
@using EcaInformationSystem.Client.Pages.BeneficiaryInformation.LiquidationComponents.Modal
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IDisposable
@inject BeneficiaryStateService State
@inject ToastService toast
@inject IJSRuntime JS

<PageTitle>Liquidation — CDR</PageTitle>

<!-- Page Header -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i>
                Cash Disbursements Record (CDR)
            </h5>
            <small class="text-muted">Filter paid grantees by province and payment date, then generate the CDR Excel</small>
        </div>
        <button class="btn btn-success"
                @onclick="OpenModalAsync"
                disabled="@(!State.Beneficiaries.Any() || _isGenerating)">
            @if (_isGenerating)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Opening...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-excel me-1"></i>
                <span>Generate CDR</span>
            }
        </button>
    </div>
</div>

<!-- Filter -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-0">
        <LiquidationSearchFilters />
    </div>
</div>

<!-- Preview Table -->
@if (State.IsLoading)
{
    <div class="text-center py-5">
        <HxSpinner Color="ThemeColor.Primary" Size="SpinnerSize.Regular" />
        <p class="mt-2 text-muted">Loading paid records...</p>
    </div>
}
else if (State.Beneficiaries.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold">Paid Records Preview</span>
                <span class="badge bg-success">@State.Beneficiaries.Count Record(s)</span>
                <span class="badge bg-primary">@GetPreviewGroups().Count CDR Row(s)</span>
            </div>
            <small class="text-muted">Grouped by Municipality + Milestone Year — each group = one CDR row</small>
        </div>
        <div class="card-body p-2">
            <div class="table-responsive">
                <table class="table table-sm table-hover table-bordered align-middle mb-0"
                       style="font-size:13px;">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Payment Date</th>
                            <th>Province</th>
                            <th>Municipality</th>
                            <th>Milestone Year</th>
                            <th class="text-center">Grantee Count</th>
                            <th class="text-end">Disbursement (₱)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int seq = 2; } @* starts at 2 because DV row is 0001 *@
                        @foreach (var group in GetPreviewGroups())
                        {
                            <tr>
                                <td>@seq</td>
                                <td>@group.PaymentDate.ToString("MMM dd, yyyy")</td>
                                <td>@group.Province</td>
                                <td>@group.Municipality</td>
                                <td>
                                    <span class="badge bg-info text-dark">@group.MilestoneYear</span>
                                </td>
                                <td class="text-center">@group.Count</td>
                                <td class="text-end">₱@group.TotalAmount.ToString("N2")</td>
                            </tr>
                            seq++;
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="6" class="text-end">Total Disbursement:</td>
                            <td class="text-end">
                                ₱@GetPreviewGroups().Sum(x => x.TotalAmount).ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
else if (State.HasActiveFilter && !State.IsLoading)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No paid records found for the selected filters.
    </div>
}

<LiquidationModal @ref="_modal" />

@code {
    private bool _isGenerating;
    private LiquidationModal _modal = default!;

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private async Task OpenModalAsync()
    {
        if (!State.Beneficiaries.Any())
        {
            toast.ShowError("No records found. Apply filters first.");
            return;
        }
        _isGenerating = true;
        StateHasChanged();
        try
        {
            await _modal.ShowAsync(State.Filter);
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private List<CdrPreviewGroup> GetPreviewGroups()
    {
        return State.Beneficiaries
            .Where(x => x.PaymentDate.HasValue)
            .GroupBy(x => new
            {
                PaymentDate  = x.PaymentDate!.Value.Date,
                Municipality = x.MunicipalityName ?? string.Empty,
                Province     = x.ProvinceName     ?? string.Empty,
                x.MilestoneYear
            })
            .Select(g => new CdrPreviewGroup
            {
                PaymentDate  = g.Key.PaymentDate,
                Municipality = g.Key.Municipality,
                Province     = g.Key.Province,
                MilestoneYear = g.Key.MilestoneYear,
                Count        = g.Count(),
                TotalAmount  = g.Sum(x => PayrollSettingsDto.CalculateCashGiftAmount(x.Age))
            })
            .OrderBy(x => x.PaymentDate)
            .ThenBy(x => x.Municipality)
            .ThenBy(x => x.MilestoneYear)
            .ToList();
    }
    
    private sealed class CdrPreviewGroup
    {
        public DateTime PaymentDate  { get; set; }
        public string Municipality   { get; set; } = string.Empty;
        public string Province       { get; set; } = string.Empty;
        public int MilestoneYear     { get; set; }
        public int Count             { get; set; }
        public decimal TotalAmount   { get; set; }
    }
}
