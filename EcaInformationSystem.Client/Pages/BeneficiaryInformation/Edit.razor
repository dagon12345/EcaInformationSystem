@page "/beneficiary-edit/{Id:guid}"
@attribute [Authorize]
@using EcaInformationSystem.Client.Pages.BeneficiaryInformation.BeneficiaryInformationChildComponents
@using Microsoft.AspNetCore.Authorization

<PageTitle>Edit Record</PageTitle>

<div class="container-fluid py-3">

    @* ── Page header *@
    <div class="page-header-bar page-header-bar--warn mb-3">
        <div class="page-header-icon">
            <i class="bi bi-pencil-square"></i>
        </div>
        <div>
            <h5 class="page-header-title">Edit Record</h5>
            <span class="page-header-sub">Update existing grantee information</span>
        </div>
    </div>

    @* ── Form section *@
    <div class="sys-card">
        <div class="sys-card-header">
            <i class="bi bi-clipboard2-data me-2"></i>
            Grantee Information
        </div>
        <div class="sys-card-body">
            <BeneficiaryForm IsEditMode="true" EditId="@Id" />
        </div>
    </div>

</div>

@code {
    [Parameter] public Guid Id { get; set; }
}
