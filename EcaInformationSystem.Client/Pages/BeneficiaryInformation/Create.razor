@page "/beneficiary-create"
@attribute [Authorize]
@using EcaInformationSystem.Client.Pages.BeneficiaryInformation.BeneficiaryInformationChildComponents
@using Microsoft.AspNetCore.Authorization

<PageTitle>Information Entry</PageTitle>

<div class="container-fluid py-3">

    @* ── Page header *@
    <div class="page-header-bar mb-3">
        <div class="page-header-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div>
            <h5 class="page-header-title">Information Entry</h5>
            <span class="page-header-sub">Create a new grantee record</span>
        </div>
    </div>

    @* ── Import section *@
    <div class="sys-card mb-3">
        <div class="sys-card-header d-flex align-items-center justify-content-between" style="cursor:pointer;"
             @onclick="() => _showBulkImport = !_showBulkImport">
            <span><i class="bi bi-file-earmark-arrow-up me-2"></i>Bulk Import via Excel</span>
            <i class="bi @(_showBulkImport ? "bi-chevron-up" : "bi-chevron-down") text-muted"></i>
        </div>
        @if (_showBulkImport)
        {
            <div class="sys-card-body">
                <BeneficiaryImporting />
            </div>
        }
    </div>

    @* ── Form section *@
    <div class="sys-card">
        <div class="sys-card-header">
            <i class="bi bi-clipboard2-pulse me-2"></i>
            Manual Entry Form
        </div>
        <div class="sys-card-body">
            <BeneficiaryForm IsEditMode="false" />
        </div>
    </div>

</div>

@code {
    private bool _showBulkImport = false;
}
