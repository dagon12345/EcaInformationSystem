@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject ToastService toast
@inject HttpClient Http
@inject BeneficiaryStateService State
@inject IJSRuntime JS
@inject AuthService AuthService

<div class="sf-wrap">
    <div class="sf-card" @onkeydown="OnFilterKeyDown">

        @* ── HEADER — static, no longer the collapse trigger ── *@
        <div class="sf-header sf-header--static">
            <div class="sf-header-left">
                <div class="sf-header-icon">
                    <i class="bi bi-funnel-fill"></i>
                </div>
                <div>
                    <p class="sf-header-title">
                        Filter Grantees
                        <i class="bi bi-info-circle-fill sf-header-info"
                           title="Search and filter results reflect data exactly as encoded. Incomplete or uncleansed records can skew counts — please verify and cleanse data for accurate results."></i>
                    </p>
                    <p class="sf-header-sub">Search by name — or open More Filters for Region, Payment, Age and more</p>
                </div>
            </div>
        </div>

        @* ── QUICK SEARCH — the 5 most-used fields, always visible; the
             free-text "search anything" box now lives inside More Filters
             instead, alongside the rest of the advanced criteria. ── *@
        <div class="sf-general-search sf-quickbar">
            <div class="sf-quickbar-row">
                <div class="sf-quickbar-fields">
                    <div class="sf-quickbar-field">
                        <label title="Type in this order for best results — no comma, just spaces">Full Name <span class="sf-quickbar-field-hint">(Last First Middle Suffix)</span></label>
                        <input type="text" placeholder="e.g. Dela Cruz Juan Santos Jr." disabled="@IsLoading"
                               @bind="State.Filter.FullName" @bind:event="oninput" />
                    </div>
                    <div class="sf-quickbar-field">
                        <label>Last Name</label>
                        <input type="text" placeholder="Last name" disabled="@IsLoading"
                               @bind="State.Filter.LastName" @bind:event="oninput" />
                    </div>
                    <div class="sf-quickbar-field">
                        <label>First Name</label>
                        <input type="text" placeholder="First name" disabled="@IsLoading"
                               @bind="State.Filter.FirstName" @bind:event="oninput" />
                    </div>
                    <div class="sf-quickbar-field">
                        <label>Middle Name</label>
                        <input type="text" placeholder="Middle name" disabled="@IsLoading"
                               @bind="State.Filter.MiddleName" @bind:event="oninput" />
                    </div>
                    <div class="sf-quickbar-field">
                        <label>Suffix</label>
                        <input type="text" placeholder="Jr., Sr., III" disabled="@IsLoading"
                               @bind="State.Filter.Suffix" @bind:event="oninput" />
                    </div>
                    <div class="sf-quickbar-field">
                        <label>Batch Code</label>
                        <input type="text" placeholder="Batch code" disabled="@IsLoading"
                               @bind="State.Filter.BatchCode" @bind:event="oninput" />
                    </div>
                </div>
                <div class="sf-quickbar-actions">
                    <button class="sf-btn sf-btn-clear" @onclick="ClearFilterAsync">
                        <i class="bi bi-x-circle"></i> Clear
                    </button>
                    <button class="sf-btn sf-btn-apply" @onclick="ApplyFiltersAsync"
                            disabled="@(IsApplyingFilters || IsLoading)">
                        @if (IsApplyingFilters)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Applying...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Apply</span>
                        }
                    </button>
                    <button class="sf-btn sf-btn-advanced" @onclick="OpenAdvancedFiltersModal">
                        <i class="bi bi-sliders"></i>
                        <span>More Filters</span>
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(State.Filter.GeneralSearch))
            {
                <small class="text-muted mt-1 d-block">
                    <i class="bi bi-info-circle me-1"></i>
                    Also searching all columns for
                    <strong>"@State.Filter.GeneralSearch"</strong>
                    (set in More Filters)
                    <button type="button" class="btn btn-link btn-sm p-0 ms-1" @onclick="ClearGeneralSearch">Clear</button>
                </small>
            }
            @{
                var activeAdvancedFilters = GetActiveAdvancedFilterSummary();
            }
            @if (activeAdvancedFilters.Any())
            {
                <small class="text-muted mt-1 d-flex flex-wrap align-items-center gap-1">
                    <i class="bi bi-funnel-fill text-primary me-1"></i>
                    <span>Filters applied:</span>
                    @foreach (var chip in activeAdvancedFilters)
                    {
                        <span class="sf-active-filter-chip">@chip</span>
                    }
                </small>
            }
        </div>
    </div>
</div>

@* ── ADVANCED FILTERS — modal instead of an inline panel, so the search
     bar above the grid stays a single compact line. ── *@
<HxModal @ref="_advancedFiltersModal" Size="ModalSize.ExtraLarge" Scrollable="true">
    <HeaderTemplate>
        <h5 class="modal-title"><i class="bi bi-sliders me-2"></i>More Filters</h5>
    </HeaderTemplate>
    <BodyTemplate>
            <div class="sf-body sf-body--modal" @onkeydown="OnAdvancedFilterKeyDown">

                @* GENERAL SEARCH — moved here from the quick bar; the 5
                   most-used fields (Full/Last/First/Middle Name, Batch Code)
                   stay always-visible instead, this free-text "search
                   everything" box is now an advanced/opt-in criterion. *@
                <div class="sf-group">
                    <div class="sf-section-label"><i class="bi bi-search me-1"></i>General Search</div>
                    <div class="sf-grid">
                        <div class="sf-field" style="grid-column: 1 / -1;">
                            <label>Search anything</label>
                            <input type="text" placeholder="Name, batch code, barangay, paid, male, 1926..."
                                   @bind="State.Filter.GeneralSearch" @bind:event="oninput" disabled="@IsLoading" />
                        </div>
                    </div>
                </div>

                @* LOCATION *@
                <div class="sf-group">
                    <div class="sf-section-label"><i class="bi bi-geo-alt me-1"></i>Location</div>
                    <div class="sf-grid">

                        @* Region *@
                        <div class="sf-field">
                            <label>Region</label>
                            <select value="@State.SelectedRegionId" @onchange="OnRegionChanged"
                                    disabled="@(IsLoading || IsFilterRegionLoading)">
                                <option value="0">All Regions</option>
                                @foreach (var r in State.FilterRegions)
                                {
                                    <option value="@r.PsgcCodeRegion">@r.Name</option>
                                }
                            </select>
                            @if (IsFilterRegionLoading)
                            {
                                <span class="sf-loading-pill">
                                    <span class="spinner-border spinner-border-sm"></span> Loading...
                                </span>
                            }
                        </div>

                        @* Province *@
                        <div class="sf-field">
                            <label>Province</label>
                            <MultiSelectDropdown TItem="ProvinceLookupDto" Items="State.FilterProvinces"
                                                 SelectedIds="State.SelectedProvinceIds" SelectedIdsChanged="OnProvinceMultiSelectChanged"
                                                 IdSelector="@(p => p.PsgcCodeProvince)" LabelSelector="@(p => p.Name)"
                                                 Placeholder="Provinces" Disabled="@(IsLoading || State.SelectedRegionId == 0)" />
                        </div>

                        @* Municipality *@
                        <div class="sf-field">
                            <label>Municipality</label>
                            <MultiSelectDropdown TItem="MunicipalityLookupDto" Items="State.FilterMunicipalities"
                                                 SelectedIds="State.SelectedMunicipalityIds"
                                                 SelectedIdsChanged="OnMunicipalityMultiSelectChanged"
                                                 IdSelector="@(m => m.PsgcCodeMunicipality)" LabelSelector="@(m => m.Name)"
                                                 Placeholder="Municipalities"
                                                 Disabled="@(IsLoading || !State.SelectedProvinceIds.Any() && State.FilterProvinces.Any())" />
                        </div>

                        @* Barangay — unchanged, still a native single-select *@
                        <div class="sf-field">
                            <label>Barangay</label>
                            <select value="@State.SelectedBarangayId" @onchange="OnBarangayChanged"
                                    disabled="@(IsLoading || !State.FilterBarangays.Any() || IsFilterBarangayLoading)">
                                <option value="0">Select Barangay</option>
                                @foreach (var b in State.FilterBarangays)
                                {
                                    <option value="@b.PsgcCodeBarangay">@b.Name</option>
                                }
                            </select>
                            @if (IsFilterBarangayLoading)
                            {
                                <span class="sf-loading-pill">
                                    <span class="spinner-border spinner-border-sm"></span> Loading...
                                </span>
                            }
                        </div>
                        <div class="sf-field">
                            <label>Data Quality</label>
                            <select value="@_dataQualityValue" @onchange="OnDataQualityChanged"
                                    disabled="@(IsLoading || State.SelectedBarangayId > 0)">
                                <option value="">All Records</option>
                                <option value="location">Caution — Location Needs Correction</option>
                                <option value="headsup">Heads-Up — Missing Payment Info</option>
                                <option value="incomplete">Incomplete — Missing Grantee Details</option>
                            </select>
                        </div>

                    </div>
                </div>

                @* DATE ADDED *@
                <div class="sf-group">
                    <div class="sf-section-label"><i class="bi bi-calendar-plus me-1"></i>Date Added</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>From</label>
                            <input type="date" value="@(State.Filter.DateAddedFrom?.ToString("yyyy-MM-dd"))"
                                   @onchange="e => OnDateAddedFromChanged(e)" />
                        </div>
                        <div class="sf-field">
                            <label>To</label>
                            <input type="date" value="@(State.Filter.DateAddedTo?.ToString("yyyy-MM-dd"))"
                                   @onchange="e => OnDateAddedToChanged(e)" />
                        </div>
                        @if (State.Filter.DateAddedFrom.HasValue || State.Filter.DateAddedTo.HasValue)
                        {
                            <div class="sf-field" style="align-self: flex-end;">
                                <button class="sf-btn sf-btn-clear" style="width: auto;" @onclick="ClearDateAddedFilter">
                                    <i class="bi bi-x-circle"></i> Clear
                                </button>
                            </div>
                        }
                    </div>
                    @if (State.Filter.DateAddedFrom.HasValue || State.Filter.DateAddedTo.HasValue)
                    {
                        <small class="text-muted mt-1 d-block">
                            <i class="bi bi-funnel-fill me-1 text-primary"></i>
                            @if (State.Filter.DateAddedFrom.HasValue && State.Filter.DateAddedTo.HasValue)
                            {
                                <span>
                                    @State.Filter.DateAddedFrom.Value.ToString("MMM dd, yyyy")
                                    → @State.Filter.DateAddedTo.Value.ToString("MMM dd, yyyy")
                                </span>
                            }
                            else if (State.Filter.DateAddedFrom.HasValue)
                            {
                                <span>From @State.Filter.DateAddedFrom.Value.ToString("MMM dd, yyyy")</span>
                            }
                            else
                            {
                                <span>Until @State.Filter.DateAddedTo!.Value.ToString("MMM dd, yyyy")</span>
                            }
                        </small>
                    }
                </div>

                @* DATE ENDORSED *@
                <div class="sf-group">
                    <div class="sf-section-label"><i class="bi bi-calendar-check me-1"></i>Date Endorsed</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>From</label>
                            <input type="date" value="@(State.Filter.DateEndorsedFrom?.ToString("yyyy-MM-dd"))"
                                   @onchange="e => OnDateEndorsedFromChanged(e)" />
                        </div>
                        <div class="sf-field">
                            <label>To</label>
                            <input type="date" value="@(State.Filter.DateEndorsedTo?.ToString("yyyy-MM-dd"))"
                                   @onchange="e => OnDateEndorsedToChanged(e)" />
                        </div>
                        @if (State.Filter.DateEndorsedFrom.HasValue || State.Filter.DateEndorsedTo.HasValue)
                        {
                            <div class="sf-field" style="align-self: flex-end;">
                                <button class="sf-btn sf-btn-clear" style="width: auto;" @onclick="ClearDateEndorsedFilter">
                                    <i class="bi bi-x-circle"></i> Clear
                                </button>
                            </div>
                        }
                    </div>
                    @if (State.Filter.DateEndorsedFrom.HasValue || State.Filter.DateEndorsedTo.HasValue)
                    {
                        <small class="text-muted mt-1 d-block">
                            <i class="bi bi-funnel-fill me-1 text-primary"></i>
                            @if (State.Filter.DateEndorsedFrom.HasValue && State.Filter.DateEndorsedTo.HasValue)
                            {
                                <span>
                                    @State.Filter.DateEndorsedFrom.Value.ToString("MMM dd, yyyy")
                                    → @State.Filter.DateEndorsedTo.Value.ToString("MMM dd, yyyy")
                                </span>
                            }
                            else if (State.Filter.DateEndorsedFrom.HasValue)
                            {
                                <span>From @State.Filter.DateEndorsedFrom.Value.ToString("MMM dd, yyyy")</span>
                            }
                            else
                            {
                                <span>Until @State.Filter.DateEndorsedTo!.Value.ToString("MMM dd, yyyy")</span>
                            }
                        </small>
                    }
                </div>

                @* PAYMENT *@
                <div class="sf-group">
                    <div class="sf-section-label"><i class="bi bi-credit-card me-1"></i>Payment</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>Payment Status</label>
                            <MultiSelectDropdown TItem="PaymentStatusOption" Items="_paymentStatusOptions"
                                                 SelectedIds="State.SelectedPaymentStatuses"
                                                 SelectedIdsChanged="@(ids => { State.SelectedPaymentStatuses = ids; })"
                                                 IdSelector="@(p => p.Value)" LabelSelector="@(p => p.Label)" Placeholder="Payment Status"
                                                 Disabled="@IsLoading" />
                        </div>
                        @* PAYROLL QUARTER *@
                        <div class="sf-field">
                            <label>Payroll Quarter</label>
                            <MultiSelectDropdown TItem="PayrollQuarterOption" Items="_payrollQuarterOptions"
                                                 SelectedIds="State.SelectedPayrollQuarters"
                                                 SelectedIdsChanged="@(ids => { State.SelectedPayrollQuarters = ids; })"
                                                 IdSelector="@(p => p.Value)" LabelSelector="@(p => p.Label)" Placeholder="Payroll Quarters"
                                                 Disabled="@IsLoading" />
                            @* ✅ FISCAL YEAR — its own separate sf-field, not nested inside Payroll Quarter *@
                            <div class="sf-field">
                                <label>Fiscal Year</label>
                                <select class="form-select form-select-sm" @bind="State.Filter.FilterFiscalYear">
                                    <option value="">-- Select --</option>
                                    @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                        </div>

                        @* MODE OF PAYMENT *@
                        <div class="sf-field">
                            <label>Mode of Payment</label>
                            <select value="@_modeOfPaymentValue" @onchange="OnModeOfPaymentChanged" disabled="@IsLoading">
                                <option value="">All</option>
                                <option value="1">Cash Advance by SDO</option>
                                <option value="2">Bank Transfer</option>
                            </select>
                        </div>
                        <div class="sf-field">
                            <label>Payment Date From</label>
                            <input type="date" @bind="State.Filter.PaymentDateFrom" />
                        </div>
                        <div class="sf-field">
                            <label>Payment Date To</label>
                            <input type="date" @bind="State.Filter.PaymentDateTo" />
                        </div>
                        @if (State.Filter.PaymentDateFrom.HasValue || State.Filter.PaymentDateTo.HasValue)
                        {
                            <div class="sf-field" style="align-self: flex-end;">
                                <button class="sf-btn sf-btn-clear" style="width: auto;" @onclick="ClearPaymentDateFilter">
                                    <i class="bi bi-x-circle"></i> Clear
                                </button>
                            </div>
                        }
                    </div>
                    @if (State.Filter.PaymentDateFrom.HasValue || State.Filter.PaymentDateTo.HasValue)
                    {
                        <small class="text-muted mt-1 d-block">
                            <i class="bi bi-funnel-fill me-1 text-primary"></i>
                            @if (State.Filter.PaymentDateFrom.HasValue && State.Filter.PaymentDateTo.HasValue)
                            {
                                <span>
                                    @State.Filter.PaymentDateFrom.Value.ToString("MMM dd, yyyy")
                                    → @State.Filter.PaymentDateTo.Value.ToString("MMM dd, yyyy")
                                </span>
                            }
                            else if (State.Filter.PaymentDateFrom.HasValue)
                            {
                                <span>From @State.Filter.PaymentDateFrom.Value.ToString("MMM dd, yyyy")</span>
                            }
                            else
                            {
                                <span>Until @State.Filter.PaymentDateTo!.Value.ToString("MMM dd, yyyy")</span>
                            }
                        </small>
                    }
                </div>

                @* AGE & BIRTHDAY *@
                <div class="sf-group">
                    <div class="sf-section-label"><i class="bi bi-calendar3 me-1"></i>Age & Birthday</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>Specific Age</label>
                            <input type="number" placeholder="e.g. 80" @bind="State.Filter.SpecificAge" />
                        </div>
                        <div class="sf-field">
                            <label>Milestone Year</label>
                            <select @bind="State.Filter.MilestoneYear">
                                <option value="">-- Select --</option>
                                <option value="0">No Milestone (0)</option>
                                @for (int y = DateTime.Now.Year; y >= 2024; y--)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>

                        @* Anticipated Milestones — separate, additive filter: pick any of
                           2024/2025/2026 together to see grantees turning a milestone age
                           (80/85/90/95/100) in ANY of those years, including a milestone
                           birthday that hasn't happened yet this year, so PDOs can
                           anticipate upcoming milestones ahead of time instead of checking
                           one year at a time via Milestone Year above. *@
                        <div class="sf-field">
                            <label>Anticipated Milestones</label>
                            <MultiSelectDropdown TItem="MilestoneYearOption" Items="_anticipatedMilestoneYearOptions"
                                                 SelectedIds="State.SelectedAnticipatedMilestoneYears"
                                                 SelectedIdsChanged="@(ids => State.SelectedAnticipatedMilestoneYears = ids)"
                                                 IdSelector="@(y => y.Value)" LabelSelector="@(y => y.Label)"
                                                 Placeholder="Anticipated Years" Disabled="@IsLoading" />
                        </div>

                        @* Specific Birthday — Month + Day only *@
                        <div class="sf-field">
                            <label>Specific Birthday</label>
                            <div class="sf-inline">
                                <select @bind="_specificBirthdayMonth" disabled="@IsLoading"
                                        class="@(_specificBirthdayMonth > 0 && _specificBirthdayDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Month</option>
                                    @foreach (var m in _months)
                                    {
                                        <option value="@m.Value">@m.Label</option>
                                    }
                                </select>
                                <select @bind="_specificBirthdayDay" disabled="@(IsLoading || _specificBirthdayMonth == 0)"
                                        class="@(_specificBirthdayMonth > 0 && _specificBirthdayDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Day</option>
                                    @foreach (var d in GetDaysForMonth(_specificBirthdayMonth))
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            </div>
                            @if (_specificBirthdayMonth > 0 && _specificBirthdayDay == 0)
                            {
                                <span class="sf-field-error">Please select a day.</span>
                            }
                        </div>

                        @* Birthday From — Month + Day only *@
                        <div class="sf-field">
                            <label>Birthday From</label>
                            <div class="sf-inline">
                                <select @bind="_birthdayFromMonth" disabled="@IsLoading"
                                        class="@(_birthdayFromMonth > 0 && _birthdayFromDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Month</option>
                                    @foreach (var m in _months)
                                    {
                                        <option value="@m.Value">@m.Label</option>
                                    }
                                </select>
                                <select @bind="_birthdayFromDay" disabled="@(IsLoading || _birthdayFromMonth == 0)"
                                        class="@(_birthdayFromMonth > 0 && _birthdayFromDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Day</option>
                                    @foreach (var d in GetDaysForMonth(_birthdayFromMonth))
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            </div>
                            @if (_birthdayFromMonth > 0 && _birthdayFromDay == 0)
                            {
                                <span class="sf-field-error">Please select a day.</span>
                            }
                        </div>

                        @* Birthday To — Month + Day only *@
                        <div class="sf-field">
                            <label>Birthday To</label>
                            <div class="sf-inline">
                                <select @bind="_birthdayToMonth" disabled="@IsLoading"
                                        class="@(_birthdayToMonth > 0 && _birthdayToDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Month</option>
                                    @foreach (var m in _months)
                                    {
                                        <option value="@m.Value">@m.Label</option>
                                    }
                                </select>
                                <select @bind="_birthdayToDay" disabled="@(IsLoading || _birthdayToMonth == 0)"
                                        class="@(_birthdayToMonth > 0 && _birthdayToDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Day</option>
                                    @foreach (var d in GetDaysForMonth(_birthdayToMonth))
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            </div>
                            @if (_birthdayToMonth > 0 && _birthdayToDay == 0)
                            {
                                <span class="sf-field-error">Please select a day.</span>
                            }
                        </div>

                    </div>
                </div>
                @* REFERENCE NUMBER *@
                <div class="sf-group">
                    <div class="sf-section-label">
                        <i class="bi bi-hash me-1"></i>Reference Number
                    </div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>Quarter</label>
                            <select value="@_refQuarterValue" @onchange="OnRefQuarterChanged" disabled="@IsLoading">
                                <option value="">All Quarters</option>
                                <option value="1">Q1 (Jan–Mar)</option>
                                <option value="2">Q2 (Apr–Jun)</option>
                                <option value="3">Q3 (Jul–Sep)</option>
                                <option value="4">Q4 (Oct–Dec)</option>
                            </select>
                        </div>
                        <div class="sf-field">
                            <label>Batch</label>
                            <input type="text" placeholder="e.g. 01, A" @bind="State.Filter.FilterBatch" />
                        </div>
                        <div class="sf-field">
                            <label>Year (short)</label>
                            <input type="number" placeholder="e.g. 26" @bind="State.Filter.FilterRefYear" />
                        </div>
                        <div class="sf-field">
                            <label>Region</label>
                            <select value="@State.Filter.FilterRegionRoman" @onchange="OnRefRegionChanged"
                                    disabled="@IsLoading">
                                <option value="">All Regions</option>
                                <option value="I">I – Ilocos</option>
                                <option value="II">II – Cagayan Valley</option>
                                <option value="III">III – Central Luzon</option>
                                <option value="IV-A">IV-A – CALABARZON</option>
                                <option value="IV-B">IV-B – MIMAROPA</option>
                                <option value="V">V – Bicol</option>
                                <option value="VI">VI – Western Visayas</option>
                                <option value="VII">VII – Central Visayas</option>
                                <option value="VIII">VIII – Eastern Visayas</option>
                                <option value="IX">IX – Zamboanga</option>
                                <option value="X">X – Northern Mindanao</option>
                                <option value="XI">XI – Davao</option>
                                <option value="XII">XII – SOCCSKSARGEN</option>
                                <option value="XIII">XIII – Caraga</option>
                                <option value="NCR">NCR</option>
                                <option value="CAR">CAR</option>
                                <option value="BARMM">BARMM</option>
                            </select>
                        </div>
                    </div>
                </div>
                @* PERSONAL — Full/Last/First/Middle Name and Batch Code now
                   live in the always-visible quick bar instead, since those
                   are the most-used fields (Suffix too, now); this section
                   keeps the rest. *@
                <div class="sf-group">
                    <div class="sf-section-label"><i class="bi bi-person me-1"></i>Personal</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>Sex</label>
                            <select value="@State.Filter.Sex" @onchange="OnSexChanged" disabled="@IsLoading">
                                <option value="0">Select Sex</option>
                                <option value="1">Male</option>
                                <option value="2">Female</option>
                            </select>
                        </div>
                        @* CO STATUS *@
                        <div class="sf-field">
                            <label>CO Status</label>
                            <select value="@_coStatusValue" @onchange="OnCoStatusFilterChanged" disabled="@IsLoading">
                                <option value="-1">Select CO Status</option>
                                <option value="0">Not Set</option>
                                <option value="1">Endorsed</option>
                                <option value="2">Approved</option>
                            </select>
                        </div>
                        @* REPLACEMENT STATUS — internal-only, SuperAdmin/Admin restricted action lives in the grid *@
                        <div class="sf-field">
                            <label>Replacement Status</label>
