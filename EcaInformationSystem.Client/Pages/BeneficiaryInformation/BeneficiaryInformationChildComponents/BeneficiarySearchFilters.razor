        provinceSelectKey++;
        municipalitySelectKey++;
        barangaySelectKey++;

        _specificBirthdayMonth = 0;
        _specificBirthdayDay = 0;
        _birthdayFromMonth = 0;
        _birthdayFromDay = 0;
        _birthdayToMonth = 0;
        _birthdayToDay = 0;
        _coStatusValue = "-1";
        _replacementStatusValue = "-1";
        _barangayIssueValue = string.Empty;
        State.Filter.CoStatus = null;
        State.Filter.ReplacementStatus = null;
        _complianceValue = string.Empty;
        State.Filter.IsCompliant = null;
        State.Filter.ComplianceMode = null;
        State.Filter.IsEligible = null;
        State.Filter.EligibilityMode = null;
        _eligibilityValue = string.Empty;
        State.Filter.IsLivenessVerified = null;
        _livenessValue = string.Empty;
        State.Filter.IsReadyForEft = null;
        _eftValue = string.Empty;
        State.Filter.GeneralSearch = null;
        _refQuarterValue = string.Empty;
        State.Filter.FilterQuarter = null;
        // ✅ Add inside ClearFilterAsync alongside the other filter clears
        State.Filter.FilterFiscalYear = null;
        State.Filter.FilterBatch = null;
        State.Filter.FilterRefYear = null;
        State.Filter.FilterRegionRoman = null;
        _modeOfPaymentValue = string.Empty;
        State.Filter.FilterModeOfPayment = null;
        _dataQualityValue = string.Empty;
        State.Filter.DataQualityIssue = null;
        // Inside ClearAllFilters — add alongside the other clears
        State.Filter.DateAddedFrom = null;
        State.Filter.DateAddedTo = null;
        State.Filter.DateEndorsedFrom = null;
        State.Filter.DateEndorsedTo = null;

        State.Filter = new BeneficiaryFilterDto
        {
            PageNumber = 1,
            PageSize = 50,
            // Sort reset to default on clear
            SortColumn = null,
            SortAscending = true

        };
        State.ClearData();

        if (!State.FilterRegions.Any())
            await LoadFilterRegionsAsync();

        StateHasChanged();
    }
    private void ClearPaymentDateFilter()
    {
        State.Filter.PaymentDateFrom = null;
