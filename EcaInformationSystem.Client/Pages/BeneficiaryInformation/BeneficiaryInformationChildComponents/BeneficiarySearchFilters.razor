    private bool IsFilterEmpty(BeneficiaryFilterDto f) =>
    string.IsNullOrWhiteSpace(f.FullName) &&
    string.IsNullOrWhiteSpace(f.LastName) &&
    string.IsNullOrWhiteSpace(f.FirstName) &&
    string.IsNullOrWhiteSpace(f.MiddleName) &&
    string.IsNullOrWhiteSpace(f.Suffix) &&
    string.IsNullOrWhiteSpace(f.Validator) &&
    string.IsNullOrWhiteSpace(f.BatchCode) &&
    f.SpecificAge == null &&
    // ✅ null means "not selected"; 0 means "filter for no milestone" — both are valid states
    f.MilestoneYear == null &&
    !State.SelectedAnticipatedMilestoneYears.Any() &&
    f.PaymentDateFrom == null &&
    f.PaymentDateTo == null &&
    f.PsgcCodeRegion == null &&
    !State.SelectedProvinceIds.Any() &&
    !State.SelectedMunicipalityIds.Any() &&
    !State.SelectedPaymentStatuses.Any() &&
    !State.SelectedPayrollQuarters.Any() &&
    string.IsNullOrWhiteSpace(State.Filter.DataQualityIssue) &&
    f.PsgcCodeBarangay == null &&
    f.Sex == null &&
    f.IsCompliant == null &&
    f.IsEligible == null &&
    f.IsCompliant == null &&
    string.IsNullOrWhiteSpace(f.ComplianceMode) && // ✅ add this
    f.IsEligible == null &&
      string.IsNullOrWhiteSpace(f.EligibilityMode) &&
    f.IsLivenessVerified == null &&
    f.IsReadyForEft == null &&
    (f.FindingStatus == null || f.FindingStatus == 3) &&
    string.IsNullOrWhiteSpace(f.GeneralSearch) && // ✅ add this
    string.IsNullOrWhiteSpace(f.FullName) &&
    f.CoStatus == null &&
    f.ReplacementStatus == null &&
    _specificBirthdayMonth == 0 &&
    _birthdayFromMonth == 0 &&
    f.FilterQuarter == null &&
    // ✅ Add this line inside IsFilterEmpty alongside the other filter checks
    State.Filter.FilterFiscalYear == null &&
    string.IsNullOrWhiteSpace(f.FilterBatch) &&
    f.FilterRefYear == null &&
    string.IsNullOrWhiteSpace(f.FilterRegionRoman) &&
    State.Filter.FilterModeOfPayment == null &&
    // ── Date Added ────────────────────────────────────────────────────────────
    State.Filter.DateAddedFrom == null &&
    State.Filter.DateAddedTo == null &&
    // ── Date Endorsed ─────────────────────────────────────────────────────────
    State.Filter.DateEndorsedFrom == null &&
    State.Filter.DateEndorsedTo == null &&
    _birthdayToMonth == 0;

    private async Task LoadMunicipalitiesForProvincesAsync(List<int> provinceIds)
    {
        var mySequence = ++_municipalityLoadSequence; // ✅ snapshot this call's turn

        try
        {
            IsFilterMunicipalityLoading = true;
            var combined = new List<MunicipalityLookupDto>();

            foreach (var provinceId in provinceIds)
            {
                if (filterMunicipalityCache.TryGetValue(provinceId, out var cached))
                {
                    combined.AddRange(cached);
                    continue;
                }

                var result = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>(
                    $"api/Municipality/by-province/{provinceId}") ?? new();

                filterMunicipalityCache[provinceId] = result;
                combined.AddRange(result);
            }

            // ✅ If a newer call has started since this one began, discard this
            // result — it's stale, and applying it would silently reintroduce
            // whatever province selection triggered the newer call.
            if (mySequence != _municipalityLoadSequence)
                return;

            State.FilterMunicipalities = combined
                .DistinctBy(m => m.PsgcCodeMunicipality)
                .OrderBy(m => m.Name)
                .ToList();
        }
        finally
        {
            if (mySequence == _municipalityLoadSequence)
                IsFilterMunicipalityLoading = false;
            StateHasChanged();
        }
    }
    private string GetQueryString(BeneficiaryFilterDto filter)
    {
        var properties = from p in filter.GetType().GetProperties()
                         let value = p.GetValue(filter, null)
                         where value != null
                         select new { p.Name, Value = value };
        var queryString = new List<string>();
        foreach (var prop in properties)
        {
            if (prop.Value is System.Collections.IEnumerable list && !(prop.Value is string))
                foreach (var item in list)
                    queryString.Add($"{prop.Name}={Uri.EscapeDataString(item.ToString() ?? "")}");
            else
                queryString.Add($"{prop.Name}={Uri.EscapeDataString(prop.Value.ToString() ?? "")}");
        }
        return string.Join("&", queryString);
    }
    private readonly List<PaymentStatusOption> _paymentStatusOptions = new()
    {
        new(0, "N/A"),
        new(1, "Unpaid"),
        new(2, "Paid"),
        new(3, "Pending"),
    };

    // Human-readable summary of the advanced (More Filters modal) criteria
    // that are actually applied right now — so after the modal closes, the
    // user can still see at a glance which filters produced the current
    // result set, without having to reopen the modal to check.
    private List<string> GetActiveAdvancedFilterSummary()
    {
        var f = State.Filter;
        var chips = new List<string>();

        if (f.PsgcCodeRegion is > 0)
        {
            var region = State.FilterRegions.FirstOrDefault(r => r.PsgcCodeRegion == f.PsgcCodeRegion);
            chips.Add($"Region: {region?.Name ?? f.PsgcCodeRegion.ToString()}");
        }
        if (State.SelectedProvinceIds.Any())
            chips.Add($"Province: {State.SelectedProvinceIds.Count}");
        if (State.SelectedMunicipalityIds.Any())
            chips.Add($"Municipality: {State.SelectedMunicipalityIds.Count}");
        if (f.PsgcCodeBarangay is > 0)
            chips.Add("Barangay");
        if (!string.IsNullOrWhiteSpace(f.DataQualityIssue))
            chips.Add($"Data Quality: {f.DataQualityIssue}");
        if (f.DateAddedFrom.HasValue || f.DateAddedTo.HasValue)
            chips.Add("Date Added");
        if (f.DateEndorsedFrom.HasValue || f.DateEndorsedTo.HasValue)
            chips.Add("Date Endorsed");
        if (State.SelectedPaymentStatuses.Any())
            chips.Add("Payment Status");
        if (State.SelectedPayrollQuarters.Any())
            chips.Add("Payroll Quarter");
        if (f.FilterFiscalYear.HasValue)
            chips.Add($"Fiscal Year: {f.FilterFiscalYear}");
        if (f.FilterModeOfPayment.HasValue)
            chips.Add("Mode of Payment");
        if (f.PaymentDateFrom.HasValue || f.PaymentDateTo.HasValue)
            chips.Add("Payment Date");
        if (f.SpecificAge.HasValue)
            chips.Add($"Age: {f.SpecificAge}");
        if (f.MilestoneYear.HasValue)
            chips.Add($"Milestone Year: {f.MilestoneYear}");
        if (State.SelectedAnticipatedMilestoneYears.Any())
            chips.Add($"Anticipated Milestones: {string.Join(", ", State.SelectedAnticipatedMilestoneYears)}");
        if (f.SpecificBirthday.HasValue)
            chips.Add("Specific Birthday");
        if (f.BirthdayFrom.HasValue || f.BirthdayTo.HasValue)
            chips.Add("Birthday Range");
        if (f.FilterQuarter.HasValue)
            chips.Add($"Ref Quarter: Q{f.FilterQuarter}");
        if (!string.IsNullOrWhiteSpace(f.FilterBatch))
            chips.Add($"Ref Batch: {f.FilterBatch}");
        if (f.FilterRefYear.HasValue)
            chips.Add($"Ref Year: {f.FilterRefYear}");
        if (!string.IsNullOrWhiteSpace(f.FilterRegionRoman))
            chips.Add($"Ref Region: {f.FilterRegionRoman}");
        if (!string.IsNullOrWhiteSpace(f.FullName))
            chips.Add($"Full Name: {f.FullName}");
        if (!string.IsNullOrWhiteSpace(f.LastName))
            chips.Add($"Last Name: {f.LastName}");
        if (!string.IsNullOrWhiteSpace(f.FirstName))
            chips.Add($"First Name: {f.FirstName}");
        if (!string.IsNullOrWhiteSpace(f.MiddleName))
            chips.Add($"Middle Name: {f.MiddleName}");
        if (!string.IsNullOrWhiteSpace(f.Suffix))
            chips.Add($"Suffix: {f.Suffix}");
        if (f.Sex is > 0)
            chips.Add(f.Sex == 1 ? "Sex: Male" : "Sex: Female");
        if (!string.IsNullOrWhiteSpace(f.BatchCode))
            chips.Add($"Batch Code: {f.BatchCode}");
        if (f.CoStatus.HasValue)
            chips.Add("CO Status");
        if (f.ReplacementStatus.HasValue)
            chips.Add("Replacement Status");
        if (!string.IsNullOrWhiteSpace(f.Validator))
            chips.Add($"Validator: {f.Validator}");
        if (f.FindingStatus.HasValue && f.FindingStatus != 3)
            chips.Add("Findings");
        if (!string.IsNullOrWhiteSpace(f.ComplianceMode))
            chips.Add("Compliance");
        if (!string.IsNullOrWhiteSpace(f.EligibilityMode))
            chips.Add("Eligibility");
        if (f.IsLivenessVerified.HasValue)
            chips.Add(f.IsLivenessVerified.Value ? "Liveness: Verified" : "Liveness: Not Verified");
        if (f.IsReadyForEft.HasValue)
            chips.Add(f.IsReadyForEft.Value ? "EFT: Ready" : "EFT: Not Ready");

        return chips;
    }
