    private async Task OnProvinceMultiSelectChanged(List<int> selectedIds)
    {
        State.SelectedProvinceIds = selectedIds;
        State.SelectedMunicipalityIds = new();
        State.SelectedBarangayId = 0;
        State.FilterMunicipalities = new();
        State.FilterBarangays = new();
        filterMunicipalityCache.Clear();
        filterBarangayCache.Clear();

        // ✅ No fallback — if nothing is selected, there's nothing to cascade.
        // The Municipality dropdown is disabled in this state anyway.
        if (selectedIds.Any())
            await LoadMunicipalitiesForProvincesAsync(selectedIds);
    }
    private async Task OnMunicipalityMultiSelectChanged(List<int> newSelectedIds)
    {
        var previousIds = State.SelectedMunicipalityIds.ToList();
        State.SelectedMunicipalityIds = newSelectedIds;

        var removedMunicipalityIds = previousIds.Except(newSelectedIds).ToList();
        var addedMunicipalityIds = newSelectedIds.Except(previousIds).ToList();

        // ✅ Drop cached barangays for municipalities that were just unchecked
        foreach (var muniId in removedMunicipalityIds)
            filterBarangayCache.Remove(muniId);

        // ✅ Fetch barangays only for newly-checked municipalities not already cached
        if (addedMunicipalityIds.Any())
            await FetchAndCacheBarangaysAsync(addedMunicipalityIds);

        // ✅ Rebuild the visible Barangay <select> options from the CURRENT
        // full Municipality selection, pulling only from cache. This is what
        // actually drops barangays belonging to unchecked municipalities and
        // adds barangays for newly-checked ones.
        var idsToShowFrom = newSelectedIds.Any()
            ? newSelectedIds
            : State.FilterMunicipalities.Select(m => m.PsgcCodeMunicipality).ToList();

        var combined = new List<BarangayLookupDto>();
        foreach (var muniId in idsToShowFrom)
        {
            if (filterBarangayCache.TryGetValue(muniId, out var cached))
                combined.AddRange(cached);
        }

        State.FilterBarangays = combined
            .DistinctBy(b => b.PsgcCodeBarangay)
            .OrderBy(b => b.Name)
            .ToList();

        // ✅ If the currently-selected Barangay no longer exists in the
        // rebuilt list (its municipality was unchecked), clear the selection
        if (State.SelectedBarangayId != 0 &&
            !State.FilterBarangays.Any(b => b.PsgcCodeBarangay == State.SelectedBarangayId))
        {
            State.SelectedBarangayId = 0;
        }

        StateHasChanged();
    }

    // ✅ Fetches and caches barangays ONLY for the municipality IDs passed in.
    // Does not touch State.FilterBarangays — the caller rebuilds that from
    // the full current selection afterward, so this stays a pure cache-filler.
    private async Task FetchAndCacheBarangaysAsync(List<int> municipalityIds)
    {
        try
        {
            IsFilterBarangayLoading = true;

            var response = await Http.PostAsJsonAsync(
                "api/Barangay/by-municipalities",
                new LookupMultiRequestDto { Ids = municipalityIds });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<BarangayLookupDto>>() ?? new();

                foreach (var muniId in municipalityIds)
                {
                    filterBarangayCache[muniId] = result
                        .Where(b => b.PsgcCodeMunicipality == muniId)
                        .ToList();
                }
            }
        }
        finally
        {
            IsFilterBarangayLoading = false;
            StateHasChanged();
        }
    }

