@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject ToastService toast
@inject HttpClient Http
@inject BeneficiaryStateService State
@inject IJSRuntime JS

<div class="row mb-4">
        <div class="col-12">
            <HxCard Class="shadow-sm border-0">
                <BodyTemplate>
                <HxCardTitle>
                        <div class="card-header bg-primary text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="mb-0">Filter Grantees to show Records</h4>
                                    <small class="opacity-75">Search and narrow down Grantee records</small>
                                </div>
                            </div>
                        </div>
                </HxCardTitle>

                <!-- Location -->
                <div class="mb-4">
                    <h6 class="text-primary mb-3">Location</h6>
                    <div class="row g-3">

                        <!-- Province -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label">Province</label>
                            <select class="form-select"
                                    @key="provinceSelectKey"
                                    value="@selectedProvinceId"
                                    @onchange="OnProvinceChanged"
                                    disabled="@(IsLoading || IsFilterProvinceLoading)">
                                <option value="0">Select Province</option>
                                @foreach (var p in filterProvinces)
                                {
                                    <option value="@p.PsgcCodeProvince">@p.Name</option>
                                }
                            </select>
                            @if (IsFilterProvinceLoading)
                            {
                                <div class="small text-primary mt-1">
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    Loading provinces...
                                </div>
                            }
                        </div>

                        <!-- Municipality -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label">Municipality</label>
                            <select class="form-select"
                                    @key="municipalitySelectKey"
                                    value="@selectedMunicipalityId"
                                    @onchange="OnMunicipalityChanged"
                                    disabled="@(IsLoading || selectedProvinceId == 0 || IsFilterMunicipalityLoading)">
                                <option value="0">-- Select Municipality --</option>
                                @foreach (var m in filterMunicipalities)
                                {
                                    <option value="@m.PsgcCodeMunicipality">@m.Name</option>
                                }
                            </select>
                            @if (IsFilterMunicipalityLoading)
                            {
                                <div class="small text-primary mt-1">
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    Loading municipalities...
                                </div>
                            }
                        </div>

                        <!-- Barangay -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label">Barangay</label>
                            <select class="form-select"
                                    @key="barangaySelectKey"
                                    value="@selectedBarangayId"
                                    @onchange="OnBarangayChanged"
                                    disabled="@(IsLoading || selectedMunicipalityId == 0 || IsFilterBarangayLoading)">
                                <option value="0">-- Select Barangay --</option>
                                @foreach (var b in filterBarangays)
                                {
                                    <option value="@b.PsgcCodeBarangay">@b.Name</option>
                                }
                            </select>
                            @if (IsFilterBarangayLoading)
                            {
                                <div class="small text-primary mt-1">
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    Loading barangays...
                                </div>
                            }
                        </div>

                    </div>
                </div>

                <!-- Personal Filters -->
                <div class="mb-4">
                    <h6 class="text-primary mb-3">Personal Filters</h6>
                    <div class="row g-3">

                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label">Full Name</label>
                            <input type="text" class="form-control"
                                   placeholder="Search by name..."
                                   @bind="filterModel.FullName"
                                   @bind:event="oninput" />
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label">Last Name</label>
                            <input type="text" class="form-control"
                                   placeholder="Enter last name"
                                   @bind="filterModel.LastName" />
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label">First Name</label>
                            <input type="text" class="form-control"
                                   placeholder="Enter first name"
                                   @bind="filterModel.FirstName" />
                        </div>

                        <!-- Sex -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label">Sex</label>
                            <select class="form-select"
                                    value="@selectedSex"
                                    @onchange="OnSexChanged"
                                    disabled="@IsLoading">
                                <option value="0">-- Select Sex --</option>
                                <option value="1">Male</option>
                                <option value="2">Female</option>
                            </select>
                        </div>

                        <!-- Payment Status -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label">Payment Status</label>
                            <select class="form-select"
                                    value="@selectedPaymentStatus"
                                    @onchange="OnPaymentStatusChanged"
                                    disabled="@IsLoading">
                                <option value="-1">-- Select Status --</option>
                                <option value="0">N/A</option>
                                <option value="1">Unpaid</option>
                                <option value="2">Paid</option>
                            </select>
                        </div>

                    </div>
                </div>

                    <!-- Age & Other Filters -->
                    <div class="mb-4">
                        <h6 class="text-primary mb-3">Age Filters</h6>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label">Specific Age</label>
                                <input type="number" class="form-control" placeholder="e.g. 80" @bind="filterModel.SpecificAge" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Validator</label>
                                <input type="text" class="form-control" placeholder="Validator" @bind="filterModel.Validator" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">BatchCode</label>
                                <input type="text" class="form-control" placeholder="Batch Code" @bind="filterModel.BatchCode" />
                            </div>
                        </div>
                    </div>

                    <!-- Birthday Filters -->
                    <div>
                        <h6 class="text-primary mb-3">Birthday Filters</h6>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label">Specific Birthday</label>
                                <input type="date" class="form-control" @bind="filterModel.SpecificBirthday" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Birthday From</label>
                                <input type="date" class="form-control" @bind="filterModel.BirthdayFrom" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Birthday To</label>
                                <input type="date" class="form-control" @bind="filterModel.BirthdayTo" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">Milestone Year</label>
                            <InputSelect @bind-Value="filterModel.MilestoneYear" class="form-select">
                                <option value="">-- Select Year --</option>
                                @for (int year = DateTime.Now.Year; year >= 2024; year--)
                                {
                                    <option value="@year">@year</option>
                                }
                            </InputSelect>
                            </div>

                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <HxButton Color="ThemeColor.Secondary" Size="ButtonSize.Small" @onclick="ClearFilterAsync">
                            Clear Filters
                        </HxButton>
                        <HxButton Color="ThemeColor.Primary" Size="ButtonSize.Small" @onclick="ApplyFiltersAsync" Disabled="@(IsApplyingFilters || IsLoading)">
                            @if (IsApplyingFilters)
                            {
                                <span>Applying...</span>
                            }
                            else
                            {
                                <span>Apply Filters</span>
                            }
                        </HxButton>

                    </div>
            </BodyTemplate>
            </HxCard>
        </div>
    </div>
@code {
    private bool showProvinceDropdown;
    private bool showMunicipalityDropdown;
    private bool showBarangayDropdown;
    private bool showSexDropdown;
    private bool showPaymentStatusDropdown;
    private bool IsProvinceLoading;
    private string? errorMessage;
    private int bulkPaymentStatus = 0;
    private string? fullNameFilter;
    private const int DefaultRegionCode = 1600000000;
    private int totalCount;
    private int totalPages;

    private bool IsLoading = false;
    private bool IsMunicipalityDisabled = true;
    private bool IsBarangayDisabled = true;
    private bool IsFilterProvinceLoading = false;
    private bool IsFilterMunicipalityLoading = false;
    private bool IsFilterBarangayLoading = false;
    private bool IsApplyingFilters = false;

    private int selectedProvinceId = 0;
    private int selectedBarangayId = 0;
    private HashSet<int> selectedMunicipalityIds = new();
    private HashSet<int> selectedSexes = new();
    private HashSet<int> selectedPaymentStatuses = new();

    private HashSet<Guid> checkedIds = new();

    #region Filter dropdowns
    private List<ProvinceLookupDto> filterProvinces = new();
    private List<MunicipalityLookupDto> filterMunicipalities = new();
    private List<BarangayLookupDto> filterBarangays = new();

    private List<ProvinceLookupDto> provinces = new();
    private List<MunicipalityLookupDto> municipalities = new();
    private List<BarangayLookupDto> barangays = new();

    // Cache — keyed by province id and municipality id
    private Dictionary<int, List<MunicipalityLookupDto>> filterMunicipalityCache = new();
    private Dictionary<int, List<BarangayLookupDto>> filterBarangayCache = new();


    #endregion
    private List<BeneficiaryInformationDto> beneficiaries = new();
    private BeneficiaryInformationDto model = new();
    // ✅ Add reference to the dropdown container
    private ElementReference municipalityDropdownRef;
    private BeneficiaryFilterDto filterModel = new() { PageNumber = 1, PageSize = 10 };
    // ── Fields ────────────────────────────────────────────────
    private int selectedMunicipalityId = 0;
    private int selectedSex = 0;
    private int selectedPaymentStatus = -1;

    private int provinceSelectKey = 0;
    private int municipalitySelectKey = 0;
    private int barangaySelectKey = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterProvincesAsync(); // fills `filterProvinces` which the dropdown uses
    }


    // ── Province ──────────────────────────────────────────────
    private async Task OnProvinceChanged(ChangeEventArgs e)
    {
        selectedProvinceId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        selectedMunicipalityId = 0;
        selectedBarangayId = 0;
        filterMunicipalities.Clear();
        filterBarangays.Clear();

        if (selectedProvinceId > 0)
            await LoadMunicipalitiesAsync(selectedProvinceId);
    }

    // ── Municipality ──────────────────────────────────────────
    private async Task OnMunicipalityChanged(ChangeEventArgs e)
    {
        selectedMunicipalityId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        selectedBarangayId = 0;
        filterBarangays.Clear();

        if (selectedMunicipalityId > 0)
            await LoadBarangaysAsync(selectedMunicipalityId);
    }

    // ── Barangay ──────────────────────────────────────────────
    private void OnBarangayChanged(ChangeEventArgs e)
    {
        selectedBarangayId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    }

    // ── Sex ───────────────────────────────────────────────────
    private void OnSexChanged(ChangeEventArgs e)
    {
        selectedSex = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    }

    // ── Payment Status ────────────────────────────────────────
    private void OnPaymentStatusChanged(ChangeEventArgs e)
    {
        selectedPaymentStatus = int.TryParse(e.Value?.ToString(), out var id) ? id : -1;
    }

    // ── Loaders ───────────────────────────────────────────────
    private async Task LoadFilterProvincesAsync()
    {
        if (filterProvinces.Any()) return;
        try
        {
            IsFilterProvinceLoading = true;
            filterProvinces = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>(
                $"api/Province/by-region/{DefaultRegionCode}") ?? new();
        }
        finally
        {
            IsFilterProvinceLoading = false;
        }
    }

    // ── Apply ─────────────────────────────────────────────────
    private async Task ApplyFiltersAsync()
    {
        if (IsLoading || IsApplyingFilters) return;
        try
        {
            IsApplyingFilters = true;

            // Hierarchy: most specific wins
            if (selectedBarangayId > 0)
            {
                State.Filter.PsgcCodeBarangays = new List<int> { selectedBarangayId };
                State.Filter.PsgcCodeMunicipalities = new List<int>();
                State.Filter.PsgcCodeProvinces = new List<int>();
            }
            else if (selectedMunicipalityId > 0)
            {
                State.Filter.PsgcCodeBarangays = new List<int>();
                State.Filter.PsgcCodeMunicipalities = new List<int> { selectedMunicipalityId };
                State.Filter.PsgcCodeProvinces = new List<int>();
            }
            else if (selectedProvinceId > 0)
            {
                State.Filter.PsgcCodeBarangays = new List<int>();
                State.Filter.PsgcCodeMunicipalities = new List<int>();
                State.Filter.PsgcCodeProvinces = new List<int> { selectedProvinceId };
            }
            else
            {
                State.Filter.PsgcCodeBarangays = new List<int>();
                State.Filter.PsgcCodeMunicipalities = new List<int>();
                State.Filter.PsgcCodeProvinces = new List<int>();
            }

            // Sex — single value into list
            State.Filter.Sexes = selectedSex > 0
                ? new List<int> { selectedSex }
                : new List<int>();

            // Payment status — single value into list
            State.Filter.PaymentStatuses = selectedPaymentStatus >= 0
                ? new List<int> { selectedPaymentStatus }
                : new List<int>();

            // Text / date fields
            State.Filter.FullName = filterModel.FullName;
            State.Filter.LastName = filterModel.LastName;
            State.Filter.FirstName = filterModel.FirstName;
            State.Filter.Validator = filterModel.Validator;
            State.Filter.BatchCode = filterModel.BatchCode;
            State.Filter.SpecificAge = filterModel.SpecificAge;
            State.Filter.SpecificBirthday = filterModel.SpecificBirthday;
            State.Filter.BirthdayFrom = filterModel.BirthdayFrom;
            State.Filter.BirthdayTo = filterModel.BirthdayTo;
            State.Filter.MilestoneYear = filterModel.MilestoneYear;
            State.Filter.PageNumber = 1;

            if (IsFilterEmpty(State.Filter))
            {
                toast.ShowError("Please select or input at least one filter.");
                return;
            }

            await State.LoadAsync();
        }
        finally
        {
            IsApplyingFilters = false;
        }
    }

    private async Task ClearFilterAsync()
    {
        selectedProvinceId = 0;
        selectedMunicipalityId = 0;
        selectedBarangayId = 0;
        selectedSex = 0;
        selectedPaymentStatus = -1;
        filterMunicipalities.Clear();
        filterBarangays.Clear();
        errorMessage = null;

        // ✅ Clear caches so next selection fetches fresh data
        filterMunicipalityCache.Clear();
        filterBarangayCache.Clear();

        // Force DOM reset
        provinceSelectKey++;
        municipalitySelectKey++;
        barangaySelectKey++;

        filterModel = new BeneficiaryFilterDto { PageNumber = 1, PageSize = 10 };
        State.Filter = new BeneficiaryFilterDto { PageNumber = 1, PageSize = 10 };
        State.ClearData();

        filterProvinces.Clear();
        await LoadFilterProvincesAsync();
        StateHasChanged();
    }

    // ── Helpers ───────────────────────────────────────────────
    private bool IsFilterEmpty(BeneficiaryFilterDto f) =>
        string.IsNullOrWhiteSpace(f.FullName) &&
        string.IsNullOrWhiteSpace(f.LastName) &&
        string.IsNullOrWhiteSpace(f.FirstName) &&
        string.IsNullOrWhiteSpace(f.Validator) &&
        string.IsNullOrWhiteSpace(f.BatchCode) &&
        f.SpecificAge == null &&
        f.SpecificBirthday == null &&
        f.BirthdayFrom == null &&
        f.BirthdayTo == null &&
        f.MilestoneYear == null &&
        (f.PsgcCodeProvinces == null || !f.PsgcCodeProvinces.Any()) &&
        (f.PsgcCodeMunicipalities == null || !f.PsgcCodeMunicipalities.Any()) &&
        (f.PsgcCodeBarangays == null || !f.PsgcCodeBarangays.Any()) &&
        (f.Sexes == null || !f.Sexes.Any()) &&
        (f.PaymentStatuses == null || !f.PaymentStatuses.Any());
    private async Task LoadMunicipalitiesAsync(int provinceId)
    {
        if (filterMunicipalityCache.TryGetValue(provinceId, out var cached))
        {
            // ✅ Don't use cache if it's empty — re-fetch instead
            if (cached.Any())
            {
                filterMunicipalities = cached;
                StateHasChanged();
                return;
            }
            // Remove bad cache entry and fall through to re-fetch
            filterMunicipalityCache.Remove(provinceId);
        }

        try
        {
            IsFilterMunicipalityLoading = true;
            var response = await Http.PostAsJsonAsync(
                "api/Municipality/by-provinces",
                new LookupMultiRequestDto { Ids = new List<int> { provinceId } });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content
                    .ReadFromJsonAsync<List<MunicipalityLookupDto>>() ?? new();

                filterMunicipalities = result;

                // ✅ Only cache if we actually got data
                if (result.Any())
                    filterMunicipalityCache[provinceId] = result;
            }
        }
        finally
        {
            IsFilterMunicipalityLoading = false;
            StateHasChanged();
        }
    }
    private async Task LoadBarangaysAsync(int municipalityId)
    {
        if (filterBarangayCache.TryGetValue(municipalityId, out var cached))
        {
            // ✅ Don't use empty cache
            if (cached.Any())
            {
                filterBarangays = cached;
                StateHasChanged();
                return;
            }
            filterBarangayCache.Remove(municipalityId);
        }

        try
        {
            IsFilterBarangayLoading = true;
            var response = await Http.PostAsJsonAsync(
                "api/Barangay/by-municipalities",
                new LookupMultiRequestDto { Ids = new List<int> { municipalityId } });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content
                    .ReadFromJsonAsync<List<BarangayLookupDto>>() ?? new();

                filterBarangays = result;

                // ✅ Only cache if we got data
                if (result.Any())
                    filterBarangayCache[municipalityId] = result;
            }
        }
        finally
        {
            IsFilterBarangayLoading = false;
            StateHasChanged();
        }
    }
    private string GetQueryString(BeneficiaryFilterDto filter)
    {
        var properties = from p in filter.GetType().GetProperties()
                         let value = p.GetValue(filter, null)
                         where value != null
                         select new { p.Name, Value = value };

        var queryString = new List<string>();

        foreach (var prop in properties)
        {
            // Check if the property is a List/Enumerable (but not a string)
            if (prop.Value is System.Collections.IEnumerable list && !(prop.Value is string))
            {
                foreach (var item in list)
                {
                    queryString.Add($"{prop.Name}={Uri.EscapeDataString(item.ToString() ?? "")}");
                }
            }
            else
            {
                queryString.Add($"{prop.Name}={Uri.EscapeDataString(prop.Value.ToString() ?? "")}");
            }
        }

        return string.Join("&", queryString);
    }
    private async Task LoadBeneficiariesAsync()
    {
        try
        {
            IsLoading = true;
            errorMessage = null;
            checkedIds.Clear();

            // 2. Automatically generate the full query string
            var query = GetQueryString(filterModel);

            // 3. Call the API
            var paginatedResult = await Http.GetFromJsonAsync<PagedResultDto<BeneficiaryInformationDto>>(
                $"api/beneficiary/paged?{query}");

            beneficiaries = paginatedResult?.Items?.ToList() ?? new List<BeneficiaryInformationDto>();
            totalCount = paginatedResult?.TotalCount ?? 0;
            totalPages = paginatedResult?.TotalPages ?? 0;
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load grantees. {ex.Message}";
            beneficiaries = new List<BeneficiaryInformationDto>();
        }
        finally
        {
            IsLoading = false;
        }
    }
   #region Lookup DTOS
    public class LogsLookupDto
    {
        public Guid Id { get; set; }
        public Guid BeneficiaryInformationId { get; set; }
        public string Activity { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }

    public class RegionLookupDto
    {
        public int PsgcCodeRegion { get; set; }
        public string Name { get; set; } = string.Empty;
    }
    public class ProvinceLookupDto
    {
        public int PsgcCodeRegion { get; set; }
        public int PsgcCodeProvince { get; set; }
        public string Name { get; set; } = string.Empty;
    }
    public class MunicipalityLookupDto
    {
        public int PsgcCodeProvince { get; set; }
        public int PsgcCodeMunicipality { get; set; }
        public string Name { get; set; } = string.Empty;
    }
    public class BarangayLookupDto
    {
        public int PsgcCodeMunicipality { get; set; }
        public int PsgcCodeBarangay { get; set; }
        public string Name { get; set; } = string.Empty;
    }
   #endregion Lookup DTOS - End
}
