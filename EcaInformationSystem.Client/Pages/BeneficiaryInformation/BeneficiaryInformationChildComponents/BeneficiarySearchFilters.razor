    protected override async Task OnInitializedAsync()
    {
        await LoadFilterRegionsAsync();

        if (State.SelectedRegionId > 0 && !State.FilterProvinces.Any())
            await LoadFilterProvincesAsync(State.SelectedRegionId);

        if (State.SelectedProvinceIds.Any() && !State.FilterMunicipalities.Any())
            await LoadMunicipalitiesForProvincesAsync(State.SelectedProvinceIds);

        if (State.SelectedMunicipalityIds.Any() && !State.FilterBarangays.Any())
            await FetchAndCacheBarangaysAsync(State.SelectedMunicipalityIds);
    }

    private void OnComplianceChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _complianceValue = val ?? string.Empty;

        // ✅ Map to both fields so backward compat is preserved
        switch (val)
        {
            case "compliant":
                State.Filter.IsCompliant = true;
                State.Filter.ComplianceMode = "compliant";
                break;
            case "noncompliant":
                State.Filter.IsCompliant = false;
                State.Filter.ComplianceMode = "noncompliant";
                break;
            case "withfindings":
                State.Filter.IsCompliant = true; // still compliant
                State.Filter.ComplianceMode = "withfindings";
                break;
            default:
                State.Filter.IsCompliant = null;
                State.Filter.ComplianceMode = null;
                break;
        }
    }
