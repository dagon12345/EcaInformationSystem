@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject ToastService toast
@inject HttpClient Http
@inject BeneficiaryStateService State
@inject IJSRuntime JS

<div class="sf-wrap">
    <div class="sf-card">

        @* ── HEADER (clickable to collapse) ── *@
        <div class="sf-header" @onclick="ToggleCollapse">
            <div class="sf-header-left">
                <div class="sf-header-icon">
                    <i class="bi bi-funnel-fill"></i>
                </div>
                <div>
                    <p class="sf-header-title">Filter Grantees</p>
                    <p class="sf-header-sub">Search and narrow down records</p>
                </div>
            </div>
            <i class="bi bi-chevron-down sf-chevron @(_collapsed ? "" : "open")"></i>
        </div>

        @* ── BODY ── *@
        @if (!_collapsed)
        {
            <div class="sf-body">

                @* LOCATION *@
                <div>
                    <div class="sf-section-label"><i class="bi bi-geo-alt me-1"></i>Location</div>
                    <div class="sf-grid">

                        @* Region *@
                        <div class="sf-field">
                            <label>Region</label>
                            <select value="@State.SelectedRegionId" @onchange="OnRegionChanged"
                                    disabled="@(IsLoading || IsFilterRegionLoading)">
                                <option value="0">All Regions</option>
                                @foreach (var r in State.FilterRegions)
                                {
                                    <option value="@r.PsgcCodeRegion">@r.Name</option>
                                }
                            </select>
                            @if (IsFilterRegionLoading)
                            {
                                <span class="sf-loading-pill">
                                    <span class="spinner-border spinner-border-sm"></span> Loading...
                                </span>
                            }
                        </div>

                        @* Province *@
                        <div class="sf-field">
                            <label>Province</label>
                            <select value="@State.SelectedProvinceId" @onchange="OnProvinceChanged"
                                    disabled="@(IsLoading || IsFilterProvinceLoading || State.SelectedRegionId == 0)">
                                <option value="0">Select Province</option>
                                @foreach (var p in State.FilterProvinces)
                                {
                                    <option value="@p.PsgcCodeProvince">@p.Name</option>
                                }
                            </select>
                            @if (IsFilterProvinceLoading)
                            {
                                <span class="sf-loading-pill">
                                    <span class="spinner-border spinner-border-sm"></span> Loading...
                                </span>
                            }
                        </div>

                        @* Municipality *@
                        <div class="sf-field">
                            <label>Municipality</label>
                            <select value="@State.SelectedMunicipalityId" @onchange="OnMunicipalityChanged"
                                    disabled="@(IsLoading || State.SelectedProvinceId == 0 || IsFilterMunicipalityLoading)">
                                <option value="0">Select Municipality</option>
                                @foreach (var m in State.FilterMunicipalities)
                                {
                                    <option value="@m.PsgcCodeMunicipality">@m.Name</option>
                                }
                            </select>
                            @if (IsFilterMunicipalityLoading)
                            {
                                <span class="sf-loading-pill">
                                    <span class="spinner-border spinner-border-sm"></span> Loading...
                                </span>
                            }
                        </div>

                        @* Barangay *@
                        <div class="sf-field">
                            <label>Barangay</label>
                            <select value="@State.SelectedBarangayId" @onchange="OnBarangayChanged"
                                    disabled="@(IsLoading || State.SelectedMunicipalityId == 0 || IsFilterBarangayLoading)">
                                <option value="0">Select Barangay</option>
                                @foreach (var b in State.FilterBarangays)
                                {
                                    <option value="@b.PsgcCodeBarangay">@b.Name</option>
                                }
                            </select>
                            @if (IsFilterBarangayLoading)
                            {
                                <span class="sf-loading-pill">
                                    <span class="spinner-border spinner-border-sm"></span> Loading...
                                </span>
                            }
                        </div>

                    </div>
                </div>

                @* PERSONAL *@
                <div>
                    <div class="sf-section-label"><i class="bi bi-person me-1"></i>Personal</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>Full Name</label>
                            <input type="text" placeholder="Search by name..." @bind="State.Filter.FullName"
                                   @bind:event="oninput" />
                        </div>
                        <div class="sf-field">
                            <label>Last Name</label>
                            <input type="text" placeholder="Last name" @bind="State.Filter.LastName" />
                        </div>
                        <div class="sf-field">
                            <label>First Name</label>
                            <input type="text" placeholder="First name" @bind="State.Filter.FirstName" />
                        </div>
                        <div class="sf-field">
                            <label>Sex</label>
                            <select value="@State.Filter.Sex" @onchange="OnSexChanged" disabled="@IsLoading">
                                <option value="0">Select Sex</option>
                                <option value="1">Male</option>
                                <option value="2">Female</option>
                            </select>
                        </div>
                        <div class="sf-field">
                            <label>Batch Code</label>
                            <input type="text" placeholder="e.g. 123-45 or 123-45, 678-90" @bind="State.Filter.BatchCode" />
                        </div>
                        @* CO STATUS *@
                        <div class="sf-field">
                            <label>CO Status</label>
                            <select value="@_coStatusValue" @onchange="OnCoStatusFilterChanged" disabled="@IsLoading">
                                <option value="-1">Select CO Status</option>
                                <option value="0">Not Set</option>
                                <option value="1">Endorsed</option>
                                <option value="2">Approved</option>
                            </select>
                        </div>
                        <div class="sf-field">
                            <label>Validator</label>
                            <input type="text" placeholder="Validator" @bind="State.Filter.Validator" />
                        </div>
                        <div class="sf-field">
                            <label>Findings</label>
                            <select value="@State.Filter.FindingStatus" @onchange="OnFindingStatusChanged"
                                    disabled="@IsLoading">
                                <option value="3">Select Findings</option>
                                <option value="0">N/A</option>
                                <option value="1">Solved</option>
                                <option value="2">Unresolved</option>
                            </select>
                        </div>
                        <div class="sf-field">
                            <label>Compliance</label>
                            <select value="@_complianceValue" @onchange="OnComplianceChanged" disabled="@IsLoading">
                                <option value="">Select Compliance</option>
                                <option value="compliant">Compliant</option>
                                <option value="noncompliant">Non-Compliant</option>
                                <option value="withfindings">Compliant w/ Findings</option>
                            </select>
                        </div>

                        <div class="sf-field">
                            <label>Eligibility</label>
                            <select value="@_eligibilityValue" @onchange="OnEligibilityChanged" disabled="@IsLoading">
                                <option value="">Select Eligibility</option>
                                <option value="eligible">Eligible</option>
                                <option value="ineligible">Ineligible</option>
                                <option value="withfindings">Eligible w/ Findings</option>
                            </select>
                        </div>
                    </div>
                </div>

                @* PAYMENT *@
                <div>
                    <div class="sf-section-label"><i class="bi bi-credit-card me-1"></i>Payment</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>Payment Status</label>
                            <select value="@State.Filter.PaymentStatus" @onchange="OnPaymentStatusChanged"
                                    disabled="@IsLoading">
                                <option value="-1">Select Payment Status</option>
                                <option value="0">N/A</option>
                                <option value="1">Unpaid</option>
                                <option value="2">Paid</option>
                                <option value="3">Pending</option>
                            </select>
                        </div>
                        <div class="sf-field">
                            <label>Payment Date</label>
                            <input type="date" @bind="State.Filter.PaymentDate" />
                        </div>
                    </div>
                </div>

                @* AGE & BIRTHDAY *@
                <div>
                    <div class="sf-section-label"><i class="bi bi-calendar3 me-1"></i>Age & Birthday</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>Specific Age</label>
                            <input type="number" placeholder="e.g. 80" @bind="State.Filter.SpecificAge" />
                        </div>
                        <div class="sf-field">
                            <label>Milestone Year</label>
                            <select @bind="State.Filter.MilestoneYear">
                                <option value="">-- Select --</option>
                                <option value="0">No Milestone (0)</option>
                                @for (int y = DateTime.Now.Year; y >= 2024; y--)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>

                        @* Specific Birthday — Month + Day only *@
                        <div class="sf-field">
                            <label>Specific Birthday</label>
                            <div class="sf-inline">
                                <select @bind="_specificBirthdayMonth" disabled="@IsLoading"
                                        class="@(_specificBirthdayMonth > 0 && _specificBirthdayDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Month</option>
                                    @foreach (var m in _months)
                                    {
                                        <option value="@m.Value">@m.Label</option>
                                    }
                                </select>
                                <select @bind="_specificBirthdayDay" disabled="@(IsLoading || _specificBirthdayMonth == 0)"
                                        class="@(_specificBirthdayMonth > 0 && _specificBirthdayDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Day</option>
                                    @foreach (var d in GetDaysForMonth(_specificBirthdayMonth))
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            </div>
                            @if (_specificBirthdayMonth > 0 && _specificBirthdayDay == 0)
                            {
                                <span class="sf-field-error">Please select a day.</span>
                            }
                        </div>

                        @* Birthday From — Month + Day only *@
                        <div class="sf-field">
                            <label>Birthday From</label>
                            <div class="sf-inline">
                                <select @bind="_birthdayFromMonth" disabled="@IsLoading"
                                        class="@(_birthdayFromMonth > 0 && _birthdayFromDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Month</option>
                                    @foreach (var m in _months)
                                    {
                                        <option value="@m.Value">@m.Label</option>
                                    }
                                </select>
                                <select @bind="_birthdayFromDay" disabled="@(IsLoading || _birthdayFromMonth == 0)"
                                        class="@(_birthdayFromMonth > 0 && _birthdayFromDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Day</option>
                                    @foreach (var d in GetDaysForMonth(_birthdayFromMonth))
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            </div>
                            @if (_birthdayFromMonth > 0 && _birthdayFromDay == 0)
                            {
                                <span class="sf-field-error">Please select a day.</span>
                            }
                        </div>

                        @* Birthday To — Month + Day only *@
                        <div class="sf-field">
                            <label>Birthday To</label>
                            <div class="sf-inline">
                                <select @bind="_birthdayToMonth" disabled="@IsLoading"
                                        class="@(_birthdayToMonth > 0 && _birthdayToDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Month</option>
                                    @foreach (var m in _months)
                                    {
                                        <option value="@m.Value">@m.Label</option>
                                    }
                                </select>
                                <select @bind="_birthdayToDay" disabled="@(IsLoading || _birthdayToMonth == 0)"
                                        class="@(_birthdayToMonth > 0 && _birthdayToDay == 0 ? "sf-select-error" : "")">
                                    <option value="0">Day</option>
                                    @foreach (var d in GetDaysForMonth(_birthdayToMonth))
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            </div>
                            @if (_birthdayToMonth > 0 && _birthdayToDay == 0)
                            {
                                <span class="sf-field-error">Please select a day.</span>
                            }
                        </div>

                    </div>
                </div>
                @* ── GENERAL SEARCH ── *@
                <div>
                    <div class="sf-section-label"><i class="bi bi-globe me-1"></i>General Search</div>
                    <div class="sf-general-search mb-3">
                        <div class="sf-search-wrap">
                            <i class="bi bi-search sf-search-icon"></i>
                            <input type="text" class="sf-search-input"
                                   placeholder="Search anything — name, batch code, barangay, paid, male, 1926..."
                                   @bind="State.Filter.GeneralSearch" @bind:event="oninput" disabled="@IsLoading" />
                            @if (!string.IsNullOrWhiteSpace(State.Filter.GeneralSearch))
                            {
                                <button class="sf-search-clear" @onclick="ClearGeneralSearch" title="Clear search">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(State.Filter.GeneralSearch))
                        {
                            <small class="text-muted mt-1 d-block">
                                <i class="bi bi-info-circle me-1"></i>
                                Searching all columns for
                                <strong>"@State.Filter.GeneralSearch"</strong>
                            </small>
                        }
                    </div>
                </div>

                @* ACTIONS *@
                <div class="sf-actions">
                    <button class="sf-btn sf-btn-clear" @onclick="ClearFilterAsync">
                        <i class="bi bi-x-circle"></i> Clear
                    </button>
                    <button class="sf-btn sf-btn-apply" @onclick="ApplyFiltersAsync"
                            disabled="@(IsApplyingFilters || IsLoading)">
                        @if (IsApplyingFilters)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Applying...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Apply Filters</span>
                        }
                    </button>
                </div>

            </div>
        }
    </div>
</div>

@code {

    // ── Birthday state ────────────────────────────────────────────────
    private int _specificBirthdayMonth = 0;
    private int _specificBirthdayDay = 0;
    private int _birthdayFromMonth = 0;
    private int _birthdayFromDay = 0;
    private int _birthdayToMonth = 0;
    private int _birthdayToDay = 0;
    private record MonthItem(int Value, string Label);
    private readonly List<MonthItem> _months = new()
    {
        new(1, "January"),
        new(2, "February"),
        new(3, "March"),
        new(4, "April"),
        new(5, "May"),
        new(6, "June"),
        new(7, "July"),
        new(8, "August"),
        new(9, "September"),
        new(10, "October"),
        new(11, "November"),
        new(12, "December"),
    };
    private string _coStatusValue = "-1";
    private void OnCoStatusFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _coStatusValue = val ?? "-1";

        if (int.TryParse(val, out var parsed) && parsed >= 0)
            State.Filter.CoStatus = parsed; // 0 = Not Set, 1 = Endorsed, 2 = Approved
        else
            State.Filter.CoStatus = null; // -1 = no filter
    }
    // Use a fixed leap year (2000) so February always shows up to day 29
    private static IEnumerable<int> GetDaysForMonth(int month)
    {
        if (month == 0) return Enumerable.Empty<int>();
        var days = DateTime.DaysInMonth(2000, month); // 2000 is a leap year
        return Enumerable.Range(1, days);
    }

    // Build a nullable DateTime from month+day inputs using a fixed year
    private static DateTime? BuildMonthDay(int month, int day)
    {
        if (month == 0 || day == 0) return null;
        return new DateTime(2000, month, day); // year is ignored by the filter
    }

    private bool IsLoading = false;
    private bool IsFilterRegionLoading = false;
    private bool IsFilterProvinceLoading = false;
    private bool IsFilterMunicipalityLoading = false;
    private bool IsFilterBarangayLoading = false;
    private bool IsApplyingFilters = false;
    private bool _collapsed = false; // starts expanded

    private Dictionary<int, List<MunicipalityLookupDto>> filterMunicipalityCache = new();
    private Dictionary<int, List<BarangayLookupDto>> filterBarangayCache = new();

    private int provinceSelectKey = 0;
    private int municipalitySelectKey = 0;
    private int barangaySelectKey = 0;
    private string _complianceValue = string.Empty;

    private void ToggleCollapse() => _collapsed = !_collapsed;
    private string _eligibilityValue = string.Empty;
    private CancellationTokenSource? _generalSearchCts;

    private async Task OnGeneralSearchInput(ChangeEventArgs e)
    {
        State.Filter.GeneralSearch = e.Value?.ToString();
    }

    private async Task ClearGeneralSearch()
    {
        State.Filter.GeneralSearch = null;
        State.Filter.PageNumber = 1;
        await State.LoadAsync();
    }

    private void OnEligibilityChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _eligibilityValue = val ?? string.Empty;
        switch (val)
        {
            case "eligible":
                State.Filter.IsEligible = true;
                State.Filter.EligibilityMode = "eligible";
                break;
            case "ineligible":
                State.Filter.IsEligible = false;
                State.Filter.EligibilityMode = "ineligible";
                break;
            case "withfindings":
                State.Filter.IsEligible = true;
                State.Filter.EligibilityMode = "withfindings";
                break;
            default:
                State.Filter.IsEligible = null;
                State.Filter.EligibilityMode = null;
                break;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterRegionsAsync();

        // Restore cascade if selections were persisted (e.g. back-navigation)
        if (State.SelectedRegionId > 0 && !State.FilterProvinces.Any())
            await LoadFilterProvincesAsync(State.SelectedRegionId);

        if (State.SelectedProvinceId > 0 && !State.FilterMunicipalities.Any())
            await LoadMunicipalitiesAsync(State.SelectedProvinceId);

        if (State.SelectedMunicipalityId > 0 && !State.FilterBarangays.Any())
            await LoadBarangaysAsync(State.SelectedMunicipalityId);
    }

    private void OnComplianceChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _complianceValue = val ?? string.Empty;

        // ✅ Map to both fields so backward compat is preserved
        switch (val)
        {
            case "compliant":
                State.Filter.IsCompliant = true;
                State.Filter.ComplianceMode = "compliant";
                break;
            case "noncompliant":
                State.Filter.IsCompliant = false;
                State.Filter.ComplianceMode = "noncompliant";
                break;
            case "withfindings":
                State.Filter.IsCompliant = true; // still compliant
                State.Filter.ComplianceMode = "withfindings";
                break;
            default:
                State.Filter.IsCompliant = null;
                State.Filter.ComplianceMode = null;
                break;
        }
    }
    private async Task OnRegionChanged(ChangeEventArgs e)
    {
        State.SelectedRegionId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        State.SelectedProvinceId = 0;
        State.SelectedMunicipalityId = 0;
        State.SelectedBarangayId = 0;
        State.FilterProvinces = new();
        State.FilterMunicipalities = new();
        State.FilterBarangays = new();
        filterMunicipalityCache.Clear();
        filterBarangayCache.Clear();

        if (State.SelectedRegionId > 0)
            await LoadFilterProvincesAsync(State.SelectedRegionId);
    }

    private async Task OnProvinceChanged(ChangeEventArgs e)
    {
        State.SelectedProvinceId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        State.SelectedMunicipalityId = 0;
        State.SelectedBarangayId = 0;
        State.FilterMunicipalities = new();
        State.FilterBarangays = new();
        if (State.SelectedProvinceId > 0)
            await LoadMunicipalitiesAsync(State.SelectedProvinceId);
    }

    private async Task OnMunicipalityChanged(ChangeEventArgs e)
    {
        State.SelectedMunicipalityId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        State.SelectedBarangayId = 0;
        State.FilterBarangays.Clear();
        if (State.SelectedMunicipalityId > 0)
            await LoadBarangaysAsync(State.SelectedMunicipalityId);
    }

    private void OnBarangayChanged(ChangeEventArgs e)
    {
        State.SelectedBarangayId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    }

    private void OnSexChanged(ChangeEventArgs e)
    {
        State.Filter.Sex = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    }

    private void OnFindingStatusChanged(ChangeEventArgs e)
    {
        State.Filter.FindingStatus = int.TryParse(e.Value?.ToString(), out var id) ? id : 3;
    }


    private void OnPaymentStatusChanged(ChangeEventArgs e)
    {
        State.Filter.PaymentStatus = int.TryParse(e.Value?.ToString(), out var id) ? id : -1;
    }

    private async Task LoadFilterRegionsAsync()
    {
        if (State.FilterRegions.Any()) return;
        try
        {
            IsFilterRegionLoading = true;
            State.FilterRegions = await Http.GetFromJsonAsync<List<RegionLookupDto>>("api/Region") ?? new();
        }
        finally { IsFilterRegionLoading = false; StateHasChanged(); }
    }

    private async Task LoadFilterProvincesAsync(int regionCode)
    {
        try
        {
            IsFilterProvinceLoading = true;
            State.FilterProvinces = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>(
                $"api/Province/by-region/{regionCode}") ?? new();
        }
        finally { IsFilterProvinceLoading = false; StateHasChanged(); }
    }

    private async Task ApplyFiltersAsync()
    {
        if (IsLoading || IsApplyingFilters) return;

        IsApplyingFilters = true;

        try
        {
            // ── Validate month+day pairs before applying ───────────────────
            if (_specificBirthdayMonth > 0 && _specificBirthdayDay == 0)
            {
                toast.ShowError("Please select a day for Specific Birthday.");
                return;
            }

            if (_birthdayFromMonth > 0 && _birthdayFromDay == 0)
            {
                toast.ShowError("Please select a day for Birthday From.");
                return;
            }

            if (_birthdayToMonth > 0 && _birthdayToDay == 0)
            {
                toast.ShowError("Please select a day for Birthday To.");
                return;
            }

            // ── Validate that From is not the same as To ───────────────────
            if (_birthdayFromMonth > 0 && _birthdayFromDay > 0 &&
                _birthdayToMonth > 0 && _birthdayToDay > 0)
            {
                int fromMD = _birthdayFromMonth * 100 + _birthdayFromDay;
                int toMD = _birthdayToMonth * 100 + _birthdayToDay;

                if (fromMD == toMD)
                {
                    toast.ShowError("Birthday From and Birthday To cannot be the same date. Use Specific Birthday instead.");
                    return;
                }
            }

            // ── Validate Specific Birthday is not also set alongside From/To ──
            if (_specificBirthdayMonth > 0 && _specificBirthdayDay > 0 &&
                (_birthdayFromMonth > 0 || _birthdayToMonth > 0))
            {
                toast.ShowError("Cannot use Specific Birthday together with Birthday From or Birthday To.");
                return;
            }

            State.Filter.PsgcCodeRegion = State.SelectedRegionId > 0 ? State.SelectedRegionId : null;
            State.Filter.PsgcCodeProvince = State.SelectedProvinceId > 0 ? State.SelectedProvinceId : null;
            State.Filter.PsgcCodeMunicipality = State.SelectedMunicipalityId > 0 ? State.SelectedMunicipalityId : null;
            State.Filter.PsgcCodeBarangay = State.SelectedBarangayId > 0 ? State.SelectedBarangayId : null;

            // ── Map month+day selectors → filter DateTime fields ──────────
            State.Filter.SpecificBirthday = BuildMonthDay(_specificBirthdayMonth, _specificBirthdayDay);
            State.Filter.BirthdayFrom = BuildMonthDay(_birthdayFromMonth, _birthdayFromDay);
            State.Filter.BirthdayTo = BuildMonthDay(_birthdayToMonth, _birthdayToDay);

            State.Filter.PageNumber = 1;
            State.Filter.PageSize = 10;

            if (IsFilterEmpty(State.Filter))
            {
                toast.ShowError("Please select or input at least one filter.");
                return;
            }

            await State.LoadAsync();

            if (State.ErrorMessage is not null)
                toast.ShowError(State.ErrorMessage);
        }
        finally
        {
            IsApplyingFilters = false;
        }
    }

    private async Task ClearFilterAsync()
    {
        State.SelectedRegionId = 0;
        State.SelectedProvinceId = 0;
        State.SelectedMunicipalityId = 0;
        State.SelectedBarangayId = 0;
        State.FilterProvinces = new();
        State.FilterMunicipalities = new();
        State.FilterBarangays = new();
        filterMunicipalityCache.Clear();
        filterBarangayCache.Clear();
        provinceSelectKey++;
        municipalitySelectKey++;
        barangaySelectKey++;

        // ── Reset birthday selectors ──────────────────────────────────
        _specificBirthdayMonth = 0;
        _specificBirthdayDay = 0;
        _birthdayFromMonth = 0;
        _birthdayFromDay = 0;
        _birthdayToMonth = 0;
        _birthdayToDay = 0;
        //reset compliance selector
        _coStatusValue = "-1";
        State.Filter.CoStatus = null;
        _complianceValue = string.Empty;
        State.Filter.IsCompliant = null;
        State.Filter.ComplianceMode = null; // ✅ add this
        State.Filter.IsEligible = null;
        State.Filter.EligibilityMode = null;
        _eligibilityValue = string.Empty; // ✅ add this
        State.Filter.GeneralSearch = null; // ✅ add this

        State.Filter = new BeneficiaryFilterDto
        {
            PageNumber = 1,
            PageSize = 10,
            // Sort reset to default on clear
            SortColumn = null,
            SortAscending = true

        };
        State.ClearData();

        if (!State.FilterRegions.Any())
            await LoadFilterRegionsAsync();

        StateHasChanged();
    }

    private bool IsFilterEmpty(BeneficiaryFilterDto f) =>
    string.IsNullOrWhiteSpace(f.FullName) &&
    string.IsNullOrWhiteSpace(f.LastName) &&
    string.IsNullOrWhiteSpace(f.FirstName) &&
    string.IsNullOrWhiteSpace(f.Validator) &&
    string.IsNullOrWhiteSpace(f.BatchCode) &&
    f.SpecificAge == null &&
    // ✅ null means "not selected"; 0 means "filter for no milestone" — both are valid states
    f.MilestoneYear == null &&
    f.PaymentDate == null &&
    f.PsgcCodeRegion == null &&
    f.PsgcCodeProvince == null &&
    f.PsgcCodeMunicipality == null &&
    f.PsgcCodeBarangay == null &&
    f.Sex == null &&
    f.PaymentStatus == null &&
    f.IsCompliant == null &&
    f.IsEligible == null &&
    f.IsCompliant == null &&
    string.IsNullOrWhiteSpace(f.ComplianceMode) && // ✅ add this
    f.IsEligible == null &&
      string.IsNullOrWhiteSpace(f.EligibilityMode) &&
    (f.FindingStatus == null || f.FindingStatus == 3) &&
    string.IsNullOrWhiteSpace(f.GeneralSearch) && // ✅ add this
    string.IsNullOrWhiteSpace(f.FullName) &&
    f.CoStatus == null &&
    _specificBirthdayMonth == 0 &&
    _birthdayFromMonth == 0 &&
    _birthdayToMonth == 0;

    private async Task LoadMunicipalitiesAsync(int provinceId)
    {
        try
        {
            IsFilterMunicipalityLoading = true;
            var result = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>(
                $"api/Municipality/by-province/{provinceId}") ?? new();
            State.FilterMunicipalities = result;
            if (result.Any()) filterMunicipalityCache[provinceId] = result;
        }
        finally { IsFilterMunicipalityLoading = false; StateHasChanged(); }
    }

    private async Task LoadBarangaysAsync(int municipalityId)
    {
        if (filterBarangayCache.TryGetValue(municipalityId, out var cached) && cached.Any())
        {
            State.FilterBarangays = cached;
            StateHasChanged();
            return;
        }
        filterBarangayCache.Remove(municipalityId);
        try
        {
            IsFilterBarangayLoading = true;
            var response = await Http.PostAsJsonAsync(
                "api/Barangay/by-municipalities",
                new LookupMultiRequestDto { Ids = new List<int> { municipalityId } });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<BarangayLookupDto>>() ?? new();
                State.FilterBarangays = result;
                if (result.Any()) filterBarangayCache[municipalityId] = result;
            }
        }
        finally { IsFilterBarangayLoading = false; StateHasChanged(); }
    }

    private string GetQueryString(BeneficiaryFilterDto filter)
    {
        var properties = from p in filter.GetType().GetProperties()
                         let value = p.GetValue(filter, null)
                         where value != null
                         select new { p.Name, Value = value };
        var queryString = new List<string>();
        foreach (var prop in properties)
        {
            if (prop.Value is System.Collections.IEnumerable list && !(prop.Value is string))
                foreach (var item in list)
                    queryString.Add($"{prop.Name}={Uri.EscapeDataString(item.ToString() ?? "")}");
            else
                queryString.Add($"{prop.Name}={Uri.EscapeDataString(prop.Value.ToString() ?? "")}");
        }
        return string.Join("&", queryString);
    }
}
