    private List<ProvinceLookupDto> _formProvinces = new();
    private List<MunicipalityLookupDto> _formMunicipalities = new();
    private List<BarangayLookupDto> _formBarangays = new();
    private bool _isFormRegionLoading;
    private bool _isFormProvinceLoading;
    private bool _isFormMunicipalityLoading;
    private bool _isFormBarangayLoading;
    // ── Finding state (edit mode only) ───────────────────────────────────────────
    private BeneficiaryFindingDto? currentFinding;
    private int findingStatusInput = 0;
    private string? findingRemarksInput;
    private bool isLoadingFinding;
    //Soft duplicate state
    private List<SoftDuplicateCandidateDto> _softDuplicates = new();
    private bool _showSoftDuplicateModal = false;
    private HxModal _softDuplicateModal = default!;
    private CreateBeneficiaryInformationDto? _pendingDto;
    private ReferenceNumberModal _refNumberModal = default!;
    // ── Ref number section toggle ─────────────────────────────────────────────
    private bool _showRefNumber = false;
    // ✅ True only when all three fields are filled
    private bool HasRefNumber =>
        model.Quarter != null &&
        !string.IsNullOrWhiteSpace(model.Batch) &&
        model.RefYear != null;
    private void OnBatchInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        if (int.TryParse(raw, out var numeric))
            model.Batch = numeric.ToString();
        else
            model.Batch = raw.Trim();
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitAsync();
        _isAdmin = AuthService.IsAdmin();
        _isPdo = AuthService.IsPDO();
        _roleLoaded = true;

        StateHasChanged();
    }
    private async Task LoadPaymentHistoryAsync(Guid beneficiaryId)
    {
        try
        {
            isLoadingPaymentHistory = true;
            StateHasChanged();
            paymentHistory = await Http.GetFromJsonAsync<List<PaymentHistoryDto>>(
                $"api/beneficiary/payment-history/{beneficiaryId}") ?? new();
        }
        catch (Exception ex) { toast.ShowError($"Failed to load payment history: {ex.Message}"); }
        finally { isLoadingPaymentHistory = false; StateHasChanged(); }
    }

    private async Task OpenAddPaymentHistoryModal()
    {
        // ✅ Reset both objects to prevent cross-contamination
        _editPayment = new EditPaymentHistoryRequestDto();
        _newPayment = new AddPaymentHistoryDto
        {
            PaymentStatus = 0, // Default to N/A
            ModeOfPayment = 0,
            PayrollQuarter = null,
            FiscalYear = null,
            PaymentDate = null,
            Remarks = null
        };
        await addPaymentHistoryModal.ShowAsync();
    }

    private async Task OpenEditPaymentHistoryModal(PaymentHistoryDto entry)
    {
        // ✅ Reset both objects to prevent cross-contamination
        _newPayment = new AddPaymentHistoryDto();
        _editPayment = new EditPaymentHistoryRequestDto
        {
            HistoryId = entry.Id,
            BeneficiaryId = model.Id,
            PayrollQuarter = entry.PayrollQuarter,
            FiscalYear = entry.FiscalYear,
            PaymentStatus = entry.PaymentStatus,
            ModeOfPayment = entry.ModeOfPayment,
            PaymentDate = entry.PaymentDate,
            Remarks = entry.Remarks
        };
        await editPaymentHistoryModal.ShowAsync();
    }
    private async Task OpenAddPaymentConfirmation()
    {
        // ✅ Validate Paid status requirements
        if (_newPayment.PaymentStatus == 2)
        {
            if (!_newPayment.PaymentDate.HasValue)
            {
                toast.ShowError("Payment Date is required when status is Paid.");
                return;
            }
            if (!_newPayment.ModeOfPayment.HasValue || _newPayment.ModeOfPayment == 0)
            {
                toast.ShowError("Mode of Payment is required when status is Paid.");
                return;
            }
            if (!_newPayment.PayrollQuarter.HasValue || !_newPayment.FiscalYear.HasValue)
            {
                toast.ShowError("Payroll Quarter and Fiscal Year are required when status is Paid.");
                return;
            }
        }

        // ✅ Validate Unpaid status requirements
        if (_newPayment.PaymentStatus == 1)
        {
            if (!_newPayment.PaymentDate.HasValue)
            {
                toast.ShowError("Unpaid Date is required when status is Unpaid.");
                return;
            }
            if (!_newPayment.PayrollQuarter.HasValue || !_newPayment.FiscalYear.HasValue)
            {
                toast.ShowError("Payroll Quarter and Fiscal Year are required when status is Unpaid.");
                return;
            }
        }

        pendingAction = "add-payment-history";
        confirmationTitle = "Confirm New Payment Record";
        confirmationMessage =
            $"Record a new {PaymentStatusLabel(_newPayment.PaymentStatus)} payment entry" +
            (_newPayment.PayrollQuarter.HasValue || _newPayment.FiscalYear.HasValue
                ? $" for Q{_newPayment.PayrollQuarter} {_newPayment.FiscalYear}"
                : "") +
            "? This adds a new history entry — it does not overwrite the current one.";

        await addPaymentHistoryModal.HideAsync();
        await confirmModal.ShowAsync();
    }

    private async Task SubmitAddPaymentHistoryAsync()
    {
        try
        {
            _isSavingPaymentHistory = true;
            var request = new BulkAddPaymentHistoryRequestDto
            {
                Ids = new List<Guid> { model.Id },
                PayrollQuarter = _newPayment.PayrollQuarter,
                FiscalYear = _newPayment.FiscalYear,
                PaymentStatus = _newPayment.PaymentStatus,
                ModeOfPayment = _newPayment.ModeOfPayment,
                PaymentDate = _newPayment.PaymentDate,
                Remarks = _newPayment.Remarks
            };
            var response = await Http.PostAsJsonAsync("api/beneficiary/bulk-add-payment-history", request);

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess("Payment record added.");
                await LoadPaymentHistoryAsync(model.Id);
                State.Invalidate();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                toast.ShowError(response.StatusCode == System.Net.HttpStatusCode.Forbidden
                    ? "Access denied. Only Administrators can record or correct payments."
                    : (string.IsNullOrWhiteSpace(body) ? "Something went wrong." : body));
            }
        }
        finally { _isSavingPaymentHistory = false; }
    }
    private async Task OpenEditPaymentConfirmation()
    {
        // ✅ Validate Paid status requirements
        if (_editPayment.PaymentStatus == 2)
        {
            if (!_editPayment.PaymentDate.HasValue)
            {
                toast.ShowError("Payment Date is required when status is Paid.");
                return;
            }
            if (!_editPayment.ModeOfPayment.HasValue || _editPayment.ModeOfPayment == 0)
            {
                toast.ShowError("Mode of Payment is required when status is Paid.");
                return;
            }
            if (!_editPayment.PayrollQuarter.HasValue || !_editPayment.FiscalYear.HasValue)
            {
                toast.ShowError("Payroll Quarter and Fiscal Year are required when status is Paid.");
                return;
            }
        }

        // ✅ Validate Unpaid status requirements
        if (_editPayment.PaymentStatus == 1)
        {
            if (!_editPayment.PaymentDate.HasValue)
            {
                toast.ShowError("Unpaid Date is required when status is Unpaid.");
                return;
            }
            if (!_editPayment.PayrollQuarter.HasValue || !_editPayment.FiscalYear.HasValue)
            {
                toast.ShowError("Payroll Quarter and Fiscal Year are required when status is Unpaid.");
                return;
            }
        }

        pendingAction = "edit-payment-history";
        confirmationTitle = "Confirm Payment Correction";
        confirmationMessage =
            $"Correct this payment record in place, setting it to " +
            $"{PaymentStatusLabel(_editPayment.PaymentStatus)}" +
            (_editPayment.PayrollQuarter.HasValue || _editPayment.FiscalYear.HasValue
                ? $" for Q{_editPayment.PayrollQuarter} {_editPayment.FiscalYear}"
                : "") +
            "? This overwrites the existing entry and cannot be undone.";

        await editPaymentHistoryModal.HideAsync();
        await confirmModal.ShowAsync();
    }

    private async Task SubmitEditPaymentHistoryAsync()
    {
        try
        {
            _isSavingPaymentHistory = true;
            var response = await Http.PostAsJsonAsync("api/beneficiary/edit-payment-history", _editPayment);

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess("Payment record corrected.");
                await LoadPaymentHistoryAsync(model.Id);
                State.Invalidate();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                toast.ShowError(response.StatusCode == System.Net.HttpStatusCode.Forbidden
                    ? "Access denied. Only Administrators can record or correct payments."
                    : (string.IsNullOrWhiteSpace(body) ? "Something went wrong." : body));
            }
        }
        finally { _isSavingPaymentHistory = false; }
    }

    private async Task ConfirmDeletePaymentHistory(PaymentHistoryDto entry)
    {
        _pendingDeletePaymentHistory = entry;
        pendingAction = "delete-payment-history";
        confirmationTitle = "Delete Payment Record";
        confirmationMessage =
            $"Delete this {PaymentStatusLabel(entry.PaymentStatus)} payment record dated " +
            $"{entry.DateCreated.ToLocalTime():MMM dd, yyyy}? This cannot be undone.";
        await confirmModal.ShowAsync();
    }

    private async Task DeletePaymentHistoryEntryAsync()
    {
        if (_pendingDeletePaymentHistory == null) return;

        var response = await Http.DeleteAsync(
            $"api/beneficiary/payment-history/{_pendingDeletePaymentHistory.Id}");

        if (response.IsSuccessStatusCode)
        {
            toast.ShowSuccess("Payment record deleted.");
            await LoadPaymentHistoryAsync(model.Id);
            State.Invalidate();
        }
        else
        {
            var body = await response.Content.ReadAsStringAsync();
            toast.ShowError(response.StatusCode == System.Net.HttpStatusCode.Forbidden
                ? "Access denied. Only Administrators can record or correct payments."
                : (string.IsNullOrWhiteSpace(body) ? "Something went wrong." : body));
        }
        _pendingDeletePaymentHistory = null;
    }

