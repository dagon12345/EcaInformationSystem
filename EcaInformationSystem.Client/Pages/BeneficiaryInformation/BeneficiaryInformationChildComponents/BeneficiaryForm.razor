                    <div class="form-section-body">
                        @if (isLoadingPaymentHistory)
                        {
                            <div class="text-center py-3">
                                <span class="spinner-border spinner-border-sm text-primary"></span>
                                <span class="ms-2 text-muted small">Loading payment history...</span>
                            </div>
                        }
                        else if (!paymentHistory.Any())
                        {
                            <div class="alert alert-secondary py-2 px-3 small mb-0">
                                <i class="bi bi-info-circle me-1"></i>No payment records yet.
                            </div>
                        }
                        else
                        {
                            <div class="payment-timeline">
                                @foreach (var entry in paymentHistory)
                                {
                                    <div class="payment-timeline-item @(entry.IsCurrent ? "payment-timeline-item--current" : "")">
                                        <div class="payment-timeline-marker @GetPaymentBadgeClass(entry.PaymentStatus)"></div>
                                        <div class="payment-timeline-content">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <span class="tbl-badge @GetPaymentBadgeClass(entry.PaymentStatus)">
                                                        @GetPaymentStatusText(entry.PaymentStatus)
                                                    </span>
                                                    @if (entry.IsCurrent)
                                                    {
                                                        <span class="badge bg-primary ms-1" style="font-size:9px;">CURRENT</span>
                                                    }
                                                    @if (entry.DateModified.HasValue)
                                                    {
                                                        <span class="badge bg-warning text-dark ms-1" style="font-size:9px;">CORRECTED</span>
                                                    }
                                                </div>
                                                <small class="text-muted">
                                                    @entry.DateCreated.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
                                                </small>
                                            </div>
                                            <div class="row g-1 mt-1" style="font-size:12px;">
                                                @if (entry.PayrollQuarter.HasValue || entry.FiscalYear.HasValue)
                                                {
                                                    <div class="col-6">
                                                        <span class="text-muted">Period:</span>
                                                        @(entry.PayrollQuarter.HasValue ? $"Q{entry.PayrollQuarter}" : "—")
                                                        @(entry.FiscalYear?.ToString() ?? "")
                                                    </div>
                                                }
                                                @if (entry.PaymentDate.HasValue)
                                                {
                                                    <div class="col-6">
                                                        <span class="text-muted">Paid:</span>
                                                        @entry.PaymentDate.Value.ToString("MMM dd, yyyy")
                                                    </div>
                                                }
                                                @if (entry.PaymentStatus == 2)
                                                {
                                                    <div class="col-6">
                                                        <span class="text-muted">Mode:</span>
                                                        @(entry.ModeOfPayment == 1 ? "Cash Advance by SDO" : entry.ModeOfPayment == 2 ? "Bank Transfer" : "—")
                                                    </div>
                                                }
                                                <div class="col-12 text-muted" style="font-size:10px;">
                                                    Recorded by @entry.CreatedBy
                                                    @if (entry.DateModified.HasValue)
                                                    {
                                                        <span>· Corrected by @entry.ModifiedBy on @entry.DateModified.Value.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(entry.Remarks))
                                            {
                                                <div class="mt-1" style="font-size:11px;">
                                                    <span class="text-muted">Remarks:</span> @entry.Remarks
                                                </div>
                                            }
                                            @if (_isAdmin)
                                            {
                                                <div class="d-flex gap-2 mt-1">
                                                    <button type="button" class="btn btn-link btn-sm p-0" style="font-size:11px;"
                                                            @onclick="() => OpenEditPaymentHistoryModal(entry)">
                                                        <i class="bi bi-pencil-square me-1"></i>Correct
                                                    </button>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-danger" style="font-size:11px;"
                                                            @onclick="() => ConfirmDeletePaymentHistory(entry)">
                                                        <i class="bi bi-trash me-1"></i>Delete
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
    </div>

    @* ── Actions ── *@
    <div class="d-flex justify-content-end gap-2 mt-2">
        <button type="button" class="sys-btn sys-btn-cancel"
                @onclick='() => { State.Invalidate(); Navigation.NavigateTo("/beneficiary-records"); }'>
            <i class="bi bi-x-circle me-1"></i>Cancel
        </button>
        <button type="submit" class="sys-btn sys-btn-save" disabled="@IsLoading">
            @(IsEditMode ? "Update Record" : "Save Record")
        </button>
    </div>

</EditForm>
