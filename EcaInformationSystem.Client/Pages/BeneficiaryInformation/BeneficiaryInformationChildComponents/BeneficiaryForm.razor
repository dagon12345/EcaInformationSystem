    // Natural sort key: replaces every run of digits with the same digits
    // zero-padded to a fixed width, so a plain ordinal string comparison on the
    // resulting keys produces the same order a human would expect numerically —
    // "Barangay 2" < "Barangay 10" — without needing a custom IComparer.
    // Width of 10 comfortably covers any realistic barangay/street numbering.
    private static string NaturalSortKey(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;

        return System.Text.RegularExpressions.Regex.Replace(
            value, "[0-9]+", match => match.Value.PadLeft(10, '0'));
    }
