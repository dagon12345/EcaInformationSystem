                                    <i class="bi bi-lock-fill text-muted"></i>
                                    <span>Findings can only be modified by Administrators.</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            @* ── Payment History (edit mode only — system feature, not on paper form) ── *@
            @if (IsEditMode)
            {
                <div class="form-section mb-3">
                    <div class="form-section-header d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-clock-history me-2"></i>Payment History</span>
