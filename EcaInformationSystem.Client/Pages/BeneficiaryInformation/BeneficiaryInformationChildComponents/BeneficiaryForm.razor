            await _paymentConfirmModal.HideAsync();
            return;
        }
        model.PaymentStatus = _pendingPaymentStatus;
        _originalPaymentStatus = _pendingPaymentStatus; // update baseline
        await _paymentConfirmModal.HideAsync();
        StateHasChanged();
