@* BeneficiaryForm.razor — redesigned to match navy #1F3864 design system *@
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject HttpClient Http
@inject ToastService toast
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject BeneficiaryStateService State;
@inject BeneficiaryFindingClientService FindingService


<EditForm Model="@model" OnValidSubmit="@OpenSaveConfirmationModal">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3 small" />

    @* ── Identity Information ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-person-vcard me-2"></i>Identity Information
        </div>
        <div class="form-section-body">
            <div class="form-grid">
                <div class="ff">
                    <label class="ff-label">Date Applied</label>
                    <InputDate class="ff-input" @bind-Value="model.DateApplied" />
                </div>
                <div class="ff">
                    <label class="ff-label">Date Endorsed</label>
                    <InputDate class="ff-input" @bind-Value="model.DateEndorsed" />
                </div>
                <div class="ff">
                    <label class="ff-label">Batch Code</label>
                    <input class="ff-input" @bind="model.BatchCode" @ref="batchCodeInput" />
                </div>
                <div class="ff">
                    <label class="ff-label">OSCA ID Number</label>
                    <InputText class="ff-input" @bind-Value="model.OscaIdNumber" />
                </div>
                <div class="ff">
                    <label class="ff-label">OSCA ID Date Issued</label>
                    <InputDate class="ff-input" @bind-Value="model.OscaIdDateIssued" />
                </div>
                <div class="ff">
                    <label class="ff-label">NCSC RRN</label>
                    <InputNumber class="ff-input" @bind-Value="model.NcscRrn" />
                </div>
                <div class="ff">
                    <label class="ff-label">Last Name <span class="req">*</span></label>
                    <InputText class="ff-input" @bind-Value="model.LastName" />
                    <ValidationMessage For="@(() => model.LastName)" class="ff-err" />
                </div>
                <div class="ff">
                    <label class="ff-label">First Name <span class="req">*</span></label>
                    <InputText class="ff-input" @bind-Value="model.FirstName" />
                    <ValidationMessage For="@(() => model.FirstName)" class="ff-err" />
                </div>
                <div class="ff">
                    <label class="ff-label">Middle Name</label>
                    <InputText class="ff-input" @bind-Value="model.MiddleName" />
                </div>
                <div class="ff">
                    <label class="ff-label">Extension</label>
                    <InputSelect class="ff-input" @bind-Value="model.Extension">
                        <option value="">Select Extension</option>
                        <option value="">N/A</option>
                        <option value="Sr.">Sr.</option>
                        <option value="Jr.">Jr.</option>
                        <option value="II.">II</option>
                        <option value="III">III</option>
                        <option value="IV">IV</option>
                        <option value="V">V</option>
                    </InputSelect>
                </div>
                <div class="ff">
                    <label class="ff-label">Birth Date <span class="req">*</span></label>
                    <input type="date" class="ff-input"
                           @bind="@model.BirthDate"
                           @bind:after="ApplyEligibilityRules" />
                    <ValidationMessage For="@(() => model.BirthDate)" class="ff-err" />
                </div>
                <div class="ff">
                    <label class="ff-label">Age (auto)</label>
                    <input class="ff-input ff-readonly" value="@(GetAge(model.BirthDate)?.ToString() ?? "—")" readonly />
                </div>
                <div class="ff">
                    <label class="ff-label">Phone Number</label>
                    <InputText class="ff-input" @bind-Value="model.PhoneNumber" placeholder="09171234567" />
                </div>
                <div class="ff">
                    <label class="ff-label">Sex <span class="req">*</span></label>
                    <InputSelect class="ff-input" @bind-Value="model.Sex">
                        <option value="0">Select Sex</option>
                        <option value="1">Male</option>
                        <option value="2">Female</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => model.Sex)" class="ff-err" />
                </div>
            </div>

            @* Deceased sub-section *@
            <div class="form-subsection mt-2">
                <div class="form-subsection-label">
                    <i class="bi bi-info-circle me-1"></i>Other
                </div>
                <div class="form-grid">
                    <div class="ff d-flex align-items-center gap-2 pt-3">
                        <input type="checkbox"
                               class="sys-check"
                               checked="@model.IsDeceased"
                               @onchange="OnIsDeceasedChanged" />
                        <label class="ff-label mb-0">Is Deceased</label>
                    </div>
                    <div class="ff">
                        <label class="ff-label">Date of Death</label>
                        <input type="date" class="ff-input"
                               value="@(model.DateOfDeath?.ToString("yyyy-MM-dd"))"
                               max="@TodayDateString"
                               @onchange="OnDateOfDeathChanged"
                               disabled="@(!model.IsDeceased)" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Demographic ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-people me-2"></i>Demographic Information
        </div>
        <div class="form-section-body">
            <div class="form-grid">
                <div class="ff d-flex align-items-center gap-2 pt-3">
                    <InputCheckbox class="sys-check" @bind-Value="model.IsIndigenousPeople" />
                    <label class="ff-label mb-0">Indigenous People</label>
                </div>
                <div class="ff d-flex align-items-center gap-2 pt-3">
                    <InputCheckbox class="sys-check" @bind-Value="model.IsPersonWithDisability" />
                    <label class="ff-label mb-0">Person with Disability</label>
                </div>
                <div class="ff">
                    <label class="ff-label">Civil Status</label>
                    <InputSelect class="ff-input" @bind-Value="model.CivilStatus">
                        <option value="0">Select Civil Status</option>
                        <option value="1">Single</option>
                        <option value="2">Widowed</option>
                        <option value="3">Married</option>
                        <option value="4">Live in</option>
                    </InputSelect>
                </div>
                <div class="ff">
                    <label class="ff-label">Citizenship</label>
                    <select class="ff-input" @bind="@model.Citizenship" @bind:after="ApplyEligibilityRules">
                        <option value="0">Select Citizenship</option>
                        <option value="1">Filipino</option>
                        <option value="2">Dual Citizenship</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @* ── Address ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-geo-alt me-2"></i>Address Information
        </div>
        <div class="form-section-body">
            <div class="form-grid">

                @* Region *@
                <div class="ff">
                    <label class="ff-label">Region <span class="req">*</span></label>
                    <select class="ff-input"
                            value="@model.PsgcCodeRegion"
                            @onchange="OnFormRegionChanged"
                            disabled="@(_isFormRegionLoading || IsLoading)">
                        <option value="0">
                            @(_isFormRegionLoading ? "Loading..." : "Select Region")
                        </option>
                        @foreach (var r in _formRegions)
                        {
                            <option value="@r.PsgcCodeRegion">@r.Name</option>
                        }
                    </select>
                </div>

                @* Province *@
                <div class="ff">
                    <label class="ff-label">Province <span class="req">*</span></label>
                    <select class="ff-input"
                            value="@model.PsgcCodeProvince"
                            @onchange="OnFormProvinceChanged"
                            disabled="@(model.PsgcCodeRegion == 0 || _isFormProvinceLoading || IsLoading)">
                        <option value="0">
                            @(_isFormProvinceLoading ? "Loading..." : "Select Province")
                        </option>
                        @foreach (var p in _formProvinces)
                        {
                            <option value="@p.PsgcCodeProvince">@p.Name</option>
                        }
                    </select>
                </div>

                @* Municipality *@
                <div class="ff">
                    <label class="ff-label">Municipality / City <span class="req">*</span></label>
                    <select class="ff-input"
                            value="@model.PsgcCodeMunicipality"
                            @onchange="OnFormMunicipalityChanged"
                            disabled="@(model.PsgcCodeProvince == 0 || _isFormMunicipalityLoading || IsLoading)">
                        <option value="0">
                            @(_isFormMunicipalityLoading ? "Loading..." : "Select Municipality")
                        </option>
                        @foreach (var m in _formMunicipalities)
                        {
                            <option value="@m.PsgcCodeMunicipality">@m.Name</option>
                        }
                    </select>
                </div>

                @* Barangay *@
                <div class="ff">
                    <label class="ff-label">Barangay <span class="req">*</span></label>
                    <select class="ff-input"
                            value="@model.PsgcCodeBarangay"
                            @onchange="OnFormBarangayChanged"
                            disabled="@(model.PsgcCodeMunicipality == 0 || _isFormBarangayLoading || IsLoading)">
                        <option value="0">
                            @(_isFormBarangayLoading ? "Loading..." : "Select Barangay")
                        </option>
                        @foreach (var b in _formBarangays)
                        {
                            <option value="@b.PsgcCodeBarangay">@b.Name</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => model.PsgcCodeBarangay)" class="ff-err" />
                </div>

            </div>
        </div>
    </div>

    @* ── Validation ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-patch-check me-2"></i>Validation Information
        </div>
        <div class="form-section-body">
            <div class="form-grid">
                <div class="ff">
                    <label class="ff-label">Validator <span class="req">*</span></label>
                    <InputText class="ff-input" @bind-Value="model.Validator" />
                    <ValidationMessage For="@(() => model.Validator)" class="ff-err" />
                </div>
                <div class="ff">
                    <label class="ff-label">Validation Date <span class="req">*</span></label>
                    <InputDate class="ff-input" @bind-Value="model.ValidationDate" />
                    <ValidationMessage For="@(() => model.ValidationDate)" class="ff-err" />
                </div>
            </div>

            <div class="form-subsection mt-2">
                <div class="form-subsection-label">
                    <i class="bi bi-clipboard2-check me-1"></i>Assessment
                </div>
                <div class="form-grid">
                    <div class="ff d-flex align-items-center gap-2 pt-3">
                        <InputCheckbox class="sys-check" @bind-Value="model.IsEligible" />
                        <label class="ff-label mb-0">Is Eligible</label>
                    </div>
                    <div class="ff d-flex align-items-center gap-2 pt-3">
                        <InputCheckbox class="sys-check" @bind-Value="model.IsCompliant" />
                        <label class="ff-label mb-0">Is Compliant</label>
                    </div>
                    <div class="ff" style="grid-column: 1 / -1;">
                        <label class="ff-label">Assessment Remarks</label>
                        <InputTextArea class="ff-input" @bind-Value="model.AssessmentRemarks"
                                       rows="2" placeholder="Enter assessment remarks if not eligible..." />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Payment ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-cash-coin me-2"></i>Payment Information &amp; Remarks
        </div>
        <div class="form-section-body">
            <div class="form-grid">
                <div class="ff">
                    <label class="ff-label">Payment Status</label>
                    <InputSelect class="ff-input" @bind-Value="model.PaymentStatus">
                        <option value="0">N/A</option>
                        <option value="1">Unpaid</option>
                        <option value="2">Paid</option>
                    </InputSelect>
                </div>
                <div class="ff">
                    <label class="ff-label">Mode of Payment</label>
                    <InputSelect class="ff-input" @bind-Value="model.ModeOfPayment">
                        <option value="0">Select Mode</option>
                        <option value="1">Cash Advance by SDO</option>
                        <option value="2">Bank Transfer</option>
                    </InputSelect>
                </div>
                <div class="ff">
                    <label class="ff-label">Payment Date</label>
                    <InputDate class="ff-input" @bind-Value="model.PaymentDate"
                               disabled="@(model.PaymentStatus != 2)" />
                </div>
                <div class="ff">
                    <label class="ff-label">Remark Category</label>
                    <InputSelect class="ff-input" @bind-Value="model.RemarkCategory">
                        <option value="0">Select Remark</option>
                        <option value="1">Deceased prior reaching milestone age</option>
                        <option value="2">Out of town/Country</option>
                        <option value="3">Incomplete required documents</option>
                        <option value="4">Inconsistent documents</option>
                        <option value="5">Cannot be reached/Located</option>
                        <option value="6">Did not reach the milestone age</option>
                        <option value="7">Lacking of documents/Requirements</option>
                        <option value="8">For Correction</option>
                        <option value="9">Waived</option>
                        <option value="10">Lacking Proof of Relationship</option>
                        <option value="11">No show</option>
                        <option value="12">Double Application with Different Surname used</option>
                        <option value="13">For CGD Island Municipality</option>
                    </InputSelect>
                </div>
                <div class="ff" style="grid-column: 1 / -1;">
                    <label class="ff-label">Remarks</label>
                    <InputTextArea class="ff-input" @bind-Value="model.Remarks" rows="2" />
                </div>
            </div>
        </div>
    </div>
    @* ── Findings (Edit Mode only) ── *@
    @if (IsEditMode)
    {
        <div class="form-section mb-3">
            <div class="form-section-header">
                <i class="bi bi-exclamation-triangle me-2"></i>Findings
            </div>
            <div class="form-section-body">
                @if (isLoadingFinding)
                {
                    <div class="text-center py-2">
                        <span class="spinner-border spinner-border-sm text-primary"></span>
                        <span class="ms-2 text-muted">Loading finding...</span>
                    </div>
                }
                else
                {
                    <div class="form-grid">
                        <div class="ff">
                            <label class="ff-label">With Findings</label>
                            <select class="ff-input"
                                    @bind="findingStatusInput"
                                    disabled="@IsLoading">
                                <option value="0">N/A</option>
                                <option value="1">Solved</option>
                                <option value="2">Unresolved</option>
                            </select>
                        </div>

                        @if (findingStatusInput == 2)
                        {
                            <div class="ff" style="grid-column: 1 / -1;">
                                <label class="ff-label">
                                    Finding Remarks <span class="req">*</span>
                                </label>
                                <InputTextArea class="ff-input"
                                               @bind-Value="findingRemarksInput"
                                               rows="3"
                                               placeholder="Describe the unresolved finding..."
                                               disabled="@IsLoading" />
                            </div>
                        }

                        @* ✅ No separate save button — saved together with Update Record *@
                        @if (currentFinding is not null)
                        {
                            <div class="ff">
                                <small class="text-muted">
                                    Last updated:
                                    @((currentFinding.UpdatedAt ?? currentFinding.CreatedAt)
                                        .ToLocalTime()
                                        .ToString("MMM dd, yyyy hh:mm tt"))
                                </small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    @* ── Actions ── *@
    <div class="d-flex justify-content-end gap-2 mt-2">
        <button type="button" class="sys-btn sys-btn-cancel"
                @onclick='() => { State.Invalidate(); Navigation.NavigateTo("/beneficiary-records"); }'>
            <i class="bi bi-x-circle me-1"></i>Cancel
        </button>
        <button type="submit" class="sys-btn sys-btn-save" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            else
            {
                <i class="bi @(IsEditMode ? "bi-pencil-square" : "bi-floppy") me-1"></i>
            }
            @(IsEditMode ? "Update Record" : "Save Record")
        </button>
    </div>

</EditForm>

@* Confirmation modal — unchanged *@
<HxModal @ref="confirmModal">
    <HeaderTemplate><h5>@confirmationTitle</h5></HeaderTemplate>
    <BodyTemplate><p>@confirmationMessage</p></BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="CloseConfirmationModal">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="ConfirmActionAsync" Disabled="@IsLoading">Confirm</HxButton>
    </FooterTemplate>
</HxModal>

@* ── ALL @code IS IDENTICAL TO YOUR ORIGINAL — DO NOT CHANGE ── *@
@code {
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public Guid? EditId { get; set; } = null;

    private BeneficiaryInformationDto model = new()
    {
        BirthDate = DateTime.UtcNow.AddYears(-80),
        ValidationDate = DateTime.UtcNow,
    };

    private bool IsLoading;
    private string pendingAction = string.Empty;
    private string confirmationTitle = "Confirm Action";
    private string confirmationMessage = string.Empty;
    private string? successMessage = string.Empty;
    private string? errorMessage = string.Empty;
    private HxModal confirmModal = default!;
    private ElementReference batchCodeInput;
    private string TodayDateString => DateTime.Today.ToString("yyyy-MM-dd");
    private bool _isLoadingRecord = false;

    // ── Address cascade dropdowns ────────────────────────────────────────────
    private List<RegionLookupDto> _formRegions = new();
    private List<ProvinceLookupDto> _formProvinces = new();
    private List<MunicipalityLookupDto> _formMunicipalities = new();
    private List<BarangayLookupDto> _formBarangays = new();
    private bool _isFormRegionLoading;
    private bool _isFormProvinceLoading;
    private bool _isFormMunicipalityLoading;
    private bool _isFormBarangayLoading;
    // ── Finding state (edit mode only) ───────────────────────────────────────────
    private BeneficiaryFindingDto? currentFinding;
    private int findingStatusInput = 0;
    private string? findingRemarksInput;
    private bool isLoadingFinding;
    private bool isSavingFinding = false;

    #region Address cascade
    private async Task LoadFormRegionsAsync()
    {
        try
        {
            _isFormRegionLoading = true;
            _formRegions = await Http.GetFromJsonAsync<List<RegionLookupDto>>("api/Region") ?? new();
        }
        catch (Exception ex) { toast.ShowError($"Failed to load regions: {ex.Message}"); }
        finally { _isFormRegionLoading = false; StateHasChanged(); }
    }

    private async Task LoadFormProvincesAsync(int regionCode)
    {
        _formProvinces = new(); _formMunicipalities = new(); _formBarangays = new();
        try
        {
            _isFormProvinceLoading = true;
            _formProvinces = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>(
                $"api/Province/by-region/{regionCode}") ?? new();
        }
        catch (Exception ex) { toast.ShowError($"Failed to load provinces: {ex.Message}"); }
        finally { _isFormProvinceLoading = false; StateHasChanged(); }
    }

    private async Task LoadFormMunicipalitiesAsync(int provinceCode)
    {
        _formMunicipalities = new(); _formBarangays = new();
        try
        {
            _isFormMunicipalityLoading = true;
            _formMunicipalities = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>(
                $"api/Municipality/by-province/{provinceCode}") ?? new();
        }
        catch (Exception ex) { toast.ShowError($"Failed to load municipalities: {ex.Message}"); }
        finally { _isFormMunicipalityLoading = false; StateHasChanged(); }
    }

    private async Task LoadFormBarangaysAsync(int municipalityCode)
    {
        _formBarangays = new();
        try
        {
            _isFormBarangayLoading = true;
            var response = await Http.PostAsJsonAsync(
                "api/Barangay/by-municipalities",
                new LookupMultiRequestDto { Ids = new List<int> { municipalityCode } });
            if (response.IsSuccessStatusCode)
                _formBarangays = await response.Content.ReadFromJsonAsync<List<BarangayLookupDto>>() ?? new();
            else
                toast.ShowError($"Failed to load barangays (HTTP {(int)response.StatusCode}).");
        }
        catch (Exception ex) { toast.ShowError($"Failed to load barangays: {ex.Message}"); }
        finally { _isFormBarangayLoading = false; StateHasChanged(); }
    }

    private async Task OnFormRegionChanged(ChangeEventArgs e)
    {
        model.PsgcCodeRegion       = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        model.PsgcCodeProvince     = 0;
        model.PsgcCodeMunicipality = 0;
        model.PsgcCodeBarangay     = 0;
        _formProvinces = new(); _formMunicipalities = new(); _formBarangays = new();
        if (model.PsgcCodeRegion > 0)
            await LoadFormProvincesAsync(model.PsgcCodeRegion);
    }

    private async Task OnFormProvinceChanged(ChangeEventArgs e)
    {
        model.PsgcCodeProvince     = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        model.PsgcCodeMunicipality = 0;
        model.PsgcCodeBarangay     = 0;
        _formMunicipalities = new(); _formBarangays = new();
        if (model.PsgcCodeProvince > 0)
            await LoadFormMunicipalitiesAsync(model.PsgcCodeProvince);
    }

    private async Task OnFormMunicipalityChanged(ChangeEventArgs e)
    {
        model.PsgcCodeMunicipality = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        model.PsgcCodeBarangay     = 0;
        _formBarangays = new();
        if (model.PsgcCodeMunicipality > 0)
            await LoadFormBarangaysAsync(model.PsgcCodeMunicipality);
    }

    private void OnFormBarangayChanged(ChangeEventArgs e)
    {
        model.PsgcCodeBarangay = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
    }
    #endregion

    #region Finding
    private async Task LoadFindingAsync(Guid beneficiaryId)
    {
        try
        {
            isLoadingFinding = true;
            StateHasChanged();

            currentFinding = await FindingService.GetByBeneficiaryIdAsync(beneficiaryId);

            if (currentFinding is not null)
            {
                findingStatusInput = currentFinding.FindingStatus;
                findingRemarksInput = currentFinding.FindingRemarks;
            }
        }
        finally
        {
            isLoadingFinding = false;
            StateHasChanged();
        }
    }
    #endregion


    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadFormRegionsAsync();
        if (IsEditMode && EditId.HasValue)
            await LoadExistingRecordAsync(EditId.Value);
    }

    private async Task LoadExistingRecordAsync(Guid id)
    {
        try
        {
            IsLoading = true;
            _isLoadingRecord = true;
            model = await Http.GetFromJsonAsync<BeneficiaryInformationDto>($"api/beneficiary/edit/{id}") ?? model;
            model.BirthDate = model.BirthDate.Date;

            // Pre-populate cascade dropdowns from the loaded record's PSGC codes
            if (model.PsgcCodeRegion > 0)
                await LoadFormProvincesAsync(model.PsgcCodeRegion);
            if (model.PsgcCodeProvince > 0)
                await LoadFormMunicipalitiesAsync(model.PsgcCodeProvince);
            if (model.PsgcCodeMunicipality > 0)
                await LoadFormBarangaysAsync(model.PsgcCodeMunicipality);

            ApplyEligibilityRules();
            await LoadFindingAsync(id);
        }
        finally { _isLoadingRecord = false; IsLoading = false; StateHasChanged(); }
    }
    #endregion

    #region Logic
    private async Task CloseConfirmationModal() => await confirmModal.HideAsync();

    private void ResetForm()
    {
        model = new BeneficiaryInformationDto
        {
            BirthDate = DateTime.UtcNow.AddYears(-80),
            ValidationDate = DateTime.UtcNow,
        };
        _formProvinces     = new();
        _formMunicipalities = new();
        _formBarangays     = new();
    }

    private void ApplyEligibilityRules()
    {
        var milestoneReached = ComputeMilestoneYear(model.BirthDate) > 0;
        var isFilipino = model.Citizenship == 1;

        model.IsEligible = milestoneReached && isFilipino;
        StateHasChanged();
    }
    /// <summary>
    /// Mirrors BeneficiaryInformationRepository.ComputeMilestoneYear exactly.
    /// Returns the milestone year (e.g. 2026) if the person has already reached
    /// a milestone age (80, 85, 90, 95, 100) on or before today and that year >= 2024.
    /// Returns 0 if no milestone has been reached yet — meaning not yet eligible.
    /// </summary>
    private static int ComputeMilestoneYear(DateTime birthDate)
    {
        if (birthDate == default || birthDate == DateTime.MinValue)
            return 0;

        var today = DateTime.Today;

        foreach (var milestone in new[] { 100, 95, 90, 85, 80 })
        {
            int milestoneYear = birthDate.Year + milestone;

            if (milestoneYear < 2024)
                continue;

            // Already reached if milestone birthday has passed (or is today)
            bool alreadyReached =
                milestoneYear < today.Year ||
                (milestoneYear == today.Year &&
                 new DateTime(milestoneYear, birthDate.Month, birthDate.Day) <= today);

            if (alreadyReached)
                return milestoneYear;
        }

        return 0;
    }
    private int? GetEffectiveAge()
    {
        if (model.BirthDate == default || model.BirthDate == DateTime.MinValue) return null;
        return CalculateAge(model.BirthDate, DateTime.Today);
    }

    private int CalculateAge(DateTime birthDate, DateTime asOf)
    {
        var birth = birthDate.Date;
        var age = asOf.Date.Year - birth.Year;
        if (birth > asOf.Date.AddYears(-age)) age--;
        return age;
    }

    private int? GetAge(DateTime? birthDate)
    {
        if (birthDate == null) return null;
        var today = DateTime.Today;
        var age = today.Year - birthDate.Value.Year;
        if (birthDate.Value.Date > today.AddYears(-age)) age--;
        return age;
    }

    private async Task OpenSaveConfirmationModal()
    {
        ClearMessages();
        pendingAction = IsEditMode ? "edit" : "add";
        confirmationTitle = IsEditMode ? "Confirm Update" : "Confirm Add";
        confirmationMessage = IsEditMode
            ? "Are you sure you want to update this record?"
            : "Are you sure you want to add this record?";
        await confirmModal.ShowAsync();
    }

    private void ClearMessages() { successMessage = null; errorMessage = null; }

    private async Task ConfirmActionAsync()
    {
        try
        {
            await confirmModal.HideAsync();
            switch (pendingAction)
            {
                case "add": await AddBeneficiaryAsync(); break;
                case "edit": await UpdateBeneficiaryAsync(); break;
            }
        }
        catch (Exception ex) { toast.ShowError($"Error: {ex.Message}"); }
    }

    private void OnCitizenshipChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) { model.Citizenship = v; ApplyEligibilityRules(); }
    }

    private void OnDateOfDeathChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) { model.DateOfDeath = d; model.IsDeceased = true; }
        else { model.DateOfDeath = null; model.IsDeceased = false; }
        ApplyEligibilityRules();
    }

    private void OnIsDeceasedChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out var v)) model.IsDeceased = v;
        if (!model.IsDeceased) model.DateOfDeath = null;
        ApplyEligibilityRules();
    }
    #endregion

    #region CRUD
    private async Task UpdateBeneficiaryAsync()
    {
        IsLoading = true;
        try
        {
            // ── Validate finding before sending anything ──────────────────────
            if (findingStatusInput == 2 && string.IsNullOrWhiteSpace(findingRemarksInput))
            {
                toast.ShowError("Finding Remarks are required when finding is Unresolved.");
                return;
            }

            // ── 1. Update beneficiary record ──────────────────────────────────
            var response = await Http.PutAsJsonAsync($"api/Beneficiary/{model.Id}", model);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Update failed: {error}");
                return;
            }

            // ── 2. Save finding alongside the update ──────────────────────────
            var findingDto = new UpsertBeneficiaryFindingDto
            {
                FindingStatus = findingStatusInput,
                FindingRemarks = findingStatusInput == 2 ? findingRemarksInput : null
            };

            var (success, findingError) = await FindingService.UpsertAsync(model.Id, findingDto);
            if (!success)
            {
                // Beneficiary was saved but finding failed — warn but still navigate
                toast.ShowWarning($"Record updated but finding could not be saved: {findingError}");
            }
            else
            {
                toast.ShowSuccess("Record and findings updated successfully.");
            }

            // ── 3. Invalidate cache and navigate back — same as your original ─
            State.Invalidate();
            Navigation.NavigateTo("/beneficiary-records");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task AddBeneficiaryAsync()
    {
        IsLoading = true;
        errorMessage = null;
        successMessage = null;

        var dto = new CreateBeneficiaryInformationDto
        {
            DateApplied = model.DateApplied,
            DateEndorsed = model.DateEndorsed,
            BatchCode = model.BatchCode,
            OscaIdNumber = model.OscaIdNumber,
            OscaIdDateIssued = model.OscaIdDateIssued,
            NcscRrn = model.NcscRrn,
            LastName = model.LastName,
            FirstName = model.FirstName,
            MiddleName = model.MiddleName,
            Extension = model.Extension,
            BirthDate = model.BirthDate,
            PhoneNumber = model.PhoneNumber,
            Sex = model.Sex,
            IsIndigenousPeople = model.IsIndigenousPeople,
            IsPersonWithDisability = model.IsPersonWithDisability,
            CivilStatus = model.CivilStatus,
            Citizenship = model.Citizenship,
            PsgcCodeRegion = model.PsgcCodeRegion,
            PsgcCodeProvince = model.PsgcCodeProvince,
            PsgcCodeMunicipality = model.PsgcCodeMunicipality,
            PsgcCodeBarangay = model.PsgcCodeBarangay,
            IsCompliant = model.IsCompliant,
            Validator = model.Validator,
            ValidationDate = model.ValidationDate,
            PaymentStatus = model.PaymentStatus,
            ModeOfPayment = model.ModeOfPayment,
            PaymentDate = model.PaymentDate,
            IsDeceased = model.IsDeceased,
            AssessmentRemarks = model.AssessmentRemarks,
            DateOfDeath = model.DateOfDeath,
            IsEligible = model.IsEligible,
            RemarkCategory = model.RemarkCategory,
            Remarks = model.Remarks,
            IsDeleted = false
        };

        try
        {
            var client = await AuthService.GetAuthorizedClientAsync();
            var response = await Http.PostAsJsonAsync("api/Beneficiary/create", dto);
            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess("Grantee has been registered successfully.");
                ResetForm();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrWhiteSpace(error) ? "Something went wrong." : error;
                toast.ShowError(errorMessage);
            }
        }
        catch (Exception ex) { toast.ShowError($"Unexpected error: {ex.Message}"); }
        finally { IsLoading = false; }
    }
    #endregion
