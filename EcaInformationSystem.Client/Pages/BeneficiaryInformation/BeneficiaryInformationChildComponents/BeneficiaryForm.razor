    private void ApplyEligibilityRules()
    {
        // ✅ Use ValidationDate as the reference point if it has been set.
        // This means: "was this person already at milestone age ON the day they were validated?"
        // Example: BirthDate = May 28, 1946 → 80th birthday = May 28, 2026
        // ValidationDate = May 26, 2026 → milestone NOT yet reached → IsEligible = false
        // ValidationDate = May 28, 2026 → milestone reached → IsEligible = true
        // ValidationDate = May 30, 2026 → milestone already passed → IsEligible = true
        var referenceDate = model.ValidationDate != default
            ? model.ValidationDate
            : (DateTime?)null; // falls back to DateTime.Today inside the method

        var milestoneReached = ComputeMilestoneYear(model.BirthDate, referenceDate) > 0;
        var isFilipino = model.Citizenship == 1;

        model.IsEligible = milestoneReached && isFilipino;
        StateHasChanged();
    }
    /// <summary>
    /// Returns the milestone year if the person has reached a milestone age
    /// (80, 85, 90, 95, 100) on or before EITHER:
    /// - the ValidationDate (if provided), OR
    /// - today's date
    /// whichever is LATER.
    ///
    /// This ensures that if someone was validated slightly before their birthday
    /// (e.g. validated March 12, birthday March 13) but their birthday has now
    /// already passed today (June 2), they are still correctly marked eligible.
    ///
    /// Returns 0 if no milestone has been reached yet under either reference date.
    /// </summary>
    private static int ComputeMilestoneYear(DateTime birthDate, DateTime? referenceDate = null)
    {
        if (birthDate == default || birthDate == DateTime.MinValue)
            return 0;

        var today = DateTime.Today;

        // ✅ Use the LATER of ValidationDate and today.
        // - If ValidationDate is in the future (pre-dating), use it.
        // - If ValidationDate is in the past (e.g. March 12) but today is later
        // (June 2) and the birthday has passed in between, today wins.
        var asOf = referenceDate.HasValue
            ? (referenceDate.Value.Date > today ? referenceDate.Value.Date : today)
            : today;

        foreach (var milestone in new[] { 100, 95, 90, 85, 80 })
        {
            int milestoneYear = birthDate.Year + milestone;

            if (milestoneYear < 2024)
                continue;

            var milestoneBirthday = new DateTime(milestoneYear, birthDate.Month, birthDate.Day);

            // ✅ Milestone reached if birthday has passed on or before asOf
            if (milestoneBirthday <= asOf)
                return milestoneYear;
        }

        return 0;
    }
    private int? GetEffectiveAge()
    {
        if (model.BirthDate == default || model.BirthDate == DateTime.MinValue) return null;
        return CalculateAge(model.BirthDate, DateTime.Today);
    }

    private int CalculateAge(DateTime birthDate, DateTime asOf)
    {
        var birth = birthDate.Date;
        var age = asOf.Date.Year - birth.Year;
        if (birth > asOf.Date.AddYears(-age)) age--;
        return age;
    }

    private int? GetAge(DateTime? birthDate)
    {
        if (birthDate == null) return null;
        var today = DateTime.Today;
        var age = today.Year - birthDate.Value.Year;
        if (birthDate.Value.Date > today.AddYears(-age)) age--;
        return age;
    }

