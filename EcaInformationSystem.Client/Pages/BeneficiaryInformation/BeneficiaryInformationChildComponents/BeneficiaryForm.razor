    private bool IsFieldIncomplete(object? value, object? fallback = null)
    {
        if (value == null) return true;
        if (value is string str && string.IsNullOrWhiteSpace(str)) return true;
        if (value is int i && i == 0) return true;
        if (value is DateTime dt && dt == DateTime.MinValue) return true;
        return false;
    }

    private bool NeedsUpdating(object? value, object? fallback = null)
    {
        return IsFieldIncomplete(value, fallback);
    }

    private string GetFieldStatusBadge(object? value, string label)
    {
        if (IsFieldIncomplete(value))
            return $"<span class='badge bg-warning text-dark ms-1' title='{label} needs updating'><i class='bi bi-exclamation-triangle-fill me-1'></i>Needs Updating</span>";
        return "";
    }

    private MarkupString RenderFieldWithStatus(object? value, string label, string displayValue)
    {
        if (IsFieldIncomplete(value))
        {
            return new MarkupString($@"
            <span class='text-warning d-flex align-items-center gap-1'>
                <i class='bi bi-exclamation-triangle-fill'></i>
                {displayValue}
                <span class='badge bg-warning text-dark' style='font-size:9px;'>NEEDS UPDATE</span>
            </span>
        ");
        }
        return new MarkupString(displayValue);
    }
    #endregion - Private Helpers End
