@* BeneficiaryForm.razor — Annex A (2026) aligned, with system-only fields separated out *@
@using System.Text.Json
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.Helpers
@using EcaInformationSystem.Client.Pages.BeneficiaryInformation.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable
@inject HttpClient Http
@inject ToastService toast
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject BeneficiaryStateService State
@inject BeneficiaryFindingClientService FindingService
@inject IJSRuntime JS

<EditForm id="beneficiary-form-root" Model="@model" OnValidSubmit="@OpenSaveConfirmationModal" OnInvalidSubmit="@OnFormInvalidSubmit">
    <DataAnnotationsValidator />
    <div id="annexa-validation-summary">
        <ValidationSummary class="text-danger mb-3 small" />
    </div>

    @* ── Draft recovery banner — shown when a locally-saved draft is found
       that differs from what's currently loaded (e.g. after an accidental
       reload/close mid-entry) ── *@
    @if (_showDraftBanner)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center py-2 px-3 mb-3">
            <div>
                <i class="bi bi-clock-history me-2"></i>
                We found unsaved changes from a previous session
                @(_draftSavedAt.HasValue ? $"(saved {_draftSavedAt.Value.ToLocalTime():MMM dd, yyyy hh:mm tt})" : "")
                . Would you like to restore them?
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-primary" @onclick="RestoreDraftAsync">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Restore
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DiscardDraftAsync">
                    Discard
                </button>
            </div>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════
       SYSTEM FIELD — Reference Number (PDO-internal, NOT part of Annex A)
       ══════════════════════════════════════════════════════════════════ *@
    <div class="sys-card mb-3">
        <div class="sys-card-header d-flex align-items-center justify-content-between" style="cursor:pointer;"
             @onclick="() => _showRefNumber = !_showRefNumber">
            <span><i class="bi bi-hash me-2"></i>Reference Number <span class="badge bg-secondary fw-normal ms-2" style="font-size:10px;">Internal / Optional</span></span>
            <i class="bi @(_showRefNumber ? "bi-chevron-up" : "bi-chevron-down") text-muted"></i>
        </div>
        @if (_showRefNumber)
        {
            <div class="sys-card-body">
                <p class="text-muted small mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    For PDO internal numbering only — this does not appear on the printed Annex A form.
                    Leave blank to save without one; assign later via <strong>Bulk Assign Ref Number</strong>.
                </p>
                <div class="sf-grid">
                    <div class="ff">
                        <label class="ff-label">Quarter</label>
                        <select class="ff-input" @bind="model.Quarter">
                            <option value="">-- Skip for now --</option>
                            <option value="1">Q1 (Jan–Mar)</option>
                            <option value="2">Q2 (Apr–Jun)</option>
                            <option value="3">Q3 (Jul–Sep)</option>
                            <option value="4">Q4 (Oct–Dec)</option>
                        </select>
                    </div>
                    <div class="ff">
                        <label class="ff-label">Batch</label>
                        <input type="text" class="ff-input" placeholder="e.g. 1" @bind="model.Batch" />
                    </div>
                    <div class="ff">
                        <label class="ff-label">Year (short)</label>
                        <input type="number" class="ff-input" placeholder="e.g. 26" @bind="model.RefYear" />
                    </div>
                </div>
                @if (HasRefNumber)
                {
                    <div class="alert alert-success py-1 px-2 mt-2 mb-0 small">
                        <i class="bi bi-check-circle me-1"></i>
                        Will be assigned: <strong>Q@(model.Quarter)B@(model.Batch)-@(model.RefYear?.ToString("D2"))-#####-XIII</strong>
                    </div>
                }
            </div>
        }
    </div>
      <div class="system-fields-body">

            @* ── Remarks (system tracking, not on paper form) ── *@
            <div class="form-section mb-3">
                <div class="form-section-header">
                    <i class="bi bi-calendar me-2"></i>
                        Date Applied /Endorsed & Batch Code 
                    <span class="badge bg-secondary fw-normal ms-2" style="font-size:10px;">
                        INTERNAL
                    </span>
                </div>
                <div class="form-section-body">
                    <div class="form-grid">
                           <div class="ff">
                                    <label class="ff-label">Date Applied</label>
                                    <UniformDateInput Value="@model.DateApplied" ValueChanged="@(v => model.DateApplied = v)" />
                           </div>
                          <div class="ff">
                                    <label class="ff-label">Date Endorsed</label>
                                    <UniformDateInput Value="@model.DateEndorsed" ValueChanged="@(v => model.DateEndorsed = v)" />
                         </div>
                        <div class="ff">
                                    <label class="ff-label">Batch Code</label>
                                    <input type="text" class="ff-input" placeholder="e.g. BATCH-2026-001" @bind="model.BatchCode" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
@* ══════════════════════════════════════════════════════════════════
       ANNEX A DOCUMENT WRAPPER — editable replica of the printed form
       ══════════════════════════════════════════════════════════════════ *@
    <div class="annexa-doc annexa-doc--form mb-3">

        @* ── HEADER — logos + agency text (same as AnnexAPrintDocument) ── *@
        <div class="annexa-doc-header-row">
            <img src="@_ncscLogoSrc" alt="NCSC Seal" class="annexa-doc-logo-left" />
            <div class="annexa-doc-header-text">
                <div class="annexa-doc-header-line1">Republic of the Philippines</div>
                <div class="annexa-doc-header-line1">Office of the President</div>
                <div class="annexa-doc-header-title">NATIONAL COMMISSION OF SENIOR CITIZENS</div>
                <div class="annexa-doc-header-address">
                    Penthouse, The Upper Class Tower, Quezon Avenue Corner Scout Reyes,<br />
                    Barangay Paligsahan, District 4, Quezon City
                </div>
            </div>
            <img src="@_bagongLogoSrc" alt="Bagong Pilipinas" class="annexa-doc-logo-right" />
        </div>

        <div class="annexa-doc-annex-tag">
            <div class="fw-bold">ANNEX A</div>
            <div class="annexa-doc-annex-subtag">This form is not for sale.</div>
        </div>

        <div class="annexa-doc-title-box">
            <div class="annexa-doc-title-main">GRANTEE/CLAIMANT FORM</div>
            <div class="annexa-doc-title-script">"Honoring Filipino Octogenarians, Nonagenarians and Centenarians"</div>
            <div class="annexa-doc-purpose-block">
                <strong>PURPOSE:</strong> To claim the cash gift under Republic Act (R.A.) No. 11982.<br />
                <strong>INSTRUCTIONS:</strong>
                <ol class="mb-0 ps-3">
                    <li>Fill-out this form completely and correctly.</li>
                    <li>Do not leave any blank space. If not applicable, kindly indicate "N/A".</li>
                    <li>Write legibly and in CAPITAL letters.</li>
                </ol>
            </div>
        </div>
    @* ══════════════════════════════════════════════════════════════════
       A. DATA PRIVACY CONSENT — rendered ONCE, here only
       ══════════════════════════════════════════════════════════════════ *@
    <div class="annexa-section">
        <div class="annexa-header"><span class="annexa-letter">A.</span> DATA PRIVACY CONSENT</div>
        <div class="annexa-body">
            <p class="annexa-note mb-2">
                In compliance with R.A. No. 10173 ("Data Privacy Act of 2012"), I hereby consent the NCSC
                to collect, use, and process my personal information for the implementation of R.A. No. 11982.
            </p>
    <div class="annexa-checkbox-row">
        <label class="annexa-checkbox-item">
             <input type="radio" name="dataPrivacyConsent" checked="@(model.DataPrivacyConsent == true)"
                        @onchange="@(() => model.DataPrivacyConsent = true)" />
                    Consent
        </label>
                <label class="annexa-checkbox-item">
                    <input type="radio" name="dataPrivacyConsent" checked="@(model.DataPrivacyConsent == false)"
                        @onchange="@(() => model.DataPrivacyConsent = false)" />
                    Dissent
                </label>
            </div>
            @if (model.DataPrivacyConsent == null)
            {
                <span class="badge bg-secondary fw-normal" style="font-size:9px;">Not yet answered</span>
            }
            @if (model.DataPrivacyConsent != true && _showValidationHints)
            {
                <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                    <i class="bi bi-exclamation-triangle me-1"></i>Consent must be confirmed before saving.
                </div>
            }   
            @if (model.DataPrivacyConsent != true && _showValidationHints)
            {
                <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                    <i class="bi bi-exclamation-triangle me-1"></i>Consent must be confirmed before saving.
                </div>
            }
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════════
       B. PLACE OF SUBMISSION
       ══════════════════════════════════════════════════════════════════ *@
    <div class="annexa-section">
        <div class="annexa-header"><span class="annexa-letter">B.</span> PLACE OF SUBMISSION</div>
        <div class="annexa-body">
            <div class="annexa-checkbox-row">
                <label class="annexa-checkbox-item">
                    <input type="radio" name="placeOfSubmission" checked="@(model.PlaceOfSubmission == 1)"
                           @onchange="@(() => model.PlaceOfSubmission = 1)" />
                    Local (within the PH)
                </label>
                <label class="annexa-checkbox-item">
                    <input type="radio" name="placeOfSubmission" checked="@(model.PlaceOfSubmission == 2)"
                           @onchange="@(() => model.PlaceOfSubmission = 2)" />
                    Abroad
                </label>
            </div>
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════════
       C. PERSONAL INFORMATION
       ══════════════════════════════════════════════════════════════════ *@
    <div class="annexa-section">
        <div class="annexa-header"><span class="annexa-letter">C.</span> PERSONAL INFORMATION</div>
        <div class="annexa-body">

            @* C.1 / C.2 *@
            <div class="annexa-grid cols-2 mb-2">
                <div class="annexa-field">
                    <span class="annexa-item-label">C.1 NCSC Registration Reference Number <span class="annexa-required">*</span></span>
                    <InputNumber class="annexa-input" @bind-Value="model.NcscRrn" @bind-Value:after="OnNcscRrnChanged" />
                    <ValidationMessage For="@(() => model.NcscRrn)" class="ff-err" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">C.2 LGU OSCA ID Number</span>
                    <input class="annexa-input" value="@model.OscaIdNumber" @oninput="e => model.OscaIdNumber = SanitizeUpper(e.Value?.ToString())" />
                </div>
            </div>

            @* C.3 / C.4 *@
            <div class="annexa-grid cols-2 mb-2">
                <div class="annexa-field">
                    <span class="annexa-item-label">C.3 First Name <span class="annexa-required">*</span></span>
                    <input class="annexa-input" value="@model.FirstName" @oninput="e => model.FirstName = SanitizeName(e.Value?.ToString())" />
                    <ValidationMessage For="@(() => model.FirstName)" class="ff-err" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">C.4 Middle Name</span>
                    <input class="annexa-input" value="@model.MiddleName" @oninput="e => model.MiddleName = SanitizeName(e.Value?.ToString())" />
                </div>
            </div>

            @* C.5 / C.6 *@
            <div class="annexa-grid cols-2 mb-2">
                <div class="annexa-field">
                    <span class="annexa-item-label">C.5 Last Name <span class="annexa-required">*</span></span>
                    <input class="annexa-input" value="@model.LastName" @oninput="e => model.LastName = SanitizeName(e.Value?.ToString())" />
                    <ValidationMessage For="@(() => model.LastName)" class="ff-err" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">C.6 Suffix</span>
                    <select class="annexa-select" @bind="model.Extension">
                        <option value="">N/A</option>
                        <option value="Sr.">Sr.</option>
                        <option value="Jr.">Jr.</option>
                        <option value="II">II</option>
                        <option value="III">III</option>
                        <option value="IV">IV</option>
                        <option value="V">V</option>
                    </select>
                </div>
            </div>

            @* C.7 / C.8 *@
            <div class="annexa-grid cols-3 mb-2">
                <div class="annexa-field">
                    <span class="annexa-item-label">C.7 Date of Birth <span class="annexa-required">*</span></span>
                    <UniformDateInput CssClass="annexa-input" Value="@model.BirthDate" ValueChanged="@OnBirthDateChanged" />
                    <ValidationMessage For="@(() => model.BirthDate)" class="ff-err" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">
                        Age (auto)
                        @if (MissedProgramStartCutoff)
                        {
                            <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Ineligible — missed ECA program start cutoff"></i>
                        }
                    </span>
                    <input class="annexa-input annexa-readonly"
                           style="@(MissedProgramStartCutoff ? "color:#dc3545;font-weight:600;border-color:#dc3545;" : "")"
                           value="@(GetAge(model.BirthDate)?.ToString() ?? "—")" disabled />
                    <span class="annexa-item-label mt-1 d-block">
                        Milestone Year (auto)
                        @if (MissedProgramStartCutoff)
                        {
                            <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Ineligible — missed ECA program start cutoff"></i>
                        }
                    </span>
                    <input class="annexa-input annexa-readonly"
                           style="@(MissedProgramStartCutoff ? "color:#dc3545;font-weight:600;border-color:#dc3545;" : "")"
                           value="@(MissedProgramStartCutoff ? "N/A" : (ComputeMilestoneYear(model.BirthDate, model.ValidationDate != default ? model.ValidationDate : (DateTime?)null) is var my && my > 0 ? my.ToString() : "—"))"
                           disabled />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">C.8 Contact Number/s <span class="annexa-required">*</span></span>
                    @for (int i = 0; i < model.PhoneNumbers.Count; i++)
                    {
                        var idx = i;
                        <div class="d-flex gap-1 align-items-start mb-1">
                            <div class="flex-grow-1">
                                <input class="annexa-input" value="@model.PhoneNumbers[idx].Number"
                                       @onchange="@(e => OnPhoneNumberChanged(idx, e.Value?.ToString()))"
                                       placeholder="09171234567" maxlength="11" />
                                @if (_showValidationHints && !IsValidPhoneNumber(model.PhoneNumbers[idx].Number))
                                {
                                    <span class="ff-err d-block">Must be 11 digits starting with 09 (e.g. 09171234567).</span>
                                }
                            </div>
                            <button type="button" class="annexa-icon-btn annexa-icon-btn--danger" title="Remove number"
                                    aria-label="Remove number" @onclick="@(() => RemovePhoneNumber(idx))">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                    @if (!model.PhoneNumbers.Any() && _showValidationHints)
                    {
                        <span class="ff-err d-block mb-1">At least one contact number is required.</span>
                    }
                    @if (model.PhoneNumbers.Count < MaxPhoneNumbers)
                    {
                        <button type="button" class="annexa-icon-btn annexa-icon-btn--primary mt-1" title="Add another number"
                                aria-label="Add another number" @onclick="AddPhoneNumber">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    }
                    else
                    {
                        <span class="annexa-item-note d-block mt-1">Maximum of @MaxPhoneNumbers contact numbers.</span>
                    }
                </div>
            </div>

            @if (MissedProgramStartCutoff)
            {
                <div class="alert alert-danger d-flex align-items-start gap-2 py-2 px-3 mb-2 small">
                    <i class="bi bi-exclamation-octagon-fill mt-1"></i>
                    <div>
                        <strong>Ineligible — missed the ECA program start cutoff.</strong><br />
                        This grantee turned 80 before the program's start date (@EcaEligibilityHelper.ProgramStartDate.ToString("MMMM d, yyyy")),
                        so there is no milestone year they ever qualified under. Payment Status will be automatically set to
                        <strong>N/A</strong> and this record cannot be marked eligible.
                    </div>
                </div>
            }

            @* C.9.1 — Address in the Philippines. PSGC cascading selects sit
               INLINE in the same grid as House#/Street/Zip, exactly matching
               the paper form's single-row layout. Region is a system-required
               addition (needed to drive the Province cascade) — not on the
               paper form itself, flagged with a small note so it doesn't
               look out of place. *@
            <div class="annexa-subsection" style="border-top:none; margin-top:0; padding-top:0;">
                <div class="annexa-subsection-title">C.9.1 Address in the Philippines</div>
                <div class="annexa-grid cols-4">
                    <div class="annexa-field">
                        <span class="annexa-item-label">House #</span>
                        <input class="annexa-input" value="@model.HouseNumber" @oninput="e => model.HouseNumber = SanitizeUpper(e.Value?.ToString())" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Street Name</span>
                        <input class="annexa-input" value="@model.StreetName" @oninput="e => model.StreetName = SanitizeUpper(e.Value?.ToString())" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">
                            Region <span class="annexa-required">*</span>
                            <span class="annexa-item-note" style="display:inline;">(required to look up Province)</span>
                        </span>
                        <select class="annexa-select" value="@model.PsgcCodeRegion" @onchange="OnFormRegionChanged"
                                disabled="@(_isFormRegionLoading || IsLoading)">
                            <option value="0">@(_isFormRegionLoading ? "Loading..." : "Select Region")</option>
                            @foreach (var r in _formRegions)
                            {
                                <option value="@r.PsgcCodeRegion">@r.Name</option>
                            }
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Province <span class="annexa-required">*</span></span>
                        <select class="annexa-select" value="@model.PsgcCodeProvince" @onchange="OnFormProvinceChanged"
                                disabled="@(model.PsgcCodeRegion == 0 || _isFormProvinceLoading || IsLoading)">
                            <option value="0">@(_isFormProvinceLoading ? "Loading..." : "Select Province")</option>
                            @foreach (var p in _formProvinces)
                            {
                                <option value="@p.PsgcCodeProvince">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">City/Municipality <span class="annexa-required">*</span></span>
                        <select class="annexa-select" value="@model.PsgcCodeMunicipality" @onchange="OnFormMunicipalityChanged"
                                disabled="@(model.PsgcCodeProvince == 0 || _isFormMunicipalityLoading || IsLoading)">
                            <option value="0">@(_isFormMunicipalityLoading ? "Loading..." : "Select Municipality")</option>
                            @foreach (var m in _formMunicipalities)
                            {
                                <option value="@m.PsgcCodeMunicipality">@m.Name</option>
                            }
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Barangay <span class="annexa-required">*</span></span>
                        <select class="annexa-select" value="@model.PsgcCodeBarangay" @onchange="OnFormBarangayChanged"
                                disabled="@(model.PsgcCodeMunicipality == 0 || _isFormBarangayLoading || IsLoading)">
                            <option value="0">@(_isFormBarangayLoading ? "Loading..." : "Select Barangay")</option>
                            @foreach (var b in _formBarangays)
                            {
                                <option value="@b.PsgcCodeBarangay">@b.Name</option>
                            }
                        </select>
                        <ValidationMessage For="@(() => model.PsgcCodeBarangay)" class="ff-err" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Zip Code</span>
                        <input class="annexa-input" value="@model.ZipCode" @oninput="e => model.ZipCode = SanitizeUpper(e.Value?.ToString())" />
                    </div>
                </div>
            </div>

            @* C.9.2 — Address Abroad, positioned immediately after C.9.1, exactly like the paper form *@
            <BeneficiaryAddressSection PlaceOfSubmission="@model.PlaceOfSubmission"
                                       Abroad="@(model.AbroadAddress ??= new())"
                                       AbroadChanged="@(a => model.AbroadAddress = a)" />

            @* C.10 / C.11 / C.12 / C.13 *@
            <div class="annexa-subsection">
                <div class="annexa-grid cols-4">
                    <div class="annexa-field">
                        <span class="annexa-item-label">C.10 Sex <span class="annexa-required">*</span></span>
                        <select class="annexa-select" @bind="model.Sex">
                            <option value="0">Select Sex</option>
                            <option value="1">Male</option>
                            <option value="2">Female</option>
                        </select>
                        <ValidationMessage For="@(() => model.Sex)" class="ff-err" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">C.11 Civil Status</span>
                        <select class="annexa-select" @bind="model.CivilStatus">
                            <option value="0">Select Civil Status</option>
                            <option value="1">Single</option>
                            <option value="3">Married</option>
                            <option value="2">Widow/Widower</option>
                            <option value="4">Common-Law</option>
                            <option value="5">Others</option>
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">C.12 Citizenship</span>
                        <select class="annexa-select" @bind="model.Citizenship" @bind:after="ApplyEligibilityRules">
                            <option value="0">Select Citizenship</option>
                            <option value="1">Filipino</option>
                            <option value="2">Dual Citizen</option>
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">C.13 Disability</span>
                        <div class="d-flex gap-3">
                            <label class="annexa-checkbox-item">
                                <input type="checkbox" checked="@(model.IsPersonWithDisability == true)"
                                       @onchange="@(e => model.IsPersonWithDisability = (bool)(e.Value ?? false) ? true : (bool?)null)" />
                                Yes
                            </label>
                            <label class="annexa-checkbox-item">
                                <input type="checkbox" checked="@(model.IsPersonWithDisability == false)"
                                       @onchange="@(e => model.IsPersonWithDisability = (bool)(e.Value ?? false) ? false : (bool?)null)" />
                                No
                            </label>
                        </div>
                    </div>

                    @if (model.CivilStatus == 5)
                    {
                        <div class="annexa-field">
                            <span class="annexa-item-label">Specify Civil Status</span>
                            <input class="annexa-input" value="@model.CivilStatusOtherDetail" @oninput="e => model.CivilStatusOtherDetail = SanitizeUpper(e.Value?.ToString())" />
                        </div>
                    }
                    @if (model.Citizenship == 2)
                    {
                        <div class="annexa-field">
                            <span class="annexa-item-label">Dual Citizenship Details</span>
                            <input class="annexa-input" value="@model.DualCitizenshipDetails" @oninput="e => model.DualCitizenshipDetails = SanitizeUpper(e.Value?.ToString())" />
                        </div>
                    }
                    @if (model.IsPersonWithDisability == true)
                    {
                        <div class="annexa-field">
                            <span class="annexa-item-label">Type of Disability</span>
                            <input class="annexa-input" value="@model.DisabilityType" @oninput="e => model.DisabilityType = SanitizeUpper(e.Value?.ToString())" />
                        </div>
                    }
                </div>
            </div>

            @* C.14 *@
            <div class="annexa-subsection">
                <span class="annexa-item-label">C.14 Ethnicity — Member of Indigenous Peoples (IP)</span>
                <div class="d-flex gap-3 mb-1">
                    <label class="annexa-checkbox-item">
                        <input type="checkbox" checked="@(model.IsIndigenousPeople == true)"
                               @onchange="@(e => model.IsIndigenousPeople = (bool)(e.Value ?? false) ? true : (bool?)null)" />
                        Yes
                    </label>
                    <label class="annexa-checkbox-item">
                        <input type="checkbox" checked="@(model.IsIndigenousPeople == false)"
                               @onchange="@(e => model.IsIndigenousPeople = (bool)(e.Value ?? false) ? false : (bool?)null)" />
                        No
                    </label>
                </div>
                @if (model.IsIndigenousPeople == true)
                {
                    <input class="annexa-input" placeholder="Name of IP group" value="@model.EthnicityName" @oninput="e => model.EthnicityName = SanitizeUpper(e.Value?.ToString())" />
                }
            </div>

            @* Deceased toggle stays here — end of Section C, matches where the
               original form had it grouped with Identity/Personal info *@
            <div class="annexa-subsection">
                <div class="annexa-checkbox-row">
                    <label class="annexa-checkbox-item">
                        <input type="checkbox" checked="@model.IsDeceased" @onchange="OnIsDeceasedChanged" />
                        Grantee is Deceased
                    </label>
                    @if (model.IsDeceased)
                    {
                        <div class="annexa-field" style="min-width:220px;">
                            <span class="annexa-item-label">Date of Death</span>
                            <UniformDateInput Value="@model.DateOfDeath" ValueChanged="@OnDateOfDeathChanged" MaxDate="@DateTime.Today" />
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

    @* ── D. Family Information ── *@
    <BeneficiaryFamilySection FamilyMembers="@model.FamilyMembers"
                              FamilyMembersChanged="@(list => model.FamilyMembers = list)" />

    @* ── E. Transaction Account ── *@
    <BeneficiaryBankAccountSection Account="@(model.BankAccount ??= new())"
                                   AccountChanged="@(acct => model.BankAccount = acct)"
                                   PlaceOfSubmission="@model.PlaceOfSubmission"
                                   IsClaimantContext="false"
                                   IsDeceased="@model.IsDeceased" />

    @* ── F. For Deceased Grantees (conditional) ── *@
<BeneficiaryClaimantSection IsDeceased="@model.IsDeceased"
                           DateOfDeath="@model.DateOfDeath"
                           PlaceOfSubmission="@model.PlaceOfSubmission"
                           Claimant="@(model.Claimant ??= new())"
                           ClaimantChanged="@(c => model.Claimant = c)"
                           ClaimantBankAccount="@(model.ClaimantBankAccount ??= new())"
                           ClaimantBankAccountChanged="@(a => model.ClaimantBankAccount = a)" />

    @* ── G. Attestation / Certification ── *@
    <BeneficiaryAttestationSection IsSignedDeclaration="@model.IsSignedDeclaration"
                                IsSignedDeclarationChanged="@(v => model.IsSignedDeclaration = v)"
                                DateSigned="@model.DateSigned"
                                DateSignedChanged="@(v => model.DateSigned = v)"
                                ShowValidationHints="@_showValidationHints" />
                                   @* ── H./I. Verification Checklist & Result — now inline, end of Annex A ── *@
   @* ── H./I. Verification Checklist & Result — part of the main Save/Update flow now ── *@
    <BeneficiaryVerificationChecklistSection Checklist="@(model.VerificationChecklist ??= new())"
                                              ChecklistChanged="@(c => model.VerificationChecklist = c)"
                                              IsDeceased="@model.IsDeceased"
                                              IsAdmin="@(_isAdmin || _isPdo)"
                                              IsEligible="@model.IsEligible"
                                              IsEligibleChanged="@(v => OnIsEligibleChanged(v))"
                                              IsCompliant="@model.IsCompliant"
                                              IsCompliantChanged="@(v => { model.IsCompliant = v; StateHasChanged(); })"
                                              Validator="@model.Validator"
                                              ValidatorChanged="@(v => model.Validator = v)"
                                              ValidationDate="@model.ValidationDate"
                                              ValidationDateChanged="@OnValidationDateChanged"
                                              EligibilityRemarks="@model.EligibilityRemarks"
                                              EligibilityRemarksChanged="@(v => model.EligibilityRemarks = v)"
                                              AssessmentRemarks="@model.AssessmentRemarks"
                                              AssessmentRemarksChanged="@(v => model.AssessmentRemarks = v)" />
            @* ── Tracking Number — matches the centered placement on the printed
                Annex A form (Section I, alongside Date of Verification) ── *@
            <div class="annexa-tracking-number-block">
                <div class="annexa-field" style="max-width: 340px; margin: 0 auto;">
                    <span class="annexa-item-label text-center d-block">
                        NCSC Registration Number serves as the tracking number <span class="annexa-required">*</span>
                    </span>
                    <input type="text" class="annexa-input annexa-readonly text-center"
                        value="@model.TrackingNumber" disabled />
                </div>
            </div>
</div>

    @* ══════════════════════════════════════════════════════════════════
       SYSTEM FIELDS — everything below is NOT part of the printed Annex A
       form. Wrapped in one bounding box so it reads as a single distinct
       group, separate from the paper-form replica above.
       ══════════════════════════════════════════════════════════════════ *@
    <div class="system-fields-wrapper mb-3">
        <div class="system-fields-header">
            <i class="bi bi-gear-fill"></i> Internal / System Fields
        </div>
        <div class="system-fields-body">

            @* ── Remarks (system tracking, not on paper form) ── *@
            <div class="form-section mb-3">
                <div class="form-section-header"><i class="bi bi-chat-left-text me-2"></i>Internal Remarks</div>
                <div class="form-section-body">
                    <div class="form-grid">
                        <div class="ff">
                            <label class="ff-label">Remark Category</label>
                            <InputSelect class="ff-input" @bind-Value="model.RemarkCategory">
                                <option value="0">Select Remark</option>
                                <option value="1">Deceased prior reaching milestone age</option>
                                <option value="2">Out of town/Country</option>
                                <option value="3">Incomplete required documents</option>
                                <option value="4">Inconsistent documents</option>
                                <option value="5">Cannot be reached/Located</option>
                                <option value="6">Did not reach the milestone age</option>
                                <option value="7">Lacking of documents/Requirements</option>
                                <option value="8">For Correction</option>
                                <option value="9">Waived</option>
                                <option value="10">Lacking Proof of Relationship</option>
                                <option value="11">No show</option>
                                <option value="12">Double Application with Different Surname used</option>
                                <option value="13">For CGD Island Municipality</option>
                                <option value="14">Others</option>
                                <option value="15">Transfer to other Region</option>
                            </InputSelect>
                        </div>
                        <div class="ff" style="grid-column: 1 / -1;">
                            <label class="ff-label">Remarks</label>
                            <InputTextArea class="ff-input" @bind-Value="model.Remarks" rows="2" />
                        </div>
                    </div>
                </div>
            </div>
            @* ── CO Status (internal workflow, admin-gated, not on paper form) ── *@
            <div class="form-section mb-3">
                <div class="form-section-header">
                    <i class="bi bi-building-check me-2"></i>CO Status
                    @if (!_isAdmin && _roleLoaded)
                    {
                        <span class="badge bg-secondary ms-2 fw-normal" style="font-size:10px;"><i class="bi bi-lock me-1"></i>Admin only</span>
                    }
                </div>
                <div class="form-section-body">
                    <div class="form-grid">
                        <div class="ff">
                            <label class="ff-label">CO Status</label>
                            <InputSelect class="ff-input" @bind-Value="model.CoStatus" @bind-Value:after="OnCoStatusChanged" disabled="@(!_isAdmin)">
                                <option value="">Not Set</option>
                                <option value="1">Endorsed</option>
                                <option value="2">Approved</option>
                            </InputSelect>
                        </div>
                        <div class="ff">
                            <label class="ff-label">CO Date Endorsed @(model.CoStatus == 1 ? "*" : "")</label>
                            <UniformDateInput Value="@model.CoDateEndorsed" ValueChanged="@OnCoDateEndorsedChanged" Disabled="@(model.CoStatus != 1 || !_isAdmin)" />
                        </div>
                        <div class="ff">
                            <label class="ff-label">CO Date Approved @(model.CoStatus == 2 ? "*" : "")</label>
                            <UniformDateInput Value="@model.CoDateApproved" ValueChanged="@OnCoDateApprovedChanged" Disabled="@(model.CoStatus != 2 || !_isAdmin)" />
                        </div>
                    </div>
                    @if (!_isAdmin && _roleLoaded)
                    {
                        <div class="alert alert-secondary py-2 px-3 mt-2 mb-0 small d-flex align-items-center gap-2">
                            <i class="bi bi-lock-fill text-muted"></i>
                            <span>CO Status can only be modified by Administrators.</span>
                        </div>
                    }
                </div>
            </div>
@* ── Liveness Verification & EFT Readiness (internal workflow, not on paper form) ── *@
<div class="form-section mb-3">
    <div class="form-section-header">
        <i class="bi bi-person-check-fill me-2"></i>Liveness Verification &amp; EFT Readiness
    </div>
    <div class="form-section-body">
        <div class="form-grid">
            <div class="ff">
                <label class="ff-label">Liveness Verified?</label>
                <label class="annexa-checkbox-item">
                    <input type="checkbox" checked="@(model.IsLivenessVerified ?? false)"
                           @onchange="@(e => model.IsLivenessVerified = (bool)(e.Value ?? false))" />
                    Verified
                </label>
                @if (model.IsLivenessVerified == null)
                {
                    <span class="badge bg-secondary fw-normal mt-1" style="font-size:9px;">Not yet checked</span>
                }
            </div>
            <div class="ff">
                <label class="ff-label">Date of Liveness</label>
                <UniformDateInput Value="@model.DateOfLiveness" ValueChanged="@(v => model.DateOfLiveness = v)"
                                  MaxDate="@DateTime.Today" />
            </div>
            <div class="ff">
                <label class="ff-label">Ready for Electronic Fund Transfer?</label>
                <label class="annexa-checkbox-item">
                    <input type="checkbox" checked="@(model.IsReadyForEft ?? false)"
                           @onchange="@(e => model.IsReadyForEft = (bool)(e.Value ?? false))" />
                    Ready for EFT
                </label>
                @if (model.IsReadyForEft == null)
                {
                    <span class="badge bg-secondary fw-normal mt-1" style="font-size:9px;">Not yet checked</span>
                }
            </div>
        </div>
    </div>
</div>

            @* ── Findings (edit mode only, admin-gated) ── *@
            @if (IsEditMode)
            {
                <div class="form-section mb-3">
                    <div class="form-section-header">
                        <i class="bi bi-exclamation-triangle me-2"></i>Findings
                        @if (!_isAdmin && _roleLoaded)
                        {
                            <span class="badge bg-secondary ms-2 fw-normal" style="font-size:10px;"><i class="bi bi-lock me-1"></i>Admin only</span>
                        }
                    </div>
                    <div class="form-section-body">
                        @if (isLoadingFinding)
                        {
                            <div class="text-center py-2"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                        }
                        else
                        {
                            <div class="form-grid">
                                <div class="ff">
                                    <label class="ff-label">With Findings</label>
                                    <select class="ff-input" @bind="findingStatusInput" disabled="@(IsLoading || !_isAdmin)">
                                        <option value="0">N/A</option>
                                        <option value="1">Solved</option>
                                        <option value="2">Unresolved</option>
                                    </select>
                                </div>
                                @if (findingStatusInput == 2)
                                {
                                    <div class="ff" style="grid-column: 1 / -1;">
                                        <label class="ff-label">Finding Remarks <span class="req">*</span></label>
                                        <InputTextArea class="ff-input" @bind-Value="findingRemarksInput" rows="3"
                                                       placeholder="Describe the unresolved finding..." disabled="@(IsLoading || !_isAdmin)" />
                                    </div>
                                }
                                @if (currentFinding is not null)
                                {
                                    <div class="ff">
                                        <small class="text-muted">
                                            Last updated:
                                            @((currentFinding.UpdatedAt ?? currentFinding.CreatedAt).ToLocalTime().ToString("MMM dd, yyyy hh:mm tt"))
                                        </small>
                                    </div>
                                }
                            </div>
                            @if (!_isAdmin && _roleLoaded)
                            {
                                <div class="alert alert-secondary py-2 px-3 mt-2 mb-0 small d-flex align-items-center gap-2">
                                    <i class="bi bi-lock-fill text-muted"></i>
                                    <span>Findings can only be modified by Administrators.</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            @* ── Payment History (edit mode only — system feature, not on paper form) ── *@
            @if (IsEditMode)
            {
                <div class="form-section mb-3">
                    <div class="form-section-header d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-clock-history me-2"></i>Payment History</span>
                        @if (_isAdmin)
                        {
                            <button type="button" class="btn btn-sm btn-light" @onclick="OpenAddPaymentHistoryModal">
                                <i class="bi bi-plus-circle me-1"></i>Record Payment
                            </button>
                        }
                    </div>
                    <div class="form-section-body">
                        @if (isLoadingPaymentHistory)
                        {
                            <div class="text-center py-3">
                                <span class="spinner-border spinner-border-sm text-primary"></span>
                                <span class="ms-2 text-muted small">Loading payment history...</span>
                            </div>
                        }
                        else if (!paymentHistory.Any())
                        {
                            <div class="alert alert-secondary py-2 px-3 small mb-0">
                                <i class="bi bi-info-circle me-1"></i>No payment records yet.
                            </div>
                        }
                        else
                        {
                            <div class="payment-timeline">
                                @foreach (var entry in paymentHistory)
                                {
                                    <div class="payment-timeline-item @(entry.IsCurrent ? "payment-timeline-item--current" : "")">
                                        <div class="payment-timeline-marker @GetPaymentBadgeClass(entry.PaymentStatus)"></div>
                                        <div class="payment-timeline-content">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <span class="tbl-badge @GetPaymentBadgeClass(entry.PaymentStatus)">
                                                        @GetPaymentStatusText(entry.PaymentStatus)
                                                    </span>
                                                    @if (entry.IsCurrent)
                                                    {
                                                        <span class="badge bg-primary ms-1" style="font-size:9px;">CURRENT</span>
                                                    }
                                                    @if (entry.DateModified.HasValue)
                                                    {
                                                        <span class="badge bg-warning text-dark ms-1" style="font-size:9px;">CORRECTED</span>
                                                    }
                                                </div>
                                                <small class="text-muted">
                                                    @entry.DateCreated.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
                                                </small>
                                            </div>
                                            <div class="row g-1 mt-1" style="font-size:12px;">
                                                @if (entry.PayrollQuarter.HasValue || entry.FiscalYear.HasValue)
                                                {
                                                    <div class="col-6">
                                                        <span class="text-muted">Period:</span>
                                                        @(entry.PayrollQuarter.HasValue ? $"Q{entry.PayrollQuarter}" : "—")
                                                        @(entry.FiscalYear?.ToString() ?? "")
                                                    </div>
                                                }
                                                @if (entry.PaymentDate.HasValue)
                                                {
                                                    <div class="col-6">
                                                        <span class="text-muted">Paid:</span>
                                                        @entry.PaymentDate.Value.ToString("MMM dd, yyyy")
                                                    </div>
                                                }
                                                @if (entry.PaymentStatus == 2)
                                                {
                                                    <div class="col-6">
                                                        <span class="text-muted">Mode:</span>
                                                        @(entry.ModeOfPayment == 1 ? "Cash Advance by SDO" : entry.ModeOfPayment == 2 ? "Bank Transfer" : "—")
                                                    </div>
                                                }
                                                <div class="col-12 text-muted" style="font-size:10px;">
                                                    Recorded by @entry.CreatedBy
                                                    @if (entry.DateModified.HasValue)
                                                    {
                                                        <span>· Corrected by @entry.ModifiedBy on @entry.DateModified.Value.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(entry.Remarks))
                                            {
                                                <div class="mt-1" style="font-size:11px;">
                                                    <span class="text-muted">Remarks:</span> @entry.Remarks
                                                </div>
                                            }
                                            @if (_isAdmin)
                                            {
                                                <div class="d-flex gap-2 mt-1">
                                                    <button type="button" class="btn btn-link btn-sm p-0" style="font-size:11px;"
                                                            @onclick="() => OpenEditPaymentHistoryModal(entry)">
                                                        <i class="bi bi-pencil-square me-1"></i>Correct
                                                    </button>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-danger" style="font-size:11px;"
                                                            @onclick="() => ConfirmDeletePaymentHistory(entry)">
                                                        <i class="bi bi-trash me-1"></i>Delete
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
    </div>

    @* ── Actions ── *@
    <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
        <span class="text-muted small">
            @if (_lastDraftSavedAt.HasValue)
            {
                <span><i class="bi bi-cloud-check me-1"></i>Draft saved @_lastDraftSavedAt.Value.ToString("hh:mm:ss tt")</span>
            }
        </span>
        <div class="d-flex gap-2">
            <button type="button" class="sys-btn sys-btn-cancel" @onclick="CancelFormAsync">
                <i class="bi bi-x-circle me-1"></i>Cancel
            </button>
            <button type="submit" class="sys-btn sys-btn-save" disabled="@IsLoading">
                @(IsEditMode ? "Update Record" : "Save Record")
            </button>
        </div>
    </div>

</EditForm>
<HxModal @ref="addPaymentHistoryModal">
    <HeaderTemplate><h5 class="modal-title">Record New Payment</h5></HeaderTemplate>
    <BodyTemplate>
        <div class="row g-2">
            <div class="col-6">
                <label class="form-label small">Payroll Quarter</label>
                <select class="form-select form-select-sm" @bind="_newPayment.PayrollQuarter">
                    <option value="">-- None --</option>
                    <option value="1">Q1</option>
                    <option value="2">Q2</option>
                    <option value="3">Q3</option>
                    <option value="4">Q4</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Fiscal Year</label>
                <select class="form-select form-select-sm" @bind="_newPayment.FiscalYear">
                    <option value="">-- None --</option>
                    @foreach (var year in _availableMilestoneYears)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Payment Status</label>
                <select class="form-select form-select-sm" @bind="_newPayment.PaymentStatus">
                    <option value="0">N/A</option>
                    <option value="1">Unpaid</option>
                    <option value="2">Paid</option>
                    <option value="3">Pending</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Mode of Payment</label>
                <select class="form-select form-select-sm" @bind="_newPayment.ModeOfPayment"
                        disabled="@(_newPayment.PaymentStatus != 2)">
                    <option value="">-- Select --</option>
                    <option value="1">Cash Advance by SDO</option>
                    <option value="2">Bank Transfer</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Payment Date</label>
                <!-- ✅ Enable for both Paid AND Unpaid -->
                <input type="date" class="form-control form-control-sm" @bind="_newPayment.PaymentDate"
                       disabled="@(_newPayment.PaymentStatus != 2 && _newPayment.PaymentStatus != 1)" />
            </div>
            <div class="col-12">
                <label class="form-label small">Remarks</label>
                <textarea class="form-control form-control-sm" rows="2" @bind="_newPayment.Remarks"></textarea>
            </div>
        </div>
        @if (_newPayment.PaymentStatus == 2 &&
             (_newPayment.PayrollQuarter == null || _newPayment.FiscalYear == null))
        {
            <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Payroll Quarter and Fiscal Year are required for Paid status.
            </div>
        }
        @if (_newPayment.PaymentStatus == 1 &&
             (_newPayment.PayrollQuarter == null || _newPayment.FiscalYear == null))
        {
            <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Payroll Quarter and Fiscal Year are required for Unpaid status.
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => addPaymentHistoryModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="OpenAddPaymentConfirmation" Disabled="@_isSavingPaymentHistory">
            @(_isSavingPaymentHistory ? "Saving..." : "Add Record")
        </HxButton>
    </FooterTemplate>
</HxModal>

<HxModal @ref="editPaymentHistoryModal">
    <HeaderTemplate><h5 class="modal-title">Correct Payment Record</h5></HeaderTemplate>
    <BodyTemplate>
        <div class="alert alert-warning py-2 px-3 small">
            <i class="bi bi-exclamation-triangle me-1"></i>
            This edits the existing record in place. If this is actually a NEW payment
            event, close this and use "Record Payment" instead.
        </div>
        <div class="row g-2">
            <div class="col-6">
                <label class="form-label small">Payroll Quarter</label>
                <select class="form-select form-select-sm" @bind="_editPayment.PayrollQuarter">
                    <option value="">-- None --</option>
                    <option value="1">Q1</option>
                    <option value="2">Q2</option>
                    <option value="3">Q3</option>
                    <option value="4">Q4</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Fiscal Year</label>
                <select class="form-select form-select-sm" @bind="_editPayment.FiscalYear">
                    <option value="">-- None --</option>
                    @foreach (var year in _availableMilestoneYears)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Payment Status</label>
                <select class="form-select form-select-sm" @bind="_editPayment.PaymentStatus">
                    <option value="0">N/A</option>
                    <option value="1">Unpaid</option>
                    <option value="2">Paid</option>
                    <option value="3">Pending</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Mode of Payment</label>
                <select class="form-select form-select-sm" @bind="_editPayment.ModeOfPayment"
                        disabled="@(_editPayment.PaymentStatus != 2)">
                    <option value="">-- Select --</option>
                    <option value="1">Cash Advance by SDO</option>
                    <option value="2">Bank Transfer</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Payment Date</label>
                <!-- ✅ FIXED: Using _editPayment instead of _newPayment, enabled for both Paid AND Unpaid -->
                <input type="date" class="form-control form-control-sm" @bind="_editPayment.PaymentDate"
                       disabled="@(_editPayment.PaymentStatus != 2 && _editPayment.PaymentStatus != 1)" />
            </div>
            <div class="col-12">
                <label class="form-label small">Remarks</label>
                <textarea class="form-control form-control-sm" rows="2" @bind="_editPayment.Remarks"></textarea>
            </div>
        </div>
        <!-- ✅ Add warning alerts for missing required fields -->
        @if (_editPayment.PaymentStatus == 2 &&
             (_editPayment.PayrollQuarter == null || _editPayment.FiscalYear == null))
        {
            <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Payroll Quarter and Fiscal Year are required for Paid status.
            </div>
        }
        @if (_editPayment.PaymentStatus == 1 &&
             (_editPayment.PayrollQuarter == null || _editPayment.FiscalYear == null))
        {
            <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Payroll Quarter and Fiscal Year are required for Unpaid status.
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => editPaymentHistoryModal.HideAsync()">Cancel</HxButton>
