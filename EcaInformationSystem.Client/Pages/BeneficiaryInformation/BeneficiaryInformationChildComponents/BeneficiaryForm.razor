    #region Draft autosave
    private async Task StartWatchingFormActivityAsync()
    {
        _draftDotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            _draftWatchHandle = await JS.InvokeAsync<IJSObjectReference?>(
                "draftInterop.watchFormActivity", _draftDotNetRef, "beneficiary-form-root", DraftDebounceMs);
        }
        catch
        {
            // If the interop call fails for any reason, the form still works —
            // it just won't autosave a local draft.
        }
    }

    // Called from JS a short debounce after the user stops typing/selecting anywhere in the form.
    [JSInvokable]
    public async Task OnFormActivityDetected() => await AutosaveDraftAsync();

    private async Task AutosaveDraftAsync()
    {
        // ⚠️ If a "restore your unsaved changes?" banner is showing, the user
        // typing into the form INSTEAD of clicking Restore/Discard is itself a
        // decision — they're continuing with what's on screen. Previously this
        // just returned here forever, silently disabling autosave for the rest
        // of the session (since only Restore/Discard flip _showDraftBanner back
        // to false) — so any section filled in after that point was never
        // captured, and only whatever the STALE draft already had (e.g. up
        // through Section C from an earlier session) ever came back on restore.
        // Dismissing the banner here and falling through lets the current edits
        // start saving immediately, same as if they'd clicked Discard first.
        if (_showDraftBanner)
            _showDraftBanner = false;

        try
        {
            var currentJson = JsonSerializer.Serialize(model);
            if (currentJson == _baselineModelJson || currentJson == _lastSavedDraftJson)
                return;

            var envelope = new DraftEnvelope { SavedAt = DateTime.UtcNow, Model = model };
            await JS.InvokeVoidAsync("localStorage.setItem", DraftKey, JsonSerializer.Serialize(envelope));

            _lastSavedDraftJson = currentJson;
            _lastDraftSavedAt = DateTime.Now;

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Best-effort background autosave — a failure here shouldn't interrupt the user.
        }
    }

    private async Task CheckForDraftAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", DraftKey);
            if (string.IsNullOrWhiteSpace(raw)) return;

            var envelope = JsonSerializer.Deserialize<DraftEnvelope>(raw);
            if (envelope?.Model == null) return;

            // A draft that matches what's already on screen isn't worth surfacing.
            if (JsonSerializer.Serialize(envelope.Model) == _baselineModelJson) return;

            _draftSavedAt = envelope.SavedAt;
            _showDraftBanner = true;
        }
        catch
        {
            // Corrupt/incompatible draft (e.g. from an older app version) — drop it silently.
            await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey);
        }
    }

    private async Task RestoreDraftAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", DraftKey);
            var envelope = string.IsNullOrWhiteSpace(raw) ? null : JsonSerializer.Deserialize<DraftEnvelope>(raw);
            if (envelope?.Model == null)
            {
                _showDraftBanner = false;
                return;
            }

            model = envelope.Model;
            _showDraftBanner = false;

            // Re-hydrate the address cascade dropdowns for the restored PSGC codes.
            if (model.PsgcCodeRegion > 0)
                await LoadFormProvincesAsync(model.PsgcCodeRegion);
            if (model.PsgcCodeProvince > 0)
                await LoadFormMunicipalitiesAsync(model.PsgcCodeProvince);
            if (model.PsgcCodeMunicipality > 0)
                await LoadFormBarangaysAsync(model.PsgcCodeMunicipality);

            ApplyEligibilityRules();
            toast.ShowSuccess("Draft restored.");
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to restore draft: {ex.Message}");
        }
    }

    private async Task DiscardDraftAsync()
    {
        await ClearDraftAsync();
        _showDraftBanner = false;
    }

    private async Task ClearDraftAsync()
    {
        try { await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey); }
        catch { /* best-effort */ }
        _lastSavedDraftJson = null;
        _lastDraftSavedAt = null;
    }
    #endregion

    public async ValueTask DisposeAsync()
    {
        try
        {
            // ⚠️ The debounced autosave (DraftDebounceMs) is a pending JS setTimeout.
            // unwatchFormActivity below clearTimeout()s it as part of tearing down
            // the listener — so navigating away before that debounce window elapses
            // (Create/Edit are routed pages, not tabs, so this runs on every
            // navigation-away) previously discarded whatever was typed in that last
            // ~1.2s without ever writing it to localStorage. Flush a final synchronous
            // save first so nothing typed right before leaving the page is lost.
            await AutosaveDraftAsync();

            if (_draftWatchHandle is not null)
            {
                await JS.InvokeVoidAsync("draftInterop.unwatchFormActivity", _draftWatchHandle);
                await _draftWatchHandle.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* circuit/page already gone */ }
        _draftDotNetRef?.Dispose();
    }
    private string PaymentStatusLabel(int status) => status switch
    {
        0 => "N/A",
        1 => "Unpaid",
        2 => "Paid",
        3 => "Pending",
        _ => "Unknown"
    };
    private void ApplyEligibilityRules()
    {
        var referenceDate = model.ValidationDate != default
            ? model.ValidationDate
            : (DateTime?)null;

        var milestoneReached = ComputeMilestoneYear(model.BirthDate, referenceDate) > 0;
        var isFilipino = model.Citizenship == 1;

        // ✅ Guard — a grantee who already turned 80 but never crossed a
        // qualifying milestone (see ComputeMilestoneYear) missed the ECA
        // program's actual start date (March 17, 2024) and can never enter it,
        // no matter their citizenship.
        model.IsEligible = MissedProgramStartCutoff
            ? false
            : milestoneReached && isFilipino;
        StateHasChanged();
    }

    // ✅ Delegates to the shared helper (EcaInformationSystem.Shared.Helpers)
    // so the client's math always matches the server's — including the
    // March 17, 2024 program start cutoff. A milestone birthday that fell
    // before that date (even if the YEAR is 2024) does not count.
    private static int ComputeMilestoneYear(DateTime birthDate, DateTime? referenceDate = null)
        => EcaEligibilityHelper.ComputeMilestoneYear(birthDate, referenceDate);

    // True once the grantee is 80+ but has never reached a qualifying
    // milestone — their 80th (and every later) birthday fell before the
    // program existed, so there is no path in for them.
    private bool MissedProgramStartCutoff =>
        model.BirthDate != default && model.BirthDate != DateTime.MinValue
        && EcaEligibilityHelper.MissedProgramStartCutoff(model.BirthDate);
    private int? GetEffectiveAge()
    {
        if (model.BirthDate == default || model.BirthDate == DateTime.MinValue) return null;
        return CalculateAge(model.BirthDate, DateTime.Today);
    }

    private int CalculateAge(DateTime birthDate, DateTime asOf)
    {
        var birth = birthDate.Date;
        var age = asOf.Date.Year - birth.Year;
        if (birth > asOf.Date.AddYears(-age)) age--;
        return age;
    }

    private int? GetAge(DateTime? birthDate)
    {
        if (birthDate == null) return null;
        var today = DateTime.Today;
        var age = today.Year - birthDate.Value.Year;
        if (birthDate.Value.Date > today.AddYears(-age)) age--;
        return age;
    }
