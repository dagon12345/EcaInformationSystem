    private async Task OpenSaveConfirmationModal()
    {
        ClearMessages();

        if (model.DataPrivacyConsent != true)
        {
            _showValidationHints = true;
            toast.ShowError("Please confirm both Data Privacy Consent and the Attestation/Declaration before saving.");
            await ScrollToValidationSummaryAsync();
            return;
        }
        if (model.DataPrivacyConsent != true || !model.IsSignedDeclaration)
        {
            _showValidationHints = true;
            toast.ShowError("Please confirm both Data Privacy Consent and the Attestation/Declaration before saving.");
            await ScrollToValidationSummaryAsync();
            return;
        }

        if (model.NcscRrn == null)
        {
            toast.ShowError("NCSC Registration Reference Number is required.");
            await ScrollToValidationSummaryAsync();
            return;
        }

        var validPhoneNumbers = model.PhoneNumbers.Where(n => !string.IsNullOrWhiteSpace(n.Number)).ToList();
        if (!validPhoneNumbers.Any())
        {
            _showValidationHints = true;
            toast.ShowError("At least one contact number is required.");
            await ScrollToValidationSummaryAsync();
            return;
        }
        if (validPhoneNumbers.Any(n => !IsValidPhoneNumber(n.Number)))
        {
            _showValidationHints = true;
            toast.ShowError("One or more contact numbers are not valid Philippine mobile numbers (11 digits, starting with 09).");
            await ScrollToValidationSummaryAsync();
            return;
        }

        if (model.FamilyMembers.Any(f => !BeneficiaryFamilySection.IsValidOptionalContactNumber(f.ContactNumber)))
        {
            toast.ShowError("Spouse/Child Contact Number must be exactly 11 digits (Section D).");
            await ScrollToValidationSummaryAsync();
            return;
        }

        pendingAction = IsEditMode ? "edit" : "add";
        confirmationTitle = IsEditMode ? "Confirm Update" : "Confirm Add";
        confirmationMessage = IsEditMode
            ? "Are you sure you want to update this record?"
            : "Are you sure you want to add this record?";
        await confirmModal.ShowAsync();
    }
    private void ClearMessages() { successMessage = null; errorMessage = null; }

    private async Task ConfirmActionAsync()
    {
        try
        {
            await confirmModal.HideAsync();
            switch (pendingAction)
            {
                case "add": await AddBeneficiaryAsync(); break;
                case "edit": await UpdateBeneficiaryAsync(); break;
                case "delete-payment-history": await DeletePaymentHistoryEntryAsync(); break;
                case "add-payment-history": await SubmitAddPaymentHistoryAsync(); break;
                case "edit-payment-history": await SubmitEditPaymentHistoryAsync(); break;
            }
        }
        catch (Exception ex) { toast.ShowError($"Error: {ex.Message}"); }
    }

    private async Task OnIsDeceasedChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out var v)) model.IsDeceased = v;

        if (!model.IsDeceased)
        {
            model.DateOfDeath = null;
            // ✅ NEW — clear claimant data the moment Deceased is unchecked, so
            // re-checking it later within the same session starts from a blank
            // form rather than resurfacing stale entries. Server-side cleanup
            // (DeleteClaimantAsync) still fires independently on save — this is
            // purely a client-side UX improvement, not a substitute for it.
            model.Claimant = null;
        }

        ApplyEligibilityRules();
        await IsDeceasedLoaded.InvokeAsync(model.IsDeceased);
    }
