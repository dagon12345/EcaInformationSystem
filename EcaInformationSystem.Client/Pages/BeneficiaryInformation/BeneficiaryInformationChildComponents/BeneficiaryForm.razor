    private async Task OnPaymentStatusChangeRequested(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var newStatus))
            return;

        // Clear payment date when switching away from Paid
        if (newStatus != 2)
            model.PaymentDate = null;
        model.ModeOfPayment = 0;

        // ✅ Always update model.PaymentStatus immediately so the UI reacts
        // (date field enables/disables, required star shows, etc.)
        model.PaymentStatus = newStatus;
        StateHasChanged();

        // No confirmation needed if value didn't change from original or create mode
        if (!IsEditMode || newStatus == _originalPaymentStatus)
            return;

        // Store pending and open confirmation modal
        _pendingPaymentStatus = newStatus;
        await _paymentConfirmModal.ShowAsync();
