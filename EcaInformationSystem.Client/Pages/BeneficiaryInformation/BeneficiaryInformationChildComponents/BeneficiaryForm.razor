    #region CRUD
    private async Task UpdateBeneficiaryAsync()
    {
        IsLoading = true;
        try
        {
            // ✅ CO Status date guards
            if (model.CoStatus == 1 && !model.CoDateEndorsed.HasValue)
            {
                toast.ShowError("CO Date Endorsed is required when CO Status is Endorsed.");
                IsLoading = false;
                return;
            }
            if (model.CoStatus == 2 && !model.CoDateApproved.HasValue)
            {
                toast.ShowError("CO Date Approved is required when CO Status is Approved.");
                IsLoading = false;
                return;
            }
            // ✅ Payment date required if Paid
            if (model.PaymentStatus == 2 && !model.PaymentDate.HasValue)
            {
                toast.ShowError("Payment Date is required when Payment Status is Paid.");
                return;
            }

            // ✅ Clear payment date if not Paid — keep data clean
            if (model.PaymentStatus != 2)
                model.PaymentDate = null;

            // ── Validate finding before sending anything ──────────────────────
            if (findingStatusInput == 2 && string.IsNullOrWhiteSpace(findingRemarksInput))
            {
                toast.ShowError("Finding Remarks are required when finding is Unresolved.");
                return;
            }

            // ── 1. Update beneficiary record ──────────────────────────────────
            var response = await Http.PutAsJsonAsync($"api/Beneficiary/{model.Id}", model);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Update failed: {error}");
                return;
            }

            // ── 2. Save finding alongside the update ──────────────────────────
            var findingDto = new UpsertBeneficiaryFindingDto
            {
                FindingStatus = findingStatusInput,
                FindingRemarks = findingStatusInput == 2 ? findingRemarksInput : null
            };

            var (success, findingError) = await FindingService.UpsertAsync(model.Id, findingDto);
            if (!success)
            {
                // Beneficiary was saved but finding failed — warn but still navigate
                toast.ShowWarning($"Record updated but finding could not be saved: {findingError}");
            }
            else
            {
                toast.ShowSuccess("Record and findings updated successfully.");
            }

            // ── 3. Invalidate cache and navigate back — same as your original ─
            State.Invalidate();
            Navigation.NavigateTo("/beneficiary-records");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task AddBeneficiaryAsync()
    {
        IsLoading = true;
        errorMessage = null;
        successMessage = null;

        // ── Guards ────────────────────────────────────────────────────────────
        if (model.CoStatus == 1 && !model.CoDateEndorsed.HasValue)
        {
            toast.ShowError(
                "CO Date Endorsed is required when CO Status is Endorsed.");
            IsLoading = false; return;
        }
        if (model.CoStatus == 2 && !model.CoDateApproved.HasValue)
        {
            toast.ShowError(
                "CO Date Approved is required when CO Status is Approved.");
            IsLoading = false; return;
        }
        if (model.PaymentStatus == 2 && !model.PaymentDate.HasValue)
        {
            toast.ShowError(
                "Payment Date is required when Payment Status is Paid.");
            IsLoading = false; return;
        }
        if (model.PaymentStatus != 2)
            model.PaymentDate = null;

        // ✅ Warn if partial ref number entry — don't block, just clear the partial
        if (!HasRefNumber &&
            (model.Quarter != null ||
             !string.IsNullOrWhiteSpace(model.Batch) ||
             model.RefYear != null))
        {
            toast.ShowWarning(
                "Partial reference number cleared — fill Quarter, Batch, and Year " +
                "together or leave all blank. Record will be saved without one.");
            model.Quarter = null;
            model.Batch = null;
            model.RefYear = null;
        }

        // ✅ Warn if saving without ref number entirely
        if (!HasRefNumber)
        {
            toast.ShowWarning(
                "Saving without a reference number. " +
                "Use Bulk Assign Ref Number in the grid to assign later.");
        }

        _pendingDto = new CreateBeneficiaryInformationDto
        {
            // ✅ Null if not provided
            Quarter = model.Quarter,
            Batch = string.IsNullOrWhiteSpace(model.Batch) ? null : model.Batch,
            RefYear = model.RefYear,
            RefCode = null,

            // ... rest of your fields unchanged ...
            DateApplied = model.DateApplied,
            DateEndorsed = model.DateEndorsed,
            BatchCode = model.BatchCode,
            OscaIdNumber = model.OscaIdNumber,
            OscaIdDateIssued = model.OscaIdDateIssued,
            NcscRrn = model.NcscRrn,
            LastName = model.LastName,
            FirstName = model.FirstName,
            MiddleName = model.MiddleName,
            Extension = model.Extension,
            BirthDate = model.BirthDate,
            PhoneNumber = model.PhoneNumber,
            Sex = model.Sex,
            IsIndigenousPeople = model.IsIndigenousPeople,
            IsPersonWithDisability = model.IsPersonWithDisability,
            CivilStatus = model.CivilStatus,
            Citizenship = model.Citizenship,
            PsgcCodeRegion = model.PsgcCodeRegion,
            PsgcCodeProvince = model.PsgcCodeProvince,
            PsgcCodeMunicipality = model.PsgcCodeMunicipality,
            PsgcCodeBarangay = model.PsgcCodeBarangay,
            IsCompliant = model.IsCompliant,
            Validator = model.Validator,
            ValidationDate = model.ValidationDate,
            PaymentStatus = model.PaymentStatus,
            ModeOfPayment = model.ModeOfPayment,
            PaymentDate = model.PaymentDate,
            IsDeceased = model.IsDeceased,
            AssessmentRemarks = model.AssessmentRemarks,
            EligibilityRemarks = model.EligibilityRemarks,
            DateOfDeath = model.DateOfDeath,
            IsEligible = model.IsEligible,
            RemarkCategory = model.RemarkCategory,
            Remarks = model.Remarks,
            IsDeleted = false,
            BypassSoftDuplicateCheck = false
        };

        IsLoading = false;

        // ✅ Send directly — no ref number modal gate
        await SendCreateRequestAsync(_pendingDto);
    }
    private async Task SendCreateRequestAsync(CreateBeneficiaryInformationDto dto)
    {
        try
        {
            IsLoading = true;
            var response = await Http.PostAsJsonAsync("api/Beneficiary/create", dto);

            // ── Soft duplicates found ─────────────────────────────────────────
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var conflictResult = await response.Content
                    .ReadFromJsonAsync<EcaInformationService.Shared.DTOs.CreateBeneficiaryResultDto>();

                _softDuplicates = conflictResult?.SoftDuplicates ?? new();
                _showSoftDuplicateModal = true;
                StateHasChanged();
                await _softDuplicateModal.ShowAsync();
                return;
            }

            // ── Success ───────────────────────────────────────────────────────
            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess("Grantee has been registered successfully.");
                _softDuplicates.Clear();
                _pendingDto = null;
                _showSoftDuplicateModal = false;
                ResetForm();
                return;
            }

            // ── Other errors ──────────────────────────────────────────────────
            var error = await response.Content.ReadAsStringAsync();
            errorMessage = string.IsNullOrWhiteSpace(error) ? "Something went wrong." : error;
            toast.ShowError(errorMessage);
        }
        catch (Exception ex)
        {
            toast.ShowError($"Unexpected error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
    private async Task ConfirmCreateDespiteDuplicates()
    {
        if (_pendingDto is null) return;

        _pendingDto.BypassSoftDuplicateCheck = true;
        await _softDuplicateModal.HideAsync();
        _showSoftDuplicateModal = false;
        await SendCreateRequestAsync(_pendingDto);
    }
    private async Task CancelSoftDuplicateModal()
    {
        _softDuplicates.Clear();
        _pendingDto = null;
        _showSoftDuplicateModal = false;
        await _softDuplicateModal.HideAsync();
    }
    #endregion
