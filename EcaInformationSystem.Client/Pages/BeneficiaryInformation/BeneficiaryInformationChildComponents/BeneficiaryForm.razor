@* BeneficiaryForm.razor — redesigned to match navy #1F3864 design system *@
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Client.Pages.BeneficiaryInformation.Helpers
@inject HttpClient Http
@inject ToastService toast
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject BeneficiaryStateService State;
@inject BeneficiaryFindingClientService FindingService


<EditForm Model="@model" OnValidSubmit="@OpenSaveConfirmationModal">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3 small" />

    @* ── Reference Number (Optional) ─────────────────────────────────────── *@
    <div class="sf-section-header d-flex align-items-center justify-content-between mt-3" style="cursor:pointer;"
         @onclick="() => _showRefNumber = !_showRefNumber">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-hash text-muted"></i>
            <span class="fw-semibold">Reference Number</span>
            <span class="badge bg-secondary fw-normal" style="font-size:10px;">
                Optional
            </span>
            @if (HasRefNumber)
            {
                <span class="badge bg-success fw-normal" style="font-size:10px;">
                    <i class="bi bi-check me-1"></i>Set
                </span>
            }
        </div>
        <i class="bi @(_showRefNumber ? "bi-chevron-up" : "bi-chevron-down") text-muted"></i>
    </div>

    @if (_showRefNumber)
    {
        <div class="sf-section p-3 border rounded mb-3" style="background: var(--bs-light);">

            <p class="text-muted small mb-2">
                <i class="bi bi-info-circle me-1"></i>
                Leave blank to save without a reference number.
                You can assign it later using
                <strong>Bulk Assign Ref Number</strong> in the records grid.
            </p>

            <div class="sf-grid">
                <div class="ff">
                    <label class="ff-label">Quarter</label>
                    <select class="ff-input" @bind="model.Quarter">
                        <option value="">-- Skip for now --</option>
                        <option value="1">Q1 (Jan–Mar)</option>
                        <option value="2">Q2 (Apr–Jun)</option>
                        <option value="3">Q3 (Jul–Sep)</option>
                        <option value="4">Q4 (Oct–Dec)</option>
                    </select>
                </div>
                <div class="ff">
                    <label class="ff-label">Batch</label>
                    <input type="text" class="ff-input" placeholder="e.g. 1 — leave blank to skip" @bind="model.Batch" />
                </div>
                <div class="ff">
                    <label class="ff-label">Year (short)</label>
                    <input type="number" class="ff-input" placeholder="e.g. 26" @bind="model.RefYear" />
                </div>
            </div>

            @* ── Live preview ── *@
            @if (HasRefNumber)
            {
                <div class="alert alert-success py-1 px-2 mt-2 mb-0 small">
                    <i class="bi bi-check-circle me-1"></i>
                    Will be assigned:
                    <strong>
                        Q@(model.Quarter)B@(model.Batch)-@(model.RefYear?.ToString("D2"))-#####-XIII
                    </strong>
                    <span class="text-muted">(unique code generated on save)</span>
                </div>
            }
            else if (model.Quarter != null || !string.IsNullOrWhiteSpace(model.Batch) || model.RefYear != null)
            {
                @* Partial entry warning *@
                <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Fill in all three fields (Quarter, Batch, Year) to assign a reference number,
                    or clear them all to skip.
                </div>
            }

        </div>
    }
    else if (!HasRefNumber)
    {
        <p class="text-muted small mb-3">
            <i class="bi bi-info-circle me-1"></i>
            No reference number — you can assign it later via
            <strong>Bulk Assign</strong> in the grid.
            <button class="btn btn-link btn-sm p-0 ms-1" @onclick="() => _showRefNumber = true">
                Add now
            </button>
        </p>
    }

    
    @* ── Identity Information ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-person-vcard me-2"></i>Identity Information
        </div>
        <div class="form-section-body">
            <div class="form-grid">
                <div class="ff">
                    <label class="ff-label">Date Applied</label>
                    <UniformDateInput Value="@model.DateApplied" ValueChanged="@(v => model.DateApplied = v)" />
                </div>
                <div class="ff">
                    <label class="ff-label">Date Endorsed</label>
                    <UniformDateInput Value="@model.DateEndorsed" ValueChanged="@(v => model.DateEndorsed = v)" />
                </div>
                <div class="ff">
                    <label class="ff-label">Batch Code</label>
                    <input class="ff-input" @bind="model.BatchCode" @ref="batchCodeInput" />
                </div>
                <div class="ff">
                    <label class="ff-label">OSCA ID Number</label>
                    <InputText class="ff-input" @bind-Value="model.OscaIdNumber" />
                </div>
                <div class="ff">
                    <label class="ff-label">OSCA ID Date Issued</label>
                    <UniformDateInput Value="@model.OscaIdDateIssued"
                                      ValueChanged="@(v => model.OscaIdDateIssued = v)" />
                </div>
                <div class="ff">
                    <label class="ff-label">NCSC RRN</label>
                    <InputNumber class="ff-input" @bind-Value="model.NcscRrn" />
                </div>
                <div class="ff">
                    <label class="ff-label">Last Name <span class="req">*</span></label>
                    <InputText class="ff-input" @bind-Value="model.LastName" />
                    <ValidationMessage For="@(() => model.LastName)" class="ff-err" />
                </div>
                <div class="ff">
                    <label class="ff-label">First Name <span class="req">*</span></label>
                    <InputText class="ff-input" @bind-Value="model.FirstName" />
                    <ValidationMessage For="@(() => model.FirstName)" class="ff-err" />
                </div>
                <div class="ff">
                    <label class="ff-label">Middle Name</label>
                    <InputText class="ff-input" @bind-Value="model.MiddleName" />
                </div>
                <div class="ff">
                    <label class="ff-label">Extension</label>
                    <InputSelect class="ff-input" @bind-Value="model.Extension">
                        <option value="">Select Extension</option>
                        <option value="">N/A</option>
                        <option value="Sr.">Sr.</option>
                        <option value="Jr.">Jr.</option>
                        <option value="II.">II</option>
                        <option value="III">III</option>
                        <option value="IV">IV</option>
                        <option value="V">V</option>
                    </InputSelect>
                </div>
                @* Birth Date *@
                <div class="ff">
                    <label class="ff-label">Birth Date <span class="req">*</span></label>
                    <UniformDateInput Value="@model.BirthDate" ValueChanged="@OnBirthDateChanged" />
                    <ValidationMessage For="@(() => model.BirthDate)" class="ff-err" />
                </div>
                <div class="ff">
                    <label class="ff-label">Age (auto)</label>
                    <input class="ff-input ff-readonly" value="@(GetAge(model.BirthDate)?.ToString() ?? "—")"
                           readonly />
                </div>
                <div class="ff">
                    <label class="ff-label">Phone Number</label>
                    <InputText class="ff-input" @bind-Value="model.PhoneNumber" placeholder="09171234567" />
                </div>
                <div class="ff">
                    <label class="ff-label">Sex <span class="req">*</span></label>
                    <InputSelect class="ff-input" @bind-Value="model.Sex">
                        <option value="0">Select Sex</option>
                        <option value="1">Male</option>
                        <option value="2">Female</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => model.Sex)" class="ff-err" />
                </div>
            </div>

            @* Deceased sub-section *@
            <div class="form-subsection mt-2">
                <div class="form-subsection-label">
                    <i class="bi bi-info-circle me-1"></i>Other
                </div>
                <div class="form-grid">
                    <div class="ff d-flex align-items-center gap-2 pt-3">
                        <input type="checkbox" class="sys-check" checked="@model.IsDeceased"
                               @onchange="OnIsDeceasedChanged" />
                        <label class="ff-label mb-0">Is Deceased</label>
                    </div>
                    @* Date of Death *@
                    <div class="ff">
                        <label class="ff-label">Date of Death</label>
                        <UniformDateInput Value="@model.DateOfDeath" ValueChanged="@OnDateOfDeathChanged"
                                          MaxDate="@DateTime.Today" Disabled="@(!model.IsDeceased)" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Demographic ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-people me-2"></i>Demographic Information
        </div>
        <div class="form-section-body">
            <div class="form-grid">
                <div class="ff d-flex align-items-center gap-2 pt-3">
                    <InputCheckbox class="sys-check" @bind-Value="model.IsIndigenousPeople" />
                    <label class="ff-label mb-0">Indigenous People</label>
                </div>
                <div class="ff d-flex align-items-center gap-2 pt-3">
                    <InputCheckbox class="sys-check" @bind-Value="model.IsPersonWithDisability" />
                    <label class="ff-label mb-0">Person with Disability</label>
                </div>
                <div class="ff">
                    <label class="ff-label">Civil Status</label>
                    <InputSelect class="ff-input" @bind-Value="model.CivilStatus">
                        <option value="0">Select Civil Status</option>
                        <option value="1">Single</option>
                        <option value="2">Widowed</option>
                        <option value="3">Married</option>
                        <option value="4">Live in</option>
                    </InputSelect>
                </div>
                <div class="ff">
                    <label class="ff-label">Citizenship</label>
                    <select class="ff-input" @bind="@model.Citizenship" @bind:after="ApplyEligibilityRules">
                        <option value="0">Select Citizenship</option>
                        <option value="1">Filipino</option>
                        <option value="2">Dual Citizenship</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @* ── Address ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-geo-alt me-2"></i>Address Information
        </div>
        <div class="form-section-body">
            <div class="form-grid">

                @* Region *@
                <div class="ff">
                    <label class="ff-label">Region <span class="req">*</span></label>
                    <select class="ff-input" value="@model.PsgcCodeRegion" @onchange="OnFormRegionChanged"
                            disabled="@(_isFormRegionLoading || IsLoading)">
                        <option value="0">
                            @(_isFormRegionLoading ? "Loading..." : "Select Region")
                        </option>
                        @foreach (var r in _formRegions)
                        {
                            <option value="@r.PsgcCodeRegion">@r.Name</option>
                        }
                    </select>
                </div>

                @* Province *@
                <div class="ff">
                    <label class="ff-label">Province <span class="req">*</span></label>
                    <select class="ff-input" value="@model.PsgcCodeProvince" @onchange="OnFormProvinceChanged"
                            disabled="@(model.PsgcCodeRegion == 0 || _isFormProvinceLoading || IsLoading)">
                        <option value="0">
                            @(_isFormProvinceLoading ? "Loading..." : "Select Province")
                        </option>
                        @foreach (var p in _formProvinces)
                        {
                            <option value="@p.PsgcCodeProvince">@p.Name</option>
                        }
                    </select>
                </div>

                @* Municipality *@
                <div class="ff">
                    <label class="ff-label">Municipality / City <span class="req">*</span></label>
                    <select class="ff-input" value="@model.PsgcCodeMunicipality" @onchange="OnFormMunicipalityChanged"
                            disabled="@(model.PsgcCodeProvince == 0 || _isFormMunicipalityLoading || IsLoading)">
                        <option value="0">
                            @(_isFormMunicipalityLoading ? "Loading..." : "Select Municipality")
                        </option>
                        @foreach (var m in _formMunicipalities)
                        {
                            <option value="@m.PsgcCodeMunicipality">@m.Name</option>
                        }
                    </select>
                </div>

                @* Barangay *@
                <div class="ff">
                    <label class="ff-label">Barangay <span class="req">*</span></label>
                    <select class="ff-input" value="@model.PsgcCodeBarangay" @onchange="OnFormBarangayChanged"
                            disabled="@(model.PsgcCodeMunicipality == 0 || _isFormBarangayLoading || IsLoading)">
                        <option value="0">
                            @(_isFormBarangayLoading ? "Loading..." : "Select Barangay")
                        </option>
                        @foreach (var b in _formBarangays)
                        {
                            <option value="@b.PsgcCodeBarangay">@b.Name</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => model.PsgcCodeBarangay)" class="ff-err" />
                </div>

            </div>
        </div>
    </div>

    @* ── Validation ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-patch-check me-2"></i>Validation Information
        </div>
        <div class="form-section-body">
            <div class="form-grid">
                <div class="ff">
                    <label class="ff-label">Validator <span class="req">*</span></label>
                    <InputText class="ff-input" @bind-Value="model.Validator" />
                    <ValidationMessage For="@(() => model.Validator)" class="ff-err" />
                </div>
                @* Validation Date *@
                <div class="ff">
                    <label class="ff-label">Validation Date <span class="req">*</span></label>
                    <UniformDateInput Value="@model.ValidationDate" ValueChanged="@OnValidationDateChanged" />
                    <ValidationMessage For="@(() => model.ValidationDate)" class="ff-err" />
                </div>
            </div>

      

            <div class="form-subsection mt-2">
                <div class="form-subsection-label">
                    <i class="bi bi-clipboard2-check me-1"></i>Assessment
                </div>
                <div class="form-grid">
                    <div class="ff d-flex align-items-center gap-2 pt-3">
                        <InputCheckbox class="sys-check" @bind-Value="model.IsEligible" />
                        <label class="ff-label mb-0">Is Eligible</label>
                    </div>
                    <div class="ff d-flex align-items-center gap-2 pt-3">
                        <InputCheckbox class="sys-check" @bind-Value="model.IsCompliant" />
                        <label class="ff-label mb-0">Is Compliant</label>
                    </div>

                    @* ✅ EligibilityRemarks — always enabled *@
                    <div class="ff" style="grid-column: 1 / -1;">
                        <label class="ff-label">
                            Eligibility Remarks
                        </label>
                        <InputTextArea class="ff-input" @bind-Value="model.EligibilityRemarks" rows="2"
                                       placeholder="Enter eligibility finding notes..." />
                    </div>

                    @* ✅ ComplianceRemarks — always enabled *@
                    <div class="ff" style="grid-column: 1 / -1;">
                        <label class="ff-label">
                            Compliance Remarks
                        </label>
                        <InputTextArea class="ff-input" @bind-Value="model.AssessmentRemarks" rows="2"
                                       placeholder="Enter compliance finding notes..." />
                    </div>
                </div>
            </div>


        </div>
    </div>

    @* ── Payment ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-cash-coin me-2"></i>Payment Information &amp; Remarks
        </div>
        <div class="form-section-body">
            <div class="form-grid">
                @* ── Payment ── *@
                <div class="ff">
                    <label class="ff-label">Payment Status</label>
                    <select class="ff-input" value="@model.PaymentStatus" @onchange="OnPaymentStatusChangeRequested">
                        <option value="0">N/A</option>
                        <option value="1">Unpaid</option>
                        <option value="2">Paid</option>
                        <option value="3">Pending</option>
                    </select>
                </div>
                <div class="ff">
                    <label class="ff-label">Mode of Payment</label>
                    <InputSelect class="ff-input" @bind-Value="model.ModeOfPayment"
                                 disabled="@(model.PaymentStatus != 2)"> @* ✅ disabled when not Paid *@
                        <option value="0">Select Mode</option>
                        <option value="1">Cash Advance by SDO</option>
                        <option value="2">Bank Transfer</option>
                    </InputSelect>
                </div>
                @* Payment Date *@
                <div class="ff">
                    <label class="ff-label">
                        Payment Date
                        @if (model.PaymentStatus == 2)
                        {
                            <span class="req">*</span>
                        }
                    </label>
                    <UniformDateInput Value="@model.PaymentDate" ValueChanged="@OnPaymentDateChanged"
                                      Disabled="@(model.PaymentStatus != 2)" />
                    @if (model.PaymentStatus == 2 && !model.PaymentDate.HasValue)
                    {
                        <div class="ff-err">Payment Date is required when status is Paid.</div>
                    }
                </div>
                <div class="ff">
                    <label class="ff-label">Remark Category</label>
                    <InputSelect class="ff-input" @bind-Value="model.RemarkCategory">
                        <option value="0">Select Remark</option>
                        <option value="1">Deceased prior reaching milestone age</option>
                        <option value="2">Out of town/Country</option>
                        <option value="3">Incomplete required documents</option>
                        <option value="4">Inconsistent documents</option>
                        <option value="5">Cannot be reached/Located</option>
                        <option value="6">Did not reach the milestone age</option>
                        <option value="7">Lacking of documents/Requirements</option>
                        <option value="8">For Correction</option>
                        <option value="9">Waived</option>
                        <option value="10">Lacking Proof of Relationship</option>
                        <option value="11">No show</option>
                        <option value="12">Double Application with Different Surname used</option>
                        <option value="13">For CGD Island Municipality</option>
                    </InputSelect>
                </div>
                <div class="ff" style="grid-column: 1 / -1;">
                    <label class="ff-label">Remarks</label>
                    <InputTextArea class="ff-input" @bind-Value="model.Remarks" rows="2" />
                </div>
            </div>
        </div>
    </div>
    @* ── CO Status ── *@
    <div class="form-section mb-3">
        <div class="form-section-header">
            <i class="bi bi-building-check me-2"></i>CO Status
        </div>
        <div class="form-section-body">
            <div class="form-grid">
                <div class="ff">
                    <label class="ff-label">CO Status</label>
                    <InputSelect class="ff-input" @bind-Value="model.CoStatus" @bind-Value:after="OnCoStatusChanged">
                        <option value="">Not Set</option>
                        <option value="1">Endorsed</option>
                        <option value="2">Approved</option>
                    </InputSelect>
                </div>

                <div class="ff">
                    <label class="ff-label">
                        CO Date Endorsed
                        @if (model.CoStatus == 1)
                        {
                            <span class="req">*</span>
                        }
                    </label>
                    <UniformDateInput Value="@model.CoDateEndorsed" ValueChanged="@OnCoDateEndorsedChanged"
                                      Disabled="@(model.CoStatus != 1)" />
                </div>

                <div class="ff">
                    <label class="ff-label">
                        CO Date Approved
                        @if (model.CoStatus == 2)
                        {
                            <span class="req">*</span>
                        }
                    </label>
                    <UniformDateInput Value="@model.CoDateApproved" ValueChanged="@OnCoDateApprovedChanged"
                                      Disabled="@(model.CoStatus != 2)" />
                </div>
            </div>
        </div>
    </div>
    @* ── Findings (Edit Mode only) ── *@
    @if (IsEditMode)
    {
        <div class="form-section mb-3">
            <div class="form-section-header">
                <i class="bi bi-exclamation-triangle me-2"></i>Findings
            </div>
            <div class="form-section-body">
                @if (isLoadingFinding)
                {
                    <div class="text-center py-2">
                        <span class="spinner-border spinner-border-sm text-primary"></span>
                        <span class="ms-2 text-muted">Loading finding...</span>
                    </div>
                }
                else
                {
                    <div class="form-grid">
                        <div class="ff">
                            <label class="ff-label">With Findings</label>
                            <select class="ff-input" @bind="findingStatusInput" disabled="@IsLoading">
                                <option value="0">N/A</option>
                                <option value="1">Solved</option>
                                <option value="2">Unresolved</option>
                            </select>
                        </div>

                        @if (findingStatusInput == 2)
                        {
                            <div class="ff" style="grid-column: 1 / -1;">
                                <label class="ff-label">
                                    Finding Remarks <span class="req">*</span>
                                </label>
                                <InputTextArea class="ff-input" @bind-Value="findingRemarksInput" rows="3"
                                               placeholder="Describe the unresolved finding..." disabled="@IsLoading" />
                            </div>
                        }

                        @* ✅ No separate save button — saved together with Update Record *@
                        @if (currentFinding is not null)
                        {
                            <div class="ff">
                                <small class="text-muted">
                                    Last updated:
                                    @((currentFinding.UpdatedAt ?? currentFinding.CreatedAt)
                                        .ToLocalTime()
                                        .ToString("MMM dd, yyyy hh:mm tt"))
                                </small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    @* ── Actions ── *@
    <div class="d-flex justify-content-end gap-2 mt-2">
        <button type="button" class="sys-btn sys-btn-cancel"
                @onclick='() => { State.Invalidate(); Navigation.NavigateTo("/beneficiary-records"); }'>
            <i class="bi bi-x-circle me-1"></i>Cancel
        </button>
        <button type="submit" class="sys-btn sys-btn-save" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            else
            {
                <i class="bi @(IsEditMode ? "bi-pencil-square" : "bi-floppy") me-1"></i>
            }
            @(IsEditMode ? "Update Record" : "Save Record")
        </button>
    </div>

</EditForm>

@* Confirmation modal — unchanged *@
<HxModal @ref="confirmModal">
    <HeaderTemplate>
        <h5>@confirmationTitle</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>@confirmationMessage</p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="CloseConfirmationModal">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="ConfirmActionAsync" Disabled="@IsLoading">Confirm</HxButton>
    </FooterTemplate>
</HxModal>

<HxModal @ref="_paymentConfirmModal">
    <HeaderTemplate>
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
            <h5 class="mb-0">Change Payment Status?</h5>
        </div>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-1">
            You are changing the payment status from
            <strong>@PaymentStatusLabel(_originalPaymentStatus)</strong>
            to
            <strong class="text-primary">@PaymentStatusLabel(_pendingPaymentStatus)</strong>.
        </p>
        <p class="text-muted small mb-0">
            This change will only be saved when you click
            <strong>Update Record</strong>.
        </p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="CancelPaymentStatusChangeAsync">
            Cancel
        </HxButton>
        <HxButton Color="ThemeColor.Warning" @onclick="ConfirmPaymentStatusChangeAsync">
            <i class="bi bi-check-lg me-1"></i>Yes, Change It
        </HxButton>
    </FooterTemplate>
</HxModal>

@* ── Soft Duplicate Warning Modal ── *@
<HxModal @ref="_softDuplicateModal" Size="ModalSize.ExtraLarge">
    <HeaderTemplate>
        <h5 class="modal-title text-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Possible Duplicate Found
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-3">
            The record you are about to create closely matches
            <strong>@_softDuplicates.Count</strong> existing record(s).
            Please review before proceeding:
        </p>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead class="table-warning">
                    <tr>
                        <th>Name</th>
                        <th>Birth Date</th>
                        <th>OSCA ID</th>
                        <th>Municipality</th>
                        <th>Barangay</th>
                        <th>Match</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var match in _softDuplicates)
                    {
                        <tr>
                            <td>@match.ExistingFullName</td>
                            <td>@match.ExistingBirthDate.ToString("MMM dd, yyyy")</td>
                            <td>@(match.ExistingOscaId ?? "—")</td>
                            <td>@(match.ExistingMunicipality ?? "—")</td>
                            <td>@(match.ExistingBarangay ?? "—")</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @((match.MatchScore * 100).ToString("F0"))%
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mt-2 mb-0">
            If this is a <strong>different person</strong>, click
            <strong>Proceed Anyway</strong>.
            Otherwise click <strong>Cancel</strong> to review your entry.
        </p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="CancelSoftDuplicateModal">
            <i class="bi bi-x-circle me-1"></i>Cancel
        </HxButton>
        <HxButton Color="ThemeColor.Warning" @onclick="ConfirmCreateDespiteDuplicates" Disabled="@IsLoading">
            @if (IsLoading)
