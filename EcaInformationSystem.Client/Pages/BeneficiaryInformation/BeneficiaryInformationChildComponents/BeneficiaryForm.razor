@* BeneficiaryForm.razor — Annex A (2026) aligned, with system-only fields separated out *@
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Client.Pages.BeneficiaryInformation.Helpers
@inject HttpClient Http
@inject ToastService toast
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject BeneficiaryStateService State
@inject BeneficiaryFindingClientService FindingService

<EditForm Model="@model" OnValidSubmit="@OpenSaveConfirmationModal">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3 small" />

    @* ══════════════════════════════════════════════════════════════════
       SYSTEM FIELD — Reference Number (PDO-internal, NOT part of Annex A)
       ══════════════════════════════════════════════════════════════════ *@
    <div class="sys-card mb-3">
        <div class="sys-card-header d-flex align-items-center justify-content-between" style="cursor:pointer;"
             @onclick="() => _showRefNumber = !_showRefNumber">
            <span><i class="bi bi-hash me-2"></i>Reference Number <span class="badge bg-secondary fw-normal ms-2" style="font-size:10px;">Internal / Optional</span></span>
            <i class="bi @(_showRefNumber ? "bi-chevron-up" : "bi-chevron-down") text-muted"></i>
        </div>
        @if (_showRefNumber)
        {
            <div class="sys-card-body">
                <p class="text-muted small mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    For PDO internal numbering only — this does not appear on the printed Annex A form.
                    Leave blank to save without one; assign later via <strong>Bulk Assign Ref Number</strong>.
                </p>
                <div class="sf-grid">
                    <div class="ff">
                        <label class="ff-label">Quarter</label>
                        <select class="ff-input" @bind="model.Quarter">
                            <option value="">-- Skip for now --</option>
                            <option value="1">Q1 (Jan–Mar)</option>
                            <option value="2">Q2 (Apr–Jun)</option>
                            <option value="3">Q3 (Jul–Sep)</option>
                            <option value="4">Q4 (Oct–Dec)</option>
                        </select>
                    </div>
                    <div class="ff">
                        <label class="ff-label">Batch</label>
                        <input type="text" class="ff-input" placeholder="e.g. 1" @bind="model.Batch" />
                    </div>
                    <div class="ff">
                        <label class="ff-label">Year (short)</label>
                        <input type="number" class="ff-input" placeholder="e.g. 26" @bind="model.RefYear" />
                    </div>
                    <div class="ff">
                        <label class="ff-label">Tracking Number <span class="badge bg-info fw-normal" style="font-size:9px;">New</span></label>
                        <input type="text" class="ff-input" placeholder="Region-LGU-ECA-year-month-000" @bind="model.TrackingNumber" />
                    </div>
                </div>
                @if (HasRefNumber)
                {
                    <div class="alert alert-success py-1 px-2 mt-2 mb-0 small">
                        <i class="bi bi-check-circle me-1"></i>
                        Will be assigned: <strong>Q@(model.Quarter)B@(model.Batch)-@(model.RefYear?.ToString("D2"))-#####-XIII</strong>
                    </div>
                }
            </div>
        }
    </div>
      <div class="system-fields-body">

            @* ── Remarks (system tracking, not on paper form) ── *@
            <div class="form-section mb-3">
                <div class="form-section-header"><i class="bi bi-chat-left-text me-2"></i>Date Applied/Endorsed (INTERNAL)</div>
                <div class="form-section-body">
                    <div class="form-grid">
                           <div class="ff">
                                    <label class="ff-label">Date Applied</label>
                                    <UniformDateInput Value="@model.DateApplied" ValueChanged="@(v => model.DateApplied = v)" />
                           </div>
                          <div class="ff">
                                    <label class="ff-label">Date Endorsed</label>
                                    <UniformDateInput Value="@model.DateEndorsed" ValueChanged="@(v => model.DateEndorsed = v)" />
                         </div>
                    </div>
                </div>
            </div>
        </div>

    @* ══════════════════════════════════════════════════════════════════
       A. DATA PRIVACY CONSENT — rendered ONCE, here only
       ══════════════════════════════════════════════════════════════════ *@
    <div class="annexa-section">
        <div class="annexa-header"><span class="annexa-letter">A.</span> DATA PRIVACY CONSENT</div>
        <div class="annexa-body">
            <p class="annexa-note mb-2">
                In compliance with R.A. No. 10173 ("Data Privacy Act of 2012"), I hereby consent the NCSC
                to collect, use, and process my personal information for the implementation of R.A. No. 11982.
            </p>
            <div class="annexa-checkbox-row">
                <label class="annexa-checkbox-item">
                    <input type="checkbox" checked="@model.DataPrivacyConsent"
                           @onchange="@(e => model.DataPrivacyConsent = (bool)(e.Value ?? false))" />
                    Consent
                </label>
                <label class="annexa-checkbox-item text-muted">
                    <input type="checkbox" checked="@(!model.DataPrivacyConsent)" disabled /> Dissent
                </label>
            </div>
            @if (!model.DataPrivacyConsent && _showValidationHints)
            {
                <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                    <i class="bi bi-exclamation-triangle me-1"></i>Consent must be confirmed before saving.
                </div>
            }
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════════
       B. PLACE OF SUBMISSION
       ══════════════════════════════════════════════════════════════════ *@
    <div class="annexa-section">
        <div class="annexa-header"><span class="annexa-letter">B.</span> PLACE OF SUBMISSION</div>
        <div class="annexa-body">
            <div class="annexa-checkbox-row">
                <label class="annexa-checkbox-item">
                    <input type="radio" name="placeOfSubmission" checked="@(model.PlaceOfSubmission == 1)"
                           @onchange="@(() => model.PlaceOfSubmission = 1)" />
                    Local (within the PH)
                </label>
                <label class="annexa-checkbox-item">
                    <input type="radio" name="placeOfSubmission" checked="@(model.PlaceOfSubmission == 2)"
                           @onchange="@(() => model.PlaceOfSubmission = 2)" />
                    Abroad
                </label>
            </div>
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════════
       C. PERSONAL INFORMATION
       ══════════════════════════════════════════════════════════════════ *@
    <div class="annexa-section">
        <div class="annexa-header"><span class="annexa-letter">C.</span> PERSONAL INFORMATION</div>
        <div class="annexa-body">

            @* C.1 / C.2 *@
            <div class="annexa-grid cols-2 mb-2">
                <div class="annexa-field">
                    <span class="annexa-item-label">C.1 NCSC Registration Reference Number</span>
                    <InputNumber class="annexa-input" @bind-Value="model.NcscRrn" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">C.2 LGU OSCA ID Number</span>
                    <input class="annexa-input" @bind="model.OscaIdNumber" />
                </div>
            </div>

            @* C.3 / C.4 *@
            <div class="annexa-grid cols-2 mb-2">
                <div class="annexa-field">
                    <span class="annexa-item-label">C.3 First Name <span class="annexa-required">*</span></span>
                    <input class="annexa-input" @bind="model.FirstName" />
                    <ValidationMessage For="@(() => model.FirstName)" class="ff-err" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">C.4 Middle Name</span>
                    <input class="annexa-input" @bind="model.MiddleName" />
                </div>
            </div>

            @* C.5 / C.6 *@
            <div class="annexa-grid cols-2 mb-2">
                <div class="annexa-field">
                    <span class="annexa-item-label">C.5 Last Name <span class="annexa-required">*</span></span>
                    <input class="annexa-input" @bind="model.LastName" />
                    <ValidationMessage For="@(() => model.LastName)" class="ff-err" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">C.6 Suffix</span>
                    <select class="annexa-select" @bind="model.Extension">
                        <option value="">N/A</option>
                        <option value="Sr.">Sr.</option>
                        <option value="Jr.">Jr.</option>
                        <option value="II">II</option>
                        <option value="III">III</option>
                        <option value="IV">IV</option>
                        <option value="V">V</option>
                    </select>
                </div>
            </div>

            @* C.7 / C.8 *@
            <div class="annexa-grid cols-3 mb-2">
                <div class="annexa-field">
                    <span class="annexa-item-label">C.7 Date of Birth <span class="annexa-required">*</span></span>
                    <UniformDateInput Value="@model.BirthDate" ValueChanged="@OnBirthDateChanged" />
                    <ValidationMessage For="@(() => model.BirthDate)" class="ff-err" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">Age (auto)</span>
                    <input class="annexa-input annexa-readonly" value="@(GetAge(model.BirthDate)?.ToString() ?? "—")" disabled />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">C.8 Contact Number/s</span>
                    <input class="annexa-input" @bind="model.PhoneNumber" placeholder="09171234567" />
                </div>
            </div>

            @* C.9.1 — Address in the Philippines. PSGC cascading selects sit
               INLINE in the same grid as House#/Street/Zip, exactly matching
               the paper form's single-row layout. Region is a system-required
               addition (needed to drive the Province cascade) — not on the
               paper form itself, flagged with a small note so it doesn't
               look out of place. *@
            <div class="annexa-subsection" style="border-top:none; margin-top:0; padding-top:0;">
                <div class="annexa-subsection-title">C.9.1 Address in the Philippines</div>
                <div class="annexa-grid cols-4">
                    <div class="annexa-field">
                        <span class="annexa-item-label">House #</span>
                        <input class="annexa-input" @bind="model.HouseNumber" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Street Name</span>
                        <input class="annexa-input" @bind="model.StreetName" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">
                            Region <span class="annexa-required">*</span>
                            <span class="annexa-item-note">(required to look up Province)</span>
                        </span>
                        <select class="annexa-select" value="@model.PsgcCodeRegion" @onchange="OnFormRegionChanged"
                                disabled="@(_isFormRegionLoading || IsLoading)">
                            <option value="0">@(_isFormRegionLoading ? "Loading..." : "Select Region")</option>
                            @foreach (var r in _formRegions)
                            {
                                <option value="@r.PsgcCodeRegion">@r.Name</option>
                            }
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Province <span class="annexa-required">*</span></span>
                        <select class="annexa-select" value="@model.PsgcCodeProvince" @onchange="OnFormProvinceChanged"
                                disabled="@(model.PsgcCodeRegion == 0 || _isFormProvinceLoading || IsLoading)">
                            <option value="0">@(_isFormProvinceLoading ? "Loading..." : "Select Province")</option>
                            @foreach (var p in _formProvinces)
                            {
                                <option value="@p.PsgcCodeProvince">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">City/Municipality <span class="annexa-required">*</span></span>
                        <select class="annexa-select" value="@model.PsgcCodeMunicipality" @onchange="OnFormMunicipalityChanged"
                                disabled="@(model.PsgcCodeProvince == 0 || _isFormMunicipalityLoading || IsLoading)">
                            <option value="0">@(_isFormMunicipalityLoading ? "Loading..." : "Select Municipality")</option>
                            @foreach (var m in _formMunicipalities)
                            {
                                <option value="@m.PsgcCodeMunicipality">@m.Name</option>
                            }
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Barangay <span class="annexa-required">*</span></span>
                        <select class="annexa-select" value="@model.PsgcCodeBarangay" @onchange="OnFormBarangayChanged"
                                disabled="@(model.PsgcCodeMunicipality == 0 || _isFormBarangayLoading || IsLoading)">
                            <option value="0">@(_isFormBarangayLoading ? "Loading..." : "Select Barangay")</option>
                            @foreach (var b in _formBarangays)
                            {
                                <option value="@b.PsgcCodeBarangay">@b.Name</option>
                            }
                        </select>
                        <ValidationMessage For="@(() => model.PsgcCodeBarangay)" class="ff-err" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Zip Code</span>
                        <input class="annexa-input" @bind="model.ZipCode" />
                    </div>
                </div>
            </div>

            @* C.9.2 — Address Abroad, positioned immediately after C.9.1, exactly like the paper form *@
            <BeneficiaryAddressSection PlaceOfSubmission="@model.PlaceOfSubmission"
                                       Abroad="@(model.AbroadAddress ??= new())"
                                       AbroadChanged="@(a => model.AbroadAddress = a)" />

            @* C.10 / C.11 / C.12 / C.13 *@
            <div class="annexa-subsection">
                <div class="annexa-grid cols-4">
                    <div class="annexa-field">
                        <span class="annexa-item-label">C.10 Sex <span class="annexa-required">*</span></span>
                        <select class="annexa-select" @bind="model.Sex">
                            <option value="0">Select Sex</option>
                            <option value="1">Male</option>
                            <option value="2">Female</option>
                        </select>
                        <ValidationMessage For="@(() => model.Sex)" class="ff-err" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">C.11 Civil Status</span>
                        <select class="annexa-select" @bind="model.CivilStatus">
                            <option value="0">Select Civil Status</option>
                            <option value="1">Single</option>
                            <option value="3">Married</option>
                            <option value="2">Widow/Widower</option>
                            <option value="4">Common-Law</option>
                            <option value="5">Others</option>
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">C.12 Citizenship</span>
                        <select class="annexa-select" @bind="model.Citizenship" @bind:after="ApplyEligibilityRules">
                            <option value="0">Select Citizenship</option>
                            <option value="1">Filipino</option>
                            <option value="2">Dual Citizen</option>
                        </select>
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">C.13 Disability</span>
                        <label class="annexa-checkbox-item">
                            <input type="checkbox" checked="@model.IsPersonWithDisability"
                                   @onchange="@(e => model.IsPersonWithDisability = (bool)(e.Value ?? false))" />
                            Yes
                        </label>
                    </div>

                    @if (model.CivilStatus == 5)
                    {
                        <div class="annexa-field">
                            <span class="annexa-item-label">Specify Civil Status</span>
                            <input class="annexa-input" @bind="model.CivilStatusOtherDetail" />
                        </div>
                    }
                    @if (model.Citizenship == 2)
                    {
                        <div class="annexa-field">
                            <span class="annexa-item-label">Dual Citizenship Details</span>
                            <input class="annexa-input" @bind="model.DualCitizenshipDetails" />
                        </div>
                    }
                    @if (model.IsPersonWithDisability)
                    {
                        <div class="annexa-field">
                            <span class="annexa-item-label">Type of Disability</span>
                            <input class="annexa-input" @bind="model.DisabilityType" />
                        </div>
                    }
                </div>
            </div>

            @* C.14 *@
            <div class="annexa-subsection">
                <span class="annexa-item-label">C.14 Ethnicity</span>
                <label class="annexa-checkbox-item mb-1">
                    <input type="checkbox" checked="@model.IsIndigenousPeople"
                           @onchange="@(e => model.IsIndigenousPeople = (bool)(e.Value ?? false))" />
                    Member of Indigenous Peoples (IP)
                </label>
                @if (model.IsIndigenousPeople)
                {
                    <input class="annexa-input" placeholder="Name of IP group" @bind="model.EthnicityName" />
                }
            </div>

            @* Deceased toggle stays here — end of Section C, matches where the
               original form had it grouped with Identity/Personal info *@
            <div class="annexa-subsection">
                <div class="annexa-checkbox-row">
                    <label class="annexa-checkbox-item">
                        <input type="checkbox" checked="@model.IsDeceased" @onchange="OnIsDeceasedChanged" />
                        Grantee is Deceased
                    </label>
                    @if (model.IsDeceased)
                    {
                        <div class="annexa-field" style="min-width:220px;">
                            <span class="annexa-item-label">Date of Death</span>
                            <UniformDateInput Value="@model.DateOfDeath" ValueChanged="@OnDateOfDeathChanged" MaxDate="@DateTime.Today" />
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

    @* ── D. Family Information ── *@
    <BeneficiaryFamilySection FamilyMembers="@model.FamilyMembers"
                              FamilyMembersChanged="@(list => model.FamilyMembers = list)" />

    @* ── E. Transaction Account ── *@
    <BeneficiaryBankAccountSection Account="@(model.BankAccount ??= new())"
                                   AccountChanged="@(acct => model.BankAccount = acct)"
                                   PlaceOfSubmission="@model.PlaceOfSubmission"
                                   IsClaimantContext="false" />

    @* ── F. For Deceased Grantees (conditional) ── *@
    <BeneficiaryClaimantSection IsDeceased="@model.IsDeceased"
                               DateOfDeath="@model.DateOfDeath"
                               PlaceOfSubmission="@model.PlaceOfSubmission"
                               Claimant="@(model.Claimant ??= new())"
                               ClaimantChanged="@(c => model.Claimant = c)"
                               GranteeBankAccount="@(model.BankAccount ?? new())" />

    @* ── G. Attestation / Certification ── *@
    <BeneficiaryAttestationSection IsSignedDeclaration="@model.IsSignedDeclaration"
                                IsSignedDeclarationChanged="@(v => model.IsSignedDeclaration = v)"
                                DateSigned="@model.DateSigned"
                                DateSignedChanged="@(v => model.DateSigned = v)"
                                ShowValidationHints="@_showValidationHints" />
                                   @* ── H./I. Verification Checklist & Result — now inline, end of Annex A ── *@
   @* ── H./I. Verification Checklist & Result — part of the main Save/Update flow now ── *@
    <BeneficiaryVerificationChecklistSection Checklist="@(model.VerificationChecklist ??= new())"
                                              ChecklistChanged="@(c => model.VerificationChecklist = c)"
                                              IsDeceased="@model.IsDeceased"
                                              IsAdmin="@_isAdmin"
                                              IsEligible="@model.IsEligible"
                                              IsEligibleChanged="@(v => { model.IsEligible = v; StateHasChanged(); })"
                                              IsCompliant="@model.IsCompliant"
                                              IsCompliantChanged="@(v => { model.IsCompliant = v; StateHasChanged(); })"
                                              Validator="@model.Validator"
                                              ValidatorChanged="@(v => model.Validator = v)"
                                              ValidationDate="@model.ValidationDate"
                                              ValidationDateChanged="@OnValidationDateChanged"
                                              EligibilityRemarks="@model.EligibilityRemarks"
                                              EligibilityRemarksChanged="@(v => model.EligibilityRemarks = v)"
                                              AssessmentRemarks="@model.AssessmentRemarks"
                                              AssessmentRemarksChanged="@(v => model.AssessmentRemarks = v)" />

    <div class="annexa-paper-footer mb-3">— end of Annex A form fields —</div>

    @* ══════════════════════════════════════════════════════════════════
       SYSTEM FIELDS — everything below is NOT part of the printed Annex A
       form. Wrapped in one bounding box so it reads as a single distinct
       group, separate from the paper-form replica above.
       ══════════════════════════════════════════════════════════════════ *@
    <div class="system-fields-wrapper mb-3">
        <div class="system-fields-header">
            <i class="bi bi-gear-fill"></i> Internal / System Fields
            <span class="annexa-tag ms-2" style="background:#fff; color:#495057;">Not part of printed form</span>
        </div>
        <div class="system-fields-body">

            @* ── Remarks (system tracking, not on paper form) ── *@
            <div class="form-section mb-3">
                <div class="form-section-header"><i class="bi bi-chat-left-text me-2"></i>Internal Remarks</div>
                <div class="form-section-body">
                    <div class="form-grid">
                        <div class="ff">
                            <label class="ff-label">Remark Category</label>
                            <InputSelect class="ff-input" @bind-Value="model.RemarkCategory">
                                <option value="0">Select Remark</option>
                                <option value="1">Deceased prior reaching milestone age</option>
                                <option value="2">Out of town/Country</option>
                                <option value="3">Incomplete required documents</option>
                                <option value="4">Inconsistent documents</option>
                                <option value="5">Cannot be reached/Located</option>
                                <option value="6">Did not reach the milestone age</option>
                                <option value="7">Lacking of documents/Requirements</option>
                                <option value="8">For Correction</option>
                                <option value="9">Waived</option>
                                <option value="10">Lacking Proof of Relationship</option>
                                <option value="11">No show</option>
                                <option value="12">Double Application with Different Surname used</option>
                                <option value="13">For CGD Island Municipality</option>
                            </InputSelect>
                        </div>
                        <div class="ff" style="grid-column: 1 / -1;">
                            <label class="ff-label">Remarks</label>
                            <InputTextArea class="ff-input" @bind-Value="model.Remarks" rows="2" />
                        </div>
                    </div>
                </div>
            </div>
            @* ── CO Status (internal workflow, admin-gated, not on paper form) ── *@
            <div class="form-section mb-3">
                <div class="form-section-header">
                    <i class="bi bi-building-check me-2"></i>CO Status
                    @if (!_isAdmin && _roleLoaded)
                    {
                        <span class="badge bg-secondary ms-2 fw-normal" style="font-size:10px;"><i class="bi bi-lock me-1"></i>Admin only</span>
                    }
                </div>
                <div class="form-section-body">
                    <div class="form-grid">
                        <div class="ff">
                            <label class="ff-label">CO Status</label>
                            <InputSelect class="ff-input" @bind-Value="model.CoStatus" @bind-Value:after="OnCoStatusChanged" disabled="@(!_isAdmin)">
                                <option value="">Not Set</option>
                                <option value="1">Endorsed</option>
                                <option value="2">Approved</option>
                            </InputSelect>
                        </div>
                        <div class="ff">
                            <label class="ff-label">CO Date Endorsed @(model.CoStatus == 1 ? "*" : "")</label>
                            <UniformDateInput Value="@model.CoDateEndorsed" ValueChanged="@OnCoDateEndorsedChanged" Disabled="@(model.CoStatus != 1 || !_isAdmin)" />
                        </div>
                        <div class="ff">
                            <label class="ff-label">CO Date Approved @(model.CoStatus == 2 ? "*" : "")</label>
                            <UniformDateInput Value="@model.CoDateApproved" ValueChanged="@OnCoDateApprovedChanged" Disabled="@(model.CoStatus != 2 || !_isAdmin)" />
                        </div>
                    </div>
                    @if (!_isAdmin && _roleLoaded)
                    {
                        <div class="alert alert-secondary py-2 px-3 mt-2 mb-0 small d-flex align-items-center gap-2">
                            <i class="bi bi-lock-fill text-muted"></i>
                            <span>CO Status can only be modified by Administrators.</span>
                        </div>
                    }
                </div>
            </div>

            @* ── Findings (edit mode only, admin-gated) ── *@
            @if (IsEditMode)
            {
                <div class="form-section mb-3">
                    <div class="form-section-header">
                        <i class="bi bi-exclamation-triangle me-2"></i>Findings
                        @if (!_isAdmin && _roleLoaded)
                        {
                            <span class="badge bg-secondary ms-2 fw-normal" style="font-size:10px;"><i class="bi bi-lock me-1"></i>Admin only</span>
                        }
                    </div>
                    <div class="form-section-body">
                        @if (isLoadingFinding)
                        {
                            <div class="text-center py-2"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                        }
                        else
                        {
                            <div class="form-grid">
                                <div class="ff">
                                    <label class="ff-label">With Findings</label>
                                    <select class="ff-input" @bind="findingStatusInput" disabled="@(IsLoading || !_isAdmin)">
