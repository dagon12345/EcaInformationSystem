@* BeneficiaryClaimantSection.razor — Annex A Section F: For Deceased Grantees *@
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Client.Pages.BeneficiaryInformation.Helpers

@if (IsDeceased)
{
    <div class="annexa-section">
        <div class="annexa-header" style="background:#7a1f1f;">
            <span class="annexa-letter">F.</span> FOR DECEASED GRANTEES
            <span class="annexa-tag annexa-tag--warn ms-2">Attach sworn/notarized Warranty and Release From Liability Form</span>
        </div>
        <div class="annexa-body">

            <div class="alert alert-secondary py-2 px-3 mb-3 small">
                <i class="bi bi-info-circle me-1"></i>
                In case the Grantee is without known immediate relatives or next of kin, the caregiver or
                the facility's management that provided care, shelter, and/or other essential support may
                claim on behalf of the deceased, provided there is a certification issued by the concerned
                LGU or Residential Care Facility (RCF).
            </div>

            <div class="annexa-grid cols-2 mb-3">
                <div class="annexa-field">
                    <span class="annexa-item-label">F.1 Date of Death</span>
                    <input class="annexa-input annexa-readonly" value="@DateOfDeath?.ToString("MMMM dd, yyyy")" disabled />
                    <span class="annexa-item-note">Set in Identity Information above</span>
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">F.2 Contact Number of Claimant</span>
                    <input class="annexa-input" value="@Claimant.ContactNumber"
                           @oninput="@(e => { Claimant.ContactNumber = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                </div>
            </div>

            <div class="annexa-subsection" style="border-top:none; margin-top:0; padding-top:0;">
                <div class="annexa-subsection-title">F.3 Name of Claimant <span class="annexa-item-note">(Last Name, First Name, Middle Name, Ext.)</span></div>
                <div class="annexa-grid cols-4">
                    <div class="annexa-field">
                        <span class="annexa-item-label">Last Name <span class="annexa-required">*</span></span>
                        <input class="annexa-input" value="@Claimant.LastName"
                               @oninput="@(e => { Claimant.LastName = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">First Name <span class="annexa-required">*</span></span>
                        <input class="annexa-input" value="@Claimant.FirstName"
                               @oninput="@(e => { Claimant.FirstName = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Middle Name</span>
                        <input class="annexa-input" value="@Claimant.MiddleName"
                               @oninput="@(e => { Claimant.MiddleName = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Ext.</span>
                        <input class="annexa-input" placeholder="Jr./Sr./III" value="@Claimant.Extension"
                               @oninput="@(e => { Claimant.Extension = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                </div>
            </div>

            <div class="annexa-subsection">
                <div class="annexa-subsection-title">F.5 Relationship to the Deceased <span class="annexa-item-note">(attach proof of relationship)</span></div>
                <div class="annexa-field">
                    <input class="annexa-input" value="@Claimant.RelationshipToDeceased"
                           @oninput="@(e => { Claimant.RelationshipToDeceased = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                </div>
            </div>

            <div class="annexa-subsection">
                <div class="annexa-subsection-title">F.4 Permanent Address of the Claimant <span class="annexa-item-note">(in the Philippines or abroad — free text)</span></div>
                <div class="annexa-grid cols-3">
                    <div class="annexa-field">
                        <span class="annexa-item-label">House Number</span>
                        <input class="annexa-input" value="@Claimant.HouseNumber"
                               @oninput="@(e => { Claimant.HouseNumber = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Street</span>
                        <input class="annexa-input" value="@Claimant.StreetName"
                               @oninput="@(e => { Claimant.StreetName = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Barangay</span>
                        <input class="annexa-input" value="@Claimant.Barangay"
                               @oninput="@(e => { Claimant.Barangay = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">City / Municipality</span>
                        <input class="annexa-input" value="@Claimant.CityMunicipality"
                               @oninput="@(e => { Claimant.CityMunicipality = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Province</span>
                        <input class="annexa-input" value="@Claimant.Province"
                               @oninput="@(e => { Claimant.Province = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                    <div class="annexa-field">
                        <span class="annexa-item-label">Zip Code</span>
                        <input class="annexa-input" value="@Claimant.ZipCode"
                               @oninput="@(e => { Claimant.ZipCode = SanitizeUpper(e.Value?.ToString()); NotifyChanged(); })" />
                    </div>
                </div>
            </div>

        </div>
    </div>

@if (IsDeceased)
{
    <div class="annexa-section">
        <div class="annexa-header" style="background:#7a1f1f;">
            <span class="annexa-letter">F.6/F.7.</span> CLAIMANT'S PREFERRED MODE TO RECEIVE THE CASH GIFT &amp; ACCOUNT DETAILS
        </div>
        <div class="annexa-body">
            <p class="annexa-note mb-2">
                Please check only one and make sure this is under the <strong>Claimant's</strong> name —
                this account is separate from the grantee's own transaction account in Section E.
            </p>

            <div class="annexa-checkbox-row mb-3">
                <label class="annexa-checkbox-item">
                    <input type="radio" name="claimantChannel" checked="@(ClaimantBankAccount.PreferredChannel == 1)"
                           @onchange="@(() => { ClaimantBankAccount.PreferredChannel = 1; NotifyBankAccountChanged(); })" />
                    Landbank of the Philippines
                </label>
                <label class="annexa-checkbox-item">
                    <input type="radio" name="claimantChannel" checked="@(ClaimantBankAccount.PreferredChannel == 2)"
                           @onchange="@(() => { ClaimantBankAccount.PreferredChannel = 2; NotifyBankAccountChanged(); })" />
                    Other Banks
                </label>
                <label class="annexa-checkbox-item">
                    <input type="radio" name="claimantChannel" checked="@(ClaimantBankAccount.PreferredChannel == 3)"
                           @onchange="@(() => { ClaimantBankAccount.PreferredChannel = 3; NotifyBankAccountChanged(); })" />
                    Electronic Money Issuers (EMIs)
                </label>
                <label class="annexa-checkbox-item">
                    <input type="radio" name="claimantChannel" checked="@(ClaimantBankAccount.PreferredChannel == 4)"
                           @onchange="@(() => { ClaimantBankAccount.PreferredChannel = 4; NotifyBankAccountChanged(); })" />
                    PSP (Palawan Pawnshop)
                </label>
            </div>

            <div class="annexa-grid cols-3">
                <div class="annexa-field">
                    <span class="annexa-item-label">Bank Name</span>
                    <input class="annexa-input" value="@ClaimantBankAccount.BankOrWalletName"
                           @oninput="@(e => { ClaimantBankAccount.BankOrWalletName = SanitizeUpper(e.Value?.ToString()); NotifyBankAccountChanged(); })" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">Account No.</span>
                    <input class="annexa-input" value="@ClaimantBankAccount.AccountNumber"
                           @oninput="@(e => { ClaimantBankAccount.AccountNumber = SanitizeUpper(e.Value?.ToString()); NotifyBankAccountChanged(); })" />
                </div>
                <div></div>
                <div class="annexa-field">
                    <span class="annexa-item-label">Branch Name</span>
                    <input class="annexa-input" value="@ClaimantBankAccount.BranchName"
                           @oninput="@(e => { ClaimantBankAccount.BranchName = SanitizeUpper(e.Value?.ToString()); NotifyBankAccountChanged(); })" />
                </div>
                <div class="annexa-field" style="grid-column: span 2;">
                    <span class="annexa-item-label">Bank Address</span>
                    <input class="annexa-input" value="@ClaimantBankAccount.BankAddress"
                           @oninput="@(e => { ClaimantBankAccount.BankAddress = SanitizeUpper(e.Value?.ToString()); NotifyBankAccountChanged(); })" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">GCash Name</span>
                    <input class="annexa-input" value="@ClaimantBankAccount.GCashName"
                           @oninput="@(e => { ClaimantBankAccount.GCashName = SanitizeUpper(e.Value?.ToString()); NotifyBankAccountChanged(); })" />
                </div>
                <div class="annexa-field" style="grid-column: span 2;">
                    <span class="annexa-item-label">GCash Account No.</span>
                    <PhMobileNumberInput Value="@ClaimantBankAccount.MobileNumber"
                                         ValueChanged="@(v => { ClaimantBankAccount.MobileNumber = v; NotifyBankAccountChanged(); })"
                                         ShowValidation="true" />
                </div>
                <div class="annexa-field">
                    <span class="annexa-item-label">Joint Account?</span>
                    <div class="annexa-checkbox-row">
                        <label class="annexa-checkbox-item">
                            <input type="radio" name="claimantJoint" checked="@(ClaimantBankAccount.IsJointAccount == true)"
                                   @onchange="@(() => { ClaimantBankAccount.IsJointAccount = true; NotifyBankAccountChanged(); })" />
                            Yes
                        </label>
                        <label class="annexa-checkbox-item">
                            <input type="radio" name="claimantJoint" checked="@(ClaimantBankAccount.IsJointAccount == false)"
                                   @onchange="@(() => { ClaimantBankAccount.IsJointAccount = false; NotifyBankAccountChanged(); })" />
                            No
                        </label>
                    </div>
                </div>
            </div>

            @if (PlaceOfSubmission == 2)
            {
                <div class="annexa-subsection">
                    <div class="annexa-subsection-title">For Living Abroad Only</div>
                    <div class="annexa-grid cols-2">
                        <div class="annexa-field">
                            <span class="annexa-item-label">BIC/SWIFT Code</span>
                            <input class="annexa-input" value="@ClaimantBankAccount.SwiftCode"
                                   @oninput="@(e => { ClaimantBankAccount.SwiftCode = SanitizeUpper(e.Value?.ToString()); NotifyBankAccountChanged(); })" />
                        </div>
                        <div class="annexa-field">
                            <span class="annexa-item-label">IBAN (European Countries)</span>
                            <input class="annexa-input" value="@ClaimantBankAccount.Iban"
                                   @oninput="@(e => { ClaimantBankAccount.Iban = SanitizeUpper(e.Value?.ToString()); NotifyBankAccountChanged(); })" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
}

@code {
    [Parameter] public bool IsDeceased { get; set; }
    [Parameter] public DateTime? DateOfDeath { get; set; }
    [Parameter] public int? PlaceOfSubmission { get; set; }

    [Parameter] public BeneficiaryClaimantDto Claimant { get; set; } = new();
    [Parameter] public EventCallback<BeneficiaryClaimantDto> ClaimantChanged { get; set; }

     // ✅ CHANGED — was GranteeBankAccount (reused), now the claimant's own account
    [Parameter] public BeneficiaryClaimantBankAccountDto ClaimantBankAccount { get; set; } = new();
    [Parameter] public EventCallback<BeneficiaryClaimantBankAccountDto> ClaimantBankAccountChanged { get; set; }

     private void NotifyChanged()
    {
        ClaimantChanged.InvokeAsync(Claimant);
        StateHasChanged();
    }

    private void NotifyBankAccountChanged()
    {
        ClaimantBankAccountChanged.InvokeAsync(ClaimantBankAccount);
        StateHasChanged();
    }

    private static string SanitizeUpper(string? input)
    {
        return string.IsNullOrEmpty(input) ? string.Empty : input.ToUpperInvariant();
    }
}