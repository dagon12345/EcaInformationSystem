@* BeneficiaryImporting.razor — redesigned to match navy #1F3864 design system *@
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthService AuthService
@inject ToastService toast

<div class="import-wrap">

    @* ── Top row: description + download template *@
    <div class="import-toprow">
        <span class="import-hint">
            <i class="bi bi-info-circle me-1"></i>
            Download the official template, fill it out, then upload below.
        </span>
        <button class="sys-btn sys-btn-outline"
                @onclick="DownloadTemplateAsync"
                disabled="@isDownloadingTemplate">
            @if (isDownloadingTemplate)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Downloading...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-arrow-down me-1"></i>
                <span>Download Template</span>
            }
        </button>
    </div>

    @* ── File picker *@
    <div class="import-file-row">
        <InputFile OnChange="HandleFileSelected" accept=".xlsx" class="ff-input" />
        @if (isLoadingSheets)
        {
            <span class="ff-loading mt-1">
                <span class="spinner-border spinner-border-sm"></span> Reading sheets...
            </span>
        }
    </div>

    @* ── Sheet selector *@
    @if (excelSheetNames.Any())
    {
        <div class="ff mt-2">
            <label class="ff-label">Worksheet</label>
            <InputSelect class="ff-input" @bind-Value="selectedSheetName">
                @foreach (var sheet in excelSheetNames)
                {
                    <option value="@sheet">@sheet</option>
                }
            </InputSelect>
        </div>

        @if (!string.IsNullOrWhiteSpace(uploadedExcelFileName))
        {
            <div class="import-file-info mt-1">
                <i class="bi bi-file-earmark-excel text-success me-1"></i>
                <strong>@uploadedExcelFileName</strong>
                &nbsp;·&nbsp; @excelSheetNames.Count worksheet(s) found
            </div>
        }
    }

    @* ── Hint *@
    <p class="import-hint mt-2">
        <i class="bi bi-shield-check me-1"></i>
        All rows are validated first. No records are saved if any error is found.
    </p>

    @* ── Action buttons *@
    <div class="d-flex gap-2 mt-2 flex-wrap">
        <button class="sys-btn sys-btn-save"
                @onclick="UploadExcelAsync"
                disabled="@(isUploading || uploadedExcelBytes == null || !excelSheetNames.Any() || string.IsNullOrWhiteSpace(selectedSheetName))">
            @if (isUploading)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Validating...</span>
            }
            else
            {
                <i class="bi bi-cloud-upload me-1"></i>
                <span>Validate &amp; Import</span>
            }
        </button>

        <HxTooltip Text="Matches existing records by Name, Birth Date, OSCA ID, and NCSC RRN. Only updates: Batch Code, Eligibility, Date of Death, and Validation Date."
                   Placement="TooltipPlacement.Top">
            <button class="sys-btn sys-btn-warn"
                    @onclick="UpdateExcelAsync"
                    disabled="@(isUpdating || uploadedExcelBytes == null || !excelSheetNames.Any() || string.IsNullOrWhiteSpace(selectedSheetName))">
                @if (isUpdating)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Updating...</span>
                }
                else
                {
                    <i class="bi bi-arrow-repeat me-1"></i>
                    <span>Update Existing Records</span>
                }
            </button>
        </HxTooltip>
    </div>

    @* ── Import result *@
    @if (importResult != null)
    {
        <div class="import-result mt-3">
            @if (importResult.HasErrors)
            {
                <div class="import-result-banner import-result-banner--err">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Import validation failed — <strong>@importResult.ErrorCount</strong> error(s).
                    No records were saved. Fix the file and re-upload.
                </div>
                <div class="import-stats">
                    <span>Rows checked: <strong>@importResult.TotalRows</strong></span>
                    <span>Valid: <strong>@importResult.ValidRows</strong></span>
                    <span>Errors: <strong class="text-danger">@importResult.ErrorCount</strong></span>
                </div>
                <div class="import-errors-table mt-2">
                    <div class="import-errors-table-header">Import Errors</div>
                    <div style="max-height:300px; overflow-y:auto;">
                        <table class="sys-err-table">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Field</th>
                                    <th>Message</th>
                                    <th>Value</th>
                                    <th>Suggestion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var err in importResult.Errors)
                                {
                                    <tr>
                                        <td>@err.RowNumber</td>
                                        <td>@err.Field</td>
                                        <td>@err.Message</td>
                                        <td>@err.RawValue</td>
                                        <td>@err.Suggestion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="import-result-banner import-result-banner--ok">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Import successful — <strong>@importResult.ImportedCount</strong> record(s) saved.
                </div>
            }
        </div>
    }

    @* ── Update result *@
    @if (updateResult != null)
    {
        <div class="import-result mt-3">
            @if (updateResult.HasErrors)
            {
                <div class="import-result-banner import-result-banner--err">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Update validation failed — <strong>@updateResult.ErrorCount</strong> error(s). No records were updated.
                </div>
                <div class="import-stats">
                    <span>Rows checked: <strong>@updateResult.TotalRows</strong></span>
                    <span>Valid: <strong>@updateResult.ValidRows</strong></span>
                    <span>Errors: <strong class="text-danger">@updateResult.ErrorCount</strong></span>
                </div>
                <div class="import-errors-table mt-2">
                    <div class="import-errors-table-header">Update Errors</div>
                    <div style="max-height:300px; overflow-y:auto;">
                        <table class="sys-err-table">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Field</th>
                                    <th>Message</th>
                                    <th>Value</th>
                                    <th>Suggestion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var err in updateResult.Errors)
                                {
                                    <tr>
                                        <td>@err.RowNumber</td>
                                        <td>@err.Field</td>
                                        <td>@err.Message</td>
                                        <td>@err.RawValue</td>
                                        <td>@err.Suggestion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="import-result-banner import-result-banner--ok">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Update successful — <strong>@updateResult.ImportedCount</strong> record(s) updated.
                </div>
            }
        </div>
    }
</div>

@* ── ALL @code IS IDENTICAL TO YOUR ORIGINAL ── *@
@code {
    private bool isDownloadingTemplate;
    private IBrowserFile? selectedFile;
    private string? errorMessage;
    private string? successMessage;
    private BeneficiaryImportResultDto? importResult;
    private List<string> excelSheetNames = new();
    private string? selectedSheetName;
    private byte[]? uploadedExcelBytes;
    private string? uploadedExcelFileName;
    private bool isLoadingSheets;
    private bool isUploading;
    private bool isUpdating;
    private BeneficiaryImportResultDto? updateResult;

    private async Task DownloadTemplateAsync()
    {
        try
        {
            isDownloadingTemplate = true;
            var client = await AuthService.GetAuthorizedClientAsync();
            var response = await Http.GetAsync("api/beneficiary/download-import-template");
            if (response.IsSuccessStatusCode)
            {
                var fileStream = await response.Content.ReadAsStreamAsync();
                var fileName = $"ImportTemplate_{DateTime.Now:yyyy-MM-dd}.xlsx";
                using var streamRef = new DotNetStreamReference(stream: fileStream);
                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            }
            toast.ShowSuccess("Import template downloaded successfully.");
        }
        catch (Exception ex) { toast.ShowError($"Template download failed: {ex.Message}"); }
        finally { isDownloadingTemplate = false; }
    }

    private async Task UpdateExcelAsync()
    {
        if (uploadedExcelBytes == null || string.IsNullOrWhiteSpace(selectedSheetName))
        { toast.ShowError("Please select a file and a worksheet first."); return; }

        isUpdating = true; updateResult = null;
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(uploadedExcelBytes), "File", uploadedExcelFileName ?? "update.xlsx");
            content.Add(new StringContent(selectedSheetName), "SheetName");
            var response = await Http.PostAsync("api/beneficiary/update-excel", content);
            if (response.IsSuccessStatusCode)
            {
                updateResult = await response.Content.ReadFromJsonAsync<BeneficiaryImportResultDto>();
                if (updateResult?.HasErrors == true) toast.ShowError($"Update finished with {updateResult.ErrorCount} error(s).");
                else toast.ShowSuccess($"Update completed. {updateResult?.ImportedCount ?? 0} record(s) updated.");
            }
            else throw new Exception(await response.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { toast.ShowError($"Update failed: {ex.Message}"); }
        finally { isUpdating = false; StateHasChanged(); }
    }

    private async Task UploadExcelAsync()
    {
        errorMessage = null; successMessage = null; importResult = null;
        if (uploadedExcelBytes == null || string.IsNullOrWhiteSpace(uploadedExcelFileName))
        { toast.ShowError("Please select an Excel file first."); return; }
        if (string.IsNullOrWhiteSpace(selectedSheetName))
        { toast.ShowError("Please select a worksheet first."); return; }

        try
        {
            isUploading = true;
            using var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(uploadedExcelBytes), "File", uploadedExcelFileName);
            content.Add(new StringContent(selectedSheetName), "SheetName");
            var response = await Http.PostAsync("api/beneficiary/import", content);
            if (response.IsSuccessStatusCode)
            {
                importResult = await response.Content.ReadFromJsonAsync<BeneficiaryImportResultDto>();
                if (importResult?.HasErrors == true) toast.ShowError($"Validation failed. {importResult.ErrorCount} error(s).");
                else toast.ShowSuccess($"Import completed. {importResult?.ImportedCount ?? 0} record(s) saved.");
            }
            else throw new Exception(await response.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { toast.ShowError($"Import failed: {ex.Message}"); }
        finally { isUploading = false; StateHasChanged(); }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File; errorMessage = null; successMessage = null;
        importResult = null; excelSheetNames.Clear(); selectedSheetName = null;
        uploadedExcelBytes = null; uploadedExcelFileName = null;
        if (selectedFile == null) return;
        try
        {
            isLoadingSheets = true;
            await using var uploadStream = selectedFile.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await uploadStream.CopyToAsync(ms);
            uploadedExcelBytes = ms.ToArray();
            uploadedExcelFileName = selectedFile.Name;
            using var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(uploadedExcelBytes), "file", uploadedExcelFileName);
            var response = await Http.PostAsync("api/beneficiary/import/sheets", content);
            if (response.IsSuccessStatusCode)
            {
                excelSheetNames = await response.Content.ReadFromJsonAsync<List<string>>() ?? new();
                if (excelSheetNames.Any()) selectedSheetName = excelSheetNames.First();
            }
            else throw new Exception(await response.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { toast.ShowError($"Failed to read Excel sheets: {ex.Message}"); }
        finally { isLoadingSheets = false; StateHasChanged(); }
    }
}
