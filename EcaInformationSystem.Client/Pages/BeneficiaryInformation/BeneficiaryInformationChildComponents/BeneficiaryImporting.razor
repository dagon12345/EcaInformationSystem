@* BeneficiaryImporting.razor — with advanced duplicate detection modal *@
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthService AuthService
@inject ToastService toast

<div class="import-wrap">

    @* ── Top row: description + download template *@
    <div class="import-toprow">
        <span class="import-hint">
            <i class="bi bi-info-circle me-1"></i>
            Download the official template, fill it out, then upload below.
        </span>
        <button class="sys-btn sys-btn-outline" @onclick="DownloadTemplateAsync" disabled="@isDownloadingTemplate">
            @if (isDownloadingTemplate)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Downloading...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-arrow-down me-1"></i>
                <span>Download Template</span>
            }
        </button>
    </div>

    @* ── File picker *@
    <div class="import-file-row">
        <InputFile OnChange="HandleFileSelected" accept=".xlsx" class="ff-input" />
        @if (isLoadingSheets)
        {
            <span class="ff-loading mt-1">
                <span class="spinner-border spinner-border-sm"></span> Reading sheets...
            </span>
        }
    </div>

    @* ── Sheet selector *@
    @if (excelSheetNames.Any())
    {
        <div class="ff mt-2">
            <label class="ff-label">Worksheet</label>
            <InputSelect class="ff-input" @bind-Value="selectedSheetName">
                @foreach (var sheet in excelSheetNames)
                {
                    <option value="@sheet">@sheet</option>
                }
            </InputSelect>
        </div>

        @if (!string.IsNullOrWhiteSpace(uploadedExcelFileName))
        {
            <div class="import-file-info mt-1">
                <i class="bi bi-file-earmark-excel text-success me-1"></i>
                <strong>@uploadedExcelFileName</strong>
                &nbsp;·&nbsp; @excelSheetNames.Count worksheet(s) found
            </div>
        }

        @* ── Reference Number (optional) ──────────────────────────────── *@
        <div class="mt-3 p-3 border rounded" style="background: var(--bs-light);">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-hash text-muted"></i>
                <span class="fw-semibold small">Reference Number</span>
                <span class="badge bg-secondary fw-normal" style="font-size:10px;">
                    Optional
                </span>
            </div>
            <p class="text-muted small mb-2">
                Leave blank to import without a reference number.
                You can assign reference numbers later using
                <strong>Bulk Assign Ref Number</strong> in the records grid.
            </p>
            <div class="d-flex align-items-end gap-3 flex-wrap">
                <div class="d-flex flex-column">
                    <label class="ff-label mb-1">Quarter</label>
                    <select class="ff-input" style="width: 140px;" @bind="_importQuarter">
                        <option value="">-- Skip --</option>
                        <option value="1">Q1 (Jan–Mar)</option>
                        <option value="2">Q2 (Apr–Jun)</option>
                        <option value="3">Q3 (Jul–Sep)</option>
                        <option value="4">Q4 (Oct–Dec)</option>
                    </select>
                </div>
                <div class="d-flex flex-column">
                    <label class="ff-label mb-1">Batch</label>
                    <input type="text" class="ff-input" style="width: 100px;" placeholder="e.g. 1" @bind="_importBatch" />
                </div>
                <div class="d-flex flex-column">
                    <label class="ff-label mb-1">Year (short)</label>
                    <input type="number" class="ff-input" style="width: 120px;" placeholder="e.g. 26"
                           @bind="_importRefYear" />
                </div>
            </div>

            @* ── Preview of what ref number will look like ── *@
            @if (!string.IsNullOrWhiteSpace(_importQuarter) &&
                 !string.IsNullOrWhiteSpace(_importBatch) &&
                 _importRefYear.HasValue)
            {
                <div class="alert alert-success py-1 px-2 mt-2 mb-0 small">
                    <i class="bi bi-check-circle me-1"></i>
                    Records will be assigned:
                    <strong>
                        Q@(_importQuarter)B@(_importBatch)-@(_importRefYear.Value.ToString("D2"))-#####-XIII
                    </strong>
                    <span class="text-muted">(unique code per record)</span>
                </div>
            }
        </div>
    }

    @* ── Hint *@
    <p class="import-hint mt-2">
        <i class="bi bi-shield-check me-1"></i>
        All rows are validated first. No records are saved if any error is found.
    </p>

    @* ── Action buttons *@
    <div class="d-flex gap-2 mt-2 flex-wrap">
        <button class="sys-btn sys-btn-save" @onclick="RunPreviewAsync"
                disabled="@(isUploading || isPreviewing || uploadedExcelBytes == null
                                                                                                                                                                                                                                                                          || !excelSheetNames.Any()
                                                                                                                                                                                                                                                                          || string.IsNullOrWhiteSpace(selectedSheetName))">
            @if (isPreviewing)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Validating...</span>
            }
            else
            {
                <i class="bi bi-cloud-upload me-1"></i>
                <span>Validate &amp; Import</span>
            }
        </button>
    </div>

    @* ── Import result *@
    @if (importResult != null)
    {
        <div class="import-result mt-3">
            @if (importResult.HasErrors)
            {
                <div class="import-result-banner import-result-banner--err">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Import validation failed — <strong>@importResult.ErrorCount</strong> error(s).
                    No records were saved. Fix the file and re-upload.
                </div>
                <div class="import-stats">
                    <span>Rows checked: <strong>@importResult.TotalRows</strong></span>
                    <span>Valid: <strong>@importResult.ValidRows</strong></span>
                    <span>Errors: <strong class="text-danger">@importResult.ErrorCount</strong></span>
                </div>
                <div class="import-errors-table mt-2">
                    <div class="import-errors-table-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span>Import Errors</span>
                        <div class="d-flex align-items-center gap-2">
                            @{
                                var correctedRowCount = importResult.Errors.Count(e => IsCorrectionAccepted(e.RowNumber, e.CorrectionField));
                            }
                            @if (correctedRowCount > 0)
                            {
                                <label class="d-flex align-items-center gap-1 small mb-0" style="cursor:pointer;">
                                    <input type="checkbox" @bind="_hideCorrectedErrors" />
                                    Hide corrected (@correctedRowCount)
                                </label>
                            }
                            @if (_acceptedCorrections.Any())
                            {
                                <button class="btn btn-sm btn-primary" @onclick="RunPreviewAsync" disabled="@isPreviewing">
                                    @if (isPreviewing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>Re-validating...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-repeat me-1"></i>
                                        <span>Apply @_acceptedCorrections.Values.Sum(m => m.Count) Correction(s) &amp; Re-validate</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                    <p class="text-muted small mb-1 mt-1">
                        <i class="bi bi-info-circle me-1"></i>
                        Where possible, fix errors right here instead of editing and re-uploading the file.
                        Errors without a usable suggestion (e.g. a blank required field) still need to be fixed in the file.
                    </p>

                    @{
                        var ncscAssessmentRowCount = importResult.Errors.Count(e => e.CorrectionField == "NcscAssessment");
                    }
                    @if (ncscAssessmentRowCount > 0)
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap p-2 mb-2 border rounded" style="background: var(--bs-light);">
                            <i class="bi bi-lightning-charge-fill text-warning"></i>
                            <span class="small fw-semibold">Bulk set NCSC Assessment</span>
                            <span class="text-muted small">(@ncscAssessmentRowCount row(s) blank/invalid)</span>
                            <select class="form-select form-select-sm w-auto" @bind="_bulkNcscAssessmentValue">
                                <option value="">-- Select --</option>
                                <option value="ELIGIBLE">Set all to ELIGIBLE</option>
                                <option value="INELIGIBLE">Set all to INELIGIBLE</option>
                            </select>
                            <button class="btn btn-sm btn-warning" disabled="@string.IsNullOrWhiteSpace(_bulkNcscAssessmentValue)"
                                    @onclick="ApplyBulkNcscAssessment">
                                <i class="bi bi-check2-all me-1"></i>Apply to All
                            </button>
                        </div>
                    }

                    <div style="max-height:400px; overflow-y:auto;">
                        <table class="sys-err-table">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Field</th>
                                    <th>Message</th>
                                    <th>Value</th>
                                    <th>Current Location</th>
                                    <th>Suggestion</th>
                                    <th>Correction</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var visibleErrors = _hideCorrectedErrors
                                        ? importResult.Errors.Where(e => !IsCorrectionAccepted(e.RowNumber, e.CorrectionField)).ToList()
                                        : importResult.Errors;
                                }
                                @if (!visibleErrors.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-success py-3">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            All errors have a correction queued. Click "Apply Corrections &amp; Re-validate" above.
                                        </td>
                                    </tr>
                                }
                                @foreach (var err in visibleErrors)
                                {
                                    var isAccepted = IsCorrectionAccepted(err.RowNumber, err.CorrectionField);
                                    <tr class="@(isAccepted ? "table-success" : "")">
                                        <td>@err.RowNumber</td>
                                        <td>@err.Field</td>
                                        <td>@err.Message</td>
                                        <td>@err.RawValue</td>
                                        <td style="font-size:12px;">
                                            @if (err.RowRegion is not null || err.RowProvince is not null || err.RowMunicipality is not null)
                                            {
                                                <div class="text-muted">
                                                    @string.Join(" › ", new[] { err.RowRegion, err.RowProvince, err.RowMunicipality }
                                                        .Where(s => !string.IsNullOrWhiteSpace(s)))
                                                </div>
                                            }
                                        </td>
                                        <td>@err.Suggestion</td>
                                        <td style="min-width:220px;">
                                            @if (isAccepted)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-lg me-1"></i>Correction queued
                                                </span>
                                                <button class="btn btn-link btn-sm p-0 ms-2" @onclick="() => UndoCorrection(err.RowNumber, err.CorrectionField)">
                                                    Undo
                                                </button>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(err.SuggestedValue))
                                            {
                                                <button class="btn btn-sm btn-outline-success" @onclick="() => AcceptSuggestion(err)">
                                                    <i class="bi bi-check2 me-1"></i>Accept '@err.SuggestedValue'
                                                </button>
                                            }
                                            else if (err.CorrectionField is "Region" or "Province" or "Municipality" or "Barangay")
                                            {
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenLocationPicker(err)">
                                                    <i class="bi bi-geo-alt me-1"></i>Pick Location
                                                </button>
                                            }
                                            else if (err.CorrectionField == "Citizenship")
                                            {
                                                <select class="form-select form-select-sm" @onchange="e => QueueSelectCorrection(err.RowNumber, err.CorrectionField, e.Value?.ToString())">
                                                    <option value="">-- Select --</option>
                                                    <option value="FILIPINO">FILIPINO</option>
                                                    <option value="DUAL CITIZENSHIP">DUAL CITIZENSHIP</option>
                                                </select>
                                            }
                                            else if (err.CorrectionField == "NcscAssessment")
                                            {
                                                <select class="form-select form-select-sm" @onchange="e => QueueSelectCorrection(err.RowNumber, err.CorrectionField, e.Value?.ToString())">
                                                    <option value="">-- Select --</option>
                                                    <option value="ELIGIBLE">ELIGIBLE</option>
                                                    <option value="INELIGIBLE">INELIGIBLE</option>
                                                </select>
                                            }
                                            else if (err.CorrectionField == "NcscRrn")
                                            {
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control" inputmode="numeric" placeholder="Digits only"
                                                           @bind="_inlineCorrectionDrafts[CorrectionDraftKey(err.RowNumber, err.CorrectionField)]" @bind:event="oninput" />
                                                    <button class="btn btn-outline-primary" @onclick="() => QueueTextCorrection(err.RowNumber, err.CorrectionField, digitsOnly: true)">Apply</button>
                                                </div>
                                            }
                                            else if (err.CorrectionField is "FirstName" or "BirthDate")
                                            {
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control"
                                                           placeholder="@(err.CorrectionField == "BirthDate" ? "e.g. January 05 1930" : "Corrected value")"
                                                           @bind="_inlineCorrectionDrafts[CorrectionDraftKey(err.RowNumber, err.CorrectionField)]" @bind:event="oninput" />
                                                    <button class="btn btn-outline-primary" @onclick="() => QueueTextCorrection(err.RowNumber, err.CorrectionField, digitsOnly: false)">Apply</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Edit the file to fix this.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="import-result-banner import-result-banner--ok">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Import successful — <strong>@importResult.ImportedCount</strong> record(s) saved.
                    @if (importResult.SkippedDuplicateCount > 0)
                    {
                        <span class="ms-2 text-muted">
                            (@importResult.SkippedDuplicateCount skipped as duplicates)
                        </span>
                    }
                    @* ── Ref number summary ── *@
                    @if (!string.IsNullOrWhiteSpace(_lastUsedRefSummary))
                    {
                        <div class="mt-1 small text-muted">
                            <i class="bi bi-hash me-1"></i>@_lastUsedRefSummary
                        </div>
                    }
                    else
                    {
                        <div class="mt-1 small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Saved without a reference number — use
                            <strong>Bulk Assign Ref Number</strong> in the grid to assign one later.
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── Update result *@
    @if (updateResult != null)
    {
        <div class="import-result mt-3">
            @if (updateResult.HasErrors)
            {
                <div class="import-result-banner import-result-banner--err">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Update validation failed —
                    <strong>@updateResult.ErrorCount</strong> error(s).
                    No records were updated.
                </div>
                <div class="import-stats">
                    <span>Rows checked: <strong>@updateResult.TotalRows</strong></span>
                    <span>Valid: <strong>@updateResult.ValidRows</strong></span>
                    <span>Errors: <strong class="text-danger">@updateResult.ErrorCount</strong></span>
                </div>
                <div class="import-errors-table mt-2">
                    <div class="import-errors-table-header">Update Errors</div>
                    <div style="max-height:300px; overflow-y:auto;">
                        <table class="sys-err-table">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Field</th>
                                    <th>Message</th>
                                    <th>Value</th>
                                    <th>Suggestion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var err in updateResult.Errors)
                                {
                                    <tr>
                                        <td>@err.RowNumber</td>
                                        <td>@err.Field</td>
                                        <td>@err.Message</td>
                                        <td>@err.RawValue</td>
                                        <td>@err.Suggestion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="import-result-banner import-result-banner--ok">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Update successful —
                    <strong>@updateResult.ImportedCount</strong> record(s) updated.
                </div>
            }
        </div>
    }
</div>

@* ══════════════════════════════════════════════════════════
   SOFT DUPLICATE REVIEW MODAL
   ══════════════════════════════════════════════════════════ *@
<HxModal @ref="duplicateModal" Size="ModalSize.Large" Scrollable="true">
    <HeaderTemplate>
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
            <h5 class="mb-0">Possible Duplicate Records Found</h5>
            <span class="badge bg-warning text-dark ms-1">
                @(previewResult?.SoftDuplicates.Count ?? 0) flagged
            </span>
        </div>
    </HeaderTemplate>
    <BodyTemplate>
        @if (previewResult != null)
        {
            @* Summary strip *@
            <div class="dup-modal-summary mb-3">
                <div class="dup-modal-summary-item text-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>
                        <div class="fw-bold">@previewResult.CleanRows</div>
                        <div class="small">Clean Rows</div>
                    </div>
                </div>
                <div class="dup-modal-summary-item text-warning">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <div>
                        <div class="fw-bold">@previewResult.SoftDuplicates.Count</div>
                        <div class="small">Flagged</div>
                    </div>
                </div>
                <div class="dup-modal-summary-item text-muted">
                    <i class="bi bi-list-ol"></i>
                    <div>
                        <div class="fw-bold">@previewResult.TotalRows</div>
                        <div class="small">Total Rows</div>
                    </div>
                </div>
            </div>

            <p class="text-muted small mb-2">
                <i class="bi bi-info-circle me-1"></i>
                These rows closely match existing records. By default all flagged rows
                are set to <strong>Skip</strong>.
                Toggle each row or use the bulk actions below.
            </p>

            @* Bulk actions *@
            <div class="d-flex gap-2 mb-3 flex-wrap">
                <button class="btn btn-sm btn-outline-warning" @onclick="SkipAll">
                    <i class="bi bi-skip-forward me-1"></i>Skip All
                </button>
                <button class="btn btn-sm btn-outline-success" @onclick="ImportAll">
                    <i class="bi bi-check-all me-1"></i>Import All Anyway
                </button>
                <span class="ms-auto text-muted small align-self-center">
                    <strong>@skipRows.Count</strong> skipped &bull;
                    <strong>
                        @(previewResult.SoftDuplicates.Count - skipRows.Count)
                    </strong> will import
                </span>
            </div>

            @* Duplicate rows table *@
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:55px;">Row</th>
                            <th>Importing</th>
                            <th>Existing Match</th>
                            <th style="width:100px;" class="text-center">Match %</th>
                            <th style="width:150px;" class="text-center">Decision</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dup in previewResult.SoftDuplicates)
                        {
                            var key = DupKey(dup.RowNumber, dup.ExistingId);
                            var isSkipped = skipRows.Contains(key);
                            var pct = (int)(dup.MatchScore * 100);
                            var badgeCss = pct >= 90 ? "bg-danger"
                                          : pct >= 75 ? "bg-warning text-dark"
                                          : "bg-secondary";
                            var likelihood = pct >= 90 ? "Very likely"
                                           : pct >= 75 ? "Possible"
                                           : "Low";

                            <tr class="@(isSkipped ? "table-warning" : "")">
                                <td class="text-center fw-semibold">@dup.RowNumber</td>

                                @* ── Importing ── *@
                                <td>
                                    <div class="fw-semibold">@dup.ImportedName</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar2 me-1"></i>
                                        @dup.ImportedBirthDate.ToString("MMM dd, yyyy")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(dup.ImportedProvince))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-map me-1"></i>@dup.ImportedProvince
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dup.ImportedMunicipality))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-geo-alt me-1"></i>@dup.ImportedMunicipality
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dup.ImportedBarangay))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-house me-1"></i>@dup.ImportedBarangay
                                        </div>
                                    }
                                </td>

                                @* ── Existing Match ── *@
                                <td>
                                    <div class="fw-semibold">@dup.ExistingFullName</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar2 me-1"></i>
                                        @dup.ExistingBirthDate.ToString("MMM dd, yyyy")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(dup.ExistingProvince))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-map me-1"></i>@dup.ExistingProvince
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dup.ExistingMunicipality))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-geo-alt me-1"></i>@dup.ExistingMunicipality
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dup.ExistingBarangay))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-house me-1"></i>@dup.ExistingBarangay
                                        </div>
                                    }
                                </td>

                                @* ── Match score ── *@
                                <td class="text-center">
                                    <span class="badge @badgeCss">@pct%</span>
                                    <div class="text-muted small mt-1">@likelihood</div>
                                </td>

                                @* ── Decision toggle ── *@
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm w-100">
                                        <button class="btn @(isSkipped ? "btn-warning" : "btn-outline-warning")"
                                                @onclick="() => ToggleSkip(dup.RowNumber, dup.ExistingId)">
                                            <i class="bi bi-skip-forward me-1"></i>Skip
                                        </button>
                                        <button class="btn @(!isSkipped ? "btn-success" : "btn-outline-success")"
                                                @onclick="() => ToggleSkip(dup.RowNumber, dup.ExistingId)">
                                            <i class="bi bi-check me-1"></i>Import
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <div class="d-flex w-100 align-items-center gap-2">
            <span class="text-muted small me-auto">
                @WillBeImported of @(previewResult?.TotalRows ?? 0) rows will be imported
            </span>
            <HxButton Color="ThemeColor.Secondary" @onclick="CloseDuplicateModal" Enabled="@(!isUploading)">
                Cancel
            </HxButton>
            <HxButton Color="ThemeColor.Primary" @onclick="RunConfirmImportAsync" Enabled="@(!isUploading)">
                @if (isUploading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Importing...</span>
                }
                else
                {
                    <i class="bi bi-cloud-upload me-1"></i>
                    <span>Confirm &amp; Import (@WillBeImported rows)</span>
                }
            </HxButton>
        </div>
    </FooterTemplate>
</HxModal>

@* ✅ ReferenceNumberModal REMOVED — no longer needed for import *@

@* ══════════════════════════════════════════════════════════
   LOCATION PICKER MODAL — cascading Region → Province →
   Municipality → Barangay, for rows whose location couldn't
   even be fuzzy-matched (most common on Barangay, since many
   barangays share names across different municipalities).
   ══════════════════════════════════════════════════════════ *@
<HxModal @ref="locationPickerModal" Size="ModalSize.Regular">
    <HeaderTemplate>
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-geo-alt-fill text-primary fs-5"></i>
            <h5 class="mb-0">Pick the Correct Location — Row @_pickerRowNumber</h5>
        </div>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="text-muted small mb-3">
            <i class="bi bi-info-circle me-1"></i>
            Select the grantee's actual Region, Province, Municipality, and Barangay.
            All four will be corrected together for this row.
        </p>
        <div class="ff mb-2">
            <label class="ff-label">Region</label>
            <select class="ff-input" value="@_pickerRegionId" @onchange="OnPickerRegionChanged" disabled="@_pickerLoading">
                <option value="0">-- Select Region --</option>
                @foreach (var r in _pickerRegions)
                {
                    <option value="@r.PsgcCodeRegion">@r.Name</option>
                }
            </select>
        </div>
        <div class="ff mb-2">
            <label class="ff-label">Province</label>
            <select class="ff-input" value="@_pickerProvinceId" @onchange="OnPickerProvinceChanged" disabled="@(_pickerRegionId == 0 || _pickerLoading)">
                <option value="0">-- Select Province --</option>
                @foreach (var p in _pickerProvinces)
                {
                    <option value="@p.PsgcCodeProvince">@p.Name</option>
                }
            </select>
        </div>
        <div class="ff mb-2">
            <label class="ff-label">Municipality / City</label>
            <select class="ff-input" value="@_pickerMunicipalityId" @onchange="OnPickerMunicipalityChanged" disabled="@(_pickerProvinceId == 0 || _pickerLoading)">
                <option value="0">-- Select Municipality --</option>
                @foreach (var m in _pickerMunicipalities)
                {
                    <option value="@m.PsgcCodeMunicipality">@m.Name</option>
                }
            </select>
        </div>
        <div class="ff mb-2">
            <label class="ff-label">Barangay</label>
            <select class="ff-input" @bind="_pickerBarangayId" disabled="@(_pickerMunicipalityId == 0 || _pickerLoading)">
                <option value="0">-- Select Barangay --</option>
                @foreach (var b in _pickerBarangays)
                {
                    <option value="@b.PsgcCodeBarangay">@b.Name</option>
                }
            </select>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="CloseLocationPicker">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="ApplyLocationPickerCorrection"
                  Enabled="@(_pickerRegionId != 0 && _pickerProvinceId != 0 && _pickerMunicipalityId != 0 && _pickerBarangayId != 0)">
            <i class="bi bi-check2 me-1"></i>Use This Location
        </HxButton>
    </FooterTemplate>
</HxModal>

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    private bool isDownloadingTemplate;
    private IBrowserFile? selectedFile;
    private string? errorMessage;
    private string? successMessage;
    private BeneficiaryImportResultDto? importResult;
    private List<string> excelSheetNames = new();
    private string? selectedSheetName;
    private byte[]? uploadedExcelBytes;
    private string? uploadedExcelFileName;
    private bool isLoadingSheets;
    private bool isUploading;
    private bool isUpdating;
    private BeneficiaryImportResultDto? updateResult;
    private bool isPreviewing;
    private BeneficiaryPreviewResultDto? previewResult;
    private HashSet<string> skipRows = new();
    private HxModal duplicateModal = default!;

    // ✅ Optional ref number fields — all nullable
    private string? _importQuarter = null;
    private string? _importBatch = null;
    private int? _importRefYear = null;

    // ✅ Shown in success banner after import
    private string? _lastUsedRefSummary;

    // ── Inline error correction — "accept correction" instead of forcing a
    // re-edit-and-re-upload cycle for every fixable error. Keyed by
    // RowNumber → Field → corrected raw value, sent back to the server on
    // the next preview/confirm call and applied before re-validation. ──────
    private readonly Dictionary<int, Dictionary<string, string>> _acceptedCorrections = new();
    private readonly Dictionary<string, string> _inlineCorrectionDrafts = new();
    private string _bulkNcscAssessmentValue = string.Empty;
    // ✅ Default true — as soon as a row has a correction queued, it drops
    // out of the list so the table shrinks instead of growing into an
    // ever-longer scroll of rows the user already dealt with.
    private bool _hideCorrectedErrors = true;

    // ── Location picker (Region → Province → Municipality → Barangay) ──────
    private HxModal locationPickerModal = default!;
    private int? _pickerRowNumber;
    private List<RegionLookupDto> _pickerRegions = new();
    private List<ProvinceLookupDto> _pickerProvinces = new();
    private List<MunicipalityLookupDto> _pickerMunicipalities = new();
    private List<BarangayLookupDto> _pickerBarangays = new();
    private int _pickerRegionId, _pickerProvinceId, _pickerMunicipalityId, _pickerBarangayId;
    private bool _pickerLoading;

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static string DupKey(int rowNumber, Guid existingId)
        => $"{rowNumber}_{existingId}";

    // ── Inline correction helpers ───────────────────────────────────────────
    private bool IsCorrectionAccepted(int rowNumber, string? field) =>
        field is not null &&
        _acceptedCorrections.TryGetValue(rowNumber, out var map) &&
        map.ContainsKey(field);

    private void QueueCorrection(int rowNumber, string field, string value)
    {
        if (!_acceptedCorrections.TryGetValue(rowNumber, out var map))
        {
            map = new();
            _acceptedCorrections[rowNumber] = map;
        }
        map[field] = value;
    }

    private void UndoCorrection(int rowNumber, string? field)
    {
        if (field is null) return;
        if (_acceptedCorrections.TryGetValue(rowNumber, out var map))
        {
            map.Remove(field);
            if (map.Count == 0) _acceptedCorrections.Remove(rowNumber);
        }
    }

    private void AcceptSuggestion(BeneficiaryImportErrorDto err)
    {
        if (err.CorrectionField is null || err.SuggestedValue is null) return;
        QueueCorrection(err.RowNumber, err.CorrectionField, err.SuggestedValue);
    }

    // ✅ Bulk-fix — NCSC Assessment is almost always the same answer for a
    // whole batch, so picking it row-by-row for dozens of blank/invalid
    // cells is pure busywork. One selection queues the correction for every
    // row that has this error at once.
    private void ApplyBulkNcscAssessment()
    {
        if (string.IsNullOrWhiteSpace(_bulkNcscAssessmentValue) || importResult is null) return;

        var affectedRows = importResult.Errors
            .Where(e => e.CorrectionField == "NcscAssessment")
            .ToList();

        foreach (var err in affectedRows)
            QueueCorrection(err.RowNumber, "NcscAssessment", _bulkNcscAssessmentValue);

        toast.ShowSuccess($"Queued '{_bulkNcscAssessmentValue}' for {affectedRows.Count} row(s).");
        _bulkNcscAssessmentValue = string.Empty;
    }

    private string CorrectionDraftKey(int rowNumber, string? field)
    {
        var key = $"{rowNumber}_{field}";
        if (!_inlineCorrectionDrafts.ContainsKey(key))
            _inlineCorrectionDrafts[key] = string.Empty;
        return key;
    }

    private void QueueSelectCorrection(int rowNumber, string? field, string? value)
    {
        if (field is null || string.IsNullOrWhiteSpace(value)) return;
        QueueCorrection(rowNumber, field, value);
    }

    private void QueueTextCorrection(int rowNumber, string? field, bool digitsOnly)
    {
        if (field is null) return;
        var key = CorrectionDraftKey(rowNumber, field);
        var value = _inlineCorrectionDrafts.GetValueOrDefault(key, string.Empty).Trim();
        if (digitsOnly)
            value = new string(value.Where(char.IsDigit).ToArray());

        if (string.IsNullOrWhiteSpace(value))
        {
            toast.ShowError("Please enter a value before applying.");
            return;
        }
        QueueCorrection(rowNumber, field, value);
    }

    // ── Location picker ──────────────────────────────────────────────────────
    // ✅ Pre-fills the cascade from the row's Current Location reference
    // (RowRegion/RowProvince/RowMunicipality) whenever a name match is
    // found, so the user usually only has to pick the Barangay itself
    // instead of re-selecting the whole chain from scratch.
    private static T? FindByName<T>(IEnumerable<T> items, Func<T, string> nameSelector, string? name) where T : class
    {
        if (string.IsNullOrWhiteSpace(name)) return null;
        var trimmed = name.Trim();
        return items.FirstOrDefault(x => string.Equals(nameSelector(x), trimmed, StringComparison.OrdinalIgnoreCase))
            ?? items.FirstOrDefault(x => nameSelector(x).Contains(trimmed, StringComparison.OrdinalIgnoreCase)
                                       || trimmed.Contains(nameSelector(x), StringComparison.OrdinalIgnoreCase));
    }

    private async Task OpenLocationPicker(BeneficiaryImportErrorDto err)
    {
        _pickerRowNumber = err.RowNumber;
        _pickerProvinces.Clear();
        _pickerMunicipalities.Clear();
        _pickerBarangays.Clear();
        _pickerRegionId = _pickerProvinceId = _pickerMunicipalityId = _pickerBarangayId = 0;

        try
        {
            _pickerLoading = true;

            if (!_pickerRegions.Any())
                _pickerRegions = await Http.GetFromJsonAsync<List<RegionLookupDto>>("api/Region") ?? new();

            var region = FindByName(_pickerRegions, r => r.Name, err.RowRegion);
            if (region is null) return;
            _pickerRegionId = region.PsgcCodeRegion;
            await LoadPickerProvinces(_pickerRegionId);

            var province = FindByName(_pickerProvinces, p => p.Name, err.RowProvince);
            if (province is null) return;
            _pickerProvinceId = province.PsgcCodeProvince;
            await LoadPickerMunicipalities(_pickerProvinceId);

            var municipality = FindByName(_pickerMunicipalities, m => m.Name, err.RowMunicipality);
            if (municipality is null) return;
            _pickerMunicipalityId = municipality.PsgcCodeMunicipality;
            await LoadPickerBarangays(_pickerMunicipalityId);
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to load location reference: {ex.Message}");
        }
        finally
        {
            _pickerLoading = false;
            await locationPickerModal.ShowAsync();
        }
    }

    private async Task LoadPickerProvinces(int regionId)
    {
        _pickerProvinces = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>(
            $"api/Province/by-region/{regionId}") ?? new();
    }

    private async Task LoadPickerMunicipalities(int provinceId)
    {
        _pickerMunicipalities = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>(
            $"api/Municipality/by-province/{provinceId}") ?? new();
    }

    private async Task LoadPickerBarangays(int municipalityId)
    {
        var response = await Http.PostAsJsonAsync(
            "api/Barangay/by-municipalities",
            new LookupMultiRequestDto { Ids = new List<int> { municipalityId } });
        if (response.IsSuccessStatusCode)
            _pickerBarangays = await response.Content.ReadFromJsonAsync<List<BarangayLookupDto>>() ?? new();
    }

    private async Task OnPickerRegionChanged(ChangeEventArgs e)
    {
        _pickerRegionId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        _pickerProvinces.Clear();
        _pickerMunicipalities.Clear();
        _pickerBarangays.Clear();
        _pickerProvinceId = _pickerMunicipalityId = _pickerBarangayId = 0;
        if (_pickerRegionId == 0) return;

        try
        {
            _pickerLoading = true;
            await LoadPickerProvinces(_pickerRegionId);
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to load provinces: {ex.Message}");
        }
        finally
        {
            _pickerLoading = false;
        }
    }

    private async Task OnPickerProvinceChanged(ChangeEventArgs e)
    {
        _pickerProvinceId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        _pickerMunicipalities.Clear();
        _pickerBarangays.Clear();
        _pickerMunicipalityId = _pickerBarangayId = 0;
        if (_pickerProvinceId == 0) return;

        try
        {
            _pickerLoading = true;
            await LoadPickerMunicipalities(_pickerProvinceId);
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to load municipalities: {ex.Message}");
        }
        finally
        {
            _pickerLoading = false;
        }
    }

    private async Task OnPickerMunicipalityChanged(ChangeEventArgs e)
    {
        _pickerMunicipalityId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        _pickerBarangays.Clear();
        _pickerBarangayId = 0;
        if (_pickerMunicipalityId == 0) return;

        try
        {
            _pickerLoading = true;
            await LoadPickerBarangays(_pickerMunicipalityId);
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to load barangays: {ex.Message}");
        }
        finally
        {
            _pickerLoading = false;
        }
    }

    private async Task ApplyLocationPickerCorrection()
    {
        if (_pickerRowNumber is not int rowNumber) return;

        var region = _pickerRegions.FirstOrDefault(r => r.PsgcCodeRegion == _pickerRegionId);
        var province = _pickerProvinces.FirstOrDefault(p => p.PsgcCodeProvince == _pickerProvinceId);
        var municipality = _pickerMunicipalities.FirstOrDefault(m => m.PsgcCodeMunicipality == _pickerMunicipalityId);
        var barangay = _pickerBarangays.FirstOrDefault(b => b.PsgcCodeBarangay == _pickerBarangayId);

        if (region is null || province is null || municipality is null || barangay is null)
        {
            toast.ShowError("Please select Region, Province, Municipality, and Barangay.");
            return;
        }

        // ✅ Corrects the whole location chain together for this row, so it
        // stays internally consistent regardless of which piece originally
        // failed to match.
        QueueCorrection(rowNumber, "Region", region.Name);
        QueueCorrection(rowNumber, "Province", province.Name);
        QueueCorrection(rowNumber, "Municipality", municipality.Name);
        QueueCorrection(rowNumber, "Barangay", barangay.Name);

        _pickerRowNumber = null;
        try { await locationPickerModal.HideAsync(); } catch { /* already closed */ }
        toast.ShowSuccess($"Location set for row {rowNumber}. Click \"Apply Corrections & Re-validate\" to continue.");
    }

    private async Task CloseLocationPicker()
    {
        _pickerRowNumber = null;
        try { await locationPickerModal.HideAsync(); } catch { /* already closed */ }
    }

    private int WillBeImported
    {
        get
        {
            if (previewResult == null) return 0;

            var rowGroups = previewResult.SoftDuplicates
                .GroupBy(x => x.RowNumber);

            int importingRows = rowGroups
                .Count(g => g.Any(c =>
                    !skipRows.Contains(DupKey(c.RowNumber, c.ExistingId))));

            int cleanRows = previewResult.CleanRows - rowGroups.Count();
            return Math.Max(0, cleanRows + importingRows);
        }
    }

    // ── Download template ─────────────────────────────────────────────────────
    private async Task DownloadTemplateAsync()
    {
        try
        {
            isDownloadingTemplate = true;
            var response = await Http.GetAsync(
                "api/beneficiary/download-import-template");

            if (response.IsSuccessStatusCode)
            {
                var fileStream = await response.Content.ReadAsStreamAsync();
                var fileName = $"ImportTemplate_{DateTime.Now:yyyy-MM-dd}.xlsx";
                using var streamRef = new DotNetStreamReference(stream: fileStream);
                await JS.InvokeVoidAsync(
                    "downloadFileFromStream", fileName, streamRef);
            }
            toast.ShowSuccess("Import template downloaded successfully.");
        }
        catch (Exception ex)
        {
            toast.ShowError($"Template download failed: {ex.Message}");
        }
        finally
        {
            isDownloadingTemplate = false;
        }
    }

    // ── File selected ─────────────────────────────────────────────────────────
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;
        successMessage = null;
        importResult = null;
        updateResult = null;
        previewResult = null;
        skipRows = new();
        _lastUsedRefSummary = null;
        _acceptedCorrections.Clear();
        _inlineCorrectionDrafts.Clear();
        excelSheetNames.Clear();
        selectedSheetName = null;
        uploadedExcelBytes = null;
        uploadedExcelFileName = null;

        if (selectedFile == null) return;

        try
        {
            isLoadingSheets = true;
            await using var uploadStream =
                selectedFile.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await uploadStream.CopyToAsync(ms);
            uploadedExcelBytes = ms.ToArray();
            uploadedExcelFileName = selectedFile.Name;

            using var content = new MultipartFormDataContent();
            content.Add(
                new ByteArrayContent(uploadedExcelBytes),
                "file", uploadedExcelFileName);

            var response = await Http.PostAsync(
                "api/beneficiary/import/sheets", content);

            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    toast.ShowError("Access denied. You do not have permission to import records.");
                    return;
                }
                throw new Exception(await response.Content.ReadAsStringAsync());
            }

            if (response.IsSuccessStatusCode)
            {
                excelSheetNames = await response.Content
                    .ReadFromJsonAsync<List<string>>() ?? new();
                if (excelSheetNames.Any())
                    selectedSheetName = excelSheetNames.First();
            }
            else
            {
                throw new Exception(
                    await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to read Excel sheets: {ex.Message}");
        }
        finally
        {
            isLoadingSheets = false;
            StateHasChanged();
        }
    }

    // ── Update existing records ───────────────────────────────────────────────
    private async Task UpdateExcelAsync()
    {
        if (uploadedExcelBytes == null ||
            string.IsNullOrWhiteSpace(selectedSheetName))
        {
            toast.ShowError("Please select a file and a worksheet first.");
            return;
        }

        isUpdating = true;
        updateResult = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(
                new ByteArrayContent(uploadedExcelBytes),
                "File", uploadedExcelFileName ?? "update.xlsx");
            content.Add(new StringContent(selectedSheetName), "SheetName");

            var response = await Http.PostAsync(
                "api/beneficiary/update-excel", content);
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                toast.ShowError("Access denied. You do not have permission to update records via Excel.");
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                updateResult = await response.Content
                    .ReadFromJsonAsync<BeneficiaryImportResultDto>();

                if (updateResult?.HasErrors == true)
                    toast.ShowError(
                        $"Update finished with {updateResult.ErrorCount} error(s).");
                else
                    toast.ShowSuccess(
                        $"Update completed. {updateResult?.ImportedCount ?? 0} record(s) updated.");
            }
            else
            {
                throw new Exception(
                    await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Update failed: {ex.Message}");
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    // ── Phase 1: Preview + duplicate detection ────────────────────────────────
    private async Task RunPreviewAsync()
    {
        // ✅ No role check — API will return 403 if unauthorized
        if (uploadedExcelBytes == null || string.IsNullOrWhiteSpace(uploadedExcelFileName))
        {
            toast.ShowError("Please select an Excel file first.");
            return;
        }
        if (string.IsNullOrWhiteSpace(selectedSheetName))
        {
            toast.ShowError("Please select a worksheet first.");
            return;
        }

        importResult = null;
        updateResult = null;
        previewResult = null;
        skipRows = new();
        _lastUsedRefSummary = null;

        try
        {
            isPreviewing = true;
            StateHasChanged();

            using var content = new MultipartFormDataContent();
            content.Add(
                new ByteArrayContent(uploadedExcelBytes),
                "File", uploadedExcelFileName);
            content.Add(new StringContent(selectedSheetName), "SheetName");
            if (_acceptedCorrections.Any())
            {
                content.Add(
                    new StringContent(System.Text.Json.JsonSerializer.Serialize(_acceptedCorrections)),
                    "CorrectionsJson");
            }

            var response = await Http.PostAsync(
                "api/beneficiary/import/preview", content);
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    toast.ShowError("Access denied. You do not have permission to import records.");
                    return;
                }
                throw new Exception(await response.Content.ReadAsStringAsync());
            }

            if (!response.IsSuccessStatusCode)
                throw new Exception(
                    await response.Content.ReadAsStringAsync());

            previewResult = await response.Content
    .ReadFromJsonAsync<BeneficiaryPreviewResultDto>();

            if (previewResult == null)
            {
                toast.ShowError("Unexpected empty response from server.");
                return;
            }

            // ── Hard errors → show inline ─────────────────────────────────
            if (previewResult.HardErrors.Any())
            {
                importResult = new BeneficiaryImportResultDto
                {
                    TotalRows = previewResult.TotalRows,
                    ValidRows = previewResult.CleanRows,
                    ErrorCount = previewResult.HardErrors.Count,
                    Errors = previewResult.HardErrors
                };
                toast.ShowError(
                    $"Validation failed. {previewResult.HardErrors.Count} error(s) found.");
                return;
            }

            // ── Soft duplicates → open review modal ───────────────────────
            if (previewResult.SoftDuplicates.Any())
            {
                skipRows = new HashSet<string>(
                    previewResult.SoftDuplicates
                        .Select(x => DupKey(x.RowNumber, x.ExistingId)));
                await duplicateModal.ShowAsync();
                return;
            }

            // ── Fully clean → import immediately ──────────────────────────
            await RunConfirmImportAsync();
        }
        catch (Exception ex)
        {
            toast.ShowError($"Preview failed: {ex.Message}");
        }
        finally
        {
            isPreviewing = false;
            StateHasChanged();
        }
    }

    // ── Phase 2: Confirm import ───────────────────────────────────────────────
    private async Task RunConfirmImportAsync()
    {
        if (uploadedExcelBytes == null ||
            string.IsNullOrWhiteSpace(uploadedExcelFileName))
        {
            toast.ShowError("File data is missing. Please re-select the file.");
            return;
        }

        // ✅ Reference number is optional — same as manual grantee creation,
        // this is just noted alongside the success message afterward, not
        // flagged as a warning beforehand (it isn't a problem).
        bool hasRefNumber = !string.IsNullOrWhiteSpace(_importQuarter)
                         && !string.IsNullOrWhiteSpace(_importBatch)
                         && _importRefYear.HasValue;

        // ── Build skip rows set ───────────────────────────────────────────
        var rowNumbersToSkip = previewResult?.SoftDuplicates
            .GroupBy(x => x.RowNumber)
            .Where(g => g.All(c =>
                skipRows.Contains(DupKey(c.RowNumber, c.ExistingId))))
            .Select(g => g.Key)
            .ToHashSet() ?? new HashSet<int>();

        // ── Close soft duplicate modal if open ────────────────────────────
        await CloseDuplicateModal();

        try
        {
            isUploading = true;
            StateHasChanged();

            using var content = new MultipartFormDataContent();
            content.Add(
                new ByteArrayContent(uploadedExcelBytes),
                "File", uploadedExcelFileName);
            content.Add(new StringContent(selectedSheetName!), "SheetName");
            content.Add(
                new StringContent(
                    System.Text.Json.JsonSerializer.Serialize(rowNumbersToSkip)),
                "SkipRowsJson");
            if (_acceptedCorrections.Any())
            {
                content.Add(
                    new StringContent(System.Text.Json.JsonSerializer.Serialize(_acceptedCorrections)),
                    "CorrectionsJson");
            }

            // ✅ Only add ref number fields if all three are provided
            // Server accepts null/missing — nullable params in controller
            if (!string.IsNullOrWhiteSpace(_importQuarter))
                content.Add(new StringContent(_importQuarter), "Quarter");

            if (!string.IsNullOrWhiteSpace(_importBatch))
                content.Add(new StringContent(_importBatch), "Batch");

            if (_importRefYear.HasValue)
                content.Add(
                    new StringContent(_importRefYear.Value.ToString()),
                    "RefYear");

            var response = await Http.PostAsync(
                "api/beneficiary/import/confirm", content);
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                toast.ShowError("Access denied. You do not have permission to import records.");
                await CloseDuplicateModal();
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                importResult = await response.Content
                    .ReadFromJsonAsync<BeneficiaryImportResultDto>();

                if (importResult?.HasErrors == true)
                {
                    toast.ShowError(
                        $"Validation failed. {importResult.ErrorCount} error(s).");
                }
                else
                {
                    // ✅ Build ref number summary for success banner
                    _lastUsedRefSummary = hasRefNumber
                        ? $"Reference number assigned: Q{_importQuarter}B{_importBatch}" +
                          $"-{_importRefYear!.Value:D2}-#####-XIII"
                        : null;

                    toast.ShowSuccess(
                        $"Import completed. {importResult?.ImportedCount ?? 0} record(s) saved." +
                        (hasRefNumber
                            ? $" Reference: Q{_importQuarter}B{_importBatch}-{_importRefYear!.Value:D2}"
                            : " Saved without a reference number — you can assign one later in the grid."));
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Import failed: {error}");
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Import failed: {ex.Message}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    // ── Skip row helpers ──────────────────────────────────────────────────────
    private void ToggleSkip(int rowNumber, Guid existingId)
    {
        var key = DupKey(rowNumber, existingId);
        if (!skipRows.Remove(key))
            skipRows.Add(key);
        StateHasChanged();
    }

    private void SkipAll()
    {
        if (previewResult == null) return;
        foreach (var dup in previewResult.SoftDuplicates)
            skipRows.Add(DupKey(dup.RowNumber, dup.ExistingId));
        StateHasChanged();
    }

    private void ImportAll()
    {
        skipRows.Clear();
        StateHasChanged();
    }

    private async Task CloseDuplicateModal()
    {
        try { await duplicateModal.HideAsync(); }
        catch { /* modal may already be closed */ }
    }
}