@* BeneficiaryImporting.razor — with advanced duplicate detection modal *@
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
using EcaInformationSystem.Shared.DTOs;
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthService AuthService
@inject ToastService toast

<div class="import-wrap">

    @* ── Top row: description + download template *@
    <div class="import-toprow">
        <span class="import-hint">
            <i class="bi bi-info-circle me-1"></i>
            Download the official template, fill it out, then upload below.
        </span>
        <button class="sys-btn sys-btn-outline" @onclick="DownloadTemplateAsync" disabled="@isDownloadingTemplate">
            @if (isDownloadingTemplate)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Downloading...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-arrow-down me-1"></i>
                <span>Download Template</span>
            }
        </button>
    </div>

    @* ── File picker *@
    <div class="import-file-row">
        <InputFile OnChange="HandleFileSelected" accept=".xlsx" class="ff-input" />
        @if (isLoadingSheets)
        {
            <span class="ff-loading mt-1">
                <span class="spinner-border spinner-border-sm"></span> Reading sheets...
            </span>
        }
    </div>

    @* ── Sheet selector *@
    @if (excelSheetNames.Any())
    {
        <div class="ff mt-2">
            <label class="ff-label">Worksheet</label>
            <InputSelect class="ff-input" @bind-Value="selectedSheetName">
                @foreach (var sheet in excelSheetNames)
                {
                    <option value="@sheet">@sheet</option>
                }
            </InputSelect>
        </div>

        @if (!string.IsNullOrWhiteSpace(uploadedExcelFileName))
        {
            <div class="import-file-info mt-1">
                <i class="bi bi-file-earmark-excel text-success me-1"></i>
                <strong>@uploadedExcelFileName</strong>
                &nbsp;·&nbsp; @excelSheetNames.Count worksheet(s) found
            </div>
        }

        @* ── Reference Number (optional) ──────────────────────────────── *@
        <div class="mt-3 p-3 border rounded" style="background: var(--bs-light);">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-hash text-muted"></i>
                <span class="fw-semibold small">Reference Number</span>
                <span class="badge bg-secondary fw-normal" style="font-size:10px;">
                    Optional
                </span>
            </div>
            <p class="text-muted small mb-2">
                Leave blank to import without a reference number.
                You can assign reference numbers later using
                <strong>Bulk Assign Ref Number</strong> in the records grid.
            </p>
            <div class="d-flex align-items-end gap-3 flex-wrap">
                <div class="d-flex flex-column">
                    <label class="ff-label mb-1">Quarter</label>
                    <select class="ff-input" style="width: 140px;" @bind="_importQuarter">
                        <option value="">-- Skip --</option>
                        <option value="1">Q1 (Jan–Mar)</option>
                        <option value="2">Q2 (Apr–Jun)</option>
                        <option value="3">Q3 (Jul–Sep)</option>
                        <option value="4">Q4 (Oct–Dec)</option>
                    </select>
                </div>
                <div class="d-flex flex-column">
                    <label class="ff-label mb-1">Batch</label>
                    <input type="text" class="ff-input" style="width: 100px;" placeholder="e.g. 1" @bind="_importBatch" />
                </div>
                <div class="d-flex flex-column">
                    <label class="ff-label mb-1">Year (short)</label>
                    <input type="number" class="ff-input" style="width: 120px;" placeholder="e.g. 26"
                           @bind="_importRefYear" />
                </div>
            </div>

            @* ── Preview of what ref number will look like ── *@
            @if (!string.IsNullOrWhiteSpace(_importQuarter) &&
                 !string.IsNullOrWhiteSpace(_importBatch) &&
                 _importRefYear.HasValue)
            {
                <div class="alert alert-success py-1 px-2 mt-2 mb-0 small">
                    <i class="bi bi-check-circle me-1"></i>
                    Records will be assigned:
                    <strong>
                        Q@(_importQuarter)B@(_importBatch)-@(_importRefYear.Value.ToString("D2"))-#####-XIII
                    </strong>
                    <span class="text-muted">(unique code per record)</span>
                </div>
            }
        </div>
    }

    @* ── Hint *@
    <p class="import-hint mt-2">
        <i class="bi bi-shield-check me-1"></i>
        All rows are validated first. No records are saved if any error is found.
    </p>

    @* ── Action buttons *@
    <div class="d-flex gap-2 mt-2 flex-wrap">
        <button class="sys-btn sys-btn-save" @onclick="RunPreviewAsync"
                disabled="@(isUploading || isPreviewing || uploadedExcelBytes == null
                                                                                                                                                                                                                                                                          || !excelSheetNames.Any()
                                                                                                                                                                                                                                                                          || string.IsNullOrWhiteSpace(selectedSheetName))">
            @if (isPreviewing)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Validating...</span>
            }
            else
            {
                <i class="bi bi-cloud-upload me-1"></i>
                <span>Validate &amp; Import</span>
            }
        </button>
    </div>

    @* ── Import result *@
    @if (importResult != null)
    {
        <div class="import-result mt-3">
            @if (importResult.HasErrors)
            {
                <div class="import-result-banner import-result-banner--err">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Import validation failed — <strong>@importResult.ErrorCount</strong> error(s).
                    No records were saved. Fix the file and re-upload.
                </div>
                <div class="import-stats">
                    <span>Rows checked: <strong>@importResult.TotalRows</strong></span>
                    <span>Valid: <strong>@importResult.ValidRows</strong></span>
                    <span>Errors: <strong class="text-danger">@importResult.ErrorCount</strong></span>
                </div>
                <div class="import-errors-table mt-2">
                    <div class="import-errors-table-header">Import Errors</div>
                    <div style="max-height:300px; overflow-y:auto;">
                        <table class="sys-err-table">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Field</th>
                                    <th>Message</th>
                                    <th>Value</th>
                                    <th>Suggestion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var err in importResult.Errors)
                                {
                                    <tr>
                                        <td>@err.RowNumber</td>
                                        <td>@err.Field</td>
                                        <td>@err.Message</td>
                                        <td>@err.RawValue</td>
                                        <td>@err.Suggestion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="import-result-banner import-result-banner--ok">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Import successful — <strong>@importResult.ImportedCount</strong> record(s) saved.
                    @if (importResult.SkippedDuplicateCount > 0)
                    {
                        <span class="ms-2 text-muted">
                            (@importResult.SkippedDuplicateCount skipped as duplicates)
                        </span>
                    }
                    @* ── Ref number summary ── *@
                    @if (!string.IsNullOrWhiteSpace(_lastUsedRefSummary))
                    {
                        <div class="mt-1 small text-muted">
                            <i class="bi bi-hash me-1"></i>@_lastUsedRefSummary
                        </div>
                    }
                    else
                    {
                        <div class="mt-1 small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            No reference number assigned — use
                            <strong>Bulk Assign Ref Number</strong> in the grid.
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── Update result *@
    @if (updateResult != null)
    {
        <div class="import-result mt-3">
            @if (updateResult.HasErrors)
            {
                <div class="import-result-banner import-result-banner--err">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Update validation failed —
                    <strong>@updateResult.ErrorCount</strong> error(s).
                    No records were updated.
                </div>
                <div class="import-stats">
                    <span>Rows checked: <strong>@updateResult.TotalRows</strong></span>
                    <span>Valid: <strong>@updateResult.ValidRows</strong></span>
                    <span>Errors: <strong class="text-danger">@updateResult.ErrorCount</strong></span>
                </div>
                <div class="import-errors-table mt-2">
                    <div class="import-errors-table-header">Update Errors</div>
                    <div style="max-height:300px; overflow-y:auto;">
                        <table class="sys-err-table">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Field</th>
                                    <th>Message</th>
                                    <th>Value</th>
                                    <th>Suggestion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var err in updateResult.Errors)
                                {
                                    <tr>
                                        <td>@err.RowNumber</td>
                                        <td>@err.Field</td>
                                        <td>@err.Message</td>
                                        <td>@err.RawValue</td>
                                        <td>@err.Suggestion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="import-result-banner import-result-banner--ok">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Update successful —
                    <strong>@updateResult.ImportedCount</strong> record(s) updated.
                </div>
            }
        </div>
    }
</div>

@* ══════════════════════════════════════════════════════════
   SOFT DUPLICATE REVIEW MODAL
   ══════════════════════════════════════════════════════════ *@
<HxModal @ref="duplicateModal" Size="ModalSize.Large" Scrollable="true">
    <HeaderTemplate>
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
            <h5 class="mb-0">Possible Duplicate Records Found</h5>
            <span class="badge bg-warning text-dark ms-1">
                @(previewResult?.SoftDuplicates.Count ?? 0) flagged
            </span>
        </div>
    </HeaderTemplate>
    <BodyTemplate>
        @if (previewResult != null)
        {
            @* Summary strip *@
            <div class="dup-modal-summary mb-3">
                <div class="dup-modal-summary-item text-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>
                        <div class="fw-bold">@previewResult.CleanRows</div>
                        <div class="small">Clean Rows</div>
                    </div>
                </div>
                <div class="dup-modal-summary-item text-warning">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <div>
                        <div class="fw-bold">@previewResult.SoftDuplicates.Count</div>
                        <div class="small">Flagged</div>
                    </div>
                </div>
                <div class="dup-modal-summary-item text-muted">
                    <i class="bi bi-list-ol"></i>
                    <div>
                        <div class="fw-bold">@previewResult.TotalRows</div>
                        <div class="small">Total Rows</div>
                    </div>
                </div>
            </div>

            <p class="text-muted small mb-2">
                <i class="bi bi-info-circle me-1"></i>
                These rows closely match existing records. By default all flagged rows
                are set to <strong>Skip</strong>.
                Toggle each row or use the bulk actions below.
            </p>

            @* Bulk actions *@
            <div class="d-flex gap-2 mb-3 flex-wrap">
                <button class="btn btn-sm btn-outline-warning" @onclick="SkipAll">
                    <i class="bi bi-skip-forward me-1"></i>Skip All
                </button>
                <button class="btn btn-sm btn-outline-success" @onclick="ImportAll">
                    <i class="bi bi-check-all me-1"></i>Import All Anyway
                </button>
                <span class="ms-auto text-muted small align-self-center">
                    <strong>@skipRows.Count</strong> skipped &bull;
                    <strong>
                        @(previewResult.SoftDuplicates.Count - skipRows.Count)
                    </strong> will import
                </span>
            </div>

            @* Duplicate rows table *@
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:55px;">Row</th>
                            <th>Importing</th>
                            <th>Existing Match</th>
                            <th style="width:100px;" class="text-center">Match %</th>
                            <th style="width:150px;" class="text-center">Decision</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dup in previewResult.SoftDuplicates)
                        {
                            var key = DupKey(dup.RowNumber, dup.ExistingId);
                            var isSkipped = skipRows.Contains(key);
                            var pct = (int)(dup.MatchScore * 100);
                            var badgeCss = pct >= 90 ? "bg-danger"
                                          : pct >= 75 ? "bg-warning text-dark"
                                          : "bg-secondary";
                            var likelihood = pct >= 90 ? "Very likely"
                                           : pct >= 75 ? "Possible"
                                           : "Low";

                            <tr class="@(isSkipped ? "table-warning" : "")">
                                <td class="text-center fw-semibold">@dup.RowNumber</td>

                                @* ── Importing ── *@
                                <td>
                                    <div class="fw-semibold">@dup.ImportedName</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar2 me-1"></i>
                                        @dup.ImportedBirthDate.ToString("MMM dd, yyyy")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(dup.ImportedProvince))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-map me-1"></i>@dup.ImportedProvince
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dup.ImportedMunicipality))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-geo-alt me-1"></i>@dup.ImportedMunicipality
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dup.ImportedBarangay))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-house me-1"></i>@dup.ImportedBarangay
                                        </div>
                                    }
                                </td>

                                @* ── Existing Match ── *@
                                <td>
                                    <div class="fw-semibold">@dup.ExistingFullName</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar2 me-1"></i>
                                        @dup.ExistingBirthDate.ToString("MMM dd, yyyy")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(dup.ExistingProvince))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-map me-1"></i>@dup.ExistingProvince
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dup.ExistingMunicipality))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-geo-alt me-1"></i>@dup.ExistingMunicipality
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dup.ExistingBarangay))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-house me-1"></i>@dup.ExistingBarangay
                                        </div>
                                    }
                                </td>

                                @* ── Match score ── *@
                                <td class="text-center">
                                    <span class="badge @badgeCss">@pct%</span>
                                    <div class="text-muted small mt-1">@likelihood</div>
                                </td>

                                @* ── Decision toggle ── *@
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm w-100">
                                        <button class="btn @(isSkipped ? "btn-warning" : "btn-outline-warning")"
                                                @onclick="() => ToggleSkip(dup.RowNumber, dup.ExistingId)">
                                            <i class="bi bi-skip-forward me-1"></i>Skip
                                        </button>
                                        <button class="btn @(!isSkipped ? "btn-success" : "btn-outline-success")"
                                                @onclick="() => ToggleSkip(dup.RowNumber, dup.ExistingId)">
                                            <i class="bi bi-check me-1"></i>Import
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <div class="d-flex w-100 align-items-center gap-2">
            <span class="text-muted small me-auto">
                @WillBeImported of @(previewResult?.TotalRows ?? 0) rows will be imported
            </span>
            <HxButton Color="ThemeColor.Secondary" @onclick="CloseDuplicateModal" Enabled="@(!isUploading)">
                Cancel
            </HxButton>
            <HxButton Color="ThemeColor.Primary" @onclick="RunConfirmImportAsync" Enabled="@(!isUploading)">
                @if (isUploading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Importing...</span>
                }
                else
                {
                    <i class="bi bi-cloud-upload me-1"></i>
                    <span>Confirm &amp; Import (@WillBeImported rows)</span>
                }
            </HxButton>
        </div>
    </FooterTemplate>
</HxModal>

@* ✅ ReferenceNumberModal REMOVED — no longer needed for import *@

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    private bool isDownloadingTemplate;
    private IBrowserFile? selectedFile;
    private string? errorMessage;
    private string? successMessage;
    private BeneficiaryImportResultDto? importResult;
    private List<string> excelSheetNames = new();
    private string? selectedSheetName;
    private byte[]? uploadedExcelBytes;
    private string? uploadedExcelFileName;
    private bool isLoadingSheets;
    private bool isUploading;
    private bool isUpdating;
    private BeneficiaryImportResultDto? updateResult;
    private bool isPreviewing;
    private BeneficiaryPreviewResultDto? previewResult;
    private HashSet<string> skipRows = new();
    private HxModal duplicateModal = default!;

    // ✅ Optional ref number fields — all nullable
    private string? _importQuarter = null;
    private string? _importBatch = null;
    private int? _importRefYear = null;

    // ✅ Shown in success banner after import
    private string? _lastUsedRefSummary;

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static string DupKey(int rowNumber, Guid existingId)
        => $"{rowNumber}_{existingId}";

    private int WillBeImported
    {
        get
        {
            if (previewResult == null) return 0;

            var rowGroups = previewResult.SoftDuplicates
                .GroupBy(x => x.RowNumber);

            int importingRows = rowGroups
                .Count(g => g.Any(c =>
                    !skipRows.Contains(DupKey(c.RowNumber, c.ExistingId))));

            int cleanRows = previewResult.CleanRows - rowGroups.Count();
            return Math.Max(0, cleanRows + importingRows);
        }
    }

    // ── Download template ─────────────────────────────────────────────────────
    private async Task DownloadTemplateAsync()
    {
        try
        {
            isDownloadingTemplate = true;
            var response = await Http.GetAsync(
                "api/beneficiary/download-import-template");

            if (response.IsSuccessStatusCode)
            {
                var fileStream = await response.Content.ReadAsStreamAsync();
                var fileName = $"ImportTemplate_{DateTime.Now:yyyy-MM-dd}.xlsx";
                using var streamRef = new DotNetStreamReference(stream: fileStream);
                await JS.InvokeVoidAsync(
                    "downloadFileFromStream", fileName, streamRef);
            }
            toast.ShowSuccess("Import template downloaded successfully.");
        }
        catch (Exception ex)
        {
            toast.ShowError($"Template download failed: {ex.Message}");
        }
        finally
        {
            isDownloadingTemplate = false;
        }
    }

    // ── File selected ─────────────────────────────────────────────────────────
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;
        successMessage = null;
        importResult = null;
        updateResult = null;
        previewResult = null;
        skipRows = new();
        _lastUsedRefSummary = null;
        excelSheetNames.Clear();
        selectedSheetName = null;
        uploadedExcelBytes = null;
        uploadedExcelFileName = null;

        if (selectedFile == null) return;

        try
        {
            isLoadingSheets = true;
            await using var uploadStream =
                selectedFile.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await uploadStream.CopyToAsync(ms);
            uploadedExcelBytes = ms.ToArray();
            uploadedExcelFileName = selectedFile.Name;

            using var content = new MultipartFormDataContent();
            content.Add(
                new ByteArrayContent(uploadedExcelBytes),
                "file", uploadedExcelFileName);

            var response = await Http.PostAsync(
                "api/beneficiary/import/sheets", content);

            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    toast.ShowError("Access denied. You do not have permission to import records.");
                    return;
                }
                throw new Exception(await response.Content.ReadAsStringAsync());
            }

            if (response.IsSuccessStatusCode)
            {
                excelSheetNames = await response.Content
                    .ReadFromJsonAsync<List<string>>() ?? new();
                if (excelSheetNames.Any())
                    selectedSheetName = excelSheetNames.First();
            }
            else
            {
                throw new Exception(
                    await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to read Excel sheets: {ex.Message}");
        }
        finally
        {
            isLoadingSheets = false;
            StateHasChanged();
        }
    }

    // ── Update existing records ───────────────────────────────────────────────
    private async Task UpdateExcelAsync()
    {
        if (uploadedExcelBytes == null ||
            string.IsNullOrWhiteSpace(selectedSheetName))
        {
            toast.ShowError("Please select a file and a worksheet first.");
            return;
        }

        isUpdating = true;
        updateResult = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(
                new ByteArrayContent(uploadedExcelBytes),
                "File", uploadedExcelFileName ?? "update.xlsx");
            content.Add(new StringContent(selectedSheetName), "SheetName");

            var response = await Http.PostAsync(
                "api/beneficiary/update-excel", content);
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                toast.ShowError("Access denied. You do not have permission to update records via Excel.");
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                updateResult = await response.Content
                    .ReadFromJsonAsync<BeneficiaryImportResultDto>();

                if (updateResult?.HasErrors == true)
                    toast.ShowError(
                        $"Update finished with {updateResult.ErrorCount} error(s).");
                else
                    toast.ShowSuccess(
                        $"Update completed. {updateResult?.ImportedCount ?? 0} record(s) updated.");
            }
            else
            {
                throw new Exception(
                    await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Update failed: {ex.Message}");
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    // ── Phase 1: Preview + duplicate detection ────────────────────────────────
    private async Task RunPreviewAsync()
    {
        // ✅ No role check — API will return 403 if unauthorized
        if (uploadedExcelBytes == null || string.IsNullOrWhiteSpace(uploadedExcelFileName))
        {
            toast.ShowError("Please select an Excel file first.");
            return;
        }
        if (string.IsNullOrWhiteSpace(selectedSheetName))
        {
            toast.ShowError("Please select a worksheet first.");
            return;
        }

        importResult = null;
        updateResult = null;
        previewResult = null;
        skipRows = new();
        _lastUsedRefSummary = null;

        try
        {
            isPreviewing = true;
            StateHasChanged();

            using var content = new MultipartFormDataContent();
            content.Add(
                new ByteArrayContent(uploadedExcelBytes),
                "File", uploadedExcelFileName);
            content.Add(new StringContent(selectedSheetName), "SheetName");

            var response = await Http.PostAsync(
                "api/beneficiary/import/preview", content);
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    toast.ShowError("Access denied. You do not have permission to import records.");
                    return;
                }
                throw new Exception(await response.Content.ReadAsStringAsync());
            }

            if (!response.IsSuccessStatusCode)
                throw new Exception(
                    await response.Content.ReadAsStringAsync());

            previewResult = await response.Content
    .ReadFromJsonAsync<BeneficiaryPreviewResultDto>();

            if (previewResult == null)
            {
                toast.ShowError("Unexpected empty response from server.");
                return;
            }

            // ── Hard errors → show inline ─────────────────────────────────
            if (previewResult.HardErrors.Any())
            {
                importResult = new BeneficiaryImportResultDto
                {
                    TotalRows = previewResult.TotalRows,
                    ValidRows = previewResult.CleanRows,
                    ErrorCount = previewResult.HardErrors.Count,
                    Errors = previewResult.HardErrors
                };
                toast.ShowError(
                    $"Validation failed. {previewResult.HardErrors.Count} error(s) found.");
                return;
            }

            // ── Soft duplicates → open review modal ───────────────────────
            if (previewResult.SoftDuplicates.Any())
            {
                skipRows = new HashSet<string>(
                    previewResult.SoftDuplicates
                        .Select(x => DupKey(x.RowNumber, x.ExistingId)));
                await duplicateModal.ShowAsync();
                return;
            }

            // ── Fully clean → import immediately ──────────────────────────
            await RunConfirmImportAsync();
        }
        catch (Exception ex)
        {
            toast.ShowError($"Preview failed: {ex.Message}");
        }
        finally
        {
            isPreviewing = false;
            StateHasChanged();
        }
    }

    // ── Phase 2: Confirm import ───────────────────────────────────────────────
    private async Task RunConfirmImportAsync()
    {
        if (uploadedExcelBytes == null ||
            string.IsNullOrWhiteSpace(uploadedExcelFileName))
        {
            toast.ShowError("File data is missing. Please re-select the file.");
            return;
        }

        // ✅ Warn if ref number not set — but never block
        bool hasRefNumber = !string.IsNullOrWhiteSpace(_importQuarter)
                         && !string.IsNullOrWhiteSpace(_importBatch)
                         && _importRefYear.HasValue;

        if (!hasRefNumber)
        {
            toast.ShowWarning(
                "Importing without a reference number. " +
                "Use Bulk Assign Ref Number in the grid to assign later.");
        }

        // ── Build skip rows set ───────────────────────────────────────────
        var rowNumbersToSkip = previewResult?.SoftDuplicates
            .GroupBy(x => x.RowNumber)
            .Where(g => g.All(c =>
                skipRows.Contains(DupKey(c.RowNumber, c.ExistingId))))
            .Select(g => g.Key)
            .ToHashSet() ?? new HashSet<int>();

        // ── Close soft duplicate modal if open ────────────────────────────
        await CloseDuplicateModal();

        try
        {
            isUploading = true;
            StateHasChanged();

            using var content = new MultipartFormDataContent();
            content.Add(
                new ByteArrayContent(uploadedExcelBytes),
                "File", uploadedExcelFileName);
            content.Add(new StringContent(selectedSheetName!), "SheetName");
            content.Add(
                new StringContent(
                    System.Text.Json.JsonSerializer.Serialize(rowNumbersToSkip)),
                "SkipRowsJson");

            // ✅ Only add ref number fields if all three are provided
            // Server accepts null/missing — nullable params in controller
            if (!string.IsNullOrWhiteSpace(_importQuarter))
                content.Add(new StringContent(_importQuarter), "Quarter");

            if (!string.IsNullOrWhiteSpace(_importBatch))
                content.Add(new StringContent(_importBatch), "Batch");

            if (_importRefYear.HasValue)
                content.Add(
                    new StringContent(_importRefYear.Value.ToString()),
                    "RefYear");

            var response = await Http.PostAsync(
                "api/beneficiary/import/confirm", content);
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                toast.ShowError("Access denied. You do not have permission to import records.");
                await CloseDuplicateModal();
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                importResult = await response.Content
                    .ReadFromJsonAsync<BeneficiaryImportResultDto>();

                if (importResult?.HasErrors == true)
                {
                    toast.ShowError(
                        $"Validation failed. {importResult.ErrorCount} error(s).");
                }
                else
                {
                    // ✅ Build ref number summary for success banner
                    _lastUsedRefSummary = hasRefNumber
                        ? $"Reference number assigned: Q{_importQuarter}B{_importBatch}" +
                          $"-{_importRefYear!.Value:D2}-#####-XIII"
                        : null;

                    toast.ShowSuccess(
                        $"Import completed. {importResult?.ImportedCount ?? 0} record(s) saved." +
                        (hasRefNumber
                            ? $" Reference: Q{_importQuarter}B{_importBatch}-{_importRefYear!.Value:D2}"
                            : " No reference number assigned."));
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Import failed: {error}");
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Import failed: {ex.Message}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    // ── Skip row helpers ──────────────────────────────────────────────────────
    private void ToggleSkip(int rowNumber, Guid existingId)
    {
        var key = DupKey(rowNumber, existingId);
        if (!skipRows.Remove(key))
            skipRows.Add(key);
        StateHasChanged();
    }

    private void SkipAll()
    {
        if (previewResult == null) return;
        foreach (var dup in previewResult.SoftDuplicates)
            skipRows.Add(DupKey(dup.RowNumber, dup.ExistingId));
        StateHasChanged();
    }

    private void ImportAll()
    {
        skipRows.Clear();
        StateHasChanged();
    }

    private async Task CloseDuplicateModal()
    {
        try { await duplicateModal.HideAsync(); }
        catch { /* modal may already be closed */ }
    }
}