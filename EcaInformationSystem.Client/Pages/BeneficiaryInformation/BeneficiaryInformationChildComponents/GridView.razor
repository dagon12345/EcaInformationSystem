    private IEnumerable<PossibleDuplicatePairDto> FilteredDuplicatePairs =>
        _duplicateSummary?.Pairs.Where(p =>
        {
            if (!string.IsNullOrWhiteSpace(_duplicateSearchTerm))
            {
                var term = _duplicateSearchTerm.Trim().ToLower();
                if (!p.Record1FullName.ToLower().Contains(term)
                    && !p.Record2FullName.ToLower().Contains(term))
                    return false;
            }
            if (!string.IsNullOrWhiteSpace(_duplicateReasonFilter))
            {
                if (!p.MatchReason.Contains(_duplicateReasonFilter, StringComparison.OrdinalIgnoreCase))
                    return false;
            }
            return true;
        })
        .OrderByDescending(p => p.MatchScore)
        ?? Enumerable.Empty<PossibleDuplicatePairDto>();

    // Resolution is stored server-side keyed by the beneficiary pair, so acting
    // on it here keeps the bell's counts in sync without needing a refetch.
    private async Task ResolveGridPairAsync(PossibleDuplicatePairDto pair)
    {
        var remarks = await JS.InvokeAsync<string?>("prompt", "Optional remarks (e.g. confirmed not a duplicate):");
        if (remarks is null) return; // user cancelled the prompt

        var ok = await State.ResolveDuplicatePairAsync(pair, remarks);
        if (ok) StateHasChanged();
    }

    private async Task UndoResolveGridPairAsync(PossibleDuplicatePairDto pair)
    {
        var ok = await State.UnresolveDuplicatePairAsync(pair);
