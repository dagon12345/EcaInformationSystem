    private async Task ExecuteBulkUpdateAsync()
    {
        try
        {
            IsBulkUpdating = true;
            var request = new
            {
                Ids = checkedIds.ToList(),
                PaymentStatus = bulkPaymentStatus,
                ModeOfPayment = bulkPaymentStatus == 2 ? bulkModeOfPayment : null,
                PaymentDate = bulkPaymentStatus == 2 ? bulkPaymentDate : null
            };
            var response = await Http.PostAsJsonAsync(
                "api/beneficiary/bulk-payment-status", request);

            await HandleApiResponseAsync(
                response,
                $"Updated {checkedIds.Count} record(s) to {GetPaymentStatusText(bulkPaymentStatus)}.",
                async () =>
