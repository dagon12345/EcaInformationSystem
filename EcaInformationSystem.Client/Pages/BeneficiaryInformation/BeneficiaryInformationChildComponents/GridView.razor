<HxModal @ref="addPaymentHistoryModal">
    <HeaderTemplate><h5 class="modal-title">Record New Payment</h5></HeaderTemplate>
    <BodyTemplate>
        <div class="row g-2">
            <div class="col-6">
                <label class="form-label small">Payroll Quarter</label>
                <select class="form-select form-select-sm" @bind="_newPayment.PayrollQuarter">
                    <option value="">-- None --</option>
                    <option value="1">Q1</option>
                    <option value="2">Q2</option>
                    <option value="3">Q3</option>
                    <option value="4">Q4</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Fiscal Year</label>
                <select class="form-select form-select-sm" @bind="_newPayment.FiscalYear">
                    <option value="">-- None --</option>
                    @foreach (var year in _availableMilestoneYears)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Payment Status</label>
                <select class="form-select form-select-sm" @bind="_newPayment.PaymentStatus">
                    <option value="0">N/A</option>
                    <option value="1">Unpaid</option>
                    <option value="2">Paid</option>
                    <option value="3">Pending</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Mode of Payment</label>
                <select class="form-select form-select-sm" @bind="_newPayment.ModeOfPayment"
                        disabled="@(_newPayment.PaymentStatus != 2)">
                    <option value="">-- Select --</option>
                    <option value="1">Cash Advance by SDO</option>
                    <option value="2">Bank Transfer</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Payment Date</label>
                <!-- ✅ Enable for both Paid AND Unpaid -->
                <input type="date" class="form-control form-control-sm" @bind="_newPayment.PaymentDate"
                       disabled="@(_newPayment.PaymentStatus != 2 && _newPayment.PaymentStatus != 1)" />
            </div>
            <div class="col-12">
                <label class="form-label small">Remarks</label>
                <textarea class="form-control form-control-sm" rows="2" @bind="_newPayment.Remarks"></textarea>
            </div>
        </div>
        @if (_newPayment.PaymentStatus == 2 &&
             (_newPayment.PayrollQuarter == null || _newPayment.FiscalYear == null))
        {
            <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Payroll Quarter and Fiscal Year are required for Paid status.
            </div>
        }
        @if (_newPayment.PaymentStatus == 1 &&
             (_newPayment.PayrollQuarter == null || _newPayment.FiscalYear == null))
        {
            <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Payroll Quarter and Fiscal Year are required for Unpaid status.
            </div>
        }
