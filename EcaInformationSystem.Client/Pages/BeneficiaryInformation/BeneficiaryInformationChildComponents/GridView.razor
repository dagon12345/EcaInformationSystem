    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => addPaymentHistoryModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="OpenAddPaymentConfirmation" Disabled="@_isSavingPaymentHistory">
            @(_isSavingPaymentHistory ? "Saving..." : "Add Record")
        </HxButton>
    </FooterTemplate>
</HxModal>

