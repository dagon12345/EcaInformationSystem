    private string confirmationTitle = "Confirm Action";
    private string confirmationMessage = string.Empty;
    private string? successMessage = string.Empty;
    private int DisplayCount => State.TotalCount;
    private string _sortColumn = string.Empty;
    private bool _sortAscending = true;

    // ── New bulk state ─────────────────────────────────────────────────────
    private string activeBulkTab = "payment"; // "payment" | "other"
    private string bulkIsEligible = string.Empty; // "true", "false", or "" = no change
    private string? bulkBatchCode; // null / "" = no change
    private bool IsBulkUpdatingOther;
    private HxModal bulkOtherUpdateModal = default!;

    // ── Open modal ────────────────────────────────────────────────────────
    private async Task OpenBulkOtherUpdateModal()
    {
        if (!checkedIds.Any()) return;
        if (string.IsNullOrWhiteSpace(bulkIsEligible) &&
            string.IsNullOrWhiteSpace(bulkBatchCode)) return;

        await bulkOtherUpdateModal.ShowAsync();
    }
    // ── Execute ───────────────────────────────────────────────────────────
    private async Task ExecuteBulkOtherUpdateAsync()
    {
        try
        {
            IsBulkUpdatingOther = true;

            // Parse eligibility — null means "don't touch"
            bool? parsedEligible = bulkIsEligible switch
            {
                "true" => true,
                "false" => false,
                _ => null
            };

            // null = don't touch; whitespace normalized to null inside service
            string? parsedBatchCode = string.IsNullOrWhiteSpace(bulkBatchCode)
                ? null
                : bulkBatchCode.Trim();

            var request = new
            {
                Ids = checkedIds.ToList(),
                IsEligible = parsedEligible,
                BatchCode = parsedBatchCode
            };

            var response = await Http.PostAsJsonAsync(
                "api/beneficiary/bulk-eligibility-batchcode", request);

            if (response.IsSuccessStatusCode)
            {
                var parts = new List<string>();
                if (parsedEligible.HasValue)
                    parts.Add($"eligibility → {(parsedEligible.Value ? "Eligible" : "Ineligible")}");
                if (parsedBatchCode != null)
                    parts.Add($"batch code → '{parsedBatchCode}'");

                toast.ShowSuccess(
                    $"Updated {checkedIds.Count} record(s): {string.Join(", ", parts)}.");

                // Reset fields
                bulkIsEligible = string.Empty;
                bulkBatchCode = null;
                ClearSelection();

                await bulkOtherUpdateModal.HideAsync();

                State.Invalidate();
                await State.LoadAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Bulk update failed: {error}");
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"An error occurred: {ex.Message}");
        }
        finally
        {
            IsBulkUpdatingOther = false;
        }
    }
    private async Task SortBy(string column)
    {
        //Guard - do nothing if no records are currently displayed (e.g. after filtering to zero results)
        if (!State.Beneficiaries.Any())
            return;

        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }

        //Push sort into the shared filter and reload from server
        State.Filter.SortColumn = _sortColumn;
        State.Filter.SortAscending = _sortAscending;
        State.Filter.PageNumber = 1; // reset to page 1 on sort change.
        await State.LoadAsync();
    }

    private string GetSortIcon(string column)
    {
        if (_sortColumn != column)
            return "bi bi-arrow-down-up text-muted";
        return _sortAscending ? "bi bi-sort-up" : "bi bi-sort-down";
    }
    // Server handles all filtering — State.Beneficiaries is already the filtered+paged result.
    // The column search box triggers a server-side reload (see OnFullNameFilterInput below).
    private IEnumerable<BeneficiaryInformationDto> FilteredBeneficiaries => State.Beneficiaries;

    private async Task OpenDetailsPanel(BeneficiaryInformationDto item)
    {
        selectedDetails = item;
        StateHasChanged();
        await detailsOffcanvas.ShowAsync();
    }
    protected override async void OnInitialized()
    {
        State.OnChange += StateHasChanged;

        // ✅ Only reload if there was an active filter before navigation
        // Don't auto-load on fresh visit or after clear
        if (State.HasActiveFilter && State.IsStale())
        {
            await State.LoadAsync();
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
    private async Task OpenPayrollModal()
    {
        if (!checkedIds.Any())
        {
            toast.ShowError("No records selected. Please check at least one record first.");
            return;
        }

        try
        {
            pendingAction = "generate-payroll";
            IsGeneratingPayroll = true;
            StateHasChanged();
            await _payrollModal.ShowAsync(checkedIds.ToList());
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to open payroll modal: {ex.Message}");
        }
        finally
        {
            IsGeneratingPayroll = false;
        }
    }
    private async Task ConfirmActionAsync()
    {
        try
        {
            IsSaving = true;
            errorMessage = null;
            successMessage = null;

            await confirmModal.HideAsync();

            if (string.IsNullOrWhiteSpace(pendingAction))
            {
                errorMessage = "No action selected.";
                return;
            }

            switch (pendingAction)
            {
                case "delete":
                    await SoftDeleteBeneficiaryAsync();
                    break;

                case "navigate":
                    //Routing here
                    Navigation.NavigateTo($"/beneficiary-edit/{selectedDetails!.Id}");
                    break;

                case "generate-payroll": // ← add if you wire payroll confirm here
                    await OpenPayrollModal();
                    break;

                default:
                    errorMessage = "Unknown action.";
                    break;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while processing. {ex.Message}";
        }
        finally
        {
            IsSaving = false;
            pendingAction = string.Empty;
            selectedDeleteItem = null;
        }
    }
    private async Task SoftDeleteBeneficiaryAsync()
    {
        if (selectedDeleteItem is null)
        {
            toast.ShowError("Failed to delete Grantee record. Item not found.");
            return;
        }

        try
        {
            // 1. Call the DELETE API directly using the Guid in the route
            var response = await Http.DeleteAsync($"api/beneficiary/soft-delete/{selectedDeleteItem.Id}");

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess($"Grantee '{selectedDeleteItem.FirstName} {selectedDeleteItem.LastName}' was deleted successfully.");

                // 2. Refresh the grid (via your State Service or local load method)
                // ✅ Reload if never loaded or marked stale by edit/delete/import
                if (!State.Beneficiaries.Any() || State.IsStale())
                {
                    State.Invalidate();
                    await State.LoadAsync();
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Failed to delete: {error}");
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"An error occurred: {ex.Message}");
        }
    }

    private async Task CloseConfirmationModal()
    {
        await confirmModal.HideAsync();
    }
    private async Task OpenLogModal(BeneficiaryInformationDto item)
    {
        try
        {
            IsLogsLoading = true;
            logs.Clear();
            selectedBeneficiaryName = GetFullName(item);
            await logModal.ShowAsync();
            await LoadLogsAsync(item.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load logs. {ex.Message}";
        }
        finally
        {
            IsLogsLoading = false;
            StateHasChanged();
        }
    }
    private async Task CloseLogModal()
    {
        await logModal.HideAsync();
    }
    //Edit confirmation modal
    private async Task OpenEditConfirmationModal(BeneficiaryInformationDto item, Guid Id)
    {
        ClearMessages();
        pendingAction = "navigate";
        confirmationTitle = "Proceed to Editing";
        confirmationMessage = $"You are going to edit Grantee '{item.FirstName} {item.LastName}'";
        await confirmModal.ShowAsync();

    }
    //Delete confirmation modal
    private async Task OpenDeleteConfirmationModal(BeneficiaryInformationDto item)
    {
        ClearMessages();

        selectedDeleteItem = item;
        pendingAction = "delete";
        confirmationTitle = "Confirm Delete";
        confirmationMessage = $"Are you sure you want to delete Grantee '{item.FirstName} {item.LastName}'?";

        await confirmModal.ShowAsync();
    }
    private async Task LoadLogsAsync(Guid beneficiaryId)
    {
        try
        {
            // Call the GET API using the route parameter {Id}
            var result = await Http.GetFromJsonAsync<List<LogsLookupDto>>($"api/beneficiary/log-summary/{beneficiaryId}");

            // If the API returns the data in the correct format,
            // you can assign it directly.
            logs = result ?? new List<LogsLookupDto>();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Failed to load logs: {ex.Message}");
            logs = new List<LogsLookupDto>();
        }
    }

    private void ClearMessages()
    {
        successMessage = null;
        errorMessage = null;
    }
    // ✅ FIX — use State.TotalPages
    private async Task GoToNextPageAsync()
    {
        if (State.Filter.PageNumber >= State.TotalPages)
            return;

        State.Filter.PageNumber++;
        await State.LoadAsync();
    }

    private async Task GoToPreviousPageAsync()
    {
        if (State.Filter.PageNumber <= 1) return;
        State.Filter.PageNumber--;
        await State.LoadAsync(); // ✅
    }

    private async Task OnPageSizeChangedAsync()
    {
        State.Filter.PageNumber = 1;
        await State.LoadAsync();
    }

    private int? GetAge(DateTime? birthDate)
    {
        if (birthDate == null)
            return null;

        var today = DateTime.Today;
        var age = today.Year - birthDate.Value.Year;

        if (birthDate.Value.Date > today.AddYears(-age))
            age--;

        return age;
    }
    private string GetFindingStatusText(int? status) => status switch
    {
        0 => "N/A",
        1 => "Solved",
        2 => "Unresolved",
        _ => "N/A"        // null = no finding record yet
    };

    private string GetFindingBadgeClass(int? status) => status switch
    {
        0 => "no-g", // grey — N/A
        1 => "yes-g", // green — Solved
        2 => "unpaid", // red — Unresolved
        _ => "no-g"      // grey  — not yet set
    };
    private string GetAgeBadgeClass(DateTime birthDate)
    {
        var age = GetAge(birthDate);
        if (age == null) return "unpaid"; // red

        int currentYear = DateTime.Today.Year;
        int[] milestones = new[] { 80, 85, 90, 95, 100 };

        // ✅ Find the nearest milestone year for this person (>= 2024)
        int nearestMilestoneYear = 0;
        int nearestMilestoneAge = 0;

        // Check already-reached first
        foreach (var m in milestones)
        {
            int my = birthDate.Year + m;
            if (my >= 2024 && my <= currentYear)
            {
                nearestMilestoneYear = my;
                nearestMilestoneAge = m;
                break;
            }
        }

        // If not yet reached, find next upcoming
        if (nearestMilestoneYear == 0)
        {
            foreach (var m in milestones)
            {
                int my = birthDate.Year + m;
                if (my >= 2024 && my > currentYear)
                {
                    nearestMilestoneYear = my;
                    nearestMilestoneAge = m;
                    break;
                }
            }
        }

        // ✅ Truly no program milestone (born before 1924)
        if (nearestMilestoneYear == 0)
            return "unpaid"; // red — pre-program

        // ✅ Not yet at their milestone age → red (e.g. age 81, 82, 83, 84 before hitting 85)
        if (age.Value < nearestMilestoneAge)
            return "unpaid"; // red — hasn't reached milestone yet

        // ✅ Exactly at milestone age — check the active window
        int windowStart = Math.Max(2024, currentYear - 2);
        if (nearestMilestoneYear >= windowStart && nearestMilestoneYear <= currentYear)
            return "yes-g"; // green — active milestone window

        if (nearestMilestoneYear > currentYear)
            return "pending"; // grey — future milestone

        return "no-g"; // grey — past window
    }

    private string GetPaymentBadgeClass(int status) => status switch
    {
        1 => "unpaid", // red
        2 => "paid", // green
        3 => "pending", // yellow
        _ => "no-g"       // grey
    };
    private string GetFullName(BeneficiaryInformationDto item)
    {
        var middle = string.IsNullOrWhiteSpace(item.MiddleName) ? "" : $" {item.MiddleName}";
        var extension = string.IsNullOrWhiteSpace(item.Extension) ? "" : $" {item.Extension}";
        return $"{item.LastName}, {item.FirstName}{middle}{extension}";
    }
    private void ToggleCheck(Guid id)
    {
        if (checkedIds.Contains(id)) checkedIds.Remove(id);
        else checkedIds.Add(id);
    }
    private bool AreAllChecked()
    {
        var check = State.Beneficiaries.Any() && State.Beneficiaries.All(x => checkedIds.Contains(x.Id));
        return check;
    }
    private async Task OnFullNameFilterInput(ChangeEventArgs e)
    {
        fullNameFilter = e.Value?.ToString();

        // Cancel any in-flight debounce
        _nameCts?.Cancel();
        _nameCts?.Dispose();
        _nameCts = new CancellationTokenSource();

        try
        {
            // Wait 400 ms — if another keystroke arrives it cancels this one
            await Task.Delay(400, _nameCts.Token);

            // Push the value into the shared filter and reload from the server.
            // This searches ALL pages, not just the current 10 rows.
            State.Filter.FullName = string.IsNullOrWhiteSpace(fullNameFilter) ? null : fullNameFilter.Trim();
            State.Filter.PageNumber = 1;
            await State.LoadAsync();
        }
        catch (TaskCanceledException) { /* debounced away — ignore */ }
    }
    private async Task OpenBulkUpdateModal()
    {
        if (bulkPaymentStatus == null || !checkedIds.Any() || bulkPaymentStatus == 2 && bulkPaymentDate == null) return;
        await bulkUpdateModal.ShowAsync();
    }
    // ✅ AFTER — selects only visible filtered rows
    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)e.Value!)
            foreach (var item in FilteredBeneficiaries) // ✅ what user sees
                checkedIds.Add(item.Id);
        else
            checkedIds.Clear();
    }
    private void ClearSelection()
    {
        checkedIds.Clear();
        bulkPaymentStatus = null;
        bulkPaymentDate = null;
    }
    private void GoToDashboardSummary()
    {
        Navigation.NavigateTo("/");
    }

    private async Task ExecuteBulkUpdateAsync()
    {
        try
        {
            IsBulkUpdating = true;

            // 1. Create the request object matching the Controller's DTO
            var request = new
            {
                Ids = checkedIds.ToList(),
                PaymentStatus = bulkPaymentStatus,
                PaymentDate = bulkPaymentStatus == 2 ? bulkPaymentDate : null // ✅ 2 = Paid
            };

            // 2. Call the API directly using HttpClient
            var response = await Http.PostAsJsonAsync("api/beneficiary/bulk-payment-status", request);

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess(
                    $"Successfully updated {checkedIds.Count} record(s) to {GetPaymentStatusText(bulkPaymentStatus)}.");

                ClearSelection();
                if (!State.Beneficiaries.Any() || State.IsStale())
                {
                    State.Invalidate();
                    await State.LoadAsync();
                }
                if (bulkUpdateModal != null)
                    await bulkUpdateModal.HideAsync();

            }
            else
            {
                // Try to extract the error message from the API response
                var errorMsg = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Bulk update failed: {errorMsg}");
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"An error occurred: {ex.Message}");
        }
        finally
        {
            IsBulkUpdating = false;
        }
    }


    // ✅ FIX
    private async Task ExportExcel()
    {
        if (!checkedIds.Any())
        {
            toast.ShowError("No records to export. Please check at least one record.");
            return;
        }


        try
        {
            IsExporting = true;
            StateHasChanged(); // ← make spinner appear immediately
            var request = new
            {
                Ids = checkedIds.ToList()
            };

            var response = await Http.PostAsJsonAsync("api/beneficiary/export", request);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Export failed: {error}");
                return;
            }

            var exportBytes = await response.Content.ReadAsByteArrayAsync();
            if (exportBytes == null || exportBytes.Length == 0)
            {
                toast.ShowError("No data returned from export.");
                return;
            }

            var base64 = Convert.ToBase64String(exportBytes);
            await JS.InvokeVoidAsync("downloadFile", $"Beneficiaries_{DateTime.Now:yyyy-MM-dd}.xlsx", base64);
        }
        catch (Exception ex)
        {
            toast.ShowError($"Export failed: {ex.Message}");
        }
        finally
        {
            IsExporting = false;
        }
    }
    private async Task GeneratePayrollAsync()
    {
        if (!checkedIds.Any())
        {
            toast.ShowError("No records selected. Please check at least one record.");
            return;
        }

        try
        {
            IsGeneratingPayroll = true;
            StateHasChanged();

            var request = new
            {
                Ids = checkedIds.ToList()
            };

            var response = await Http.PostAsJsonAsync("api/payroll/generate-payroll", request);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Payroll generation failed: {error}");
                return;
            }

            var fileBytes = await response.Content.ReadAsByteArrayAsync();
            if (fileBytes == null || fileBytes.Length == 0)
            {
                toast.ShowError("No data returned from payroll generation.");
                return;
            }

            var base64 = Convert.ToBase64String(fileBytes);
            var fileName = $"CashGiftPayroll_{DateTime.Now:yyyy-MM-dd}.xlsx";
            await JS.InvokeVoidAsync("downloadFile", fileName, base64);

            toast.ShowSuccess($"Payroll generated for {checkedIds.Count} record(s).");
        }
        catch (Exception ex)
        {
            toast.ShowError($"Payroll generation failed: {ex.Message}");
        }
        finally
        {
            IsGeneratingPayroll = false;
        }
    }

