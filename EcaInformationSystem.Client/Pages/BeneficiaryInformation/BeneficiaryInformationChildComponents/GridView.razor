    private async Task ExecuteBulkPayrollQuarterAsync()
    {
        try
        {
            IsBulkUpdatingPayrollQuarter = true;
            var request = new
            {
                Ids = checkedIds.ToList(),
                PayrollQuarter = _clearingPayrollQuarter ? (int?)null : bulkPayrollQuarterOnly
            };
            var response = await Http.PostAsJsonAsync("api/beneficiary/bulk-payroll-quarter", request);

            await HandleApiResponseAsync(
                response,
                _clearingPayrollQuarter
                    ? $"Cleared Payroll Quarter for {checkedIds.Count} record(s)."
                    : $"Set Payroll Quarter to Q{bulkPayrollQuarterOnly} for {checkedIds.Count} record(s).",
                async () =>
                {
                    bulkPayrollQuarterOnly = null;
                    _clearingPayrollQuarter = false;
                    ClearSelection();
                    await bulkPayrollQuarterModal.HideAsync();
                    State.Invalidate();
                    await State.LoadAsync();
                });
        }
        catch (Exception ex) { toast.ShowError($"An error occurred: {ex.Message}"); }
        finally { IsBulkUpdatingPayrollQuarter = false; }
    }

