    private async Task GoToNextPageAsync()
    {
        if (State.Filter.PageNumber >= State.TotalPages) return;
        State.Filter.PageNumber++;
        await State.LoadAsync();
    }

    private async Task GoToPreviousPageAsync()
    {
        if (State.Filter.PageNumber <= 1) return;
        State.Filter.PageNumber--;
        await State.LoadAsync();
    }

    // Backs the "Go to page" jump box next to Prev/Next — lets someone land
    // directly on e.g. page 47 instead of clicking Next 46 times. Out-of-range
    // input is clamped rather than rejected, since typing "999" on a 50-page
    // result set almost always means "take me to the last page".
    private int? _jumpToPage;

    private async Task GoToPageAsync()
    {
        if (_jumpToPage is not int target) return;

        var clamped = Math.Clamp(target, 1, Math.Max(1, State.TotalPages));
        _jumpToPage = null;

        if (clamped == State.Filter.PageNumber) return;

        State.Filter.PageNumber = clamped;
        await State.LoadAsync();
    }

    private async Task GoToSpecificPageAsync(int page)
    {
        if (page == State.Filter.PageNumber || page < 1 || page > State.TotalPages) return;
        State.Filter.PageNumber = page;
        await State.LoadAsync();
    }

    // Windowed page-number strip below Prev/Next — always shows page 1 and
    // the last page, plus a couple pages either side of the current one, with
    // null standing in for an "…" gap. A flat 1..TotalPages loop would be
    // unusable once there are hundreds/thousands of pages (this grid's page
    // size can go as low as 10 on a dataset with thousands of records).
    private List<int?> GetPageNumbersToShow()
    {
        var total = State.TotalPages;
        var current = State.Filter.PageNumber;
        var result = new List<int?>();

        if (total <= 7)
        {
            for (var p = 1; p <= total; p++) result.Add(p);
            return result;
        }

        result.Add(1);
        var start = Math.Max(2, current - 1);
        var end = Math.Min(total - 1, current + 1);

        if (start > 2) result.Add(null);
        for (var p = start; p <= end; p++) result.Add(p);
        if (end < total - 1) result.Add(null);

        result.Add(total);
        return result;
    }

    private async Task OnPageSizeChangedAsync()
    {
        State.Filter.PageNumber = 1;
        await State.LoadAsync();
    }

    private int? GetAge(DateTime? birthDate)
    {
        if (birthDate == null) return null;
        var today = DateTime.Today;
        var age = today.Year - birthDate.Value.Year;
        if (birthDate.Value.Date > today.AddYears(-age)) age--;
        return age;
    }

