    // ✅ Add this helper — called wherever an HTTP response comes back
    private async Task HandleApiResponseAsync(
        HttpResponseMessage response, string successMessage, Func<Task>? onSuccess = null)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            toast.ShowError("Access denied. You do not have permission to perform this action.");
            return;
        }
        if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            toast.ShowError(await response.Content.ReadAsStringAsync());
            State.Invalidate();
            await State.LoadAsync();
            return;
        }
        if (response.IsSuccessStatusCode)
        {
            toast.ShowSuccess(successMessage);
            if (onSuccess != null) await onSuccess();

        // ✅ ADDED — note that since this action ALREADY calls
        // State.LoadAsync() inside most onSuccess callbacks, the grid on
        // THIS page is already fresh. The stale flag exists for the case
        // where the user later navigates AWAY and back, or where some
        // OTHER open tab/session's grid is now stale. If you only ever
        // care about "this same page, this same session," this flag is
        // arguably redundant with the existing State.LoadAsync() calls —
        // see the note below before wiring this in.
        State.MarkGridDataStale();


            return;
        }
        toast.ShowError(await response.Content.ReadAsStringAsync());
    }
