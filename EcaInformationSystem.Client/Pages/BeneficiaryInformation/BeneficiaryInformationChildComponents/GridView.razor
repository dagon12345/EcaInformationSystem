    private string GetAgeBadgeClass(DateTime birthDate)
    {
        var age = GetAge(birthDate);
        if (age == null) return "unpaid";
        int currentYear = DateTime.Today.Year;
        int[] milestones = new[] { 80, 85, 90, 95, 100 };
        int nearestMilestoneYear = 0, nearestMilestoneAge = 0;
        foreach (var m in milestones)
        {
            int my = birthDate.Year + m;
            if (my >= 2024 && my <= currentYear) { nearestMilestoneYear = my; nearestMilestoneAge = m; break; }
        }
        if (nearestMilestoneYear == 0)
        {
            foreach (var m in milestones)
            {
                int my = birthDate.Year + m;
                if (my >= 2024 && my > currentYear) { nearestMilestoneYear = my; nearestMilestoneAge = m; break; }
            }
        }
        if (nearestMilestoneYear == 0) return "unpaid";
        if (age.Value < nearestMilestoneAge) return "unpaid";
        int windowStart = Math.Max(2024, currentYear - 2);
        if (nearestMilestoneYear >= windowStart && nearestMilestoneYear <= currentYear) return "yes-g";
        if (nearestMilestoneYear > currentYear) return "pending";
        return "no-g";
    }

