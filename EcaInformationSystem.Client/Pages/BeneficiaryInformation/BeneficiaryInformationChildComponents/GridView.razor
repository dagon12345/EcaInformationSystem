            </p>
        }
        @if (bulkCoStatus == "2" && bulkCoDateApproved.HasValue)
        {
            <p class="mb-0">
                CO Date Approved:
                <strong>@bulkCoDateApproved.Value.ToString("MMMM dd, yyyy")</strong>
            </p>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => bulkCoStatusModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="ExecuteBulkCoStatusAsync" Disabled="@IsBulkUpdatingCoStatus">
            @if (IsBulkUpdatingCoStatus)
            {
                <span>Updating...</span>
            }
            else
            {

                <span>Yes, Update</span>
            }
        </HxButton>
    </FooterTemplate>
</HxModal>

<HxModal @ref="replaceModal">
    <HeaderTemplate>
        <h5 class="modal-title">Replace Payment Record</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-2">
            <strong>@_replaceOutgoingLabel</strong> will be marked
            <span class="tbl-badge no-g">Replaced</span> and handed over to a payment record you select below.
        </p>
        <div class="mb-2">
            <label class="ff-label">Step 1 — Search Replacement Grantee</label>
            <input class="form-control form-control-sm" placeholder="Type a name or batch code..."
                   value="@_replaceSearchTerm" @oninput="OnReplaceSearchInput" />
        </div>
        @if (_isSearchingReplacement)
        {
            <div class="text-center py-2">
                <span class="spinner-border spinner-border-sm text-primary"></span>
                <span class="ms-2 text-muted small">Searching...</span>
            </div>
        }
        else if (_replacementCandidates.Any())
        {
            <div class="list-group mb-2" style="max-height:220px; overflow-y:auto;">
                @foreach (var candidate in _replacementCandidates)
                {
                    <button type="button"
                            class="list-group-item list-group-item-action @(_selectedReplacementBeneficiaryId == candidate.Id ? "active" : "")"
                            @onclick="() => SelectReplacementBeneficiaryAsync(candidate)">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>@candidate.FullName</span>
                            @if (!string.IsNullOrWhiteSpace(candidate.BatchCode))
                            {
                                <small class="text-muted">@candidate.BatchCode</small>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(candidate.MunicipalityName))
                        {
                            <small class="text-muted">@candidate.MunicipalityName</small>
                        }
                    </button>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_replaceSearchTerm))
        {
            <p class="text-muted small">No matching grantees found.</p>
        }

        @if (_selectedReplacementBeneficiaryId.HasValue)
        {
            <div class="mb-2">
                <label class="ff-label">Step 2 — Select their Payment Record</label>
                @if (_isLoadingIncomingHistory)
                {
                    <div class="text-center py-2">
                        <span class="spinner-border spinner-border-sm text-primary"></span>
                        <span class="ms-2 text-muted small">Loading payment history...</span>
                    </div>
                }
                else if (!_incomingPaymentHistory.Any())
                {
                    <p class="text-muted small">This grantee has no payment records yet.</p>
                }
                else
                {
                    <div class="list-group mb-2" style="max-height:220px; overflow-y:auto;">
                        @foreach (var candidateEntry in _incomingPaymentHistory)
                        {
                            var alreadyLinked = candidateEntry.ReplacementStatus is 1 or 2;
                            <button type="button" disabled="@alreadyLinked"
                                    class="list-group-item list-group-item-action @(_selectedIncomingHistoryId == candidateEntry.Id ? "active" : "")"
                                    @onclick="() => _selectedIncomingHistoryId = candidateEntry.Id">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>@PeriodLabel(candidateEntry.PayrollQuarter, candidateEntry.FiscalYear)</span>
                                    <span class="tbl-badge @GetPaymentBadgeClass(candidateEntry.PaymentStatus)">
                                        @GetPaymentStatusText(candidateEntry.PaymentStatus)
                                    </span>
                                </div>
                                @if (alreadyLinked)
                                {
                                    <small class="text-muted">Already has a Replacement Status — pick another entry.</small>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }

        <div class="mb-2">
            <label class="ff-label">Replacement Date</label>
            <input type="date" class="form-control form-control-sm" @bind="_replacementDate" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Remarks (optional)</label>
            <textarea class="form-control form-control-sm" rows="2" @bind="_replacementRemarks"></textarea>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => replaceModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="ExecuteReplaceAsync"
                  Disabled="@(_selectedIncomingHistoryId == null || IsReplacing)">
            @if (IsReplacing)
            {
                <span>Replacing...</span>
            }
            else
            {
                <span>Confirm Replacement</span>
            }
        </HxButton>
    </FooterTemplate>
</HxModal>

<HxModal @ref="undoReplacementModal">
    <HeaderTemplate>
        <h5 class="modal-title">Undo Replacement Status</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>
            Clear the Replacement Status for the <strong>@_undoReplacementLabel</strong> payment record
            (and its linked record)? Both will return to Not Replaced.
        </p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => undoReplacementModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Danger" @onclick="ExecuteUndoReplacementAsync" Disabled="@IsReplacing">
            @if (IsReplacing)
            {
                <span>Undoing...</span>
            }
            else
            {
                <span>Yes, Undo</span>
            }
        </HxButton>
    </FooterTemplate>
</HxModal>

<HxOffcanvas @ref="detailsOffcanvas" Size="OffcanvasSize.Large">
<HeaderTemplate>
    <div class="details-header">
        <div class="details-header-identity">
            <div class="details-header-avatar">
                @GetInitials(selectedDetails?.FirstName, selectedDetails?.LastName)
            </div>
            <div class="details-header-text">
                <h5 class="offcanvas-title mb-0 text-uppercase">
                    @selectedDetails?.LastName, @selectedDetails?.FirstName
                </h5>
                <div class="details-header-meta">
                    @if (!string.IsNullOrWhiteSpace(selectedDetails?.RegionName))
                    {
                        <span class="details-header-badge">
                            <i class="bi bi-geo-alt-fill"></i>@selectedDetails.RegionName
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedDetails?.BatchCode))
                    {
                        <span class="details-header-badge">
                            <i class="bi bi-upc-scan"></i>Batch @selectedDetails.BatchCode
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="dropdown no-print print-forms-dropdown">
            <button type="button" class="btn btn-primary btn-sm dropdown-toggle details-header-action" data-bs-toggle="dropdown"
                    aria-expanded="false" title="View & print NCSC forms for this beneficiary">
                <i class="bi bi-printer-fill me-1"></i>Print Forms
            </button>
            <ul class="dropdown-menu dropdown-menu-end print-forms-menu">
                <li>
                    <button type="button" class="dropdown-item print-forms-item" @onclick="() => _annexBModal.ShowAsync()">
                        <i class="bi bi-file-earmark-text print-forms-item-icon"></i>
                        <span class="print-forms-item-text">
                            <span class="print-forms-item-title">Annex B</span>
                            <span class="print-forms-item-sub">Validation Form</span>
                        </span>
                    </button>
                </li>
                <li>
                    <button type="button" class="dropdown-item print-forms-item" @onclick="() => _livenessModal.ShowAsync()">
                        <i class="bi bi-person-check print-forms-item-icon"></i>
                        <span class="print-forms-item-text">
                            <span class="print-forms-item-title">Liveness &amp; Transaction Form</span>
                            <span class="print-forms-item-sub">Current form</span>
                        </span>
                    </button>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <button type="button" class="dropdown-item print-forms-item" @onclick="() => _annexMModal.ShowAsync()">
                        <i class="bi bi-clipboard2-check print-forms-item-icon"></i>
                        <span class="print-forms-item-text">
                            <span class="print-forms-item-title">Annex M</span>
                            <span class="print-forms-item-sub">Liveness &amp; Confirmation of Transaction Account (old form)</span>
                        </span>
                    </button>
                </li>
                <li>
                    <button type="button" class="dropdown-item print-forms-item" @onclick="() => _annexNModal.ShowAsync()">
                        <i class="bi bi-wallet2 print-forms-item-icon"></i>
                        <span class="print-forms-item-text">
                            <span class="print-forms-item-title">Annex N</span>
                            <span class="print-forms-item-sub">Transaction Account Form (old form)</span>
                        </span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</HeaderTemplate>
<BodyTemplate>
    @if (selectedDetails is not null)
    {
      <AnnexAPrintDocument Beneficiary="@selectedDetails" />

      <div class="system-fields-wrapper mb-3 no-print">
            <div class="system-fields-header">
                <i class="bi bi-gear-fill"></i> Internal / System Fields
            </div>
<div class="system-fields-body">
<h6 id="payment-history-anchor" class="text-primary fw-bold border-bottom pb-1 mb-3 d-flex align-items-center justify-content-between">
    <span><i class="bi bi-calendar me-1"></i>Date Applied /Endorsed</span>
</h6>
<div class="row g-2 mb-4">
    <div class="col-6">
            <div class="annexa-grid cols-2 mt-2">
               <div class="annexa-field">
                  <small class="text-muted d-block">Date Applied</small>
                  <span>@(selectedDetails.DateApplied?.ToString("MMMM dd, yyyy") ?? "—")</span>
            </div>
            <div class="annexa-field">
                <small class="text-muted d-block">Date Endorsed</small>
                <span>@(selectedDetails.DateEndorsed?.ToString("MMMM dd, yyyy") ?? "—")</span>
            </div>
         </div>
    </div>
</div>
<h6 class="text-primary fw-bold border-bottom pb-1 mb-3 d-flex align-items-center justify-content-between">
    <span><i class="bi bi-person-check-fill me-1"></i>Liveness Verification &amp; EFT Readiness</span>
</h6>
<div class="row g-2 mb-4">
    <div class="col-6">
        <small class="text-muted d-block">Liveness Verified?</small>
        <span class="tbl-badge @(selectedDetails.IsLivenessVerified == true ? "yes-g" : selectedDetails.IsLivenessVerified == false ? "no-g" : "pending")">
            @(selectedDetails.IsLivenessVerified switch
            {
                true => "Verified",
                false => "Not Verified",
                null => "Not Yet Checked"
            })
        </span>
    </div>
    <div class="col-6">
        <small class="text-muted d-block">Date of Liveness</small>
        <span>@(selectedDetails.DateOfLiveness?.ToString("MMMM dd, yyyy") ?? "—")</span>
    </div>
    <div class="col-6">
        <small class="text-muted d-block">Ready for Electronic Fund Transfer?</small>
        <span class="tbl-badge @(selectedDetails.IsReadyForEft == true ? "yes-g" : selectedDetails.IsReadyForEft == false ? "no-g" : "pending")">
            @(selectedDetails.IsReadyForEft switch
            {
                true => "Ready",
                false => "Not Ready",
                null => "Not Yet Checked"
            })
        </span>
    </div>
</div>

 <h6 id="payment-history-anchor" class="text-primary fw-bold border-bottom pb-1 mb-3 d-flex align-items-center justify-content-between">
    <span><i class="bi bi-clock-history me-1"></i>Payment History</span>
    @if (_isAdmin)
    {
        <button class="btn btn-sm btn-primary" @onclick="() => OpenAddPaymentHistoryModal(selectedDetails!.Id)">
            <i class="bi bi-plus-circle me-1"></i>Record Payment
        </button>
    }
</h6>

@* ── Milestone cash-gift payroll — a separate disbursement from the
     quarterly payroll above, so it's not tied to any single payment
     history entry; shown once for this beneficiary's own milestone year. ── *@
@if (selectedDetails?.MilestoneYear > 0)
{
    if (_milestonePayrollDoc != null)
    {
        <button type="button" class="payment-payroll-pill payment-payroll-pill--active mb-3"
                title="View the milestone cash-gift payroll document for @selectedDetails.MilestoneYear"
                disabled="@(_payrollPreviewLoadingId == _milestonePayrollDoc.Id)"
                @onclick="() => PreviewPayrollAsync(_milestonePayrollDoc)">
            @if (_payrollPreviewLoadingId == _milestonePayrollDoc.Id)
            {
                <span class="spinner-border spinner-border-sm"></span>
                <span>Opening...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-pdf-fill"></i>
                <span>View Milestone @selectedDetails.MilestoneYear Payroll Document</span>
            }
        </button>
    }
    else
    {
        <div class="payment-payroll-pill payment-payroll-pill--none mb-3"
             title="No milestone payroll document has been linked for @selectedDetails.MilestoneYear yet — an admin can link one from Forms Gateway.">
            <i class="bi bi-file-earmark-excel"></i>
            <span>No Milestone @selectedDetails.MilestoneYear Payroll Document Linked</span>
        </div>
    }
}

@if (isLoadingPaymentHistory)
{
    <div class="text-center py-3">
        <span class="spinner-border spinner-border-sm text-primary"></span>
        <span class="ms-2 text-muted small">Loading payment history...</span>
    </div>
}
else if (!paymentHistory.Any())
{
    <div class="alert alert-secondary py-2 px-3 small mb-4">
        <i class="bi bi-info-circle me-1"></i>No payment records yet for this beneficiary.
    </div>
}
else
{
    <div class="payment-timeline mb-4">
        @foreach (var entry in paymentHistory)
        {
            <div class="payment-timeline-item @(entry.IsCurrent ? "payment-timeline-item--current" : "")">
                <div class="payment-timeline-marker @GetPaymentBadgeClass(entry.PaymentStatus)"></div>
                <div class="payment-timeline-content">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="tbl-badge @GetPaymentBadgeClass(entry.PaymentStatus)">
                                @GetPaymentStatusText(entry.PaymentStatus)
                            </span>
                            @if (entry.IsCurrent)
                            {
                                <span class="badge bg-primary ms-1" style="font-size:9px;">CURRENT</span>
                            }
                            @if (entry.DateModified.HasValue)
                            {
                                <span class="badge bg-warning text-dark ms-1" style="font-size:9px;">CORRECTED</span>
                            }
                        </div>
                        <small class="text-muted">
                            @entry.DateCreated.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
                        </small>
                    </div>

                    <div class="row g-1 mt-1" style="font-size:12px;">
                        @if (entry.PayrollQuarter.HasValue || entry.FiscalYear.HasValue)
                        {
                            <div class="col-6">
                                <span class="text-muted">Period:</span>
                                @(entry.PayrollQuarter.HasValue ? $"Q{entry.PayrollQuarter}" : "—")
                                @(entry.FiscalYear?.ToString() ?? "")
                            </div>
                        }
                        @if (entry.PaymentDate.HasValue)
                        {
                            <div class="col-6">
                                <span class="text-muted">@GetPaymentDateLabel(entry.PaymentStatus)</span>
                                @entry.PaymentDate.Value.ToString("MMM dd, yyyy")
                            </div>
                        }
                        @if (entry.PaymentStatus == 2)
                        {
                            <div class="col-6">
                                <span class="text-muted">Mode:</span>
                                @GetModeOfPaymentText(entry.ModeOfPayment)
                            </div>
                        }
                        <div class="col-12 text-muted" style="font-size:10px;">
                            Recorded by @entry.CreatedBy
                            @if (entry.DateModified.HasValue)
                            {
                                <span>· Corrected by @entry.ModifiedBy on @entry.DateModified.Value.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            }
                        </div>
                    </div>

                    @* ── Payroll document indicator — a clearly visible pill instead of a
                         tiny link buried in the period text, so it's obvious at a glance
                         whether a payroll attachment is actually available for this entry. ── *@
                    @if (entry.PayrollQuarter.HasValue && entry.FiscalYear.HasValue)
                    {
                        if (_payrollLinksByHistoryId.TryGetValue(entry.Id, out var payrollDoc) && payrollDoc != null)
                        {
                            <button type="button" class="payment-payroll-pill payment-payroll-pill--active mt-2"
                                    title="View the payroll document for this period"
                                    disabled="@(_payrollPreviewLoadingId == payrollDoc.Id)"
                                    @onclick="() => PreviewPayrollAsync(payrollDoc)">
                                @if (_payrollPreviewLoadingId == payrollDoc.Id)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>Opening...</span>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-pdf-fill"></i>
                                    <span>View Payroll Document</span>
                                }
                            </button>
                        }
                        else
                        {
                            <div class="payment-payroll-pill payment-payroll-pill--none mt-2"
                                 title="No payroll document has been linked for this period yet — an admin can link one from Forms Gateway.">
                                <i class="bi bi-file-earmark-excel"></i>
                                <span>No Payroll Document Linked</span>
                            </div>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(entry.Remarks))
                    {
                        <div class="mt-1" style="font-size:11px;">
                            <span class="text-muted">Remarks:</span> @entry.Remarks
                        </div>
                    }

                    @* ── Replacement Status — moved here from the beneficiary level.
                         Shows both the link (who/what this entry is tied to) AND that
                         linked entry's Payment Status, so it's visible at a glance. ── *@
                    @if (entry.ReplacementStatus is 1 or 2)
                    {
                        <div class="mt-1" style="font-size:11px;">
                            <span class="tbl-badge @GetReplacementStatusBadgeClass(entry.ReplacementStatus)">
                                @GetReplacementStatusLabel(entry.ReplacementStatus, entry.LinkedBeneficiaryName, entry.LinkedPeriodLabel, entry.LinkedPaymentStatusLabel)
                            </span>
                            @if (entry.ReplacementDate.HasValue)
                            {
                                <span class="text-muted ms-1">on @entry.ReplacementDate.Value.ToString("MMM dd, yyyy")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.ReplacementRemarks))
                            {
                                <div class="text-muted">Remarks: @entry.ReplacementRemarks</div>
                            }
                            @if (_isAdmin)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1" style="font-size:11px;"
                                        @onclick="() => OpenUndoReplacementModal(entry)">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Undo
                                </button>
                            }
                        </div>
                    }

                  @if (_isAdmin)
                    {
                        <div class="d-flex gap-2 mt-1">
                            @if (!entry.IsCurrent)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 text-success" style="font-size:11px;"
                                        @onclick="() => ConfirmSetAsCurrent(entry)">
                                    <i class="bi bi-star-fill me-1"></i>Set as Current
                                </button>
                            }
                            <button type="button" class="btn btn-link btn-sm p-0" style="font-size:11px;"
                                    @onclick="() => OpenEditPaymentHistoryModal(entry)">
                                <i class="bi bi-pencil-square me-1"></i>Correct this entry
                            </button>
                            <button type="button" class="btn btn-link btn-sm p-0 text-danger" style="font-size:11px;"
                                    @onclick="() => ConfirmDeletePaymentHistory(entry)">
                                <i class="bi bi-trash me-1"></i>Delete
                            </button>
                            @if (entry.ReplacementStatus is not (1 or 2))
                            {
                                <button type="button" class="btn btn-link btn-sm p-0" style="font-size:11px;"
                                        @onclick="() => OpenReplaceModal(entry)">
                                    <i class="bi bi-arrow-left-right me-1"></i>Mark as Replaced
                                </button>
                            }
                        </div>
                    }
                  </div>
            </div>
        }
    </div>
}

@* ── Payroll Document Preview Overlay — same doc-viewer pattern as
     FormsGateway.razor's PDF preview, opened from a payment history row's
     "View Payroll" link above. ── *@
@if (_payrollPreviewDoc != null)
{
    <div class="doc-viewer-overlay" @onclick="ClosePayrollPreviewAsync">
        <div class="doc-viewer-card" @onclick:stopPropagation="true">
            <div class="doc-viewer-toolbar">
                <i class="bi bi-file-earmark-pdf me-1"></i>
                <span class="text-truncate flex-grow-1 small">@_payrollPreviewDoc.Title</span>

                @if (_payrollPreviewBlobUrl != null)
                {
                    <div class="doc-viewer-zoom-controls">
                        <button class="doc-viewer-zoom-btn" @onclick="PayrollPreviewZoomOut" disabled="@(_payrollPreviewZoom <= 50)" title="Zoom out">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                        <span class="doc-viewer-zoom-label">@_payrollPreviewZoom%</span>
                        <button class="doc-viewer-zoom-btn" @onclick="PayrollPreviewZoomIn" disabled="@(_payrollPreviewZoom >= 300)" title="Zoom in">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                        <button class="doc-viewer-zoom-btn" @onclick="PayrollPreviewZoomReset" title="Reset zoom">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>
                }

                <HxButton Size="ButtonSize.Small" Color="ThemeColor.None"
                          CssClass="btn-close btn-close-white ms-1"
                          OnClick="ClosePayrollPreviewAsync" />
            </div>
            @if (_payrollPreviewBlobUrl != null)
            {
                <iframe @key="@($"{_payrollPreviewDoc.Id}-{_payrollPreviewZoom}")"
                        src="@($"{_payrollPreviewBlobUrl}#zoom={_payrollPreviewZoom}")" class="doc-viewer-frame"></iframe>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center flex-grow-1 py-5">
                    <span class="spinner-border text-primary me-2"></span>
                    <span class="text-muted small">Loading preview...</span>
                </div>
            }
        </div>
    </div>
}
<h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Assessment</h6>
<div class="row g-2 mb-4">
                                                                                                    <div class="col-6">
                                                                                                        <small class="text-muted d-block">Is Eligible</small>
                                                                                                        @if (selectedDetails!.MissedProgramStartCutoff)
                                                                                                        {
                                                                                                            <span class="badge bg-danger" title="Missed ECA program start cutoff (March 17, 2024) — permanently ineligible">
                                                                                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>No (Cutoff)
                                                                                                            </span>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            var detailEligLabel = GetEligibilityLabel(selectedDetails.IsEligible,
                                                                                                        selectedDetails.EligibilityRemarks);
                                                                                                            <span class="badge @(selectedDetails.IsEligible ? "bg-success" : "bg-secondary")">
                                                                                                                @detailEligLabel
                                                                                                            </span>
                                                                                                        }
                                                                                                    </div>
                                                                                                    @if (!string.IsNullOrWhiteSpace(selectedDetails.EligibilityRemarks))
                                                                                                    {
                                                                                                        <div class="col-12">
                                                                                                            <small class="text-muted d-block">Eligibility Remarks</small>
                                                                                                            <span class="text-uppercase">@selectedDetails.EligibilityRemarks</span>
                                                                                                        </div>
                                                                                                    }
                                                                                                    <div class="col-6">
                                                                                                        <small class="text-muted d-block">Is Compliant</small>
                                                                                                        @{
                                                                                                            var detailCompLabel = GetComplianceLabel(selectedDetails.IsCompliant,
                                                                                                    selectedDetails.AssessmentRemarks);
                                                                                                        }
                                                                                                        <span class="badge @(selectedDetails.IsCompliant ? "bg-info" : "bg-warning text-dark")">
                                                                                                            @detailCompLabel
                                                                                                        </span>
                                                                                                    </div>
                                                                                                    @if (!string.IsNullOrWhiteSpace(selectedDetails.AssessmentRemarks))
                                                                                                    {
                                                                                                        <div class="col-12">
                                                                                                            <small class="text-muted d-block">Compliance Remarks</small>
                                                                                                            <span class="text-uppercase">@selectedDetails.AssessmentRemarks</span>
                                                                                                        </div>
                                                                                                    }
                                                                                                </div>
                                                                                                 <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Other</h6>
                                                                                                <div class="row g-2 mb-4">
                                                                                                    <div class="col-6"><small class="text-muted d-block">Is Deceased</small><span>@(selectedDetails.IsDeceased ?
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           "Yes" : "No")</span></div>
                                                                                                        <div class="col-6"><small class="text-muted d-block">Date of
                                                                                                            Death</small><span>@(selectedDetails.DateOfDeath?.ToString("MMMM dd, yyyy") ?? "—")</span></div>
                                                                                                            <div class="col-6"><small class="text-muted d-block">Date
                                                                                                                Added</small><span>@selectedDetails.DateAdded.ToString("MMMM dd, yyyy")</span></div>
                                                                                                            </div>

                                                                                                            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">
                                                                                                                <i class="bi bi-exclamation-triangle me-1"></i>Findings
                                                                                                            </h6>
                                                                                                            <div class="row g-2 mb-4">
                                                                                                                <div class="col-6">
                                                                                                                    <small class="text-muted d-block">With Findings</small>
                                                                                                                    <span class="tbl-badge @GetFindingBadgeClass(selectedDetails.FindingStatus)">
                                                                                                                        @GetFindingStatusText(selectedDetails.FindingStatus)
                                                                                                                    </span>
                                                                                                                </div>
                                                                                                                @if (selectedDetails.FindingStatus == 2 && !string.IsNullOrWhiteSpace(selectedDetails.FindingRemarks))
                                                                                                                {
                                                                                                                    <div class="col-12">
                                                                                                                        <small class="text-muted d-block">Finding Remarks</small>
                                                                                                                        <span>@selectedDetails.FindingRemarks</span>
                                                                                                                    </div>
                                                                                                                }
                                                                                                            </div>

                                                                                                            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">
                                                                                                                <i class="bi bi-building-check me-1"></i>CO Status
                                                                                                            </h6>
                                                                                                            <div class="row g-2 mb-4">
                                                                                                                <div class="col-6">
                                                                                                                    <small class="text-muted d-block">CO Status</small>
                                                                                                                    <span class="tbl-badge @GetCoStatusBadgeClass(selectedDetails!.CoStatus)">
                                                                                                                        @GetCoStatusLabel(selectedDetails.CoStatus)
                                                                                                                    </span>
                                                                                                                </div>
                                                                                                                <div class="col-6">
                                                                                                                    <small class="text-muted d-block">CO Date Endorsed</small>
                                                                                                                    @if (selectedDetails.CoDateEndorsed.HasValue)
                                                                                                                    {
                                                                                                                        <span class="tbl-badge pending">@selectedDetails.CoDateEndorsed.Value.ToString("MMMM dd, yyyy")</span>
                                                                                                                    }
                                                                                                                    else
                                                                                                                    {
                                                                                                                        <span class="text-muted">—</span>
                                                                                                                    }
                                                                                                                </div>
                                                                                                                <div class="col-6">
                                                                                                                    <small class="text-muted d-block">CO Date Approved</small>
                                                                                                                    @if (selectedDetails.CoDateApproved.HasValue)
                                                                                                                    {
                                                                                                                        <span class="tbl-badge yes-g">@selectedDetails.CoDateApproved.Value.ToString("MMMM dd, yyyy")</span>
                                                                                                                    }
                                                                                                                    else
                                                                                                                    {
                                                                                                                        <span class="text-muted">—</span>
                                                                                                                    }
                                                                                                                </div>
                                                                                                                @{
                                                                                                                     var detailCoDuration = GetCoProcessingDuration(selectedDetails.CoDateEndorsed, selectedDetails.CoDateApproved);
                                                                                                                 }
                                                                                                                 @if (detailCoDuration != null)
                                                                                                                 {
                                                                                                                     <div class="col-6">
                                                                                                                         <small class="text-muted d-block">Processing Time</small>
                                                                                                                         <span class="fw-semibold text-primary">@detailCoDuration</span>
                                                                                                                     </div>
                                                                                                                 }
                                                                                                            </div>

                                                                                                            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">
                                                                                                                <i class="bi bi-file-earmark-pdf me-1"></i>Documents
                                                                                                                @if (selectedDetails!.HasDocuments)
                                                                                                                {
                                                                                                                    <span class="badge bg-primary ms-2" style="font-size:10px;">
                                                                                                                        Has Attachments
                                                                                                                    </span>
                                                                                                                }
