                                                                                            <small class="text-muted d-block">Payment Status</small>
                                                                                            <span class="tbl-badge @GetPaymentBadgeClass(selectedDetails.PaymentStatus)">
                                                                                                @GetPaymentStatusText(selectedDetails.PaymentStatus)
                                                                                            </span>
                                                                                        </div>
                                                                                        <div class="col-6"><small class="text-muted d-block">Payment
                                                                                            Date</small><span>@(selectedDetails.PaymentDate?.ToString("MMMM dd, yyyy") ?? "—")</span></div>
                                                                                            <div class="col-6"><small class="text-muted d-block">Mode of
                                                                                                Payment</small><span>@GetModeOfPaymentText(selectedDetails.ModeOfPayment)</span></div>
                                                                                                <div class="col-12"><small class="text-muted d-block">Remarks</small><span>@(selectedDetails.Remarks ??
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         "—")</span></div>
                                                                                                </div>

                                                                                                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Assessment</h6>
                                                                                                <div class="row g-2 mb-4">
                                                                                                    <div class="col-6">
                                                                                                        <small class="text-muted d-block">Is Eligible</small>
                                                                                                        @{
                                                                                                            var detailEligLabel = GetEligibilityLabel(selectedDetails!.IsEligible,
                                                                                                    selectedDetails.EligibilityRemarks);
                                                                                                        }
                                                                                                        <span class="badge @(selectedDetails.IsEligible ? "bg-success" : "bg-secondary")">
                                                                                                            @detailEligLabel
                                                                                                        </span>
                                                                                                    </div>
