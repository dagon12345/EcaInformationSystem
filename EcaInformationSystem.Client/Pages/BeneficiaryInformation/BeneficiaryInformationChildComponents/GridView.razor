private void OpenGlobalDuplicateModal()
{
    _duplicateSummary = State.GlobalDuplicateSummary;
    _duplicateSearchTerm = string.Empty;
    _duplicateReasonFilter = string.Empty;

    // ✅ Defer to the next render cycle via InvokeAsync, and actually
    // observe/log any exception instead of discarding the task.
    _ = InvokeAsync(async () =>
    {
        try
        {
            StateHasChanged(); // ensure _duplicateSummary is rendered into the DOM first
            await Task.Yield(); // let the render actually commit
            await _duplicateModal.ShowAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[GRID] _duplicateModal.ShowAsync() FAILED: {ex}");
        }
    });
}

