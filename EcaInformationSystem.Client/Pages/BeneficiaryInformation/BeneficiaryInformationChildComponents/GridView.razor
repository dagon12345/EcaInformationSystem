    private async Task SearchReplacementCandidatesAsync(string term)
    {
        _replacementSearchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _replacementSearchCts = cts;

        try
        {
            _isSearchingReplacement = true;
            StateHasChanged();
            await Task.Delay(300, cts.Token);

            // ✅ excludeId still keeps the outgoing beneficiary out of their own
            // candidate list — WHICH of their entries is used is chosen in step 2.
            var url = $"api/beneficiary/replacement-lookup?excludeId={selectedDetails?.Id}" +
                      (string.IsNullOrWhiteSpace(term) ? "" : $"&search={Uri.EscapeDataString(term)}");
            var result = await Http.GetFromJsonAsync<List<BeneficiaryLookupDto>>(url, cts.Token);

            if (!cts.IsCancellationRequested)
                _replacementCandidates = result ?? new();
        }
        catch (TaskCanceledException) { /* superseded by a newer search */ }
        catch (Exception ex) { toast.ShowError($"Search failed: {ex.Message}"); }
        finally
        {
            if (!cts.IsCancellationRequested)
                _isSearchingReplacement = false;
            StateHasChanged();
        }
    }

