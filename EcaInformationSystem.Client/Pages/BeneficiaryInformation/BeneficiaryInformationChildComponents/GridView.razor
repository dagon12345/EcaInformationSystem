// ── Grid-level payroll indicator — whether the CURRENT payment history
// entry shown for each visible row has a matching Forms Gateway payroll
// document (same matching FindPayrollDocumentAsync uses in the off-canvas).
// Recomputed whenever the grid's data changes (State.OnChange) — cheap,
// since FindPayrollDocumentAsync filters an already-cached document list.
private readonly Dictionary<Guid, bool> _hasPayrollByBeneficiaryId = new();

private bool HasLinkedPayroll(BeneficiaryListItemDto item) =>
    _hasPayrollByBeneficiaryId.TryGetValue(item.Id, out var has) && has;

private async Task RecomputeGridPayrollLinksAsync()
{
    foreach (var item in FilteredBeneficiaries.ToList())
    {
        var region = item.PsgcCodeRegion > 0 ? item.PsgcCodeRegion : (int?)null;
        var municipality = item.PsgcCodeMunicipality > 0 ? item.PsgcCodeMunicipality : (int?)null;
        var hasLink = false;

        try
        {
            // ✅ FIXED — one unified lookup instead of two independent OR'd
            // ones. See FormDocumentClientService.FindPayrollDocumentAsync —
            // a document tagged with BOTH Quarter/FiscalYear AND a specific
            // Milestone Year now requires BOTH to match this beneficiary,
            // not either alone.
            var doc = await FormService.FindPayrollDocumentAsync(
                item.PayrollQuarter, item.FiscalYear,
                item.MilestoneYear > 0 ? item.MilestoneYear : null,
                region, municipality);
            hasLink = doc != null;

            _hasPayrollByBeneficiaryId[item.Id] = hasLink;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Grid payroll lookup failed for {item.Id}: {ex.Message}");
            _hasPayrollByBeneficiaryId[item.Id] = false;
        }
    }

    await InvokeAsync(StateHasChanged);
}
