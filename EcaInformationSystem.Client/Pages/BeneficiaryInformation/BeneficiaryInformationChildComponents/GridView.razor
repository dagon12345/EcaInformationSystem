@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject ToastService toast
@inject IJSRuntime JS
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BeneficiaryStateService State;

<!-- List/Grid Section -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex flex-column">
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="mb-0">Showing</h5>
                                <span class="badge bg-primary">@DisplayCount Record(s)</span>
                            </div>
                            <small class="opacity-75 mt-1">Select the checkbox to Bulk Update payment status or Create Payroll</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-info" @onclick="GoToDashboardSummary">
                            Dashboard Summary
                        </button>

                        <button class="btn btn-success"
                                @onclick="ExportExcel"
                                disabled="@IsExporting">

                            @if (IsExporting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Exporting...</span>
                            }
                            else
                            {
                                <span class="bi bi-file-earmark-excel">Export Excel</span>
                            }
                        </button>
                    </div>
                </div>

            </div>
            <div class="card-body p-3">
            <div class="records-table-wrap">

                @* ── BULK BAR ────────────────────────────────────────── *@
                <div class="bulk-bar">
                    <span class="sel-count">@checkedIds.Count selected</span>

                    <select class="form-select form-select-sm w-auto" @bind="bulkPaymentStatus">
                        <option value="0">-- Set Payment Status --</option>
                        <option value="1">Unpaid</option>
                        <option value="2">Paid</option>
                    </select>

                    <InputDate class="form-control form-control-sm w-auto"
                               TValue="DateTime?"
                               @bind-Value="bulkPaymentDate"
                               disabled="@(bulkPaymentStatus != 2)" />

                    <button class="btn btn-sm btn-primary"
                            @onclick="OpenBulkUpdateModal"
                            disabled="@(!checkedIds.Any() || bulkPaymentStatus == 0 || (bulkPaymentStatus == 2 && bulkPaymentDate == null) || IsBulkUpdating)">
                        @if (IsBulkUpdating)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Apply to Selected</span>
                        }
                    </button>

                    <button class="btn btn-sm btn-warning"
                            @onclick="OpenPayrollModal"
                            disabled="@(!checkedIds.Any() || IsGeneratingPayroll)">
                        @if (IsGeneratingPayroll)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Opening...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel me-1"></i>
                            <span>Generate Payroll</span>
                        }
                    </button>

                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="ClearSelection"
                            disabled="@(!checkedIds.Any())">
                        Clear Selection
                    </button>
                </div>

                @* ── PAGINATION BAR ──────────────────────────────────── *@
                <div class="pag-bar">
                    <span>
                        Showing
                        <strong>@(((State.Filter.PageNumber - 1) * State.Filter.PageSize) + 1)</strong>
                        –
                        <strong>@Math.Min(State.Filter.PageNumber * State.Filter.PageSize, DisplayCount)</strong>
                        of <strong>@DisplayCount</strong> record(s)
                        &nbsp;·&nbsp; Page @State.Filter.PageNumber of @State.TotalPages
                    </span>
                    <div class="pag-controls">
                        <button class="pag-btn"
                                @onclick="GoToPreviousPageAsync"
                                disabled="@(State.Filter.PageNumber <= 1 || State.IsLoading)">
                            ← Prev
                        </button>
                        <span style="font-size:12px; color:var(--text-muted);">
                            @State.Filter.PageNumber / @State.TotalPages
                        </span>
                        <button class="pag-btn"
                                @onclick="GoToNextPageAsync"
                                disabled="@(State.Filter.PageNumber >= State.TotalPages || State.IsLoading)">
                            Next →
                        </button>
                            <select class="form-select form-select-sm w-auto"
                                    @bind="State.Filter.PageSize"
                                    @bind:after="OnPageSizeChangedAsync">
                                <option value="10">10 / page</option>
                                <option value="20">20 / page</option>
                                <option value="50">50 / page</option>
                                <option value="100">100 / page</option>
                                <option value="500">500 / page</option>
                                <option value="1000">1000 / page</option>
                            </select>
                    </div>
                </div>

                @* ── TABLE CONTAINER ─────────────────────────────────── *@
                <div class="tbl-container">

                    @* Havit spinner overlay *@
                    @if (State.IsLoading)
                    {
                        <div class="tbl-overlay">
                           <HxSpinner Color="ThemeColor.Primary" Size="SpinnerSize.Regular"/>
                            <span class="ov-text">Loading records...</span>
                        </div>
                    }

                    <div class="tbl-scroll">
                        <table class="records-tbl">
                            <thead>
                                <tr>
                                    <th style="width:42px;">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               checked="@AreAllChecked()"
                                               @onchange="ToggleSelectAll" />
                                    </th>
                                    <th>Batch Code</th>
                                    <th>Phone</th>
                                    <th>
                                        Full Name
                                        <input type="text"
                                               class="hdr-search"
                                               placeholder="Search name..."
                                               @oninput="OnFullNameFilterInput" />
                                    </th>
                                    <th>Birth Date</th>
                                    <th>Age</th>
                                    <th>Milestone</th>
                                    <th>Sex</th>
                                    <th>Municipality</th>
                                    <th>Barangay</th>
                                    <th>Validator</th>
                                    <th>Payment</th>
                                    <th>Eligible</th>
                                    <th>Compliant</th>
                                    <th>Findings</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredBeneficiaries)
                                {
                                    <tr class="@(checkedIds.Contains(item.Id) ? "row-checked" : "")">
                                        <td>
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   checked="@checkedIds.Contains(item.Id)"
                                                   @onchange="() => ToggleCheck(item.Id)" />
                                        </td>
                                        <td>@item.BatchCode</td>
                                        <td>@item.PhoneNumber</td>
                                        <td>@GetFullName(item)</td>
                                        <td>@item.BirthDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="tbl-badge @GetAgeBadgeClass(item.BirthDate)">
                                                @item.Age
                                            </span>
                                        </td>
                                        <td>
                                            <span class="tbl-badge mile">@item.MilestoneYear</span>
                                        </td>
                                        <td>@GetSexText(item.Sex)</td>
                                        <td>@item.MunicipalityName</td>
                                        <td>@item.BarangayName</td>
                                        <td>@item.Validator</td>
                                        <td>
                                            <span class="tbl-badge @GetPaymentBadgeClass(item.PaymentStatus)">
                                                @GetPaymentStatusText(item.PaymentStatus)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="tbl-badge @(item.IsEligible ? "yes-g" : "no-g")">
                                                @(item.IsEligible ? "Yes" : "No")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="tbl-badge @(item.IsCompliant ? "yes-b" : "no-b")">
                                                @(item.IsCompliant ? "Yes" : "No")
                                            </span>
                                        </td>
                                            <td>
                                                @{
                                                    var badge = GetFindingBadgeClass(item.FindingStatus);
                                                    var label = GetFindingStatusText(item.FindingStatus);
                                                }
                                                <span class="tbl-badge @badge" title="@item.FindingRemarks">
                                                    @label
                                                </span>
                                                @if (item.FindingStatus == 2 && !string.IsNullOrWhiteSpace(item.FindingRemarks))
                                                {
                                                    <br />
                                                    <small class="text-muted" style="font-size:10px; max-width:120px; display:inline-block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                        @item.FindingRemarks
                                                    </small>
                                                }
                                            </td>
                                        <td>
                                            <button class="btn-details"
                                                    @onclick="() => OpenDetailsPanel(item)"
                                                    title="View Details">
                                                <i class="bi bi-info-circle"></i> Details
                                            </button>
                                        </td>
                                    </tr>
                                }

                                @* Filler — holds 500px height when empty or loading *@
                                @if (!FilteredBeneficiaries.Any())
                                {
                                    <tr class="filler-row">
                                        <td colspan="16">
                                            @if (!State.IsLoading)
                                            {
                                                <span>No records found.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
          </div>
        </div>
    </div>
</div>
<!--Bulk update Modal-->
<HxModal @ref="bulkUpdateModal">
    <HeaderTemplate>
        <h5 class="modal-title">Confirm Bulk Update</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>
            You are about to set <strong>@checkedIds.Count</strong> record(s) to
            <strong>@GetPaymentStatusText(bulkPaymentStatus)</strong>.
            This action cannot be undone easily. Proceed?
        </p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => bulkUpdateModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="ExecuteBulkUpdateAsync" Disabled="@IsBulkUpdating">
            @if (IsBulkUpdating)
            {
                //No need spinner Hxmodal have already
                <span>Updating...</span>
            }
            else
            {

                <span>Yes, Update</span>
            }
        </HxButton>
    </FooterTemplate>
</HxModal>
<!--Off Canvas details displaying-->
<HxOffcanvas @ref="detailsOffcanvas"
           Size="OffcanvasSize.Large">
    <HeaderTemplate>
        <h5 class="offcanvas-title">
            Details — @selectedDetails?.LastName, @selectedDetails?.FirstName
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        @if (selectedDetails is not null)
        {
            <!-- Identity -->
            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Identity Information</h6>
            <div class="row g-2 mb-4">
                <div class="col-6">
                    <small class="text-muted d-block">Last Name</small>
                    <span>@(selectedDetails.LastName ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">First Name</small>
                    <span>@selectedDetails.FirstName</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Middle Name</small>
                    <span>@(selectedDetails.MiddleName ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Extension</small>
                    <span>@(selectedDetails.Extension ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Birth Date</small>
                    <span>@selectedDetails.BirthDate.ToString("MMMM dd, yyyy")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Age</small>
                    <span>@selectedDetails.Age</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Sex</small>
                    <span>@GetSexText(selectedDetails.Sex)</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Phone Number</small>
                    <span>@(selectedDetails.PhoneNumber ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">OSCA ID Number</small>
                    <span>@(selectedDetails.OscaIdNumber ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">NCSC RRN</small>
                    <span>@(selectedDetails.NcscRrn?.ToString() ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Batch Code</small>
                    <span>@(selectedDetails.BatchCode ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Date Applied</small>
                    <span>@(selectedDetails.DateApplied?.ToString("MMMM dd, yyyy") ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Date Endorsed</small>
                    <span>@(selectedDetails.DateEndorsed?.ToString("MMMM dd, yyyy") ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">OSCA ID Date Issued</small>
                    <span>@(selectedDetails.OscaIdDateIssued?.ToString("MMMM dd, yyyy") ?? "—")</span>
                </div>
            </div>

            <!-- Demographic -->
            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Demographic Information</h6>
            <div class="row g-2 mb-4">
                <div class="col-6">
                    <small class="text-muted d-block">Civil Status</small>
                    <span>@GetCivilStatusText(selectedDetails.CivilStatus)</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Citizenship</small>
                    <span>@GetCitizenshipText(selectedDetails.Citizenship)</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Indigenous People</small>
                    <span>@(selectedDetails.IsIndigenousPeople ? "Yes" : "No")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Person with Disability</small>
                    <span>@(selectedDetails.IsPersonWithDisability ? "Yes" : "No")</span>
                </div>
            </div>

            <!-- Address -->
            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Address Information</h6>
            <div class="row g-2 mb-4">
                <div class="col-6">
                    <small class="text-muted d-block">Region</small>
                    <span>@(selectedDetails.Region)</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Province</small>
                    <span>@(selectedDetails.Province)</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Municipality</small>
                    <span>@(selectedDetails.Municipality)</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Barangay</small>
                    <span>@(selectedDetails.Barangay)</span>
                </div>
            </div>

            <!-- Validation -->
            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Validation & Payment</h6>
            <div class="row g-2 mb-4">
                <div class="col-6">
                    <small class="text-muted d-block">Validator</small>
                    <span>@(selectedDetails.Validator ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Validation Date</small>
                    <span>@selectedDetails.ValidationDate.ToString("MMMM dd, yyyy")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Payment Status</small>
                    <span class="badge @GetPaymentBadgeClass(selectedDetails.PaymentStatus)">
                        @GetPaymentStatusText(selectedDetails.PaymentStatus)
                    </span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Payment Date</small>
                    <span>@(selectedDetails.PaymentDate?.ToString("MMMM dd, yyyy") ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Mode of Payment</small>
                    <span>@GetModeOfPaymentText(selectedDetails.ModeOfPayment)</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Is Eligible</small>
                    <span class="badge @(selectedDetails.IsEligible ? "bg-success" : "bg-secondary")">
                        @(selectedDetails.IsEligible ? "Yes" : "No")
                    </span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Is Compliant</small>
                    <span class="badge @(selectedDetails.IsCompliant ? "bg-info" : "bg-warning text-dark")">
                        @(selectedDetails.IsCompliant ? "Yes" : "No")
                    </span>
                </div>
            </div>

            <!-- Assessment -->
            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Assessment</h6>
            <div class="row g-2 mb-4">
                <div class="col-12">
                    <small class="text-muted d-block">Assessment Remarks</small>
                    <span>@(selectedDetails.AssessmentRemarks ?? "—")</span>
                </div>
                <div class="col-12">
                    <small class="text-muted d-block">Remarks</small>
                    <span>@(selectedDetails.Remarks ?? "—")</span>
                </div>
            </div>

            <!-- Deceased -->
            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Other</h6>
            <div class="row g-2 mb-4">
                <div class="col-6">
                    <small class="text-muted d-block">Is Deceased</small>
                    <span>@(selectedDetails.IsDeceased ? "Yes" : "No")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Date of Death</small>
                    <span>@(selectedDetails.DateOfDeath?.ToString("MMMM dd, yyyy") ?? "—")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Date Added</small>
                    <span>@selectedDetails.DateAdded.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>
            <!-- Findings -->
            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i>Findings
            </h6>
            <div class="row g-2 mb-4">
                <div class="col-6">
                    <small class="text-muted d-block">With Findings</small>
                    <span class="tbl-badge @GetFindingBadgeClass(selectedDetails.FindingStatus)">
                        @GetFindingStatusText(selectedDetails.FindingStatus)
                    </span>
                </div>
                @if (selectedDetails.FindingStatus == 2 && !string.IsNullOrWhiteSpace(selectedDetails.FindingRemarks))
                {
                    <div class="col-12">
                        <small class="text-muted d-block">Finding Remarks</small>
                        <span>@selectedDetails.FindingRemarks</span>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <div class="d-flex justify-content-between align-items-center w-100">
        
            <!-- Left side buttons -->
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary px-4"
                        @onclick="() => detailsOffcanvas.HideAsync()">
                    Close
                </button>
              <button class="btn btn-outline-primary px-4"
                   @onclick="async () => {await OpenEditConfirmationModal(selectedDetails! ,selectedDetails!.Id);}">
                  <i class="bi bi-pencil-square me-1"></i> Edit
               </button>
                <button class="btn btn-outline-info px-4"
                        @onclick="() => OpenLogModal(selectedDetails!)"
                        title="Logs">
                    <i class="bi bi-clock-history me-1"></i> Logs
                </button>
            </div>

            <!-- Right side — Delete pushed to far right -->
            <button class="btn btn-outline-danger px-4"
                    @onclick="async () => {await detailsOffcanvas.HideAsync(); await OpenDeleteConfirmationModal(selectedDetails!); }"
                    title="Delete">
                <i class="bi bi-trash me-1"></i> Delete
            </button>

        </div>
    </FooterTemplate>
</HxOffcanvas>
<!--Log Modal-->
<HxModal @ref="logModal" Size="ModalSize.ExtraLarge">
    <HeaderTemplate>
        <h5 class="modal-title">Logs - @selectedBeneficiaryName</h5>
    </HeaderTemplate>

    <BodyTemplate>
        @if (IsLogsLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 mb-0">Loading logs...</p>
            </div>
        }
        else if (logs == null || !logs.Any())
        {
            <div class="alert alert-info mb-0">
                No logs found for this beneficiary.
            </div>
        }
        else
        {
            <div style="max-height: 500px; overflow-y: auto;">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th style="width: 70px;">#</th>
                                <th>Activity</th>
                                <th style="width: 180px;">User</th>
                                <th style="width: 200px;">Date Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < logs.Count; i++)
                            {
                                var log = logs[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@log.Activity</td>
                                    <td>@log.UserName</td>
                                    <td>@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </BodyTemplate>

    <FooterTemplate>
        <HxButton Type="ButtonType.Button"
                Color="ThemeColor.Secondary"
                @onclick="CloseLogModal">
            Close
        </HxButton>
    </FooterTemplate>
</HxModal>
<PayrollModal @ref="_payrollModal" />
<!--Confirmation Modal-->
<HxModal @ref="confirmModal">
    <HeaderTemplate>
        <h5 class="modal-title">@confirmationTitle</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-0">@confirmationMessage</p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Type="ButtonType.Button" Color="ThemeColor.Secondary" @onclick="CloseConfirmationModal">
            Cancel
        </HxButton>
        <HxButton Type="ButtonType.Button" Color="ThemeColor.Primary" @onclick="ConfirmActionAsync" Disabled="@IsSaving">
            @if (IsSaving)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Yes, Confirm</span>
            }
        </HxButton>
    </FooterTemplate>
</HxModal>
@code {
    private string? errorMessage;
    private bool IsExporting;
    private bool IsGeneratingPayroll;
    private PayrollModal _payrollModal = default!;
    private bool IsLogsLoading;
    private bool IsSaving;
    private HashSet<Guid> checkedIds = new();
    private int bulkPaymentStatus = 0;
    private DateTime? bulkPaymentDate;
    private bool IsBulkUpdating;
    private string? fullNameFilter;
    private CancellationTokenSource? _nameCts;
    private BeneficiaryInformationDto? selectedDetails;
    private HxOffcanvas detailsOffcanvas = default!;
    private const int DefaultRegionCode = 1600000000;
    private HxModal bulkUpdateModal = default!;
    private HxModal logModal = default!;
    private HxModal confirmModal = default!;
    private string selectedBeneficiaryName = string.Empty;
    private BeneficiaryInformationDto? selectedDeleteItem;
    private List<LogsLookupDto> logs = new();
    private string pendingAction = string.Empty; //"add", "edit", "delete"
    private string confirmationTitle = "Confirm Action";
    private string confirmationMessage = string.Empty;
    private string? successMessage = string.Empty;
    // Server handles all filtering — State.Beneficiaries is already the filtered+paged result.
    // The column search box triggers a server-side reload (see OnFullNameFilterInput below).
    private IEnumerable<BeneficiaryInformationDto> FilteredBeneficiaries => State.Beneficiaries;
    private int DisplayCount => State.TotalCount;

    private async Task OpenDetailsPanel(BeneficiaryInformationDto item)
    {
        selectedDetails = item;
        StateHasChanged();
        await detailsOffcanvas.ShowAsync();
    }
    protected override async void OnInitialized()
    {
        State.OnChange += StateHasChanged;

        // ✅ Only reload if there was an active filter before navigation
        // Don't auto-load on fresh visit or after clear
        if (State.HasActiveFilter && State.IsStale())
        {
            await State.LoadAsync();
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
