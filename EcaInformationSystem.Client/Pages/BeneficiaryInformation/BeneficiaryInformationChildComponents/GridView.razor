    private List<string> GetIncompleteDetails(BeneficiaryListItemDto item)
{
    var issues = new List<string>();
    if (item.DateEndorsed == null) issues.Add("Date Endorsed missing");
    if (item.DateApplied == null) issues.Add("Date Applied missing");
    if (!item.PhoneNumbers.Any(n => !string.IsNullOrWhiteSpace(n.Number))) issues.Add("Phone Number missing");
    if (item.NcscRrn == null) issues.Add("NCSC RRN missing");
    return issues;
}

