    // ── Execute ───────────────────────────────────────────────────────────
    private async Task ExecuteBulkOtherUpdateAsync()
    {
        try
        {
            IsBulkUpdatingOther = true;
            // ✅ Build RowVersions from the currently displayed records
            // State.Beneficiaries contains the DTOs with RowVersion from last load
            var rowVersions = State.Beneficiaries
                .Where(x => checkedIds.Contains(x.Id) && x.RowVersion != null)
                .ToDictionary(x => x.Id, x => x.RowVersion!);

            // Parse eligibility — null means "don't touch"
            bool? parsedEligible = bulkIsEligible switch
            {
                "true" => true,
                "false" => false,
                _ => null
            };

            // null = don't touch; whitespace normalized to null inside service
            string? parsedBatchCode = string.IsNullOrWhiteSpace(bulkBatchCode)
                ? null
                : bulkBatchCode.Trim();

            var request = new
            {
                Ids = checkedIds.ToList(),
                IsEligible = parsedEligible,
                BatchCode = parsedBatchCode
            };

            var response = await Http.PostAsJsonAsync(
                "api/beneficiary/bulk-eligibility-batchcode", request);

            // ✅ Handle concurrency conflict
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var message = await response.Content.ReadAsStringAsync();
                toast.ShowError(message);
                State.Invalidate();
                await State.LoadAsync();
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var parts = new List<string>();
                if (parsedEligible.HasValue)
                    parts.Add($"eligibility → {(parsedEligible.Value ? "Eligible" : "Ineligible")}");
                if (parsedBatchCode != null)
                    parts.Add($"batch code → '{parsedBatchCode}'");

                toast.ShowSuccess(
                    $"Updated {checkedIds.Count} record(s): {string.Join(", ", parts)}.");

                // Reset fields
                bulkIsEligible = string.Empty;
                bulkBatchCode = null;
                ClearSelection();

                await bulkOtherUpdateModal.HideAsync();

                State.Invalidate();
                await State.LoadAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Bulk update failed: {error}");
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"An error occurred: {ex.Message}");
        }
        finally
        {
            IsBulkUpdatingOther = false;
        }
    }
    private async Task SortBy(string column)
