                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      "—")</span></div>
                                                                                    <div class="col-6"><small class="text-muted d-block">Validation Date</small><span>@selectedDetails.ValidationDate.ToString("MMMM dd, yyyy")</span></div>
