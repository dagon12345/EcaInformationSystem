    private async Task ConfirmActionAsync()
    {
        try
        {
            IsSaving = true;
            errorMessage = null;
            successMessage = null;
            await confirmModal.HideAsync();
            if (string.IsNullOrWhiteSpace(pendingAction)) { errorMessage = "No action selected."; return; }
            switch (pendingAction)
            {
                case "delete": await SoftDeleteBeneficiaryAsync(); break;
                case "navigate": Navigation.NavigateTo($"/beneficiary-edit/{selectedDetails!.Id}"); break;
                case "generate-payroll": await OpenPayrollModal(); break;
                default: errorMessage = "Unknown action."; break;
            }
        }
        catch (Exception ex) { errorMessage = $"An error occurred while processing. {ex.Message}"; }
        finally { IsSaving = false; pendingAction = string.Empty; selectedDeleteItem = null; }
    }

