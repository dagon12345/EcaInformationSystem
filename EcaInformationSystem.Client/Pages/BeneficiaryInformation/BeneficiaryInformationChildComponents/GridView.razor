// Looks up a matching Forms Gateway payroll PDF for every entry that has a
// PayrollQuarter/FiscalYear, so the "View Payroll" link only renders where
// an admin has actually tagged one. Uses the beneficiary's own municipality
// and region so a municipality-specific payroll file is preferred over a
// region-wide one, which is preferred over an "all regions" one.
private async Task LoadPayrollLinksAsync()
{
    _payrollLinksByHistoryId.Clear();
    _milestonePayrollDoc = null;
    var region = selectedDetails?.PsgcCodeRegion;
    var municipality = selectedDetails?.PsgcCodeMunicipality;

    var milestoneYear = selectedDetails?.MilestoneYear > 0 ? selectedDetails.MilestoneYear : (int?)null;

    foreach (var entry in paymentHistory)
    {
        if (!entry.PayrollQuarter.HasValue || !entry.FiscalYear.HasValue) continue;

        // ✅ FIXED — selectedDetails.MilestoneYear is the beneficiary's CURRENT
        // milestone year, not a per-entry value (PaymentHistory never stores
        // one — it's computed from BirthDate). Applying it to every historical
        // entry broke older quarters' links: a Q2 2024 payroll doc tagged for
        // whatever milestone year was current back then no longer matched
        // against the beneficiary's PRESENT milestone year. Only the entry
        // that's still their current one shares that "now" context with
        // selectedDetails.MilestoneYear — every other entry is checked on
        // Quarter/FiscalYear alone, same as before this whole fix.
        var milestoneYearForEntry = entry.IsCurrent ? milestoneYear : null;

        try
        {
            _payrollLinksByHistoryId[entry.Id] = await FormService.FindPayrollDocumentAsync(
                entry.PayrollQuarter, entry.FiscalYear, milestoneYearForEntry, region, municipality);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Payroll lookup failed for history {entry.Id}: {ex.Message}");
        }
    }

    if (milestoneYear.HasValue)
    {
        try
        {
            // No specific Quarter/FiscalYear here (this isn't tied to one
            // payment history entry) — a document that ALSO requires a
            // quarter/year is deliberately excluded rather than guessed at.
            _milestonePayrollDoc = await FormService.FindPayrollDocumentAsync(
                null, null, milestoneYear, region, municipality);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Milestone payroll lookup failed for {selectedDetails!.Id}: {ex.Message}");
        }
    }
}

private async Task PreviewPayrollAsync(FormDocumentDto doc)
{
    if (_payrollPreviewLoadingId.HasValue) return;
    _payrollPreviewLoadingId = doc.Id;
    StateHasChanged();

    try
    {
        var result = await FormService.DownloadAsync(doc.Id, doc.OriginalFileName);
        if (result == null)
        {
            toast.ShowError("Could not load the payroll preview.");
            return;
        }

        _payrollPreviewDoc = doc;
        _payrollPreviewZoom = 100;
        StateHasChanged();

        using var streamRef = new DotNetStreamReference(new MemoryStream(result.Value.Data));
        _payrollPreviewBlobUrl = await JS.InvokeAsync<string>("createPdfBlobUrlFromStream", streamRef);
    }
    catch (Exception ex)
    {
        toast.ShowError($"Could not load the payroll preview: {ex.Message}");
        _payrollPreviewDoc = null;
    }
    finally
    {
        _payrollPreviewLoadingId = null;
        StateHasChanged();
    }
}

private async Task ClosePayrollPreviewAsync()
