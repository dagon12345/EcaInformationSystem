    private MarkupString Highlight(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return new MarkupString("—");
        var term = State.Filter.GeneralSearch?.Trim();
        if (string.IsNullOrWhiteSpace(term))
            return new MarkupString(System.Web.HttpUtility.HtmlEncode(text));
        var encoded = System.Web.HttpUtility.HtmlEncode(text);
        var encodedTerm = System.Web.HttpUtility.HtmlEncode(term);
        var result = System.Text.RegularExpressions.Regex.Replace(
            encoded,
            System.Text.RegularExpressions.Regex.Escape(encodedTerm),
            match => $"<mark class=\"search-highlight\">{match.Value}</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return new MarkupString(result);
    }

    private MarkupString Highlight(string? text, string fallback = "—")
    {
        if (string.IsNullOrWhiteSpace(text)) return new MarkupString(fallback);
        return Highlight(text);
    }

