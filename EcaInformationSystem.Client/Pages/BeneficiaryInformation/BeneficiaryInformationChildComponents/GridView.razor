private List<string> GetLocationCautions(BeneficiaryListItemDto item)
{
    var issues = new List<string>();

    if (string.IsNullOrWhiteSpace(item.MunicipalityName))
        issues.Add("Municipality code needs correction");

    if (string.IsNullOrWhiteSpace(item.BarangayName))
        issues.Add("Barangay code needs correction");

    // Add Province/Region checks here too, if/when those name fields
    // become available on BeneficiaryListItemDto — same null-check pattern.

    return issues;
}

// ── Warning: everything else ─────────────────────────────────────────────
private List<string> GetOtherWarnings(BeneficiaryListItemDto item)
{
    var issues = new List<string>();

    if (item.Quarter.HasValue && !string.IsNullOrWhiteSpace(item.Batch)
        && item.RefYear.HasValue && string.IsNullOrWhiteSpace(item.RefCode))
        issues.Add("Reference number not generated — use bulk assign");

    if (item.PaymentStatus == 2 && (item.PaymentDate == null || item.ModeOfPayment == 0))
        issues.Add("Paid status missing payment date or mode of payment");

    if (item.CoStatus == 1 && item.CoDateEndorsed == null)
        issues.Add("CO Status is Endorsed but missing CO Date Endorsed");
    if (item.CoStatus == 2 && item.CoDateApproved == null)
        issues.Add("CO Status is Approved but missing CO Date Approved");

    return issues;
}

private int LocationCautionCount =>
    FilteredBeneficiaries.Count(item => GetLocationCautions(item).Any());

private int OtherWarningCount =>
    FilteredBeneficiaries.Count(item => GetOtherWarnings(item).Any());


