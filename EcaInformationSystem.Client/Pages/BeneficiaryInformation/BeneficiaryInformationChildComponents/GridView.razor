<HxModal @ref="bulkPaymentHistoryModal">
    <HeaderTemplate>
        <h5 class="modal-title">Confirm Bulk Payment Record</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>
            You are about to record a new
            <strong>@GetPaymentStatusText(bulkPaymentStatus)</strong> payment entry
            for <strong>@checkedIds.Count</strong> beneficiary record(s).
        </p>
        @* AFTER *@
        @if (bulkPaymentStatus == 2)
        {
            <ul class="mb-0">
                <li>Period: <strong>Q@(bulkPayrollQuarterOnly) @(_bulkFiscalYear)</strong></li>
                <li>Mode of Payment: <strong>@GetModeOfPaymentText(bulkModeOfPayment ?? 0)</strong></li>
                <li>Payment Date: <strong>@(bulkPaymentDate?.ToString("MMMM dd, yyyy") ?? "Left blank — each record keeps its existing date")</strong></li>
            </ul>
        }
        else if (bulkPaymentStatus == 1)
        {
            <ul class="mb-0">
                <li>Unpaid Date: <strong>@(bulkPaymentDate?.ToString("MMMM dd, yyyy") ?? "Left blank — each record keeps its existing date")</strong></li>
            </ul>
        }
        <p class="mt-2 mb-0 text-muted small">
            This adds a new history entry to each selected record — it does not
            overwrite existing entries.
        </p>
    </BodyTemplate>
    <FooterTemplate>
