        try
        {
            IsExporting = true;
            StateHasChanged();
            var response = await Http.PostAsJsonAsync("api/beneficiary/export", new { Ids = checkedIds.ToList() });
            if (!response.IsSuccessStatusCode)
            {
                toast.ShowError($"Export failed: {await response.Content.ReadAsStringAsync()}");
                return;
            }
            var exportBytes = await response.Content.ReadAsByteArrayAsync();
            if (exportBytes == null || exportBytes.Length == 0) { toast.ShowError("No data returned from export."); return; }
            await JS.InvokeVoidAsync("downloadFile", $"Beneficiaries_{DateTime.Now:yyyy-MM-dd}.xlsx",
Convert.ToBase64String(exportBytes));
        }
        catch (Exception ex) { toast.ShowError($"Export failed: {ex.Message}"); }
        finally { IsExporting = false; }
    }

