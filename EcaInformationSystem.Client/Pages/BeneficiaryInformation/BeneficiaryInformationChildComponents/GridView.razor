                                                                                                            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">
                                                                                                                <i class="bi bi-building-check me-1"></i>CO Status
                                                                                                            </h6>
                                                                                                            <div class="row g-2 mb-4">
                                                                                                                <div class="col-6">
                                                                                                                    <small class="text-muted d-block">CO Status</small>
                                                                                                                    <span class="tbl-badge @GetCoStatusBadgeClass(selectedDetails!.CoStatus)">
                                                                                                                        @GetCoStatusLabel(selectedDetails.CoStatus)
                                                                                                                    </span>
                                                                                                                </div>
                                                                                                                <div class="col-6"><small class="text-muted d-block">CO Date
                                                                                                                    Endorsed</small><span>@(selectedDetails.CoDateEndorsed?.ToString("MMMM dd, yyyy") ?? "—")</span>
                                                                                                                </div>
                                                                                                                <div class="col-6"><small class="text-muted d-block">CO Date
                                                                                                                    Approved</small><span>@(selectedDetails.CoDateApproved?.ToString("MMMM dd, yyyy") ?? "—")</span>
                                                                                                                </div>
                                                                                                            </div>

                                                                                                            <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">
                                                                                                                <i class="bi bi-file-earmark-pdf me-1"></i>Documents
                                                                                                                @if (selectedDetails!.HasDocuments)
                                                                                                                {
                                                                                                                    <span class="badge bg-primary ms-2" style="font-size:10px;">
                                                                                                                        Has Attachments
                                                                                                                    </span>
                                                                                                                }
                                                                                                            </h6>
                                                                                                            <BeneficiaryDocumentUpload EditId="@selectedDetails!.Id" PsgcCodeMunicipality="@selectedDetails.PsgcCodeMunicipality"
                                                                                                                                       OnDeleteComplete="@(() => detailsOffcanvas.ShowAsync())" />
                                                                                                        }
                                                                                                    </BodyTemplate>
                                                                                                    @* ── Offcanvas footer — Edit and Delete always visible ── *@
                                                                                                    <FooterTemplate>
                                                                                                        <div class="d-flex justify-content-between align-items-center w-100">
                                                                                                            <div class="d-flex gap-2">
                                                                                                                <button class="btn btn-outline-secondary px-4" @onclick="() => detailsOffcanvas.HideAsync()">
                                                                                                                    Close
                                                                                                                </button>
                                                                                                                <button class="btn btn-outline-info px-4" @onclick="() => OpenLogModal(selectedDetails!)" title="Logs">
                                                                                                                    <i class="bi bi-clock-history me-1"></i>Logs
                                                                                                                </button>
                                                                                                                @* ✅ Always visible — API gate handles unauthorized edit *@
                                                                                                                <button class="btn btn-outline-primary px-4"
                                                                                                                        @onclick="async () => { await OpenEditConfirmationModal(selectedDetails!, selectedDetails!.Id); }">
                                                                                                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                                                                                                </button>
                                                                                                            </div>
                                                                                                            @* ✅ Always visible — API gate handles unauthorized delete *@
                                                                                                            <button class="btn btn-outline-danger px-4"
                                                                                                                    @onclick="async () => { await detailsOffcanvas.HideAsync(); await OpenDeleteConfirmationModal(selectedDetails!); }"
                                                                                                                    title="Delete">
                                                                                                                <i class="bi bi-trash me-1"></i>Delete
                                                                                                            </button>
                                                                                                        </div>
                                                                                                    </FooterTemplate>
                                                                                                </HxOffcanvas>

                                                                                                <HxModal @ref="logModal" Size="ModalSize.ExtraLarge">
                                                                                                    <HeaderTemplate>
                                                                                                        <h5 class="modal-title">Logs - @selectedBeneficiaryName</h5>
                                                                                                    </HeaderTemplate>
                                                                                                    <BodyTemplate>
                                                                                                        @if (IsLogsLoading)
                                                                                                        {
                                                                                                            <div class="text-center py-4">
                                                                                                                <div class="spinner-border text-primary" role="status"></div>
                                                                                                                <p class="mt-2 mb-0">Loading logs...</p>
                                                                                                            </div>
                                                                                                        }
                                                                                                        else if (logs == null || !logs.Any())
                                                                                                        {
                                                                                                            <div class="alert alert-info mb-0">No logs found for this beneficiary.</div>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <div style="max-height:500px; overflow-y:auto;">
                                                                                                                <div class="table-responsive">
                                                                                                                    <table class="table table-hover table-striped align-middle mb-0">
                                                                                                                        <thead class="table-light" style="position:sticky; top:0; z-index:1;">
                                                                                                                            <tr>
                                                                                                                                <th style="width:70px;">#</th>
                                                                                                                                <th>Activity</th>
                                                                                                                                <th style="width:180px;">User</th>
                                                                                                                                <th style="width:200px;">Date Created</th>
                                                                                                                            </tr>
                                                                                                                        </thead>
                                                                                                                        <tbody>
                                                                                                                            @for (int i = 0; i < logs.Count; i++)
                                                                                                                            {
                                                                                                                                var log = logs[i];
                                                                                                                                <tr>
                                                                                                                                    <td>@(i + 1)</td>
                                                                                                                                    <td>@log.Activity</td>
                                                                                                                                    <td>@log.UserName</td>
                                                                                                                                    <td>@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                                                                                                                                </tr>
                                                                                                                            }
                                                                                                                        </tbody>
                                                                                                                    </table>
                                                                                                                </div>
                                                                                                            </div>
                                                                                                        }
                                                                                                    </BodyTemplate>
                                                                                                    <FooterTemplate>
                                                                                                        <HxButton Type="ButtonType.Button" Color="ThemeColor.Secondary" @onclick="CloseLogModal">
                                                                                                            Close
                                                                                                        </HxButton>
                                                                                                    </FooterTemplate>
                                                                                                </HxModal>

                                                                                                <PayrollModal @ref="_payrollModal" />

                                                                                                <HxModal @ref="confirmModal">
                                                                                                    <HeaderTemplate>
                                                                                                        <h5 class="modal-title">@confirmationTitle</h5>
                                                                                                    </HeaderTemplate>
                                                                                                    <BodyTemplate>
                                                                                                        <p class="mb-0">@confirmationMessage</p>
                                                                                                    </BodyTemplate>
                                                                                                    <FooterTemplate>
                                                                                                        <HxButton Type="ButtonType.Button" Color="ThemeColor.Secondary" @onclick="CloseConfirmationModal">
                                                                                                            Cancel
                                                                                                        </HxButton>
                                                                                                        <HxButton Type="ButtonType.Button" Color="ThemeColor.Primary" @onclick="ConfirmActionAsync"
                                                                                                                  Disabled="@IsSaving">
                                                                                                            @if (IsSaving)
                                                                                                            {
                                                                                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                                                                                <span>Processing...</span>
                                                                                                            }
                                                                                                            else
                                                                                                            {
                                                                                                                <span>Yes, Confirm</span>
                                                                                                            }
                                                                                                        </HxButton>
                                                                                                    </FooterTemplate>
                                                                                                </HxModal>
                                                                                                <HxModal @ref="_duplicateModal" Size="ModalSize.ExtraLarge">
                                                                                                    <HeaderTemplate>
                                                                                                        <div class="d-flex align-items-center gap-2">
                                                                                                            <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                                                                                            <h5 class="mb-0">
                                                                                                                Possible Duplicate Records
                                                                                                                @if (_duplicateSummary is not null)
                                                                                                                {
                                                                                                                    <span class="badge bg-warning text-dark ms-2 fw-normal">
                                                                                                                        @_duplicateSummary.TotalPairs pair(s) found
                                                                                                                    </span>
                                                                                                                }
                                                                                                            </h5>
                                                                                                        </div>
                                                                                                    </HeaderTemplate>
                                                                                                    <BodyTemplate>
                                                                                                        @if (_duplicateSummary?.Pairs is null || !_duplicateSummary.Pairs.Any())
                                                                                                        {
                                                                                                            <div class="alert alert-success mb-0">
                                                                                                                <i class="bi bi-check-circle-fill me-2"></i>No possible duplicates found.
                                                                                                            </div>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            @* ── Two column layout when a record is being viewed ─────── *@
                                                                                                            <div class="d-flex gap-3 duplicate-compare-wrap @(_duplicateViewingId.HasValue || _isDuplicateDetailLoading ? "duplicate-compare-wrap--viewing" : "")" style="min-height: 500px;">

                                                                                                                @* ── LEFT: pairs table ───────────────────────────────── *@
                                                                                                                <div class="duplicate-compare-list" style="flex: 1; min-width: 0;">

                                                                                                                    <p class="text-muted small mb-2">
                                                                                                                        Similar name and birthdate flagged as possible duplicates.
                                                                                                                        Click <strong>View</strong> to compare side by side before editing.
                                                                                                                        <span class="badge bg-danger bg-opacity-25 text-danger ms-1">Red rows</span>
                                                                                                                        have at least one <strong>Paid</strong> record.
                                                                                                                    </p>

                                                                                                                    @* ── Filter bar ──────────────────────────────────── *@
                                                                                                                    <div class="d-flex gap-2 mb-2 flex-wrap align-items-center">
                                                                                                                        <div class="input-group input-group-sm" style="max-width:200px;">
                                                                                                                            <span class="input-group-text">
                                                                                                                                <i class="bi bi-search"></i>
                                                                                                                            </span>
                                                                                                                            <input type="text" class="form-control" placeholder="Search name..."
                                                                                                                                   @bind="_duplicateSearchTerm" @bind:event="oninput" />
                                                                                                                        </div>
                                                                                                                        <select class="form-select form-select-sm w-auto" @bind="_duplicateReasonFilter">
                                                                                                                            <option value="">All reasons</option>
                                                                                                                            <option value="same birthdate">Same birthdate</option>
                                                                                                                            <option value="birthdate">Similar birthdate (±)</option>
                                                                                                                            <option value="DIFFERENT middle">Different middle name</option>
                                                                                                                        </select>
                                                                                                                        <span class="text-muted small ms-auto">
                                                                                                                            @FilteredDuplicatePairs.Count() of
                                                                                                                            @_duplicateSummary.Pairs.Count pair(s)
                                                                                                                        </span>
                                                                                                                    </div>

                                                                                                                    @* ── Pairs table ─────────────────────────────────── *@
                                                                                                                    <div style="max-height: 460px; overflow-y: auto;">
                                                                                                                        <table class="table table-sm table-bordered align-middle mb-0">
                                                                                                                            <thead class="table-warning" style="position: sticky; top: 0; z-index: 1;">
                                                                                                                                <tr>
                                                                                                                                    <th style="width:30px;">#</th>
                                                                                                                                    <th>Reason</th>
                                                                                                                                    <th style="width:56px;">Match</th>
                                                                                                                                    <th>Record 1</th>
                                                                                                                                    <th>Record 2</th>
                                                                                                                                    <th style="width:90px;">Actions</th>
                                                                                                                                </tr>
                                                                                                                            </thead>
                                                                                                                            <tbody>
                                                                                                                                @{
                                                                                                                                    var filteredPairs = FilteredDuplicatePairs.ToList();
                                                                                                                                }
                                                                                                                                @if (!filteredPairs.Any())
                                                                                                                                {
                                                                                                                                    <tr>
                                                                                                                                        <td colspan="6" class="text-center text-muted py-3">
                                                                                                                                            No pairs match your filter.
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                }
                                                                                                                                @foreach (var (pair, idx) in filteredPairs
                                                                                                                                    .Select((p, i) => (p, i + 1)))
                                                                                                                                {
                                                                                                                                    bool hasPaid = pair.Record1PaymentStatus == 2
                                                                                                                                               || pair.Record2PaymentStatus == 2;

                                                                                                                                    // ✅ Highlight the currently viewed pair
                                                                                                                                    bool isViewing =
                                                                                                                                        _duplicateViewingId == pair.Record1Id ||
                                                                                                                                        _duplicateViewingId == pair.Record2Id;

                                                                                                                                    <tr class="@(hasPaid ? "table-danger" : "")
                                                                                                                                        @(isViewing ? "table-primary" : "")"
                                                                                                                                        style="cursor:pointer;">
                                                                                                                                        <td class="text-center text-muted small">
                                                                                                                                            @idx
                                                                                                                                        </td>
                                                                                                                                        <td>
                                                                                                                                            <span class="badge @GetDuplicateReasonBadgeClass(pair.MatchReason) small"
                                                                                                                                                  style="font-size:10px; white-space:normal;">
                                                                                                                                                @pair.MatchReason
                                                                                                                                            </span>
                                                                                                                                        </td>
                                                                                                                                        <td class="text-center">
                                                                                                                                            <span class="badge bg-warning text-dark" style="font-size:10px;">
                                                                                                                                                @((pair.MatchScore * 100).ToString("F0"))%
                                                                                                                                            </span>
                                                                                                                                        </td>
                                                                                                                                        <td>
                                                                                                                                            <div class="fw-semibold" style="font-size:11px;">
                                                                                                                                                @pair.Record1FullName
                                                                                                                                            </div>
                                                                                                                                            <div class="text-muted" style="font-size:10px;">
                                                                                                                                                @pair.Record1BirthDate
                                                                                                                                            </div>
                                                                                                                                            <div class="text-muted" style="font-size:10px;">
                                                                                                                                                @pair.Record1Municipality
                                                                                                                                                @if (!string.IsNullOrWhiteSpace(pair.Record1Barangay))
                                                                                                                                                {
                                                                                                                                                    <span> — @pair.Record1Barangay</span>
                                                                                                                                                }
                                                                                                                                            </div>
                                                                                                                                            @if (pair.Record1PaymentStatus == 2)
                                                                                                                                            {
                                                                                                                                                <span class="badge bg-success" style="font-size:9px;">
                                                                                                                                                    Paid
                                                                                                                                                </span>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                        <td>
                                                                                                                                            <div class="fw-semibold" style="font-size:11px;">
                                                                                                                                                @pair.Record2FullName
                                                                                                                                            </div>
                                                                                                                                            <div class="text-muted" style="font-size:10px;">
                                                                                                                                                @pair.Record2BirthDate
                                                                                                                                            </div>
                                                                                                                                            <div class="text-muted" style="font-size:10px;">
                                                                                                                                                @pair.Record2Municipality
                                                                                                                                                @if (!string.IsNullOrWhiteSpace(pair.Record2Barangay))
                                                                                                                                                {
                                                                                                                                                    <span> — @pair.Record2Barangay</span>
                                                                                                                                                }
                                                                                                                                            </div>
                                                                                                                                            @if (pair.Record2PaymentStatus == 2)
                                                                                                                                            {
                                                                                                                                                <span class="badge bg-success" style="font-size:9px;">
                                                                                                                                                    Paid
                                                                                                                                                </span>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                        <td>
                                                                                                                                            <div class="d-flex flex-column gap-1">

                                                                                                                                                @* ✅ View button — loads details panel *@
                                                                                                                                                <button class="btn btn-xs btn-outline-info btn-sm" style="font-size:11px;"
                                                                                                                                                        @onclick="async () => await LoadDuplicateCompareAsync(pair)">
                                                                                                                                                    <i class="bi bi-eye me-1"></i>View
                                                                                                                                                </button>

                                                                                                                                                <button class="btn btn-xs btn-outline-primary btn-sm" style="font-size:11px;"
                                                                                                                                                        @onclick="async () => await NavigateToDuplicateEdit(pair.Record1Id)">
                                                                                                                                                    <i class="bi bi-pencil-square me-1"></i>Edit #1
                                                                                                                                                </button>
                                                                                                                                                <button class="btn btn-xs btn-outline-primary btn-sm" style="font-size:11px;"
                                                                                                                                                        @onclick="async () => await NavigateToDuplicateEdit(pair.Record2Id)">
                                                                                                                                                    <i class="bi bi-pencil-square me-1"></i>Edit #2
                                                                                                                                                </button>
                                                                                                                                            </div>
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                }
                                                                                                                            </tbody>
                                                                                                                        </table>
                                                                                                                    </div>
                                                                                                                </div>

                                                                                                                @* ── RIGHT: side-by-side comparison panel ────────────── *@
                                                                                                                @if (_duplicateViewingId.HasValue || _isDuplicateDetailLoading)
                                                                                                                {
                                                                                                                    <div class="duplicate-compare-detail"
                                                                                                                    style="width: 520px; flex-shrink: 0; border-left: 1px solid var(--bs-border-color); padding-left: 1rem; overflow-y: auto; max-height: 500px;">

                                                                                                                        @if (_isDuplicateDetailLoading)
                                                                                                                        {
                                                                                                                            <div class="d-flex align-items-center gap-2 py-4 justify-content-center">
                                                                                                                                <span class="spinner-border spinner-border-sm"></span>
                                                                                                                                <span class="text-muted small">Loading records...</span>
                                                                                                                            </div>
                                                                                                                        }
                                                                                                                        else if (_duplicateRecord1 is not null && _duplicateRecord2 is not null)
                                                                                                                        {
                                                                                                                            @* ── Comparison header ────────────────────── *@
                                                                                                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                                                                                                <button class="btn btn-sm btn-outline-secondary duplicate-compare-back" @onclick="CloseDuplicateCompare">
                                                                                                                                    <i class="bi bi-arrow-left me-1"></i>Back
                                                                                                                                </button>
                                                                                                                                <h6 class="mb-0 fw-bold duplicate-compare-title">
                                                                                                                                    <i class="bi bi-columns-gap me-1"></i>
                                                                                                                                    Side-by-Side Comparison
                                                                                                                                </h6>
                                                                                                                                <button class="btn btn-sm btn-outline-secondary duplicate-compare-close" @onclick="CloseDuplicateCompare">
                                                                                                                                    <i class="bi bi-x"></i>
                                                                                                                                </button>
                                                                                                                            </div>

                                                                                                                            @* ── Column headers ───────────────────────── *@
                                                                                                                            <div class="row g-0 mb-1">
                                                                                                                                <div class="col-6 text-center">
                                                                                                                                    <span class="badge bg-primary w-100">Record 1</span>
                                                                                                                                </div>
                                                                                                                                <div class="col-6 text-center ps-1">
                                                                                                                                    <span class="badge bg-secondary w-100">Record 2</span>
                                                                                                                                </div>
                                                                                                                            </div>

                                                                                                                            @* ── Comparison rows ─────────────────────────────────────────── *@
                                                                                                                            <table class="table table-sm table-bordered mb-2" style="font-size: 11px;">
                                                                                                                                <tbody>

                                                                                                                                    @* Last Name *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            Last Name
                                                                                                                                            @if (!string.Equals(_duplicateRecord1.LastName?.Trim(),
                                                                                                                                                            _duplicateRecord2.LastName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr class="@DiffClass(_duplicateRecord1.LastName, _duplicateRecord2.LastName)">
                                                                                                                                        <td style="width:50%;">@(_duplicateRecord1.LastName ?? "—")</td>
                                                                                                                                        <td style="width:50%;">@(_duplicateRecord2.LastName ?? "—")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* First Name *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            First Name
                                                                                                                                            @if (!string.Equals(_duplicateRecord1.FirstName?.Trim(),
                                                                                                                                                            _duplicateRecord2.FirstName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr class="@DiffClass(_duplicateRecord1.FirstName, _duplicateRecord2.FirstName)">
                                                                                                                                        <td>@(_duplicateRecord1.FirstName ?? "—")</td>
                                                                                                                                        <td>@(_duplicateRecord2.FirstName ?? "—")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* Middle Name *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            Middle Name
                                                                                                                                            @if (!string.Equals(_duplicateRecord1.MiddleName?.Trim(),
                                                                                                                                                            _duplicateRecord2.MiddleName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr class="@DiffClass(_duplicateRecord1.MiddleName, _duplicateRecord2.MiddleName)">
                                                                                                                                        <td>@(_duplicateRecord1.MiddleName ?? "—")</td>
                                                                                                                                        <td>@(_duplicateRecord2.MiddleName ?? "—")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* Extension *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            Extension
                                                                                                                                            @if (!string.Equals(_duplicateRecord1.Extension?.Trim(),
                                                                                                                                                            _duplicateRecord2.Extension?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr class="@DiffClass(_duplicateRecord1.Extension, _duplicateRecord2.Extension)">
                                                                                                                                        <td>@(_duplicateRecord1.Extension ?? "—")</td>
                                                                                                                                        <td>@(_duplicateRecord2.Extension ?? "—")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* Birth Date *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            Birth Date
                                                                                                                                            @if (_duplicateRecord1.BirthDate.Date != _duplicateRecord2.BirthDate.Date)
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr
                                                                                                                                        class="@DiffClass(_duplicateRecord1.BirthDate.ToString("MMMM dd, yyyy"), _duplicateRecord2.BirthDate.ToString("MMMM dd, yyyy"))">
                                                                                                                                        <td>@_duplicateRecord1.BirthDate.ToString("MMMM dd, yyyy")</td>
                                                                                                                                        <td>@_duplicateRecord2.BirthDate.ToString("MMMM dd, yyyy")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* Sex *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            Sex
                                                                                                                                            @if (_duplicateRecord1.Sex != _duplicateRecord2.Sex)
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr class="@DiffClass(GetSexText(_duplicateRecord1.Sex), GetSexText(_duplicateRecord2.Sex))">
                                                                                                                                        <td>@GetSexText(_duplicateRecord1.Sex)</td>
                                                                                                                                        <td>@GetSexText(_duplicateRecord2.Sex)</td>
                                                                                                                                    </tr>

                                                                                                                                    @* OSCA ID *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            OSCA ID
                                                                                                                                            @if (!string.Equals(_duplicateRecord1.OscaIdNumber?.Trim(),
                                                                                                                                                            _duplicateRecord2.OscaIdNumber?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr class="@DiffClass(_duplicateRecord1.OscaIdNumber, _duplicateRecord2.OscaIdNumber)">
                                                                                                                                        <td>@(_duplicateRecord1.OscaIdNumber ?? "—")</td>
                                                                                                                                        <td>@(_duplicateRecord2.OscaIdNumber ?? "—")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* NCSC RRN *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            NCSC RRN
                                                                                                                                            @if (_duplicateRecord1.NcscRrn != _duplicateRecord2.NcscRrn)
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr
                                                                                                                                        class="@DiffClass(_duplicateRecord1.NcscRrn?.ToString(), _duplicateRecord2.NcscRrn?.ToString())">
                                                                                                                                        <td>@(_duplicateRecord1.NcscRrn?.ToString() ?? "—")</td>
                                                                                                                                        <td>@(_duplicateRecord2.NcscRrn?.ToString() ?? "—")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* Batch Code *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            Batch Code
                                                                                                                                            @if (!string.Equals(_duplicateRecord1.BatchCode?.Trim(),
                                                                                                                                                            _duplicateRecord2.BatchCode?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr class="@DiffClass(_duplicateRecord1.BatchCode, _duplicateRecord2.BatchCode)">
                                                                                                                                        <td>@(_duplicateRecord1.BatchCode ?? "—")</td>
                                                                                                                                        <td>@(_duplicateRecord2.BatchCode ?? "—")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* Province *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            Province
                                                                                                                                            @if (!string.Equals(_duplicateRecord1.ProvinceName?.Trim(),
                                                                                                                                                            _duplicateRecord2.ProvinceName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr class="@DiffClass(_duplicateRecord1.ProvinceName, _duplicateRecord2.ProvinceName)">
                                                                                                                                        <td>@(_duplicateRecord1.ProvinceName ?? "—")</td>
                                                                                                                                        <td>@(_duplicateRecord2.ProvinceName ?? "—")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* Municipality *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            Municipality
                                                                                                                                            @if (!string.Equals(_duplicateRecord1.MunicipalityName?.Trim(),
                                                                                                                                                            _duplicateRecord2.MunicipalityName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
                                                                                                                                    <tr class="@DiffClass(_duplicateRecord1.MunicipalityName, _duplicateRecord2.MunicipalityName)">
                                                                                                                                        <td>@(_duplicateRecord1.MunicipalityName ?? "—")</td>
                                                                                                                                        <td>@(_duplicateRecord2.MunicipalityName ?? "—")</td>
                                                                                                                                    </tr>

                                                                                                                                    @* Barangay *@
                                                                                                                                    <tr style="background: var(--bs-light);">
                                                                                                                                        <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                                                                                                            Barangay
                                                                                                                                            @if (!string.Equals(_duplicateRecord1.BarangayName?.Trim(),
                                                                                                                                                            _duplicateRecord2.BarangayName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                                                                                                            {
                                                                                                                                                <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                                                                                                            }
                                                                                                                                        </td>
                                                                                                                                    </tr>
