    private int? GetAge(DateTime? birthDate)
    {
        if (birthDate == null)
            return null;

        var today = DateTime.Today;
        var age = today.Year - birthDate.Value.Year;

        if (birthDate.Value.Date > today.AddYears(-age))
            age--;

        return age;
    }
    private string GetFindingStatusText(int? status) => status switch
    {
        0 => "N/A",
        1 => "Solved",
        2 => "Unresolved",
        _ => "N/A"        // null = no finding record yet
    };

    private string GetFindingBadgeClass(int? status) => status switch
    {
        0 => "no-g",     // grey  — N/A
        1 => "yes-g",    // green — Solved
        2 => "unpaid",   // red   — Unresolved
        _ => "no-g"      // grey  — not yet set
    };
    private string GetAgeBadgeClass(DateTime birthDate)
{
    var age = GetAge(birthDate);
    if (age == null || age < 80) return "unpaid";   // red

    int currentYear = DateTime.Today.Year;
    int[] milestones = new[] { 100, 95, 90, 85, 80 };
    int milestoneYear = 0;
    foreach (var m in milestones)
    {
        int my = birthDate.Year + m;
        if (my <= currentYear && my >= 2024) { milestoneYear = my; break; }
    }

    if (milestoneYear == 0) return "pending";

    int windowStart = Math.Max(2024, currentYear - 2);
    if (milestoneYear >= windowStart && milestoneYear <= currentYear)
        return "yes-g";      // green — active window

    return "no-g";           // grey — past window
}

private string GetPaymentBadgeClass(int status) => status switch
{
    1 => "unpaid",    // red
    2 => "paid",      // green
    3 => "unpaid",    // red
    _ => "no-g"       // grey
};
    private string GetFullName(BeneficiaryInformationDto item)
    {
        var middle = string.IsNullOrWhiteSpace(item.MiddleName) ? "" : $" {item.MiddleName}";
        var extension = string.IsNullOrWhiteSpace(item.Extension) ? "" : $" {item.Extension}";
        return $"{item.LastName}, {item.FirstName}{middle}{extension}";
    }
