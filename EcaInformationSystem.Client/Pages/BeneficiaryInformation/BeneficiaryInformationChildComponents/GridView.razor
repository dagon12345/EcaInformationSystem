        try
        {
            IsGeneratingPayroll = true;
            StateHasChanged();
            var response = await Http.PostAsJsonAsync("api/payroll/generate-payroll", new { Ids = checkedIds.ToList() });
            if (!response.IsSuccessStatusCode)
            {
                toast.ShowError($"Payroll generation failed: {await
response.Content.ReadAsStringAsync()}"); return;
            }
            var fileBytes = await response.Content.ReadAsByteArrayAsync();
            if (fileBytes == null || fileBytes.Length == 0)
            {
                toast.ShowError("No data returned from payroll generation."); return;
            }
            await JS.InvokeVoidAsync("downloadFile", $"CashGiftPayroll_{DateTime.Now:yyyy-MM-dd}.xlsx",
Convert.ToBase64String(fileBytes));
            toast.ShowSuccess($"Payroll generated for {checkedIds.Count} record(s).");
        }
        catch (Exception ex) { toast.ShowError($"Payroll generation failed: {ex.Message}"); }
        finally { IsGeneratingPayroll = false; }
    }

