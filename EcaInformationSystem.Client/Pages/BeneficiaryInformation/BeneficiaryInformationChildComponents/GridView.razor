                                                                    Status</small><span>@GetCivilStatusText(selectedDetails.CivilStatus)</span></div>
                                                                    <div class="col-6"><small
                                                                        class="text-muted d-block">Citizenship</small><span>@GetCitizenshipText(selectedDetails.Citizenship)</span>
                                                                    </div>
                                                                    <div class="col-6"><small class="text-muted d-block">Indigenous
                                                                        People</small><span>@(selectedDetails.IsIndigenousPeople ? "Yes" : "No")</span></div>
                                                                        <div class="col-6"><small class="text-muted d-block">Person with
                                                                            Disability</small><span>@(selectedDetails.IsPersonWithDisability ? "Yes" : "No")</span></div>
                                                                        </div>

                                                                        <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Address Information</h6>
