    private string? GetCoProcessingDuration(DateTime? endorsed, DateTime? approved)
    {
        if (!endorsed.HasValue || !approved.HasValue) return null;
        var days = (approved.Value.Date - endorsed.Value.Date).Days;
        if (days < 0) return null; // guards against bad/out-of-order data instead of showing "-3 days"
        return days == 0 ? "same day" : $"{days} day{(days == 1 ? "" : "s")}";
    }
