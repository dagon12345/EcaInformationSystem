@using EcaInformationService.Shared.DTOs
@using EcaInformationSystem.Client.Pages.BeneficiaryInformation.Helpers
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject ToastService toast
@inject IJSRuntime JS
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BeneficiaryStateService State;

@* ── No scan yet — shown before user applies any filter ─────────────────── *@
@if (_duplicateSummary is null && !_isLoadingDuplicates)
{
    <div class="alert alert-secondary d-flex align-items-center gap-2 mb-3 py-2">
        <i class="bi bi-info-circle flex-shrink-0 text-muted"></i>
        <span class="small text-muted">
            Apply a filter above to scan for possible duplicate records.
            You can also
            <button class="btn btn-link btn-sm p-0 align-baseline" @onclick="RunDuplicateScanAsync">
                scan all records manually
            </button>
            (may be slow on large datasets).
        </span>
    </div>
}

@* ── Scanning indicator ───────────────────────────────────────────────────── *@
@if (_isLoadingDuplicates)
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2">
        <span class="spinner-border spinner-border-sm flex-shrink-0"></span>
        <span class="small">Scanning for possible duplicate records...</span>
    </div>
}

@* ── Timeout warning ──────────────────────────────────────────────────────── *@
@if (_duplicateSummary is not null
     && _duplicateSummary.TimedOut
     && !_dismissedDuplicateBanner)
{
    <div class="alert alert-secondary d-flex align-items-center gap-3 mb-3 py-2" role="alert">
        <i class="bi bi-clock-history fs-5 flex-shrink-0"></i>
        <div class="flex-grow-1">
            <strong>Duplicate scan timed out</strong>
            <p class="mb-0 small text-muted">
                The dataset is too large to scan all at once.
                Try filtering by province first, then rescan.
            </p>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <button class="btn btn-sm btn-outline-secondary" @onclick="RescanDuplicatesAsync">
                <i class="bi bi-arrow-clockwise me-1"></i>Rescan
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _dismissedDuplicateBanner = true">
                Dismiss
            </button>
        </div>
    </div>
}

@* ── Results banner ───────────────────────────────────────────────────────── *@
@if (_duplicateSummary is not null
     && !_duplicateSummary.TimedOut
     && _duplicateSummary.TotalPairs > 0
     && !_dismissedDuplicateBanner)
{
    <div class="alert alert-warning d-flex align-items-center gap-3 mb-3 shadow-sm py-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0"></i>
        <div class="flex-grow-1">
            <strong>Possible duplicate records detected</strong>
            <p class="mb-0 small text-muted">
                Found <strong>@_duplicateSummary.TotalPairs</strong>
                possible duplicate pair(s) in the current filtered results.
                Please review to ensure data accuracy.
            </p>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <button class="btn btn-sm btn-warning fw-semibold" @onclick="OpenDuplicateReviewModal">
                <i class="bi bi-search me-1"></i>Review
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _dismissedDuplicateBanner = true">
                Dismiss
            </button>
        </div>
    </div>
}

@* ── No duplicates found ───────────────────────────────────────────────────── *@
@if (_duplicateSummary is not null
     && !_duplicateSummary.TimedOut
     && _duplicateSummary.TotalPairs == 0
     && !_dismissedDuplicateBanner)
{
    <div class="alert alert-success d-flex align-items-center gap-3 mb-3 py-2">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <div class="flex-grow-1 small">
            No possible duplicate records found in the current filtered results.
        </div>
        <button class="btn btn-sm btn-outline-secondary flex-shrink-0" @onclick="() => _dismissedDuplicateBanner = true">
            Dismiss
        </button>
    </div>
}
<!-- List/Grid Section -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex flex-column">
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="mb-0">Showing</h5>
                                <span class="badge bg-primary">@DisplayCount Record(s)</span>
                            </div>
                            <small class="opacity-75 mt-1">Select the checkbox to Bulk Update payment status or Create
                                Payroll</small>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-info" @onclick="GoToDashboardSummary">
                                Dashboard Summary
                            </button>

                            <button class="btn btn-sm btn-warning" @onclick="OpenPayrollModal"
                                    disabled="@(!checkedIds.Any() || IsGeneratingPayroll)">
                                @if (IsGeneratingPayroll)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Opening...</span>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-excel me-1"></i>
                                    <span>Generate Payroll</span>
                                }
                            </button>

                            <button class="btn btn-success" @onclick="ExportExcel"
                                    disabled="@(!checkedIds.Any() || IsExporting)">

                                @if (IsExporting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Exporting...</span>
                                }
                                else
                                {
                                    <span class="bi bi-file-earmark-excel me-1">Export Excel</span>
                                }
                            </button>
                        </div>
                    </div>

                </div>
                <div class="card-body p-3">
                    <div class="records-table-wrap">

                        @* ── BULK BAR ────────────────────────────────────────── *@
                        <div class="bulk-bar">
                            <span class="sel-count">@checkedIds.Count selected</span>

                            @* ── Tab switcher ── *@
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button"
                                        class="btn @(activeBulkTab == "payment" ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick='() => activeBulkTab = "payment"'>
                                    <i class="bi bi-cash-coin me-1"></i>Payment
                                </button>
                                <button type="button"
                                        class="btn @(activeBulkTab == "other" ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick='() => activeBulkTab = "other"'>
                                    <i class="bi bi-pencil-square me-1"></i>Eligibility / Batch
                                </button>
                                <button type="button"
                                        class="btn @(activeBulkTab == "costatus" ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick='() => activeBulkTab = "costatus"'>
                                    <i class="bi bi-building-check me-1"></i>CO Status
                                </button>
                                <button type="button"
                                        class="btn @(activeBulkTab == "refnumber" ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick='() => activeBulkTab = "refnumber"'>
                                    <i class="bi bi-hash me-1"></i>Ref Number
                                </button>
                            </div>

                            @* ── Payment tab ── *@
                            @if (activeBulkTab == "payment")
                            {
                                <select class="form-select form-select-sm w-auto" @bind="bulkPaymentStatus">
                                    <option value="">-- Set Payment Status --</option>
                                    <option value="0">N/A</option>
                                    <option value="1">Unpaid</option>
                                    <option value="2">Paid</option>
                                    <option value="3">Pending</option>
                                </select>

                                @* ✅ Mode of Payment — only enabled when Paid (2) *@
                                <select class="form-select form-select-sm w-auto" @bind="bulkModeOfPayment"
                                        disabled="@(bulkPaymentStatus != 2)">
                                    <option value="">-- Mode of Payment --</option>
                                    <option value="1">Cash Advance by SDO</option>
                                    <option value="2">Bank Transfer</option>
                                </select>


                                <InputDate class="form-control form-control-sm w-auto" TValue="DateTime?"
                                           @bind-Value="bulkPaymentDate" disabled="@(bulkPaymentStatus != 2)" />

                                <button class="btn btn-sm btn-primary" @onclick="OpenBulkUpdateModal"
                                        disabled="@(!checkedIds.Any()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        || bulkPaymentStatus == null || (bulkPaymentStatus == 2 && bulkPaymentDate == null)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        || IsBulkUpdating)">
                                    @if (IsBulkUpdating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>Updating...</span>
                                    }
                                    else
                                    {
                                        <span>Apply Payment</span>
                                    }
                                </button>
                            }

                            @* ── Eligibility / Batch Code tab ── *@
                            @if (activeBulkTab == "other")
                            {
                                <select class="form-select form-select-sm w-auto" @bind="bulkIsEligible">
                                    <option value="">-- Eligibility (no change) --</option>
                                    <option value="true">Eligible</option>
                                    <option value="false">Ineligible</option>
                                </select>

                                <input class="form-control form-control-sm" style="max-width:160px;"
                                       placeholder="Batch Code (leave blank = no change)" @bind="bulkBatchCode"
                                       @bind:event="oninput" />

                                <button class="btn btn-sm btn-primary" @onclick="OpenBulkOtherUpdateModal"
                                        disabled="@(!checkedIds.Any() || (string.IsNullOrWhiteSpace(bulkBatchCode) && string.IsNullOrWhiteSpace(bulkIsEligible))
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        || IsBulkUpdatingOther)">
                                    @if (IsBulkUpdatingOther)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>Updating...</span>
                                    }
                                    else
                                    {
                                        <span>Apply Changes</span>
                                    }
                                </button>
                            }
                            @* ── CO Status tab ── *@
                            @if (activeBulkTab == "costatus")
                            {
                                <select class="form-select form-select-sm w-auto" @bind="bulkCoStatus">
                                    <option value="">-- Set CO Status --</option>
                                    <option value="1">Endorsed</option>
                                    <option value="2">Approved</option>
                                </select>

                                @if (bulkCoStatus == "1")
                                {
                                    <input type="date" class="form-control form-control-sm w-auto" @bind="bulkCoDateEndorsed" />
                                }

                                @if (bulkCoStatus == "2")
                                {
                                    <input type="date" class="form-control form-control-sm w-auto" @bind="bulkCoDateApproved" />
                                }

                                <button class="btn btn-sm btn-primary" @onclick="OpenBulkCoStatusModal"
                                        disabled="@(!checkedIds.Any() || string.IsNullOrWhiteSpace(bulkCoStatus) || (bulkCoStatus == "1" && bulkCoDateEndorsed == null)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        || (bulkCoStatus == "2" && bulkCoDateApproved == null) || IsBulkUpdatingCoStatus)">
                                    @if (IsBulkUpdatingCoStatus)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>Updating...</span>
                                    }
                                    else
                                    {
                                        <span>Apply CO Status</span>
                                    }
                                </button>
                            }
                            @* ── Reference Number bulk tab ── *@
                            @if (activeBulkTab == "refnumber")
                            {
                                <select class="form-select form-select-sm w-auto" @bind="bulkRefQuarter">
                                    <option value="">-- Quarter --</option>
                                    <option value="1">Q1</option>
                                    <option value="2">Q2</option>
                                    <option value="3">Q3</option>
                                    <option value="4">Q4</option>
                                </select>

                                <input class="form-control form-control-sm" style="max-width:100px;" placeholder="Batch e.g. 1"
                                       value="@bulkRefBatch" @oninput="OnBulkBatchInput" />

                                <input class="form-control form-control-sm" type="number" style="max-width:150px;"
                                       placeholder="Year e.g. 26" @bind="bulkRefYear" />

                                <button class="btn btn-sm btn-primary" @onclick="OpenBulkRefNumberModal"
                                        disabled="@(!checkedIds.Any()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 || string.IsNullOrWhiteSpace(bulkRefQuarter)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 || string.IsNullOrWhiteSpace(bulkRefBatch)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 || bulkRefYear == null
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 || IsBulkUpdatingRefNumber)">
                                    @if (IsBulkUpdatingRefNumber)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>Updating...</span>
                                    }
                                    else
                                    {
                                        <span>Apply Ref Number</span>
                                    }
                                </button>
                            }

                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection"
                                    disabled="@(!checkedIds.Any())">
                                Clear Selection
                            </button>
                        </div>

                        @* ── PAGINATION BAR ──────────────────────────────────── *@
                        <div class="pag-bar">
                            <span>
                                Showing
                                <strong>@(((State.Filter.PageNumber - 1) * State.Filter.PageSize) + 1)</strong>
                                –
                                <strong>@Math.Min(State.Filter.PageNumber * State.Filter.PageSize, DisplayCount)</strong>
                                of <strong>@DisplayCount</strong> record(s)
                                &nbsp;·&nbsp; Page @State.Filter.PageNumber of @State.TotalPages
                            </span>
                            <div class="pag-controls">
                                <button class="pag-btn" @onclick="GoToPreviousPageAsync"
                                        disabled="@(State.Filter.PageNumber <= 1 || State.IsLoading)">
                                    ← Prev
                                </button>
                                <span style="font-size:12px; color:var(--text-muted);">
                                    @State.Filter.PageNumber / @State.TotalPages
                                </span>
                                <button class="pag-btn" @onclick="GoToNextPageAsync"
                                        disabled="@(State.Filter.PageNumber >= State.TotalPages || State.IsLoading)">
                                    Next →
                                </button>
                                <select class="form-select form-select-sm w-auto" @bind="State.Filter.PageSize"
                                        @bind:after="OnPageSizeChangedAsync">
                                    <option value="10">10 / page</option>
                                    <option value="20">20 / page</option>
                                    <option value="50">50 / page</option>
                                    <option value="100">100 / page</option>
                                    <option value="500">500 / page</option>
                                    <option value="1000">1000 / page</option>
                                    <option value="5000">5000 / page</option>
                                </select>
                            </div>
                        </div>

                        @* ── TABLE CONTAINER ─────────────────────────────────── *@
                        <div class="tbl-container">

                            @* Havit spinner overlay *@
                            @if (State.IsLoading)
                            {
                                <div class="tbl-overlay">
                                    <HxSpinner Color="ThemeColor.Primary" Size="SpinnerSize.Regular" />
                                    <span class="ov-text">Loading records...</span>
                                </div>
                            }

                            <div class="tbl-scroll">
                                <table class="records-tbl">
                                    <thead>
                                        <tr>
                                            <th style="width:42px;">
                                                <input type="checkbox" class="form-check-input" checked="@AreAllChecked()"
                                                       @onchange="ToggleSelectAll" />
                                            </th>
                                            <th>Reference Number</th>

                                            @* -- Sortable Batch code -- *@
                                            <th class="sortable-th @(!State.Beneficiaries.Any() ? "sort-disabled" : "")"
                                                @onclick='() => SortBy("batchcode")'>
                                                <div class="sort-header">
                                                    <span>Batch Code</span>
                                                    <span class="sort-icon-wrap">
                                                        @if (_sortColumn == "batchcode")
                                                        {
                                                            <i
                                                            class="bi @(_sortAscending ? "bi-sort-up" : "bi-sort-down") sort-icon-active"></i>
                                                        }
                                                        else
                                                        {
                                                            <i
                                                            class="bi bi-arrow-down-up sort-icon-idle @(!State.Beneficiaries.Any() ? "sort-icon-hidden" : "")"></i>
                                                        }
                                                    </span>
                                                </div>
                                            </th>

                                            <th>Phone</th>
                                            <th>
                                                Full Name
                                                <input type="text" class="hdr-search" placeholder="Search name..."
                                                       @oninput="OnFullNameFilterInput" />
                                            </th>

                                            @* ── Sortable: Birth Date ── *@
                                            <th class="sortable-th @(!State.Beneficiaries.Any() ? "sort-disabled" : "")"
                                                @onclick='() => SortBy("birthdate")'>
                                                <div class="sort-header">
                                                    <span>Birth Date</span>
                                                    <span class="sort-icon-wrap">
                                                        @if (_sortColumn == "birthdate")
                                                        {
                                                            <i
                                                            class="bi @(_sortAscending ? "bi-sort-up" : "bi-sort-down") sort-icon-active"></i>
                                                        }
                                                        else
                                                        {
                                                            <i
                                                            class="bi bi-arrow-down-up sort-icon-idle @(!State.Beneficiaries.Any() ? "sort-icon-hidden" : "")"></i>
                                                        }
                                                    </span>
                                                </div>
                                            </th>

                                            <th>Age</th>
                                            <th>Milestone</th>
                                            <th>Sex</th>
                                            <th>Municipality</th>
                                            <th>Barangay</th>
                                            <th>Validator</th>
                                            <th>Payment</th>
                                            <th>Mode</th>
                                            <th>Eligible</th>
                                            <th>Compliant</th>
                                            <th>CO Findings</th>
                                            <th>CO Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <Virtualize Items="@FilteredBeneficiaries.ToList()" Context="item" ItemSize="56"
                                                    OverscanCount="5">
                                            <ItemContent>
                                                <tr class="@(checkedIds.Contains(item.Id) ? "row-checked" : "")">

                                                    <td>
                                                        <input type="checkbox" class="form-check-input"
                                                               checked="@checkedIds.Contains(item.Id)"
                                                               @onchange="() => ToggleCheck(item.Id)" />
                                                    </td>
                                                    <td>
                                                        @{
                                                            var refNo = item.ReferenceNumber;
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(refNo))
                                                        {
                                                            <span class="tbl-badge ref-no" title="@refNo">
                                                                @Highlight(refNo)
                                                            </span>
                                                        }
                                                        else if (item.Quarter.HasValue &&
                                                                 !string.IsNullOrWhiteSpace(item.Batch) &&
                                                                 item.RefYear.HasValue)
                                                        {
                                                            @* ✅ Quarter/Batch/Year set but RefCode missing — old record before
                                                    migration *@
                                                            <span class="tbl-badge ref-no text-muted" style="opacity:0.6;"
                                                                  title="Reference code not yet generated">
                                                                Q@(item.Quarter)B@(item.Batch)-@(item.RefYear?.ToString("D2"))-?????-@RegionRomanNumeralHelper.GetRoman(item.PsgcCodeRegion)
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">—</span>
                                                        }
                                                    </td>
                                                    <td>@Highlight(item.BatchCode)</td>
                                                    <td>@Highlight(item.PhoneNumber)</td>
                                                    <td>
                                                        @Highlight(item.LastName)<span>, </span>@Highlight(item.FirstName)
                                                        @if (!string.IsNullOrWhiteSpace(item.MiddleName))
                                                        {
                                                            <span>&nbsp;</span>
                                                            @Highlight(item.MiddleName)
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.Extension))
                                                        {
                                                            <span>&nbsp;</span>
                                                            @Highlight(item.Extension)
                                                        }
                                                    </td>
                                                    <td>@Highlight(item.BirthDate.ToString("MMM dd, yyyy"))</td>
                                                    <td>
                                                        <span class="tbl-badge @GetAgeBadgeClass(item.BirthDate)">
                                                            @item.Age
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="tbl-badge mile">@item.MilestoneYear</span>
                                                    </td>
                                                    <td>@Highlight(GetSexText(item.Sex))</td>
                                                    <td>@Highlight(item.MunicipalityName)</td>
                                                    <td>@Highlight(item.BarangayName)</td>
                                                    <td>@Highlight(item.Validator)</td>
                                                    @* Payment *@
                                                    <td>
                                                        <span class="tbl-badge @GetPaymentBadgeClass(item.PaymentStatus)">
                                                            @Highlight(GetPaymentStatusText(item.PaymentStatus))
                                                        </span>
                                                    </td>

                                                    @* Mode of Payment — ✅ new *@
                                                    <td>
                                                        @if (item.PaymentStatus == 2)
                                                        {
                                                            <span
                                                                class="tbl-badge @GetModeOfPaymentBadgeClass(item.ModeOfPayment)"
                                                                title="@GetModeOfPaymentText(item.ModeOfPayment)">
                                                                @Highlight(GetModeOfPaymentText(item.ModeOfPayment))
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">—</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @{
                                                            var eligBadge = GetEligibilityBadgeClass(item.IsEligible,
                                                                                        item.EligibilityRemarks);
                                                            var eligLabel = GetEligibilityLabel(item.IsEligible,
                                                                                        item.EligibilityRemarks);
                                                        }
                                                        <span class="tbl-badge @eligBadge" title="@item.EligibilityRemarks">
                                                            @Highlight(eligLabel)
                                                        </span>
                                                        @if (item.IsEligible &&
                                                    !string.IsNullOrWhiteSpace(item.EligibilityRemarks))
                                                        {
                                                            <br />
                                                            <small class="text-muted"
                                                                   style="font-size:10px; max-width:120px; display:inline-block;
                                                                white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                                @Highlight(item.EligibilityRemarks)
                                                            </small>
                                                        }
                                                    </td>
                                                    <td>
                                                        @{
                                                            var compBadge = GetComplianceBadgeClass(item.IsCompliant,
                                                                                        item.AssessmentRemarks);
                                                            var compLabel = GetComplianceLabel(item.IsCompliant,
                                                                                        item.AssessmentRemarks);
                                                        }
                                                        <span class="tbl-badge @compBadge" title="@item.AssessmentRemarks">
                                                            @Highlight(compLabel)
                                                        </span>
                                                        @if (item.IsCompliant &&
                                                    !string.IsNullOrWhiteSpace(item.AssessmentRemarks))
                                                        {
                                                            <br />
                                                            <small class="text-muted"
                                                                   style="font-size:10px; max-width:120px; display:inline-block;
                                                                white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                                @Highlight(item.AssessmentRemarks)
                                                            </small>
                                                        }
                                                    </td>
                                                    <td>
                                                        @{
                                                            var findBadge = GetFindingBadgeClass(item.FindingStatus);
                                                            var findLabel = GetFindingStatusText(item.FindingStatus);
                                                        }
                                                        <span class="tbl-badge @findBadge" title="@item.FindingRemarks">
                                                            @Highlight(findLabel)
                                                        </span>
                                                        @if (item.FindingStatus == 2 &&
                                                    !string.IsNullOrWhiteSpace(item.FindingRemarks))
                                                        {
                                                            <br />
                                                            <small class="text-muted"
                                                                   style="font-size:10px; max-width:120px; display:inline-block;
                                                                white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                                @Highlight(item.FindingRemarks)
                                                            </small>
                                                        }
                                                    </td>
                                                    <td>
                                                        @{
                                                            var coBadge = GetCoStatusBadgeClass(item.CoStatus);
                                                            var coLabel = GetCoStatusLabel(item.CoStatus);
                                                        }
                                                        <span class="tbl-badge @coBadge" title="@coLabel">
                                                            @Highlight(coLabel)
                                                        </span>
                                                        @if (item.CoStatus == 1 && item.CoDateEndorsed.HasValue)
                                                        {
                                                            <br />
                                                            <small class="text-muted" style="font-size:10px;">
                                                                @Highlight(item.CoDateEndorsed.Value.ToString("MMM dd, yyyy"))
                                                            </small>
                                                        }
                                                        @if (item.CoStatus == 2 && item.CoDateApproved.HasValue)
                                                        {
                                                            <br />
                                                            <small class="text-muted" style="font-size:10px;">
                                                                @Highlight(item.CoDateApproved.Value.ToString("MMM dd, yyyy"))
                                                            </small>
                                                        }
                                                    </td>
                                                    <td>
                                                        <button class="btn-details" @onclick="() => OpenDetailsPanel(item)"
                                                                title="View Details">
                                                            <i class="bi bi-info-circle"></i> Details
                                                        </button>
                                                    </td>

                                                </tr>
                                            </ItemContent>

                                        </Virtualize>

                                        @* Filler — holds height when empty *@
                                        @if (!FilteredBeneficiaries.Any())
                                        {
                                            <tr class="filler-row">
                                                <td colspan="19">
                                                    @if (!State.IsLoading)
                                                    {
                                                        <span>No records found.</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    @* ── Duplicate review modal ──────────────────────────────────────────────── *@
    <HxModal @ref="_duplicateModal" Size="ModalSize.ExtraLarge">
        <HeaderTemplate>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                <h5 class="mb-0">
                    Possible Duplicate Records
                    @if (_duplicateSummary is not null)
                    {
                        <span class="badge bg-warning text-dark ms-2 fw-normal">
                            @_duplicateSummary.TotalPairs pair(s) found
                        </span>
                    }
                </h5>
            </div>
        </HeaderTemplate>
        <BodyTemplate>
            @if (_duplicateSummary?.Pairs is null || !_duplicateSummary.Pairs.Any())
            {
                <div class="alert alert-success mb-0">
                    <i class="bi bi-check-circle-fill me-2"></i>No possible duplicates found.
                </div>
            }
            else
            {
                <p class="text-muted small mb-3">
                    Click <strong>Edit</strong> on either record to review and correct it.
                    Rows highlighted in
                    <span class="badge bg-danger bg-opacity-25 text-danger">red</span>
                    have at least one <strong>Paid</strong> record — resolve those first.
                </p>

                @* ── Filter bar ──────────────────────────────────────────── *@
                <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
                    <div class="input-group input-group-sm" style="max-width:240px;">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Search name..." @bind="_duplicateSearchTerm"
                               @bind:event="oninput" />
                    </div>
                    <select class="form-select form-select-sm w-auto" @bind="_duplicateReasonFilter">
                        <option value="">All reasons</option>
                        <option value="same birthdate">Same birthdate</option>
                        <option value="birthdate">Similar birthdate (±)</option>
                    </select>
                    <span class="text-muted small ms-auto">
                        Showing @FilteredDuplicatePairs.Count() of
                        @_duplicateSummary.Pairs.Count pair(s)
                    </span>
                </div>

                @* ── Pairs table ─────────────────────────────────────────── *@
                <div style="max-height:500px; overflow-y:auto;">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-warning" style="position:sticky; top:0; z-index:1;">
                            <tr>
                                <th style="width:36px;">#</th>
                                <th style="width:110px;">Reason</th>
                                <th style="width:64px;">Match</th>
                                <th>Record 1</th>
                                <th>Record 2</th>
                                <th style="width:130px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var filteredPairs = FilteredDuplicatePairs.ToList();
                            }
                            @if (!filteredPairs.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-3">
                                        No pairs match your filter.
                                    </td>
                                </tr>
                            }
                            @foreach (var (pair, idx) in filteredPairs.Select((p, i) => (p, i + 1)))
                            {
                                bool hasPaid = pair.Record1PaymentStatus == 2
                                            || pair.Record2PaymentStatus == 2;
                                <tr class="@(hasPaid ? "table-danger" : "")">
                                    <td class="text-center text-muted small">@idx</td>
                                    <td>
                                        <span class="badge @GetDuplicateReasonBadgeClass(pair.MatchReason) small">
                                            @pair.MatchReason
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning text-dark">
                                            @((pair.MatchScore * 100).ToString("F0"))%
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold small">@pair.Record1FullName</div>
                                        <div class="text-muted" style="font-size:11px;">
                                            @pair.Record1BirthDate
                                        </div>
                                        <div class="text-muted" style="font-size:11px;">
                                            @pair.Record1Municipality
                                            @if (!string.IsNullOrWhiteSpace(pair.Record1Barangay))
                                            {
                                                <span> — @pair.Record1Barangay</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(pair.Record1OscaId))
                                        {
                                            <div class="text-muted" style="font-size:11px;">
                                                OSCA: @pair.Record1OscaId
                                            </div>
                                        }
                                        @if (pair.Record1PaymentStatus == 2)
                                        {
                                            <span class="badge bg-success" style="font-size:10px;">
                                                Paid
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold small">@pair.Record2FullName</div>
                                        <div class="text-muted" style="font-size:11px;">
                                            @pair.Record2BirthDate
                                        </div>
                                        <div class="text-muted" style="font-size:11px;">
                                            @pair.Record2Municipality
                                            @if (!string.IsNullOrWhiteSpace(pair.Record2Barangay))
                                            {
                                                <span> — @pair.Record2Barangay</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(pair.Record2OscaId))
                                        {
                                            <div class="text-muted" style="font-size:11px;">
                                                OSCA: @pair.Record2OscaId
                                            </div>
                                        }
                                        @if (pair.Record2PaymentStatus == 2)
                                        {
                                            <span class="badge bg-success" style="font-size:10px;">
                                                Paid
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <button class="btn btn-xs btn-outline-primary btn-sm"
                                                    @onclick="async () => await NavigateToDuplicateEdit(pair.Record1Id)">
                                                <i class="bi bi-pencil-square me-1"></i>Edit #1
                                            </button>
                                            <button class="btn btn-xs btn-outline-primary btn-sm"
                                                    @onclick="async () => await NavigateToDuplicateEdit(pair.Record2Id)">
                                                <i class="bi bi-pencil-square me-1"></i>Edit #2
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </BodyTemplate>
        <FooterTemplate>
            <div class="d-flex justify-content-between align-items-center w-100">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    After editing a record, click <strong>Rescan</strong> to refresh results.
                </small>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RescanDuplicatesAsync"
                            disabled="@_isLoadingDuplicates">
                        @if (_isLoadingDuplicates)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-clockwise me-1"></i>
                        }
                        Rescan
                    </button>
                    <HxButton Color="ThemeColor.Secondary" @onclick="() => _duplicateModal.HideAsync()">
                        Close
                    </HxButton>
                </div>
            </div>
        </FooterTemplate>
    </HxModal>
    <HxModal @ref="bulkRefNumberModal">
        <HeaderTemplate>
            <h5 class="modal-title">Confirm Reference Number Update</h5>
        </HeaderTemplate>
        <BodyTemplate>
            <p>
                You are about to assign Reference Number
                <strong>@GetBulkRefPreview()</strong>
                to <strong>@checkedIds.Count</strong> record(s).
            </p>
            <p class="text-muted small mb-0">
                <i class="bi bi-info-circle me-1"></i>
                Each record will receive a unique 5-digit code in place of <strong>#####</strong>.
            </p>
        </BodyTemplate>
        <FooterTemplate>
            <HxButton Color="ThemeColor.Secondary" @onclick="() => bulkRefNumberModal.HideAsync()">
                Cancel
            </HxButton>
            <HxButton Color="ThemeColor.Primary" @onclick="ExecuteBulkRefNumberAsync" Disabled="@IsBulkUpdatingRefNumber">
                @if (IsBulkUpdatingRefNumber)
                {
                    <span>Updating...</span>
                }
                else
                {
                    <span>Yes, Assign</span>
                }
            </HxButton>
        </FooterTemplate>
    </HxModal>
    <!--Bulk update Modal-->
    <HxModal @ref="bulkUpdateModal">
        <HeaderTemplate>
            <h5 class="modal-title">Confirm Bulk Update</h5>
