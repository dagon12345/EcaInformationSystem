        <HxButton Color="ThemeColor.Secondary" @onclick="() => bulkOtherUpdateModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="ExecuteBulkOtherUpdateAsync" Disabled="@IsBulkUpdatingOther">
            @if (IsBulkUpdatingOther)
            {
                <span>Updating...</span>
            }
            else
            {

