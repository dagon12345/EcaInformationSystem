    private async Task GeneratePayrollAsync()
    {
        if (!checkedIds.Any())
        {
            toast.ShowError("No records selected. Please check at least one record.");
            return;
        }

        try
        {
            IsGeneratingPayroll = true;
            StateHasChanged();

            var request = new
            {
                Ids = checkedIds.ToList()
            };

            var response = await Http.PostAsJsonAsync("api/payroll/generate-payroll", request);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Payroll generation failed: {error}");
                return;
            }

            var fileBytes = await response.Content.ReadAsByteArrayAsync();
            if (fileBytes == null || fileBytes.Length == 0)
            {
                toast.ShowError("No data returned from payroll generation.");
                return;
            }

            var base64 = Convert.ToBase64String(fileBytes);
            var fileName = $"CashGiftPayroll_{DateTime.Now:yyyy-MM-dd}.xlsx";
            await JS.InvokeVoidAsync("downloadFile", fileName, base64);

            toast.ShowSuccess($"Payroll generated for {checkedIds.Count} record(s).");
        }
        catch (Exception ex)
        {
            toast.ShowError($"Payroll generation failed: {ex.Message}");
        }
        finally
        {
            IsGeneratingPayroll = false;
        }
    }

