    private async Task ExportExcel()
    {
        if (!checkedIds.Any()) { toast.ShowError("No records to export. Please check at least one record."); return; }
        try
        {
            IsExporting = true;
            StateHasChanged();
            var response = await Http.PostAsJsonAsync("api/beneficiary/export", new { Ids = checkedIds.ToList() });
            if (!response.IsSuccessStatusCode)
            {
                toast.ShowError($"Export failed: {await response.Content.ReadAsStringAsync()}");
                return;
            }
            var exportBytes = await response.Content.ReadAsByteArrayAsync();
            if (exportBytes == null || exportBytes.Length == 0) { toast.ShowError("No data returned from export."); return; }
            await JS.InvokeVoidAsync("downloadFile", $"Beneficiaries_{DateTime.Now:yyyy-MM-dd}.xlsx",
Convert.ToBase64String(exportBytes));
        }
        catch (Exception ex) { toast.ShowError($"Export failed: {ex.Message}"); }
        finally { IsExporting = false; }
    }

    private async Task GeneratePayrollAsync()
    {
        if (!checkedIds.Any()) { toast.ShowError("No records selected. Please check at least one record."); return; }
        try
        {
            IsGeneratingPayroll = true;
            StateHasChanged();
            var response = await Http.PostAsJsonAsync("api/payroll/generate-payroll", new { Ids = checkedIds.ToList() });
            if (!response.IsSuccessStatusCode)
            {
                toast.ShowError($"Payroll generation failed: {await
response.Content.ReadAsStringAsync()}"); return;
            }
            var fileBytes = await response.Content.ReadAsByteArrayAsync();
            if (fileBytes == null || fileBytes.Length == 0)
            {
                toast.ShowError("No data returned from payroll generation."); return;
            }
            await JS.InvokeVoidAsync("downloadFile", $"CashGiftPayroll_{DateTime.Now:yyyy-MM-dd}.xlsx",
Convert.ToBase64String(fileBytes));
            toast.ShowSuccess($"Payroll generated for {checkedIds.Count} record(s).");
        }
        catch (Exception ex) { toast.ShowError($"Payroll generation failed: {ex.Message}"); }
        finally { IsGeneratingPayroll = false; }
    }

