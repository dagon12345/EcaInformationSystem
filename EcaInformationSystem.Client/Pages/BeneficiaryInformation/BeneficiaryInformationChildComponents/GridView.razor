        </BodyTemplate>
        <FooterTemplate>
            <HxButton Color="ThemeColor.Secondary" @onclick="() => bulkUpdateModal.HideAsync()">
                Cancel
            </HxButton>
            <HxButton Color="ThemeColor.Primary" @onclick="ExecuteBulkUpdateAsync" Disabled="@IsBulkUpdating">
                @if (IsBulkUpdating)
                {
                    <span>Updating...</span>
                }
                else
                {
                    <span>Yes, Update</span>
                }
            </HxButton>
        </FooterTemplate>
