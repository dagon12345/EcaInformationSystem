    private async Task OnFullNameFilterInput(ChangeEventArgs e)
    {
        fullNameFilter = e.Value?.ToString();

        // Cancel any in-flight debounce
        _nameCts?.Cancel();
        _nameCts?.Dispose();
        _nameCts = new CancellationTokenSource();

        try
        {
            // Wait 400 ms — if another keystroke arrives it cancels this one
            await Task.Delay(400, _nameCts.Token);

            // Push the value into the shared filter and reload from the server.
            // This searches ALL pages, not just the current 10 rows.
            State.Filter.FullName = string.IsNullOrWhiteSpace(fullNameFilter) ? null : fullNameFilter.Trim();
            State.Filter.PageNumber = 1;
            await State.LoadAsync();

            // ✅ Rescan whenever the visible dataset changes
            // Only rescan if a previous scan result exists — don't trigger
            // a brand new scan just from typing in the name box
            if (_duplicateSummary is not null)
                _ = RunDuplicateScanAsync();
        }
        catch (TaskCanceledException) { /* debounced away — ignore */ }
    }
