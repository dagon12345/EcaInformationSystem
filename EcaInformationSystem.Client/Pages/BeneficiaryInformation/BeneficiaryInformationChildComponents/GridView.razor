    public async Task RunDuplicateScanAsync()
    {
        try
        {
            _duplicateSummary = null;
            _dismissedDuplicateBanner = false;
            _isLoadingDuplicates = true;
            StateHasChanged();

            // ✅ Build a clean filter snapshot for the scan
            // PageNumber/PageSize are irrelevant for the scan — scan sees ALL
            // matching records, not just the current page
            var scanFilter = new BeneficiaryFilterDto
            {
                // Location
                PsgcCodeRegion = State.Filter.PsgcCodeRegion,
                PsgcCodeProvince = State.Filter.PsgcCodeProvince,
                PsgcCodeMunicipality = State.Filter.PsgcCodeMunicipality,
                PsgcCodeBarangay = State.Filter.PsgcCodeBarangay,

                // ✅ Name fields intentionally excluded
                // FullName, LastName, FirstName are grid search helpers only
                // The scan should find duplicates across the full location scope
                // not just within whatever name the user typed in the search box
                // GeneralSearch also excluded for the same reason
                Validator = State.Filter.Validator,
                BatchCode = State.Filter.BatchCode,

                // Status filters
                PaymentStatus = State.Filter.PaymentStatus,
                PaymentDate = State.Filter.PaymentDate,
                PaymentDateFrom = State.Filter.PaymentDateFrom,
                PaymentDateTo = State.Filter.PaymentDateTo,
                IsEligible = State.Filter.IsEligible,
                EligibilityMode = State.Filter.EligibilityMode,
                IsCompliant = State.Filter.IsCompliant,
                ComplianceMode = State.Filter.ComplianceMode,
                CoStatus = State.Filter.CoStatus,
                FindingStatus = State.Filter.FindingStatus,
                Sex = State.Filter.Sex,
                FilterModeOfPayment = State.Filter.FilterModeOfPayment,

                // Age / birthday
                SpecificAge = State.Filter.SpecificAge,
                MilestoneYear = State.Filter.MilestoneYear,
                SpecificBirthday = State.Filter.SpecificBirthday,
                BirthdayFrom = State.Filter.BirthdayFrom,
                BirthdayTo = State.Filter.BirthdayTo,

                // Reference number
                FilterQuarter = State.Filter.FilterQuarter,
                FilterBatch = State.Filter.FilterBatch,
                FilterRefYear = State.Filter.FilterRefYear,
                FilterRegionRoman = State.Filter.FilterRegionRoman,
                // ✅ Add alongside the other filter fields
                DateAddedFrom = State.Filter.DateAddedFrom,
                DateAddedTo = State.Filter.DateAddedTo,

                // ✅ No pagination — scan sees all matching records
                PageNumber = 1,
                PageSize = int.MaxValue
            };

            var response = await Http.PostAsJsonAsync(
                "api/beneficiary/possible-duplicates",
                scanFilter);

            if (response.IsSuccessStatusCode)
            {
                _duplicateSummary = await response.Content
                    .ReadFromJsonAsync<PossibleDuplicateSummaryDto>();
            }
            else
            {
                Console.WriteLine($"Duplicate scan HTTP error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Duplicate scan failed: {ex.Message}");
        }
        finally
        {
            _isLoadingDuplicates = false;
            StateHasChanged();
        }
    }
