    private async Task LoadDuplicateCompareAsync(PossibleDuplicatePairDto pair)
    {
        try
        {
            _isDuplicateDetailLoading = true;
            _duplicateRecord1 = null;
            _duplicateRecord2 = null;
            _duplicateViewingId = pair.Record1Id;
            StateHasChanged();
            var t1 = Http.GetFromJsonAsync<BeneficiaryInformationDto>($"api/beneficiary/edit/{pair.Record1Id}");
            var t2 = Http.GetFromJsonAsync<BeneficiaryInformationDto>($"api/beneficiary/edit/{pair.Record2Id}");
            await Task.WhenAll(t1, t2);
            _duplicateRecord1 = await t1;
            _duplicateRecord2 = await t2;
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to load records for comparison: {ex.Message}");
            _duplicateViewingId = null;
        }
        finally
        {
            _isDuplicateDetailLoading = false;
            StateHasChanged();
        }
    }

    private void CloseDuplicateCompare()
    {
        _duplicateViewingId = null;
        _duplicateRecord1 = null;
        _duplicateRecord2 = null;
        StateHasChanged();
    }

    private async Task CloseDuplicateModal()
    {
        CloseDuplicateCompare();
        await _duplicateModal.HideAsync();
    }

    private IEnumerable<PossibleDuplicatePairDto> FilteredDuplicatePairs =>
        _duplicateSummary?.Pairs.Where(p =>
        {
            if (!string.IsNullOrWhiteSpace(_duplicateSearchTerm))
            {
                var term = _duplicateSearchTerm.Trim().ToLower();
                if (!p.Record1FullName.ToLower().Contains(term)
                    && !p.Record2FullName.ToLower().Contains(term))
                    return false;
            }
            if (!string.IsNullOrWhiteSpace(_duplicateReasonFilter))
            {
                if (!p.MatchReason.Contains(_duplicateReasonFilter, StringComparison.OrdinalIgnoreCase))
                    return false;
            }
            return true;
        })
        .OrderByDescending(p => p.MatchScore)
        ?? Enumerable.Empty<PossibleDuplicatePairDto>();

    // Simple, honest approach: don't try to silently validate every record
    // in the pairs list (expensive, and still racy). Instead, when a navigate-
    // to-edit fails because the record is gone, tell the user clearly AND
    // proactively suggest the fix — Rescan — rather than leaving them in an
    // ambiguous broken state.

    private async Task NavigateToDuplicateEdit(Guid id)
    {
        try
        {
            var check = await Http.GetAsync($"api/beneficiary/edit/{id}");
            if (!check.IsSuccessStatusCode)
            {
                toast.ShowError(
                    "This record no longer exists in the system — it was likely deleted " +
                    "after this duplicate list was last refreshed. Use the bell's " +
                    "\"Rescan now\" to update the list.");
                return;
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Could not verify record: {ex.Message}");
            return;
        }

        await _duplicateModal.HideAsync();
        Navigation.NavigateTo($"/beneficiary-edit/{id}");
    }

    private async Task OnSingleRefNumberConfirmed(ReferenceNumberModal.RefNumberResult result)
    {
        if (selectedDetails == null) return;
        try
        {
            var request = new
            {
                Ids = new List<Guid> { selectedDetails.Id },
                Quarter = result.Quarter,
                Batch = result.Batch,
                RefYear = result.RefYear
            };
            var response = await Http.PostAsJsonAsync("api/beneficiary/bulk-assign-refnumber", request);
            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess("Reference number assigned successfully.");
                selectedDetails.Quarter = result.Quarter;
                selectedDetails.Batch = result.Batch;
                selectedDetails.RefYear = result.RefYear;
                State.Invalidate();
                await State.LoadAsync();
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Failed: {error}");
            }
        }
        catch (Exception ex) { toast.ShowError($"Error: {ex.Message}"); }
    }

