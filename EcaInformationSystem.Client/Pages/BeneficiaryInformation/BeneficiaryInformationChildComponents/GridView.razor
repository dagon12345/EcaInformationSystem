                                                                                                                                                                                                                                              "—")</span></div>
                    <div class="col-6"><small class="text-muted d-block">First
                        Name</small><span>@selectedDetails.FirstName</span></div>
                        <div class="col-6"><small class="text-muted d-block">Middle Name</small><span>@(selectedDetails.MiddleName
                                                                                                                                                                                                                                                                                                                                        ?? "—")</span></div>
                            <div class="col-6"><small class="text-muted d-block">Extension</small><span>@(selectedDetails.Extension ??
                                                                                                                                                                                                                                                                                                                                                                                   "—")</span></div>
                                <div class="col-6"><small class="text-muted d-block">Birth
                                    Date</small><span>@selectedDetails.BirthDate.ToString("MMMM dd, yyyy")</span></div>
                                    <div class="col-6"><small class="text-muted d-block">Age</small><span>@selectedDetails.Age</span></div>
                                    <div class="col-6"><small
                                        class="text-muted d-block">Sex</small><span>@GetSexText(selectedDetails.Sex)</span></div>
                                        <div class="col-6"><small class="text-muted d-block">Phone Number</small><span>@(selectedDetails.PhoneNumber
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ?? "—")</span></div>
                                            <div class="col-6"><small class="text-muted d-block">OSCA ID
                                                Number</small><span>@(selectedDetails.OscaIdNumber ?? "—")</span></div>
                                                <div class="col-6"><small class="text-muted d-block">NCSC
                                                    RRN</small><span>@(selectedDetails.NcscRrn?.ToString() ?? "—")</span></div>
                                                    <div class="col-6"><small class="text-muted d-block">Batch Code</small><span>@(selectedDetails.BatchCode ??
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           "—")</span></div>
                                                        <div class="col-6"><small class="text-muted d-block">Date
                                                            Applied</small><span>@(selectedDetails.DateApplied?.ToString("MMMM dd, yyyy") ?? "—")</span></div>
                                                            <div class="col-6"><small class="text-muted d-block">Date
                                                                Endorsed</small><span>@(selectedDetails.DateEndorsed?.ToString("MMMM dd, yyyy") ?? "—")</span></div>
                                                                <div class="col-6"><small class="text-muted d-block">OSCA ID Date
