    <!--Off Canvas details displaying-->
    <HxOffcanvas @ref="detailsOffcanvas" Size="OffcanvasSize.Large">
        <HeaderTemplate>
            <h5 class="offcanvas-title">
                Details — @selectedDetails?.LastName, @selectedDetails?.FirstName
            </h5>
        </HeaderTemplate>
        <BodyTemplate>
            @if (selectedDetails is not null)
            {
                <!-- Reference Number -->
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">
                    <i class="bi bi-hash me-1"></i>Reference Number
                </h6>
                <div class="row g-2 mb-4">
                    <div class="col-12">
                        <small class="text-muted d-block">Reference Number</small>
                        @{
                            var detailRefNo = selectedDetails!.ReferenceNumber;
                        }
                        @if (!string.IsNullOrWhiteSpace(detailRefNo))
                        {
                            <span class="tbl-badge ref-no fs-6">@detailRefNo</span>
                        }
                        else if (selectedDetails.Quarter.HasValue &&
                                 !string.IsNullOrWhiteSpace(selectedDetails.Batch) &&
                                 selectedDetails.RefYear.HasValue)
                        {
                            @* ✅ Partial — has Q/B/Y but no RefCode yet *@
                            <span class="text-warning fst-italic">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                Code not yet generated — use bulk assign to fix
                            </span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Not assigned yet</span>
                        }
                    </div>
                </div>
                <!-- Identity -->
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Identity Information</h6>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <small class="text-muted d-block">Last Name</small>
                        <span>@(selectedDetails.LastName ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">First Name</small>
                        <span>@selectedDetails.FirstName</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Middle Name</small>
                        <span>@(selectedDetails.MiddleName ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Extension</small>
                        <span>@(selectedDetails.Extension ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Birth Date</small>
                        <span>@selectedDetails.BirthDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Age</small>
                        <span>@selectedDetails.Age</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Sex</small>
                        <span>@GetSexText(selectedDetails.Sex)</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Phone Number</small>
                        <span>@(selectedDetails.PhoneNumber ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">OSCA ID Number</small>
                        <span>@(selectedDetails.OscaIdNumber ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">NCSC RRN</small>
                        <span>@(selectedDetails.NcscRrn?.ToString() ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Batch Code</small>
                        <span>@(selectedDetails.BatchCode ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Date Applied</small>
                        <span>@(selectedDetails.DateApplied?.ToString("MMMM dd, yyyy") ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Date Endorsed</small>
                        <span>@(selectedDetails.DateEndorsed?.ToString("MMMM dd, yyyy") ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">OSCA ID Date Issued</small>
                        <span>@(selectedDetails.OscaIdDateIssued?.ToString("MMMM dd, yyyy") ?? "—")</span>
                    </div>
                </div>

                <!-- Demographic -->
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Demographic Information</h6>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <small class="text-muted d-block">Civil Status</small>
                        <span>@GetCivilStatusText(selectedDetails.CivilStatus)</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Citizenship</small>
                        <span>@GetCitizenshipText(selectedDetails.Citizenship)</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Indigenous People</small>
                        <span>@(selectedDetails.IsIndigenousPeople ? "Yes" : "No")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Person with Disability</small>
                        <span>@(selectedDetails.IsPersonWithDisability ? "Yes" : "No")</span>
                    </div>
                </div>

                <!-- Address -->
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Address Information</h6>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <small class="text-muted d-block">Region</small>
                        <span>@(selectedDetails.Region)</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Province</small>
                        <span>@(selectedDetails.Province)</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Municipality</small>
                        <span>@(selectedDetails.Municipality)</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Barangay</small>
                        <span>@(selectedDetails.Barangay)</span>
                    </div>
                </div>

                <!-- Validation -->
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Validation & Payment</h6>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <small class="text-muted d-block">Validator</small>
                        <span>@(selectedDetails.Validator ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Validation Date</small>
                        <span>@selectedDetails.ValidationDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Payment Status</small>
                        <span class="tbl-badge @GetPaymentBadgeClass(selectedDetails.PaymentStatus)">
                            @GetPaymentStatusText(selectedDetails.PaymentStatus)
                        </span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Payment Date</small>
                        <span>@(selectedDetails.PaymentDate?.ToString("MMMM dd, yyyy") ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Mode of Payment</small>
                        <span>@GetModeOfPaymentText(selectedDetails.ModeOfPayment)</span>
                    </div>

                    @* ── Remarks stays as general notes ── *@
                    <div class="col-12">
                        <small class="text-muted d-block">Remarks</small>
                        <span>@(selectedDetails.Remarks ?? "—")</span>
                    </div>
                </div>

                <!-- Assessment -->
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Assessment</h6>
                <div class="row g-2 mb-4">

                    <div class="col-6">
                        <small class="text-muted d-block">Is Eligible</small>
                        @{
                            var detailEligBadge = GetEligibilityBadgeClass(
                                selectedDetails!.IsEligible, selectedDetails.EligibilityRemarks);
                            var detailEligLabel = GetEligibilityLabel(
                                selectedDetails.IsEligible, selectedDetails.EligibilityRemarks);
                        }
                        <span class="badge @(selectedDetails.IsEligible ? "bg-success" : "bg-secondary")">
                            @detailEligLabel
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedDetails.EligibilityRemarks))
                    {
                        <div class="col-12">
                            <small class="text-muted d-block">Eligibility Remarks</small>
                            <span>@selectedDetails.EligibilityRemarks</span>
                        </div>
                    }

                    <div class="col-6">
                        <small class="text-muted d-block">Is Compliant</small>
                        @{
                            var detailCompBadge = GetComplianceBadgeClass(
                                selectedDetails.IsCompliant, selectedDetails.AssessmentRemarks);
                            var detailCompLabel = GetComplianceLabel(
                                selectedDetails.IsCompliant, selectedDetails.AssessmentRemarks);
                        }
                        <span class="badge @(selectedDetails.IsCompliant ? "bg-info" : "bg-warning text-dark")">
                            @detailCompLabel
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedDetails.AssessmentRemarks))
                    {
                        <div class="col-12">
                            <small class="text-muted d-block">Compliance Remarks</small>
                            <span>@selectedDetails.AssessmentRemarks</span>
                        </div>
                    }
                </div>

                <!-- Deceased -->
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">Other</h6>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <small class="text-muted d-block">Is Deceased</small>
                        <span>@(selectedDetails.IsDeceased ? "Yes" : "No")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Date of Death</small>
                        <span>@(selectedDetails.DateOfDeath?.ToString("MMMM dd, yyyy") ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Date Added</small>
                        <span>@selectedDetails.DateAdded.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>
                <!-- Findings -->
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">
                    <i class="bi bi-exclamation-triangle me-1"></i>Findings
                </h6>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <small class="text-muted d-block">With Findings</small>
                        <span class="tbl-badge @GetFindingBadgeClass(selectedDetails.FindingStatus)">
                            @GetFindingStatusText(selectedDetails.FindingStatus)
                        </span>
                    </div>
                    @if (selectedDetails.FindingStatus == 2 && !string.IsNullOrWhiteSpace(selectedDetails.FindingRemarks))
                    {
                        <div class="col-12">
                            <small class="text-muted d-block">Finding Remarks</small>
                            <span>@selectedDetails.FindingRemarks</span>
                        </div>
                    }
                </div>

                <!-- CO Status -->
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-3">
                    <i class="bi bi-building-check me-1"></i>CO Status
                </h6>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <small class="text-muted d-block">CO Status</small>
                        <span class="tbl-badge @GetCoStatusBadgeClass(selectedDetails!.CoStatus)">
                            @GetCoStatusLabel(selectedDetails.CoStatus)
                        </span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">CO Date Endorsed</small>
                        <span>@(selectedDetails.CoDateEndorsed?.ToString("MMMM dd, yyyy") ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">CO Date Approved</small>
                        <span>@(selectedDetails.CoDateApproved?.ToString("MMMM dd, yyyy") ?? "—")</span>
                    </div>
                </div>
            }
        </BodyTemplate>
        <FooterTemplate>
            <div class="d-flex justify-content-between align-items-center w-100">

                <!-- Left side buttons -->
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary px-4" @onclick="() => detailsOffcanvas.HideAsync()">
                        Close
                    </button>
                    <button class="btn btn-outline-primary px-4"
                            @onclick="async () => { await OpenEditConfirmationModal(selectedDetails!, selectedDetails!.Id); }">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                    </button>
                    <button class="btn btn-outline-info px-4" @onclick="() => OpenLogModal(selectedDetails!)" title="Logs">
                        <i class="bi bi-clock-history me-1"></i> Logs
                    </button>
                </div>

                <!-- Right side — Delete pushed to far right -->
                <button class="btn btn-outline-danger px-4"
                        @onclick="async () => { await detailsOffcanvas.HideAsync(); await OpenDeleteConfirmationModal(selectedDetails!); }"
                        title="Delete">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>

            </div>
        </FooterTemplate>
    </HxOffcanvas>
    <!--Log Modal-->
    <HxModal @ref="logModal" Size="ModalSize.ExtraLarge">
        <HeaderTemplate>
            <h5 class="modal-title">Logs - @selectedBeneficiaryName</h5>
        </HeaderTemplate>

        <BodyTemplate>
            @if (IsLogsLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 mb-0">Loading logs...</p>
                </div>
            }
            else if (logs == null || !logs.Any())
            {
                <div class="alert alert-info mb-0">
                    No logs found for this beneficiary.
                </div>
            }
            else
            {
                <div style="max-height: 500px; overflow-y: auto;">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                                <tr>
                                    <th style="width: 70px;">#</th>
                                    <th>Activity</th>
                                    <th style="width: 180px;">User</th>
                                    <th style="width: 200px;">Date Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < logs.Count; i++)
                                {
                                    var log = logs[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@log.Activity</td>
                                        <td>@log.UserName</td>
                                        <td>@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </BodyTemplate>

        <FooterTemplate>
            <HxButton Type="ButtonType.Button" Color="ThemeColor.Secondary" @onclick="CloseLogModal">
                Close
            </HxButton>
        </FooterTemplate>
    </HxModal>
    <PayrollModal @ref="_payrollModal" />
    <!--Confirmation Modal-->
    <HxModal @ref="confirmModal">
        <HeaderTemplate>
            <h5 class="modal-title">@confirmationTitle</h5>
        </HeaderTemplate>
        <BodyTemplate>
            <p class="mb-0">@confirmationMessage</p>
        </BodyTemplate>
        <FooterTemplate>
            <HxButton Type="ButtonType.Button" Color="ThemeColor.Secondary" @onclick="CloseConfirmationModal">
                Cancel
            </HxButton>
            <HxButton Type="ButtonType.Button" Color="ThemeColor.Primary" @onclick="ConfirmActionAsync"
                      Disabled="@IsSaving">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Processing...</span>
                }
                else
                {
                    <span>Yes, Confirm</span>
                }
            </HxButton>
        </FooterTemplate>
    </HxModal>
    <HxModal @ref="_duplicateModal" Size="ModalSize.ExtraLarge">
        <HeaderTemplate>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                <h5 class="mb-0">
                    Possible Duplicate Records
                    @if (_duplicateSummary is not null)
                    {
                        <span class="badge bg-warning text-dark ms-2 fw-normal">
                            @_duplicateSummary.TotalPairs pair(s) found
                        </span>
                    }
                </h5>
            </div>
        </HeaderTemplate>
        <BodyTemplate>
            @if (_duplicateSummary?.Pairs is null || !_duplicateSummary.Pairs.Any())
            {
                <div class="alert alert-success mb-0">
                    <i class="bi bi-check-circle-fill me-2"></i>No possible duplicates found.
                </div>
            }
            else
            {
                @* ── Two column layout when a record is being viewed ─────── *@
                <div class="d-flex gap-3" style="min-height: 500px;">

                    @* ── LEFT: pairs table ───────────────────────────────── *@
                    <div style="flex: 1; min-width: 0;">

                        <p class="text-muted small mb-2">
                            Similar name and birthdate flagged as possible duplicates.
                            Click <strong>View</strong> to compare side by side before editing.
                            <span class="badge bg-danger bg-opacity-25 text-danger ms-1">Red rows</span>
                            have at least one <strong>Paid</strong> record.
                        </p>

                        @* ── Filter bar ──────────────────────────────────── *@
                        <div class="d-flex gap-2 mb-2 flex-wrap align-items-center">
                            <div class="input-group input-group-sm" style="max-width:200px;">
                                <span class="input-group-text">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" class="form-control" placeholder="Search name..."
                                       @bind="_duplicateSearchTerm" @bind:event="oninput" />
                            </div>
                            <select class="form-select form-select-sm w-auto" @bind="_duplicateReasonFilter">
                                <option value="">All reasons</option>
                                <option value="same birthdate">Same birthdate</option>
                                <option value="birthdate">Similar birthdate (±)</option>
                                <option value="DIFFERENT middle">Different middle name</option>
                            </select>
                            <span class="text-muted small ms-auto">
                                @FilteredDuplicatePairs.Count() of
                                @_duplicateSummary.Pairs.Count pair(s)
                            </span>
                        </div>

                        @* ── Pairs table ─────────────────────────────────── *@
                        <div style="max-height: 460px; overflow-y: auto;">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-warning" style="position: sticky; top: 0; z-index: 1;">
                                    <tr>
                                        <th style="width:30px;">#</th>
                                        <th>Reason</th>
                                        <th style="width:56px;">Match</th>
                                        <th>Record 1</th>
                                        <th>Record 2</th>
                                        <th style="width:90px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var filteredPairs = FilteredDuplicatePairs.ToList();
                                    }
                                    @if (!filteredPairs.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-3">
                                                No pairs match your filter.
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var (pair, idx) in filteredPairs
                                        .Select((p, i) => (p, i + 1)))
                                    {
                                        bool hasPaid = pair.Record1PaymentStatus == 2
                                                   || pair.Record2PaymentStatus == 2;

                                        // ✅ Highlight the currently viewed pair
                                        bool isViewing =
                                            _duplicateViewingId == pair.Record1Id ||
                                            _duplicateViewingId == pair.Record2Id;

                                        <tr class="@(hasPaid ? "table-danger" : "")
                                            @(isViewing ? "table-primary" : "")" style="cursor:pointer;">
                                            <td class="text-center text-muted small">
                                                @idx
                                            </td>
                                            <td>
                                                <span class="badge @GetDuplicateReasonBadgeClass(pair.MatchReason) small"
                                                      style="font-size:10px; white-space:normal;">
                                                    @pair.MatchReason
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-warning text-dark" style="font-size:10px;">
                                                    @((pair.MatchScore * 100).ToString("F0"))%
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold" style="font-size:11px;">
                                                    @pair.Record1FullName
                                                </div>
                                                <div class="text-muted" style="font-size:10px;">
                                                    @pair.Record1BirthDate
                                                </div>
                                                <div class="text-muted" style="font-size:10px;">
                                                    @pair.Record1Municipality
                                                    @if (!string.IsNullOrWhiteSpace(pair.Record1Barangay))
                                                    {
                                                        <span> — @pair.Record1Barangay</span>
                                                    }
                                                </div>
                                                @if (pair.Record1PaymentStatus == 2)
                                                {
                                                    <span class="badge bg-success" style="font-size:9px;">
                                                        Paid
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-semibold" style="font-size:11px;">
                                                    @pair.Record2FullName
                                                </div>
                                                <div class="text-muted" style="font-size:10px;">
                                                    @pair.Record2BirthDate
                                                </div>
                                                <div class="text-muted" style="font-size:10px;">
                                                    @pair.Record2Municipality
                                                    @if (!string.IsNullOrWhiteSpace(pair.Record2Barangay))
                                                    {
                                                        <span> — @pair.Record2Barangay</span>
                                                    }
                                                </div>
                                                @if (pair.Record2PaymentStatus == 2)
                                                {
                                                    <span class="badge bg-success" style="font-size:9px;">
                                                        Paid
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column gap-1">

                                                    @* ✅ View button — loads details panel *@
                                                    <button class="btn btn-xs btn-outline-info btn-sm" style="font-size:11px;"
                                                            @onclick="async () => await LoadDuplicateCompareAsync(pair)">
                                                        <i class="bi bi-eye me-1"></i>View
                                                    </button>

                                                    <button class="btn btn-xs btn-outline-primary btn-sm" style="font-size:11px;"
                                                            @onclick="async () => await NavigateToDuplicateEdit(pair.Record1Id)">
                                                        <i class="bi bi-pencil-square me-1"></i>Edit #1
                                                    </button>
                                                    <button class="btn btn-xs btn-outline-primary btn-sm" style="font-size:11px;"
                                                            @onclick="async () => await NavigateToDuplicateEdit(pair.Record2Id)">
                                                        <i class="bi bi-pencil-square me-1"></i>Edit #2
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* ── RIGHT: side-by-side comparison panel ────────────── *@
                    @if (_duplicateViewingId.HasValue || _isDuplicateDetailLoading)
                    {
                        <div
                            style="width: 520px; flex-shrink: 0; border-left: 1px solid var(--bs-border-color); padding-left: 1rem; overflow-y: auto; max-height: 500px;">

                            @if (_isDuplicateDetailLoading)
                            {
                                <div class="d-flex align-items-center gap-2 py-4 justify-content-center">
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span class="text-muted small">Loading records...</span>
                                </div>
                            }
                            else if (_duplicateRecord1 is not null && _duplicateRecord2 is not null)
                            {
                                @* ── Comparison header ────────────────────── *@
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0 fw-bold">
                                        <i class="bi bi-columns-gap me-1"></i>
                                        Side-by-Side Comparison
                                    </h6>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseDuplicateCompare">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>

                                @* ── Column headers ───────────────────────── *@
                                <div class="row g-0 mb-1">
                                    <div class="col-6 text-center">
                                        <span class="badge bg-primary w-100">Record 1</span>
                                    </div>
                                    <div class="col-6 text-center ps-1">
                                        <span class="badge bg-secondary w-100">Record 2</span>
                                    </div>
                                </div>

                                @* ── Comparison rows ─────────────────────────────────────────── *@
                                <table class="table table-sm table-bordered mb-2" style="font-size: 11px;">
                                    <tbody>

                                        @* Last Name *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Last Name
                                                @if (!string.Equals(_duplicateRecord1.LastName?.Trim(),
                                                                _duplicateRecord2.LastName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(_duplicateRecord1.LastName, _duplicateRecord2.LastName)">
                                            <td style="width:50%;">@(_duplicateRecord1.LastName ?? "—")</td>
                                            <td style="width:50%;">@(_duplicateRecord2.LastName ?? "—")</td>
                                        </tr>

                                        @* First Name *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                First Name
                                                @if (!string.Equals(_duplicateRecord1.FirstName?.Trim(),
                                                                _duplicateRecord2.FirstName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(_duplicateRecord1.FirstName, _duplicateRecord2.FirstName)">
                                            <td>@(_duplicateRecord1.FirstName ?? "—")</td>
                                            <td>@(_duplicateRecord2.FirstName ?? "—")</td>
                                        </tr>

                                        @* Middle Name *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Middle Name
                                                @if (!string.Equals(_duplicateRecord1.MiddleName?.Trim(),
                                                                _duplicateRecord2.MiddleName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(_duplicateRecord1.MiddleName, _duplicateRecord2.MiddleName)">
                                            <td>@(_duplicateRecord1.MiddleName ?? "—")</td>
                                            <td>@(_duplicateRecord2.MiddleName ?? "—")</td>
                                        </tr>

                                        @* Extension *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Extension
                                                @if (!string.Equals(_duplicateRecord1.Extension?.Trim(),
                                                                _duplicateRecord2.Extension?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(_duplicateRecord1.Extension, _duplicateRecord2.Extension)">
                                            <td>@(_duplicateRecord1.Extension ?? "—")</td>
                                            <td>@(_duplicateRecord2.Extension ?? "—")</td>
                                        </tr>

                                        @* Birth Date *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Birth Date
                                                @if (_duplicateRecord1.BirthDate.Date != _duplicateRecord2.BirthDate.Date)
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr
                                            class="@DiffClass(_duplicateRecord1.BirthDate.ToString("MMMM dd, yyyy"), _duplicateRecord2.BirthDate.ToString("MMMM dd, yyyy"))">
                                            <td>@_duplicateRecord1.BirthDate.ToString("MMMM dd, yyyy")</td>
                                            <td>@_duplicateRecord2.BirthDate.ToString("MMMM dd, yyyy")</td>
                                        </tr>

                                        @* Sex *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Sex
                                                @if (_duplicateRecord1.Sex != _duplicateRecord2.Sex)
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(GetSexText(_duplicateRecord1.Sex), GetSexText(_duplicateRecord2.Sex))">
                                            <td>@GetSexText(_duplicateRecord1.Sex)</td>
                                            <td>@GetSexText(_duplicateRecord2.Sex)</td>
                                        </tr>

                                        @* OSCA ID *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                OSCA ID
                                                @if (!string.Equals(_duplicateRecord1.OscaIdNumber?.Trim(),
                                                                _duplicateRecord2.OscaIdNumber?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(_duplicateRecord1.OscaIdNumber, _duplicateRecord2.OscaIdNumber)">
                                            <td>@(_duplicateRecord1.OscaIdNumber ?? "—")</td>
                                            <td>@(_duplicateRecord2.OscaIdNumber ?? "—")</td>
                                        </tr>

                                        @* NCSC RRN *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                NCSC RRN
                                                @if (_duplicateRecord1.NcscRrn != _duplicateRecord2.NcscRrn)
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr
                                            class="@DiffClass(_duplicateRecord1.NcscRrn?.ToString(), _duplicateRecord2.NcscRrn?.ToString())">
                                            <td>@(_duplicateRecord1.NcscRrn?.ToString() ?? "—")</td>
                                            <td>@(_duplicateRecord2.NcscRrn?.ToString() ?? "—")</td>
                                        </tr>

                                        @* Batch Code *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Batch Code
                                                @if (!string.Equals(_duplicateRecord1.BatchCode?.Trim(),
                                                                _duplicateRecord2.BatchCode?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(_duplicateRecord1.BatchCode, _duplicateRecord2.BatchCode)">
                                            <td>@(_duplicateRecord1.BatchCode ?? "—")</td>
                                            <td>@(_duplicateRecord2.BatchCode ?? "—")</td>
                                        </tr>

                                        @* Province *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Province
                                                @if (!string.Equals(_duplicateRecord1.ProvinceName?.Trim(),
                                                                _duplicateRecord2.ProvinceName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(_duplicateRecord1.ProvinceName, _duplicateRecord2.ProvinceName)">
                                            <td>@(_duplicateRecord1.ProvinceName ?? "—")</td>
                                            <td>@(_duplicateRecord2.ProvinceName ?? "—")</td>
                                        </tr>

                                        @* Municipality *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Municipality
                                                @if (!string.Equals(_duplicateRecord1.MunicipalityName?.Trim(),
                                                                _duplicateRecord2.MunicipalityName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(_duplicateRecord1.MunicipalityName, _duplicateRecord2.MunicipalityName)">
                                            <td>@(_duplicateRecord1.MunicipalityName ?? "—")</td>
                                            <td>@(_duplicateRecord2.MunicipalityName ?? "—")</td>
                                        </tr>

                                        @* Barangay *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Barangay
                                                @if (!string.Equals(_duplicateRecord1.BarangayName?.Trim(),
                                                                _duplicateRecord2.BarangayName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="@DiffClass(_duplicateRecord1.BarangayName, _duplicateRecord2.BarangayName)">
                                            <td>@(_duplicateRecord1.BarangayName ?? "—")</td>
                                            <td>@(_duplicateRecord2.BarangayName ?? "—")</td>
                                        </tr>

                                        @* Payment Status *@
                                        <tr style="background: var(--bs-light);">
                                            <td colspan="2" class="text-muted fw-semibold" style="font-size:10px; padding: 2px 4px;">
                                                Payment Status
                                                @if (_duplicateRecord1.PaymentStatus != _duplicateRecord2.PaymentStatus)
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Values differ"></i>
                                                }
                                            </td>
                                        </tr>
                                        <tr
