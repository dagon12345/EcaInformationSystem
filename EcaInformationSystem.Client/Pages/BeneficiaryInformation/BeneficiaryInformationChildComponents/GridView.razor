    private async Task ConfirmActionAsync()
    {
        try
        {
            IsSaving = true;
            errorMessage = null;
            successMessage = null;

            await confirmModal.HideAsync();

            if (string.IsNullOrWhiteSpace(pendingAction))
            {
                errorMessage = "No action selected.";
                return;
            }

            switch (pendingAction)
            {
                case "delete":
                    await SoftDeleteBeneficiaryAsync();
                    break;

                case "navigate":
                    //Routing here
                    Navigation.NavigateTo($"/beneficiary-edit/{selectedDetails!.Id}");
                    break;

                case "generate-payroll": // ← add if you wire payroll confirm here
                    await OpenPayrollModal();
                    break;

                default:
                    errorMessage = "Unknown action.";
                    break;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while processing. {ex.Message}";
        }
        finally
        {
            IsSaving = false;
            pendingAction = string.Empty;
            selectedDeleteItem = null;
        }
    }
    private async Task SoftDeleteBeneficiaryAsync()
    {
        if (selectedDeleteItem is null)
        {
            toast.ShowError("Failed to delete Grantee record. Item not found.");
            return;
        }

        try
        {
            // 1. Call the DELETE API directly using the Guid in the route
            var response = await Http.DeleteAsync($"api/beneficiary/soft-delete/{selectedDeleteItem.Id}");

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess($"Grantee '{selectedDeleteItem.FirstName} {selectedDeleteItem.LastName}' was deleted successfully.");

                // 2. Refresh the grid (via your State Service or local load method)
                // ✅ Reload if never loaded or marked stale by edit/delete/import
                if (!State.Beneficiaries.Any() || State.IsStale())
                {
                    State.Invalidate();
                    await State.LoadAsync();
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Failed to delete: {error}");
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"An error occurred: {ex.Message}");
        }
    }

