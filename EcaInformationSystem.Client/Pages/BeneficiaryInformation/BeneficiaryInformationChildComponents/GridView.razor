    private async Task ExecuteBulkUpdateAsync()
    {
        try
        {
            IsBulkUpdating = true;
            // ✅ Build RowVersions from the currently displayed records
            // State.Beneficiaries contains the DTOs with RowVersion from last load
            var rowVersions = State.Beneficiaries
                .Where(x => checkedIds.Contains(x.Id) && x.RowVersion != null)
                .ToDictionary(x => x.Id, x => x.RowVersion!);

            // 1. Create the request object matching the Controller's DTO
            var request = new
            {
                Ids = checkedIds.ToList(),
                PaymentStatus = bulkPaymentStatus,
                ModeOfPayment = bulkPaymentStatus == 2 ? bulkModeOfPayment : null, // ✅
                PaymentDate = bulkPaymentStatus == 2 ? bulkPaymentDate : null // ✅ 2 = Paid
            };

            // 2. Call the API directly using HttpClient
            var response = await Http.PostAsJsonAsync("api/beneficiary/bulk-payment-status", request);

            // ✅ Handle concurrency conflict
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var message = await response.Content.ReadAsStringAsync();
                toast.ShowError(message);
                // ✅ Reload so user sees the current state
                State.Invalidate();
                await State.LoadAsync();
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess(
                    $"Successfully updated {checkedIds.Count} record(s) to {GetPaymentStatusText(bulkPaymentStatus)}.");

                ClearSelection();
                if (!State.Beneficiaries.Any() || State.IsStale())
                {
                    State.Invalidate();
                    await State.LoadAsync();
                }
                if (bulkUpdateModal != null)
                    await bulkUpdateModal.HideAsync();

            }
            else
            {
                // Try to extract the error message from the API response
                var errorMsg = await response.Content.ReadAsStringAsync();
                toast.ShowError($"Bulk update failed: {errorMsg}");
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"An error occurred: {ex.Message}");
        }
        finally
        {
            IsBulkUpdating = false;
        }
    }


