private async Task ExecuteBulkAddPaymentHistoryAsync()
{
    // ✅ CHANGED — Payment Date is no longer required for bulk updates; see
    // OpenBulkPaymentHistoryModal above and BulkAddPaymentHistoryAsync.
    if (bulkPaymentStatus == 2 && bulkModeOfPayment == null)
    {
        toast.ShowError("Mode of Payment is required when status is Paid.");
        return;
    }
    // ✅ CHANGED: Allow quarter/fiscal year for both Paid AND Unpaid
    if ((bulkPaymentStatus == 2 || bulkPaymentStatus == 1) && (bulkPayrollQuarterOnly == null || _bulkFiscalYear == null))
    {
        toast.ShowError("Payroll Quarter and Fiscal Year are required when status is Paid or Unpaid.");
        return;
    }

    try
    {
        IsBulkUpdating = true;
        var request = new BulkAddPaymentHistoryRequestDto
        {
            Ids = checkedIds.ToList(),
            PayrollQuarter = bulkPayrollQuarterOnly,
            FiscalYear = _bulkFiscalYear,
            PaymentStatus = bulkPaymentStatus!.Value,
            ModeOfPayment = bulkModeOfPayment,
            PaymentDate = bulkPaymentDate
        };
        var response = await Http.PostAsJsonAsync("api/beneficiary/bulk-add-payment-history", request);

        await HandleApiResponseAsync(response,
            $"Recorded payment for {checkedIds.Count} record(s).",
            async () =>
            {
                ClearSelection();
                StateHasChanged();  
                State.Invalidate();
                await State.LoadAsync();
