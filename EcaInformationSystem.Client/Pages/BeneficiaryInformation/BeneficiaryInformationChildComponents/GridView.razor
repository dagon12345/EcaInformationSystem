<HxModal @ref="bulkRefNumberModal">
    <HeaderTemplate>
        <h5 class="modal-title">Confirm Reference Number Update</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>
            You are about to assign Reference Number
            <strong>@GetBulkRefPreview()</strong>
            to <strong>@checkedIds.Count</strong> record(s).
        </p>
        <p class="text-muted small mb-0">
            <i class="bi bi-info-circle me-1"></i>
            Each record will receive a unique 5-digit code in place of <strong>#####</strong>.
        </p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => bulkRefNumberModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="ExecuteBulkRefNumberAsync" Disabled="@IsBulkUpdatingRefNumber">
            @if (IsBulkUpdatingRefNumber)
            {
                <span>Updating...</span>
            }
            else
            {

                <span>Yes, Assign</span>
            }
        </HxButton>
    </FooterTemplate>
</HxModal>

<HxModal @ref="bulkOtherUpdateModal">
    <HeaderTemplate>
        <h5 class="modal-title">Confirm Bulk Update</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>You are about to update <strong>@checkedIds.Count</strong> record(s):</p>
        <ul class="mb-0">
            @if (!string.IsNullOrWhiteSpace(bulkIsEligible))
            {
                <li>Eligibility → <strong>@(bulkIsEligible == "true" ? "Eligible" : "Ineligible")</strong></li>
            }
            @if (!string.IsNullOrWhiteSpace(bulkBatchCode))
            {
                <li>Batch Code → <strong>@bulkBatchCode</strong></li>
            }
        </ul>
        <p class="mt-2 mb-0 text-muted small">This action cannot be undone easily.</p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => bulkOtherUpdateModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="ExecuteBulkOtherUpdateAsync" Disabled="@IsBulkUpdatingOther">
            @if (IsBulkUpdatingOther)
            {
                <span>Updating...</span>
            }
            else
            {

                <span>Yes, Update</span>
            }
        </HxButton>
    </FooterTemplate>
</HxModal>

<HxModal @ref="bulkCoStatusModal">
    <HeaderTemplate>
        <h5 class="modal-title">Confirm CO Status Update</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>
            You are about to set <strong>@checkedIds.Count</strong> record(s) to
            CO Status: <strong>@GetCoStatusLabel(int.TryParse(bulkCoStatus, out var s) ? s : 0)</strong>.
        </p>
        @if (bulkCoStatus == "1" && bulkCoDateEndorsed.HasValue)
        {
            <p class="mb-0">
