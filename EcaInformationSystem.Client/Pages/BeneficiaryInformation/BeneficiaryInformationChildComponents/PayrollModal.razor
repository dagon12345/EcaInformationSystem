@* ============================================================
   PayrollModal.razor — Improved
   Bug fixes:
   - P2 pagination: PAGE2_RECORDS = 7 (was 9 in RefreshPreview)
   - CGP number format matches backend exactly: {Region}-{MilestoneYear}{Month}-{Fixed}-{ShortYear}-{NNNN}
   - Municipality grouping headers render correctly inside while loop
   - Deceased rows highlighted in preview
   New features:
   - Live CGP number preview (updates on input)
   - MilestoneYear read-only (derived from BirthDate, not user input)
   - Stats bar in preview (records, provinces, municipalities, pages)
   - Records-per-page shown as read-only informational field
   - Background job queue/poll/download for large batches (no IIS timeout)
   ============================================================ *@

@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JS
@inject ToastService Toast

<HxModal @ref="_modal" Size="ModalSize.ExtraLarge">
    <HeaderTemplate>
        <div class="d-flex align-items-center gap-2">
            <div class="rounded-2 d-flex align-items-center justify-content-center"
                 style="width:32px;height:32px;background:#EAF3DE;">
                <i class="bi bi-file-earmark-excel text-success"></i>
            </div>
            <div>
                <h5 class="modal-title mb-0">Generate Cash Gift Payroll</h5>
                <small class="text-muted">Configure and export payroll sheets grouped by province and municipality</small>
            </div>
        </div>
    </HeaderTemplate>

    <BodyTemplate>
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(_activeTab == "settings" ? "active" : "")"
                        @onclick='() => _activeTab = "settings"'>
                    <i class="bi bi-gear me-1"></i>Settings
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == "preview" ? "active" : "")"
                        @onclick="SwitchToPreview">
                    <i class="bi bi-eye me-1"></i>Preview
                </button>
            </li>
        </ul>

        @if (!string.IsNullOrWhiteSpace(_payrollJobError))
        {
            <div class="alert alert-danger py-2 mb-3 small">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Last generation failed: @_payrollJobError
            </div>
        }

        @* ── SETTINGS TAB ─────────────────────────────────────────────────── *@
        @if (_activeTab == "settings")
        {
            <div class="row g-3">

                @* ── CGP Numbering ── *@
                <div class="col-12">
                    <div class="card border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title fw-semibold mb-3">
                                <i class="bi bi-hash me-1 text-secondary"></i>CGP Numbering
                            </h6>
                            <div class="row g-2 mb-2">
                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold">Region Code</label>
                                    <input class="form-control form-control-sm"
                                           @bind="_settings.RegionCode"
                                           @bind:event="oninput"
                                           @bind:after="StateHasChanged" />
                                    <div class="form-text">e.g. RegionXIII</div>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-semibold">Milestone Year</label>
                                    <input class="form-control form-control-sm bg-white"
                                           value="@_milestoneYearDisplay"
                                           disabled
                                           title="Derived from beneficiary birth date" />
                                    <div class="form-text text-muted">From record</div>
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label small fw-semibold">Month</label>
                                    <input class="form-control form-control-sm"
                                           @bind="_settings.Month"
                                           @bind:event="oninput"
                                           @bind:after="StateHasChanged"
                                           maxlength="2" placeholder="MM" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-semibold">Fixed Segment</label>
                                    <input class="form-control form-control-sm"
                                           @bind="_settings.FixedSegment"
                                           @bind:event="oninput"
                                           @bind:after="StateHasChanged"
                                           maxlength="4" />
                                    <div class="form-text">Usually "01"</div>
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label small fw-semibold">Short Year</label>
                                    <input class="form-control form-control-sm"
                                           @bind="_settings.ShortenYear"
                                           @bind:event="oninput"
                                           @bind:after="StateHasChanged"
                                           maxlength="2" placeholder="26" />
                                </div>
                            </div>

                            @* Live CGP Preview *@
                            <div class="alert alert-success py-2 mb-0 small d-flex align-items-center gap-2">
                                <i class="bi bi-tag-fill flex-shrink-0"></i>
                                <div>
                                    <strong>CGP Preview: </strong>
                                    <code>@CgpNumber(1)</code>
                                    <span class="mx-1 text-muted">→</span>
                                    <code>@CgpNumber(2)</code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Pagination info strip *@
                <div class="col-12">
                    <div class="alert alert-light border small mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-primary flex-shrink-0"></i>
                        <span>
                            <strong>@_selectedCount record(s)</strong> selected &mdash;
                            Grouped by <strong>Province → Municipality → Barangay</strong>.
                            Page 1 = <strong>6 records</strong>, Page 2+ = <strong>7 records</strong>.
                            Output: one <code>.xlsx</code> per province inside a <code>.zip</code>.
                        </span>
                    </div>
                </div>

                @* ── Signatory 1 — SARAH ROSE ── *@
                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title fw-semibold mb-3 small text-uppercase text-muted">
                                <span class="badge rounded-circle bg-primary me-1">1</span>
                                Certified by
                            </h6>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Certification Text</label>
                                <textarea class="form-control form-control-sm" rows="2"
                                          @bind="_settings.Signatory1Label"></textarea>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Name</label>
                                    <input class="form-control form-control-sm" @bind="_settings.Signatory1Name" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Position</label>
                                    <input class="form-control form-control-sm" @bind="_settings.Signatory1Position" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── Signatory 2 — CESAR ── *@
                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title fw-semibold mb-3 small text-uppercase text-muted">
                                <span class="badge rounded-circle bg-success me-1">2</span>
                                Approved by
                            </h6>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Approval Label</label>
                                <input class="form-control form-control-sm" @bind="_settings.Signatory2Label" />
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Name</label>
                                    <input class="form-control form-control-sm" @bind="_settings.Signatory2Name" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Position</label>
                                    <input class="form-control form-control-sm" @bind="_settings.Signatory2Position" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── Signatory 3 — ALMIRA (SDO) ── *@
                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title fw-semibold mb-3 small text-uppercase text-muted">
                                <span class="badge rounded-circle bg-warning text-dark me-1">3</span>
                                SDO Officer
                            </h6>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Name</label>
                                    <input class="form-control form-control-sm" @bind="_settings.Signatory3Name" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Label / Position</label>
                                    <input class="form-control form-control-sm" @bind="_settings.Signatory3Position" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── Signatory 4 — Other Officers ── *@
                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title fw-semibold mb-3 small text-uppercase text-muted">
                                <span class="badge rounded-circle bg-secondary me-1">4</span>
                                Other Officers (×2 blank blocks)
                            </h6>
                            <div>
                                <label class="form-label small fw-semibold">Label (used for both blocks)</label>
                                <input class="form-control form-control-sm" @bind="_settings.Signatory4Position" />
                                <div class="form-text">e.g. "other officer present during Payout"</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }

        @* ── PREVIEW TAB ──────────────────────────────────────────────────── *@
        @if (_activeTab == "preview")
        {
            @if (_isLoadingPreview)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2 text-muted small">Building preview…</p>
                </div>
            }
            else
            {
                @* Stats bar *@
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-people me-1"></i>
                            <strong>@_previewData.Count</strong> records
                        </span>
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-building me-1"></i>
                            <strong>@_provinceCount</strong> province(s)
                        </span>
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-geo me-1"></i>
                            <strong>@_municipalityCount</strong> municipality(ies)
                        </span>
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-file-earmark me-1"></i>
                            <strong>@_previewPages.Count</strong> page(s)
                        </span>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshPreview">
                        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                    </button>
                </div>

                <div style="max-height:600px; overflow-y:auto; background:#d0d0d0;
                    padding:8px; border-radius:4px;">
                    <div style="background:white; font-family:Arial,sans-serif; font-size:8pt;
                        padding:16px; border:1px solid #aaa;">

                        @* ── DOCUMENT HEADER ── *@
                        <div style="text-align:center; margin-bottom:8px;">
                            <div style="font-size:11pt; font-weight:bold;">
                                NATIONAL COMMISSION OF SENIOR CITIZENS
                            </div>
                            <div style="font-size:8.5pt;">
                                Regional Office XIII, Province of @(_previewData.FirstOrDefault()?.ProvinceName ?? "—"),
                                @(_previewData.FirstOrDefault()?.MunicipalityName ?? "—")
                            </div>
                            <div style="font-size:8.5pt;">Expanded Centenarian Act</div>
                            <div style="font-size:10pt; font-weight:bold; margin-top:4px;">
                                CASH GIFT PAYROLL
                            </div>
                        </div>

                        @* ── PURPOSE ROW ── *@
                        <div style="display:flex; align-items:flex-start; gap:8px; margin:6px 0; font-size:7.5pt;">
                            <span style="font-weight:bold; white-space:nowrap;">A. PURPOSE:</span>
                            <span style="flex:1;">
                                Cash gift payout for Octogenarians, Nonagenarians, and Centenarians
                                pursuant to R.A. No. 11982 - Expanded Centenarian Act.
                            </span>
                            <span style="border:1px solid #333; padding:2px 5px; font-size:6.5pt;
                                white-space:nowrap; flex-shrink:0;">
                                @CgpNumber(1, _previewData.FirstOrDefault()?.MilestoneYear)
                            </span>
                        </div>

                        @* ── COLUMN HEADERS ── *@
                        <table style="width:100%; border-collapse:collapse; font-size:7pt;">
                            <colgroup>
                                <col style="width:10%" />
                                <col style="width:3%" />
                                <col style="width:6%" />
                                <col style="width:6%" />
                                <col style="width:6%" />
                                <col style="width:3%" />
                                <col style="width:7%" />
                                <col style="width:3%" />
                                <col style="width:5%" />
                                <col style="width:7%" />
                                <col style="width:6%" />
                                <col style="width:6%" />
                                <col style="width:7%" />
                                <col style="width:5%" />
                                <col style="width:8%" />
                                <col style="width:5%" />
                                <col style="width:5%" />
                                <col style="width:7%" />
                            </colgroup>
                            <tr style="background:#1F3864; color:white; font-weight:bold; height:14pt;">
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">Batch Code</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">No.</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" colspan="4">Full Name of Beneficiary</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">BDate<br />(mm/dd/yyyy)</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">Age</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">Sex</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">Barangay</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">Amount</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">Amount Received</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" colspan="2">Beneficiary / Authorized Representative</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">For Auth. Rep.</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">Date of Death</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">Date Received</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px;" rowspan="3">Remarks</th>
                            </tr>
                            <tr style="background:#1F3864; height:8pt;">
                                <td colspan="4" style="border:1px solid #555;"></td>
                                <td colspan="2" style="border:1px solid #555;"></td>
                            </tr>
                            <tr style="background:#1F3864; color:white; font-weight:bold; height:32pt;">
                                <th style="border:1px solid #555; text-align:center; padding:2px; vertical-align:middle;">Last Name</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px; vertical-align:middle;">First Name</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px; vertical-align:middle;">Middle Name</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px; vertical-align:middle;">Ext.</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px; vertical-align:middle;">Signature Over Printed Name</th>
                                <th style="border:1px solid #555; text-align:center; padding:2px; vertical-align:middle;">Thumbmark</th>
                            </tr>
                        </table>

                        @* ── DATA ROWS ── *@
                        <table style="width:100%; border-collapse:collapse; font-size:7pt;">
                            <colgroup>
                                <col style="width:10%" />
                                <col style="width:3%" />
                                <col style="width:6%" />
                                <col style="width:6%" />
                                <col style="width:6%" />
                                <col style="width:3%" />
                                <col style="width:7%" />
                                <col style="width:3%" />
                                <col style="width:5%" />
                                <col style="width:7%" />
                                <col style="width:6%" />
                                <col style="width:6%" />
                                <col style="width:7%" />
                                <col style="width:5%" />
                                <col style="width:8%" />
                                <col style="width:5%" />
                                <col style="width:5%" />
                                <col style="width:7%" />
                            </colgroup>

                            @{
                                decimal total = 0;
                                // ✅ FIX: Matches backend PAGE2_RECORDS = 7 (was incorrectly 9)
                                const int P1 = 6;
                                const int P2 = 7;
                                int globalSeq = 1;
                            }

                            @foreach (var provinceGroup in _previewData.GroupBy(x => x?.ProvinceName).OrderBy(g => g.Key))
                            {
                                @* Province header row *@
                                <tr>
                                    <td colspan="18"
                                        style="background:#212529; color:white; font-weight:bold;
                                        padding:6px 8px; font-size:8pt;
                                        border-top:2px solid #000;">
                                        <i class="bi bi-building me-1"></i>
                                        Province Workbook: @provinceGroup.Key
                                    </td>
                                </tr>

                                int pageN = 1;
                                int done = 0;

                                var provinceRecords = provinceGroup
                                    .OrderBy(x => x?.MunicipalityName)
                                    .ThenBy(x => x?.LastName)
                                    .ThenBy(x => x?.FirstName)
                                    .ThenBy(x => x?.MiddleName)
                                    .ToList();

                                while (done < provinceRecords.Count)
                                {
                                    int take = pageN == 1 ? P1 : P2;
                                    var pageRecs = provinceRecords.Skip(done).Take(take).ToList();

                                    if (pageN > 1)
                                    {
                                        <tr>
                                            <td colspan="16"></td>
                                            <td colspan="2"
                                                style="border:1px solid #333; text-align:right;
                                                font-size:6.5pt; padding:2px 5px;
                                                vertical-align:middle; height:18pt;">
                                                @CgpNumber(pageN, provinceRecords.FirstOrDefault()?.MilestoneYear)
                                            </td>
                                        </tr>
                                    }

                                    string? prevMuni = pageN == 1
                                        ? null
                                        : provinceRecords.Take(done).LastOrDefault()?.MunicipalityName;

                                    foreach (var rec in pageRecs)
                                    {
                                        if (rec?.MunicipalityName != prevMuni)
                                        {
                                            <tr>
                                                <td colspan="18"
                                                    style="background:#f1f3f5; font-weight:bold;
                                                    padding:5px 8px; border-top:1.5px solid #666;
                                                    font-size:7.5pt;">
                                                    Municipality Sheet: @rec?.MunicipalityName
                                                </td>
                                            </tr>
                                        }
                                        prevMuni = rec?.MunicipalityName;
                                        decimal newTotal = PayrollSettingsDto.CalculateCashGiftAmount(rec?.Age ?? 0);
                                        total += newTotal;

                                        @* ✅ Deceased rows highlighted *@
                                        bool isDeceased = rec?.IsDeceased == true;

                                        // ✅ Pre-computed full style strings instead of embedding
                                        // @(...) ternaries inside multi-line HTML attributes.
                                        // This avoids the Razor formatter's "changes must not
                                        // overlap" crash, which is triggered when the C# formatter
                                        // and HTML formatter both try to reformat overlapping spans
                                        // around an inline expression sitting inside an attribute.
                                        string rowStyle = isDeceased
                                            ? "height:25pt; vertical-align:middle; background:#fff5f5;"
                                            : "height:25pt; vertical-align:middle;";

                                        string dateOfDeathCellStyle = isDeceased
                                            ? "border:1px solid #ccc; padding:2px; text-align:center; color:#c0392b; font-weight:bold;"
                                            : "border:1px solid #ccc; padding:2px; text-align:center;";

                                        string remarksCellStyle = isDeceased
                                            ? "border:1px solid #ccc; padding:2px; font-size:6.5pt; color:#c0392b;"
                                            : "border:1px solid #ccc; padding:2px; font-size:6.5pt;";

                                        string dateOfDeathText = isDeceased && rec?.DateOfDeath != null
                                            ? rec.DateOfDeath.Value.ToString("MM/dd/yyyy")
                                            : string.Empty;

                                        string remarksText = isDeceased ? "Deceased" : string.Empty;

                                        <tr style="@rowStyle">
                                            <td style="border:1px solid #ccc; padding:2px;">
                                                @rec?.BatchCode?.ToUpperInvariant()
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px; text-align:center;">
                                                @globalSeq
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px;">
                                                @rec?.LastName?.ToUpperInvariant()
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px;">
                                                @rec?.FirstName?.ToUpperInvariant()
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px;">
                                                @rec?.MiddleName?.ToUpperInvariant()
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px;">
                                                @rec?.Extension
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px; text-align:center;">
                                                @rec?.BirthDate.ToString("MM/dd/yyyy")
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px; text-align:center;">
                                                @rec?.Age
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px; text-align:center;">
                                                @(rec?.Sex == 1 ? "MALE" : "FEMALE")
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px;">
                                                @rec?.BarangayName?.ToUpperInvariant()
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px; text-align:right;">
                                                @PayrollSettingsDto.CalculateCashGiftAmount(rec?.Age ?? 0).ToString("N2")
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px;"></td>
                                            <td style="border:1px solid #ccc; padding:2px;"></td>
                                            <td style="border:1px solid #ccc; padding:2px;"></td>
                                            <td style="border:1px solid #ccc; padding:2px;"></td>
                                            <td style="@dateOfDeathCellStyle">
                                                @dateOfDeathText
                                            </td>
                                            <td style="border:1px solid #ccc; padding:2px;"></td>
                                            <td style="@remarksCellStyle">
                                                @remarksText
                                            </td>
                                        </tr>

                                        globalSeq++;
                                    }

                                    done += pageRecs.Count; pageN++;
                                }
                            }

                            @* SUBTOTAL *@
                            <tr style="font-weight:bold; height:14pt; vertical-align:middle;
                                background:#f0f4e8; border-top:1.5px solid #3B6D11;">
                                <td colspan="10" style="border:1px solid #999;
                                    text-align:right; padding:2px;">
                                    SUBTOTAL
                                </td>
                                <td style="border:1px solid #999; padding:2px;
                                    text-align:right; color:#27500A;">
                                    @total.ToString("N2")
                                </td>
                                <td colspan="7" style="border:1px solid #999;"></td>
                            </tr>
                        </table>

                        @* ── SIGNATORIES ── *@
                        <div style="margin-top:14px; font-size:8pt;">

                            @* Cert text — left side *@
                            <div style="font-style:italic; width:55%; margin-bottom:8px; line-height:1.4;">
                                @_settings.Signatory1Label
                            </div>

                            @* Approved for Payment — right side *@
                            <div style="display:flex; justify-content:flex-end; margin-bottom:4px;">
                                <div style="width:42%; font-weight:bold; text-align:center;">
                                    @_settings.Signatory2Label
                                </div>
                            </div>

                            @* Signing space *@
                            <div style="height:42px;"></div>

                            @* Sig names row: SARAH ROSE (left) | CESAR (right) *@
                            <div style="display:flex; justify-content:space-between; align-items:flex-end;">
                                <div style="width:28%; text-align:center;">
                                    <div style="border-bottom:1px solid #000; font-weight:bold; padding-bottom:2px;">
                                        @_settings.Signatory1Name
                                    </div>
                                    <div style="font-size:7.5pt; margin-top:2px;">@_settings.Signatory1Position</div>
                                </div>
                                <div style="width:38%; text-align:center;">
                                    <div style="border-bottom:1px solid #000; font-weight:bold; padding-bottom:2px;">
                                        @_settings.Signatory2Name
                                    </div>
                                    <div style="font-size:7.5pt; margin-top:2px;">@_settings.Signatory2Position</div>
                                </div>
                            </div>

                            @* Oath text *@
                            <div style="margin-top:14px; width:55%; line-height:1.5; font-size:7.5pt;">
                                R. I/we certify on my/our official oath that on ______________________________________,
                                I/we have paid in cash to each individual on the payroll, the amount set opposite to
                                each name, having presented himself/herself, established identity and affixed
                                his/her signature or thumbmark on the space provided.
                            </div>

                            <div style="height:28px;"></div>

                            @* Bottom sig blocks: ALMIRA (center) | Officer1 | Officer2 *@
                            <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-top:4px;">
                                <div style="width:35%; text-align:center; margin-left:6%;">
                                    <div style="border-bottom:1px solid #000; font-weight:bold; padding-bottom:2px;">
                                        @_settings.Signatory3Name
                                    </div>
                                    <div style="font-size:7.5pt; margin-top:2px;">@_settings.Signatory3Position</div>
                                </div>
                                <div style="width:18%; text-align:center;">
                                    <div style="border-bottom:1px solid #000; padding-bottom:2px; min-height:14px;">&nbsp;</div>
                                    <div style="font-size:7pt; margin-top:2px; line-height:1.3;">
                                        Printed Name and Signature of<br />@_settings.Signatory4Position
                                    </div>
                                </div>
                                <div style="width:18%; text-align:center;">
                                    <div style="border-bottom:1px solid #000; padding-bottom:2px; min-height:14px;">&nbsp;</div>
                                    <div style="font-size:7pt; margin-top:2px; line-height:1.3;">
                                        Printed Name and Signature of<br />@_settings.Signatory4Position
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            }
        }
    </BodyTemplate>

    <FooterTemplate>
        <div class="d-flex justify-content-between w-100">
            <HxButton Color="ThemeColor.Secondary" @onclick="CancelAndClose">
                Cancel
            </HxButton>
            <div class="d-flex gap-2">
                @if (_activeTab == "settings")
                {
                    <HxButton Color="ThemeColor.Info" @onclick="SwitchToPreview">
                        <i class="bi bi-eye me-1"></i>Preview
                    </HxButton>
                }
                <HxButton Color="ThemeColor.Success"
                          @onclick="DownloadPayrollAsync"
                          Disabled="@_isDownloading">
                    @if (_isDownloading)
                    {
                        <span>@GetProgressLabel()</span>
                    }
                    else
                    {
                        <i class="bi bi-download me-1"></i><span>Download Payroll</span>
                    }
                </HxButton>
            </div>
        </div>
    </FooterTemplate>
</HxModal>

@code {
    private HxModal _modal = default!;
    private string _activeTab = "settings";
    private bool _isLoadingPreview;
    private bool _isDownloading;
    private int _selectedCount;

    // ✅ Background job progress state
    private string _payrollJobState = string.Empty;   // "", "Queued", "Processing", "Completed", "Failed"
    private string? _payrollJobError;
    private CancellationTokenSource? _pollCts;

    // Computed preview stats
    private int _provinceCount;
    private int _municipalityCount;
    private string _milestoneYearDisplay = "";

    private PayrollSettingsDto _settings = new();
    private List<BeneficiaryInformationDto?> _previewData = new();
    private List<(int PageNum, List<BeneficiaryInformationDto?> Recs)> _previewPages = new();

    // ─────────────────────────────────────────────────────────────────────────
    // CGP Number helper — builds the formatted CGP string exactly as the
    // backend does: {RegionCode}-{MilestoneYear}{Month}-{FixedSegment}-{ShortenYear}-{NNNN}
    // milestoneYear is optional so we can call it from both header and per-page rows.
    // ─────────────────────────────────────────────────────────────────────────
    private string CgpNumber(int pageNum, int? milestoneYear = null)
    {
        var year = milestoneYear ?? 0;
        var yearStr = year > 0 ? year.ToString() : "YYYY";
        return $"CGP No.: {_settings.RegionCode}-{yearStr}{_settings.Month}-{_settings.FixedSegment}-{_settings.ShortenYear}-{pageNum:D4}";
    }

    private string GetProgressLabel() => _payrollJobState switch
    {
        "Queued" => "Queued…",
        "Processing" => $"Generating {_selectedCount} record(s)…",
        _ => "Starting…"
    };

    private async Task CancelAndClose()
    {
        _pollCts?.Cancel();
        await _modal.HideAsync();
    }

    public async Task ShowAsync(List<Guid> selectedIds)
    {
        var distinctIds = selectedIds.Distinct().ToList();

        // Fetch the full beneficiary records for ALL selected IDs from the server.
        // This is necessary because State.Beneficiaries only holds the current page —
        // selections made on other pages would otherwise be silently missing.
        List<BeneficiaryInformationDto> fetched;
        try
        {
            fetched = await Http.PostAsJsonAsync("api/beneficiary/by-ids", distinctIds)
                          .ContinueWith(async t =>
                          {
                              var resp = await t;
                              resp.EnsureSuccessStatusCode();
                              return await resp.Content.ReadFromJsonAsync<List<BeneficiaryInformationDto>>()
                                     ?? new List<BeneficiaryInformationDto>();
                          }).Unwrap();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load selected records: {ex.Message}");
            return;
        }

        _previewData = fetched
            .OrderBy(x => x.ProvinceName)
            .ThenBy(x => x.MunicipalityName)
            .ThenBy(x => x.LastName)
            .ThenBy(x => x.FirstName)
            .ThenBy(x => x.MiddleName)
            .Cast<BeneficiaryInformationDto?>()
            .ToList();

        _selectedCount = _previewData.Count;

        // Compute stats for the UI
        _provinceCount = _previewData.Select(x => x?.ProvinceName).Distinct().Count();
        _municipalityCount = _previewData.Select(x => x?.MunicipalityName).Distinct().Count();

        // MilestoneYear is read-only — derived from the first record's BirthDate
        var firstMilestone = _previewData.FirstOrDefault()?.MilestoneYear ?? 0;
        _milestoneYearDisplay = firstMilestone > 0 ? firstMilestone.ToString() : "—";

        _settings = new PayrollSettingsDto
        {
            Ids = distinctIds,
            Month = DateTime.Today.ToString("MM"),
            RecordsPerPage = 15,
        };

        _activeTab = "settings";
        _previewPages.Clear();

        await _modal.ShowAsync();
    }

    private async Task SwitchToPreview()
    {
        _activeTab = "preview";
        await RefreshPreview();
    }

    private Task RefreshPreview()
    {
        _isLoadingPreview = true;
        StateHasChanged();

        _previewPages.Clear();

        // ✅ FIX: PAGE2_RECORDS = 7 — matches BuildPayrollSheet exactly
        const int p1 = 6, p2 = 7;
        int done = 0, pageN = 1;

        while (done < _previewData.Count)
        {
            int take = pageN == 1 ? p1 : p2;
            var slice = _previewData.Skip(done).Take(take).ToList();
            _previewPages.Add((pageN, slice));
            done += slice.Count;
            pageN++;
        }

        _isLoadingPreview = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task DownloadPayrollAsync()
    {
        if (_settings.Ids == null || !_settings.Ids.Any())
        {
            Toast.ShowError("No records selected.");
            return;
        }

        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();

        try
        {
            _isDownloading = true;
            _payrollJobState = "Queued";
            _payrollJobError = null;
            StateHasChanged();

            _settings.Ids = _settings.Ids.Distinct().ToList();

            // 1️⃣ Queue the job — returns almost instantly, no IIS timeout risk
            var queueResponse = await Http.PostAsJsonAsync("api/payroll/queue-payroll", _settings);

            if (!queueResponse.IsSuccessStatusCode)
            {
                var err = await queueResponse.Content.ReadAsStringAsync();
                Toast.ShowError($"Failed to start payroll generation: {err}");
                return;
            }

            var queued = await queueResponse.Content.ReadFromJsonAsync<PayrollJobQueuedResponse>();
            if (queued is null)
            {
                Toast.ShowError("Unexpected response while queuing payroll generation.");
                return;
            }

            var jobId = queued.JobId;

            // 2️⃣ Poll status every 2s until Completed or Failed
            while (!_pollCts.IsCancellationRequested)
            {
                await Task.Delay(2000, _pollCts.Token);

                var statusResponse = await Http.GetAsync($"api/payroll/status/{jobId}");

                if (statusResponse.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    Toast.ShowError("Lost track of the payroll job (server may have restarted). Please try again.");
                    return;
                }

                if (!statusResponse.IsSuccessStatusCode)
                {
                    Toast.ShowError("Failed to check payroll job status.");
                    return;
                }

                var status = await statusResponse.Content.ReadFromJsonAsync<PayrollJobStatusResponse>();
                if (status is null) continue;

                _payrollJobState = status.State;
                StateHasChanged();

                if (status.State == "Completed")
                {
                    var fileResponse = await Http.GetAsync(
                        $"api/payroll/download/{jobId}",
                        HttpCompletionOption.ResponseHeadersRead);

                    if (!fileResponse.IsSuccessStatusCode)
                    {
                        var err = await fileResponse.Content.ReadAsStringAsync();
                        Toast.ShowError($"Payroll generation finished, but download failed: {err}");
                        return;
                    }

                    var fileStream = await fileResponse.Content.ReadAsStreamAsync();
                    using var streamRef = new DotNetStreamReference(stream: fileStream, leaveOpen: false);

                    var fileName = $"CashGiftPayroll_{DateTime.Now:yyyy-MM-dd}.zip";
                    await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

                    await _modal.HideAsync();
                    Toast.ShowSuccess($"Payroll downloaded — {_previewData.Count} record(s).");
                    return;
                }

                if (status.State == "Failed")
                {
                    _payrollJobError = status.ErrorMessage ?? "Unknown error.";
                    Toast.ShowError($"Payroll generation failed: {_payrollJobError}");
                    return;
                }

                // else "Queued" or "Processing" — keep polling
            }
        }
        catch (OperationCanceledException)
        {
            // Modal closed or a new generation started — silently stop polling
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isDownloading = false;
            _payrollJobState = string.Empty;
            StateHasChanged();
        }
    }

    // ✅ Lightweight response shapes matching PayrollController's JSON
    private class PayrollJobQueuedResponse
    {
        public Guid JobId { get; set; }
    }

    private class PayrollJobStatusResponse
    {
        public Guid JobId { get; set; }
        public string State { get; set; } = string.Empty;
        public int TotalRecords { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
