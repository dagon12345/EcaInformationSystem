@* AnnexMPrintDocument.razor — Annex M: Liveness Check and Confirmation of Transaction Account
   Form (for old forms). Same data shape as LivenessCheckPrintDocument.razor (no new
   entity/DTO fields) — reuses BeneficiaryInformationDto. Independent, one-page A4 document
   with its own print scope (#annex-m-print-target) — printing it never pulls in Annex A/B or
   the Liveness form, even when all are rendered on the same page. *@
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Client.Services

@* ── Live print-formatting controls — Scale/Font/Margin apply as CSS custom
     properties on .annexm-doc, so this preview always shows exactly what
     will print (no separate print-only sizing to keep in sync). ── *@
<div class="no-print annexb-print-controls mb-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
        <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-sliders me-1"></i>Print Settings</h6>
        <button type="button" class="btn btn-primary btn-sm" @onclick="PrintAsync"
                title="View & print the Annex M Liveness Check and Confirmation of Transaction Account Form">
            <i class="bi bi-printer me-1"></i>Print Annex M
        </button>
    </div>
    <div class="row g-3 align-items-end">
        <div class="col-sm-4">
            <label class="form-label small fw-bold mb-1">Scale <span class="text-muted">(@_scalePercent%)</span></label>
            <input type="range" class="form-range" min="60" max="120" step="1"
                   @bind-value="_scalePercent" @bind-value:event="oninput" />
        </div>
        <div class="col-sm-4">
            <label class="form-label small fw-bold mb-1">Font Size <span class="text-muted">(@_fontPercent%)</span></label>
            <input type="range" class="form-range" min="70" max="130" step="1"
                   @bind-value="_fontPercent" @bind-value:event="oninput" />
        </div>
        <div class="col-sm-4">
            <label class="form-label small fw-bold mb-1">Margin <span class="text-muted">(@_marginMm mm)</span></label>
            <input type="range" class="form-range" min="0" max="25" step="1"
                   @bind-value="_marginMm" @bind-value:event="oninput" />
        </div>
    </div>
    <div class="text-end mt-2 d-flex justify-content-end gap-3">
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="SavePrintSettingsAsync">
            <i class="bi bi-save me-1"></i>Save as default
        </button>
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="ResetPrintSettings">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to defaults
        </button>
    </div>
</div>

<div class="annexm-doc" id="annex-m-print-target" style="@RootStyle">
  <div class="annexm-doc-inner">

    @* ══════════════════ HEADER — logos + agency text (same treatment as Annex A/B/Liveness) ══════════════════ *@
    <div class="annexa-doc-header-row">
        <img src="@_ncscLogoSrc" alt="NCSC Seal" class="annexa-doc-logo-left" />
        <div class="annexa-doc-header-text">
            <div class="annexa-doc-header-line1">Republic of the Philippines</div>
            <div class="annexa-doc-header-line1">Office of the President</div>
            <div class="annexa-doc-header-title">NATIONAL COMMISSION OF SENIOR CITIZENS</div>
            <div class="annexa-doc-header-address">
                20th Floor, The Upper Class Tower, Quezon Avenue Corner Scout Reyes,<br />
                Barangay Paligsahan, District 4, Quezon City
            </div>
        </div>
        <img src="@_bagongLogoSrc" alt="Bagong Pilipinas" class="annexa-doc-logo-right" />
    </div>

    <div class="annexa-doc-annex-tag">
        <div class="fw-bold fst-italic">ANNEX M</div>
    </div>

    @* ══════════════════ TITLE BLOCK ══════════════════ *@
    <div class="annexa-doc-title-box annexm-title-box">
        <div class="annexa-doc-title-main">LIVENESS CHECK AND CONFIRMATION OF TRANSACTION ACCOUNT FORM</div>
        <div class="text-muted fst-italic annexm-doc-subtitle">(to be filled-up by NCSC personnel only, especially if old forms were used)</div>
    </div>

    @* ══════════════════ A. PERSONAL INFORMATION ══════════════════ *@
    <div class="annexa-doc-bar">A. PERSONAL INFORMATION</div>
    <table class="annexa-doc-table">
        <tr>
            <td style="width:50%;">
                <span class="annexa-doc-field-label">A.1 NCSC Registration Reference Number:</span>
                <span class="annexa-doc-field-value">@(Beneficiary.NcscRrn?.ToString() ?? "")</span>
            </td>
            <td style="width:50%;">
                <span class="annexa-doc-field-label">A.2 OSCA ID Number</span>
                <span class="annexa-doc-field-value">@(Beneficiary.OscaIdNumber ?? "")</span>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="annexa-doc-field-label">A.3 Full Name <em>(Last Name, Given Name, Middle Name, Ext.)</em></span>
                <span class="annexa-doc-field-value">@FullName</span>
            </td>
        </tr>
        <tr>
            <td style="width:50%;">
                <span class="annexa-doc-field-label">A.4 Date of Birth <em>(Month/Day/Year)</em></span>
                <span class="annexa-doc-field-value">@Beneficiary.BirthDate.ToString("MMMM dd, yyyy")</span>
            </td>
            <td style="width:50%;">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <span class="annexa-doc-field-label">A.5 Date of Death if deceased <em>(Month/Day/Year)</em></span>
                        <span class="annexa-doc-field-value">@(Beneficiary.DateOfDeath?.ToString("MMMM dd, yyyy") ?? "")</span>
                    </div>
                    <div class="text-end flex-shrink-0 annexm-doc-age-cell">
                        <span class="annexa-doc-field-label d-block">A.6 Age</span>
                        <span class="annexa-doc-field-value">@Beneficiary.Age</span>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="annexa-doc-field-label">A.7 NCSC Approval Batch Code Number:</span>
                <span class="annexa-doc-field-value">@(Beneficiary.BatchCode ?? "")</span>
            </td>
        </tr>
    </table>

    @* ══════════════════ B. LIVENESS CHECK DETAILS ══════════════════ *@
    <div class="annexa-doc-bar">B. LIVENESS CHECK DETAILS</div>
    <table class="annexa-doc-vc-table">
        <tr class="annexa-doc-col-headers">
            <td style="width:75%;"></td>
            <td style="width:25%;" class="fw-bold">REMARKS</td>
        </tr>
        <tr>
            <td>
                <span class="annexa-doc-field-label d-block">Date and Time Conducted:</span>
                <span class="annexa-doc-field-value annexa-doc-underline-value d-block">@(Beneficiary.DateOfLiveness?.ToString("MMMM dd, yyyy") ?? "")</span>
            </td>
            <td></td>
        </tr>
        <tr>
            <td>
                @* Intentionally left blank — filled in by hand at the time of printing, not reflected from any system field. *@
                <span class="annexa-doc-field-label d-block">Platform Used, may include other details as to proof of life:</span>
                <div class="annexm-doc-findings-line"></div>
            </td>
            <td></td>
        </tr>
    </table>

    @* ══════════════════ C. CONFIRMATION OF TRANSACTION ACCOUNT DETAILS ══════════════════ *@
    <div class="annexa-doc-bar">C. CONFIRMATION OF TRANSACTION ACCOUNT DETAILS</div>
    <table class="annexa-doc-table annexm-doc-boxed-table">
        <tr>
            <td>
                <div class="annexm-doc-subheader">BANK ACCOUNT DETAILS</div>

                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">Account No.:</span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill">@(BankAccount?.AccountNumber ?? "")</span>
                </div>
                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">Bank Name <em>(no acronyms)</em>:</span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill">@(BankAccount?.BankOrWalletName ?? "")</span>
                </div>
                @* Branch Name left blank for Palawan (channel 4) — same field as
                   "Preferred branch" below, would otherwise print twice. *@
                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">Branch Name <em>(no acronyms)</em>:</span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill">@(BankAccount?.PreferredChannel == 4 ? "" : (BankAccount?.BranchName ?? ""))</span>
                </div>
                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">Bank Address:</span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill">@(BankAccount?.BankAddress ?? "")</span>
                </div>
                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">Is this a Joint Account (Yes/No)?</span>
                    <span class="annexa-doc-underline-value" style="min-width:60px;">@JointAccountDisplay</span>
                    <em class="annexm-doc-inline-note">If yes, need to present proof that the account is a joint account. Photocopy only.</em>
                </div>

                <div class="annexm-doc-subheader annexm-doc-subheader--sm">For Living Abroad Only:</div>
                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">BIC/SWIFTCODE:</span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill">@(BankAccount?.SwiftCode ?? "")</span>
                </div>
                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">IBAN for European Countries:</span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill">@(BankAccount?.Iban ?? "")</span>
                </div>

                <div class="annexm-doc-field-row mt-1">
                    <span class="annexm-doc-field-inline-label"><strong>Sample bank-verified deposit slip (attachment):</strong></span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill"></span>
                </div>

                @* GCash digit boxes left blank for Palawan too — same field as
                   "Active Mobile Number for PALAWAN PAWNSHOP" below. *@
                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label"><strong>GCASH ACCOUNT NUMBER:</strong></span>
                    <div class="annexm-doc-digit-boxes">
                        @for (int i = 0; i < 11; i++)
                        {
                            <span class="annexm-doc-digit-box">@(BankAccount?.PreferredChannel == 4 ? ' ' : GCashDigitAt(i))</span>
                            if (i == 3 || i == 6)
                            {
                                <span class="annexm-doc-digit-dash">&ndash;</span>
                            }
                        }
                    </div>
                </div>
                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">Screenshot of GCash Profile Information <strong>(attachment):</strong></span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill"></span>
                </div>

                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">Active Mobile Number for <strong>PALAWAN PAWNSHOP:</strong></span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill">@(PalawanMobileNumber ?? "")</span>
                </div>
                <div class="annexm-doc-field-row">
                    <span class="annexm-doc-field-inline-label">Preferred branch:</span>
                    <span class="annexa-doc-underline-value annexm-doc-field-fill">@(PalawanBranch ?? "")</span>
                </div>
            </td>
        </tr>
        <tr>
            <td class="annexm-doc-assessment-cell">
                <div class="annexm-doc-subheader">ASSESSMENT</div>
                <div class="d-flex gap-4 mt-1 justify-content-center">
                    <span class="annexa-doc-checkbox"><span class="box annexa-doc-radio-box @(Beneficiary.IsReadyForEft == true ? "checked" : "")"></span><strong>Ready</strong>&nbsp;for EFT</span>
                    <span class="annexa-doc-checkbox"><span class="box annexa-doc-radio-box @(Beneficiary.IsReadyForEft == false ? "checked" : "")"></span><strong>Not Ready</strong>&nbsp;for EFT</span>
                </div>
            </td>
        </tr>
    </table>

    @* ══════════════════ D. CONDUCTED BY ══════════════════ *@
    <div class="annexa-doc-bar">D. CONDUCTED BY</div>
    <table class="annexa-doc-table annexm-doc-boxed-table">
        <tr>
            <td>
                <div class="annexa-doc-signoff-block">
                    <div class="annexa-doc-underline-value">@(Beneficiary.Validator ?? "") &nbsp;&nbsp; @Beneficiary.ValidationDate.ToString("MMMM dd, yyyy")</div>
                    <div class="text-muted fst-italic annexm-doc-signoff-caption">Signature over printed name of NCSC staff and Date</div>
                </div>
            </td>
        </tr>
    </table>

    <div class="annexa-doc-footer">
        <div class="annexa-doc-footer-brand">
            <img src="images/puso-para-sa-seniors.png" alt="Puso Para sa Seniors" class="annexa-doc-footer-logo-img" />
            <div class="annexa-doc-footer-contacts">
                <span><i class="bi bi-telephone-fill"></i> 0962-2743-622</span>
                <span><i class="bi bi-telephone-fill"></i> (02) 8567-5646</span>
                <span><i class="bi bi-envelope-fill"></i> contact@ncsc.gov.ph</span>
                <span><i class="bi bi-globe"></i> www.ncsc.gov.ph</span>
            </div>
        </div>
    </div>

  </div>
</div>

@code {
    [Parameter, EditorRequired] public BeneficiaryInformationDto Beneficiary { get; set; } = default!;
    [Inject] public IJSRuntime JS { get; set; } = default!;
    [Inject] public ToastService Toast { get; set; } = default!;

    private const string _ncscLogoSrc = "images/ncsc-seal.png";
    private readonly string _bagongLogoSrc = $"data:image/png;base64,{PayrollLogos.BagongBase64}";

    // Deceased grantees get paid out through the claimant's account instead of
    // their own — BeneficiaryClaimantBankAccountDto is a structurally
    // identical but SEPARATE type from BeneficiaryBankAccountDto (no shared
    // base/interface), so this maps whichever one applies into one shape
    // the rest of this component can read uniformly. Same approach as
    // LivenessCheckPrintDocument.razor.
    private sealed class AccountView
    {
        public int PreferredChannel { get; init; }
        public string? AccountNumber { get; init; }
        public string? MobileNumber { get; init; }
        public string? BankOrWalletName { get; init; }
        public string? BranchName { get; init; }
        public string? BankAddress { get; init; }
        public bool? IsJointAccount { get; init; }
        public string? SwiftCode { get; init; }
        public string? Iban { get; init; }
    }

    private AccountView? BankAccount
    {
        get
        {
            if (Beneficiary.IsDeceased)
            {
                var c = Beneficiary.ClaimantBankAccount;
                return c is null ? null : new AccountView
                {
                    PreferredChannel = c.PreferredChannel,
                    AccountNumber = c.AccountNumber,
                    MobileNumber = c.MobileNumber,
                    BankOrWalletName = c.BankOrWalletName,
                    BranchName = c.BranchName,
                    BankAddress = c.BankAddress,
                    IsJointAccount = c.IsJointAccount,
                    SwiftCode = c.SwiftCode,
                    Iban = c.Iban
                };
            }

            var b = Beneficiary.BankAccount;
            return b is null ? null : new AccountView
            {
                PreferredChannel = b.PreferredChannel,
                AccountNumber = b.AccountNumber,
                MobileNumber = b.MobileNumber,
                BankOrWalletName = b.BankOrWalletName,
                BranchName = b.BranchName,
                BankAddress = b.BankAddress,
                IsJointAccount = b.IsJointAccount,
                SwiftCode = b.SwiftCode,
                Iban = b.Iban
            };
        }
    }

    private string JointAccountDisplay => BankAccount?.IsJointAccount switch
    {
        true => "Yes",
        false => "No",
        null => ""
    };

    private string GCashDigits => OnlyDigits(BankAccount?.MobileNumber);
    private char GCashDigitAt(int index) =>
        index < GCashDigits.Length ? GCashDigits[index] : ' ';

    private string? PalawanMobileNumber => BankAccount?.PreferredChannel == 4 ? BankAccount.MobileNumber : null;
    private string? PalawanBranch => BankAccount?.PreferredChannel == 4 ? BankAccount.BranchName : null;

    private static string OnlyDigits(string? s) =>
        string.IsNullOrEmpty(s) ? string.Empty : new string(s.Where(char.IsDigit).ToArray());

    // ── Live print-formatting controls (Scale/Font/Margin) ──
    private int _scalePercent = 100;
    private int _fontPercent = 100;
    private int _marginMm = 0;

    private string RootStyle =>
        $"--am-scale:{(_scalePercent / 100.0).ToString(System.Globalization.CultureInfo.InvariantCulture)};" +
        $"--am-font-scale:{(_fontPercent / 100.0).ToString(System.Globalization.CultureInfo.InvariantCulture)};" +
        $"--am-margin:{_marginMm}mm;";

    private void ResetPrintSettings()
    {
        _scalePercent = 100;
        _fontPercent = 100;
        _marginMm = 0;
    }

    private const string ScaleStorageKey = "annexm-print-scale";
    private const string FontStorageKey = "annexm-print-font";
    private const string MarginStorageKey = "annexm-print-margin";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var savedScale = await JS.InvokeAsync<string?>("localStorage.getItem", ScaleStorageKey);
            var savedFont = await JS.InvokeAsync<string?>("localStorage.getItem", FontStorageKey);
            var savedMargin = await JS.InvokeAsync<string?>("localStorage.getItem", MarginStorageKey);

            var changed = false;
            if (int.TryParse(savedScale, out var scale)) { _scalePercent = scale; changed = true; }
            if (int.TryParse(savedFont, out var font)) { _fontPercent = font; changed = true; }
            if (int.TryParse(savedMargin, out var margin)) { _marginMm = margin; changed = true; }

            if (changed) StateHasChanged();
        }
        catch
        {
            // localStorage unavailable — keep the built-in defaults.
        }
    }

    private async Task SavePrintSettingsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ScaleStorageKey, _scalePercent.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", FontStorageKey, _fontPercent.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", MarginStorageKey, _marginMm.ToString());
            Toast.ShowSuccess("Print settings saved as your default for Annex M.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save print settings: {ex.Message}");
        }
    }

    private string FullName
    {
        get
        {
            var givenMiddleExt = string.Join(" ", new[]
            {
                Beneficiary.FirstName.ToUpperInvariant(),
                Beneficiary.MiddleName?.ToUpperInvariant(),
                Beneficiary.Extension?.ToUpperInvariant()
            }.Where(s => !string.IsNullOrWhiteSpace(s)));

            return $"{Beneficiary.LastName?.ToUpperInvariant()}, {givenMiddleExt}";
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("printAnnexMOnly");
}
