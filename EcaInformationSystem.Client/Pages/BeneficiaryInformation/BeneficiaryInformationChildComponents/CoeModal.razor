@* CoeModal.razor *@
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Client.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject ToastService Toast

<HxModal @ref="_modal" Size="ModalSize.Large">
    <HeaderTemplate>
        <div class="d-flex align-items-center gap-2">
            <div class="rounded-2 d-flex align-items-center justify-content-center"
                 style="width:32px;height:32px;background:#FCE8E6;">
                <i class="bi bi-file-earmark-pdf text-danger"></i>
            </div>
            <div>
                <h5 class="modal-title mb-0">Generate Certificate of Eligibility</h5>
                <small class="text-muted">Grouped by Municipality and Milestone Year</small>
            </div>
        </div>
    </HeaderTemplate>

    <BodyTemplate>
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(_activeTab == "settings" ? "active" : "")"
                        @onclick='() => _activeTab = "settings"'>
                    <i class="bi bi-gear me-1"></i>Settings
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == "preview" ? "active" : "")" @onclick="SwitchToPreview">
                    <i class="bi bi-eye me-1"></i>Preview
                </button>
            </li>
        </ul>

        @if (_activeTab == "settings")
        {
            <div class="row g-3">
                <div class="col-12">
                    <div class="card border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title fw-semibold mb-3">
                                <i class="bi bi-building me-1 text-secondary"></i>Office Information
                            </h6>
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Office Address</label>
                                    <input class="form-control form-control-sm" @bind="_settings.OfficeAddress" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Email</label>
                                    <input class="form-control form-control-sm" @bind="_settings.OfficeEmail" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Website</label>
                                    <input class="form-control form-control-sm" @bind="_settings.OfficeWebsite" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Cash Gift Amount</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">₱</span>
                                        <input type="number" class="form-control" @bind="_settings.CashGiftAmount" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title fw-semibold mb-3 small text-uppercase text-muted">
                                <span class="badge rounded-circle bg-primary me-1">1</span>
                                Prepared by
                            </h6>
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Name</label>
                                    <input class="form-control form-control-sm" @bind="_settings.PreparedByName" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Position</label>
                                    <input class="form-control form-control-sm" @bind="_settings.PreparedByPosition" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title fw-semibold mb-3 small text-uppercase text-muted">
                                <span class="badge rounded-circle bg-success me-1">2</span>
                                Approved by
                            </h6>
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Name</label>
                                    <input class="form-control form-control-sm" @bind="_settings.ApprovedByName" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Position</label>
                                    <input class="form-control form-control-sm" @bind="_settings.ApprovedByPosition" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_activeTab == "preview")
        {
            @if (_isLoadingPreview)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2 text-muted small">Building preview…</p>
                </div>
            }
            else if (_previewGroups is null || !_previewGroups.Any())
            {
                <div class="alert alert-warning mb-0">
                    No eligible records with a valid milestone year were found in the selection.
                </div>
            }
            else
            {
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-building me-1"></i>
                        <strong>@_previewGroups.Count</strong> municipality(ies)
                    </span>
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-people me-1"></i>
                        <strong>@_previewGroups.Sum(g => g.TotalRecords)</strong> total records
                    </span>
                </div>

                <div style="max-height:500px; overflow-y:auto;">
                    @foreach (var group in _previewGroups)
                    {
                        <div class="card mb-3">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <strong>@group.MunicipalityName, @group.ProvinceName</strong>
                                <span class="badge bg-secondary">@group.TotalRecords record(s)</span>
                            </div>
                            <div class="card-body p-2">
                                @foreach (var yearGroup in group.YearGroups)
                                {
                                    <div class="mb-2">
                                        <div class="fw-semibold small text-white bg-dark px-2 py-1">
                                            @yearGroup.MilestoneYear Eligible Grantees
                                            <span class="float-end">@yearGroup.Records.Count</span>
                                        </div>
                                        <table class="table table-sm table-bordered mb-0 small">
                                            <thead>
                                                <tr>
                                                    <th>No.</th>
                                                    <th>Last Name</th>
                                                    <th>First Name</th>
                                                    <th>Middle Name</th>
                                                    <th>Birthdate</th>
                                                    <th>Age</th>
                                                    <th>Barangay</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var rec in yearGroup.Records)
                                                {
                                                    <tr>
                                                        <td>@rec.RowNumber</td>
                                                        <td>@rec.LastName</td>
                                                        <td>@rec.FirstName</td>
                                                        <td>@rec.MiddleName</td>
                                                        <td>@rec.BirthDate.ToString("MM/dd/yyyy")</td>
                                                        <td>@rec.Age</td>
                                                        <td>@rec.BarangayName</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </BodyTemplate>

    <FooterTemplate>
        <div class="d-flex justify-content-between w-100">
            <HxButton Color="ThemeColor.Secondary" @onclick="() => _modal.HideAsync()">
                Cancel
            </HxButton>
            <div class="d-flex gap-2">
                @if (_activeTab == "settings")
                {
                    <HxButton Color="ThemeColor.Info" @onclick="SwitchToPreview">
                        <i class="bi bi-eye me-1"></i>Preview
                    </HxButton>
                }
                <HxButton Color="ThemeColor.Danger" @onclick="DownloadCoeAsync" Disabled="@_isDownloading">
                    @if (_isDownloading)
                    {
                        <span>Generating...</span>
                    }
                    else
                    {
                        <i class="bi bi-download me-1"></i><span>Download COE</span>
                    }
                </HxButton>
            </div>
        </div>
    </FooterTemplate>
</HxModal>

@code {
    private HxModal _modal = default!;
    private string _activeTab = "settings";
    private bool _isLoadingPreview;
    private bool _isDownloading;

    private CoeSettingsDto _settings = new();
    private List<CoePreviewGroupDto>? _previewGroups;

    public async Task ShowAsync(List<Guid> selectedIds)
    {
        _settings = new CoeSettingsDto { Ids = selectedIds.Distinct().ToList() };
        _activeTab = "settings";
        _previewGroups = null;
        await _modal.ShowAsync();
    }

    private async Task SwitchToPreview()
    {
        _activeTab = "preview";
        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        try
        {
            _isLoadingPreview = true;
            StateHasChanged();

            var response = await Http.PostAsJsonAsync("api/coe/preview", _settings);
            if (response.IsSuccessStatusCode)
            {
                _previewGroups = await response.Content.ReadFromJsonAsync<List<CoePreviewGroupDto>>();
            }
            else
            {
                Toast.ShowError(await response.Content.ReadAsStringAsync());
                _previewGroups = new();
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to build preview: {ex.Message}");
        }
        finally
        {
            _isLoadingPreview = false;
            StateHasChanged();
        }
    }

    private async Task DownloadCoeAsync()
    {
        if (_settings.Ids == null || !_settings.Ids.Any())
        {
            Toast.ShowError("No records selected.");
            return;
        }

        try
        {
            _isDownloading = true;
            StateHasChanged();

            var response = await Http.PostAsJsonAsync("api/coe/generate", _settings);

            if (!response.IsSuccessStatusCode)
            {
                var err = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"COE generation failed: {err}");
                return;
            }

            var fileStream = await response.Content.ReadAsStreamAsync();
            using var streamRef = new DotNetStreamReference(stream: fileStream, leaveOpen: false);

            var fileName = $"COE_{DateTime.Now:yyyy-MM-dd}.docx"; // was .pdf
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            await _modal.HideAsync();
            Toast.ShowSuccess("Certificate of Eligibility downloaded.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isDownloading = false;
            StateHasChanged();
        }
    }
}