@using System.IdentityModel.Tokens.Jwt
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.DTOs.Chat
@inject ChatStateService ChatState
@inject AuthService AuthService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http
@inject NavbarFlyoutCoordinator FlyoutCoordinator
@implements IDisposable


<div class="chat-widget-container @(Inline ? "chat-widget-container--inline" : "")" id="@_widgetContainerId">
    @* Always-visible attention marker for the inline panel (no toggle button
       to carry the usual unread badge) — a pulsing count badge in the corner,
       regardless of which internal view (room list / conversation / picker)
       is currently showing, so unread messages stay noticeable no matter
       where the user left the widget. Disappears the moment TotalUnreadCount
       hits zero. *@
    @if (Inline && ChatState.TotalUnreadCount > 0)
    {
        <div class="chat-inline-unread-count" title="@ChatState.TotalUnreadCount unread message(s)">
            @(ChatState.TotalUnreadCount > 99 ? "99+" : ChatState.TotalUnreadCount.ToString())
        </div>
    }
    @if (!Inline)
    {
        <button class="chat-toggle-btn @(ChatState.TotalUnreadCount > 0 && !ChatState.IsWidgetOpen ? "chat-toggle-btn--attention" : "")" @onclick="ToggleChatWidget">
            <i class="bi @(ChatState.IsWidgetOpen ? "bi-x-lg" : "bi-chat-dots-fill")"></i>
            <span class="chat-toggle-btn-label">@(ChatState.IsWidgetOpen ? "Close" : "Messages")</span>
            @if (!ChatState.IsWidgetOpen && ChatState.TotalUnreadCount > 0)
            {
                <span class="chat-unread-badge">@(ChatState.TotalUnreadCount > 99 ? "99+" : ChatState.TotalUnreadCount.ToString())</span>
            }
        </button>
    }

    @* Compact collapsed header — only shown/visible via CSS once the feed
       columns stack (narrow window / mobile), where the full-height inline
       panel would otherwise dump a wall of chat above the actual feed posts.
       On wide desktop layouts this stays hidden and the panel is always
       expanded, same as before. *@
    @if (Inline)
    {
        <button type="button" class="chat-inline-collapsed-bar" @onclick="() => _inlineExpanded = !_inlineExpanded">
            <i class="bi bi-chat-dots-fill"></i>
            <strong class="flex-grow-1">Messages</strong>
            <i class="bi @(_inlineExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
        </button>
    }

    @* Inline mode (Feed left sidebar) always shows the panel — no toggle to
       open/close it, same as the birthday/sticky-notes cards beside it. The
       floating navbar instance keeps its own independent open/close state. *@
    @if (Inline || ChatState.IsWidgetOpen)
    {
        <div class="chat-widget-panel @(Inline ? "chat-widget-panel--inline" : "") @(Inline && !_inlineExpanded ? "chat-widget-panel--inline-collapsed" : "")">
            @if (_showUserPicker)
            {
                @* ── VIEW 1: New conversation user picker ────────────────── *@
                <div class="chat-panel-header">
                    <button class="btn-back" @onclick="CloseUserPicker">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <strong class="flex-grow-1">New Conversation</strong>
                </div>

                <input class="chat-user-search" placeholder="Search people..."
                       @oninput="OnUserSearchInput" autofocus />

                <div class="chat-user-picker-list">
                    @if (_isLoadingUsers)
                    {
                        <div class="text-center text-muted small py-4">
                            <span class="spinner-border spinner-border-sm me-1"></span> Loading people...
                        </div>
                    }
                    else
                    {
                        @foreach (var user in _filteredUsers)
                        {
                            <div class="chat-user-picker-item" @onclick="() => StartChatWith(user.UserId)">
                                <span class="chat-presence-dot @(ChatState.IsUserOnline(user.UserId) ? "online" : "offline")"></span>
                                <i class="bi bi-person-circle me-2"></i>
                                <span class="flex-grow-1 text-truncate">@user.DisplayName</span>
                                <small class="text-muted">@user.Role</small>
                            </div>
                        }
                        @if (!_filteredUsers.Any())
                        {
                            <div class="text-center text-muted small py-4">No users found.</div>
                        }
                    }
                </div>
            }
            else if (_showMentionsList)
            {
                @* ── VIEW 2: Mentions jump list ───────────────────────────── *@
                <div class="chat-panel-header">
                    <button class="btn-back" @onclick="() => _showMentionsList = false">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <strong class="flex-grow-1">Mentions</strong>
                </div>
                <div class="chat-room-list">
                    @if (_isLoadingMentions)
                    {
                        <div class="text-center text-muted small py-4">
                            <span class="spinner-border spinner-border-sm me-1"></span> Loading...
                        </div>
                    }
                    else if (!_mentionJumpList.Any())
                    {
                        <div class="text-center text-muted small py-4">No mentions yet.</div>
                    }
                    else
                    {
                        @foreach (var mention in _mentionJumpList)
                        {
                            <div class="chat-room-item" @onclick="() => JumpToMention(mention)">
                                <div class="chat-room-icon room-icon-direct">
                                    <i class="bi bi-at"></i>
                                </div>
                                <div class="chat-room-info">
                                    <div class="chat-room-name">@mention.RoomDisplayName</div>
                                    <div class="chat-room-preview text-truncate">@mention.MessagePreview</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else if (ChatState.ActiveRoom == null)
            {
                @* ── VIEW 3: Room list ────────────────────────────────────── *@
                <div class="chat-panel-header">
                    <strong class="flex-grow-1">Messages</strong>
                    <button class="btn-new-chat btn-mentions" title="Jump to mentions" @onclick="OpenMentionsList">
                        <i class="bi bi-at"></i>
                        @if (ChatState.UnreadMentionCount > 0)
                        {
                            <span class="btn-icon-badge">@(ChatState.UnreadMentionCount > 99 ? "99+" : ChatState.UnreadMentionCount.ToString())</span>
                        }
                    </button>
                    <button class="btn-new-chat btn-compose" title="Compose new message" @onclick="OpenUserPicker">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div class="chat-room-list">
                    @if (!ChatState.Rooms.Any())
                    {
                        <div class="text-center text-muted small py-4">
                            <span class="spinner-border spinner-border-sm me-1"></span> Loading conversations...
                        </div>
                    }
                    @foreach (var room in ChatState.Rooms)
                    {
                        <div class="chat-room-item" @onclick="() => SelectRoomAsync(room)">
                            @if (room.Type == "Direct" && room.OtherUserId.HasValue)
                            {
                                <div class="chat-room-icon chat-room-icon--avatar avatar-preview-trigger">
                                    <img src="@AvatarUrl(room.OtherUserId.Value)" alt="" class="chat-room-avatar-img"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                    <span class="chat-room-avatar-fallback" style="display:none;">@GetInitials(room.DisplayName)</span>
                                    @if (ChatState.IsUserOnline(room.OtherUserId.Value))
                                    {
                                        <span class="chat-presence-dot-badge online"></span>
                                    }
                                    <img src="@AvatarUrl(room.OtherUserId.Value)" alt="" class="avatar-preview-popup"
                                         onerror="this.style.display='none';" />
                                </div>
                            }
                            else
                            {
                                <div class="chat-room-icon @GetRoomIconClass(room.Type)">
                                    <i class="bi @GetRoomIcon(room.Type)"></i>
                                </div>
                            }
                            <div class="chat-room-info">
                                <div class="chat-room-name">@room.DisplayName</div>
                                @if (!string.IsNullOrWhiteSpace(room.LastMessagePreview))
                                {
                                    <div class="chat-room-preview text-truncate">@room.LastMessagePreview</div>
                                }
                            </div>
                            @if (room.UnreadCount > 0)
                            {
                                <span class="chat-room-unread">@room.UnreadCount</span>
                            }
                            @* ✅ NEW — delete only for Direct rooms, stops the click from also opening the room *@
                            @if (room.Type == "Direct")
                            {
                                <button class="chat-room-delete-btn" title="Delete conversation"
                                        @onclick="() => OpenDeleteConfirmModal(room.Id)" @onclick:stopPropagation="true">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @* ── VIEW 4: Active conversation ──────────────────────────── *@
                <div class="chat-panel-header">
                    <button class="btn-back" @onclick="ChatState.ReturnToRoomList">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    @if (ChatState.ActiveRoom.Type == "Direct" && ChatState.ActiveRoom.OtherUserId.HasValue)
                    {
                        <a href="@($"/profile/{ChatState.ActiveRoom.OtherUserId.Value}")" class="chat-header-avatar-link avatar-preview-trigger" title="View profile">
                            <img src="@AvatarUrl(ChatState.ActiveRoom.OtherUserId.Value)" alt="" class="chat-header-avatar avatar-img"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <span class="chat-header-avatar chat-header-avatar-fallback" style="display:none;">@GetInitials(ChatState.ActiveRoom.DisplayName)</span>
                            <img src="@AvatarUrl(ChatState.ActiveRoom.OtherUserId.Value)" alt="" class="avatar-preview-popup"
                                 onerror="this.style.display='none';" />
                        </a>
                    }
                    <div class="flex-grow-1 overflow-hidden">
                        @if (ChatState.ActiveRoom.Type == "Direct" && ChatState.ActiveRoom.OtherUserId.HasValue)
                        {
                            <a href="@($"/profile/{ChatState.ActiveRoom.OtherUserId.Value}")" class="chat-sender-link" title="View profile">
                                <strong class="text-truncate d-block">@ChatState.ActiveRoom.DisplayName</strong>
                            </a>
                        }
                        else
                        {
                            <strong class="text-truncate d-block">@ChatState.ActiveRoom.DisplayName</strong>
                        }
                        @if (ChatState.ActiveRoom.Type == "Direct" && ChatState.ActiveRoom.OtherUserId.HasValue)
                        {
                            <small class="chat-header-presence">
                                @if (ChatState.IsUserOnline(ChatState.ActiveRoom.OtherUserId.Value))
                                {
                                    <span class="chat-presence-dot online"></span> <text>Online</text>
                                }
                                else if (_activeRoomLastSeen.HasValue)
                                {
                                    <span class="chat-presence-dot offline"></span> <text>Last seen @FormatLastSeen(_activeRoomLastSeen.Value)</text>
                                }
                                else
                                {
                                    <span class="chat-presence-dot offline"></span> <text>Offline</text>
                                }
                            </small>
                        }
                    </div>
                </div>

                <ChatMessageList CurrentUserId="@_currentUserId" />
                <ChatComposer />
            }
        </div>
    }
</div>
<HxModal @ref="_deleteConfirmModal">
    <HeaderTemplate>
        <h5 class="modal-title text-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Conversation
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-0">
            This will remove the conversation from your list. This cannot be undone.
        </p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="CancelDeleteConfirm">
            Cancel
        </HxButton>
        <HxButton Color="ThemeColor.Danger" @onclick="ConfirmDeleteConversation" Disabled="@_isDeletingConversation">
            @if (_isDeletingConversation)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <span>Yes, Delete</span>
        </HxButton>
    </FooterTemplate>
</HxModal>
@code {
    // True on the Feed page's left-column instance — renders as an always-
    // visible panel (no floating toggle button) instead of the navbar's
    // click-to-open dropdown. Both instances share the same ChatState
    // (active room, unread counts), so selecting a conversation in one
    // reflects in the other.
    [Parameter] public bool Inline { get; set; }

    // Collapsed by default — only matters once the feed layout stacks into a
    // single column (narrow window/mobile); CSS keeps the panel always
    // expanded on wide desktop layouts regardless of this flag.
    private bool _inlineExpanded;

    private DateTime? _activeRoomLastSeen;
    private Guid _currentUserId;

    private bool _showUserPicker;
    private bool _isLoadingUsers;
    private List<ChatUserSummaryDto> _allUsers = new();
    private List<ChatUserSummaryDto> _filteredUsers = new();

    private bool _showMentionsList;
    private bool _isLoadingMentions;
    private List<ChatMentionJumpDto> _mentionJumpList = new();
    private readonly string _widgetContainerId = $"chat-widget-{Guid.NewGuid():N}";
    private DotNetObjectReference<ChatWidget>? _dotNetRef;
    private bool _wasOpen;
    private HxModal _deleteConfirmModal = default!;
    private Guid _pendingDeleteRoomId;
    private bool _isDeletingConversation;

    // ✅ NEW — wraps ChatState.ToggleWidget so opening this panel also tells
    // other navbar flyouts (Sticky Notes) to close, preventing both panels
    // from visually stacking on top of each other in the same corner.
    private void ToggleChatWidget()
    {
        ChatState.ToggleWidget();
        if (ChatState.IsWidgetOpen) FlyoutCoordinator.NotifyOpened("chat");
    }

    private void HandleOtherPanelOpened(string panelId)
    {
        if (panelId == "chat" || !ChatState.IsWidgetOpen) return;
        ChatState.CloseWidget();
    }

    protected override async Task OnInitializedAsync()
    {
        ChatState.OnChange += HandleChatStateChanged;
        FlyoutCoordinator.OnOpened += HandleOtherPanelOpened;
        _dotNetRef = DotNetObjectReference.Create(this);
        var token = await AuthService.GetTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            var handler = new JwtSecurityTokenHandler();
            if (handler.CanReadToken(token))
            {
                var jwt = handler.ReadJwtToken(token);
                var sub = jwt.Claims.FirstOrDefault(c => c.Type == JwtRegisteredClaimNames.Sub)?.Value;
                if (sub != null)
                {
                    _currentUserId = Guid.Parse(sub);
                    ChatState.CurrentUserId = _currentUserId;
                }
            }
        }

        await ChatState.LoadRoomsAsync();
        await ChatState.LoadOnlineUsersAsync();
        await ChatState.RefreshUnreadMentionCountAsync();
    }
    private async Task OpenDeleteConfirmModal(Guid roomId)
    {
        _pendingDeleteRoomId = roomId;
        await _deleteConfirmModal.ShowAsync();
    }

    private async Task CancelDeleteConfirm()
    {
        await _deleteConfirmModal.HideAsync();
    }

    private async Task ConfirmDeleteConversation()
    {
        try
        {
            _isDeletingConversation = true;
            StateHasChanged();

            await ChatState.DeleteConversationAsync(_pendingDeleteRoomId);
            await _deleteConfirmModal.HideAsync();
        }
        finally
        {
            _isDeletingConversation = false;
            StateHasChanged();
        }
    }
    private static string FormatLastSeen(DateTime lastSeenUtc)
    {
        var span = DateTime.UtcNow - lastSeenUtc;

        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} minute(s) ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hour(s) ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} day(s) ago";
        return lastSeenUtc.ToLocalTime().ToString("MMM dd, yyyy");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // ✅ NEW — register/unregister the outside-click listener whenever
        // the widget's open state actually changes (not on every re-render).
        if (ChatState.IsWidgetOpen && !_wasOpen)
        {
            await JS.InvokeVoidAsync("chatInterop.registerOutsideClick", _widgetContainerId, _dotNetRef);
        }
        else if (!ChatState.IsWidgetOpen && _wasOpen)
        {
            await JS.InvokeVoidAsync("chatInterop.unregisterOutsideClick", _widgetContainerId);
        }

        _wasOpen = ChatState.IsWidgetOpen;
    }
    [JSInvokable]
    public void OnClickOutside()
    {
        if (ChatState.IsWidgetOpen)
        {
            ChatState.CloseWidget(); // already exists in ChatStateService
        }
    }


    private void HandleChatStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SelectRoomAsync(ChatRoomDto room)
    {
        try
        {
            await ChatState.SelectRoomAsync(room);

            // ✅ NEW — fetch last-seen info for the header, only relevant for DMs
            if (room.Type == "Direct" && room.OtherUserId.HasValue)
            {
                var presence = await ChatState.GetUserPresenceAsync(room.OtherUserId.Value);
                _activeRoomLastSeen = presence?.LastSeenAt;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CHAT DEBUG] SelectRoomAsync failed: {ex}");
        }
    }

    // ── Mentions ─────────────────────────────────────────────────────────

    private async Task OpenMentionsList()
    {
        _showMentionsList = true;
        _isLoadingMentions = true;
        StateHasChanged();

        _mentionJumpList = await ChatState.GetMyMentionJumpListAsync();
        _isLoadingMentions = false;
        StateHasChanged();
    }

    private async Task JumpToMention(ChatMentionJumpDto mention)
    {
        _showMentionsList = false;
        await ChatState.JumpToMentionAsync(mention.RoomId, mention.MessageId);
    }

    // ── New conversation picker ──────────────────────────────────────────

    private async Task OpenUserPicker()
    {
        _showUserPicker = true;
        _isLoadingUsers = true;
        StateHasChanged();

        _allUsers = await ChatState.GetUsersForNewConversationAsync();
        _filteredUsers = _allUsers;

        await ChatState.LoadOnlineUsersAsync(); // ✅ NEW — refresh presence snapshot right before showing the picker

        _isLoadingUsers = false;
        StateHasChanged();
    }

    private void CloseUserPicker()
    {
        _showUserPicker = false;
    }

    private void OnUserSearchInput(ChangeEventArgs e)
    {
        var term = e.Value?.ToString() ?? string.Empty;
        _filteredUsers = string.IsNullOrWhiteSpace(term)
            ? _allUsers
            : _allUsers.Where(u => u.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task StartChatWith(Guid userId)
    {
        _showUserPicker = false;
        try
        {
            await ChatState.StartAndOpenDirectConversationAsync(userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CHAT DEBUG] StartChatWith failed: {ex}");
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    // Absolute URL — see Profile.razor's AvatarUrl for why a relative <img src>
    // 404s (API is on a different origin than the client).
    private string AvatarUrl(Guid userId) => $"{Http.BaseAddress}api/UserProfile/{userId}/avatar/thumb";

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private static string GetRoomIcon(string type) => type switch
    {
        "Global" => "bi-globe",
        "Regional" => "bi-geo-alt-fill",
        "Direct" => "bi-person-fill",
        _ => "bi-chat-fill"
    };

    private static string GetRoomIconClass(string type) => type switch
    {
        "Global" => "room-icon-global",
        "Regional" => "room-icon-regional",
        "Direct" => "room-icon-direct",
        _ => ""
    };

    public void Dispose()
    {
        ChatState.OnChange -= HandleChatStateChanged;
        FlyoutCoordinator.OnOpened -= HandleOtherPanelOpened;
        _dotNetRef?.Dispose();
        _ = JS.InvokeVoidAsync("chatInterop.unregisterOutsideClick", _widgetContainerId);
    }
}