@using System.IdentityModel.Tokens.Jwt
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.DTOs.Chat
@inject ChatStateService ChatState
@inject AuthService AuthService
@implements IDisposable

<div class="chat-widget-container">
    <button class="chat-toggle-btn" @onclick="ChatState.ToggleWidget">
        <i class="bi @(ChatState.IsWidgetOpen ? "bi-x-lg" : "bi-chat-dots-fill")"></i>
        @if (!ChatState.IsWidgetOpen && ChatState.TotalUnreadCount > 0)
        {
            <span class="chat-unread-badge">@(ChatState.TotalUnreadCount > 99 ? "99+" : ChatState.TotalUnreadCount.ToString())</span>
        }
    </button>

    @if (ChatState.IsWidgetOpen)
    {
        <div class="chat-widget-panel">
            @if (_showUserPicker)
            {
                @* ── New conversation: user picker ─────────────────────── *@
                <div class="chat-panel-header">
                    <button class="btn-back" @onclick="CloseUserPicker">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <strong class="flex-grow-1">New Conversation</strong>
                </div>

                <input class="chat-user-search" placeholder="Search people..."
                       @oninput="OnUserSearchInput" autofocus />

                <div class="chat-user-picker-list">
                    @if (_isLoadingUsers)
                    {
                        <div class="text-center text-muted small py-4">
                            <span class="spinner-border spinner-border-sm me-1"></span> Loading people...
                        </div>
                    }
                    else
                    {
                        @foreach (var user in _filteredUsers)
                        {
                            <div class="chat-user-picker-item" @onclick="() => StartChatWith(user.UserId)">
                                <i class="bi bi-person-circle me-2"></i>
                                <span class="flex-grow-1 text-truncate">@user.DisplayName</span>
                                <small class="text-muted">@user.Role</small>
                            </div>
                        }
                        @if (!_filteredUsers.Any())
                        {
                            <div class="text-center text-muted small py-4">No users found.</div>
                        }
                    }
                </div>
            }
            else if (ChatState.ActiveRoom == null)
            {
                @* ── Room list view ─────────────────────────────────────── *@
                <div class="chat-panel-header">
                    <strong class="flex-grow-1">Messages</strong>
                    <button class="btn-new-chat" title="Start a new conversation" @onclick="OpenUserPicker">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div class="chat-room-list">
                    @if (!ChatState.Rooms.Any())
                    {
                        <div class="text-center text-muted small py-4">
                            <span class="spinner-border spinner-border-sm me-1"></span> Loading conversations...
                        </div>
                    }
                    @foreach (var room in ChatState.Rooms)
                    {
                        <div class="chat-room-item" @onclick="() => SelectRoomAsync(room)">
                            <div class="chat-room-icon @GetRoomIconClass(room.Type)">
                                <i class="bi @GetRoomIcon(room.Type)"></i>
                            </div>
                            <div class="chat-room-info">
                                <div class="chat-room-name">@room.DisplayName</div>
                                @if (!string.IsNullOrWhiteSpace(room.LastMessagePreview))
                                {
                                    <div class="chat-room-preview text-truncate">@room.LastMessagePreview</div>
                                }
                            </div>
                            @if (room.UnreadCount > 0)
                            {
                                <span class="chat-room-unread">@room.UnreadCount</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @* ── Active room / conversation view ─────────────────────── *@
                <div class="chat-panel-header">
                    <button class="btn-back" @onclick="ChatState.ReturnToRoomList">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <strong class="flex-grow-1 text-truncate">@ChatState.ActiveRoom.DisplayName</strong>
                </div>

                <ChatMessageList CurrentUserId="@_currentUserId" />
                <ChatComposer />
            }
        </div>
    }
</div>

@code {
    private Guid _currentUserId;

    private bool _showUserPicker;
    private bool _isLoadingUsers;
    private List<ChatUserSummaryDto> _allUsers = new();
    private List<ChatUserSummaryDto> _filteredUsers = new();

    protected override async Task OnInitializedAsync()
    {
        ChatState.OnChange += HandleChatStateChanged;

        var token = await AuthService.GetTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            var handler = new JwtSecurityTokenHandler();
            if (handler.CanReadToken(token))
            {
                var jwt = handler.ReadJwtToken(token);
                var sub = jwt.Claims.FirstOrDefault(c => c.Type == JwtRegisteredClaimNames.Sub)?.Value;
                if (sub != null)
                {
                    _currentUserId = Guid.Parse(sub);
                    ChatState.CurrentUserId = _currentUserId;
                }
            }
        }

        await ChatState.LoadRoomsAsync();
    }

    private void HandleChatStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SelectRoomAsync(ChatRoomDto room)
    {
        try
        {
            await ChatState.SelectRoomAsync(room);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CHAT DEBUG] SelectRoomAsync failed: {ex}");
        }
    }

    // ── New conversation picker ──────────────────────────────────────────

    private async Task OpenUserPicker()
    {
        _showUserPicker = true;
        _isLoadingUsers = true;
        StateHasChanged();

        _allUsers = await ChatState.GetUsersForNewConversationAsync();
        _filteredUsers = _allUsers;
        _isLoadingUsers = false;
        StateHasChanged();
    }

    private void CloseUserPicker()
    {
        _showUserPicker = false;
    }

    private void OnUserSearchInput(ChangeEventArgs e)
    {
        var term = e.Value?.ToString() ?? string.Empty;
        _filteredUsers = string.IsNullOrWhiteSpace(term)
            ? _allUsers
            : _allUsers.Where(u => u.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task StartChatWith(Guid userId)
    {
        _showUserPicker = false;
        try
        {
            await ChatState.StartAndOpenDirectConversationAsync(userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CHAT DEBUG] StartChatWith failed: {ex}");
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    private static string GetRoomIcon(string type) => type switch
    {
        "Global" => "bi-globe",
        "Regional" => "bi-geo-alt-fill",
        "Direct" => "bi-person-fill",
        _ => "bi-chat-fill"
    };

    private static string GetRoomIconClass(string type) => type switch
    {
        "Global" => "room-icon-global",
        "Regional" => "room-icon-regional",
        "Direct" => "room-icon-direct",
        _ => ""
    };

    public void Dispose()
    {
        ChatState.OnChange -= HandleChatStateChanged;
    }
}