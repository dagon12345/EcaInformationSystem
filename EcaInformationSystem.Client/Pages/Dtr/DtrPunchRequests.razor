@* Client/Pages/Dtr/DtrPunchRequests.razor — Admin/Finance/SuperAdmin: review
   and approve/reject self-service DTR punch-edit requests filed by everyone
   else (see DtrController.AddManualPunch/RemoveManualPunch — a non-approver's
   Add/Remove is filed here instead of writing straight to AttendanceLog).
   Reached from UnifiedNotificationBell's "DTR Request" feed items. *@
@page "/dtr-punch-requests"
@attribute [Authorize]
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs.Dtr
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject ToastService Toast
@inject AuthService AuthService
@inject DtrPunchRequestClientService DtrRequests

<PageTitle>DTR Time Entry Requests</PageTitle>

@if (!_isAuthorized)
{
    <div class="container-fluid py-3">
        <div class="alert alert-danger">You are not authorized to view this page.</div>
    </div>
}
else
{
    <div class="container-fluid py-3">
        <div class="page-header-bar mb-3">
            <div class="page-header-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <h5 class="page-header-title">DTR Time Entry Requests</h5>
                <span class="page-header-sub">Approve or reject self-service punch edits before they're written to the DTR</span>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="text-muted">Loading…</div>
        }
        else if (!_requests.Any())
        {
            <div class="alert alert-secondary">
                <i class="bi bi-check-circle me-1"></i>No pending requests.
            </div>
        }
        else
        {
            @foreach (var group in _groups)
            {
                var isExpanded = _expandedUserId == group.UserId;
                <div class="sys-card mb-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-2 px-3 @(isExpanded ? "border-bottom" : "")"
                         role="button" style="cursor:pointer;" @onclick="() => ToggleExpanded(group)">
                        <div>
                            <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right") me-2 text-muted"></i>
                            <strong>@group.EmployeeName</strong>
                            <span class="text-muted small ms-2">@group.Requests.Count pending correction@(group.Requests.Count == 1 ? "" : "s")</span>
                        </div>
                        <div @onclick:stopPropagation="true">
                            <button class="btn btn-sm btn-success me-1" disabled="@_isGroupBusy(group)"
                                    @onclick="() => ApproveGroupAsync(group)">
                                <i class="bi bi-check-lg"></i> Approve All
                            </button>
                            <button class="btn btn-sm btn-danger" disabled="@_isGroupBusy(group)"
                                    @onclick="() => RejectGroupAsync(group)">
                                <i class="bi bi-x-lg"></i> Reject All
                            </button>
                        </div>
                    </div>
                    @if (isExpanded)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Requested By</th>
                                        <th>Requested At</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in group.Requests)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @(r.RequestType == "Add" ? "bg-success" : "bg-danger")">@r.RequestType</span>
                                            </td>
                                            <td>@r.PunchDate.ToString("MMM d, yyyy")</td>
                                            <td>
                                                @if (r.RequestType == "Add")
                                                {
                                                    <span>@r.RequestedPunchTime</span>
                                                }
                                                else
                                                {
                                                    <span>Remove @r.CurrentPunchTime</span>
                                                }
                                            </td>
                                            <td>@r.RequestedByName</td>
                                            <td>@r.RequestedAt.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        }
    </div>
}

@code {
    // One employee's worth of pending requests, grouped client-side so the
    // admin reviews and clears everything for one person together instead
    // of one unrelated row at a time (requests have no server-side batch
    // link — see DtrPunchEditRequest — so grouping is purely presentational,
    // keyed on UserId).
    private class RequestGroup
    {
        public Guid UserId { get; set; }
        public string EmployeeName { get; set; } = string.Empty;
        public List<DtrPunchRequestDto> Requests { get; set; } = new();
    }

    private bool _isAuthorized;
    private bool _isLoading = true;
    private List<DtrPunchRequestDto> _requests = new();
    private List<RequestGroup> _groups = new();
    private Guid? _processingGroupUserId;
    private Guid? _expandedUserId;

    private bool _isGroupBusy(RequestGroup group) => _processingGroupUserId.HasValue;

    private void ToggleExpanded(RequestGroup group) =>
        _expandedUserId = _expandedUserId == group.UserId ? null : group.UserId;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitAsync();
        _isAuthorized = AuthService.IsAdmin() || AuthService.IsFinance();
        if (!_isAuthorized)
        {
            _isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            _requests = await Http.GetFromJsonAsync<List<DtrPunchRequestDto>>("api/dtr/punch-requests/pending") ?? new();
            _groups = _requests
                .GroupBy(r => r.UserId)
                .Select(g => new RequestGroup
                {
                    UserId = g.Key,
                    EmployeeName = g.First().EmployeeName,
                    Requests = g.OrderByDescending(r => r.RequestedAt).ToList()
                })
                .OrderBy(g => g.EmployeeName)
                .ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load pending requests: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApproveGroupAsync(RequestGroup group)
    {
        _processingGroupUserId = group.UserId;
        StateHasChanged();
        try
        {
            var ids = group.Requests.Select(r => r.Id).ToList();
            var response = await Http.PostAsJsonAsync("api/dtr/punch-requests/approve-batch",
                new BulkReviewDtrPunchRequestDto { Ids = ids });
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess($"Approved {ids.Count} request(s) for {group.EmployeeName}.");
                await RefreshAllAsync();
            }
            else
            {
                Toast.ShowError("Failed to approve the requests.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to approve the requests: {ex.Message}");
        }
        finally
        {
            _processingGroupUserId = null;
        }
    }

    private async Task RejectGroupAsync(RequestGroup group)
    {
        _processingGroupUserId = group.UserId;
        StateHasChanged();
        try
        {
            var ids = group.Requests.Select(r => r.Id).ToList();
            var response = await Http.PostAsJsonAsync("api/dtr/punch-requests/reject-batch",
                new BulkReviewDtrPunchRequestDto { Ids = ids });
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess($"Rejected {ids.Count} request(s) for {group.EmployeeName}.");
                await RefreshAllAsync();
            }
            else
            {
                Toast.ShowError("Failed to reject the requests.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to reject the requests: {ex.Message}");
        }
        finally
        {
            _processingGroupUserId = null;
        }
    }

    // Refreshes this page's own list AND the bell's shared PendingItems, so
    // the badge count drops immediately instead of waiting for the next
    // SignalR push or page reload.
    private async Task RefreshAllAsync()
    {
        await LoadAsync();
        await DtrRequests.RefreshAsync();
    }
}
