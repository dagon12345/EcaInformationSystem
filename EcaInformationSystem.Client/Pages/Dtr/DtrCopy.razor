@* DtrCopy.razor — one copy of Civil Service Form No. 48 (Daily Time
   Record). DtrPrintDocument.razor renders this twice side by side inside
   .dtr-print-page, matching the paper form's printed-in-duplicate layout.
   WfhDays/HolidayDays (and their toggle callbacks) are owned by the parent
   so both copies always show the same marks — punches alone can't tell WFH
   or Holiday apart from a regular day, so these are manual, display-only
   overrides. *@
@using EcaInformationSystem.Shared.DTOs.Dtr

<div class="dtr-doc">
    <table class="dtr-doc-formno-table">
        <tr>
            <td class="dtr-doc-formno-label">Civil Service Form No. 48</td>
            <td></td>
        </tr>
    </table>

    <div class="dtr-doc-title">DAILY TIME RECORD</div>
    <div class="dtr-doc-title-sub">-----o0o-----</div>

    <div class="dtr-doc-name">@Document.EmployeeName.ToUpperInvariant()</div>
    <div class="dtr-doc-name-caption">(Name)</div>

    <table class="dtr-doc-meta-table">
        <tr>
            <td class="dtr-doc-meta-label" style="width:45%;">For the month</td>
            <td class="dtr-doc-meta-value-inline">@Document.ForTheMonthLabel</td>
        </tr>
        <tr>
            <td class="dtr-doc-meta-label" rowspan="2">Official hours for arrival and departure</td>
            <td class="dtr-doc-meta-value-inline">
                <span class="dtr-doc-meta-sublabel">Regular days</span>
                <span class="dtr-doc-meta-underline">@Document.RegularDaysHours</span>
            </td>
        </tr>
        <tr>
            <td class="dtr-doc-meta-value-inline">
                <span class="dtr-doc-meta-sublabel">Saturdays</span>
                <span class="dtr-doc-meta-underline">@Document.SaturdaysHours</span>
            </td>
        </tr>
    </table>

    <table class="dtr-doc-table">
        <thead>
            <tr>
                <th rowspan="2">Day</th>
                <th colspan="2">A.M.</th>
                <th colspan="2">P.M.</th>
                <th colspan="2">Undertime</th>
            </tr>
            <tr>
                <th>Time in</th>
                <th>Time out</th>
                <th>Time in</th>
                <th>Time out</th>
                <th>Hrs</th>
                <th>Min</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Document.Days.Count; i++)
            {
                var day = Document.Days[i];
                var isWfh = WfhDays.Contains(day.Day);
                var isHoliday = HolidayDays.Contains(day.Day);

                // Saturday/Sunday are editable the same as any weekday now —
                // this just decides whether to show that day's actual grid
                // (once it has a punch, from the device or added manually) or
                // fall back to the plain "SATURDAY"/"SUNDAY" label, which is
                // what an untouched weekend still shows by default.
                var weekendHasPunch = !string.IsNullOrWhiteSpace(day.AmTimeIn) || !string.IsNullOrWhiteSpace(day.AmTimeOut)
                    || !string.IsNullOrWhiteSpace(day.PmTimeIn) || !string.IsNullOrWhiteSpace(day.PmTimeOut);

                // A saved per-column note (e.g. "Wtf" spanning PmIn..PmOut)
                // has no punch time and isn't a whole-day NoteDays entry
                // either — without this check it would still be masked by
                // the plain weekend label below after a reload.
                var weekendHasSlotNote = SlotNotes.Keys.Any(k => k.Day == day.Day);

                @if (!day.IsInPeriod)
                {
                    @if (i > 0 && !Document.Days[i - 1].IsInPeriod)
                    {
                        // Continuation of an out-of-period run — the diagonal cell
                        // from the run's first row already spans down over this one.
                        <tr class="dtr-doc-outofperiod">
                            <td class="dtr-doc-day">@day.Day</td>
                        </tr>
                    }
                    else
                    {
                        var runLength = 1;
                        while (i + runLength < Document.Days.Count && !Document.Days[i + runLength].IsInPeriod)
                            runLength++;

                        <tr class="dtr-doc-outofperiod">
                            <td class="dtr-doc-day">@day.Day</td>
                            <td colspan="6" rowspan="@runLength" class="dtr-doc-outofperiod-diagonal"
                                style="--dtr-run-length:@runLength;"></td>
                        </tr>
                    }
                }
                else if ((day.DayType == DtrDayType.Saturday || day.DayType == DtrDayType.Sunday)
                         && !weekendHasPunch && !weekendHasSlotNote && !ExpandedWeekendDays.Contains(day.Day)
                         && !isHoliday && !isWfh && !NoteDays.ContainsKey(day.Day))
                {
                    <tr class="dtr-doc-weekend">
                        <td class="dtr-doc-day">@day.Day</td>
                        <td colspan="6">
                            @(day.DayType == DtrDayType.Saturday ? "SATURDAY" : "SUNDAY")
                            @if (AllowManualPunchEdit)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-2 no-print"
                                        title="This day was covered by office activity — add a time record"
                                        @onclick="() => OnExpandWeekend.InvokeAsync(day.Day)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
                else if (isHoliday)
                {
                    <tr class="dtr-doc-holiday">
                        <td class="dtr-doc-day">@day.Day</td>
                        <td colspan="6">
                            HOLIDAY
                            @if (OnToggleHoliday.HasDelegate)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-2 no-print" @onclick="() => OnToggleHoliday.InvokeAsync(day.Day)">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
                else if (isWfh)
                {
                    <tr class="dtr-doc-wfh">
                        <td class="dtr-doc-day">@day.Day</td>
                        <td colspan="6">
                            WORK FROM HOME
                            @if (OnToggleWfh.HasDelegate)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-2 no-print" @onclick="() => OnToggleWfh.InvokeAsync(day.Day)">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
                else if (NoteDays.ContainsKey(day.Day))
                {
                    var note = NoteDays[day.Day];

                    <tr class="dtr-doc-note">
                        <td class="dtr-doc-day">@day.Day</td>
                        <td colspan="6" class="dtr-doc-note-cell">
                            <NoteCellContent Day="day.Day" Note="note" OnNoteChanged="OnNoteChanged" OnNoteBlur="OnNoteBlur" OnClearNote="OnClearNote" />
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td class="dtr-doc-day">
                            @day.Day
                            @if (OnToggleWfh.HasDelegate)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 no-print" title="Mark as work-from-home"
                                        @onclick="() => OnToggleWfh.InvokeAsync(day.Day)">
                                    <i class="bi bi-house"></i>
                                </button>
                            }
                            @if (OnToggleHoliday.HasDelegate)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 no-print" title="Mark as holiday"
                                        @onclick="() => OnToggleHoliday.InvokeAsync(day.Day)">
                                    <i class="bi bi-flag"></i>
                                </button>
                            }
                            @if (OnSetNote.HasDelegate)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 no-print" title="Add a note/activity for this day"
                                        @onclick="() => OnSetNote.InvokeAsync(day.Day)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            }
                            @if ((day.DayType == DtrDayType.Saturday || day.DayType == DtrDayType.Sunday) && !weekendHasPunch && !weekendHasSlotNote)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 no-print"
                                        title="No time was recorded — revert this day back to the default SATURDAY/SUNDAY label"
                                        @onclick="() => OnCollapseWeekend.InvokeAsync(day.Day)">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            }
                        </td>
                        @{
                            var segments = BuildRowSegments(day.Day);
                            // A single note spanning the whole AmIn..PmOut
                            // width has nothing left to put in the Undertime
                            // columns anyway — merge them in too so the row
                            // reads as one clean full-width cell, same as
                            // the SATURDAY/SUNDAY/HOLIDAY/WFH label rows,
                            // instead of leaving two dangling empty cells.
                            var isFullRowNote = segments.Count == 1 && segments[0].Start == 0
                                && segments[0].End == DtrSlotOrder.Slots.Length - 1 && segments[0].Text is not null;
                        }
                        @foreach (var seg in segments)
                        {
                            var slotStart = DtrSlotOrder.Slots[seg.Start];
                            <td colspan="@(isFullRowNote ? 6 : seg.End - seg.Start + 1)" class="@(isFullRowNote ? "dtr-doc-fullrow-note" : null)">
                                <DtrSlotNoteCell Day="day.Day" Slot="@slotStart" Text="@seg.Text" SlotEndValue="@(seg.SlotEnd ?? slotStart)"
                                             AvailableEndSlots="@AvailableEndSlots(day.Day, seg.Start)"
                                             CurrentTime="@GetPunchTime(day, slotStart)" LogId="@GetPunchLogId(day, slotStart)"
                                             AllowEdit="AllowManualPunchEdit" OnAddPunch="AddPunch" OnEditPunch="EditPunch" OnClearPunch="ClearPunch"
                                             OnSetNote="OnSetSlotNote" OnChanged="OnSlotNoteChanged" OnBlur="OnSlotNoteBlur" OnClear="OnClearSlotNote"
                                             OnRangeChanged="OnSlotRangeChanged" Confirm="Confirm" />
                            </td>
                        }
                        @if (!isFullRowNote)
                        {
                            <td>@(day.UndertimeHours > 0 ? day.UndertimeHours.ToString() : "")</td>
                            <td>@(day.UndertimeMinutes > 0 ? day.UndertimeMinutes.ToString() : "")</td>
                        }
                    </tr>
                }
            }
            <tr>
                <td colspan="5" style="text-align:right;font-weight:700;">Total</td>
                <td style="font-weight:700;">@(AdjustedTotal.Hours > 0 ? AdjustedTotal.Hours.ToString() : "")</td>
                <td style="font-weight:700;">@(AdjustedTotal.Minutes > 0 ? AdjustedTotal.Minutes.ToString() : "")</td>
            </tr>
        </tbody>
    </table>

    <div class="dtr-doc-cert">
        I certify on my honor that the above is a true and correct report of
        the hours of work performed, record of which was made daily at
        the time of arrival and departure from office.
    </div>

    <div class="dtr-doc-signoff">
        <div class="dtr-doc-signoff-name">@Document.EmployeeName.ToUpperInvariant()</div>
        <div class="dtr-doc-signoff-title">@Document.Position</div>
    </div>

    <div class="dtr-doc-verified">
        VERIFIED as to the prescribed office hours:
        <div class="dtr-doc-verified-line"></div>
    </div>

    <div class="dtr-doc-signoff" style="margin-top:6px;">
        <div class="dtr-doc-signoff-name">@Document.ApprovedByName</div>
        <div class="dtr-doc-signoff-title">@Document.ApprovedByPosition</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DtrDocumentDto Document { get; set; } = default!;
    [Parameter] public ISet<int> WfhDays { get; set; } = new HashSet<int>();
    [Parameter] public EventCallback<int> OnToggleWfh { get; set; }
    [Parameter] public ISet<int> HolidayDays { get; set; } = new HashSet<int>();
    [Parameter] public EventCallback<int> OnToggleHoliday { get; set; }

    // Free-text remarks for a WHOLE day (e.g. "Field Visit", "Seminar") —
    // unlike WFH/Holiday's fixed labels, this is an actual editable text
    // box in the row, for whatever office activity doesn't fit those two
    // options. For a note on just one specific punch column, see SlotNotes
    // below instead.
    [Parameter] public IDictionary<int, DtrPrintDocument.DtrNoteEntry> NoteDays { get; set; } = new Dictionary<int, DtrPrintDocument.DtrNoteEntry>();
    [Parameter] public EventCallback<int> OnSetNote { get; set; }
    [Parameter] public EventCallback<(int Day, string Text)> OnNoteChanged { get; set; }
    [Parameter] public EventCallback<int> OnNoteBlur { get; set; }
    [Parameter] public EventCallback<int> OnClearNote { get; set; }

    // Per-column notes — independent of NoteDays above. Keyed by (Day,
    // Slot) where Slot is the note's STARTING column; the value's SlotEnd
    // says how far it extends (same as Slot for a single column). A slot
    // with no entry here — and not covered by an earlier note's span — just
    // shows its normal punch-time cell. Multiple notes on the same day can
    // each cover their own (non-overlapping) run of columns.
    [Parameter] public IDictionary<(int Day, string Slot), (string Text, string SlotEnd)> SlotNotes { get; set; } = new Dictionary<(int, string), (string, string)>();
    [Parameter] public EventCallback<(int Day, string Slot)> OnSetSlotNote { get; set; }
    [Parameter] public EventCallback<(int Day, string Slot, string Text)> OnSlotNoteChanged { get; set; }
    [Parameter] public EventCallback<(int Day, string Slot)> OnSlotNoteBlur { get; set; }
    [Parameter] public EventCallback<(int Day, string Slot)> OnClearSlotNote { get; set; }
    [Parameter] public EventCallback<(int Day, string Slot, string NewSlotEnd)> OnSlotRangeChanged { get; set; }

    private static string? GetPunchTime(DtrDayDto day, string slot) => slot switch
    {
        "AmIn" => day.AmTimeIn,
        "AmOut" => day.AmTimeOut,
        "PmIn" => day.PmTimeIn,
        "PmOut" => day.PmTimeOut,
        _ => null
    };

    private static int? GetPunchLogId(DtrDayDto day, string slot) => slot switch
    {
        "AmIn" => day.AmTimeInLogId,
        "AmOut" => day.AmTimeOutLogId,
        "PmIn" => day.PmTimeInLogId,
        "PmOut" => day.PmTimeOutLogId,
        _ => null
    };

    // Walks the 4 AM/PM columns left to right, grouping a note's covered
    // columns into ONE segment (rendered as one <td colspan>) and leaving
    // every other, un-noted column as its own single-column segment —
    // exactly mirroring how the server resolves overlapping ranges, so the
    // two never disagree about which columns a note actually covers.
    private List<(int Start, int End, string? Text, string? SlotEnd)> BuildRowSegments(int day)
    {
        var segments = new List<(int, int, string?, string?)>();
        var i = 0;
        while (i < DtrSlotOrder.Slots.Length)
        {
            var slot = DtrSlotOrder.Slots[i];
            if (SlotNotes.TryGetValue((day, slot), out var noted))
            {
                var endIdx = DtrSlotOrder.IndexOf(noted.SlotEnd);
                segments.Add((i, endIdx, noted.Text, noted.SlotEnd));
                i = endIdx + 1;
            }
            else
            {
                segments.Add((i, i, null, null));
                i++;
            }
        }
        return segments;
    }

    // Valid "extend through" choices when composing/editing a note starting
    // at startIdx — every consecutive column from there that isn't the
    // start of a DIFFERENT note (columns between two note-starts always
    // belong to whichever note started earlier, so the first other
    // note-start found is exactly where this one's reach has to stop).
    private List<string> AvailableEndSlots(int day, int startIdx)
    {
        var result = new List<string> { DtrSlotOrder.Slots[startIdx] };
        for (var j = startIdx + 1; j < DtrSlotOrder.Slots.Length; j++)
        {
            if (SlotNotes.ContainsKey((day, DtrSlotOrder.Slots[j])))
                break;
            result.Add(DtrSlotOrder.Slots[j]);
        }
        return result;
    }

    // Set on both AttendanceManagement.razor (SuperAdmin/Finance) and
    // MyDtr.razor (self-service) — lets the viewer clear ANY time in this
    // table (device-synced or manual) and re-enter it, since the log book
    // is the authoritative record, not whatever the device happened to
    // capture. The server enforces ownership regardless of this flag.
    [Parameter] public bool AllowManualPunchEdit { get; set; }
    [Parameter] public EventCallback<(int Day, TimeOnly Time)> OnAddManualPunch { get; set; }
    [Parameter] public EventCallback<int> OnRemoveManualPunch { get; set; }
    [Parameter] public EventCallback<(int Day, int LogId, TimeOnly NewTime)> OnEditManualPunch { get; set; }

    // Client-only, not persisted: a Saturday/Sunday with no punch still
    // defaults to the plain "SATURDAY"/"SUNDAY" label — the pencil icon
    // switches that day into the normal editable grid so a punch can be
    // added; once one exists, the day shows that way on its own (see
    // weekendHasPunch above). Owned by DtrPrintDocument (same pattern as
    // WfhDays/HolidayDays above) so expanding it in one printed copy is
    // reflected in the other — a plain field here would only affect
    // whichever DtrCopy instance was clicked.
    [Parameter] public ISet<int> ExpandedWeekendDays { get; set; } = new HashSet<int>();
    [Parameter] public EventCallback<int> OnExpandWeekend { get; set; }
    [Parameter] public EventCallback<int> OnCollapseWeekend { get; set; }

    // Owned by DtrPrintDocument, threaded through here to every DtrTimeCell
    // — one shared confirmation dialog instead of one per cell.
    [Parameter] public ConfirmModal? Confirm { get; set; }

    // Bridges DtrTimeCell's (Day, Slot, ...) callbacks to the parent's
    // (Day, ...)-only ones — Slot only matters for picking which cell is
    // mid-edit, which DtrTimeCell now owns itself.
    private Task AddPunch((int Day, string Slot, TimeOnly Time) e) => OnAddManualPunch.InvokeAsync((e.Day, e.Time));
    private Task ClearPunch((int Day, string Slot, int LogId) e) => OnRemoveManualPunch.InvokeAsync(e.LogId);
    private Task EditPunch((int Day, string Slot, int LogId, TimeOnly NewTime) e) => OnEditManualPunch.InvokeAsync((e.Day, e.LogId, e.NewTime));

    // A day fully excused (WFH, Holiday, or a whole-day note) contributes no
    // undertime at all, matching the paper form's convention that a
    // documented absence isn't counted against the employee. Per-column
    // notes (SlotNotes) are deliberately NOT included here — they annotate
    // one specific punch cell, not the whole day, and undertime is only
    // ever computed server-side per whole day, so there's no sub-day amount
    // to subtract for just one noted column. Recomputed client-side since
    // DtrService (server) has no knowledge of these marks — they're saved
    // separately, not baked into Document.TotalUndertimeHours/Minutes.
    private (int Hours, int Minutes) AdjustedTotal
    {
        get
        {
            var totalMinutes = 0;
            foreach (var day in Document.Days)
            {
                if (!day.IsInPeriod) continue;
                if (WfhDays.Contains(day.Day) || HolidayDays.Contains(day.Day) || NoteDays.ContainsKey(day.Day))
                    continue;

                totalMinutes += day.UndertimeHours * 60 + day.UndertimeMinutes;
            }
            return (totalMinutes / 60, totalMinutes % 60);
        }
    }
}
