@* DtrPrintDocument.razor — Civil Service Form No. 48 (Daily Time Record)
   print/PDF preview. Same live Scale/Font/Margin control pattern as
   DarPrintDocument.razor (reuses its .dar-print-controls* CSS classes
   verbatim — that panel is generic chrome, not landscape-specific), printed
   A4 portrait in duplicate (two copies side by side, matching the paper
   form). Each copy's table rows auto-expand to fill the full page height —
   see the file-header comment in dtr-form.css for how. *@
@using EcaInformationSystem.Shared.DTOs.Dtr
@using EcaInformationSystem.Client.Services

<div class="no-print dar-print-controls mb-3">
    <div class="dar-print-controls-header">
        <div class="dar-print-controls-title">
            <span class="dar-print-controls-icon"><i class="bi bi-sliders"></i></span>
            <div>
                <div class="fw-bold">Print Settings</div>
                <div class="dar-print-controls-subtitle">Adjust how the DTR looks before printing</div>
            </div>
        </div>
        <button type="button" class="btn btn-primary btn-sm dar-print-btn" @onclick="PrintAsync"
                title="View & print the Daily Time Record">
            <i class="bi bi-printer me-1"></i>Print DTR
        </button>
    </div>

    <div class="dar-print-controls-body">
        <div class="dar-print-slider">
            <div class="dar-print-slider-label">
                <span><i class="bi bi-arrows-angle-expand me-1"></i>Scale</span>
                <span class="dar-print-slider-value">@_scalePercent%</span>
            </div>
            <input type="range" class="form-range" min="60" max="170" step="1"
                   @bind-value="_scalePercent" @bind-value:event="oninput" />
        </div>
        <div class="dar-print-slider">
            <div class="dar-print-slider-label">
                <span><i class="bi bi-fonts me-1"></i>Font Size</span>
                <span class="dar-print-slider-value">@_fontPercent%</span>
            </div>
            <input type="range" class="form-range" min="70" max="180" step="1"
                   @bind-value="_fontPercent" @bind-value:event="oninput" />
        </div>
        <div class="dar-print-slider">
            <div class="dar-print-slider-label">
                <span><i class="bi bi-aspect-ratio me-1"></i>Margin</span>
                <span class="dar-print-slider-value">@_marginMm mm</span>
            </div>
            <input type="range" class="form-range" min="0" max="25" step="1"
                   @bind-value="_marginMm" @bind-value:event="oninput" />
        </div>
    </div>

    <div class="dar-print-controls-footer">
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="SavePrintSettingsAsync">
            <i class="bi bi-save me-1"></i>Save as default
        </button>
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="ResetPrintSettings">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to defaults
        </button>
    </div>

    <div class="dar-print-note">
        <i class="bi bi-info-circle me-1"></i>
        Before printing, check your browser/printer's paper setup — set <strong>paper size to A4</strong> and
        <strong>layout to Portrait</strong> — for the best result.
    </div>
</div>

<div class="no-print dar-doc-mobile-hint">
    <i class="bi bi-arrow-left-right me-1"></i>Scroll sideways to see both copies
</div>
<div class="dar-doc-preview-scroll">
<div class="dtr-doc-wrap" id="dtr-print-target" style="@RootStyle">
  <div class="dtr-doc-wrap-inner">
    <div class="dtr-print-page">
        <DtrCopy Document="Document" WfhDays="_wfhDays" OnToggleWfh="ToggleWfh" HolidayDays="_holidayDays" OnToggleHoliday="ToggleHoliday"
                 NoteDays="_noteDays" OnSetNote="SetNote" OnNoteChanged="NoteChanged" OnNoteBlur="NoteBlur" OnClearNote="ClearNote"
                 SlotNotes="_slotNotes" OnSetSlotNote="SetSlotNote" OnSlotNoteChanged="SlotNoteChanged" OnSlotNoteBlur="SlotNoteBlur" OnClearSlotNote="ClearSlotNote" OnSlotRangeChanged="SlotRangeChanged"
                 AllowManualPunchEdit="AllowManualPunchEdit" OnAddManualPunch="AddManualPunch" OnRemoveManualPunch="RemoveManualPunch" OnEditManualPunch="EditManualPunch"
                 ExpandedWeekendDays="_expandedWeekendDays" OnExpandWeekend="ExpandWeekend" OnCollapseWeekend="CollapseWeekend"
                 Confirm="_confirmModal" />
        <DtrCopy Document="Document" WfhDays="_wfhDays" OnToggleWfh="ToggleWfh" HolidayDays="_holidayDays" OnToggleHoliday="ToggleHoliday"
                 NoteDays="_noteDays" OnSetNote="SetNote" OnNoteChanged="NoteChanged" OnNoteBlur="NoteBlur" OnClearNote="ClearNote"
                 SlotNotes="_slotNotes" OnSetSlotNote="SetSlotNote" OnSlotNoteChanged="SlotNoteChanged" OnSlotNoteBlur="SlotNoteBlur" OnClearSlotNote="ClearSlotNote" OnSlotRangeChanged="SlotRangeChanged"
                 AllowManualPunchEdit="AllowManualPunchEdit" OnAddManualPunch="AddManualPunch" OnRemoveManualPunch="RemoveManualPunch" OnEditManualPunch="EditManualPunch"
                 ExpandedWeekendDays="_expandedWeekendDays" OnExpandWeekend="ExpandWeekend" OnCollapseWeekend="CollapseWeekend"
                 Confirm="_confirmModal" />
    </div>
  </div>
</div>
</div>

<ConfirmModal @ref="_confirmModal" />

@code {
    private ConfirmModal? _confirmModal;

    [Parameter, EditorRequired] public DtrDocumentDto Document { get; set; } = default!;
    [Inject] public IJSRuntime JS { get; set; } = default!;
    [Inject] public ToastService Toast { get; set; } = default!;
    [Inject] public HttpClient Http { get; set; } = default!;

    // Set by AttendanceManagement.razor (SuperAdmin/Finance managing any
    // same-region user's DTR) and by MyDtr.razor (self-service) — the
    // server enforces the actual ownership rule (self, or SuperAdmin/Finance
    // within their own region) on the manual-punch endpoints regardless of
    // what this flag is set to client-side.
    //
    // What DOES differ server-side by caller role: Admin/Finance/SuperAdmin
    // write the punch immediately; every other role's Add/Remove is filed as
    // a Pending DtrPunchEditRequest instead and only takes effect once one of
    // those three approves it (see DtrController, DtrPunchRequestService,
    // and the "DTR Request" feed in UnifiedNotificationBell). This component
    // doesn't need to know which path it's on — HandlePunchResponseAsync
    // below surfaces the "submitted for approval" case either way.
    [Parameter] public bool AllowManualPunchEdit { get; set; }

    // Adding/removing a punch changes Document.Days server-side (AM/PM times,
    // undertime), which this component doesn't own — the parent re-fetches
    // the whole DtrDocumentDto and passes a fresh one back down.
    [Parameter] public EventCallback OnDocumentChanged { get; set; }

    // Shared between both printed copies so marking a day WFH in one always
    // reflects in the other — see DtrCopy.razor's file-header comment.
    // Loaded from (and saved to) DtrDayMark via the API, keyed by
    // Document.UserId — see LoadMarksAsync/SaveMarkAsync/ClearMarkAsync.
    private readonly HashSet<int> _wfhDays = new();
    private readonly HashSet<int> _holidayDays = new();
    private readonly Dictionary<int, DtrNoteEntry> _noteDays = new();

    // Per-column notes — keyed by (Day, Slot), Slot the note's STARTING
    // column ("AmIn"|"AmOut"|"PmIn"|"PmOut"); the value's SlotEnd says how
    // far it extends (same as Slot for a single column). Independent of
    // _noteDays (whole-day): multiple, non-overlapping slot notes can
    // coexist on the same day, while any un-covered slots keep showing
    // real punch cells.
    private readonly Dictionary<(int Day, string Slot), (string Text, string SlotEnd)> _slotNotes = new();

    // Client-only (not persisted via DtrDayMark): which blank Saturdays/
    // Sundays the user has manually switched to the normal editable grid
    // via the pencil icon, so a punch can be added. Shared between both
    // printed copies for the same reason as _wfhDays etc above.
    private readonly HashSet<int> _expandedWeekendDays = new();
    private void ExpandWeekend(int day) => _expandedWeekendDays.Add(day);
    private void CollapseWeekend(int day) => _expandedWeekendDays.Remove(day);

    private Guid _loadedForUserId;
    private DateTime _loadedMonth;

    protected override async Task OnParametersSetAsync()
    {
        // Days are always shown for Document.PeriodStart's whole month
        // (see DtrService), so that's the range marks are loaded/saved for.
        var month = new DateTime(Document.PeriodStart.Year, Document.PeriodStart.Month, 1);
        if (Document.UserId == _loadedForUserId && month == _loadedMonth)
            return;

        _loadedForUserId = Document.UserId;
        _loadedMonth = month;
        await LoadMarksAsync(month);
    }

    private async Task LoadMarksAsync(DateTime month)
    {
        _wfhDays.Clear();
        _holidayDays.Clear();
        _noteDays.Clear();
        _slotNotes.Clear();

        try
        {
            var monthEnd = new DateTime(month.Year, month.Month, DateTime.DaysInMonth(month.Year, month.Month));
            var marks = await Http.GetFromJsonAsync<List<DtrDayMarkDto>>(
                $"api/dtr/day-marks/{Document.UserId}?start={month:yyyy-MM-dd}&end={monthEnd:yyyy-MM-dd}") ?? new();

            foreach (var mark in marks)
            {
                if (mark.Slot is not null)
                {
                    // Per-column note — MarkType is always "Note" here.
                    _slotNotes[(mark.Date.Day, mark.Slot)] = (mark.NoteText ?? string.Empty, mark.SlotEnd ?? mark.Slot);
                    continue;
                }

                switch (mark.MarkType)
                {
                    case "Wfh": _wfhDays.Add(mark.Date.Day); break;
                    case "Holiday": _holidayDays.Add(mark.Date.Day); break;
                    case "Note": _noteDays[mark.Date.Day] = new DtrNoteEntry { Text = mark.NoteText ?? string.Empty }; break;
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load WFH/Holiday/Note marks: {ex.Message}");
        }
    }

    private DateTime DateFor(int day) => new(Document.PeriodStart.Year, Document.PeriodStart.Month, day);

    private async Task<bool> SaveMarkAsync(int day, string markType, string? noteText, string? slot = null, string? slotEnd = null)
    {
        try
        {
            var response = await Http.PutAsJsonAsync("api/dtr/day-marks", new SetDtrDayMarkRequestDto
            {
                UserId = Document.UserId,
                Date = DateFor(day),
                MarkType = markType,
                NoteText = noteText,
                Slot = slot,
                SlotEnd = slotEnd
            });

            if (!response.IsSuccessStatusCode)
                Toast.ShowError("Failed to save.");

            return response.IsSuccessStatusCode;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save: {ex.Message}");
            return false;
        }
    }

    private async Task ClearMarkAsync(int day, string? slot = null)
    {
        try
        {
            var url = $"api/dtr/day-marks/{Document.UserId}?date={DateFor(day):yyyy-MM-dd}";
            if (slot is not null) url += $"&slot={slot}";
            await Http.DeleteAsync(url);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to clear: {ex.Message}");
        }
    }

    // Whole-day marks (Wfh/Holiday/full-day Note) supersede any per-column
    // notes on that date — clearing _slotNotes locally here mirrors what
    // DtrDayMarkService already does server-side.
    private void ClearSlotNotesForDay(int day)
    {
        foreach (var key in _slotNotes.Keys.Where(k => k.Day == day).ToList())
            _slotNotes.Remove(key);
    }

    private async Task ToggleWfh(int day)
    {
        if (_wfhDays.Remove(day))
        {
            await ClearMarkAsync(day);
        }
        else
        {
            _wfhDays.Add(day);
            _holidayDays.Remove(day);
            _noteDays.Remove(day);
            ClearSlotNotesForDay(day);
            await SaveMarkAsync(day, "Wfh", null);
        }
    }

    private async Task ToggleHoliday(int day)
    {
        if (_holidayDays.Remove(day))
        {
            await ClearMarkAsync(day);
        }
        else
        {
            _holidayDays.Add(day);
            _wfhDays.Remove(day);
            _noteDays.Remove(day);
            ClearSlotNotesForDay(day);
            await SaveMarkAsync(day, "Holiday", null);
        }
    }

    private async Task SetNote(int day)
    {
        if (_noteDays.ContainsKey(day))
            return;

        _wfhDays.Remove(day);
        _holidayDays.Remove(day);
        ClearSlotNotesForDay(day);
        _noteDays[day] = new DtrNoteEntry { Text = string.Empty };
        await SaveMarkAsync(day, "Note", string.Empty);
    }

    // Fires on every keystroke — local-only, no network call, so typing
    // stays instant. The actual save happens on blur, see NoteBlur below.
    private void NoteChanged((int Day, string Text) change)
    {
        if (_noteDays.TryGetValue(change.Day, out var entry))
            entry.Text = change.Text;
    }

    private async Task NoteBlur(int day)
    {
        if (!_noteDays.TryGetValue(day, out var entry))
            return;

        // Blur is the actual commit point for a typed note/activity — give
        // explicit confirmation it was saved, since (especially on a
        // Saturday/Sunday, where nothing else on the row visibly changes)
        // the user has no other cue that it didn't just get lost before
        // they navigate away.
        if (await SaveMarkAsync(day, "Note", entry.Text) && !string.IsNullOrWhiteSpace(entry.Text))
            Toast.ShowSuccess("Activity saved.");
    }

    private async Task ClearNote(int day)
    {
        _noteDays.Remove(day);
        await ClearMarkAsync(day);
    }

    public class DtrNoteEntry
    {
        public string Text { get; set; } = string.Empty;
    }

    // ── Per-column notes — independent of the whole-day note above. Each of
    // the 4 punch slots (AmIn/AmOut/PmIn/PmOut) can carry its own note,
    // coexisting with the other slots' real punch times on the same day.
    // Always starts as a single column (SlotEnd = Slot) — extending it
    // across further columns happens afterward via SlotRangeChanged. ──────
    private async Task SetSlotNote((int Day, string Slot) input)
    {
        var key = (input.Day, input.Slot);
        if (_slotNotes.ContainsKey(key))
            return;

        // Mirrors the server: setting a slot note supersedes any whole-day
        // mark on that date (a day is either "one whole-day thing" or "a mix
        // of individually-noted/unnoted columns", never both).
        _wfhDays.Remove(input.Day);
        _holidayDays.Remove(input.Day);
        _noteDays.Remove(input.Day);
        _slotNotes[key] = (string.Empty, input.Slot);
        await SaveMarkAsync(input.Day, "Note", string.Empty, input.Slot, input.Slot);
    }

    private void SlotNoteChanged((int Day, string Slot, string Text) change)
    {
        if (_slotNotes.TryGetValue((change.Day, change.Slot), out var entry))
            _slotNotes[(change.Day, change.Slot)] = (change.Text, entry.SlotEnd);
    }

    private async Task SlotNoteBlur((int Day, string Slot) input)
    {
        if (!_slotNotes.TryGetValue((input.Day, input.Slot), out var entry))
            return;

        await SaveMarkAsync(input.Day, "Note", entry.Text, input.Slot, entry.SlotEnd);
    }

    private async Task ClearSlotNote((int Day, string Slot) input)
    {
        _slotNotes.Remove((input.Day, input.Slot));
        await ClearMarkAsync(input.Day, input.Slot);
    }

    // Extends/shrinks an existing slot note's span — e.g. turning a lone
    // AmOut note into one that also covers PmIn and PmOut. Saves right
    // away, same as SlotNoteBlur, rather than waiting for a text edit too.
    private async Task SlotRangeChanged((int Day, string Slot, string NewSlotEnd) input)
    {
        if (!_slotNotes.TryGetValue((input.Day, input.Slot), out var entry))
            return;

        _slotNotes[(input.Day, input.Slot)] = (entry.Text, input.NewSlotEnd);
        await SaveMarkAsync(input.Day, "Note", entry.Text, input.Slot, input.NewSlotEnd);
    }

    // ✅ NEW — the server only writes the punch directly when the caller is
    // Admin/Finance/SuperAdmin; anyone else's Add/Remove comes back with
    // Pending=true instead (it was filed as a request, not applied), so this
    // surfaces that distinction instead of silently refreshing as if nothing
    // happened.
    private async Task<bool> HandlePunchResponseAsync(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
            return false;

        try
        {
            var result = await response.Content.ReadFromJsonAsync<DtrPunchActionResultDto>();
            if (result?.Pending == true)
                Toast.ShowSuccess(result.Message ?? "Submitted for approval.", "Request Submitted");
        }
        catch
        {
            // Older/empty response body (e.g. RemoveManualPunch's direct-delete
            // path returns no content) — not an error, just nothing to surface.
        }

        return true;
    }

    private async Task AddManualPunch((int Day, TimeOnly Time) input)
    {
        try
        {
            var punchDateTime = DateFor(input.Day).Add(input.Time.ToTimeSpan());
            var response = await Http.PostAsJsonAsync("api/dtr/manual-punch", new AddManualPunchRequestDto
            {
                UserId = Document.UserId,
                PunchDateTime = punchDateTime
            });

            if (await HandlePunchResponseAsync(response))
                await OnDocumentChanged.InvokeAsync();
            else
                Toast.ShowError("Failed to add the manual time entry.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to add the manual time entry: {ex.Message}");
        }
    }

    private async Task RemoveManualPunch(int manualPunchId)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/dtr/manual-punch/{manualPunchId}");
            if (await HandlePunchResponseAsync(response))
                await OnDocumentChanged.InvokeAsync();
            else
                Toast.ShowError("Failed to remove the manual time entry.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to remove the manual time entry: {ex.Message}");
        }
    }

    // There's no dedicated "update punch time" endpoint — a clear + re-add
    // achieves the same result and reuses both endpoints' existing ownership
    // checks, so this just does both under one user-facing "Edit" action
    // (and one document refresh) instead of making the user do it as two
    // separate steps.
    //
    // ✅ For a non-Admin/Finance/SuperAdmin caller, neither call actually
    // mutates anything — the DELETE files a "Remove this punch" request and
    // the POST files an "Add this new time" request, both Pending, so the
    // original punch is untouched until an approver acts on both. That's two
    // separate approvals instead of one atomic edit, but it means a rejected
    // request never loses the real punch in the meantime.
    private async Task EditManualPunch((int Day, int LogId, TimeOnly NewTime) input)
    {
        try
        {
            var removeResponse = await Http.DeleteAsync($"api/dtr/manual-punch/{input.LogId}");
            if (!await HandlePunchResponseAsync(removeResponse))
            {
                Toast.ShowError("Failed to update the time entry.");
                return;
            }

            var punchDateTime = DateFor(input.Day).Add(input.NewTime.ToTimeSpan());
            var addResponse = await Http.PostAsJsonAsync("api/dtr/manual-punch", new AddManualPunchRequestDto
            {
                UserId = Document.UserId,
                PunchDateTime = punchDateTime
            });

            if (await HandlePunchResponseAsync(addResponse))
                await OnDocumentChanged.InvokeAsync();
            else
                Toast.ShowError("Failed to update the time entry.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to update the time entry: {ex.Message}");
        }
    }

    private const int DefaultScalePercent = 100;
    private const int DefaultFontPercent = 100;
    private const int DefaultMarginMm = 0;

    private int _scalePercent = DefaultScalePercent;
    private int _fontPercent = DefaultFontPercent;
    private int _marginMm = DefaultMarginMm;

    private string RootStyle =>
        $"--dtr-scale:{(_scalePercent / 100.0).ToString(System.Globalization.CultureInfo.InvariantCulture)};" +
        $"--dtr-font-scale:{(_fontPercent / 100.0).ToString(System.Globalization.CultureInfo.InvariantCulture)};" +
        $"--dtr-margin:{_marginMm}mm;";

    private void ResetPrintSettings()
    {
        _scalePercent = DefaultScalePercent;
        _fontPercent = DefaultFontPercent;
        _marginMm = DefaultMarginMm;
    }

    private const string ScaleStorageKey = "dtr-print-scale";
    private const string FontStorageKey = "dtr-print-font";
    private const string MarginStorageKey = "dtr-print-margin";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var savedScale = await JS.InvokeAsync<string?>("localStorage.getItem", ScaleStorageKey);
            var savedFont = await JS.InvokeAsync<string?>("localStorage.getItem", FontStorageKey);
            var savedMargin = await JS.InvokeAsync<string?>("localStorage.getItem", MarginStorageKey);

            var changed = false;
            if (int.TryParse(savedScale, out var scale)) { _scalePercent = scale; changed = true; }
            if (int.TryParse(savedFont, out var font)) { _fontPercent = font; changed = true; }
            if (int.TryParse(savedMargin, out var margin)) { _marginMm = margin; changed = true; }

            if (changed) StateHasChanged();
        }
        catch
        {
            // localStorage unavailable — keep the built-in defaults.
        }
    }

    private async Task SavePrintSettingsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ScaleStorageKey, _scalePercent.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", FontStorageKey, _fontPercent.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", MarginStorageKey, _marginMm.ToString());
            Toast.ShowSuccess("Print settings saved as your default for the DTR.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save print settings: {ex.Message}");
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("printDtrOnly");
}
