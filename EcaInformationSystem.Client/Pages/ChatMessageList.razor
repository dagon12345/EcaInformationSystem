@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs.Chat
@inject ChatStateService ChatState
@inject IJSRuntime JS
@inject HttpClient Http
@implements IAsyncDisposable

<div id="@_containerId" class="chat-message-list">
    @if (ChatState.IsLoadingMessages && !ChatState.Messages.Any())
    {
        <div class="text-center text-muted small py-3">
            <span class="spinner-border spinner-border-sm me-1"></span> Loading messages...
        </div>
    }
    else if (ChatState.IsLoadingMessages)
    {
        <div class="text-center text-muted small py-2">
            <span class="spinner-border spinner-border-sm"></span>
        </div>
    }

    @{
        DateTime? lastDate = null;
    }
    @foreach (var message in ChatState.Messages)
    {
        var messageDate = message.SentAt.ToLocalTime().Date;

        @if (lastDate == null || messageDate != lastDate)
        {
            <div class="chat-date-separator">
                <span>@FormatDateSeparator(messageDate)</span>
            </div>
        }
        lastDate = messageDate;

        <div id="msg-@message.Id" class="chat-message-bubble @(message.SenderId == CurrentUserId ? "own" : "") @(message.Id == ChatState.PendingScrollToMessageId ? "chat-message-highlighted" : "")">

            @if (message.ReplyPreview != null)
            {
                <div class="chat-reply-quote" @onclick="() => ScrollToOriginal(message.ReplyPreview.MessageId)" @onclick:stopPropagation="true">
                    <div class="chat-reply-quote-sender">@message.ReplyPreview.SenderName</div>
                    <div class="chat-reply-quote-text text-truncate">@message.ReplyPreview.Preview</div>
                </div>
            }

            @if (message.SenderId != CurrentUserId)
            {
                <a href="@($"/profile/{message.SenderId}")" class="chat-message-sender chat-sender-link" title="View profile" @onclick:stopPropagation="true">
                    <span class="avatar-preview-trigger">
                        <img src="@AvatarUrl(message.SenderId)" crossorigin="anonymous" alt="" class="chat-message-avatar avatar-img"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
                        <span class="chat-message-avatar" style="display:none;">@GetInitials(message.SenderName)</span>
                        <img src="@AvatarUrl(message.SenderId)" crossorigin="anonymous" alt="" class="avatar-preview-popup"
                             onerror="this.style.display='none';" />
                    </span>
                    @message.SenderName
                </a>
            }

            @if (message.IsDeleted)
            {
                <div class="chat-message-content deleted"><em>This message was deleted</em></div>
            }
            else if (_editingMessageId == message.Id)
            {
                @* ✅ Edit mode — replaces content, this is intentional (you ARE changing the text) *@
                <div class="chat-edit-box" @onclick:stopPropagation="true">
                    <textarea class="form-control form-control-sm chat-edit-input" rows="2"
                              @bind="_editDraftText" @onkeydown="e => OnEditKeyDown(e, message)"></textarea>
                    <div class="chat-edit-actions">
                        <button class="chat-edit-btn chat-edit-btn-cancel" @onclick="CancelEditing">Cancel</button>
                        <button class="chat-edit-btn chat-edit-btn-save" @onclick="() => SaveEdit(message)">Save</button>
                    </div>
                </div>
            }
            @* ✅ Normal content — ALWAYS shown when not editing, regardless of delete-confirm state *@
            else
            {
                @if (message.Attachments.Any())
                {
                    <div class="chat-message-attachments">
                        @foreach (var attachment in message.Attachments)
                        {
                            @if (attachment.ContentType.StartsWith("image/"))
                            {
                                <img src="data:@attachment.ContentType;base64,@attachment.ThumbnailBase64"
                                     class="chat-attachment-thumb"
                                     @onclick="() => ViewFullAttachment(message.Attachments, attachment.Id)" />
                            }
                            else
                            {
                                <div class="chat-pdf-attachment" style="cursor:pointer;"
                                     @onclick="() => DownloadPdfAttachment(attachment.Id, attachment.OriginalFileName)">
                                    <i class="bi @ChatFileIconHelper.GetIcon(attachment.ContentType)"></i>
                                    <span class="text-truncate">@attachment.OriginalFileName</span>
                                    <i class="bi bi-download ms-1 text-muted"></i>
                                </div>
                            }
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(message.Content))
                {
                    <div class="chat-message-content">@RenderContentWithMentions(message)</div>
                }
            }
            @* ✅ MOVED — delete confirm now renders BELOW the content, as its own separate block,
   not replacing anything. Only shows when NOT currently editing (can't delete while editing anyway). *@
            @if (_confirmingDeleteMessageId == message.Id && _editingMessageId != message.Id)
            {
                <div class="chat-inline-confirm" @onclick:stopPropagation="true">
                    <div class="chat-inline-confirm-text">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>
                        Delete this message?
                    </div>
                    <div class="chat-inline-confirm-actions">
                        <button class="chat-inline-confirm-btn chat-inline-confirm-cancel" @onclick="CancelDeleteMessage" disabled="@_isDeletingMessage">
                            Cancel
                        </button>
                        <button class="chat-inline-confirm-btn chat-inline-confirm-delete" @onclick="() => ConfirmDeleteMessage(message.Id)" disabled="@_isDeletingMessage">
                            @if (_isDeletingMessage)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <span>Delete</span>
                            }
                        </button>
                    </div>
                </div>
            }
            <div class="chat-message-meta">
                <small class="text-muted">
                    @message.SentAt.ToLocalTime().ToString("h:mm tt")
                    @if (message.IsEdited)
                    {
                        <span class="chat-edited-tag" title="@(message.EditedAt?.ToLocalTime().ToString("MMM dd, yyyy h:mm tt"))">(edited)</span>
                    }
                </small>

                <div class="chat-message-actions">
                    <button class="chat-action-btn" title="Reply" @onclick="() => ReplyTo(message)" @onclick:stopPropagation="true">
                        <i class="bi bi-reply-fill"></i>
                    </button>
                    @if (message.SenderId == CurrentUserId && !message.IsDeleted)
                    {
                        <button class="chat-action-btn" title="Edit" @onclick="() => StartEditing(message)" @onclick:stopPropagation="true">
                            <i class="bi bi-pencil-fill"></i>
                        </button>
                    }
                    @if (message.CanDelete && !message.IsDeleted)
                    {
                        <button class="chat-action-btn chat-action-delete" title="Delete message" @onclick="() => RequestDeleteMessage(message.Id)" @onclick:stopPropagation="true">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            </div>

            @* ✅ NEW — floating emoji button, anchored to the bottom-left CORNER of the bubble itself *@
            @if (!message.IsDeleted)
            {
                <button class="chat-emoji-corner-btn" title="React" @onclick="() => ToggleReactionPicker(message.Id)" @onclick:stopPropagation="true">
                    <i class="bi bi-emoji-smile"></i>
                </button>

                @if (_activeReactionPickerId == message.Id)
                {
                    <div class="chat-reaction-picker-floating" @onclick:stopPropagation="true">
                        <span @onclick="() => AddReaction(message, ReactionLike)" title="Like">👍</span>
                        <span @onclick="() => AddReaction(message, ReactionHeart)" title="Heart">❤️</span>
                        <span @onclick="() => AddReaction(message, ReactionHaha)" title="Haha">😂</span>
                        <span @onclick="() => AddReaction(message, ReactionClap)" title="Clap">👏</span>
                        <span @onclick="() => AddReaction(message, ReactionWow)" title="Wow">😮</span>
                    </div>
                }
            }
            @* ✅ NEW — seen indicator, only for MY latest message *@
            @if (message.Id == _myLastMessageId && _seenInfo != null)
            {
                <div class="chat-seen-indicator" @onclick="() => _showFullSeenList = !_showFullSeenList" @onclick:stopPropagation="true">
                    @if (ChatState.ActiveRoom?.Type == "Direct")
                    {
                        <small class="text-muted"><i class="bi bi-check2-all me-1"></i>Seen</small>
                    }
                    else
                    {
                        <small class="text-muted">
                            <i class="bi bi-check2-all me-1"></i>
                            Seen by @string.Join(", ", _seenInfo.SeenByNames.Take(_showFullSeenList ? 10 : 3))
                            @if (_seenInfo.HasMore)
                            {
                                <span> and @(_seenInfo.TotalSeenCount - Math.Min(_seenInfo.SeenByNames.Count, _showFullSeenList ? 10 : 3)) other(s)...</span>
                            }
                        </small>
                    }
                </div>
            }
            @if (message.Reactions.Any())
            {
                <div class="chat-reaction-summary">
                    @foreach (var r in message.Reactions)
                    {
                        <span class="chat-reaction-pill @(r.ReactorUserIds.Contains(CurrentUserId) ? "mine" : "")"
                              @onclick="() => ShowReactorsPopup(message.Id, r)" @onclick:stopPropagation="true">
                            @GetReactionEmoji(r.Type) @r.Count
                        </span>
                    }
                    @if (_reactorsPopupVisible)
                    {
                        <div class="chat-reactors-popup-backdrop" @onclick="CloseReactorsPopup">
                            <div class="chat-reactors-popup" @onclick:stopPropagation="true">
                                <div class="chat-reactors-popup-header">
                                    <span>@GetReactionEmoji(_popupReactionType) @_popupReactionType</span>
                                    <button class="chat-modal-btn" @onclick="CloseReactorsPopup">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                                <div class="chat-reactors-popup-list">
                                    @foreach (var name in _popupReactorNames)
                                    {
                                        <div class="chat-reactors-popup-item">
                                            <i class="bi bi-person-circle me-2"></i>@name
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    @if (ChatState.ActiveRoom != null)
    {
        var typingText = ChatState.GetTypingIndicatorText(ChatState.ActiveRoom.Id);
        @if (typingText != null)
        {
            <div class="chat-typing-indicator">
                <span class="chat-typing-dots"><span></span><span></span><span></span></span>
                @typingText
            </div>
        }
    }
    @if (_showImageModal)
    {
        <div class="chat-image-modal-backdrop" @onclick="CloseImageModal" @onkeydown="OnModalKeyDown" tabindex="0" @ref="_modalBackdropRef">
            <div class="chat-image-modal" @onclick:stopPropagation="true">
                <div class="chat-image-modal-header">
                    <span class="text-truncate">
                        @_modalFileName
                        @if (_modalAttachmentList.Count > 1)
                        {
                            <small class="text-muted ms-2">(@(_modalCurrentIndex + 1) of @_modalAttachmentList.Count)</small>
                        }
                    </span>
                    <div class="d-flex gap-2">
                        <button class="chat-modal-btn" title="Download" @onclick="DownloadModalImage">
                            <i class="bi bi-download"></i>
                        </button>
                        <button class="chat-modal-btn" title="Close" @onclick="CloseImageModal">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="chat-image-modal-body-wrap">
                    @if (_modalAttachmentList.Count > 1 && _modalCurrentIndex > 0)
                    {
                        <button class="chat-modal-nav-btn chat-modal-nav-prev" @onclick="ShowPreviousImage">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    }
                    <div class="chat-image-modal-body">
                        @if (_isLoadingModalImage)
                        {
                            <div class="text-white"><span class="spinner-border"></span></div>
                        }
                        else if (_modalImageSrc != null)
                        {
                            <img src="@_modalImageSrc" />
                        }
                    </div>
                    @if (_modalAttachmentList.Count > 1 && _modalCurrentIndex < _modalAttachmentList.Count - 1)
                    {
                        <button class="chat-modal-nav-btn chat-modal-nav-next" @onclick="ShowNextImage">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @if (!ChatState.Messages.Any() && !ChatState.IsLoadingMessages)
    {
        <div class="text-center text-muted small py-4">No messages yet. Say hello!</div>
    }
</div>

@code {
    // Absolute URL — see Profile.razor's AvatarUrl for why a relative <img src>
    // 404s (API is on a different origin than the client).
    private string AvatarUrl(Guid userId) => $"{Http.BaseAddress}api/UserProfile/{userId}/avatar/thumb";

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private Guid _pendingDeleteMessageId;
    private Guid? _confirmingDeleteMessageId;
    private bool _isDeletingMessage;
    private Guid? _editingMessageId;
    private string _editDraftText = string.Empty;
    private List<ChatAttachmentDto> _modalAttachmentList = new();
    private ElementReference _modalBackdropRef;
    private int _modalCurrentIndex;
    private Guid? _activeReactionPickerId; // ✅ REPLACES _hoveredMessageId
    private bool _showImageModal;
    private bool _isLoadingModalImage;
    private string? _modalImageSrc;
    private string? _modalFileName;
    private byte[]? _modalAttachmentBytes;
    [Parameter] public Guid CurrentUserId { get; set; }
    private Guid? _hoveredMessageId;
    private bool _reactorsPopupVisible;
    private string _popupReactionType = string.Empty;
    private List<string> _popupReactorNames = new();
    //Reactions
    private const string ReactionLike = "Like";
    private const string ReactionHeart = "Heart";
    private const string ReactionHaha = "Haha";
    private const string ReactionClap = "Clap";
    private const string ReactionWow = "Wow";

    private readonly string _containerId = $"chat-msg-list-{Guid.NewGuid():N}";
    private DotNetObjectReference<ChatMessageList>? _dotNetRef;
    private int _previousMessageCount;
    private Guid? _myLastMessageId;
    private ChatSeenInfoDto? _seenInfo;
    private bool _showFullSeenList;
    private DotNetObjectReference<ChatMessageList>? _pickerDotNetRef;


    protected override void OnInitialized()
    {
        ChatState.OnChange += HandleStateChanged; // ✅ NEW
        ChatState.SeenStatusChangedForRoom += HandleSeenStatusChangedForRoom; // ✅ NEW
    }
    private void RequestDeleteMessage(Guid messageId)
    {
        _confirmingDeleteMessageId = messageId;
        _editingMessageId = null;
    }

    private void CancelDeleteMessage()
    {
        _confirmingDeleteMessageId = null;
    }

    private async Task ConfirmDeleteMessage(Guid messageId)
    {
        try
        {
            _isDeletingMessage = true;
            StateHasChanged();

            await ChatState.DeleteMessageAsync(messageId);
        }
        finally
        {
            _confirmingDeleteMessageId = null;
            _isDeletingMessage = false;
            StateHasChanged();
        }
    }
    private void StartEditing(ChatMessageDto message)
    {
        _editingMessageId = message.Id;
        _editDraftText = message.Content ?? string.Empty;
        _activeReactionPickerId = null; //Close the reaction pciker if it happened to be open.
        _confirmingDeleteMessageId = null;
    }
    private void CancelEditing()
    {
        _editingMessageId = null;
        _editDraftText = string.Empty;
    }
    private async Task SaveEdit(ChatMessageDto message)
    {
        if (string.IsNullOrWhiteSpace(_editDraftText) && !message.Attachments.Any())
            return; // Don't allow saving into an empty, attachment-less messasge

        await ChatState.EditMessageAsync(message.Id, message.RoomId, _editDraftText.Trim());
        _editingMessageId = null;
        _editDraftText = string.Empty;
    }
    private async Task OnEditKeyDown(KeyboardEventArgs e, ChatMessageDto message)
    {
        if(e.Key == "Enter" && !e.ShiftKey)
        {
            await SaveEdit(message);
        }
        else if(e.Key == "Escape")
        {
            CancelEditing();
        }
    }
    private async Task OnModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft")
        {
            await ShowPreviousImage();
        }
        else if (e.Key == "ArrowRight")
        {
            await ShowNextImage();
        }
        else if (e.Key == "Escape")
        {
            CloseImageModal();
        }
    }

    private void ReplyTo(ChatMessageDto message)
    {
        ChatState.SetReplyTarget(message);
    }

    private async Task ScrollToOriginal(Guid messageId)
    {
        await JS.InvokeVoidAsync("chatInterop.scrollToElement", $"msg-{messageId}");
    }

    private void ShowReactorsPopup(Guid messageId, ChatReactionDto reaction)
    {
        _popupReactionType = reaction.Type;
        _popupReactorNames = reaction.ReactorNames;
        _reactorsPopupVisible = true;
    }
    // ✅ NEW
    private async void HandleSeenStatusChangedForRoom(Guid roomId)
    {
        await RefreshSeenInfoAsync();
        await InvokeAsync(StateHasChanged);
    }
    private void CloseReactorsPopup()
    {
        _reactorsPopupVisible = false;
    }
    private async void ToggleReactionPicker(Guid messageId)
    {
        var wasOpenForThisMessage = _activeReactionPickerId == messageId;
        _activeReactionPickerId = wasOpenForThisMessage ? null : messageId;
        StateHasChanged();

        if (_activeReactionPickerId != null)
        {
            _pickerDotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("chatInterop.registerReactionPickerOutsideClick", _pickerDotNetRef);
        }
        else
        {
            await JS.InvokeVoidAsync("chatInterop.unregisterReactionPickerOutsideClick");
        }
    }
    [JSInvokable]
    public void OnReactionPickerOutsideClick()
    {
        if (_activeReactionPickerId != null)
        {
            _activeReactionPickerId = null;
            InvokeAsync(StateHasChanged);
            _ = JS.InvokeVoidAsync("chatInterop.unregisterReactionPickerOutsideClick");
        }
    }

    private async Task AddReaction(ChatMessageDto message, string type)
    {
        var myExisting = message.Reactions.FirstOrDefault(r => r.ReactorUserIds.Contains(CurrentUserId));
        var newType = myExisting?.Type == type ? null : type;

        await ChatState.SetReactionAsync(message.Id, message.RoomId, newType);
        _activeReactionPickerId = null;
        await JS.InvokeVoidAsync("chatInterop.unregisterReactionPickerOutsideClick"); // ✅ NEW
    }
    private async Task ViewFullAttachment(List<ChatAttachmentDto> allAttachments, Guid startAttachmentId)
    {
        _modalAttachmentList = allAttachments.Where(a => a.ContentType.StartsWith("image/")).ToList();
        _modalCurrentIndex = _modalAttachmentList.FindIndex(a => a.Id == startAttachmentId);
        if (_modalCurrentIndex < 0) _modalCurrentIndex = 0;

        _showImageModal = true;
        await LoadModalImageAsync();

        // ✅ NEW — give the modal keyboard focus so ArrowLeft/ArrowRight/Escape work immediately
        await Task.Delay(50); // let the DOM render the backdrop first
        await _modalBackdropRef.FocusAsync();
    }
    private async Task LoadModalImageAsync()
    {
        if (!_modalAttachmentList.Any()) return;

        var attachment = _modalAttachmentList[_modalCurrentIndex];
        _isLoadingModalImage = true;
        _modalFileName = attachment.OriginalFileName;
        _modalImageSrc = null;
        StateHasChanged();

        var result = await ChatState.FetchFullAttachmentAsync(attachment.Id);
        if (result != null)
        {
            _modalAttachmentBytes = result.Value.Data;
            _modalImageSrc = $"data:{result.Value.ContentType};base64,{Convert.ToBase64String(result.Value.Data)}";
        }

        _isLoadingModalImage = false;
        StateHasChanged();
    }
    private async Task ShowPreviousImage()
    {
        if (_modalCurrentIndex > 0)
        {
            _modalCurrentIndex--;
            await LoadModalImageAsync();
        }
    }

    private async Task ShowNextImage()
    {
        if (_modalCurrentIndex < _modalAttachmentList.Count - 1)
        {
            _modalCurrentIndex++;
            await LoadModalImageAsync();
        }
    }

    private void CloseImageModal()
    {
        _showImageModal = false;
        _modalImageSrc = null;
        _modalAttachmentBytes = null;
        _modalAttachmentList = new();
        _modalCurrentIndex = 0;
    }

    private async Task DownloadModalImage()
    {
        if (_modalAttachmentBytes == null || _modalFileName == null) return;
        await JS.InvokeVoidAsync("downloadFile", _modalFileName, Convert.ToBase64String(_modalAttachmentBytes));
    }
    private async Task DownloadPdfAttachment(Guid attachmentId, string fileName)
    {
        var result = await ChatState.FetchFullAttachmentAsync(attachmentId);
        if (result == null) return;

        // ✅ Reuses your existing window.downloadFile helper (already in index.html,
        // same one BeneficiaryRecordsGrid.ExportExcel uses) — no new JS needed.
        await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(result.Value.Data));
    }
    // ✅ NEW
    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string? _previousTypingText;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("chatInterop.registerScrollTop", _containerId, _dotNetRef);
            await JS.InvokeVoidAsync("chatInterop.scrollToBottom", _containerId);
            _previousMessageCount = ChatState.Messages.Count;
            await RefreshSeenInfoAsync();
        }
        else if (ChatState.Messages.Count > _previousMessageCount)
        {
            await JS.InvokeVoidAsync("chatInterop.scrollToBottom", _containerId);
            _previousMessageCount = ChatState.Messages.Count;
            await RefreshSeenInfoAsync();
        }

        // ✅ NEW — auto-scroll when the typing indicator appears or disappears,
        // since it changes the scrollable content's height just like a new
        // message would.
        var currentTypingText = ChatState.ActiveRoom != null
            ? ChatState.GetTypingIndicatorText(ChatState.ActiveRoom.Id)
            : null;

        if (currentTypingText != _previousTypingText)
        {
            _previousTypingText = currentTypingText;

            // Only auto-scroll if the indicator just APPEARED (someone started
            // typing) — not strictly necessary on disappear, but scrolling in
            // both directions keeps the view anchored to "the latest thing"
            // consistently rather than leaving a gap when it goes away.
            await JS.InvokeVoidAsync("chatInterop.scrollToBottom", _containerId);
        }

        if (ChatState.PendingScrollToMessageId.HasValue)
        {
            var targetId = ChatState.PendingScrollToMessageId.Value;
            ChatState.PendingScrollToMessageId = null;
            await JS.InvokeVoidAsync("chatInterop.scrollToElement", $"msg-{targetId}");
        }
    }
    private async Task RefreshSeenInfoAsync()
    {
        var myLastMessage = ChatState.Messages
            .Where(m => m.SenderId == CurrentUserId && !m.IsDeleted)
            .OrderByDescending(m => m.SentAt)
            .FirstOrDefault();

        if (myLastMessage == null || ChatState.ActiveRoom == null)
        {
            _myLastMessageId = null;
            _seenInfo = null;
            return;
        }

        _myLastMessageId = myLastMessage.Id;
        _seenInfo = await ChatState.GetSeenInfoAsync(ChatState.ActiveRoom.Id, myLastMessage.Id, myLastMessage.SentAt);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnScrolledNearTop()
    {
        if (!ChatState.HasMoreHistory || ChatState.IsLoadingMessages) return;

        var previousHeight = await JS.InvokeAsync<int>("chatInterop.getScrollHeight", _containerId);
        await ChatState.LoadOlderMessagesAsync();
        StateHasChanged();

        await Task.Delay(50);
        await JS.InvokeVoidAsync("chatInterop.preserveScrollAfterPrepend", _containerId, previousHeight);
    }
    private static readonly System.Text.RegularExpressions.Regex UrlPattern = new(
    @"(https?://[^\s<]+|www\.[^\s<]+)",
    System.Text.RegularExpressions.RegexOptions.Compiled | System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private MarkupString RenderContentWithMentions(ChatMessageDto message)
    {
        var content = message.Content ?? string.Empty;

        // ✅ Escape FIRST — everything starts as safe, inert text
        var escaped = System.Net.WebUtility.HtmlEncode(content);

        // ✅ Bold @mentions using the message's own structured Mentions list —
        // only text that's an actual recognized mention gets bolded, never
        // just any "@word" the sender happened to type. Matched against the
        // already-escaped text/names so nothing here can reopen the HTML
        // encoding that was just applied above.
        var mentionNames = message.Mentions
            .Select(m => m.IsEveryoneMention ? "everyone" : m.MentionedUserName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase);

        foreach (var name in mentionNames)
        {
            var encodedName = System.Net.WebUtility.HtmlEncode(name);
            var pattern = "@" + System.Text.RegularExpressions.Regex.Escape(encodedName);
            escaped = System.Text.RegularExpressions.Regex.Replace(
                escaped, pattern,
                $"<strong class=\"chat-mention-tag\">@{encodedName}</strong>",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }

        // ✅ THEN replace URL matches with real anchor tags. Since we matched
        // against the escaped string, any "<" or ">" a user typed is already
        // neutralized as &lt;/&gt; and can't break out of the anchor markup.
        var linked = UrlPattern.Replace(escaped, match =>
        {
            var url = match.Value;
            var href = url.StartsWith("www.", StringComparison.OrdinalIgnoreCase) ? $"https://{url}" : url;
            return $"<a href=\"{href}\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"chat-message-link\">{url}</a>";
        });

        return new MarkupString(linked);
    }

    // ✅ CHANGED — unsubscribe added
    public async ValueTask DisposeAsync()
    {
        ChatState.OnChange -= HandleStateChanged;
        ChatState.SeenStatusChangedForRoom -= HandleSeenStatusChangedForRoom;
        _dotNetRef?.Dispose();
        _pickerDotNetRef?.Dispose();
        await JS.InvokeVoidAsync("chatInterop.unregisterReactionPickerOutsideClick");
    }
    private static string FormatDateSeparator(DateTime date)
    {
        var today = DateTime.Today;
        var diff = (today - date).Days;

        return diff switch
        {
            0 => "Today",
            1 => "Yesterday",
            < 7 => date.ToString("dddd"), // "Monday", "Tuesday", etc. for the past week
            _ => date.ToString("MMMM d, yyyy") // "July 3, 2026" for anything older
        };
    }
    private static string GetFileIcon(string contentType) => contentType switch
    {
        "application/pdf" => "bi-file-earmark-pdf-fill text-danger",
        "application/msword" or
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "bi-file-earmark-word-fill text-primary",
        "application/vnd.ms-excel" or
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "bi-file-earmark-excel-fill text-success",
        "application/vnd.ms-powerpoint" or
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" => "bi-file-earmark-ppt-fill text-warning",
        "text/csv" => "bi-file-earmark-spreadsheet-fill text-success",
        "text/plain" => "bi-file-earmark-text-fill text-secondary",
        _ => "bi-file-earmark-fill text-muted"
    };

    private async Task ToggleReaction(ChatMessageDto message, string type)
    {
        // Clicking an existing pill also toggles your own reaction the same way
        await AddReaction(message, type);
    }

    private static string GetReactionEmoji(string type) => type switch
    {
        "Like" => "👍",
        "Heart" => "❤️",
        "Haha" => "😂",
        "Clap" => "👏",
        "Wow" => "😮",
        _ => "👍"
    };
