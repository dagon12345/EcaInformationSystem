    // Pops a blocking, must-acknowledge modal instead of a toast — a toast
    // auto-dismisses after 6s and was easy to miss entirely for a large-file
    // upload failure, which is exactly the "silent failure" this fixes.
    private Task ShowUploadErrorAsync(string message)
    {
        _uploadErrorMessage = message;
        return _uploadErrorModal.ShowAsync();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _shrinkRequired = false;
        _previewResult = null;

        if (e.File.Size > HardCeilingBytes)
        {
            await ShowUploadErrorAsync(
                $"'{e.File.Name}' is {FormatFileSize(e.File.Size)} — the absolute maximum is {FormatFileSize(HardCeilingBytes)}, " +
                "even with shrinking. Please reduce it yourself before uploading.");
            _uploadFile = null;
            return;
        }

        if (e.File.Size > MaxFileSizeBytes)
        {
            if (!ShrinkableContentTypes.Contains(e.File.ContentType))
            {
                await ShowUploadErrorAsync(
                    $"'{e.File.Name}' is {FormatFileSize(e.File.Size)} — the maximum is 10 MB, and this file type " +
                    "can't be automatically shrunk. Please reduce it manually, or save it as a PDF/DOCX/XLSX first.");
                _uploadFile = null;
                return;
            }

            _shrinkRequired = true;
            _shrinkQuality = ShrinkQuality.Medium;
            _uploadFile = e.File;
            await RunShrinkPreviewAsync();
            return;
        }

        _uploadFile = e.File;
    }

    private async Task SetShrinkQualityAsync(ShrinkQuality quality)
    {
        _shrinkQuality = quality;
        await RunShrinkPreviewAsync();
    }

    // Shrinks the file server-side for the currently selected quality and shows
    // the resulting size — without saving anything — so the user can see what
    // they'll get before committing to the upload.
    private async Task RunShrinkPreviewAsync()
    {
        if (_uploadFile == null || !_shrinkRequired) return;

        _previewResult = null;
        _isPreviewingShrink = true;
        StateHasChanged();

        try
        {
            await using var stream = _uploadFile.OpenReadStream(HardCeilingBytes);
            var (success, error, result) = await FormService.PreviewShrinkAsync(
                stream, _uploadFile.Name, _uploadFile.ContentType, _shrinkQuality);

            if (success)
                _previewResult = result;
            else
                toast.ShowError(error ?? "Could not estimate the shrink result.");
        }
        catch (Exception ex)
        {
            toast.ShowError($"Could not estimate the shrink result: {ex.Message}");
        }
        finally
        {
            _isPreviewingShrink = false;
            StateHasChanged();
        }
    }

    private async Task OnReplaceFileSelected(InputFileChangeEventArgs e)
    {
        if (e.File.Size > MaxFileSizeBytes)
        {
            await ShowUploadErrorAsync(
                $"'{e.File.Name}' is {FormatFileSize(e.File.Size)} — the maximum allowed upload size is 10 MB. " +
                "Please choose a smaller file, or compress it before uploading.");
            _replaceFile = null;
            return;
        }
        _replaceFile = e.File;
    }

    private async Task SubmitUploadAsync()
    {
        if (string.IsNullOrWhiteSpace(_uploadTitle))
        {
            toast.ShowError("Title is required.");
            return;
        }
        if (_uploadFile == null)
        {
            toast.ShowError("Please select a file.");
            return;
        }

        if (_shrinkRequired)
        {
            if (_isPreviewingShrink)
            {
                toast.ShowError("Still estimating the shrink result — please wait a moment and try again.");
                return;
            }
            if (_previewResult == null)
            {
                toast.ShowError("Please wait for the shrink estimate before uploading.");
                return;
            }
            if (!_previewResult.MeetsLimit)
            {
                toast.ShowError("This file is still over the 10 MB limit at the selected quality — choose a higher shrinkage level.");
                return;
            }
        }

        _isSaving = true;
        try
        {
            int? payrollQuarter = _uploadPayrollQuarter > 0 ? _uploadPayrollQuarter : null;
            int? fiscalYear = _uploadFiscalYear > 0 ? _uploadFiscalYear : null;
            int? psgcCodeRegion = _uploadPsgcCodeRegion > 0 ? _uploadPsgcCodeRegion : null;
            int? psgcCodeProvince = _uploadPsgcCodeProvince > 0 ? _uploadPsgcCodeProvince : null;
            int? psgcCodeMunicipality = _uploadPsgcCodeMunicipality > 0 ? _uploadPsgcCodeMunicipality : null;

            // A shrink was already previewed — confirm using the cached
            // shrunk bytes by token rather than re-sending/re-shrinking the file.
            if (_shrinkRequired && _previewResult != null)
            {
                var (success, error, document) = await FormService.UploadFromPreviewAsync(
                    _previewResult.PreviewToken, _uploadTitle, _uploadDescription, _uploadCategory, _uploadFolderId,
                    payrollQuarter, fiscalYear, psgcCodeRegion, psgcCodeProvince, psgcCodeMunicipality);

                if (success)
                {
                    toast.ShowSuccess(document?.PreShrinkSizeBytes is long preSize
                        ? $"Form uploaded — shrunk from {FormatFileSize(preSize)} to {FormatFileSize(document.FileSizeBytes)}."
                        : "Form uploaded successfully.");
                    await _uploadModal.HideAsync();
                    await LoadFoldersAsync();
                    await LoadFormsAsync();
                }
                else
                {
                    await ShowUploadErrorAsync(error ?? "Upload failed for an unknown reason. Please try again.");
                }

                return;
            }

            await using var stream = _uploadFile.OpenReadStream(HardCeilingBytes);

            var (success2, error2, document2) = await FormService.UploadAsync(
                stream, _uploadFile.Name, _uploadFile.ContentType,
                _uploadTitle, _uploadDescription, _uploadCategory, _uploadFolderId, null,
                payrollQuarter, fiscalYear, psgcCodeRegion, psgcCodeProvince, psgcCodeMunicipality);

            if (success2)
            {
                toast.ShowSuccess("Form uploaded successfully.");
                await _uploadModal.HideAsync();
                await LoadFoldersAsync();
                await LoadFormsAsync();
            }
            else
            {
                await ShowUploadErrorAsync(error2 ?? "Upload failed for an unknown reason. Please try again.");
            }
        }
        catch (Exception ex)
        {
            // Covers both an IBrowserFile.OpenReadStream size-guard rejection
            // (the file slipped past OnFileSelected's check, e.g. right at the
            // boundary) and a network-level failure (e.g. the connection was
            // reset because the server's own request-size limit kicked in) —
            // previously both were uncaught and failed completely silently.
            await ShowUploadErrorAsync(DescribeUploadException(ex, _uploadFile));
        }
        finally { _isSaving = false; }
    }

    private string DescribeUploadException(Exception ex, IBrowserFile? file)
    {
        var sizeNote = file != null ? $" ('{file.Name}', {FormatFileSize(file.Size)})" : string.Empty;
        return ex switch
        {
            IOException or InvalidOperationException =>
                $"The file{sizeNote} could not be uploaded — it's too large. The maximum allowed size is 10 MB.",
            System.Net.Http.HttpRequestException =>
                $"Upload failed{sizeNote} — the connection was interrupted. This can happen when a file is too large or the network drops mid-upload. Please try again.",
            TaskCanceledException =>
                $"The upload timed out after several minutes{sizeNote}. This can happen with a very large, image-heavy file or a slow connection — please check your connection and try again.",
            _ => $"Upload failed{sizeNote}: {ex.Message}"
        };
    }

