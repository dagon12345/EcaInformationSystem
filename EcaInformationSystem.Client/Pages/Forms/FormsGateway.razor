@page "/forms-gateway"
@attribute [Authorize]
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@inject FormDocumentClientService FormService
@inject FormFolderClientService FolderService
@inject ToastService toast
@inject AuthService AuthService
@inject IJSRuntime JS

<div class="forms-layout">

    @* ── Folder Sidebar ── *@
    <div class="forms-sidebar">
        <div class="forms-sidebar-header">
            <span>Folders</span>
            @if (_hasFullAccess)
            {
                <button class="btn btn-sm btn-link p-0" @onclick="OpenCreateFolderModal" title="New Folder">
                    <i class="bi bi-folder-plus"></i>
                </button>
            }
        </div>

        <div class="forms-folder-item @(_selectedFolderId == null && !_uncategorizedOnly ? "active" : "")"
             @onclick="() => SelectFolder(null, false)">
            <span class="forms-folder-toggle-spacer"></span>
            <i class="bi bi-collection forms-folder-icon"></i>
            <span class="forms-folder-name">All Forms</span>
            <span class="folder-count">@_allCount</span>
        </div>

        <div class="forms-folder-item @(_uncategorizedOnly ? "active" : "")"
             @onclick="() => SelectFolder(null, true)">
            <span class="forms-folder-toggle-spacer"></span>
            <i class="bi bi-inbox forms-folder-icon"></i>
            <span class="forms-folder-name">Uncategorized</span>
            <span class="folder-count">@_uncategorizedCount</span>
        </div>

        <hr class="my-2" />

        @{
            RenderFragment<(FormFolderDto Folder, int Depth)> FolderRow = null!;
            FolderRow = ctx =>
                @<text>
                    @{
                        var children = SubfoldersOf(ctx.Folder.Id).ToList();
                        var hasChildren = children.Count > 0;
                        var isExpanded = IsFolderExpanded(ctx.Folder.Id);
                    }
                    <div class="forms-folder-item @(ctx.Depth > 0 ? "forms-folder-item--sub" : "") @(_selectedFolderId == ctx.Folder.Id ? "active" : "")"
                         style="padding-left:@(8 + ctx.Depth * 16)px;"
                         @onclick="() => SelectFolder(ctx.Folder.Id, false)">
                        @if (hasChildren)
                        {
                            <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right") forms-folder-toggle"
                               @onclick="() => ToggleFolderExpand(ctx.Folder.Id)" @onclick:stopPropagation="true"
                               title="@(isExpanded ? "Hide subfolders" : "Show subfolders")"></i>
                        }
                        else
                        {
                            <span class="forms-folder-toggle-spacer"></span>
                        }
                        <i class="bi @(ctx.Depth == 0 ? "bi-folder-fill" : "bi-folder2") forms-folder-icon"></i>
                        <span class="forms-folder-name text-truncate" title="@ctx.Folder.Name">@ctx.Folder.Name</span>
                        <span class="folder-count">@ctx.Folder.DocumentCount</span>

                        @if (_hasFullAccess)
                        {
                            <div class="folder-actions" @onclick:stopPropagation="true">
                                <i class="bi bi-folder-plus" @onclick="() => OpenCreateSubfolderModal(ctx.Folder)" title="New Subfolder"></i>
                                <i class="bi bi-pencil" @onclick="() => OpenEditFolderModal(ctx.Folder)" title="Rename"></i>
                                <i class="bi bi-trash" @onclick="() => OpenDeleteFolderConfirm(ctx.Folder)" title="Delete"></i>
                            </div>
                        }
                    </div>

                    @if (hasChildren && isExpanded)
                    {
                        @foreach (var child in children)
                        {
                            @FolderRow((child, ctx.Depth + 1))
                        }
                    }
                </text>;
        }

        @foreach (var folder in RootFolders)
        {
            @FolderRow((folder, 0))
        }

        @if (_hasFullAccess)
        {
            <hr class="my-2" />
            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="() => ShowActivityLog()">
                <i class="bi bi-clock-history me-1"></i>Activity Log
            </button>
        }
    </div>

    @* ── Main Panel ── *@
    <div class="forms-main">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <h4 class="mb-0"><i class="bi bi-folder2-open me-2"></i>Forms Gateway</h4>
                <small class="text-muted">@GetCurrentFolderLabel()</small>
            </div>
            @if (_hasFullAccess)
            {
                <button class="sys-btn sys-btn-save" @onclick="OpenUploadModal">
                    <i class="bi bi-cloud-upload me-1"></i>Upload Form
                </button>
            }
        </div>

        <div class="forms-info-banner mb-3">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>About this page.</strong>
                Official NCSC files for download. Accepted file types: PDF, Word (.doc/.docx), Excel (.xls/.xlsx) — max <strong>10 MB</strong> per file.
                @if (_hasFullAccess)
                {
                    <span>You can manage folders and upload, edit, or delete forms here.</span>
                }
                else
                {
                    <span>You have view, search, and download access only.</span>
                }
            </div>
        </div>

        @* ── Search bar ── *@
        <div class="d-flex gap-2 mb-3 align-items-center">
            <div class="forms-search-bar flex-grow-1 mb-0">
                <i class="bi bi-search"></i>
                <input type="text" class="forms-search-input" placeholder="Search by title, description, category, or file name..."
                       value="@_searchTerm" @oninput="OnSearchInput" />
                @if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <button class="forms-search-clear" @onclick="ClearSearch" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>
            <select class="form-select form-select-sm w-auto flex-shrink-0" @bind="_sortBy" @bind:after="ApplyCurrentViewAsync">
                <option value="Date">Sort by Date</option>
                <option value="Name">Sort by Name</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary flex-shrink-0" @onclick="ToggleSortOrder"
                    title="Toggle sort order">
                <i class="bi @(_sortAscending ? "bi-sort-alpha-down" : "bi-sort-alpha-down-alt")"></i>
                @GetSortDirectionLabel()
            </button>
        </div>

        @* ── Subfolder tiles — browse into a subfolder rather than seeing its files mixed in here ── *@
        @if (_selectedFolderId.HasValue && SubfoldersOf(_selectedFolderId.Value).Any())
        {
            <div class="forms-subfolder-tiles mb-3">
                @foreach (var sub in SubfoldersOf(_selectedFolderId.Value))
                {
                    <div class="forms-subfolder-tile" @onclick="() => SelectFolder(sub.Id, false)">
                        <i class="bi bi-folder2"></i>
                        <span class="text-truncate" title="@sub.Name">@sub.Name</span>
                        <span class="folder-count">@sub.DocumentCount</span>
                        <i class="bi bi-chevron-right forms-subfolder-tile-arrow"></i>
                    </div>
                }
            </div>
        }

        @if (_isLoading)
        {
            <div class="text-center py-4">
                <span class="spinner-border text-primary"></span>
            </div>
        }
        else if (!_displayedForms.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-search" style="font-size:28px;"></i>
                <p class="mt-2 mb-0">
                    @(string.IsNullOrWhiteSpace(_searchTerm) ? "No forms in this folder yet." : $"No results for \"{_searchTerm}\".")
                </p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var form in _displayedForms)
                {
                    var visual = GetFileTypeVisual(form.OriginalFileName, form.ContentType);

                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="form-card">
                            <div class="form-card-top">
                                <div class="form-card-icon" style="background:@(visual.Color)1A; color:@visual.Color;">
                                    <i class="bi @visual.Icon"></i>
                                </div>
                                <div class="form-card-typebadge" style="color:@visual.Color; border-color:@(visual.Color)40;">
                                    @visual.Label
                                </div>
                            </div>

                            <div class="form-card-body">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <h6 class="form-card-title" title="@form.Title">@form.Title</h6>
                                    @if (!string.IsNullOrWhiteSpace(form.Category))
                                    {
                                        <span class="badge bg-secondary form-card-category">@form.Category</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(form.Description))
                                {
                                    <p class="form-card-desc">@form.Description</p>
                                }

                                @if (_selectedFolderId == null && !_uncategorizedOnly && !string.IsNullOrWhiteSpace(form.FolderName))
                                {
                                    <div class="form-card-folder-tag">
                                        <i class="bi bi-folder-fill"></i>@form.FolderName
                                    </div>
                                }

                                <div class="form-card-meta">
                                    <div class="form-card-meta-row">
                                        <i class="bi bi-file-earmark-text"></i>
                                        <span class="text-truncate">@form.OriginalFileName</span>
                                    </div>
                                    <div class="form-card-meta-row">
                                        <i class="bi bi-hdd"></i>
                                        <span>File Size</span>
                                        <span class="form-card-size">@FormatFileSize(form.FileSizeBytes)</span>
                                    </div>
                                    <div class="form-card-meta-row">
                                        <i class="bi bi-clock-history"></i>
                                        <span>@form.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy") · @form.UploadedBy</span>
                                    </div>
                                </div>

                                <div class="form-card-actions">
                                    <button class="btn btn-sm btn-primary flex-grow-1" @onclick="() => DownloadAsync(form)"
                                            disabled="@_downloadingFormIds.Contains(form.Id)">
                                        @if (_downloadingFormIds.Contains(form.Id))
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                            <span>Downloading...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-download me-1"></i>
                                            <span>Download</span>
                                        }
                                    </button>

                                    @if (_hasFullAccess)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditModal(form)" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteConfirm(form)" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ── Create/Edit Folder Modal ── *@
<HxModal @ref="_folderModal">
    <HeaderTemplate>
        <h5>
            @(_editingFolder != null ? "Rename Folder" : _folderParentId.HasValue ? $"New Subfolder in \"{_folderParentName}\"" : "New Folder")
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        <div class="mb-2">
            <label class="ff-label">Folder Name <span class="req">*</span></label>
            <input class="ff-input" @bind="_folderNameInput" maxlength="150" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Description</label>
            <textarea class="ff-input" rows="2" @bind="_folderDescriptionInput"></textarea>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _folderModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="SubmitFolderAsync" Disabled="@_isSaving">Save</HxButton>
    </FooterTemplate>
</HxModal>

@* ── Delete Folder Confirm (CAUTION) ── *@
<HxModal @ref="_deleteFolderModal">
    <HeaderTemplate>
        <h5 class="text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Folder</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>
            You're about to delete <strong>@_targetFolder?.Name</strong>.
            @if (_targetFolder?.DocumentCount > 0)
            {
                <span>
                    This folder contains <strong>@_targetFolder.DocumentCount file(s)</strong> —
                    they will <u>not</u> be deleted, but will be moved to <strong>Uncategorized</strong>.
                </span>
            }
            else
            {
                <span>This folder is empty.</span>
            }
            @if (_targetFolder != null && SubfoldersOf(_targetFolder.Id).Any())
            {
                <span>
                    Its <strong>@SubfoldersOf(_targetFolder.Id).Count() subfolder(s)</strong> will
                    <u>not</u> be deleted — they'll be promoted to top-level folders.
                </span>
            }
        </p>
        <p class="text-muted small mb-2">Type the folder name below to confirm.</p>
        <input class="ff-input" @bind="_deleteFolderConfirmText" placeholder="@_targetFolder?.Name" />
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _deleteFolderModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Danger" @onclick="ConfirmDeleteFolderAsync"
                  Disabled="@(_deleteFolderConfirmText != _targetFolder?.Name)">
            <i class="bi bi-trash me-1"></i>Delete Folder
        </HxButton>
    </FooterTemplate>
</HxModal>

@* ── Upload Modal ── *@
<HxModal @ref="_uploadModal">
    <HeaderTemplate><h5>Upload Form</h5></HeaderTemplate>
    <BodyTemplate>
        <div class="mb-2">
            <label class="ff-label">Title <span class="req">*</span></label>
            <input class="ff-input" @bind="_uploadTitle" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Folder</label>
            <select class="ff-input" @bind="_uploadFolderId">
                <option value="">-- Uncategorized --</option>
                @foreach (var entry in FlattenedFolderOptions())
                {
                    <option value="@entry.Folder.Id">@(new string(' ', entry.Depth * 2))@(entry.Depth > 0 ? "— " : "")@entry.Folder.Name</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label class="ff-label">Category</label>
            <input class="ff-input" @bind="_uploadCategory" placeholder="e.g. COE, Liquidation, Payroll" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Description</label>
            <textarea class="ff-input" rows="2" @bind="_uploadDescription"></textarea>
        </div>
        <div class="mb-2">
            <label class="ff-label">File <span class="req">*</span></label>
            <InputFile OnChange="OnFileSelected" class="form-control" />
            <small class="text-muted">PDF, Word, or Excel — max 10 MB.</small>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _uploadModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="SubmitUploadAsync" Disabled="@_isSaving">
            @(_isSaving ? "Uploading..." : "Upload")
        </HxButton>
    </FooterTemplate>
</HxModal>

@* ── Edit Form Metadata Modal ── *@
<HxModal @ref="_editModal">
    <HeaderTemplate><h5>Edit Form</h5></HeaderTemplate>
    <BodyTemplate>
        <div class="mb-2">
            <label class="ff-label">Title <span class="req">*</span></label>
            <input class="ff-input" @bind="_editDto.Title" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Folder</label>
            <select class="ff-input" @bind="_editFolderId">
                <option value="">-- Uncategorized --</option>
                @foreach (var entry in FlattenedFolderOptions())
                {
                    <option value="@entry.Folder.Id">@(new string(' ', entry.Depth * 2))@(entry.Depth > 0 ? "— " : "")@entry.Folder.Name</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label class="ff-label">Category</label>
            <input class="ff-input" @bind="_editDto.Category" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Description</label>
            <textarea class="ff-input" rows="2" @bind="_editDto.Description"></textarea>
        </div>
        <hr />
        <label class="ff-label">Replace File (optional)</label>
        <InputFile OnChange="OnReplaceFileSelected" class="form-control" />
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _editModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="SubmitEditAsync" Disabled="@_isSaving">Save</HxButton>
    </FooterTemplate>
</HxModal>

@* ── Delete Form Confirm ── *@
<HxModal @ref="_deleteModal">
    <HeaderTemplate><h5 class="text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Form</h5></HeaderTemplate>
    <BodyTemplate>
        <p>Delete <strong>@_targetForm?.Title</strong>? This cannot be undone from the UI.</p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _deleteModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Danger" @onclick="ConfirmDeleteAsync">Delete</HxButton>
    </FooterTemplate>
</HxModal>

@* ── Activity Log Modal ── *@
<HxModal @ref="_activityLogModal" Size="ModalSize.Large">
    <HeaderTemplate><h5><i class="bi bi-clock-history me-2"></i>Folder & Form Activity Log</h5></HeaderTemplate>
    <BodyTemplate>
        @if (!_activityLogs.Any())
        {
            <p class="text-muted">No activity recorded yet.</p>
        }
        else
        {
            <div class="table-responsive" style="max-height:60vh;">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Action</th>
                            <th>Target</th>
                            <th>Details</th>
                            <th>By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _activityLogs)
                        {
                            <tr>
                                <td class="text-nowrap small">@log.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                                <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                                <td>@log.TargetName</td>
                                <td class="small text-muted">@log.Details</td>
                                <td class="small">@log.UserName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _activityLogModal.HideAsync()">Close</HxButton>
    </FooterTemplate>
</HxModal>

@code {
    private const long MaxFileSizeBytes = 10 * 1024 * 1024;

    private List<FormFolderDto> _folders = new();
    private List<FormDocumentDto> _displayedForms = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _hasFullAccess;

    private Guid? _selectedFolderId = null;
    private bool _uncategorizedOnly = false;
    private int _allCount = 0;
    private int _uncategorizedCount = 0;

    private string _searchTerm = string.Empty;
    private System.Threading.CancellationTokenSource? _searchDebounceCts;
    private bool _sortAscending = true;
    private string _sortBy = "Date";

    // Folder modals
    private HxModal _folderModal = default!;
    private HxModal _deleteFolderModal = default!;
    private FormFolderDto? _editingFolder;
    private FormFolderDto? _targetFolder;
    private string _folderNameInput = string.Empty;
    private string? _folderDescriptionInput;
    private string _deleteFolderConfirmText = string.Empty;
    private Guid? _folderParentId;
    private string? _folderParentName;

    // ── Folder tree helpers (one level of nesting) ─────────────────────────
    private IEnumerable<FormFolderDto> RootFolders => _folders.Where(f => f.ParentFolderId == null);
    private IEnumerable<FormFolderDto> SubfoldersOf(Guid parentId) => _folders.Where(f => f.ParentFolderId == parentId);

    // Folders whose subfolder list is currently collapsed — expanded by default.
    private readonly HashSet<Guid> _collapsedFolderIds = new();
    private bool IsFolderExpanded(Guid folderId) => !_collapsedFolderIds.Contains(folderId);
    private void ToggleFolderExpand(Guid folderId)
    {
        if (!_collapsedFolderIds.Add(folderId))
            _collapsedFolderIds.Remove(folderId);
    }

    private IEnumerable<(FormFolderDto Folder, int Depth)> FlattenedFolderOptions()
    {
        foreach (var root in RootFolders)
        {
            foreach (var entry in FlattenFolderSubtree(root, 0))
                yield return entry;
        }
    }

    private IEnumerable<(FormFolderDto Folder, int Depth)> FlattenFolderSubtree(FormFolderDto folder, int depth)
    {
        yield return (folder, depth);
        foreach (var child in SubfoldersOf(folder.Id))
        {
            foreach (var entry in FlattenFolderSubtree(child, depth + 1))
                yield return entry;
        }
    }

    // Form modals
    private HxModal _uploadModal = default!;
    private HxModal _editModal = default!;
    private HxModal _deleteModal = default!;
    private HxModal _activityLogModal = default!;

    private string _uploadTitle = string.Empty;
    private string? _uploadCategory;
    private string? _uploadDescription;
    private Guid? _uploadFolderId;
    private IBrowserFile? _uploadFile;

    private FormDocumentDto? _targetForm;
    private FormDocumentUpdateDto _editDto = new();
    private Guid? _editFolderId;
    private IBrowserFile? _replaceFile;

    private List<FormActivityLogDto> _activityLogs = new();
    private readonly HashSet<Guid> _downloadingFormIds = new();

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitAsync();
        _hasFullAccess = AuthService.IsAdmin() || AuthService.IsViewer();
        await LoadFoldersAsync();
        await LoadFormsAsync();
    }

    private async Task LoadFoldersAsync()
    {
        _folders = await FolderService.GetAllAsync();
    }

    private async Task LoadFormsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var allForms = await FormService.GetAllAsync();
        _allCount = allForms.Count;
        _uncategorizedCount = allForms.Count(f => f.FolderId == null);

        await ApplyCurrentViewAsync();
        _isLoading = false;
    }

    private async Task ApplyCurrentViewAsync()
    {
        // Strictly this folder's own files — subfolders are browsed into via
        // their own tile in the main panel, not mixed into the parent's list.
        var filter = new FormDocumentSearchDto
        {
            SearchTerm = _searchTerm,
            FolderId = _selectedFolderId,
            UncategorizedOnly = _uncategorizedOnly,
            SortBy = _sortBy,
            SortAscending = _sortAscending
        };

        _displayedForms = await FormService.SearchAsync(filter);
        StateHasChanged();
    }

    private async Task SelectFolder(Guid? folderId, bool uncategorized)
    {
        _selectedFolderId = folderId;
        _uncategorizedOnly = uncategorized;
        _isLoading = true;
        await ApplyCurrentViewAsync();
        _isLoading = false;
    }

    private string GetCurrentFolderLabel()
    {
        if (_uncategorizedOnly) return "Uncategorized forms";
        if (_selectedFolderId == null) return $"All forms ({_allCount})";
        var f = _folders.FirstOrDefault(x => x.Id == _selectedFolderId);
        return f != null ? $"Folder: {f.Name}" : "Forms";
    }

    // ── Search (debounced) ──────────────────────────────────────────────────
    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;

        _searchDebounceCts?.Cancel();
        _searchDebounceCts = new System.Threading.CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        _ = DebouncedSearchAsync(token);
    }

    private async Task DebouncedSearchAsync(System.Threading.CancellationToken token)
    {
        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;
            await InvokeAsync(async () =>
            {
                await ApplyCurrentViewAsync();
            });
        }
        catch (TaskCanceledException) { }
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await ApplyCurrentViewAsync();
    }

    private async Task ToggleSortOrder()
    {
        _sortAscending = !_sortAscending;
        await ApplyCurrentViewAsync();
    }

    private string GetSortDirectionLabel()
    {
        if (_sortBy == "Name") return _sortAscending ? "A → Z" : "Z → A";
        return _sortAscending ? "Oldest First" : "Newest First";
    }

    // ── Folder CRUD ──────────────────────────────────────────────────────────
    private Task OpenCreateFolderModal()
    {
        _editingFolder = null;
        _folderNameInput = string.Empty;
        _folderDescriptionInput = null;
        _folderParentId = null;
        _folderParentName = null;
        return _folderModal.ShowAsync();
    }

