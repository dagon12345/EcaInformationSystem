@* ── Edit Form Metadata Modal ── *@
<HxModal @ref="_editModal">
    <HeaderTemplate><h5>Edit Form</h5></HeaderTemplate>
    <BodyTemplate>
        <div class="mb-2">
            <label class="ff-label">Title <span class="req">*</span></label>
            <input class="ff-input" @bind="_editDto.Title" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Folder</label>
            <select class="ff-input" @bind="_editFolderId">
                <option value="">-- Uncategorized --</option>
                @foreach (var entry in FlattenedFolderOptions())
                {
                    <option value="@entry.Folder.Id">@(new string(' ', entry.Depth * 2))@(entry.Depth > 0 ? "— " : "")@entry.Folder.Name</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label class="ff-label">Category</label>
            <input class="ff-input" @bind="_editDto.Category" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Description</label>
            <textarea class="ff-input" rows="2" @bind="_editDto.Description"></textarea>
        </div>

        @* ── Payroll link — same tagging as Upload. Setting Quarter+Fiscal Year
             links this file; setting both back to "-- none --" unlinks it. ── *@
        <div class="mb-2 payroll-link-panel">
            <label class="ff-label mb-1">
                <i class="bi bi-link-45deg me-1"></i>Link as Payroll Document <span class="text-muted fw-normal">(optional)</span>
            </label>
            <div class="row g-2">
                <div class="col-4">
                    <select class="ff-input" @bind="_editPayrollQuarter">
                        <option value="0">Quarter</option>
                        <option value="1">Q1</option>
                        <option value="2">Q2</option>
                        <option value="3">Q3</option>
                        <option value="4">Q4</option>
                    </select>
                </div>
                <div class="col-4">
                    <select class="ff-input" @bind="_editFiscalYear">
                        <option value="0">Fiscal Year</option>
                        @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
                <div class="col-4">
                    <select class="ff-input" value="@_editPsgcCodeRegion" @onchange="OnEditRegionChanged">
                        <option value="0">All Regions</option>
                        @foreach (var r in _regions)
                        {
                            <option value="@r.PsgcCodeRegion">@r.Name</option>
                        }
                    </select>
                </div>
            </div>
            @if (_editPsgcCodeRegion > 0)
            {
                <div class="row g-2 mt-1">
                    <div class="col-6">
                        <select class="ff-input" value="@_editPsgcCodeProvince" @onchange="OnEditProvinceChanged"
                                disabled="@_isLoadingEditProvinces">
                            <option value="0">Whole Region (all provinces)</option>
                            @foreach (var p in _editProvinces)
                            {
                                <option value="@p.PsgcCodeProvince">@p.Name</option>
                            }
                        </select>
                        @if (_isLoadingEditProvinces)
                        {
                            <span class="sf-loading-pill"><span class="spinner-border spinner-border-sm"></span> Loading...</span>
                        }
                    </div>
                    <div class="col-6">
                        <select class="ff-input" value="@_editPsgcCodeMunicipality" @onchange="OnEditMunicipalityChanged"
                                disabled="@(_editPsgcCodeProvince == 0 || _isLoadingEditMunicipalities)">
                            <option value="0">Whole Province (all municipalities)</option>
                            @foreach (var m in _editMunicipalities)
                            {
                                <option value="@m.PsgcCodeMunicipality">@m.Name</option>
                            }
                        </select>
                        @if (_isLoadingEditMunicipalities)
                        {
                            <span class="sf-loading-pill"><span class="spinner-border spinner-border-sm"></span> Loading...</span>
                        }
                    </div>
                </div>
            }
            @if (_editPayrollQuarter > 0 && _editFiscalYear > 0)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary mt-1" @onclick="UnlinkPayroll">
                    <i class="bi bi-x-circle me-1"></i>Unlink Payroll
                </button>
            }
            <small class="text-muted d-block mt-1">
                Set Quarter + Fiscal Year to link this file so grantees paid in that period can view it from their payment history.
                Narrow down to Province/Municipality if this file only covers part of a region.
            </small>
        </div>
        <hr />
        <label class="ff-label">Replace File (optional)</label>
        <InputFile OnChange="OnReplaceFileSelected" class="form-control" />
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _editModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="SubmitEditAsync" Disabled="@_isSaving">Save</HxButton>
    </FooterTemplate>
</HxModal>

@* ── Delete Form Confirm ── *@
<HxModal @ref="_deleteModal">
    <HeaderTemplate><h5 class="text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Form</h5></HeaderTemplate>
    <BodyTemplate>
        <p>Delete <strong>@_targetForm?.Title</strong>? This cannot be undone from the UI.</p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _deleteModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Danger" @onclick="ConfirmDeleteAsync">Delete</HxButton>
    </FooterTemplate>
</HxModal>

@* ── Activity Log Modal ── *@
<HxModal @ref="_activityLogModal" Size="ModalSize.Large">
    <HeaderTemplate><h5><i class="bi bi-clock-history me-2"></i>Folder & Form Activity Log</h5></HeaderTemplate>
    <BodyTemplate>
        @if (!_activityLogs.Any())
        {
            <p class="text-muted">No activity recorded yet.</p>
