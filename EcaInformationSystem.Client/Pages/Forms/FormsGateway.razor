    private async Task DownloadAsync(FormDocumentDto form)
    {
        if (!_downloadingFormIds.Add(form.Id)) return;
        StateHasChanged();

        try
        {
            var result = await FormService.DownloadAsync(form.Id, form.OriginalFileName);
            if (result == null)
            {
                toast.ShowError("Could not download the file.");
                return;
            }

            var base64 = Convert.ToBase64String(result.Value.Data);
            await JS.InvokeVoidAsync("downloadFile", result.Value.FileName, base64, result.Value.ContentType);
        }
        finally
        {
            _downloadingFormIds.Remove(form.Id);
            StateHasChanged();
        }
    }

    // View in-browser instead of forcing a download first — fetches the same
    // bytes as Download, but hands them to the browser's native PDF renderer
    // via a blob URL in an iframe rather than saving to disk.
    private async Task PreviewAsync(FormDocumentDto form)
    {
        if (_previewLoadingId.HasValue) return;
        _previewLoadingId = form.Id;
        StateHasChanged();

        try
        {
            var result = await FormService.DownloadAsync(form.Id, form.OriginalFileName);
            if (result == null)
            {
                toast.ShowError("Could not load the preview.");
                return;
            }

            _previewDoc = form;
            _previewZoom = 100;
            StateHasChanged();

            // DotNetStreamReference hands the bytes to JS as a binary stream
            // instead of round-tripping through a base64 string — see
            // createPdfBlobUrlFromStream in index.html for why that matters.
            using var streamRef = new DotNetStreamReference(new MemoryStream(result.Value.Data));
            _previewBlobUrl = await JS.InvokeAsync<string>("createPdfBlobUrlFromStream", streamRef);
        }
        catch (Exception ex)
        {
            toast.ShowError($"Could not load the preview: {ex.Message}");
            _previewDoc = null;
        }
        finally
        {
            _previewLoadingId = null;
            StateHasChanged();
        }
    }

    private async Task ClosePreviewAsync()
    {
        _previewDoc = null;
        var urlToRevoke = _previewBlobUrl;
        _previewBlobUrl = null;
        StateHasChanged();

        if (!string.IsNullOrEmpty(urlToRevoke))
        {
            await Task.Delay(500);
            try { await JS.InvokeVoidAsync("revokeBlobUrl", urlToRevoke); } catch { }
        }
    }

    private void PreviewZoomIn()
    {
        _previewZoom = Math.Min(300, _previewZoom + 25);
    }

    private void PreviewZoomOut()
    {
        _previewZoom = Math.Max(50, _previewZoom - 25);
    }

    private void PreviewZoomReset()
    {
        _previewZoom = 100;
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    private (string Icon, string Color, string Label) GetFileTypeVisual(string fileName, string contentType)
    {
        var ext = System.IO.Path.GetExtension(fileName)?.ToLowerInvariant() ?? string.Empty;

        return ext switch
        {
            ".pdf" => ("bi-filetype-pdf", "#e53e3e", "PDF"),
            ".doc" or ".docx" => ("bi-filetype-docx", "#2b579a", "Word"),
            ".xls" or ".xlsx" => ("bi-filetype-xlsx", "#217346", "Excel"),
            ".ppt" or ".pptx" => ("bi-filetype-pptx", "#d24726", "PowerPoint"),
            ".png" => ("bi-filetype-png", "#8e44ad", "Image"),
            ".jpg" or ".jpeg" => ("bi-filetype-jpg", "#8e44ad", "Image"),
            ".csv" => ("bi-filetype-csv", "#217346", "CSV"),
            ".txt" => ("bi-filetype-txt", "#6b7280", "Text"),
            ".zip" or ".rar" => ("bi-file-earmark-zip", "#b7791f", "Archive"),
            _ => ("bi-file-earmark", "#6b7280", "File")
        };
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.#} {sizes[order]}";
    }
