    private async Task SubmitFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(_folderNameInput))
        {
            toast.ShowError("Folder name is required.");
            return;
        }

        _isSaving = true;
        try
        {
            (bool Success, string? Error) result;

            if (_editingFolder == null)
            {
                result = await FolderService.CreateAsync(new FormFolderCreateDto
                {
                    Name = _folderNameInput,
                    Description = _folderDescriptionInput,
                    ParentFolderId = _folderParentId
                });
            }
            else
            {
                result = await FolderService.UpdateAsync(_editingFolder.Id, new FormFolderUpdateDto
                {
                    Name = _folderNameInput,
                    Description = _folderDescriptionInput
                });
            }

            if (result.Success)
            {
                toast.ShowSuccess(_editingFolder != null ? "Folder renamed."
                    : _folderParentId.HasValue ? "Subfolder created."
                    : "Folder created.");
                await _folderModal.HideAsync();
                await LoadFoldersAsync();
            }
            else
            {
                toast.ShowError(result.Error ?? "Operation failed.");
            }
        }
        finally { _isSaving = false; }
    }

    private Task OpenDeleteFolderConfirm(FormFolderDto folder)
    {
        _targetFolder = folder;
        _deleteFolderConfirmText = string.Empty;
        return _deleteFolderModal.ShowAsync();
    }

    private async Task ConfirmDeleteFolderAsync()
    {
        if (_targetFolder == null) return;

        var (success, affectedCount, error) = await FolderService.DeleteAsync(_targetFolder.Id);
        if (success)
        {
            toast.ShowSuccess(affectedCount > 0
                ? $"Folder deleted. {affectedCount} file(s) moved to Uncategorized."
                : "Folder deleted.");

            if (_selectedFolderId == _targetFolder.Id)
            {
                _selectedFolderId = null;
                _uncategorizedOnly = false;
            }

            await LoadFoldersAsync();
            await LoadFormsAsync();
        }
        else
        {
            toast.ShowError(error ?? "Delete failed.");
        }

        await _deleteFolderModal.HideAsync();
    }

