    private async Task DownloadAsync(FormDocumentDto form)
    {
        if (!_downloadingFormIds.Add(form.Id)) return;
        StateHasChanged();

        try
        {
            var result = await FormService.DownloadAsync(form.Id, form.OriginalFileName);
            if (result == null)
            {
                toast.ShowError("Could not download the file.");
                return;
            }

            var base64 = Convert.ToBase64String(result.Value.Data);
            await JS.InvokeVoidAsync("downloadFile", result.Value.FileName, base64, result.Value.ContentType);
        }
        finally
        {
            _downloadingFormIds.Remove(form.Id);
            StateHasChanged();
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    private (string Icon, string Color, string Label) GetFileTypeVisual(string fileName, string contentType)
    {
        var ext = System.IO.Path.GetExtension(fileName)?.ToLowerInvariant() ?? string.Empty;

        return ext switch
        {
            ".pdf" => ("bi-filetype-pdf", "#e53e3e", "PDF"),
            ".doc" or ".docx" => ("bi-filetype-docx", "#2b579a", "Word"),
            ".xls" or ".xlsx" => ("bi-filetype-xlsx", "#217346", "Excel"),
            ".ppt" or ".pptx" => ("bi-filetype-pptx", "#d24726", "PowerPoint"),
            ".png" => ("bi-filetype-png", "#8e44ad", "Image"),
            ".jpg" or ".jpeg" => ("bi-filetype-jpg", "#8e44ad", "Image"),
            ".csv" => ("bi-filetype-csv", "#217346", "CSV"),
            ".txt" => ("bi-filetype-txt", "#6b7280", "Text"),
            ".zip" or ".rar" => ("bi-file-earmark-zip", "#b7791f", "Archive"),
            _ => ("bi-file-earmark", "#6b7280", "File")
        };
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.#} {sizes[order]}";
    }
