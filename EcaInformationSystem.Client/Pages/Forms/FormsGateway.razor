            }
        </div>
    </div>
}

@code {
    // Final stored-size ceiling — matches the server. HardCeilingBytes is the
    // absolute cutoff before a shrink is even attempted (also server-matched).
    private const long MaxFileSizeBytes = 10 * 1024 * 1024;
    private const long HardCeilingBytes = 50 * 1024 * 1024;

    private static readonly HashSet<string> ShrinkableContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    };

    private List<FormFolderDto> _folders = new();
    private List<FormDocumentDto> _displayedForms = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _hasFullAccess;

    // ── Payroll linking — Region/Province/Municipality lookups for the
    // optional location tags on a payroll document (Forms Gateway itself has
    // no location concept otherwise). Payroll often runs per-municipality
    // even within a single region, hence the full cascade down to Municipality. ──
    private List<RegionLookupDto> _regions = new();
    private record RegionLookupDto(int PsgcCodeRegion, string? Name);
    private record ProvinceLookupDto(int PsgcCodeProvince, string? Name);
    private record MunicipalityLookupDto(int PsgcCodeMunicipality, string? Name);
    private string? GetRegionName(int? psgcCodeRegion) =>
        psgcCodeRegion.HasValue ? _regions.FirstOrDefault(r => r.PsgcCodeRegion == psgcCodeRegion.Value)?.Name : null;
    private readonly Dictionary<int, string?> _provinceNameCache = new();
    private string? GetProvinceName(int? psgcCodeProvince) =>
        psgcCodeProvince.HasValue ? _provinceNameCache.GetValueOrDefault(psgcCodeProvince.Value) : null;
    private readonly Dictionary<int, string?> _municipalityNameCache = new();
    private string? GetMunicipalityName(int? psgcCodeMunicipality) =>
        psgcCodeMunicipality.HasValue ? _municipalityNameCache.GetValueOrDefault(psgcCodeMunicipality.Value) : null;

    // Full location trail for the payroll badge — Region · Province ·
    // Municipality, showing every level that's actually set instead of just
    // the most specific one, so it's clear at a glance exactly how narrow
    // (or broad) this file's coverage is.
    private string GetPayrollLocationLabel(FormDocumentDto form)
    {
        var parts = new List<string>();
        if (GetRegionName(form.PsgcCodeRegion) is { } rn) parts.Add(rn);
        if (GetProvinceName(form.PsgcCodeProvince) is { } pn) parts.Add(pn);
        if (GetMunicipalityName(form.PsgcCodeMunicipality) is { } mn) parts.Add(mn);
        return parts.Count > 0 ? string.Join(" · ", parts) : "All Regions";
    }

    private Guid? _selectedFolderId = null;
    private bool _uncategorizedOnly = false;
    // True only once the user explicitly clicks "All Forms" — the initial/root
    // landing state (all three flags false) instead browses root folder tiles,
    // so navigating here doesn't dump every form in the system onto the page.
    private bool _viewAllForms = false;
    private int _allCount = 0;
    private int _uncategorizedCount = 0;

    // Root-level "browse folders" view: nothing selected, not searching. Shows
    // folder tiles instead of a flat list of every form.
    private bool IsRootBrowse => _selectedFolderId == null && !_uncategorizedOnly
        && !_viewAllForms && string.IsNullOrWhiteSpace(_searchTerm);

    private string _searchTerm = string.Empty;
    private System.Threading.CancellationTokenSource? _searchDebounceCts;
    private bool _sortAscending = true;
    private string _sortBy = "Date";

    // Folder modals
    private HxModal _folderModal = default!;
    private HxModal _deleteFolderModal = default!;
    private FormFolderDto? _editingFolder;
    private FormFolderDto? _targetFolder;
    private string _folderNameInput = string.Empty;
    private string? _folderDescriptionInput;
    private string _deleteFolderConfirmText = string.Empty;
    private Guid? _folderParentId;
    private string? _folderParentName;

    // ── Folder tree helpers (one level of nesting) ─────────────────────────
    private IEnumerable<FormFolderDto> RootFolders => _folders.Where(f => f.ParentFolderId == null);
    private IEnumerable<FormFolderDto> SubfoldersOf(Guid parentId) => _folders.Where(f => f.ParentFolderId == parentId);

    // Folders whose subfolder list is currently expanded — collapsed by default,
    // so a folder tree with many nested subfolders doesn't dump everything open
    // at once (see FormsGateway redesign — deep trees were unreadable expanded).
    private readonly HashSet<Guid> _expandedFolderIds = new();
    private bool IsFolderExpanded(Guid folderId) => _expandedFolderIds.Contains(folderId);
    private void ToggleFolderExpand(Guid folderId)
    {
        if (!_expandedFolderIds.Add(folderId))
            _expandedFolderIds.Remove(folderId);
    }

    // Recursive totals (own files/subfolders + every descendant's) — the API's
    // per-folder DocumentCount is direct-children-only, which read as "0" or
    // misleadingly low for folders whose files all live a level or two down.
    private int GetTotalFileCount(Guid folderId)
    {
        var folder = _folders.FirstOrDefault(f => f.Id == folderId);
        var count = folder?.DocumentCount ?? 0;
        foreach (var child in SubfoldersOf(folderId))
            count += GetTotalFileCount(child.Id);
        return count;
    }

    private int GetTotalSubfolderCount(Guid folderId)
    {
        var children = SubfoldersOf(folderId).ToList();
        var count = children.Count;
        foreach (var child in children)
            count += GetTotalSubfolderCount(child.Id);
        return count;
    }

    private IEnumerable<(FormFolderDto Folder, int Depth)> FlattenedFolderOptions()
    {
        foreach (var root in RootFolders)
        {
            foreach (var entry in FlattenFolderSubtree(root, 0))
                yield return entry;
        }
    }

    private IEnumerable<(FormFolderDto Folder, int Depth)> FlattenFolderSubtree(FormFolderDto folder, int depth)
    {
        yield return (folder, depth);
        foreach (var child in SubfoldersOf(folder.Id))
        {
            foreach (var entry in FlattenFolderSubtree(child, depth + 1))
                yield return entry;
        }
    }

    // Form modals
    private HxModal _uploadModal = default!;
    private HxModal _editModal = default!;
    private HxModal _deleteModal = default!;
    private HxModal _activityLogModal = default!;
    private HxModal _uploadErrorModal = default!;
    private string _uploadErrorMessage = string.Empty;

    private string _uploadTitle = string.Empty;
    private string? _uploadCategory;
    private string? _uploadDescription;
    private Guid? _uploadFolderId;
    private IBrowserFile? _uploadFile;
    private bool _shrinkRequired;
    private ShrinkQuality _shrinkQuality = ShrinkQuality.Medium;
    private bool _isPreviewingShrink;
    private ShrinkPreviewResultDto? _previewResult;
    private int _uploadPayrollQuarter;
    private int _uploadFiscalYear;
    private int _uploadPsgcCodeRegion;
    private int _uploadPsgcCodeProvince;
    private int _uploadPsgcCodeMunicipality;
    private List<ProvinceLookupDto> _uploadProvinces = new();
    private List<MunicipalityLookupDto> _uploadMunicipalities = new();
    private bool _isLoadingUploadProvinces;
    private bool _isLoadingUploadMunicipalities;

    private FormDocumentDto? _targetForm;
    private FormDocumentUpdateDto _editDto = new();
    private Guid? _editFolderId;
    private IBrowserFile? _replaceFile;
    private int _editPayrollQuarter;
    private int _editFiscalYear;
    private int _editPsgcCodeRegion;
    private int _editPsgcCodeProvince;
    private int _editPsgcCodeMunicipality;
    private List<ProvinceLookupDto> _editProvinces = new();
    private List<MunicipalityLookupDto> _editMunicipalities = new();
    private bool _isLoadingEditProvinces;
    private bool _isLoadingEditMunicipalities;

    private List<FormActivityLogDto> _activityLogs = new();
    private readonly HashSet<Guid> _downloadingFormIds = new();

    // ── PDF preview ──────────────────────────────────────────────────────────
    private FormDocumentDto? _previewDoc;
    private string? _previewBlobUrl;
    private int _previewZoom = 100;
    private Guid? _previewLoadingId;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitAsync();
        _hasFullAccess = AuthService.IsAdmin() || AuthService.IsViewer();
        await LoadFoldersAsync();
        await LoadFormsAsync();

        // Loaded for everyone (not just _hasFullAccess) — the payroll location
        // badge on a card needs these names for every viewer, not just admins
        // tagging documents. Province/Municipality caches were previously only
        // populated lazily when the Edit modal happened to touch that specific
        // region/province, so a card's tag would show Region only until an
        // admin reopened Edit on it — loading the full lookup lists up front
        // (same size class as the existing full Region load) fixes that.
        try { _regions = await Http.GetFromJsonAsync<List<RegionLookupDto>>("api/Region") ?? new(); }
        catch (Exception ex) { Console.WriteLine($"Error loading regions: {ex.Message}"); }

        try
        {
            var allProvinces = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>("api/Province") ?? new();
            foreach (var p in allProvinces) _provinceNameCache[p.PsgcCodeProvince] = p.Name;
        }
        catch (Exception ex) { Console.WriteLine($"Error loading provinces: {ex.Message}"); }

        try
        {
            var allMunicipalities = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>("api/Municipality") ?? new();
            foreach (var m in allMunicipalities) _municipalityNameCache[m.PsgcCodeMunicipality] = m.Name;
        }
        catch (Exception ex) { Console.WriteLine($"Error loading municipalities: {ex.Message}"); }
    }

    private async Task LoadFoldersAsync()
    {
        _folders = await FolderService.GetAllAsync();
    }

    private async Task LoadFormsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var allForms = await FormService.GetAllAsync();
        _allCount = allForms.Count;
        _uncategorizedCount = allForms.Count(f => f.FolderId == null);

        await ApplyCurrentViewAsync();
        _isLoading = false;
    }

    private async Task ApplyCurrentViewAsync()
    {
        // Strictly this folder's own files — subfolders are browsed into via
        // their own tile in the main panel, not mixed into the parent's list.
        var filter = new FormDocumentSearchDto
        {
            SearchTerm = _searchTerm,
            FolderId = _selectedFolderId,
            UncategorizedOnly = _uncategorizedOnly,
            SortBy = _sortBy,
            SortAscending = _sortAscending
        };

        _displayedForms = await FormService.SearchAsync(filter);
        StateHasChanged();
    }

    private Task SelectAllForms() => SelectFolder(null, false, viewAll: true);

    private async Task SelectFolder(Guid? folderId, bool uncategorized, bool viewAll = false)
    {
        _selectedFolderId = folderId;
        _uncategorizedOnly = uncategorized;
        _viewAllForms = viewAll;

        if (folderId.HasValue)
        {
            // Auto-expand the selected folder and all its ancestors in the
            // sidebar tree, so its children are immediately visible without an
            // extra chevron click — especially useful when jumping several
            // levels deep at once via the breadcrumb trail above.
            foreach (var ancestor in GetFolderPath(folderId.Value))
                _expandedFolderIds.Add(ancestor.Id);
        }

        _isLoading = true;
        await ApplyCurrentViewAsync();
        _isLoading = false;
    }

    // Root-to-leaf chain of ancestor folders (inclusive of folderId itself) —
    // powers both the breadcrumb trail and the sidebar auto-expand above.
    private List<FormFolderDto> GetFolderPath(Guid folderId)
    {
        var path = new List<FormFolderDto>();
        var current = _folders.FirstOrDefault(f => f.Id == folderId);
        while (current != null)
        {
            path.Insert(0, current);
            current = current.ParentFolderId.HasValue
                ? _folders.FirstOrDefault(f => f.Id == current.ParentFolderId.Value)
                : null;
        }
        return path;
    }

    private string GetCurrentFolderLabel()
    {
        if (_uncategorizedOnly) return "Uncategorized forms";
        if (_viewAllForms) return $"All forms ({_allCount})";
        if (_selectedFolderId == null) return "Browse a folder below, or search across all forms.";
        var f = _folders.FirstOrDefault(x => x.Id == _selectedFolderId);
        return f != null ? $"Folder: {f.Name}" : "Forms";
    }

    // ── Search (debounced) ──────────────────────────────────────────────────
    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;

        _searchDebounceCts?.Cancel();
        _searchDebounceCts = new System.Threading.CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        _ = DebouncedSearchAsync(token);
    }

    private async Task DebouncedSearchAsync(System.Threading.CancellationToken token)
    {
        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;
            await InvokeAsync(async () =>
            {
                await ApplyCurrentViewAsync();
            });
        }
        catch (TaskCanceledException) { }
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await ApplyCurrentViewAsync();
    }

    private async Task ToggleSortOrder()
    {
        _sortAscending = !_sortAscending;
        await ApplyCurrentViewAsync();
    }

    private string GetSortDirectionLabel()
    {
        if (_sortBy == "Name") return _sortAscending ? "A → Z" : "Z → A";
        return _sortAscending ? "Oldest First" : "Newest First";
    }

    // ── Folder CRUD ──────────────────────────────────────────────────────────

    // Mirrors the sidebar's "+" (top-level) / per-row folder-plus icon
    // (subfolder) actions, but reachable from inside the main panel too — so
    // creating a folder doesn't require going back to the sidebar first while
    // browsing several levels deep.
    private Task OpenCreateFolderInCurrentContext()
    {
        if (_selectedFolderId.HasValue && !_uncategorizedOnly)
        {
            var current = _folders.FirstOrDefault(f => f.Id == _selectedFolderId.Value);
            if (current != null)
                return OpenCreateSubfolderModal(current);
        }

        return OpenCreateFolderModal();
    }

    private Task OpenCreateFolderModal()
    {
        _editingFolder = null;
        _folderNameInput = string.Empty;
        _folderDescriptionInput = null;
        _folderParentId = null;
        _folderParentName = null;
        return _folderModal.ShowAsync();
    }

    private Task OpenCreateSubfolderModal(FormFolderDto parent)
    {
        _editingFolder = null;
        _folderNameInput = string.Empty;
        _folderDescriptionInput = null;
        _folderParentId = parent.Id;
        _folderParentName = parent.Name;
        return _folderModal.ShowAsync();
    }

    private Task OpenEditFolderModal(FormFolderDto folder)
    {
        _editingFolder = folder;
        _folderNameInput = folder.Name;
        _folderDescriptionInput = folder.Description;
        _folderParentId = folder.ParentFolderId;
        _folderParentName = null;
        return _folderModal.ShowAsync();
    }

    private async Task SubmitFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(_folderNameInput))
        {
            toast.ShowError("Folder name is required.");
            return;
        }

        _isSaving = true;
        try
        {
            (bool Success, string? Error) result;

            if (_editingFolder == null)
            {
                result = await FolderService.CreateAsync(new FormFolderCreateDto
                {
                    Name = _folderNameInput,
                    Description = _folderDescriptionInput,
                    ParentFolderId = _folderParentId
                });
            }
