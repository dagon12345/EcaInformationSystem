    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _activityLogModal.HideAsync()">Close</HxButton>
    </FooterTemplate>
</HxModal>

@* ── PDF Preview Overlay — view in-browser instead of downloading first.
     Same pattern/CSS as BeneficiaryDocumentUpload's viewer. ── *@
@if (_previewDoc != null)
{
    <div class="doc-viewer-overlay" @onclick="ClosePreviewAsync">
        <div class="doc-viewer-card" @onclick:stopPropagation="true">
            <div class="doc-viewer-toolbar">
                <i class="bi bi-file-earmark-pdf me-1"></i>
                <span class="text-truncate flex-grow-1 small">@_previewDoc.Title</span>

                @if (_previewBlobUrl != null)
                {
                    <div class="doc-viewer-zoom-controls">
                        <button class="doc-viewer-zoom-btn" @onclick="PreviewZoomOut" disabled="@(_previewZoom <= 50)" title="Zoom out">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                        <span class="doc-viewer-zoom-label">@_previewZoom%</span>
                        <button class="doc-viewer-zoom-btn" @onclick="PreviewZoomIn" disabled="@(_previewZoom >= 300)" title="Zoom in">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                        <button class="doc-viewer-zoom-btn" @onclick="PreviewZoomReset" title="Reset zoom">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>
                }

                <HxButton Size="ButtonSize.Small" Color="ThemeColor.None"
                          CssClass="btn-close btn-close-white ms-1"
                          OnClick="ClosePreviewAsync" />
            </div>
            @if (_previewBlobUrl != null)
            {
                <iframe @key="@($"{_previewDoc.Id}-{_previewZoom}")"
                        src="@($"{_previewBlobUrl}#zoom={_previewZoom}")" class="doc-viewer-frame"></iframe>
