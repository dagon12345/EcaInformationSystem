                        @foreach (var log in _activityLogs)
                        {
                            <tr>
                                <td class="text-nowrap small">@log.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                                <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                                <td>@log.TargetName</td>
                                <td class="small text-muted">@log.Details</td>
