    private async Task OpenEditModal(FormDocumentDto form)
    {
        _targetForm = form;
        _editFolderId = form.FolderId;
        _editDto = new FormDocumentUpdateDto
        {
            Title = form.Title,
            Description = form.Description,
            Category = form.Category,
            FolderId = form.FolderId
        };
        _editPayrollQuarter = form.PayrollQuarter ?? 0;
        _editFiscalYear = form.FiscalYear ?? 0;
        _editPsgcCodeRegion = form.PsgcCodeRegion ?? 0;
        _editPsgcCodeProvince = 0;
        _editPsgcCodeMunicipality = 0;
        _editProvinces = new();
        _editMunicipalities = new();
        _replaceFile = null;

        // Re-derive the Province/Municipality cascade selection for an
        // already-tagged file — the entity only stores Region + Municipality
        // (Province is purely a UI cascade step, not persisted), so finding
        // which province the tagged municipality belongs to means checking
        // each of the region's provinces' municipality lists in turn.
        if (_editPsgcCodeRegion > 0)
        {
            _isLoadingEditProvinces = true;
            try
            {
                _editProvinces = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>($"api/Province/by-region/{_editPsgcCodeRegion}") ?? new();
                foreach (var p in _editProvinces) _provinceNameCache[p.PsgcCodeProvince] = p.Name;
            }
            finally { _isLoadingEditProvinces = false; }

            if (form.PsgcCodeMunicipality.HasValue)
            {
                _isLoadingEditMunicipalities = true;
                try
                {
                    foreach (var province in _editProvinces)
                    {
                        var munis = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>($"api/Municipality/by-province/{province.PsgcCodeProvince}") ?? new();
                        foreach (var m in munis) _municipalityNameCache[m.PsgcCodeMunicipality] = m.Name;

                        if (munis.Any(m => m.PsgcCodeMunicipality == form.PsgcCodeMunicipality.Value))
                        {
                            _editPsgcCodeProvince = province.PsgcCodeProvince;
                            _editMunicipalities = munis;
                            _editPsgcCodeMunicipality = form.PsgcCodeMunicipality.Value;
                            break;
                        }
                    }
                }
                finally { _isLoadingEditMunicipalities = false; }
            }
        }

        await _editModal.ShowAsync();
    }

