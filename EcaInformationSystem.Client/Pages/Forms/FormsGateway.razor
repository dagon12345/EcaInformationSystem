@page "/forms-gateway"
@attribute [Authorize]
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@inject FormDocumentClientService FormService
@inject FormFolderClientService FolderService
@inject ToastService toast
@inject AuthService AuthService
@inject IJSRuntime JS
@inject HttpClient Http

<div class="forms-layout">

    @* ── Folder Sidebar ── *@
    <div class="forms-sidebar">
        <div class="forms-sidebar-header">
            <span>Folders</span>
            @if (_hasFullAccess)
            {
                <button class="btn btn-sm btn-link p-0" @onclick="OpenCreateFolderModal" title="New Folder">
                    <i class="bi bi-folder-plus"></i>
                </button>
            }
        </div>

        <div class="forms-folder-item @(_viewAllForms ? "active" : "")"
             @onclick="SelectAllForms">
            <span class="forms-folder-toggle-spacer"></span>
            <i class="bi bi-collection forms-folder-icon"></i>
            <span class="forms-folder-name">All Forms</span>
            <span class="folder-count">@_allCount</span>
        </div>

        <div class="forms-folder-item @(_uncategorizedOnly ? "active" : "")"
             @onclick="() => SelectFolder(null, true)">
            <span class="forms-folder-toggle-spacer"></span>
            <i class="bi bi-inbox forms-folder-icon"></i>
            <span class="forms-folder-name">Uncategorized</span>
            <span class="folder-count">@_uncategorizedCount</span>
        </div>

        <hr class="my-2" />

        @{
            RenderFragment<(FormFolderDto Folder, int Depth)> FolderRow = null!;
            FolderRow = ctx =>
                @<text>
                    @{
                        var children = SubfoldersOf(ctx.Folder.Id).ToList();
                        var hasChildren = children.Count > 0;
                        var isExpanded = IsFolderExpanded(ctx.Folder.Id);
                    }
                    <div class="forms-folder-item @(ctx.Depth > 0 ? "forms-folder-item--sub" : "") @(_selectedFolderId == ctx.Folder.Id ? "active" : "")"
                         style="padding-left:@(8 + ctx.Depth * 16)px;"
                         @onclick="() => SelectFolder(ctx.Folder.Id, false)">
                        @if (hasChildren)
                        {
                            <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right") forms-folder-toggle"
                               @onclick="() => ToggleFolderExpand(ctx.Folder.Id)" @onclick:stopPropagation="true"
                               title="@(isExpanded ? "Hide subfolders" : "Show subfolders")"></i>
                        }
                        else
                        {
                            <span class="forms-folder-toggle-spacer"></span>
                        }
                        <i class="bi @(ctx.Depth == 0 ? "bi-folder-fill" : "bi-folder2") forms-folder-icon"></i>
                        <span class="forms-folder-name text-truncate" title="@ctx.Folder.Name">@ctx.Folder.Name</span>
                        @{
                            var subfolderTotal = GetTotalSubfolderCount(ctx.Folder.Id);
                            var fileTotal = GetTotalFileCount(ctx.Folder.Id);
                        }
                        <span class="folder-count-group">
                            @if (subfolderTotal > 0)
                            {
                                <span class="folder-count-badge" title="@subfolderTotal subfolder(s)">
                                    <i class="bi bi-folder2"></i>@subfolderTotal
                                </span>
                            }
                            <span class="folder-count-badge" title="@fileTotal file(s) (including subfolders)">
                                <i class="bi bi-file-earmark"></i>@fileTotal
                            </span>
                        </span>

                        @if (_hasFullAccess)
                        {
                            <div class="folder-actions" @onclick:stopPropagation="true">
                                <i class="bi bi-folder-plus" @onclick="() => OpenCreateSubfolderModal(ctx.Folder)" title="New Subfolder"></i>
                                <i class="bi bi-pencil" @onclick="() => OpenEditFolderModal(ctx.Folder)" title="Rename"></i>
                                <i class="bi bi-trash" @onclick="() => OpenDeleteFolderConfirm(ctx.Folder)" title="Delete"></i>
                            </div>
                        }
                    </div>

                    @if (hasChildren && isExpanded)
                    {
                        @foreach (var child in children)
                        {
                            @FolderRow((child, ctx.Depth + 1))
                        }
                    }
                </text>;
        }

        @foreach (var folder in RootFolders)
        {
            @FolderRow((folder, 0))
        }

        @if (_hasFullAccess)
        {
            <hr class="my-2" />
            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="() => ShowActivityLog()">
                <i class="bi bi-clock-history me-1"></i>Activity Log
            </button>
        }
    </div>

    @* ── Main Panel ── *@
    <div class="forms-main">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div class="flex-grow-1" style="min-width:0;">
                <h4 class="mb-0"><i class="bi bi-folder2-open me-2"></i>Forms Gateway</h4>
                @if (_selectedFolderId.HasValue && !_uncategorizedOnly)
                {
                    <nav class="forms-breadcrumb" aria-label="Folder path">
                        <span class="forms-breadcrumb-item forms-breadcrumb-root" @onclick="() => SelectFolder(null, false)">
                            <i class="bi bi-house-door-fill"></i>Main
                        </span>
                        @foreach (var crumb in GetFolderPath(_selectedFolderId.Value))
                        {
                            <i class="bi bi-chevron-right forms-breadcrumb-sep"></i>
                            <span class="forms-breadcrumb-item @(crumb.Id == _selectedFolderId ? "active" : "")"
                                  title="@crumb.Name"
                                  @onclick="() => SelectFolder(crumb.Id, false)">
                                @crumb.Name
                            </span>
                        }
                    </nav>
                }
                else
                {
                    <small class="text-muted">@GetCurrentFolderLabel()</small>
                }
            </div>
            @if (_hasFullAccess)
            {
                <div class="d-flex gap-2 flex-shrink-0">
                    <button class="sys-btn sys-btn-outline" @onclick="OpenCreateFolderInCurrentContext">
                        <i class="bi bi-folder-plus me-1"></i>
                        @(_selectedFolderId.HasValue && !_uncategorizedOnly ? "New Subfolder" : "New Folder")
                    </button>
                    <button class="sys-btn sys-btn-save" @onclick="OpenUploadModal">
                        <i class="bi bi-cloud-upload me-1"></i>Upload Form
                    </button>
                </div>
            }
        </div>

        <div class="forms-info-banner mb-3">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>About this page.</strong>
                Official NCSC files for download. Accepted file types: PDF, Word (.doc/.docx), Excel (.xls/.xlsx) — max <strong>10 MB</strong> per file.
                @if (_hasFullAccess)
                {
                    <span>You can manage folders and upload, edit, or delete forms here.</span>
                }
                else
                {
                    <span>You have view, search, and download access only.</span>
                }
            </div>
        </div>

        @* ── Search bar ── *@
        <div class="d-flex gap-2 mb-3 align-items-center">
            <div class="forms-search-bar flex-grow-1 mb-0">
                <i class="bi bi-search"></i>
                <input type="text" class="forms-search-input" placeholder="Search by title, description, category, or file name..."
                       value="@_searchTerm" @oninput="OnSearchInput" />
                @if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <button class="forms-search-clear" @onclick="ClearSearch" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>
            <select class="form-select form-select-sm w-auto flex-shrink-0" @bind="_sortBy" @bind:after="ApplyCurrentViewAsync">
                <option value="Date">Sort by Date</option>
                <option value="Name">Sort by Name</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary flex-shrink-0" @onclick="ToggleSortOrder"
                    title="Toggle sort order">
                <i class="bi @(_sortAscending ? "bi-sort-alpha-down" : "bi-sort-alpha-down-alt")"></i>
                @GetSortDirectionLabel()
            </button>
        </div>

        @* ── Subfolder tiles — browse into a subfolder rather than seeing its files mixed in here.
             At the root (nothing selected, not searching), this browses the top-level folders instead
             of dumping every form in the system onto the page. ── *@
        @{
            var tileFolders = _selectedFolderId.HasValue ? SubfoldersOf(_selectedFolderId.Value) : RootFolders;
            var showTiles = _selectedFolderId.HasValue
                ? !_uncategorizedOnly
                : IsRootBrowse;
        }
        @if (showTiles && tileFolders.Any())
        {
            <div class="forms-subfolder-tiles mb-3">
                @foreach (var sub in tileFolders)
                {
                    var subSubfolderTotal = GetTotalSubfolderCount(sub.Id);
                    var subFileTotal = GetTotalFileCount(sub.Id);

                    <div class="forms-subfolder-tile" @onclick="() => SelectFolder(sub.Id, false)">
                        <i class="bi bi-folder2"></i>
                        <span class="text-truncate" title="@sub.Name">@sub.Name</span>
                        <span class="folder-count-group">
                            @if (subSubfolderTotal > 0)
                            {
                                <span class="folder-count-badge" title="@subSubfolderTotal subfolder(s)">
                                    <i class="bi bi-folder2"></i>@subSubfolderTotal
                                </span>
                            }
                            <span class="folder-count-badge" title="@subFileTotal file(s) (including subfolders)">
                                <i class="bi bi-file-earmark"></i>@subFileTotal
                            </span>
                        </span>
                        <i class="bi bi-chevron-right forms-subfolder-tile-arrow"></i>
                    </div>
                }
            </div>
        }

        @if (IsRootBrowse)
        {
            @if (!tileFolders.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-folder2-open" style="font-size:28px;"></i>
                    <p class="mt-2 mb-0">No folders yet — create one, or search across all forms above.</p>
                </div>
            }
        }
        else if (_isLoading)
        {
            <div class="text-center py-4">
                <span class="spinner-border text-primary"></span>
            </div>
        }
        else if (!_displayedForms.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-search" style="font-size:28px;"></i>
                <p class="mt-2 mb-0">
                    @(string.IsNullOrWhiteSpace(_searchTerm) ? "No forms in this folder yet." : $"No results for \"{_searchTerm}\".")
                </p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var form in _displayedForms)
                {
                    var visual = GetFileTypeVisual(form.OriginalFileName, form.ContentType);

                    var isPayroll = form.PayrollQuarter.HasValue && form.FiscalYear.HasValue;

                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="form-card @(isPayroll ? "form-card--payroll" : "")" style="border-left-color:@visual.Color;">
                            @if (isPayroll)
                            {
                                <div class="form-card-payroll-ribbon" title="Linked as a payroll document — grantees paid in this period can view it from their payment history">
                                    <i class="bi bi-link-45deg"></i>PAYROLL
                                </div>
                            }
                            <div class="form-card-top">
                                <div class="form-card-icon" style="background:@(visual.Color)1A; color:@visual.Color;">
                                    <i class="bi @visual.Icon"></i>
                                </div>
                                <div class="form-card-typebadge" style="color:@visual.Color; border-color:@(visual.Color)40;">
                                    @visual.Label
                                </div>
                            </div>

                            <div class="form-card-body">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <h6 class="form-card-title" title="@form.Title">@form.Title</h6>
                                    @if (!string.IsNullOrWhiteSpace(form.Category))
                                    {
                                        <span class="badge bg-secondary form-card-category">@form.Category</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(form.Description))
                                {
                                    <p class="form-card-desc">@form.Description</p>
                                }

                                @if (_selectedFolderId == null && !_uncategorizedOnly && !string.IsNullOrWhiteSpace(form.FolderName))
                                {
                                    <div class="form-card-folder-tag">
                                        <i class="bi bi-folder-fill"></i>@form.FolderName
                                    </div>
                                }

                                @if (isPayroll)
                                {
                                    <div class="form-card-payroll-tag" title="Linked as a payroll document — grantees paid in this period can view it from their payment history">
                                        <i class="bi bi-calendar-check-fill"></i>
                                        Q@(form.PayrollQuarter) @form.FiscalYear · @GetPayrollLocationLabel(form)
                                    </div>
                                }

                                <div class="form-card-meta">
                                    <div class="form-card-meta-row">
                                        <i class="bi bi-file-earmark-text"></i>
                                        <span class="text-truncate">@form.OriginalFileName</span>
                                    </div>
                                    <div class="form-card-meta-row">
                                        <i class="bi bi-hdd"></i>
                                        <span>File Size</span>
                                        <span class="form-card-size">@FormatFileSize(form.FileSizeBytes)</span>
                                    </div>
                                    <div class="form-card-meta-row">
                                        <i class="bi bi-clock-history"></i>
                                        <span>@form.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy") · @form.UploadedBy</span>
                                    </div>
                                </div>

                                <div class="form-card-actions">
                                    @if (form.ContentType == "application/pdf")
                                    {
                                        <button class="btn btn-sm btn-outline-primary flex-grow-1" @onclick="() => PreviewAsync(form)"
                                                disabled="@(_previewLoadingId == form.Id)">
                                            @if (_previewLoadingId == form.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>Opening...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-eye me-1"></i>
                                                <span>Preview</span>
                                            }
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-primary flex-grow-1" @onclick="() => DownloadAsync(form)"
                                            disabled="@_downloadingFormIds.Contains(form.Id)">
                                        @if (_downloadingFormIds.Contains(form.Id))
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                            <span>Downloading...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-download me-1"></i>
                                            <span>Download</span>
                                        }
                                    </button>

                                    @if (_hasFullAccess)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditModal(form)" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteConfirm(form)" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ── Create/Edit Folder Modal ── *@
<HxModal @ref="_folderModal">
    <HeaderTemplate>
        <h5>
            @(_editingFolder != null ? "Rename Folder" : _folderParentId.HasValue ? $"New Subfolder in \"{_folderParentName}\"" : "New Folder")
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        <div class="mb-2">
            <label class="ff-label">Folder Name <span class="req">*</span></label>
            <input class="ff-input" @bind="_folderNameInput" maxlength="150" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Description</label>
            <textarea class="ff-input" rows="2" @bind="_folderDescriptionInput"></textarea>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _folderModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="SubmitFolderAsync" Disabled="@_isSaving">Save</HxButton>
    </FooterTemplate>
</HxModal>

@* ── Delete Folder Confirm (CAUTION) ── *@
<HxModal @ref="_deleteFolderModal">
    <HeaderTemplate>
        <h5 class="text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Folder</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>
            You're about to delete <strong>@_targetFolder?.Name</strong>.
            @if (_targetFolder?.DocumentCount > 0)
            {
                <span>
                    This folder contains <strong>@_targetFolder.DocumentCount file(s)</strong> —
                    they will <u>not</u> be deleted, but will be moved to <strong>Uncategorized</strong>.
                </span>
            }
            else
            {
                <span>This folder is empty.</span>
            }
            @if (_targetFolder != null && SubfoldersOf(_targetFolder.Id).Any())
            {
                <span>
                    Its <strong>@SubfoldersOf(_targetFolder.Id).Count() subfolder(s)</strong> will
                    <u>not</u> be deleted — they'll be promoted to top-level folders.
                </span>
            }
        </p>
        <p class="text-muted small mb-2">Type the folder name below to confirm.</p>
        <input class="ff-input" @bind="_deleteFolderConfirmText" placeholder="@_targetFolder?.Name" />
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _deleteFolderModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Danger" @onclick="ConfirmDeleteFolderAsync"
                  Disabled="@(_deleteFolderConfirmText != _targetFolder?.Name)">
            <i class="bi bi-trash me-1"></i>Delete Folder
        </HxButton>
    </FooterTemplate>
</HxModal>

@* ── Upload Modal ── *@
<HxModal @ref="_uploadModal">
    <HeaderTemplate><h5>Upload Form</h5></HeaderTemplate>
    <BodyTemplate>
        <div class="mb-2">
            <label class="ff-label">Title <span class="req">*</span></label>
            <input class="ff-input" @bind="_uploadTitle" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Folder</label>
            <select class="ff-input" @bind="_uploadFolderId">
                <option value="">-- Uncategorized --</option>
                @foreach (var entry in FlattenedFolderOptions())
                {
                    <option value="@entry.Folder.Id">@(new string(' ', entry.Depth * 2))@(entry.Depth > 0 ? "— " : "")@entry.Folder.Name</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label class="ff-label">Category</label>
            <input class="ff-input" @bind="_uploadCategory" placeholder="e.g. COE, Liquidation, Payroll" />
        </div>
        <div class="mb-2">
            <label class="ff-label">Description</label>
            <textarea class="ff-input" rows="2" @bind="_uploadDescription"></textarea>
        </div>

        @* ── Payroll link — tagging a PDF here is what makes it show up as
             "View Payroll" on matching grantees' payment history rows. ── *@
        <div class="mb-2 payroll-link-panel">
            <label class="ff-label mb-1">
                <i class="bi bi-link-45deg me-1"></i>Link as Payroll Document <span class="text-muted fw-normal">(optional)</span>
            </label>
            <div class="row g-2">
                <div class="col-4">
                    <select class="ff-input" @bind="_uploadPayrollQuarter">
                        <option value="0">Quarter</option>
                        <option value="1">Q1</option>
                        <option value="2">Q2</option>
                        <option value="3">Q3</option>
                        <option value="4">Q4</option>
                    </select>
                </div>
                <div class="col-4">
                    <select class="ff-input" @bind="_uploadFiscalYear">
                        <option value="0">Fiscal Year</option>
                        @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
                <div class="col-4">
                    <select class="ff-input" value="@_uploadPsgcCodeRegion" @onchange="OnUploadRegionChanged">
                        <option value="0">All Regions</option>
                        @foreach (var r in _regions)
                        {
                            <option value="@r.PsgcCodeRegion">@r.Name</option>
                        }
                    </select>
                </div>
            </div>
            @if (_uploadPsgcCodeRegion > 0)
            {
                <div class="row g-2 mt-1">
                    <div class="col-6">
                        <select class="ff-input" value="@_uploadPsgcCodeProvince" @onchange="OnUploadProvinceChanged"
                                disabled="@_isLoadingUploadProvinces">
                            <option value="0">Whole Region (all provinces)</option>
                            @foreach (var p in _uploadProvinces)
                            {
                                <option value="@p.PsgcCodeProvince">@p.Name</option>
                            }
                        </select>
                        @if (_isLoadingUploadProvinces)
                        {
                            <span class="sf-loading-pill"><span class="spinner-border spinner-border-sm"></span> Loading...</span>
                        }
                    </div>
                    <div class="col-6">
                        <select class="ff-input" value="@_uploadPsgcCodeMunicipality" @onchange="OnUploadMunicipalityChanged"
                                disabled="@(_uploadPsgcCodeProvince == 0 || _isLoadingUploadMunicipalities)">
                            <option value="0">Whole Province (all municipalities)</option>
                            @foreach (var m in _uploadMunicipalities)
                            {
                                <option value="@m.PsgcCodeMunicipality">@m.Name</option>
                            }
                        </select>
                        @if (_isLoadingUploadMunicipalities)
                        {
                            <span class="sf-loading-pill"><span class="spinner-border spinner-border-sm"></span> Loading...</span>
                        }
                    </div>
                </div>
            }
            <small class="text-muted d-block mt-1">
                Set Quarter + Fiscal Year to link this file so grantees paid in that period can view it from their payment history.
                Leave Region as "All Regions" unless this file only applies to one region — payroll is often run per
                municipality, so narrow it down to Province/Municipality if this file only covers part of a region.
            </small>
        </div>

        <div class="mb-2">
            <label class="ff-label">File <span class="req">*</span></label>
            <InputFile OnChange="OnFileSelected" class="form-control" />
            <small class="text-muted">
                PDF, Word, or Excel — up to 10 MB. Larger PDF/DOCX/XLSX files (up to 50 MB) can be
                automatically shrunk below 10 MB; other file types over 10 MB can't be.
                Shrinking a large, image-heavy file can take a few minutes — please keep this tab open until it finishes.
            </small>
        </div>

        @if (_shrinkRequired && _uploadFile != null)
        {
            <div class="shrink-quality-panel">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-arrows-angle-contract text-warning"></i>
                    <strong>'@_uploadFile.Name' is @FormatFileSize(_uploadFile.Size) — over the 10 MB limit.</strong>
                </div>
                <p class="text-muted small mb-2">
                    Choose how much to shrink it before uploading. Higher shrinkage means a smaller
                    file but lower quality; lower shrinkage keeps more quality but reduces the size less.
                </p>
                <label class="shrink-quality-option">
                    <input type="radio" name="shrinkQuality" checked="@(_shrinkQuality == ShrinkQuality.High)"
                           @onchange="() => SetShrinkQualityAsync(ShrinkQuality.High)" />
                    <span><strong>High shrinkage</strong> — smallest file, lowest quality. Best when the file just needs to fit.</span>
                </label>
                <label class="shrink-quality-option">
                    <input type="radio" name="shrinkQuality" checked="@(_shrinkQuality == ShrinkQuality.Medium)"
                           @onchange="() => SetShrinkQualityAsync(ShrinkQuality.Medium)" />
                    <span><strong>Medium shrinkage</strong> — balanced size and quality. Recommended for most files.</span>
                </label>
                <label class="shrink-quality-option">
                    <input type="radio" name="shrinkQuality" checked="@(_shrinkQuality == ShrinkQuality.Low)"
                           @onchange="() => SetShrinkQualityAsync(ShrinkQuality.Low)" />
                    <span><strong>Low shrinkage</strong> — best quality, smallest reduction in size.</span>
                </label>

                <div class="shrink-preview-result">
                    @if (_isPreviewingShrink)
                    {
                        <span class="text-muted">
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            Compressing and estimating result — this can take a few minutes for large files, please wait...
                        </span>
                    }
                    else if (_previewResult != null)
                    {
                        @if (_previewResult.MeetsLimit)
                        {
                            <span class="text-success">
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Estimated result: <strong>@FormatFileSize(_previewResult.ShrunkSizeBytes)</strong>
                                (from @FormatFileSize(_previewResult.OriginalSizeBytes)) — fits under 10 MB.
                            </span>
                        }
                        else
                        {
                            <span class="text-danger">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Estimated result: <strong>@FormatFileSize(_previewResult.ShrunkSizeBytes)</strong> —
                                still over 10 MB at this quality. Try a higher shrinkage level.
                            </span>
                        }
                    }
                </div>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _uploadModal.HideAsync()">Cancel</HxButton>
        <HxButton Color="ThemeColor.Primary" @onclick="SubmitUploadAsync" Disabled="@(_isSaving || _isPreviewingShrink)">
            @(_isSaving ? "Uploading..." : "Upload")
        </HxButton>
    </FooterTemplate>
</HxModal>

@* ── Upload/Replace Error Modal — blocking dialog so a failed upload (e.g.
