@page "/system-updates"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs.SystemUpdate
@using System.Net.Http.Json
@inject AuthService AuthService
@inject HttpClient Http
@inject ToastService Toast
@inject SystemUpdateClientService SystemUpdateClient
@inject IJSRuntime JS

<PageTitle>System Updates</PageTitle>

<div class="container-fluid py-3">

    <div class="page-header-bar mb-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <div class="page-header-icon">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <div>
                <h5 class="page-header-title">System Updates</h5>
                <span class="page-header-sub">
                    @(_authorized
                        ? "Publish a release note — it's pushed live to everyone currently in the app."
                        : "Every release note published so far, with the date and time each one went live.")
                </span>
            </div>
        </div>
        <button class="btn btn-outline-primary btn-sm" disabled="@_refreshing" @onclick="SyncRefreshAsync"
                title="Reload to sync the latest changes">
            <i class="bi bi-arrow-clockwise me-1 @(_refreshing ? "spin" : "")"></i>
            @(_refreshing ? "Syncing..." : "Refresh")
        </button>
    </div>

    @* Read-only for everyone else — the release history and its Word summary
       are readable by any signed-in user (the API's notice feed has always
       been), so only the publish form is gated to Super Administrators. *@
    <div class="row g-3">
        @if (_authorized)
        {
            <div class="col-md-5">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light"><strong>Publish New Update</strong></div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="form-label small">
                                Version
                                <span class="text-muted">(auto-suggested — edit to override)</span>
                            </label>
                            <input class="form-control form-control-sm" placeholder="e.g. 1.4.0" @bind="_version" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Title</label>
                            <input class="form-control form-control-sm" placeholder="e.g. Application Tracking improvements" @bind="_title" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Changes (one per line)</label>
                            <textarea class="form-control form-control-sm" rows="6" placeholder="Fixed X&#10;Added Y&#10;Improved Z" @bind="_changes"></textarea>
                        </div>
                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <div class="alert alert-danger py-1 small">@_error</div>
                        }
                        <button class="btn btn-primary btn-sm" disabled="@_publishing" @onclick="Publish">
                            @if (_publishing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Publish &amp; Notify Everyone
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-@(_authorized ? "7" : "12")">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <strong>Update History</strong>
                    <button class="btn btn-outline-primary btn-sm"
                            disabled="@(_downloadingWord || _history is null || _history.Count == 0)"
                            @onclick="DownloadSummaryWordAsync"
                            title="Download a Word summary of every update — with the date and time each one was published">
                        @if (_downloadingWord)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-word me-1"></i>
                        }
                        Download Summary (Word)
                    </button>
                </div>
                <div class="list-group list-group-flush" style="max-height:500px; overflow-y:auto;">
                    @if (_history is null)
                    {
                        <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    }
                    else if (_history.Count == 0)
                    {
                        <div class="p-3 text-muted small">No updates published yet.</div>
                    }
                    else
                    {
                        @foreach (var notice in _history)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <strong>@notice.Title</strong>
                                    <span class="badge bg-secondary">v@(notice.Version)</span>
                                </div>
                                <div class="small text-muted mb-1">
                                    @notice.PublishedByName · @notice.PublishedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                </div>
                                @foreach (var line in notice.Changes.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <div class="small">• @line</div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _authorized;
    private bool _publishing;
    private bool _refreshing;
    private bool _downloadingWord;
    private string? _error;
    private string _version = string.Empty;
    private string _title = string.Empty;
    private string _changes = string.Empty;
    private List<SystemUpdateNoticeDto>? _history;

    private async Task SyncRefreshAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        StateHasChanged();

        // Acknowledge the latest published notice (if any) so the bell/banner
        // don't immediately flag it again right after this same refresh.
        var latest = _history?.FirstOrDefault();
        if (latest != null)
            await SystemUpdateClient.AcknowledgeAsync(latest.Version);

        // Brief pause so the spin is actually visible before the page tears down.
        await Task.Delay(350);
        // syncReload — a plain reload is enough now that index.html/blazor.boot.json
        // are served no-cache (see wwwroot/web.config), so it always picks up the
        // new deploy without re-downloading the whole runtime. Works the same on
        // mobile browsers, unlike the old hardReload's forced cache-storage wipe.
        await JS.InvokeVoidAsync("syncReload");
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitAsync();
        _authorized = AuthService.IsSuperAdmin();

        // History is loaded for everyone (it drives the read-only view and the
        // Download Summary button); the suggested next version is admin-only.
        await LoadHistoryAsync();

        if (_authorized)
            await LoadNextVersionAsync();
    }

    private async Task LoadNextVersionAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<NextVersionResponse>("api/system-updates/next-version");
            if (result != null && string.IsNullOrWhiteSpace(_version))
                _version = result.Version;
        }
        catch
        {
            // Non-fatal — the admin can still type a version in manually.
        }
    }

    private class NextVersionResponse
    {
        public string Version { get; set; } = string.Empty;
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            _history = await Http.GetFromJsonAsync<List<SystemUpdateNoticeDto>>("api/system-updates") ?? new();
        }
        catch
        {
            _history = new();
        }
    }

    private async Task DownloadSummaryWordAsync()
    {
        if (_downloadingWord) return;
        _downloadingWord = true;
        StateHasChanged();

        try
        {
            // Shared with the bell dropdown — an <a href> can't carry the
            // bearer token, so the service hands it to triggerFileDownload
            // (wwwroot/index.html) which fetches the file as a blob.
            await SystemUpdateClient.DownloadSummaryWordAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to download the summary: {ex.Message}", "System Update");
        }
        finally
        {
            _downloadingWord = false;
            StateHasChanged();
        }
    }

    private async Task Publish()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_version) || string.IsNullOrWhiteSpace(_title))
        {
            _error = "Version and title are required.";
            return;
        }

        _publishing = true;
        try
        {
            var dto = new CreateSystemUpdateNoticeDto
            {
                Version = _version.Trim(),
                Title = _title.Trim(),
                Changes = _changes.Trim()
            };

            var response = await Http.PostAsJsonAsync("api/system-updates", dto);
            if (!response.IsSuccessStatusCode)
            {
                _error = await response.Content.ReadAsStringAsync();
                return;
            }

            Toast.ShowSuccess("Update published and broadcast to all connected users.", "System Update");
            _version = string.Empty;
            _title = string.Empty;
            _changes = string.Empty;
            await LoadHistoryAsync();
            await LoadNextVersionAsync();
        }
        finally
        {
            _publishing = false;
        }
    }
}
