@page "/register"
@attribute [AllowAnonymous]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs.Auth
@using Microsoft.AspNetCore.Authorization
@inject AuthService AuthService  // replace @inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Register — ECA-InFORMS Caraga</PageTitle>

<style>
    .register-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #042C53;
        padding: 24px;
        overflow-y: auto; /* ✅ explicit scroll permission */
    }

    .register-card {
        display: flex;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0,0,0,0.35);
        width: 780px;
        max-width: 98vw;
    }

    .register-left {
        width: 220px;
        flex-shrink: 0;
        background: #0C447C;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 24px;
        position: relative;
    }

    .register-right {
        flex: 1;
        background: #fff;
        padding: 40px 44px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .register-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px 20px;
        margin-bottom: 4px;
    }

    @@media (max-width: 640px) {
        .register-wrapper {
            display: block; /* ✅ abandon flex centering entirely on mobile */
            min-height: 100vh;
            height: auto;
            padding: 16px 12px;
            overflow-y: visible;
        }

        .register-card {
            display: block; /* ✅ no flex row/column fighting — just stack naturally */
            width: 100%;
            box-shadow: none;
        }

        .register-left {
            width: 100%;
            padding: 24px 16px;
        }

        .register-right {
            width: 100%;
            padding: 24px 20px;
            display: block;
        }

        .register-grid {
            display: block; /* ✅ each field its own full-width block, no grid */
        }

            .register-grid > div {
                margin-bottom: 14px;
            }
    }
</style>

<div class="register-wrapper">
    <div class="register-card">

        <div class="register-left">
            <div style="position: absolute; bottom: 0; left: 0; width: 100%; height: 160px; background: #185FA5; border-radius: 0 80px 0 0;"></div>
            <div style="position: relative; z-index: 1; text-align: center;">
                <img src="images/ncsc-seal.png" alt="NCSC"
                     style="width: 80px; height: 80px; border-radius: 50%; border: 3px solid #85B7EB; object-fit: cover; margin-bottom: 16px; background: white;"
                     onerror="this.style.display='none'" />
                <div style="font-size: 26px; font-weight: 700; color: #fff; letter-spacing: 1px;">ECA-InFORMS</div>
                <div style="font-size: 11px; color: #85B7EB; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 16px;">Caraga Region</div>
                <div style="width: 36px; height: 2px; background: #378ADD; margin: 0 auto 14px; border-radius: 2px;"></div>
                <p style="font-size: 11px; color: #B5D4F4; line-height: 1.7; max-width: 170px;">
                    Expanded Centenarian Act - Integrated Financial, Operations, Reporting and Monitoring System
                </p>
                <div style="display: flex; gap: 6px; justify-content: center; margin-top: 18px; flex-wrap: wrap;">
                    <span style="font-size: 10px; padding: 3px 8px; border-radius: 20px; border: 0.5px solid #378ADD; color: #B5D4F4;">NCSC</span>
                    <span style="font-size: 10px; padding: 3px 8px; border-radius: 20px; border: 0.5px solid #378ADD; color: #B5D4F4;">Region XIII</span>
                </div>
            </div>
        </div>

        <div class="register-right">
            <p style="font-size: 11px; letter-spacing: 2px; color: #378ADD; text-transform: uppercase; font-weight: 600; margin-bottom: 6px;">Internal account</p>
            <h2 style="font-size: 20px; font-weight: 700; color: #1a1a1a; margin-bottom: 4px;">Create your account</h2>
            <p style="font-size: 13px; color: #6b7280; margin-bottom: 20px;">Register to access the ECA-InFORMS Caraga Information System</p>

            <div style="background: #E6F1FB; border: 0.5px solid #85B7EB; color: #0C447C; padding: 10px 14px; border-radius: 8px; font-size: 12px; margin-bottom: 20px; line-height: 1.5;">
                Your account will require <strong>administrator approval</strong> before you can log in.
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div style="padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 18px;
                    background: @(IsSuccess ? "#f0fdf4" : "#fef2f2");
                    border: 0.5px solid @(IsSuccess ? "#86efac" : "#fca5a5");
                    color: @(IsSuccess ? "#166534" : "#991b1b");">
                    @Message
                </div>
            }

            <EditForm Model="model" OnValidSubmit="HandleRegisterAsync">
                <DataAnnotationsValidator />

                <p style="font-size: 11px; font-weight: 600; color: #378ADD; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 0.5px solid #e5e7eb;">Personal information</p>

                <div class="register-grid">
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px;">Full name</label>
                        <InputText @bind-Value="model.FullName" placeholder="Juan dela Cruz"
                                   style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; outline: none;" />
                        <ValidationMessage For="@(() => model.FullName)" style="font-size: 11px; color: #991b1b;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px;">Position</label>
                        <InputText @bind-Value="model.Position" placeholder="e.g. Social Welfare Officer"
                                   style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; outline: none;" />
                        <ValidationMessage For="@(() => model.Position)" style="font-size: 11px; color: #991b1b;" />
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px;">Birth date</label>
                        <InputDate @bind-Value="model.BirthDate"
                                   style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; outline: none;" />
                        <ValidationMessage For="@(() => model.BirthDate)" style="font-size: 11px; color: #991b1b;" />
                    </div>
                </div>

                <p style="font-size: 11px; font-weight: 600; color: #378ADD; text-transform: uppercase; letter-spacing: 1.5px; margin: 18px 0 10px; padding-bottom: 6px; border-bottom: 0.5px solid #e5e7eb;">Account credentials</p>

                <div class="register-grid" style="margin-bottom: 20px;">
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px;">Username</label>
                        <InputText @bind-Value="model.UserName" placeholder="your.username" autocomplete="username"
                                   style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; outline: none;" />
                        <ValidationMessage For="@(() => model.UserName)" style="font-size: 11px; color: #991b1b;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px;">Password</label>
                        <InputText type="password" @bind-Value="model.Password" placeholder="Create a strong password" autocomplete="new-password"
                                   style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; outline: none;" />
                        <ValidationMessage For="@(() => model.Password)" style="font-size: 11px; color: #991b1b;" />
                    </div>
                </div>

                <button type="submit" disabled="@IsLoading"
                        style="width: 100%; padding: 11px; background: #0C447C; color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; opacity: @(IsLoading ? "0.7" : "1");">
                    @(IsLoading ? "Creating account..." : "Create account")
                </button>
            </EditForm>

            <p style="text-align: center; margin-top: 16px; font-size: 13px; color: #6b7280;">
                Already have an account? <a href="login" style="color: #185FA5; font-weight: 600; text-decoration: none;">Sign in here</a>
            </p>
        </div>

    </div>
</div>

@code {
    private RegisterViewModel model = new();
    private string? Message;
    private bool IsSuccess;
    private bool IsLoading;


    private async Task HandleRegisterAsync()
    {
        IsLoading = true;
        Message = null;
        StateHasChanged();

        var request = new RegisterRequest
        {
            FullName = model.FullName,
            Position = model.Position,
            BirthDate = model.BirthDate ?? DateTime.Today,
            UserName = model.UserName,
            Password = model.Password
        };

        var (success, message) = await AuthService.RegisterAsync(request);
        IsSuccess = success;
        Message = success
            ? "Registration successful! Your account is pending administrator approval."
            : message;

        if (success)
        {
            await Task.Delay(5000);
            Navigation.NavigateTo("/login");
        }

        IsLoading = false;
        StateHasChanged();
    }

    public class RegisterViewModel
    {
        [Required(ErrorMessage = "Full name is required.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Position is required.")]
        public string Position { get; set; } = string.Empty;

        [Required(ErrorMessage = "Birth date is required.")]
        public DateTime? BirthDate { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "Username is required.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}