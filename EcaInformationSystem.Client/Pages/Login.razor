@page "/login"
@attribute [AllowAnonymous]
@implements IDisposable
@layout AuthLayout
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Client.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Login</PageTitle>

@if (isCheckingAuth)
{
    <div class="container py-5 text-center">
        <p>Loading...</p>
    </div>
}
else
{
    <div class="auth-page-wrapper public-glass-bg">
        <GlassParticles />

        <div class="login-navbar">
            <div class="login-navbar-left">
                <div class="login-navbar-brand">
                    <img src="images/ncsc-seal.png" alt="NCSC Seal" onerror="this.style.display='none'" />
                    <div class="login-navbar-brand-text-wrap">
                        <div class="login-navbar-brand-text">ECA-InFORMS</div>
                        <div class="login-navbar-brand-sub">Caraga Region</div>
                    </div>
                </div>

                <span class="login-navbar-left-divider"></span>

                @* ── Back beside the brand per request — the earlier centered
                     grid-column layout is retired. The sign-in panel now floats
                     as an absolute overlay when expanded (doesn't consume grid/
                     flex space), so this move can't reintroduce the overflow
                     bug that motivated centering it in the first place. ── *@
                <div class="login-navbar-quicklinks">
                    <a href="features" class="login-navbar-about-link">
                        <i class="bi bi-stars"></i> <span>Features</span>
                    </a>
                    <a href="about" class="login-navbar-about-link">
                        <i class="bi bi-info-circle"></i> <span>About</span>
                    </a>
                    <a href="regional-offices" class="login-navbar-about-link">
                        <i class="bi bi-telephone"></i> <span>Contact</span>
                    </a>
                    <a href="directory-officials" class="login-navbar-about-link">
                        <i class="bi bi-people"></i> <span>Officials</span>
                    </a>
                    <a href="developer" class="login-navbar-about-link">
                        <i class="bi bi-code-slash"></i> <span>Developer</span>
                    </a>
                </div>
            </div>

            <button class="login-navbar-hamburger" @onclick="ToggleMobileMenu" title="Menu">
                <i class="bi bi-list"></i>
            </button>

            <EditForm Model="model" OnValidSubmit="HandleLoginAsync" OnInvalidSubmit="HandleInvalidSubmit"
                      class="@($"login-navbar-form {(_mobileMenuOpen ? "login-navbar-form--open" : "")}")">
                <DataAnnotationsValidator />

                @* ── Mobile-only copies of the quick links — the top bar's inline
                     pills (.login-navbar-quicklinks) get hidden on narrow screens
                     so they don't crowd/clip against the hamburger button; these
                     full-width copies live at the top of the same dropdown so
                     About/Contact/Officials stay reachable and tappable without
                     getting buried below the login form. ── *@
                <div class="login-navbar-menu-links">
                    <a href="features" class="login-navbar-register-btn"><i class="bi bi-stars me-1"></i>Features</a>
                    <a href="about" class="login-navbar-register-btn"><i class="bi bi-info-circle me-1"></i>About</a>
                    <a href="regional-offices" class="login-navbar-register-btn"><i class="bi bi-telephone me-1"></i>Contact</a>
                    <a href="directory-officials" class="login-navbar-register-btn"><i class="bi bi-people me-1"></i>Officials</a>
                    <a href="developer" class="login-navbar-register-btn"><i class="bi bi-code-slash me-1"></i>Developer</a>
                </div>

                @* ── Desktop-only: fields stay collapsed behind a single icon
                     until clicked, then slide open right-to-left. Mobile ignores
                     this entirely (the dropdown above already shows everything
                     when open) — see the >760px guard in auth-shared.css. ── *@
                @if (!_desktopLoginExpanded)
                {
                    <button type="button" class="login-navbar-signin-toggle" @onclick="() => _desktopLoginExpanded = true" title="Sign In">
                        <i class="bi bi-box-arrow-in-right"></i> <span>Sign In</span>
                    </button>
                }

                <div class="login-navbar-fields @(_desktopLoginExpanded ? "login-navbar-fields--open" : "")">
                    <InputText @bind-Value="model.UserName" placeholder="Username" class="login-navbar-input" />
                    <InputText type="password" @bind-Value="model.Password" placeholder="Password" class="login-navbar-input" />
                    <button type="submit" class="login-navbar-btn" disabled="@(IsLoading || SecondsLeft.HasValue)">
                        @(SecondsLeft.HasValue ? $"Locked ({SecondsLeft}s)" : (IsLoading ? "Signing in..." : "Sign in"))
                    </button>
                    <a href="register" class="login-navbar-register-btn">Register</a>
                    <a href="forgot-password" class="login-navbar-register-btn">Forgot?</a>
                    <button type="button" class="login-navbar-signin-close" @onclick="() => _desktopLoginExpanded = false" title="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </EditForm>
        </div>

        <PublicLiveTicker />

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            var bgColor = IsLockedOut ? "#fef2f2" : (AttemptsRemaining <= 2 ? "#fff7ed" : "#fef2f2");
            var borderColor = IsLockedOut ? "#fca5a5" : (AttemptsRemaining <= 2 ? "#fdba74" : "#fca5a5");
            var textColor = IsLockedOut ? "#991b1b" : (AttemptsRemaining <= 2 ? "#9a3412" : "#991b1b");

            <div class="login-status-banner">
                <div
                    style="background:@bgColor;border:0.5px solid @borderColor;color:@textColor;padding:10px 14px;border-radius:8px;font-size:13px;">
                    <div style="font-weight:600;">@ErrorMessage</div>

                    @if (SecondsLeft.HasValue)
                    {
                        var mins = SecondsLeft.Value / 60;
                        var secs = SecondsLeft.Value % 60;
                        <div style="font-size:13px;margin-top:6px;font-variant-numeric:tabular-nums;">
                            ⏱ Try again in @mins:@secs.ToString("00")
                        </div>
                    }
                    else if (AttemptsRemaining.HasValue && !IsLockedOut && AttemptsRemaining <= 3)
                    {
                        <div style="display:flex;gap:4px;margin-top:6px;">
                            @for (int i = 0; i < 5; i++)
                            {
                                var filled = i < (5 - AttemptsRemaining.Value);
                                <div style="width:20px;height:6px;border-radius:3px;background:@(filled ? "#dc2626" : "#e5e7eb");">
                                </div>
                            }
                        </div>
                        <div style="font-size:11px;margin-top:4px;opacity:0.8;">
                            @AttemptsRemaining.Value of 5 attempts remaining
                        </div>
                    }
                </div>
            </div>
        }

        @if (_mfaStep)
        {
            <div class="mfa-modal-backdrop">
                <div class="mfa-modal-card">
                    <p
                        style="font-size:11px;letter-spacing:2px;color:#378ADD;text-transform:uppercase;font-weight:600;margin-bottom:6px;">
                        Verification required</p>
                        <h2 style="font-size:20px;font-weight:700;color:#1a1a1a;margin-bottom:4px;">Enter your code</h2>
                        <p style="font-size:13px;color:#6b7280;margin-bottom:20px;">
                            Open your authenticator app and enter the 6-digit code for ECA-InFORMS.
                        </p>

                        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                        {
                            <div
                                style="background:#fef2f2;border:0.5px solid #fca5a5;color:#991b1b;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:16px;">
                                @ErrorMessage
                            </div>
                        }

                        <input @bind="_mfaCode" @bind:event="oninput" maxlength="6" placeholder="000000"
                               style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:18px;letter-spacing:6px;text-align:center;margin-bottom:14px;" />

                        <button @onclick="HandleVerifyMfaAsync" disabled="@(_mfaCode.Length != 6 || IsLoading)"
                                style="width:100%;padding:11px;background:#0C447C;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;opacity:@(_mfaCode.Length != 6 || IsLoading ? "0.6" : "1");">
                            @(IsLoading ? "Verifying..." : "Verify")
                        </button>

                        <p style="text-align:center;margin-top:14px;">
                            <a href="#" @onclick="BackToLogin" @onclick:preventDefault="true"
                               style="color:#185FA5;font-size:13px;">← Back to login</a>
                        </p>
                    </div>
                </div>
            }

            <div class="login-feed-hero">
                <span class="login-feed-hero-badge"><span class="login-feed-hero-dot"></span> LIVE FROM THE FIELD</span>
                <h2 class="login-feed-hero-title">See what <span class="login-feed-hero-title-accent">ECA-InFORMS</span> teams are up to</h2>
                <p class="login-feed-hero-lede">
                    A public glimpse of the Feed — real posts, real progress, no account needed to look around.
                    <a href="features">See everything the system can do →</a>
                </p>
            </div>

            <div class="login-feed-body">
                <PostFeed />
            </div>
            <PublicCalendarWidget />

            <ScrollToTopButton />

        </div>
    }

@code {
    private LoginModel model = new();
    private string? ErrorMessage;
    private int? AttemptsRemaining;
    private bool IsLockedOut;
    private int? SecondsLeft;
    private System.Threading.Timer? _countdownTimer;
    private bool isCheckingAuth = true;
    private bool IsLoading = false;

    private bool _mfaStep = false;
    private string _mfaUserId = string.Empty;
    private string _mfaCode = string.Empty;

    private bool _mobileMenuOpen = false;
    // Desktop only — the Username/Password/Sign in row stays collapsed
    // behind a single icon until clicked (see auth-shared.css's .login-navbar-fields).
    private bool _desktopLoginExpanded = false;

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/", true);
            return;
        }

        isCheckingAuth = false;
        StateHasChanged();
    }

    private void HandleInvalidSubmit()
    {
        ErrorMessage = "Please enter both username and password.";
        AttemptsRemaining = null;
        IsLockedOut = false;
        StateHasChanged();
    }

    private void BackToLogin()
    {
        _mfaStep = false;
        _mfaCode = string.Empty;
        ErrorMessage = null;
    }

    private async Task HandleLoginAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        AttemptsRemaining = null;
        IsLockedOut = false;
        StopCountdown();
        StateHasChanged();

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var outcome = await AuthService.LoginAsync(model.UserName, model.Password, cts.Token);

            if (outcome.IsSuccess)
            {
                ((JwtAuthStateProvider)AuthStateProvider).NotifyAuthChanged();
                Navigation.NavigateTo("/", true);
            }
            else if (outcome.MfaRequired)
            {
                _mfaStep = true;
                _mfaUserId = outcome.MfaUserId!;
            }
            else
            {
                ErrorMessage = outcome.Message;
                AttemptsRemaining = outcome.AttemptsRemaining;
                IsLockedOut = outcome.IsLockedOut;

                if (outcome.RetryAfterSeconds is > 0)
                {
                    StartCountdown(outcome.RetryAfterSeconds.Value);
                }
            }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleVerifyMfaAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var outcome = await AuthService.VerifyMfaAsync(_mfaUserId, _mfaCode, cts.Token);

            if (outcome.IsSuccess)
            {
                ((JwtAuthStateProvider)AuthStateProvider).NotifyAuthChanged();
                Navigation.NavigateTo("/", true);
            }
            else
            {
                ErrorMessage = outcome.Message;
                _mfaCode = string.Empty;
            }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void StartCountdown(int seconds)
    {
        SecondsLeft = seconds;
        _countdownTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (SecondsLeft is > 0) SecondsLeft--;

                if (SecondsLeft <= 0)
                {
                    StopCountdown();
                    ErrorMessage = null;
                    IsLockedOut = false;
                    AttemptsRemaining = null;
                }

                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private void StopCountdown()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
        SecondsLeft = null;
    }

    public void Dispose() => StopCountdown();

    public class LoginModel
    {
        [Required(ErrorMessage = "Username is required.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}