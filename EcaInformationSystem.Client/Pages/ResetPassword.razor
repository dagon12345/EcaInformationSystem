@page "/reset-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using EcaInformationSystem.Client.Services
@using Microsoft.AspNetCore.Authorization
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Reset Password — ECA-InFORMS</PageTitle>

<style>
    .auth-page-wrapper {
        min-height: 100vh;
        background: #042C53;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 40px 24px 60px;
    }

    .register-card {
        display: flex;
        flex-direction: column;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0,0,0,0.35);
        width: 100%;
        max-width: 460px;
    }

    .register-brand-panel {
        background: #0C447C;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 24px;
    }

    .register-form-panel {
        background: #fff;
        padding: 32px 36px;
    }
</style>

<div class="auth-page-wrapper">
    <div class="register-card">

        <div class="register-brand-panel">
            <img src="images/ncsc-seal.png" alt="NCSC"
                 style="width: 64px; height: 64px; border-radius: 50%; border: 3px solid #85B7EB; object-fit: cover; margin-bottom: 12px; background: white;"
                 onerror="this.style.display='none'" />
            <div style="font-size: 22px; font-weight: 700; color: #fff; letter-spacing: 1px;">ECA-InFORMS</div>
            <div style="font-size: 10px; color: #85B7EB; letter-spacing: 2px; text-transform: uppercase;">Caraga Region</div>
        </div>

        <div class="register-form-panel">
            @if (!_completed)
            {
                <p style="font-size: 11px; letter-spacing: 2px; color: #378ADD; text-transform: uppercase; font-weight: 600; margin-bottom: 6px;">Account recovery</p>
                <h2 style="font-size: 20px; font-weight: 700; color: #1a1a1a; margin-bottom: 4px;">Reset your password</h2>
                <p style="font-size: 13px; color: #6b7280; margin-bottom: 24px;">
                    Enter the one-time code your administrator gave you, along with your new password.
                </p>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div style="background: #fef2f2; border: 0.5px solid #fca5a5; color: #991b1b; padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 18px;">
                        @_errorMessage
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div style="margin-bottom: 16px;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px;">Username</label>
                        <InputText @bind-Value="_model.UserName" placeholder="your.username"
                                   style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; outline: none;" />
                        <ValidationMessage For="@(() => _model.UserName)" style="font-size: 11px; color: #991b1b;" />
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px;">One-time code</label>
                        <InputText @bind-Value="_model.Code" placeholder="e.g. K3F9-M2A1"
                                   style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; letter-spacing: 2px; text-transform: uppercase; outline: none;" />
                        <ValidationMessage For="@(() => _model.Code)" style="font-size: 11px; color: #991b1b;" />
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px;">New password</label>
                        <InputText type="password" @bind-Value="_model.NewPassword" placeholder="Create a strong password"
                                   style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; outline: none;" />
                        <ValidationMessage For="@(() => _model.NewPassword)" style="font-size: 11px; color: #991b1b;" />
                    </div>

                    <div style="margin-bottom: 24px;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px;">Confirm new password</label>
                        <InputText type="password" @bind-Value="_model.ConfirmPassword" placeholder="Re-enter your new password"
                                   style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; outline: none;" />
                        <ValidationMessage For="@(() => _model.ConfirmPassword)" style="font-size: 11px; color: #991b1b;" />
                    </div>

                    <button type="submit" disabled="@_isLoading"
                            style="width: 100%; padding: 11px; background: #0C447C; color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; opacity: @(_isLoading ? "0.7" : "1");">
                        @(_isLoading ? "Resetting..." : "Reset password")
                    </button>
                </EditForm>
            }
            else
            {
                <div style="background: #f0fdf4; border: 0.5px solid #86efac; color: #166534; padding: 14px 16px; border-radius: 10px; font-size: 13px; line-height: 1.5;">
                    <i class="bi bi-check-circle-fill" style="margin-right: 6px;"></i>
                    Password reset successfully. You can now sign in with your new password.
                </div>

                <button @onclick="GoToLogin"
                        style="width: 100%; margin-top: 16px; padding: 11px; background: #0C447C; color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">
                    Go to login
                </button>
            }

            @if (!_completed)
            {
                <p style="text-align: center; margin-top: 20px; font-size: 13px; color: #6b7280;">
                    <a href="login" style="color: #185FA5; font-weight: 600; text-decoration: none;">← Back to login</a>
                </p>
            }
        </div>
    </div>
</div>

@code {
    private ResetPasswordModel _model = new();
    private bool _isLoading;
    private bool _completed;
    private string? _errorMessage;

    private async Task HandleSubmitAsync()
    {
        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            StateHasChanged();
            return;
        }

        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var (success, message) = await AuthService.CompletePasswordResetAsync(
            _model.UserName, _model.Code, _model.NewPassword);

        if (success)
        {
            _completed = true;
        }
        else
        {
            _errorMessage = message;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    public class ResetPasswordModel
    {
        [Required(ErrorMessage = "Username is required.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Code is required.")]
        public string Code { get; set; } = string.Empty;

        [Required(ErrorMessage = "New password is required.")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}