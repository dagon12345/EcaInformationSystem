@page "/post/{PostId:guid}"
@attribute [AllowAnonymous]
@implements IDisposable
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Client.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>ECA-InFORMS Feed</PageTitle>

@if (_checkingAuth)
{
    <div class="container py-5 text-center"><p>Loading...</p></div>
}
else if (_isAuthenticated)
{
    <PostFeed FocusPostId="@PostId" />
}
else
{
    <div class="auth-page-wrapper">

        <div class="login-navbar">
            <div class="login-navbar-brand">
                <img src="images/ncsc-seal.png" alt="NCSC Seal" onerror="this.style.display='none'" />
                <div class="login-navbar-brand-text-wrap">
                    <div class="login-navbar-brand-text">ECA-InFORMS</div>
                    <div class="login-navbar-brand-sub">Caraga Region</div>
                </div>
            </div>

            @if (!_mfaStep)
            {
                <button class="login-navbar-hamburger" @onclick="ToggleMobileMenu" title="Menu">
                    <i class="bi bi-list"></i>
                </button>

                <EditForm Model="_model" OnValidSubmit="HandleLoginAsync" OnInvalidSubmit="HandleInvalidSubmit"
                          class="@($"login-navbar-form {(_mobileMenuOpen ? "login-navbar-form--open" : "")}")">
                    <DataAnnotationsValidator />
                    <InputText @bind-Value="_model.UserName" placeholder="Username" class="login-navbar-input" />
                    <InputText type="password" @bind-Value="_model.Password" placeholder="Password" class="login-navbar-input" />
                    <button type="submit" class="login-navbar-btn" disabled="@(_isLoggingIn || _secondsLeft.HasValue)">
                        @(_secondsLeft.HasValue ? $"Locked ({_secondsLeft}s)" : (_isLoggingIn ? "Signing in..." : "Sign in"))
                    </button>
                    <a href="register" class="login-navbar-register-btn">Register</a>
                </EditForm>
            }
            else
            {
                <a href="register" class="login-navbar-register-btn">Register</a>
            }
        </div>

        @if (!_mfaStep && !string.IsNullOrWhiteSpace(_errorMessage))
        {
            var bgColor = _isLockedOut ? "#fef2f2" : (_attemptsRemaining <= 2 ? "#fff7ed" : "#fef2f2");
            var borderColor = _isLockedOut ? "#fca5a5" : (_attemptsRemaining <= 2 ? "#fdba74" : "#fca5a5");
            var textColor = _isLockedOut ? "#991b1b" : (_attemptsRemaining <= 2 ? "#9a3412" : "#991b1b");

            <div class="login-status-banner">
                <div style="background:@bgColor;border:0.5px solid @borderColor;color:@textColor;padding:10px 14px;border-radius:8px;font-size:13px;">
                    <div style="font-weight:600;">@_errorMessage</div>

                    @if (_secondsLeft.HasValue)
                    {
                        var mins = _secondsLeft.Value / 60;
                        var secs = _secondsLeft.Value % 60;
                        <div style="font-size:13px;margin-top:6px;font-variant-numeric:tabular-nums;">
                            ⏱ Try again in @mins:@secs.ToString("00")
                        </div>
                    }
                    else if (_attemptsRemaining.HasValue && !_isLockedOut && _attemptsRemaining <= 3)
                    {
                        <div style="display:flex;gap:4px;margin-top:6px;">
                            @for (int i = 0; i < 5; i++)
                            {
                                var filled = i < (5 - _attemptsRemaining.Value);
                                <div style="width:20px;height:6px;border-radius:3px;background:@(filled ? "#dc2626" : "#e5e7eb");"></div>
                            }
                        </div>
                        <div style="font-size:11px;margin-top:4px;opacity:0.8;">
                            @_attemptsRemaining.Value of 5 attempts remaining
                        </div>
                    }
                </div>
            </div>
        }

        @if (_mfaStep)
        {
            <div class="mfa-modal-backdrop">
                <div class="mfa-modal-card">
                    <p style="font-size:11px;letter-spacing:2px;color:#378ADD;text-transform:uppercase;font-weight:600;margin-bottom:6px;">Verification required</p>
                    <h2 style="font-size:20px;font-weight:700;color:#1a1a1a;margin-bottom:4px;">Enter your code</h2>
                    <p style="font-size:13px;color:#6b7280;margin-bottom:20px;">
                        Open your authenticator app and enter the 6-digit code for ECA-InFORMS.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div style="background:#fef2f2;border:0.5px solid #fca5a5;color:#991b1b;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:16px;">
                            @_errorMessage
                        </div>
                    }

                    <input @bind="_mfaCode" @bind:event="oninput" maxlength="6" placeholder="000000"
                           style="width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:18px;letter-spacing:6px;text-align:center;margin-bottom:14px;" />

                    <button @onclick="HandleVerifyMfaAsync" disabled="@(_mfaCode.Length != 6 || _isLoggingIn)"
                            style="width:100%;padding:11px;background:#0C447C;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;opacity:@(_mfaCode.Length != 6 || _isLoggingIn ? "0.6" : "1");">
                        @(_isLoggingIn ? "Verifying..." : "Verify")
                    </button>

                    <p style="text-align:center;margin-top:14px;">
                        <a href="#" @onclick="BackToLogin" @onclick:preventDefault="true" style="color:#185FA5;font-size:13px;">← Back to login</a>
                    </p>
                </div>
            </div>
        }

        <div class="login-feed-body">
            <PostFeed FocusPostId="@PostId" />
        </div>

        <ScrollToTopButton />

    </div>
}

@code {
    [Parameter] public Guid PostId { get; set; }

    private bool _checkingAuth = true;
    private bool _isAuthenticated;

    private LoginModel _model = new();
    private string? _errorMessage;
    private int? _attemptsRemaining;
    private bool _isLockedOut;
    private int? _secondsLeft;
    private System.Threading.Timer? _countdownTimer;
    private bool _isLoggingIn;

    private bool _mfaStep = false;
    private string _mfaUserId = string.Empty;
    private string _mfaCode = string.Empty;

    private bool _mobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        _checkingAuth = false;
    }

    private void HandleInvalidSubmit()
    {
        _errorMessage = "Please enter both username and password.";
        _attemptsRemaining = null;
        _isLockedOut = false;
        StateHasChanged();
    }

    private async Task HandleLoginAsync()
    {
        _isLoggingIn = true;
        _errorMessage = null;
        _attemptsRemaining = null;
        _isLockedOut = false;
        StopCountdown();
        StateHasChanged();

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var outcome = await AuthService.LoginAsync(_model.UserName, _model.Password, cts.Token);

            if (outcome.IsSuccess)
            {
                ((JwtAuthStateProvider)AuthStateProvider).NotifyAuthChanged();
                Navigation.NavigateTo($"/post/{PostId}", true);
            }
            else if (outcome.MfaRequired)
            {
                _mfaStep = true;
                _mfaUserId = outcome.MfaUserId!;
            }
            else
            {
                _errorMessage = outcome.Message;
                _attemptsRemaining = outcome.AttemptsRemaining;
                _isLockedOut = outcome.IsLockedOut;

                if (outcome.RetryAfterSeconds is > 0)
                {
                    StartCountdown(outcome.RetryAfterSeconds.Value);
                }
            }
        }
        finally
        {
            _isLoggingIn = false;
            StateHasChanged();
        }
    }

    private async Task HandleVerifyMfaAsync()
    {
        _isLoggingIn = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var outcome = await AuthService.VerifyMfaAsync(_mfaUserId, _mfaCode, cts.Token);

            if (outcome.IsSuccess)
            {
                ((JwtAuthStateProvider)AuthStateProvider).NotifyAuthChanged();
                Navigation.NavigateTo($"/post/{PostId}", true);
            }
            else
            {
                _errorMessage = outcome.Message;
                _mfaCode = string.Empty;
            }
        }
        finally
        {
            _isLoggingIn = false;
            StateHasChanged();
        }
    }

    private void BackToLogin()
    {
        _mfaStep = false;
        _mfaCode = string.Empty;
        _errorMessage = null;
    }

    private void StartCountdown(int seconds)
    {
        _secondsLeft = seconds;
        _countdownTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (_secondsLeft is > 0) _secondsLeft--;

                if (_secondsLeft <= 0)
                {
                    StopCountdown();
                    _errorMessage = null;
                    _isLockedOut = false;
                    _attemptsRemaining = null;
                }

                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private void StopCountdown()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
        _secondsLeft = null;
    }

    public void Dispose() => StopCountdown();

    public class LoginModel
    {
        [Required(ErrorMessage = "Username is required.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}