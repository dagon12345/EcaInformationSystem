@page "/developer"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>About the Developer</PageTitle>

@* Mirrors About.razor: standalone public chrome for an anonymous visitor
   (reached via the login page's navbar), just the article when already
   signed in and reached from inside the app shell. *@
<AuthorizeView>
    <NotAuthorized>
        <div class="auth-page-wrapper public-glass-bg">
            <GlassParticles />
            <PublicNavbar Current="developer" />

            <div class="dev-page-body">
                <DeveloperArticle />
            </div>

            <ScrollToTopButton />
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="dev-page-body">
            <DeveloperArticle />
        </div>
    </Authorized>
</AuthorizeView>
