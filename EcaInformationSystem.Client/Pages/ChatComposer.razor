@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs.Chat
@inject ChatStateService ChatState
@inject HttpClient Http
@inject ToastService toast
@implements IDisposable


<div class="chat-composer">

    @if (ChatState.ReplyingTo != null)
    {
        <div class="chat-reply-bar">
            <div class="flex-grow-1 overflow-hidden">
                <div class="chat-reply-bar-label">Replying to @ChatState.ReplyingTo.SenderName</div>
                <div class="chat-reply-bar-preview text-truncate">
                    @(ChatState.ReplyingTo.Content ?? "[Attachment]")
                </div>
            </div>
            <button class="btn-close btn-close-sm" @onclick="ChatState.CancelReply"></button>
        </div>
    }

    @if (_pendingAttachments.Any())
    {
        <div class="chat-attachment-preview-list">
            @foreach (var att in _pendingAttachments)
            {
                <div class="chat-attachment-preview">
                    @if (att.Preview != null)
                    {
                        <img src="@att.Preview" style="width:32px;height:32px;object-fit:cover;border-radius:4px;" />
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-fill" style="font-size:20px;"></i>
                    }
                    <span class="text-truncate small">@att.FileName</span>
                    <button class="btn-close btn-close-sm" @onclick="() => RemovePendingAttachment(att.Id, 0)"></button>
                </div>
            }
        </div>
    }

    @if (_isUploadingAttachment)
    {
        <div class="chat-attachment-uploading small text-muted">
            <span class="spinner-border spinner-border-sm me-1"></span> Uploading...
        </div>
    }

    @{ var showEveryoneOption = _canMentionEveryone && "everyone".StartsWith(_mentionSearchTerm, StringComparison.OrdinalIgnoreCase); }
    @* ✅ FIXED — used to require _mentionSuggestions.Any() to show the dropdown
       AT ALL, which hid "@everyone" too the moment no real member's name
       matched anymore (e.g. typing past the point any name contains that
       substring) even though "@everyone" itself was still a valid match. *@
    @if (_showMentionDropdown && (_mentionSuggestions.Any() || showEveryoneOption))
    {
        <div class="chat-mention-dropdown">
            @if (showEveryoneOption)
            {
                <div class="chat-mention-item" @onclick="() => SelectEveryoneMention()">
                    <i class="bi bi-people-fill me-2"></i><strong>@@everyone</strong>
                </div>
            }
            @foreach (var user in _mentionSuggestions)
            {
                <div class="chat-mention-item" @onclick="() => SelectMention(user)">
                    <i class="bi bi-person-circle me-2"></i>
                    <strong>@user.DisplayName</strong>
                    <small class="text-muted ms-1">(@user.Role)</small>
                </div>
            }
        </div>
    }

    @* A plain <textarea> can't render bold text mid-string, so confirmed
       mentions show as a small bold chip strip above it instead — the closest
       equivalent to "bold in the composer" without a full rich-text editor. *@
    @if (_mentionEveryoneSelected || _selectedMentions.Any())
    {
        <div class="chat-mention-chip-row">
            @if (_mentionEveryoneSelected)
            {
                <span class="chat-mention-chip">
                    <strong>@@everyone</strong>
                    <button type="button" @onclick="RemoveEveryoneMention" title="Remove"><i class="bi bi-x"></i></button>
                </span>
            }
            @foreach (var mention in _selectedMentions)
            {
                <span class="chat-mention-chip">
                    <strong>@@@mention.Name</strong>
                    <button type="button" @onclick="() => RemoveSelectedMention(mention.Id)" title="Remove"><i class="bi bi-x"></i></button>
                </span>
            }
        </div>
    }

    <div class="d-flex align-items-end gap-2">
        <label class="chat-attach-btn" title="Attach image or PDF">
            <i class="bi bi-paperclip"></i>
            <InputFile OnChange="OnFileSelected" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv" style="display:none;" />
        </label>
        <textarea class="form-control chat-composer-input" rows="1"
                  placeholder="Type a message... use @@ to mention someone"
                  value="@_draftText"
                  @oninput="OnInputChanged"
                  @onkeydown="OnKeyDown"></textarea>

        <button class="btn btn-primary chat-send-btn" @onclick="SendAsync"
                disabled="@(_isSending || (string.IsNullOrWhiteSpace(_draftText) && !_pendingAttachments.Any()))">
            @if (_isSending)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <i class="bi bi-send-fill"></i>
            }
        </button>
    </div>
</div>

@code {
    private string _draftText = string.Empty;
    private bool _isSending;

    private Guid? _pendingAttachmentId;
    private string? _pendingAttachmentPreview;
    private string? _pendingFileName;
    private string? _pendingContentType; // ✅ NEW
    private bool _isUploadingAttachment;

    private bool _showMentionDropdown;
    private string _mentionSearchTerm = string.Empty;
    private List<ChatMemberSuggestionDto> _mentionSuggestions = new();
    private List<(Guid Id, string Name)> _selectedMentions = new();
    private bool _mentionEveryoneSelected;
    private bool _canMentionEveryone = true; // ✅ open to all roles, per spec

    private CancellationTokenSource? _mentionDebounceCts;
    private static readonly string[] AllowedTypes = { "image/jpeg", "image/png", "image/webp", "application/pdf" };
    private const long MaxImageSize = 5 * 1024 * 1024;   // 5MB — matches server limit
    private const long MaxPdfSize = 10 * 1024 * 1024;    // 10MB — matches server limit
    private List<(Guid Id, string FileName, string? Preview)> _pendingAttachments = new();
    private const long MaxCombinedSize = 10 * 1024 * 1024; // 10MB total
    private long _combinedPendingSize = 0;

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        _draftText = e.Value?.ToString() ?? string.Empty;
        // ✅ NEW — fire a (debounced) typing signal on every keystroke
        _ = ChatState.NotifyTypingAsync();

        var atIndex = _draftText.LastIndexOf('@');
        if (atIndex >= 0)
        {
            var afterAt = _draftText[(atIndex + 1)..];
            if (!afterAt.Contains(' ') && !afterAt.Contains('\n'))
            {
                _mentionSearchTerm = afterAt;
                _showMentionDropdown = true;
                await DebouncedFetchSuggestionsAsync();
                return;
            }
        }

        _showMentionDropdown = false;
    }

    private async Task DebouncedFetchSuggestionsAsync()
    {
        _mentionDebounceCts?.Cancel();
        _mentionDebounceCts = new CancellationTokenSource();
        var token = _mentionDebounceCts.Token;

        try
        {
            await Task.Delay(200, token); // debounce fast typing
            var result = await ChatState.GetMentionSuggestionsAsync(_mentionSearchTerm, token);

            // Belt-and-suspenders — even though the fetch itself is now
            // cancellable, only apply the result if no newer keystroke has
            // since started its own debounce cycle (guards against any
            // response that still slips through out of order).
            if (token == _mentionDebounceCts?.Token)
            {
                _mentionSuggestions = result;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
    }
    protected override void OnInitialized()
    {
        ChatState.OnChange += HandleStateChanged;
    }
    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatState.OnChange -= HandleStateChanged;
    }

    private void SelectMention(ChatMemberSuggestionDto user)
    {
        var atIndex = _draftText.LastIndexOf('@');
        if (atIndex >= 0)
        {
            _draftText = _draftText[..atIndex] + $"@{user.DisplayName} ";
        }

        if (!_selectedMentions.Any(m => m.Id == user.UserId))
        {
            _selectedMentions.Add((user.UserId, user.DisplayName));
        }

        _showMentionDropdown = false;
        StateHasChanged();
    }

    private void SelectEveryoneMention()
    {
        var atIndex = _draftText.LastIndexOf('@');
        if (atIndex >= 0)
        {
            _draftText = _draftText[..atIndex] + "@everyone ";
        }

        _mentionEveryoneSelected = true;
        _showMentionDropdown = false;
        StateHasChanged();
    }

    private static readonly System.Text.RegularExpressions.Regex MentionEveryoneTextRegex =
        new(@"@everyone\s?", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Compiled);

    private void RemoveEveryoneMention()
    {
        _draftText = MentionEveryoneTextRegex.Replace(_draftText, "");
        _mentionEveryoneSelected = false;
    }

    private void RemoveSelectedMention(Guid userId)
    {
        var match = _selectedMentions.FirstOrDefault(m => m.Id == userId);
        if (match.Name is not null)
        {
            var pattern = "@" + System.Text.RegularExpressions.Regex.Escape(match.Name) + @"\s?";
            _draftText = System.Text.RegularExpressions.Regex.Replace(
                _draftText, pattern, "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }

        _selectedMentions.RemoveAll(m => m.Id == userId);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _showMentionDropdown = false;
            return;
        }

        // ✅ Enter sends; Shift+Enter inserts a newline (standard chat convention)
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            // Don't send while the mention dropdown is open — Enter should
            // ideally select the highlighted suggestion instead. Since there's
            // no keyboard-selection state tracked yet, the safest behavior for
            // now is to just close the dropdown and let the user press Enter
            // again to actually send, rather than sending mid-mention-typing.
            if (_showMentionDropdown)
            {
                _showMentionDropdown = false;
                return;
            }

            await SendAsync();
        }
    }
    private static readonly Dictionary<string, long> AllowedTypesWithLimits = new()
    {
        ["image/jpeg"] = 5 * 1024 * 1024,
        ["image/png"] = 5 * 1024 * 1024,
        ["image/webp"] = 5 * 1024 * 1024,
        ["application/pdf"] = 10 * 1024 * 1024,
        ["application/msword"] = 10 * 1024 * 1024,
        ["application/vnd.openxmlformats-officedocument.wordprocessingml.document"] = 10 * 1024 * 1024,
        ["application/vnd.ms-excel"] = 10 * 1024 * 1024,
        ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"] = 10 * 1024 * 1024,
        ["application/vnd.ms-powerpoint"] = 10 * 1024 * 1024,
        ["application/vnd.openxmlformats-officedocument.presentationml.presentation"] = 10 * 1024 * 1024,
        ["text/plain"] = 10 * 1024 * 1024,
        ["text/csv"] = 10 * 1024 * 1024
    };
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(10); // cap the picker itself at a sane max count

        foreach (var file in files)
        {
            var contentType = file.ContentType.ToLowerInvariant();
            if (!AllowedTypesWithLimits.ContainsKey(contentType))
            {
                toast.ShowError($"'{file.Name}' isn't a supported file type.");
                continue;
            }

            // ✅ Check COMBINED total, not per-file, per the new requirement
            if (_combinedPendingSize + file.Size > MaxCombinedSize)
            {
                toast.ShowError($"Adding '{file.Name}' would exceed the 10MB combined limit for this message.");
                continue;
            }

            _isUploadingAttachment = true;
            StateHasChanged();

            try
            {
                var buffer = new byte[file.Size];
                await using (var stream = file.OpenReadStream(MaxCombinedSize))
                {
                    await stream.ReadAsync(buffer);
                }

                using var content = new MultipartFormDataContent();
                var streamContent = new ByteArrayContent(buffer);
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "file", file.Name);

                var response = await Http.PostAsync("api/chat/attachments", content);
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<AttachmentUploadResult>();
                    var isImage = contentType.StartsWith("image/");
                    var preview = isImage ? $"data:{contentType};base64,{Convert.ToBase64String(buffer)}" : null;

                    _pendingAttachments.Add((result!.AttachmentId, file.Name, preview));
                    _combinedPendingSize += file.Size;
                }
                else
                {
                    var errorText = await response.Content.ReadAsStringAsync();
                    toast.ShowError(errorText.Trim('"'));
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[CHAT DEBUG] Attachment upload exception: {ex}");
                toast.ShowError("Something went wrong while uploading. Please try again.");
            }
            finally
            {
                _isUploadingAttachment = false;
                StateHasChanged();
            }
        }
    }

    private void RemovePendingAttachment(Guid attachmentId, long approxSize)
    {
        _pendingAttachments.RemoveAll(a => a.Id == attachmentId);
        _combinedPendingSize = Math.Max(0, _combinedPendingSize - approxSize); // approximate is fine here
    }
    private void ClearPendingAttachment()
    {
        _pendingAttachmentId = null;
        _pendingAttachmentPreview = null;
        _pendingFileName = null;
        _pendingContentType = null; // ✅ NEW
    }
    // ⬅️ Add this small class too — needed by the snippet above
    private class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1_048_576 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / 1_048_576.0:F1} MB"
    };
    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_draftText) && !_pendingAttachments.Any()) // ✅ FIXED
            return;

        _isSending = true;
        StateHasChanged();

        try
        {
            await ChatState.SendMessageAsync(
                string.IsNullOrWhiteSpace(_draftText) ? null : _draftText.Trim(),
                _selectedMentions.Select(m => m.Id).ToList(),
                _mentionEveryoneSelected,
                _pendingAttachments.Select(a => a.Id).ToList());

            _pendingAttachments.Clear();
            _combinedPendingSize = 0;
            _draftText = string.Empty;
            _selectedMentions.Clear();
            _mentionEveryoneSelected = false;
            ClearPendingAttachment();
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }
    private class AttachmentUploadResult
    {
        public Guid AttachmentId { get; set; }
    }
}