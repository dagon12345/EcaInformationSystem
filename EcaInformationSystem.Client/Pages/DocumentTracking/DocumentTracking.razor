@* DocumentTracking.razor — the generic sibling of Application Tracking: tracks
   a single free-form document as it's tagged from person to person (relay),
   sent back (return, server picks the recipient), or marked done (complete).
   No rows/batches, no fixed workflow stages — just one record per document
   and three free-form routing actions. *@
@page "/document-tracking"
@attribute [Authorize]
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs.DocumentTracking
@using EcaInformationSystem.Shared.DTOs.Common
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject ToastService Toast
@inject DocumentTrackingClientService DocTracking
@inject IJSRuntime JS
@implements IDisposable
@implements IAsyncDisposable

<PageTitle>Document Tracking</PageTitle>

<div class="dt-wrap">
    <div class="dt-header">
        <div>
            <h4 class="dt-title"><i class="bi bi-send me-2"></i>Document Tracking</h4>
            <p class="dt-sub">Track where a document is right now — who has it, and who it's going to next.</p>
        </div>
        <button class="dt-btn dt-btn-primary" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg"></i> New Tracked Document
        </button>
    </div>

    <div class="dt-filter-bar">
        <input type="text" class="dt-filter-input" placeholder="Search by serial number or title..."
               value="@_searchTerm" @oninput="OnSearchInput" />
    </div>

    @if (_loading)
    {
        <div class="text-center text-muted py-5">
            <span class="spinner-border spinner-border-sm me-2"></span> Loading tracked documents...
        </div>
    }
    else if (!_items.Any())
    {
        <div class="dt-empty">
            <i class="bi bi-inbox"></i>
            <p>No tracked documents found.</p>
        </div>
    }
    else
    {
        <div class="dt-card-list">
            @foreach (var doc in _items)
            {
                var completed = doc.Status == 1;
                <div class="dt-card @(completed ? "dt-card-completed" : "")">
                    <div class="dt-card-header">
                        <div class="dt-card-header-main">
                            <div class="dt-card-title">
                                <span class="text-muted font-monospace">@doc.SerialNumber</span>
                                <span class="dt-chevron-sep">›</span> @doc.Title
                            </div>
                            <div class="dt-card-meta">
                                <span class="dt-pill dt-pill-neutral">By @doc.CreatedByName</span>
                                <span class="dt-pill dt-pill-neutral">@doc.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                @if (!completed && !doc.CurrentLegAcceptedAt.HasValue)
                                {
                                    <span class="dt-pill dt-pill-finding"><i class="bi bi-hourglass-split me-1"></i>Awaiting acceptance</span>
                                }
                            </div>
                        </div>
                        <div class="dt-card-header-side">
                            <span class="dt-status-pill @(completed ? "dt-status-completed" : "dt-status-neutral")">
                                <i class="bi @(completed ? "bi-check-circle-fill" : "bi-arrow-left-right") me-1"></i>
                                @doc.StatusLabel
                            </span>
                            <div class="dt-holder-line">
                                @if (!completed)
                                {
                                    <span>
                                        With <strong>@doc.CurrentHolderName</strong>
                                        @(doc.CurrentLegAcceptedAt.HasValue ? "(accepted)" : "(pending acceptance)")
                                    </span>
                                }
                            </div>
                            <button class="dt-btn dt-btn-outline dt-btn-sm ms-2" @onclick="() => OpenDetailModalAsync(doc.Id)">
                                <i class="bi bi-eye"></i> View
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted small">@_totalCount document(s) total</span>
            <div class="d-flex align-items-center gap-2">
                <button class="dt-btn dt-btn-outline dt-btn-sm" disabled="@(_page <= 1)" @onclick="() => ChangePageAsync(_page - 1)">
                    <i class="bi bi-chevron-left"></i> Previous
                </button>
                <span class="text-muted small">Page @_page of @TotalPages</span>
                <button class="dt-btn dt-btn-outline dt-btn-sm" disabled="@(_page >= TotalPages)" @onclick="() => ChangePageAsync(_page + 1)">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    }
</div>

@* ── Create Tracked Document modal ────────────────────────────────────────── *@
@if (_showCreateModal)
{
    <div class="dt-modal-backdrop" @onclick="RequestCloseCreateModal">
        <div class="dt-modal" @onclick:stopPropagation="true">
            <div class="dt-modal-header">
                <span><i class="bi bi-send me-2"></i>New Tracked Document</span>
                <button class="dt-modal-close" @onclick="RequestCloseCreateModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="dt-modal-body" id="doc-tracking-create-form-root" style="position: relative;">
                @if (_showCreateDiscardConfirm)
                {
                    <div class="dt-discard-confirm-overlay" @onclick:stopPropagation="true">
                        <div class="dt-discard-confirm-box">
                            <div class="fw-semibold mb-1">Discard this document?</div>
                            <p class="text-muted small mb-2">What you've entered hasn't been created yet.</p>
                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelCreateDiscard">Keep editing</button>
                                <button class="btn btn-sm btn-danger" @onclick="ConfirmCreateDiscard">Discard</button>
                            </div>
                        </div>
                    </div>
                }
                @if (_showCreateDraftBanner)
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center py-2 px-3 mb-3">
                        <div>
                            <i class="bi bi-clock-history me-2"></i>
                            We found an unsaved document from a previous session
                            @(_createDraftSavedAt.HasValue ? $"(saved {_createDraftSavedAt.Value.ToLocalTime():MMM dd, yyyy hh:mm tt})" : "")
                            . Would you like to restore it?
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-primary" @onclick="RestoreCreateDraftAsync">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Restore
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DiscardCreateDraftAsync">
                                Discard
                            </button>
                        </div>
                    </div>
                }

                <div class="dt-field">
                    <label>Title <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="_createTitle" />
                </div>
                <div class="dt-field">
                    <label>Description (optional)</label>
                    <textarea class="form-control" rows="2" @bind="_createDescription"></textarea>
                </div>
                <div class="dt-field">
                    <label>Tag Recipient <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="_createRecipientUserId">
                        <option value="">Select recipient...</option>
                        @foreach (var u in _users)
                        {
                            <option value="@u.Id">@u.FullName (@u.Role)</option>
                        }
                    </select>
                </div>
                <div class="dt-field">
                    <label>Note (optional)</label>
                    <textarea class="form-control" rows="2" @bind="_createNote"></textarea>
                </div>
                <div class="dt-field">
                    <label class="d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                        <input type="checkbox" @bind="_createIsFinding" />
                        <span><i class="bi bi-flag-fill text-warning me-1"></i>Flag this as a finding (optional)</span>
                    </label>
                </div>
                @if (_createIsFinding)
                {
                    <div class="dt-field">
                        <label>Finding Justification <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="2" @bind="_createFindingJustification"
                                  placeholder="Explain the finding — what's wrong, and what's needed to resolve it."></textarea>
                    </div>
                }
            </div>
            <div class="dt-modal-footer">
                @if (_lastCreateDraftSavedAt.HasValue)
                {
                    <span class="text-muted small me-auto align-self-center">
                        <i class="bi bi-cloud-check me-1"></i>Draft saved @_lastCreateDraftSavedAt.Value.ToString("hh:mm:ss tt")
                    </span>
                }
                <button class="dt-btn dt-btn-outline" @onclick="RequestCloseCreateModal">Cancel</button>
                <button class="dt-btn dt-btn-primary" @onclick="SubmitCreateAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Create & Tag
                </button>
            </div>
        </div>
    </div>
}

@* ── Detail modal ─────────────────────────────────────────────────────────── *@
@if (_showDetailModal)
{
    <div class="dt-modal-backdrop" @onclick="CloseDetailModal">
        <div class="dt-modal dt-modal-lg" @onclick:stopPropagation="true">
            <div class="dt-modal-header">
                <span><i class="bi bi-send me-2"></i>@(_selectedDocument?.SerialNumber ?? "Document")</span>
                <button class="dt-modal-close" @onclick="CloseDetailModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="dt-modal-body">
                @if (_selectedDocument is null)
                {
                    <div class="text-center text-muted py-4">
                        <span class="spinner-border spinner-border-sm me-2"></span> Loading...
                    </div>
                }
                else
                {
                    var doc = _selectedDocument;
                    var completed = doc.Status == 1;
                    var isHolder = doc.CurrentHolderUserId == _currentUserId;
                    var canRoute = isHolder && doc.CurrentLegAcceptedAt.HasValue && !completed;
                    var canAccept = isHolder && !doc.CurrentLegAcceptedAt.HasValue && !completed;
                    var canEdit = doc.CreatedByUserId == _currentUserId || _isSuperAdmin;
                    var canDelete = _isAdmin || _isFinance;

                    <div class="dt-review-grid mb-3">
                        <div><span class="dt-review-label">Title</span><span>@doc.Title</span></div>
                        <div><span class="dt-review-label">Status</span>
                            <span class="dt-status-pill @(completed ? "dt-status-completed" : "dt-status-neutral")">
                                <i class="bi @(completed ? "bi-check-circle-fill" : "bi-arrow-left-right") me-1"></i>@doc.StatusLabel
                            </span>
                        </div>
                        <div><span class="dt-review-label">Created By</span><span>@doc.CreatedByName on @doc.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span></div>
                        <div><span class="dt-review-label">Currently With</span>
                            <span>@doc.CurrentHolderName @(completed ? "" : (doc.CurrentLegAcceptedAt.HasValue ? "(accepted)" : "(pending acceptance)"))</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(doc.Description))
                    {
                        <div class="dt-field">
                            <label>Description</label>
                            <div>@doc.Description</div>
                        </div>
                    }

                    @if (canAccept || canRoute || canEdit || canDelete)
                    {
                        <div class="dt-actions mb-3">
                            @if (canAccept)
                            {
                                <button class="dt-btn dt-btn-primary" @onclick="AcceptAsync" disabled="@_busy">
                                    <i class="bi bi-check2-circle"></i> Accept
                                </button>
                            }
                            @if (canRoute)
                            {
                                <button class="dt-btn dt-btn-outline" @onclick="() => OpenActionPanel(DtAction.Relay)" disabled="@_busy">
                                    <i class="bi bi-send"></i> Relay to...
                                </button>
                                <button class="dt-btn dt-btn-outline" @onclick="() => OpenActionPanel(DtAction.Return)" disabled="@_busy">
                                    <i class="bi bi-arrow-return-left"></i> Return
                                </button>
                                <button class="dt-btn dt-btn-primary" @onclick="() => OpenActionPanel(DtAction.Complete)" disabled="@_busy">
                                    <i class="bi bi-check2-all"></i> Complete
                                </button>
                            }
                            @if (canEdit)
                            {
                                <button class="dt-btn dt-btn-outline" @onclick="OpenEditModal" disabled="@_busy">
                                    <i class="bi bi-pencil-fill"></i> Edit
                                </button>
                            }
                            @if (canDelete)
                            {
                                <button class="dt-btn dt-btn-danger" @onclick="OpenDeleteConfirm" disabled="@_busy">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </button>
                            }
                        </div>
                    }

                    @if (_actionMode.HasValue)
                    {
                        <div class="dt-field" style="border: 1px solid var(--bs-border-color, #dee2e6); border-radius: 8px; padding: 1rem;">
                            <div class="fw-semibold mb-2">@ActionPanelTitle()</div>

                            @if (_actionMode == DtAction.Relay)
                            {
                                <div class="dt-field">
                                    <label>Tag Recipient <span class="text-danger">*</span></label>
                                    <select class="form-select" @bind="_actionToUserId">
                                        <option value="">Select recipient...</option>
                                        @foreach (var u in _users)
                                        {
                                            <option value="@u.Id">@u.FullName (@u.Role)</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (_actionMode == DtAction.Return)
                            {
                                <div class="text-muted small mb-2">
                                    <i class="bi bi-info-circle me-1"></i>This will be sent back to whoever handed it to you.
                                </div>
                            }

                            <div class="dt-field">
                                <label>Note (optional)</label>
                                <textarea class="form-control" rows="2" @bind="_actionNote"></textarea>
                            </div>

                            @if (_actionMode != DtAction.Complete)
                            {
                                <div class="dt-field">
                                    <label class="d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                                        <input type="checkbox" @bind="_actionIsFinding" />
                                        <span><i class="bi bi-flag-fill text-warning me-1"></i>Flag this as a finding (optional)</span>
                                    </label>
                                </div>
                                @if (_actionIsFinding)
                                {
                                    <div class="dt-field">
                                        <label>Finding Justification <span class="text-danger">*</span></label>
                                        <textarea class="form-control" rows="2" @bind="_actionFindingJustification"
                                                  placeholder="Explain the finding — what's wrong, and what's needed to resolve it."></textarea>
                                    </div>
                                }
                            }

                            <div class="d-flex justify-content-end gap-2 mt-2">
                                <button class="dt-btn dt-btn-outline" @onclick="CloseActionPanel">Cancel</button>
                                <button class="dt-btn dt-btn-primary" @onclick="SubmitActionAsync" disabled="@_busy">
                                    @if (_busy)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    Confirm
                                </button>
                            </div>
                        </div>
                    }

                    <div class="dt-transfer-log">
                        <div class="dt-transfer-log-title">Routing History</div>
                        @foreach (var route in doc.Routes.OrderBy(r => r.RelayedAt))
                        {
                            <div class="dt-transfer-entry">
                                <span class="dt-status-pill dt-status-neutral dt-status-pill-sm">@route.ActionLabel</span>
                                @if (route.IsFinding)
                                {
                                    <span class="dt-finding-badge" title="@route.FindingJustification">
                                        <i class="bi bi-flag-fill"></i> Finding
                                        @if (!string.IsNullOrWhiteSpace(route.RaisedByRole))
                                        {
                                            <small class="d-block text-muted">by @route.FromUserName (@route.RaisedByRole)</small>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(route.FindingJustification))
                                        {
                                            <small class="d-block text-muted">"@route.FindingJustification"</small>
                                        }
                                    </span>
                                }
                                <span class="dt-transfer-text">
                                    @route.FromUserName sent to <strong>@route.ToUserName</strong>
                                    <small class="text-muted ms-1">@route.RelayedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</small>
                                    @if (route.AcceptedAt.HasValue)
                                    {
                                        <small class="text-success ms-1"><i class="bi bi-check-circle-fill"></i> accepted @route.AcceptedAt.Value.ToLocalTime().ToString("MMM dd, h:mm tt")</small>
                                    }
                                </span>
                                @if (!string.IsNullOrWhiteSpace(route.Note))
                                {
                                    <div class="dt-transfer-note">"@route.Note"</div>
                                }
                            </div>
                        }
                        <div class="dt-transfer-entry">
                            <span class="text-muted small">Created by @doc.CreatedByName on @doc.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ── Edit modal (Title/Description only) ─────────────────────────────────── *@
@if (_showEditModal)
{
    <div class="dt-modal-backdrop" @onclick="CloseEditModal">
        <div class="dt-modal" @onclick:stopPropagation="true">
            <div class="dt-modal-header">
                <span><i class="bi bi-pencil-fill me-2"></i>Edit Document</span>
                <button class="dt-modal-close" @onclick="CloseEditModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="dt-modal-body">
                <div class="dt-field">
                    <label>Title <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="_editTitle" />
                </div>
                <div class="dt-field">
                    <label>Description (optional)</label>
                    <textarea class="form-control" rows="2" @bind="_editDescription"></textarea>
                </div>
                <div class="dt-field">
                    <label>Status</label>
                    <select class="form-select" @bind="_editStatus">
                        <option value="0">In Transit</option>
                        <option value="1">Completed</option>
                    </select>
                </div>
            </div>
            <div class="dt-modal-footer">
                <button class="dt-btn dt-btn-outline" @onclick="CloseEditModal">Cancel</button>
                <button class="dt-btn dt-btn-primary" @onclick="SubmitEditAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

@* ── Delete confirmation ──────────────────────────────────────────────────── *@
@if (_showDeleteConfirm)
{
    <div class="dt-modal-backdrop" @onclick="CloseDeleteConfirm">
        <div class="dt-modal" @onclick:stopPropagation="true">
            <div class="dt-modal-header">
                <span><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Delete Tracked Document</span>
                <button class="dt-modal-close" @onclick="CloseDeleteConfirm"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="dt-modal-body">
                <p class="mb-0">
                    This will <strong>permanently delete</strong> this document and its entire routing history for
                    every user who can see it. <strong>This cannot be undone.</strong>
                </p>
            </div>
            <div class="dt-modal-footer">
                <button class="dt-btn dt-btn-outline" @onclick="CloseDeleteConfirm">Cancel</button>
                <button class="dt-btn dt-btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Delete Permanently
                </button>
            </div>
        </div>
    </div>
}

@code {
    private enum DtAction { Relay, Return, Complete }

    // ── List state ──────────────────────────────────────────────────────
    private List<TrackedDocumentListItemDto> _items = new();
    private List<UserLookupDto> _users = new();
    private bool _loading = true;
    private bool _busy;
    private bool _isSuperAdmin;
    private bool _isAdmin;
    private bool _isFinance;
    private Guid? _currentUserId;

    private string _searchTerm = string.Empty;
    private System.Threading.CancellationTokenSource? _searchDebounceCts;
    private const int SearchDebounceMs = 400;

    private int _page = 1;
    private const int PageSize = 20;
    private int _totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));

    // ── Create modal state ──────────────────────────────────────────────
    private bool _showCreateModal;
    private bool _showCreateDiscardConfirm;
    private string _createTitle = string.Empty;
    private string? _createDescription;
    private Guid _createRecipientUserId;
    private string? _createNote;
    private bool _createIsFinding;
    private string? _createFindingJustification;

    // ── Create modal draft autosave — same localStorage pattern as
    // ApplicationTracking.razor's create-batch draft.
    private const string CreateDraftKey = "eca-doctracking-draft-new";
    private const int CreateDraftDebounceMs = 1200;
    private IJSObjectReference? _createDraftWatchHandle;
    private DotNetObjectReference<DocumentTracking>? _createDraftDotNetRef;
    private bool _pendingCreateDraftWatchSetup;
    private string? _createDraftBaselineJson;
    private string? _lastSavedCreateDraftJson;
    private bool _showCreateDraftBanner;
    private DateTime? _createDraftSavedAt;
    private DateTime? _lastCreateDraftSavedAt;

    private class CreateDocumentDraftData
    {
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public Guid RecipientUserId { get; set; }
        public string? Note { get; set; }
        public bool IsFinding { get; set; }
        public string? FindingJustification { get; set; }
    }

    private class CreateDocumentDraftEnvelope
    {
        public DateTime SavedAt { get; set; }
        public CreateDocumentDraftData? Data { get; set; }
    }

    // ── Detail modal state ────────────────────────────────────────────────
    private bool _showDetailModal;
    private Guid? _detailDocumentId;
    private TrackedDocumentDto? _selectedDocument;

    // ── Relay/Return/Complete action panel state ────────────────────────
    private DtAction? _actionMode;
    private Guid _actionToUserId;
    private string? _actionNote;
    private bool _actionIsFinding;
    private string? _actionFindingJustification;

    // ── Edit modal state ──────────────────────────────────────────────────
    private bool _showEditModal;
    private string _editTitle = string.Empty;
    private string? _editDescription;
    private int _editStatus;

    // ── Delete confirm state ──────────────────────────────────────────────
    private bool _showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitAsync();
        _isSuperAdmin = AuthService.IsSuperAdmin();
        _isAdmin = AuthService.IsAdmin(); // true for both Admin and SuperAdmin
        _isFinance = AuthService.IsFinance();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = Guid.TryParse(authState.User.FindFirst("sub")?.Value, out var id) ? id : (Guid?)null;

        await LoadItemsAsync();
        _users = await Http.GetFromJsonAsync<List<UserLookupDto>>("api/document-tracking/taggable-users") ?? new();

        // Live-refresh on ANY document change by ANYONE, so this page (and any
        // open detail modal) never shows stale data while it's open.
        DocTracking.OnDocumentChanged += HandleDocumentChangedLive;
        DocTracking.OnDocumentDeleted += HandleDocumentDeletedLive;
    }

    private async Task LoadItemsAsync()
    {
        _loading = true;
        try
        {
            var url = $"api/document-tracking?page={_page}&pageSize={PageSize}" +
                       (string.IsNullOrWhiteSpace(_searchTerm) ? "" : $"&search={Uri.EscapeDataString(_searchTerm)}");
            var result = await Http.GetFromJsonAsync<PagedResultDto<TrackedDocumentListItemDto>>(url);
            _items = result?.Items ?? new();
            _totalCount = result?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load tracked documents: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangePageAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == _page) return;
        _page = page;
        await LoadItemsAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;

        _searchDebounceCts?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        _searchDebounceCts = cts;

        _ = DebouncedSearchAsync(cts.Token);
    }

    private async Task DebouncedSearchAsync(System.Threading.CancellationToken token)
    {
        try
        {
            await Task.Delay(SearchDebounceMs, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested) return;

        _page = 1; // a new search term always resets to the first page
        await InvokeAsync(async () =>
        {
            await LoadItemsAsync();
            StateHasChanged();
        });
    }

    // ── Live updates ──────────────────────────────────────────────────────
    private async void HandleDocumentChangedLive(TrackedDocumentDto document)
    {
        // Skip refreshing the list while a modal that could collide with a
        // reload is open — the modal's own close handler reloads once done.
        if (_showCreateModal || _showEditModal || _showDeleteConfirm) return;

        try
        {
            await InvokeAsync(async () =>
            {
                await LoadItemsAsync();

                if (_showDetailModal && _detailDocumentId == document.Id)
                    _selectedDocument = document;

                StateHasChanged();
            });
        }
        catch
        {
            // Non-fatal — a stray exception here shouldn't wedge the render loop.
        }
    }

    private async void HandleDocumentDeletedLive(Guid documentId)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_showDetailModal && _detailDocumentId == documentId)
                {
                    Toast.ShowWarning("This document was deleted.");
                    CloseDetailModal();
                }

                await LoadItemsAsync();
                StateHasChanged();
            });
        }
        catch
        {
        }
    }

    public void Dispose()
    {
        DocTracking.OnDocumentChanged -= HandleDocumentChangedLive;
        DocTracking.OnDocumentDeleted -= HandleDocumentDeletedLive;
        _searchDebounceCts?.Cancel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingCreateDraftWatchSetup)
        {
            _pendingCreateDraftWatchSetup = false;
            await StartWatchingCreateFormActivityAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_showCreateModal)
                await AutosaveCreateDraftAsync();
            await StopWatchingCreateFormActivityAsync();
        }
        catch (JSDisconnectedException) { /* circuit/page already gone */ }
        _createDraftDotNetRef?.Dispose();
    }

    // ── Create modal ─────────────────────────────────────────────────────
    private async Task OpenCreateModal()
    {
        _createTitle = string.Empty;
        _createDescription = null;
        _createRecipientUserId = Guid.Empty;
        _createNote = null;
        _createIsFinding = false;
        _createFindingJustification = null;
        _showCreateModal = true;

        _createDraftBaselineJson = JsonSerializer.Serialize(CaptureCreateDraftData());
        _lastSavedCreateDraftJson = null;
        _lastCreateDraftSavedAt = null;
        await CheckForCreateDraftAsync();
        _pendingCreateDraftWatchSetup = true; // picked up in OnAfterRenderAsync, once the modal markup exists
    }

    private async Task CloseCreateModal()
    {
        _showCreateModal = false;
        _showCreateDiscardConfirm = false;
        await StopWatchingCreateFormActivityAsync();
    }

    private bool CreateFormIsDirty() =>
        !string.IsNullOrWhiteSpace(_createTitle) ||
        !string.IsNullOrWhiteSpace(_createDescription) ||
        _createRecipientUserId != Guid.Empty ||
        !string.IsNullOrWhiteSpace(_createNote);

    private async Task RequestCloseCreateModal()
    {
        if (CreateFormIsDirty())
            _showCreateDiscardConfirm = true;
        else
            await CloseCreateModal();
    }

    private void CancelCreateDiscard() => _showCreateDiscardConfirm = false;

    private async Task ConfirmCreateDiscard()
    {
        await ClearCreateDraftAsync();
        await CloseCreateModal();
    }

    private async Task SubmitCreateAsync()
    {
        if (_busy) return;

        if (string.IsNullOrWhiteSpace(_createTitle))
        {
            Toast.ShowError("Please enter a title.");
            return;
        }
        if (_createRecipientUserId == Guid.Empty)
        {
            Toast.ShowError("Please tag who this document is initially going to.");
            return;
        }
        if (_createIsFinding && string.IsNullOrWhiteSpace(_createFindingJustification))
        {
            Toast.ShowError("Please explain the finding — a justification is required when flagging one.");
            return;
        }

        _busy = true;
        try
        {
            var dto = new CreateTrackedDocumentDto
            {
                Title = _createTitle.Trim(),
                Description = string.IsNullOrWhiteSpace(_createDescription) ? null : _createDescription,
                RecipientUserId = _createRecipientUserId,
                Note = _createNote,
                IsFinding = _createIsFinding,
                FindingJustification = _createIsFinding ? _createFindingJustification : null
            };

            var response = await Http.PostAsJsonAsync("api/document-tracking", dto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Document created and tagged.");
                await ClearCreateDraftAsync();
                await CloseCreateModal();
                _page = 1;
                await LoadItemsAsync();
            }
            else
            {
                Toast.ShowError(await response.Content.ReadAsStringAsync());
            }
        }
        finally
        {
            _busy = false;
        }
    }

    #region Create draft autosave
    private CreateDocumentDraftData CaptureCreateDraftData() => new()
    {
        Title = _createTitle,
        Description = _createDescription,
        RecipientUserId = _createRecipientUserId,
        Note = _createNote,
        IsFinding = _createIsFinding,
        FindingJustification = _createFindingJustification
    };

    private async Task StartWatchingCreateFormActivityAsync()
    {
        _createDraftDotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            _createDraftWatchHandle = await JS.InvokeAsync<IJSObjectReference?>(
                "draftInterop.watchFormActivity", _createDraftDotNetRef, "doc-tracking-create-form-root", CreateDraftDebounceMs);
        }
        catch { /* form still works without local draft autosave */ }
    }

    private async Task StopWatchingCreateFormActivityAsync()
    {
        if (_createDraftWatchHandle is null) return;
        try
        {
            await JS.InvokeVoidAsync("draftInterop.unwatchFormActivity", _createDraftWatchHandle);
            await _createDraftWatchHandle.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* circuit/page already gone */ }
        _createDraftWatchHandle = null;
    }

    [JSInvokable]
    public async Task OnCreateFormActivityDetected() => await AutosaveCreateDraftAsync();

    private async Task AutosaveCreateDraftAsync()
    {
        if (_showCreateDraftBanner)
            _showCreateDraftBanner = false;

        try
        {
            var currentJson = JsonSerializer.Serialize(CaptureCreateDraftData());
            if (currentJson == _createDraftBaselineJson || currentJson == _lastSavedCreateDraftJson)
                return;

            var envelope = new CreateDocumentDraftEnvelope { SavedAt = DateTime.UtcNow, Data = CaptureCreateDraftData() };
            await JS.InvokeVoidAsync("localStorage.setItem", CreateDraftKey, JsonSerializer.Serialize(envelope));

            _lastSavedCreateDraftJson = currentJson;
            _lastCreateDraftSavedAt = DateTime.Now;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { /* circuit/page already gone */ }
    }

    private async Task CheckForCreateDraftAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", CreateDraftKey);
            if (string.IsNullOrWhiteSpace(raw)) return;

            var envelope = JsonSerializer.Deserialize<CreateDocumentDraftEnvelope>(raw);
            if (envelope?.Data is null) return;

            var hasContent = !string.IsNullOrWhiteSpace(envelope.Data.Title) ||
                              !string.IsNullOrWhiteSpace(envelope.Data.Description) ||
                              envelope.Data.RecipientUserId != Guid.Empty ||
                              !string.IsNullOrWhiteSpace(envelope.Data.Note);
            if (!hasContent)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", CreateDraftKey);
                return;
            }

            _createDraftSavedAt = envelope.SavedAt;
            _showCreateDraftBanner = true;
        }
        catch
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", CreateDraftKey);
        }
    }

    private async Task RestoreCreateDraftAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", CreateDraftKey);
            var envelope = string.IsNullOrWhiteSpace(raw) ? null : JsonSerializer.Deserialize<CreateDocumentDraftEnvelope>(raw);
            if (envelope?.Data is null)
            {
                _showCreateDraftBanner = false;
                return;
            }

            _createTitle = envelope.Data.Title;
            _createDescription = envelope.Data.Description;
            _createRecipientUserId = envelope.Data.RecipientUserId;
            _createNote = envelope.Data.Note;
            _createIsFinding = envelope.Data.IsFinding;
            _createFindingJustification = envelope.Data.FindingJustification;

            _showCreateDraftBanner = false;
            Toast.ShowSuccess("Draft restored.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to restore draft: {ex.Message}");
        }
    }

    private async Task DiscardCreateDraftAsync()
    {
        await ClearCreateDraftAsync();
        _showCreateDraftBanner = false;
    }

    private async Task ClearCreateDraftAsync()
    {
        try { await JS.InvokeVoidAsync("localStorage.removeItem", CreateDraftKey); }
        catch (JSDisconnectedException) { /* circuit/page already gone */ }
        _lastSavedCreateDraftJson = null;
        _lastCreateDraftSavedAt = null;
    }
    #endregion

    // ── Detail modal ─────────────────────────────────────────────────────
    private async Task OpenDetailModalAsync(Guid id)
    {
        _detailDocumentId = id;
        _selectedDocument = null;
        _showDetailModal = true;
        _actionMode = null;
        await LoadDetailAsync(id);
    }

    private async Task LoadDetailAsync(Guid id)
    {
        try
        {
            _selectedDocument = await Http.GetFromJsonAsync<TrackedDocumentDto>($"api/document-tracking/{id}");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load document: {ex.Message}");
        }
    }

    private void CloseDetailModal()
    {
        _showDetailModal = false;
        _detailDocumentId = null;
        _selectedDocument = null;
        _actionMode = null;
    }

    private async Task AcceptAsync()
    {
        if (_busy || _detailDocumentId is null) return;
        await RunDocumentActionAsync(() => Http.PostAsync($"api/document-tracking/{_detailDocumentId}/accept", null));
    }

    // ── Relay/Return/Complete action panel ──────────────────────────────
    private void OpenActionPanel(DtAction mode)
    {
        _actionMode = mode;
        _actionToUserId = Guid.Empty;
        _actionNote = null;
        _actionIsFinding = false;
        _actionFindingJustification = null;
    }

    private void CloseActionPanel() => _actionMode = null;

    private string ActionPanelTitle() => _actionMode switch
    {
        DtAction.Relay => "Relay to...",
        DtAction.Return => "Return",
        DtAction.Complete => "Complete",
        _ => string.Empty
    };

    private async Task SubmitActionAsync()
    {
        if (_busy || _detailDocumentId is null || _actionMode is null) return;

        if (_actionMode == DtAction.Relay && _actionToUserId == Guid.Empty)
        {
            Toast.ShowError("Please tag a recipient.");
            return;
        }
        if (_actionMode != DtAction.Complete && _actionIsFinding && string.IsNullOrWhiteSpace(_actionFindingJustification))
        {
            Toast.ShowError("Please explain the finding — a justification is required when flagging one.");
            return;
        }

        var id = _detailDocumentId.Value;
        var mode = _actionMode.Value;

        Task<HttpResponseMessage> Send()
        {
            return mode switch
            {
                DtAction.Relay => Http.PostAsJsonAsync($"api/document-tracking/{id}/relay", new RelayDocumentToDto
                {
                    ToUserId = _actionToUserId,
                    Note = _actionNote,
                    IsFinding = _actionIsFinding,
                    FindingJustification = _actionIsFinding ? _actionFindingJustification : null
                }),
                DtAction.Return => Http.PostAsJsonAsync($"api/document-tracking/{id}/return", new ReturnDocumentDto
                {
                    Note = _actionNote,
                    IsFinding = _actionIsFinding,
                    FindingJustification = _actionIsFinding ? _actionFindingJustification : null
                }),
                DtAction.Complete => Http.PostAsJsonAsync($"api/document-tracking/{id}/complete", new CompleteDocumentDto
                {
                    Note = _actionNote
                }),
                _ => throw new InvalidOperationException("Unknown action.")
            };
        }

        await RunDocumentActionAsync(Send, onSuccess: () => _actionMode = null);
    }

    private async Task RunDocumentActionAsync(Func<Task<HttpResponseMessage>> send, Action? onSuccess = null)
    {
        if (_busy) return;

        _busy = true;
        try
        {
            var response = await send();
            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<TrackedDocumentDto>();
                if (updated is not null)
                    _selectedDocument = updated;

                onSuccess?.Invoke();
                await LoadItemsAsync();
            }
            else
            {
                Toast.ShowError(await response.Content.ReadAsStringAsync());
                if (_detailDocumentId.HasValue)
                    await LoadDetailAsync(_detailDocumentId.Value);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Edit modal ────────────────────────────────────────────────────────
    private void OpenEditModal()
    {
        if (_selectedDocument is null) return;
        _editTitle = _selectedDocument.Title;
        _editDescription = _selectedDocument.Description;
        _editStatus = _selectedDocument.Status;
        _showEditModal = true;
    }

    private void CloseEditModal() => _showEditModal = false;

    private async Task SubmitEditAsync()
    {
        if (_busy || _detailDocumentId is null) return;

        if (string.IsNullOrWhiteSpace(_editTitle))
        {
            Toast.ShowError("Title is required.");
            return;
        }

        _busy = true;
        try
        {
            var dto = new UpdateTrackedDocumentDto
            {
                Title = _editTitle.Trim(),
                Description = string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription,
                Status = _editStatus
            };

            var response = await Http.PutAsJsonAsync($"api/document-tracking/{_detailDocumentId.Value}", dto);
            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<TrackedDocumentDto>();
                if (updated is not null)
                    _selectedDocument = updated;

                Toast.ShowSuccess("Document updated.");
                _showEditModal = false;
                await LoadItemsAsync();
            }
            else
            {
                Toast.ShowError(await response.Content.ReadAsStringAsync());
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Delete confirm ────────────────────────────────────────────────────
    private void OpenDeleteConfirm() => _showDeleteConfirm = true;
    private void CloseDeleteConfirm() => _showDeleteConfirm = false;

    private async Task ConfirmDeleteAsync()
    {
        if (_busy || _detailDocumentId is null) return;

        _busy = true;
        try
        {
            var response = await Http.DeleteAsync($"api/document-tracking/{_detailDocumentId.Value}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Document deleted.");
                _showDeleteConfirm = false;
                CloseDetailModal();
                _page = 1;
                await LoadItemsAsync();
            }
            else
            {
                Toast.ShowError(await response.Content.ReadAsStringAsync());
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
