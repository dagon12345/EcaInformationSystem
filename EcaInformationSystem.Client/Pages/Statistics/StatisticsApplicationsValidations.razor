@* StatisticsApplicationsValidations.razor — "Statistical Report — Applications and Validations",
   split out of Statistics.razor into its own page. It's still a branch of Statistics (same nav
   group, same audience), but it has its own filter set — Date Added, Date Endorsed, and Milestone
   Year only — and does NOT share or inherit Statistics.razor's filter state, so opening this page
   never applies Statistics' Region/Province/Municipality/Payment/Quarter/Fiscal-Year filters here. *@
@page "/statistics/applications-validations"
@using Microsoft.AspNetCore.Authorization
@using SharedDtos = EcaInformationSystem.Shared.DTOs
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Applications & Validations Report</PageTitle>

<div class="content-area">
    @* ── Page Header ───────────────────────────────────────────────── *@
    <div class="page-header-bar mb-3">
        <div class="page-header-icon">
            <i class="bi bi-clipboard2-check-fill"></i>
        </div>
        <div>
            <div class="page-header-title">Statistical Report — Applications and Validations</div>
            <div class="page-header-sub">Generated: @DateTime.Now.ToString("MMMM dd, yyyy HH:mm")</div>
        </div>
        <div class="ms-auto d-flex gap-2">
            <button class="sys-btn sys-btn-outline" @onclick="RefreshAsync">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    @* ── Data quality reminder — counts below are only as accurate as the
         source records. Kept as a single low-noise line so it registers at
         a glance without competing with the header or filters. ── *@
    <div class="data-quality-banner">
        <i class="bi bi-info-circle-fill"></i>
        Counts reflect data exactly as encoded. Incomplete or uncleansed records can skew these figures — please verify and cleanse data for accurate statistics.
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted small">Loading report...</p>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@_loadError
            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="RefreshAsync">Retry</button>
        </div>
    }
    else
    {
        @* ── Filter Panel — Date Added / Date Endorsed only ──────────── *@
        <div class="sf-card">
            <div class="sf-header" @onclick="ToggleFilter">
                <div class="sf-header-left">
                    <div class="sf-header-icon"><i class="bi bi-funnel"></i></div>
                    <div>
                        <div class="sf-header-title">Filters</div>
                        <div class="sf-header-sub">Date Added, Date Endorsed, and Milestone Year</div>
                    </div>
                </div>
                <i class="bi bi-chevron-up sf-chevron @(_filterExpanded ? "open" : "")"></i>
            </div>
            @if (_filterExpanded)
            {
                <div class="sf-body">
                    <div class="sf-date-ranges">
                        <div>
                            <div class="sf-section-label"><i class="bi bi-calendar-plus me-1"></i>Date Added</div>
                            <div class="sf-grid">
                                <div class="sf-field">
                                    <label>From</label>
                                    <input type="date" class="ff-input" @bind="_dateAddedFrom" />
                                </div>
                                <div class="sf-field">
                                    <label>To</label>
                                    <input type="date" class="ff-input" @bind="_dateAddedTo" />
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="sf-section-label"><i class="bi bi-calendar-check me-1"></i>Date Endorsed</div>
                            <div class="sf-grid">
                                <div class="sf-field">
                                    <label>From</label>
                                    <input type="date" class="ff-input" @bind="_dateEndorsedFrom" />
                                </div>
                                <div class="sf-field">
                                    <label>To</label>
                                    <input type="date" class="ff-input" @bind="_dateEndorsedTo" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="sf-group">
                        <div class="sf-section-label"><i class="bi bi-calendar-event me-1"></i>Milestone Year</div>
                        <div class="sf-grid">
                            <div class="sf-field">
                                <label>Milestone Year</label>
                                <select class="ff-input" @bind="_selectedMilestoneYear">
                                    <option value="0">All Milestone Years</option>
                                    @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="sf-actions">
                        <button class="sf-btn sf-btn-clear" @onclick="ClearFilters">Clear</button>
                        <button class="sf-btn sf-btn-apply" @onclick="ApplyFiltersAsync">
                            <i class="bi bi-check2"></i> Apply
                        </button>
                    </div>
                </div>
            }
        </div>

        @* ── Statistical Report — Applications & Validations by LGU ──────── *@
        @if (_report.LguValidationBreakdown.Any())
        {
            @* ── Summary cards ─────────────────────────────────────────── *@
            <div class="dash-stat-grid mb-3">
                <div class="dash-stat-card dash-stat-card--navy">
                    <div class="dash-stat-icon"><i class="bi bi-send-check-fill"></i></div>
                    <div class="dash-stat-value">@TotalEndorsedAll.ToString("N0")</div>
                    <div class="dash-stat-label">Total Endorsed</div>
                </div>
                <div class="dash-stat-card dash-stat-card--green">
                    <div class="dash-stat-icon"><i class="bi bi-patch-check-fill"></i></div>
                    <div class="dash-stat-value">@TotalValidatedAll.ToString("N0")</div>
                    <div class="dash-stat-label">Total Validated</div>
                </div>
                <div class="dash-stat-card dash-stat-card--amber">
                    <div class="dash-stat-icon"><i class="bi bi-hourglass-split"></i></div>
                    <div class="dash-stat-value">@TotalVarianceAll.ToString("N0")</div>
                    <div class="dash-stat-label">Awaiting Validation</div>
                </div>
                <div class="dash-stat-card" style="background:#0dcaf0;">
                    <div class="dash-stat-icon"><i class="bi bi-graph-up"></i></div>
                    <div class="dash-stat-value">@ValidationRateAll.ToString("F1")%</div>
                    <div class="dash-stat-label">Validation Rate</div>
                </div>
            </div>

            @* ── Per-province validation-progress chart ──────────────────── *@
            <div class="sys-card mb-3">
                <div class="sys-card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-bar-chart-steps me-2"></i>Validation Progress by Province</span>
                    <span class="badge bg-light text-dark">@ProvinceChartRows.Count provinces</span>
                </div>
                <div class="sys-card-body">
                    <div class="lgu-chart-legend">
                        <span><span class="lgu-chart-legend-swatch" style="background:#15803d;"></span>Validated</span>
                        <span><span class="lgu-chart-legend-swatch" style="background:#f59e0b;"></span>Awaiting Validation (Variance)</span>
                    </div>
                    <div class="lgu-province-chart">
                        @foreach (var p in ProvinceChartRows)
                        {
                            var validatedPct = p.Endorsed == 0 ? 0 : (double)p.Validated / MaxProvinceEndorsed * 100;
                            var variancePct = p.Endorsed == 0 ? 0 : (double)p.Variance / MaxProvinceEndorsed * 100;
                            <div class="lgu-province-chart-row">
                                <span class="lgu-province-chart-label" title="@p.ProvinceName">@p.ProvinceName</span>
                                <div class="lgu-province-chart-track">
                                    <div class="lgu-province-chart-fill lgu-province-chart-fill--validated"
                                         style="width:@(validatedPct.ToString("F2"))%;"
                                         title="@p.ProvinceName — Validated: @p.Validated"></div>
                                    <div class="lgu-province-chart-fill lgu-province-chart-fill--variance"
                                         style="width:@(variancePct.ToString("F2"))%;"
                                         title="@p.ProvinceName — Awaiting Validation: @p.Variance"></div>
                                </div>
                                <span class="lgu-province-chart-count">@p.Validated / @p.Endorsed</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="sys-card mt-3">
                <div class="sys-card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clipboard2-check-fill me-2"></i>Statistical Report — Applications and Validations</span>
                    <span class="badge bg-light text-dark">@_report.LguValidationBreakdown.Count LGUs</span>
                </div>
                <p class="text-muted small px-3 pt-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Endorsed</strong> = has a Date Endorsed on record. <strong>Validated</strong> = marked
                    Compliant in the Verification Checklist. <strong>Variance</strong> is endorsed grantees not yet
                    validated.
                </p>
                <p class="text-muted small px-3 pt-2 mb-0">
                    <i class="bi bi-hand-index-thumb me-1"></i>
                    Click a number in an LGU's row to see exactly which grantees it counts, with their Date
                    Endorsed and whether they are Compliant.
                </p>
                <p class="text-muted small px-3 pt-2 pb-2 mb-0">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    A row showing <strong>0</strong> across the board means that LGU has <strong>not endorsed any
                    grantees</strong> — either it genuinely has none endorsed yet, or none fall within the Date
                    Added / Date Endorsed / Milestone Year filters currently applied above. It's still listed (rather
                    than hidden) because it's a known LGU with grantees on record, so it can be tracked for
                    follow-up.
                </p>
                <div class="sys-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0 stat-table lgu-report-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="align-middle">Name of LGU</th>
                                    <th colspan="2" class="text-center lgu-group-start">Endorsed by the LGU</th>
                                    <th colspan="2" class="text-center lgu-group-start">Validated Grantees</th>
                                    <th colspan="2" class="text-center lgu-group-start">Variance</th>
                                    <th rowspan="2" class="text-center align-middle lgu-group-start">Progress</th>
                                </tr>
                                <tr>
                                    <th class="text-center lgu-group-start">Octo/Nona</th>
                                    <th class="text-center">Cente</th>
                                    <th class="text-center lgu-group-start">Octo/Nona</th>
                                    <th class="text-center">Cente</th>
                                    <th class="text-center lgu-group-start">Octo/Nona</th>
                                    <th class="text-center">Cente</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var provinceGroup in _report.LguValidationBreakdown.GroupBy(x => x.ProvinceName))
                                {
                                    <tr class="lgu-province-header">
                                        <td colspan="8"><i class="bi bi-map me-1"></i>@provinceGroup.Key</td>
                                    </tr>
                                    @foreach (var lgu in provinceGroup)
                                    {
                                        var lguEndorsed = lgu.EndorsedOctoNona + lgu.EndorsedCente;
                                        var lguValidated = lgu.ValidatedOctoNona + lgu.ValidatedCente;
                                        var lguVariance = lgu.VarianceOctoNona + lgu.VarianceCente;
                                        var lguValidatedPct = lguEndorsed == 0 ? 0 : (double)lguValidated / lguEndorsed * 100;
                                        var lguVariancePct = lguEndorsed == 0 ? 0 : (double)lguVariance / lguEndorsed * 100;
                                        <tr>
                                            <td class="ps-4">@lgu.MunicipalityName</td>
                                            <td class="text-center lgu-group-start">@LguCount(lgu, "endorsed", "octonona", lgu.EndorsedOctoNona)</td>
                                            <td class="text-center">@LguCount(lgu, "endorsed", "cente", lgu.EndorsedCente)</td>
                                            <td class="text-center lgu-group-start">@LguCount(lgu, "validated", "octonona", lgu.ValidatedOctoNona)</td>
                                            <td class="text-center">@LguCount(lgu, "validated", "cente", lgu.ValidatedCente)</td>
                                            <td class="text-center lgu-group-start @(lgu.VarianceOctoNona > 0 ? "text-danger fw-semibold" : "text-muted")">@LguCount(lgu, "variance", "octonona", lgu.VarianceOctoNona)</td>
                                            <td class="text-center @(lgu.VarianceCente > 0 ? "text-danger fw-semibold" : "text-muted")">@LguCount(lgu, "variance", "cente", lgu.VarianceCente)</td>
                                            <td class="text-center lgu-group-start">
                                                @if (lguEndorsed == 0)
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                                else
                                                {
                                                    <div class="lgu-mini-bar-track" title="@lgu.MunicipalityName — Validated @lguValidated / @lguEndorsed">
                                                        <div class="lgu-mini-bar-fill--validated" style="width:@(lguValidatedPct.ToString("F2"))%;"></div>
                                                        <div class="lgu-mini-bar-fill--variance" style="width:@(lguVariancePct.ToString("F2"))%;"></div>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    <tr class="lgu-province-subtotal">
                                        <td class="ps-4 fst-italic">Subtotal — @provinceGroup.Key</td>
                                        <td class="text-center lgu-group-start">@provinceGroup.Sum(x => x.EndorsedOctoNona)</td>
                                        <td class="text-center">@provinceGroup.Sum(x => x.EndorsedCente)</td>
                                        <td class="text-center lgu-group-start">@provinceGroup.Sum(x => x.ValidatedOctoNona)</td>
                                        <td class="text-center">@provinceGroup.Sum(x => x.ValidatedCente)</td>
                                        <td class="text-center lgu-group-start">@provinceGroup.Sum(x => x.VarianceOctoNona)</td>
                                        <td class="text-center">@provinceGroup.Sum(x => x.VarianceCente)</td>
                                        <td class="text-center lgu-group-start"></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-secondary fw-bold">
                                <tr>
                                    <td>TOTAL</td>
                                    <td class="text-center lgu-group-start">@_report.LguValidationBreakdown.Sum(x => x.EndorsedOctoNona)</td>
                                    <td class="text-center">@_report.LguValidationBreakdown.Sum(x => x.EndorsedCente)</td>
                                    <td class="text-center lgu-group-start">@_report.LguValidationBreakdown.Sum(x => x.ValidatedOctoNona)</td>
                                    <td class="text-center">@_report.LguValidationBreakdown.Sum(x => x.ValidatedCente)</td>
                                    <td class="text-center lgu-group-start">@_report.LguValidationBreakdown.Sum(x => x.VarianceOctoNona)</td>
                                    <td class="text-center">@_report.LguValidationBreakdown.Sum(x => x.VarianceCente)</td>
                                    <td class="text-center lgu-group-start">@ValidationRateAll.ToString("F1")%</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary mt-3">
                <i class="bi bi-info-circle me-1"></i>No endorsed applications found for the selected date range.
            </div>
        }
    }
</div>

@* ── Grantee drill-down for a clicked count — who is behind an LGU's
     Endorsed / Validated / Variance number. Same modal and Prev/Next paging
     as Statistics.razor's grantee audit modal; the list comes from the same
     filtered set the report was counted from, so it always adds up to the
     number that was clicked. ── *@
<HxModal @ref="_membersModal" Size="ModalSize.ExtraLarge" CssClass="stats-members-modal-wide">
    <HeaderTemplate>
        <h5 class="modal-title">
            <i class="bi bi-people-fill me-2"></i>
            @_membersModalTitle
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        @if (_isLoadingMembers)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 mb-0">Loading grantees...</p>
            </div>
        }
        else if (_membersError is not null)
        {
            <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>@_membersError
                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="FetchMembersPageAsync">Retry</button>
            </div>
        }
        else if (!_members.Any())
        {
            <div class="alert alert-info mb-0">No grantees found for this count.</div>
        }
        else
        {
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <span class="badge bg-primary fs-6">@_membersTotalCount Total</span>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_membersPageNumber <= 1 || _isLoadingMembers)"
                            @onclick="() => GoToMembersPageAsync(_membersPageNumber - 1)">
                        <i class="bi bi-chevron-left"></i> Prev
                    </button>
                    <span class="small text-muted">
                        Page @_membersPageNumber of @Math.Max(1, _membersTotalPages)
                        (@(((_membersPageNumber - 1) * MembersPageSize) + 1)–@Math.Min(_membersPageNumber * MembersPageSize, _membersTotalCount) of @_membersTotalCount)
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_membersPageNumber >= _membersTotalPages || _isLoadingMembers)"
                            @onclick="() => GoToMembersPageAsync(_membersPageNumber + 1)">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div style="max-height:65vh; overflow-y:auto;">
                <table class="table table-sm table-bordered table-hover align-middle mb-0" style="font-size:12px;">
                    <thead class="table-dark" style="position:sticky;top:0;z-index:1;">
                        <tr>
                            <th style="width:36px;">#</th>
                            <th>Full Name</th>
                            <th style="width:50px;">Age</th>
                            <th style="width:90px;">Milestone Year</th>
                            <th>OSCA ID</th>
                            <th>Batch Code</th>
                            <th>Location</th>
                            <th style="min-width:110px;">Date Endorsed</th>
                            <th style="min-width:130px;">Compliant</th>
                            <th style="min-width:220px;">Remarks (reason for variance)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = ((_membersPageNumber - 1) * MembersPageSize) + 1; }
                        @foreach (var m in _members)
                        {
                            <tr>
                                <td>@rowNum</td>
                                <td class="fw-semibold">@m.FullName</td>
                                <td>@m.Age</td>
                                <td>@(m.MilestoneYear > 0 ? m.MilestoneYear.ToString() : "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(m.OscaIdNumber) ? "—" : m.OscaIdNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(m.BatchCode) ? "—" : m.BatchCode)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(m.BarangayName))
                                    {
                                        <div>@m.BarangayName</div>
                                    }
                                    <div class="text-muted">@m.MunicipalityName, @m.ProvinceName</div>
                                </td>
                                <td>@(m.DateEndorsed.HasValue ? m.DateEndorsed.Value.ToLocalTime().ToString("MMM dd, yyyy") : "—")</td>
                                <td>
                                    <span class="badge @(m.IsCompliant ? "bg-success" : "bg-warning text-dark")">
                                        @(m.IsCompliant ? "Compliant" : "Not Compliant")
                                    </span>
                                    @if (m.IsCompliant && (m.ValidationDate.HasValue || !string.IsNullOrWhiteSpace(m.Validator)))
                                    {
                                        <div class="small text-muted">
                                            @(m.ValidationDate.HasValue ? m.ValidationDate.Value.ToLocalTime().ToString("MMM dd, yyyy") : "")
                                            @(string.IsNullOrWhiteSpace(m.Validator) ? "" : "· " + m.Validator)
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (m.IsCompliant || string.IsNullOrWhiteSpace(m.AssessmentRemarks))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        @m.AssessmentRemarks
                                    }
                                </td>
                            </tr>
                            rowNum++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _membersModal.HideAsync()">Close</HxButton>
    </FooterTemplate>
</HxModal>

@code {
    private bool _isLoading = true;
    private string? _loadError;
    private bool _filterExpanded = true;

    private LguValidationReportDto _report = new();

    private DateTime? _dateEndorsedFrom;
    private DateTime? _dateEndorsedTo;
    private DateTime? _dateAddedFrom;
    private DateTime? _dateAddedTo;
    private int _selectedMilestoneYear;

    // ── Summary cards ────────────────────────────────────────────────
    private int TotalEndorsedAll => _report.LguValidationBreakdown.Sum(x => x.EndorsedOctoNona + x.EndorsedCente);
    private int TotalValidatedAll => _report.LguValidationBreakdown.Sum(x => x.ValidatedOctoNona + x.ValidatedCente);
    private int TotalVarianceAll => TotalEndorsedAll - TotalValidatedAll;
    private double ValidationRateAll => TotalEndorsedAll == 0 ? 0 : Math.Round((double)TotalValidatedAll / TotalEndorsedAll * 100, 1);

    // ── Per-province chart ───────────────────────────────────────────
    // Octo/Nona and Cente combined into one figure per province — the table
    // below already keeps them split out, the chart is a bigger-picture view.
    private record ProvinceChartRow(string ProvinceName, int Endorsed, int Validated, int Variance);

    private List<ProvinceChartRow> ProvinceChartRows =>
        _report.LguValidationBreakdown
            .GroupBy(x => x.ProvinceName)
            .Select(g => new ProvinceChartRow(
                g.Key,
                g.Sum(x => x.EndorsedOctoNona + x.EndorsedCente),
                g.Sum(x => x.ValidatedOctoNona + x.ValidatedCente),
                g.Sum(x => x.VarianceOctoNona + x.VarianceCente)))
            .OrderByDescending(p => p.Endorsed)
            .ToList();

    // Bar widths are scaled against the largest province's Endorsed total, not
    // 100% each, so the chart still reads as a magnitude comparison across
    // provinces rather than every bar looking equally "full".
    private int MaxProvinceEndorsed => ProvinceChartRows.Count > 0
        ? Math.Max(1, ProvinceChartRows.Max(p => p.Endorsed))
        : 1;

    protected override async Task OnInitializedAsync() => await LoadReportAsync();

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            // Everything except Date Added / Date Endorsed / Milestone Year is left
            // at its "no filter" default (0 / null, PaymentStatus -1) — the shared
            // report endpoint treats those as "don't narrow by this", so this page
            // never applies Statistics.razor's Region/Province/Municipality/Payment/
            // Quarter/Fiscal-Year filters, since those live entirely on that page.
            var request = new ApplicationsValidationsRequestDto
            {
                DateEndorsedFrom = _dateEndorsedFrom,
                DateEndorsedTo = _dateEndorsedTo,
                DateAddedFrom = _dateAddedFrom,
                DateAddedTo = _dateAddedTo,
                MilestoneYear = _selectedMilestoneYear
            };

            var response = await Http.PostAsJsonAsync("api/Statistics/report", request);

            if (response.IsSuccessStatusCode)
            {
                _report = await response.Content.ReadFromJsonAsync<LguValidationReportDto>() ?? new();
                _loadedRequest = request;
            }
            else
            {
                _loadError = "Failed to load the report. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Could not reach the server: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── Clickable counts + grantee drill-down ─────────────────────────
    private const int MembersPageSize = 50;
    private HxModal _membersModal = default!;
    private string _membersModalTitle = string.Empty;
    private string _membersBucket = string.Empty;
    private bool _isLoadingMembers;
    private string? _membersError;
    private List<SharedDtos.StatisticsMemberDto> _members = new();
    private int _membersPageNumber = 1;
    private int _membersTotalCount;
    private int _membersTotalPages;

    // The filters the CURRENTLY DISPLAYED report was loaded with — not whatever
    // is typed into the filter panel since (those only apply on Apply). Drilling
    // in, and paging through the list, must use these so the grantees always add
    // up to the number that was clicked.
    private ApplicationsValidationsRequestDto _loadedRequest = new();

    // A count as a link when there's someone behind it; a plain number (or
    // muted 0) otherwise. measure: endorsed | validated | variance;
    // ageGroup: octonona | cente.
    private RenderFragment LguCount(LguValidationStatisticsDto lgu, string measure, string ageGroup, int count) => builder =>
    {
        if (count <= 0)
        {
            builder.AddContent(0, count.ToString());
            return;
        }

        builder.OpenElement(1, "button");
        builder.AddAttribute(2, "type", "button");
        builder.AddAttribute(3, "class", "lgu-count-link");
        builder.AddAttribute(4, "title", "Click to view the grantees in this count");
        builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => OpenMembersModalAsync(lgu, measure, ageGroup)));
        builder.AddContent(6, count.ToString());
        builder.CloseElement();
    };

    private async Task OpenMembersModalAsync(LguValidationStatisticsDto lgu, string measure, string ageGroup)
    {
        var measureLabel = measure switch
        {
            "endorsed" => "Endorsed",
            "validated" => "Validated",
            _ => "Variance (awaiting validation)"
        };
        var groupLabel = ageGroup == "cente" ? "Cente (100+)" : "Octo/Nona (80–99)";

        _membersModalTitle = $"{lgu.MunicipalityName}, {lgu.ProvinceName} — {measureLabel} — {groupLabel}";
        _membersBucket = $"lgu:{lgu.MunicipalityCode}:{measure}:{ageGroup}";
        _membersPageNumber = 1;
        _members = new();
        _membersTotalCount = 0;
        _membersTotalPages = 0;
        _membersError = null;
        await _membersModal.ShowAsync();
        await FetchMembersPageAsync();
    }

    private async Task GoToMembersPageAsync(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > _membersTotalPages || _isLoadingMembers) return;
        _membersPageNumber = pageNumber;
        await FetchMembersPageAsync();
    }

    private async Task FetchMembersPageAsync()
    {
        _isLoadingMembers = true;
        _membersError = null;
        StateHasChanged();

        try
        {
            var request = new LguMembersRequestDto
            {
                Filter = _loadedRequest,
                Bucket = _membersBucket,
                PageNumber = _membersPageNumber,
                PageSize = MembersPageSize
            };

            var response = await Http.PostAsJsonAsync("api/Statistics/members", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SharedDtos.StatisticsMembersPagedResultDto>();
                _members = result?.Items ?? new();
                _membersTotalCount = result?.TotalCount ?? 0;
                _membersTotalPages = result?.TotalPages ?? 0;
            }
            else
            {
                _membersError = "Failed to load the grantees. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _membersError = $"Could not reach the server: {ex.Message}";
        }
        finally
        {
            _isLoadingMembers = false;
            StateHasChanged();
        }
    }

    private void ToggleFilter() => _filterExpanded = !_filterExpanded;

    private void ClearFilters()
    {
        _dateEndorsedFrom = null;
        _dateEndorsedTo = null;
        _dateAddedFrom = null;
        _dateAddedTo = null;
        _selectedMilestoneYear = 0;
    }

    private async Task ApplyFiltersAsync() => await LoadReportAsync();
    private async Task RefreshAsync() => await LoadReportAsync();

    // ── DTOs ──────────────────────────────────────────────────────────
    // Only the fields this page actually sends/reads — the shared endpoint's
    // full request/response shapes have many more fields (Region, Province,
    // Milestone, Payment, etc.); System.Text.Json ignores whatever's on the
    // wire that isn't declared here, so this page stays self-contained
    // without pulling in Statistics.razor's whole filter model.
    public class ApplicationsValidationsRequestDto
    {
        public int PaymentStatus { get; set; } = -1;
        public int MilestoneYear { get; set; }
        public DateTime? DateEndorsedFrom { get; set; }
        public DateTime? DateEndorsedTo { get; set; }
        public DateTime? DateAddedFrom { get; set; }
        public DateTime? DateAddedTo { get; set; }
    }

    // Same shape the shared members endpoint takes: the report's own filters
    // plus which cell ("lgu:{municipalityCode}:{measure}:{ageGroup}") and page.
    public class LguMembersRequestDto
    {
        public ApplicationsValidationsRequestDto Filter { get; set; } = new();
        public string Bucket { get; set; } = string.Empty;
        public int PageNumber { get; set; } = 1;
        public int PageSize { get; set; } = 50;
    }

    public class LguValidationReportDto
    {
        public List<LguValidationStatisticsDto> LguValidationBreakdown { get; set; } = new();
    }

    public class LguValidationStatisticsDto
    {
        public string ProvinceName { get; set; } = string.Empty;
        public string MunicipalityName { get; set; } = string.Empty;
        public int MunicipalityCode { get; set; }
        public int EndorsedOctoNona { get; set; }
        public int EndorsedCente { get; set; }
        public int ValidatedOctoNona { get; set; }
        public int ValidatedCente { get; set; }
        public int VarianceOctoNona { get; set; }
        public int VarianceCente { get; set; }
        public string ReasonsOctoNona { get; set; } = "-";
        public string ReasonsCente { get; set; } = "-";
    }
}
