@* StatisticsMunicipalityBreakdown.razor — collapsible per-municipality table,
   own show/hide state since it's the heaviest table on the page. *@
@using EcaInformationSystem.Client.Pages.Statistics

@if (Report.MunicipalityBreakdowns.Any())
{
    <div class="sys-card mt-3">
        <div class="sys-card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-building me-2"></i>Breakdown by Municipality</span>
            <button class="btn btn-sm btn-light" @onclick="Toggle">
                @(_showTable ? "Hide" : "Show")
            </button>
        </div>
        @if (_showTable)
        {
            <div class="sys-card-body p-0">
                <div class="table-responsive" style="max-height:500px; overflow-y:auto;">
                    <table class="table table-hover table-sm mb-0 stat-table">
                        <thead class="table-dark position-sticky top-0" style="z-index:1;">
                            <tr>
                                <th>Municipality</th>
                                <th>Province</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">80</th>
                                <th class="text-center">85</th>
                                <th class="text-center">90</th>
                                <th class="text-center">95</th>
                                <th class="text-center">100</th>
                                <th class="text-center">M</th>
                                <th class="text-center">F</th>
                                <th class="text-end">Disbursed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Report.MunicipalityBreakdowns.OrderBy(x => x.ProvinceName).ThenBy(x => x.MunicipalityName))
                            {
                                <tr>
                                    <td>@m.MunicipalityName</td>
                                    <td>@m.ProvinceName</td>
                                    <td class="text-center">@m.TotalCount.ToString("N0")</td>
                                    <td class="text-center">@m.Age80Count</td>
                                    <td class="text-center">@m.Age85Count</td>
                                    <td class="text-center">@m.Age90Count</td>
                                    <td class="text-center">@m.Age95Count</td>
                                    <td class="text-center">@m.Age100Count</td>
                                    <td class="text-center">@m.MaleCount</td>
                                    <td class="text-center">@m.FemaleCount</td>
                                    <td class="text-end">₱@m.TotalDisbursement.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary fw-bold">
                            <tr>
                                <td colspan="2">TOTAL</td>
                                <td class="text-center">@Report.TotalBeneficiaries.ToString("N0")</td>
                                <td class="text-center">@Report.TotalAge80</td>
                                <td class="text-center">@Report.TotalAge85</td>
                                <td class="text-center">@Report.TotalAge90</td>
                                <td class="text-center">@Report.TotalAge95</td>
                                <td class="text-center">@Report.TotalAge100</td>
                                <td class="text-center">@Report.TotalMale</td>
                                <td class="text-center">@Report.TotalFemale</td>
                                <td class="text-end">₱@Report.TotalDisbursement.ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public StatisticsReportDto Report { get; set; } = new();

    private bool _showTable;

    private void Toggle() => _showTable = !_showTable;
}
