@* StatisticsChartsRow.razor — age distribution bars + payment status breakdown chart. *@
@using EcaInformationSystem.Client.Pages.Statistics

<div class="dash-row">
    @* ── Age Distribution ────────────────────────────────── *@
    <div class="dash-card">
        <div class="dash-card-header">
            <i class="bi bi-graph-up-arrow me-2"></i>
            Distribution by Milestone Age
        </div>
        <div class="dash-card-body">
            <div class="milestone-chart">
                @foreach (var item in Report.AgeDistribution)
                {
                    var pct = Report.TotalBeneficiaries > 0
                        ? (double)item.Count / Report.TotalBeneficiaries * 100
                        : 0;
                    <div class="milestone-bar-wrap">
                        <span class="milestone-bar-label">@item.Age</span>
                        <div class="milestone-bar-track">
                            <div class="milestone-bar milestone-bar--@GetAgeColor(item.Age)"
                                 style="width:@Math.Max(4, pct)%;">
                                <span class="milestone-bar-count">@item.Count</span>
                            </div>
                        </div>
                        <span class="milestone-bar-pct">@pct.ToString("F1")%</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Payment Status ───────────────────────────────────── *@
    <div class="dash-card">
        <div class="dash-card-header">
            <i class="bi bi-pie-chart-fill me-2"></i>
            Payment Status Breakdown
        </div>
        <div class="dash-card-body dash-card-body--center">
            <div class="dash-chart">
                @{
                    var maxPayment = Math.Max(1, new[] { Report.PaidCount, Report.UnpaidCount, Report.PendingCount, Report.NotApplicableCount }.Max());
                }
                <div class="dash-chart-bar-wrap">
                    <span class="dash-chart-bar-value">@Report.PaidCount.ToString("N0")</span>
                    <div class="dash-chart-bar dash-chart-bar--green"
                         style="height:@(GetBarHeight(Report.PaidCount, maxPayment))%;">
                    </div>
                    <span class="dash-chart-bar-label">Paid</span>
                </div>
                <div class="dash-chart-bar-wrap">
                    <span class="dash-chart-bar-value">@Report.UnpaidCount.ToString("N0")</span>
                    <div class="dash-chart-bar dash-chart-bar--red"
                         style="height:@(GetBarHeight(Report.UnpaidCount, maxPayment))%;">
                    </div>
                    <span class="dash-chart-bar-label">Unpaid</span>
                </div>
                <div class="dash-chart-bar-wrap">
                    <span class="dash-chart-bar-value">@Report.PendingCount.ToString("N0")</span>
                    <div class="dash-chart-bar dash-chart-bar--amber"
                         style="height:@(GetBarHeight(Report.PendingCount, maxPayment))%;">
                    </div>
                    <span class="dash-chart-bar-label">Pending</span>
                </div>
                <div class="dash-chart-bar-wrap">
                    <span class="dash-chart-bar-value">@Report.NotApplicableCount.ToString("N0")</span>
                    <div class="dash-chart-bar dash-chart-bar--gray"
                         style="height:@(GetBarHeight(Report.NotApplicableCount, maxPayment))%;">
                    </div>
                    <span class="dash-chart-bar-label">N/A</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public StatisticsReportDto Report { get; set; } = new();

    private static int GetBarHeight(int value, int max) =>
        max == 0 ? 0 : Math.Max(4, (int)Math.Round((double)value / max * 100));

    private static string GetAgeColor(int age) => age switch
    {
        80 => "80",
        85 => "85",
        90 => "90",
        95 => "95",
        100 => "100",
        _ => "80"
    };
}
