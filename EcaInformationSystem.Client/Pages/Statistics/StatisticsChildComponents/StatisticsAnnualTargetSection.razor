@* StatisticsAnnualTargetSection.razor — Annual Grantee Target vs actual-paid comparison.
   The target is set per (Region, FiscalYear) by that region's Admin/SuperAdmin, split
   across the 4 payroll quarters however the PDO organized its rollout. "Paid" here
   reflects the stored PayrollQuarter/FiscalYear columns on BeneficiaryPaymentHistory —
   the same authoritative fields used to filter the rest of the Statistics page — not
   a PaymentDate-derived calendar bucket, so it always matches whatever quarter/year the
   payroll was actually run under. *@
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject HttpClient Http
@inject AuthService AuthService
@inject ToastService Toast

<div class="sys-card mb-3">
    <div class="sys-card-header annual-target-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span><i class="bi bi-bullseye me-2"></i>Annual Grantee Target@(_comparison?.RegionName is { } rn ? $" — {rn}" : "")</span>
        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm" style="width:auto;" @bind="SelectedFiscalYear">
                @* Always includes next year, whatever "now" is — e.g. viewed in 2027 this
                   naturally starts at 2028, no fixed cutoff to remember to bump. *@
                @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                {
                    <option value="@y">@y</option>
                }
            </select>
            @if (_isAdmin)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="OpenEditor">
                    <i class="bi bi-pencil-square me-1"></i>@(_comparison?.HasTarget == true ? "Edit Target" : "Set Target")
                </button>
            }
        </div>
    </div>

    <div class="sys-card-body">
        @if (_isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary"></div>
                <span class="ms-2 text-muted">Loading target...</span>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="alert alert-danger py-2 mb-0">@_loadError</div>
        }
        else if (_comparison is not null)
        {
            @if (!_comparison.HasTarget)
            {
                <div class="alert alert-secondary py-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    No annual target has been set for @_comparison.RegionName in @SelectedFiscalYear yet.
                    @if (_isAdmin)
                    {
                        <span>Click <strong>Set Target</strong> above to add one.</span>
                    }
                </div>
            }
            else
            {
                @* One merged ring instead of 4 separate ones — three stacked arcs that
                   always sum to exactly the Annual Target: Paid (green), Due-but-unpaid
                   i.e. behind pace (red), and Not-Yet-Due i.e. later quarters (gray).
                   Re-derived from _comparison every load/fiscal-year switch/save, so
                   nothing here is hardcoded. _ringAnimateReady starts false and flips
                   true a beat after the data arrives (see AnimateRingsInAsync) — the
                   arcs render at 0-length first, then the CSS transition sweeps them
                   out to their real length, so the ring visibly "fills in" every time
                   this component mounts, i.e. every time the user navigates here. *@
                <div class="target-ring-wrap mb-2">
                    <div class="target-ring-goal">
                        <span class="target-ring-goal-badge"><i class="bi bi-flag-fill"></i> Full-Year Target</span>
                        <span class="target-ring-goal-value">@_comparison.AnnualTarget.ToString("N0")</span>
                        @if (_comparison.TotalPaidYtd > _comparison.AnnualTarget)
                        {
                            <span class="target-ring-goal-exceeded">
                                <i class="bi bi-trophy-fill"></i> Exceeded by @((_comparison.TotalPaidYtd - _comparison.AnnualTarget).ToString("N0"))
                            </span>
                        }
                    </div>

                    <div class="target-ring-glow-wrap">
                        <div class="target-ring-glow"></div>
                        <div class="target-ring target-ring--merged">
                            <svg viewBox="0 0 200 200">
                                <defs>
                                    <linearGradient id="target-grad-paid" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#22c55e" />
                                        <stop offset="100%" stop-color="#15803d" />
                                    </linearGradient>
                                    <linearGradient id="target-grad-behind" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#ef4444" />
                                        <stop offset="100%" stop-color="#b91c1c" />
                                    </linearGradient>
                                    <linearGradient id="target-grad-notdue" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#e2e8f0" />
                                        <stop offset="100%" stop-color="#b6c2d1" />
                                    </linearGradient>
                                </defs>
                                <circle class="target-ring-track" cx="100" cy="100" r="@RingRadius"></circle>
                                <circle class="target-ring-fill" cx="100" cy="100" r="@RingRadius"
                                        style="stroke:url(#target-grad-paid); stroke-dasharray:@SegDashArray(PaidCapped); stroke-dashoffset:0;"></circle>
                                <circle class="target-ring-fill" cx="100" cy="100" r="@RingRadius"
                                        style="stroke:url(#target-grad-behind); stroke-dasharray:@SegDashArray(DueUnpaid); stroke-dashoffset:@SegDashOffset(PaidCapped);"></circle>
                                <circle class="target-ring-fill" cx="100" cy="100" r="@RingRadius"
                                        style="stroke:url(#target-grad-notdue); stroke-dasharray:@SegDashArray(NotYetDue); stroke-dashoffset:@SegDashOffset(PaidCapped + DueUnpaid);"></circle>
                            </svg>
                            <div class="target-ring-center">
                                <div class="target-ring-center-value">@_comparison.TotalPaidYtd.ToString("N0")</div>
                                <div class="target-ring-center-sub">@FormatPercent(PaidPercent) of @_comparison.AnnualTarget.ToString("N0")</div>
                            </div>
                        </div>
                    </div>

                    <div class="target-ring-legend target-ring-legend--row">
                        <div class="target-ring-legend-card target-ring-legend-card--paid target-ring-legend-row--anim">
                            <div class="target-ring-legend-icon"><i class="bi bi-check-circle-fill"></i></div>
                            <span class="target-ring-legend-text">
                                <strong>@_comparison.TotalPaidYtd.ToString("N0")</strong> Paid
                                <span class="target-ring-legend-sub">Through @ThroughQuarterLabel</span>
                            </span>
                        </div>
                        <div class="target-ring-legend-card target-ring-legend-card--behind target-ring-legend-row--anim">
                            <div class="target-ring-legend-icon"><i class="bi @(DueUnpaid > 0 ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i></div>
                            <span class="target-ring-legend-text">
                                <strong>@DueUnpaid.ToString("N0")</strong> @(DueUnpaid > 0 ? "Behind Pace" : "On Pace")
                                <span class="target-ring-legend-sub">Due through @ThroughQuarterLabel, not yet paid</span>
                            </span>
                        </div>
                        <div class="target-ring-legend-card target-ring-legend-card--notdue target-ring-legend-row--anim">
                            <div class="target-ring-legend-icon"><i class="bi bi-hourglass-split"></i></div>
                            <span class="target-ring-legend-text">
                                <strong>@NotYetDue.ToString("N0")</strong> Not Yet Due
                                <span class="target-ring-legend-sub">Remaining quarters this fiscal year</span>
                            </span>
                        </div>
                    </div>
                </div>

                @* ── Extra context beyond the ring itself: a pace projection
                     (pure math on numbers already in _comparison — no new
                     fetch) and a same-endpoint lookup of last fiscal year's
                     comparison for a trend chip. Both best-effort — if last
                     year has no target on file, that chip just doesn't
                     render instead of showing a misleading comparison. ── *@
                <div class="target-info-chips">
                    @if (ThroughQuarter > 0 && ProjectedYearEnd is { } projected)
                    {
                        <div class="target-info-chip">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>
                                At this pace, projected to reach <strong>@projected.ToString("N0")</strong> by year-end
                                <span class="target-info-chip-sub">(@FormatPercent(_comparison.AnnualTarget > 0 ? (double)projected / _comparison.AnnualTarget * 100 : 0) of target)</span>
                            </span>
                        </div>
                    }
                    @if (_previousYearComparison is { HasTarget: true } prev)
                    {
                        @* Same-quarter-cutoff comparison, not prior year's full-year
                           total — sums only the prior year's quarters up through
                           the same ThroughQuarter this year is being measured
                           against, so it's an honest apples-to-apples "at this
                           point in the year" comparison rather than partial vs whole. *@
                        var prevThroughSamePoint = prev.Quarterly.Where(q => q.Quarter <= ThroughQuarter).Sum(q => q.PaidCount);
                        var delta = prevThroughSamePoint > 0
                            ? (int)Math.Round((double)(_comparison.TotalPaidYtd - prevThroughSamePoint) / prevThroughSamePoint * 100)
                            : (int?)null;
                        <div class="target-info-chip">
                            <i class="bi bi-calendar2-week"></i>
                            <span>
                                FY@(SelectedFiscalYear - 1) through @ThroughQuarterLabel: <strong>@prevThroughSamePoint.ToString("N0")</strong> paid
                                @if (delta.HasValue)
                                {
                                    <span class="target-info-chip-delta @(delta.Value >= 0 ? "target-info-chip-delta--up" : "target-info-chip-delta--down")">
                                        <i class="bi @(delta.Value >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>@Math.Abs(delta.Value)%
                                    </span>
                                }
                            </span>
                        </div>
                    }
                </div>

                @if (_comparison.DateSet is not null)
                {
                    <p class="text-muted small mb-2">
                        <i class="bi bi-person-check me-1"></i>
                        Set by <strong>@_comparison.SetBy</strong> on @_comparison.DateSet.Value.ToLocalTime().ToString("MMMM dd, yyyy")
                        @if (_comparison.DateModified is not null)
                        {
                            <span>&nbsp;— last updated by <strong>@_comparison.ModifiedBy</strong> on @_comparison.DateModified.Value.ToLocalTime().ToString("MMMM dd, yyyy")</span>
                        }
                    </p>
                }

                <p class="text-muted small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    "Ahead/Behind Pace" compares grantees actually paid against the target accumulated only
                    through @ThroughQuarterLabel — not the full-year target — so progress reads correctly
                    partway through the year.
                </p>

                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 stat-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Quarter</th>
                                <th class="text-end">Target</th>
                                <th class="text-end">Paid</th>
                                <th class="text-end">Variance</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in _comparison.Quarterly)
                            {
                                var variance = q.PaidCount - q.Target;
                                var rowAccent = q.Target == 0 ? "quarter-row--none" : q.PaidCount >= q.Target ? "quarter-row--met" : "quarter-row--behind";
                                <tr class="@rowAccent">
                                    <td class="fw-semibold">@q.QuarterLabel <span class="text-muted small">(@QuarterMonthRange(q.Quarter - 1))</span></td>
                                    <td class="text-end">@q.Target.ToString("N0")</td>
                                    <td class="text-end">@q.PaidCount.ToString("N0")</td>
                                    <td class="text-end @(variance > 0 ? "text-success" : variance < 0 ? "text-danger" : "text-muted") fw-semibold">
                                        @(variance > 0 ? "+" : "")@variance.ToString("N0")
                                    </td>
                                    <td class="text-center">
                                        @if (q.Target == 0)
                                        {
                                            <span class="badge bg-secondary">No Target Set</span>
                                        }
                                        else if (q.PaidCount >= q.Target)
                                        {
                                            <span class="badge bg-success">Met / Exceeded</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Behind</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary fw-bold">
                            <tr>
                                <td>TOTAL (Full Year)</td>
                                <td class="text-end">@_comparison.AnnualTarget.ToString("N0")</td>
                                <td class="text-end">@_comparison.TotalPaidYtd.ToString("N0")</td>
                                <td class="text-end @(_comparison.TotalPaidYtd - _comparison.AnnualTarget >= 0 ? "text-success" : "text-danger")">
                                    @((_comparison.TotalPaidYtd - _comparison.AnnualTarget) > 0 ? "+" : "")@((_comparison.TotalPaidYtd - _comparison.AnnualTarget).ToString("N0"))
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        }
    </div>
</div>

@* ══════════════════ SET / EDIT TARGET MODAL ══════════════════ *@
@if (_showEditor)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-bullseye me-2"></i>@(_comparison?.HasTarget == true ? "Edit" : "Set") Annual Grantee Target — @SelectedFiscalYear</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Split the year's grantee-served target across the 4 payroll quarters however this
                        region has organized its rollout — the quarters don't need to be equal.
                    </p>

                    @* Running total banner — always visible while editing, so the effect of
                       each keystroke is immediately obvious. *@
                    <div class="d-flex align-items-center justify-content-between p-2 mb-3 rounded"
                         style="background:#eef2f8; border:1px solid #cfe0f5;">
                        <span class="fw-semibold text-primary"><i class="bi bi-calculator me-1"></i>Annual Total</span>
                        <span class="fs-5 fw-bold text-primary">@_editQuarterly.Sum().ToString("N0")</span>
                    </div>

                    <div class="row g-3">
                        @for (int i = 0; i < 4; i++)
                        {
                            var idx = i;
                            <div class="col-md-3 col-sm-6 col-12">
                                <label class="form-label small mb-1 fw-semibold">Q@(idx + 1) <span class="text-muted fw-normal">(@QuarterMonthRange(idx))</span></label>
                                <input type="number" min="0" class="form-control"
                                       @bind="_editQuarterly[idx]" />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button class="btn btn-outline-danger" @onclick="RequestClearAll">
                        <i class="bi bi-eraser me-1"></i>Clear All
                    </button>
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary" @onclick="CloseEditor">Cancel</button>
                        <button class="btn btn-primary" @onclick="RequestSave">
                            <i class="bi bi-save me-1"></i>Save Target
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ══════════════════ SHARED CAUTION / CONFIRMATION MODAL ══════════════════
   Used for both "Save Target" and "Clear All" — same caution treatment for
   any action that changes what gets persisted, so neither feels like an
   afterthought next to the other. *@
@if (_pendingAction is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.6); z-index:1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-warning-emphasis">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>@_pendingActionTitle
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelPendingAction"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@_pendingActionMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelPendingAction" disabled="@_isSaving">Cancel</button>
                    <button class="btn @(_pendingAction == "clear" ? "btn-danger" : "btn-primary")"
                            @onclick="ConfirmPendingActionAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span>Working...</span>
                        }
                        else
                        {
                            <span>@(_pendingAction == "clear" ? "Yes, Clear All" : "Yes, Save Target")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] QuarterMonthRanges = { "Jan–Mar", "Apr–Jun", "Jul–Sep", "Oct–Dec" };

    private int _fiscalYear = DateTime.Now.Year;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isAdmin;
    private string? _loadError;
    private bool _showEditor;
    private readonly int[] _editQuarterly = new int[4];

    // "save" or "clear" — null means no confirmation dialog is showing.
    private string? _pendingAction;
    private string _pendingActionTitle = string.Empty;
    private string _pendingActionMessage = string.Empty;

    private AnnualTargetComparisonDto? _comparison;
    // Best-effort lookup of the prior fiscal year's comparison, via the same
    // existing api/AnnualGranteeTarget/{fiscalYear} endpoint already used
    // above — just called again with fiscalYear-1, purely to power the
    // "vs last year" trend chip. Null (and the chip just doesn't render) if
    // the prior year has no target on file or the call fails.
    private AnnualTargetComparisonDto? _previousYearComparison;

    private int SelectedFiscalYear
    {
        get => _fiscalYear;
        set
        {
            if (_fiscalYear == value) return;
            _fiscalYear = value;
            _ = LoadAsync();
        }
    }

    // How many quarters of this fiscal year have actually elapsed: fully
    // elapsed for past years, up through the current calendar quarter for the
    // current year, and none yet for a future year — comparing "paid so far"
    // against the WHOLE year's target on day one of Q1 would make every
    // region look wildly behind, and against a future year's target would
    // look wildly ahead, so this scopes the target down to only the quarters
    // that have actually happened.
    private int ThroughQuarter => _fiscalYear < DateTime.Now.Year ? 4
        : _fiscalYear > DateTime.Now.Year ? 0
        : (DateTime.Now.Month - 1) / 3 + 1;

    private string ThroughQuarterLabel => ThroughQuarter == 0 ? "Now" : $"Q{ThroughQuarter}";

    private int TargetToDate => _comparison?.Quarterly.Where(q => q.Quarter <= ThroughQuarter).Sum(q => q.Target) ?? 0;

    private double PaidPercent => _comparison is { AnnualTarget: > 0 }
        ? (double)_comparison.TotalPaidYtd / _comparison.AnnualTarget * 100 : 0;

    private static string FormatPercent(double percent) => $"{Math.Round(percent):0}%";

    // ── Merged-ring segments — always sum to exactly AnnualTarget ──────
    // Paid is capped at the target so an overachieving region still draws a
    // clean 100% ring (the "Exceeded by" note in the legend covers the rest,
    // instead of the arc math trying to draw past a full circle).
    private double PaidCapped => _comparison is null ? 0
        : Math.Min(_comparison.TotalPaidYtd, _comparison.AnnualTarget);

    private double DueUnpaid => _comparison is null ? 0
        : Math.Max(0, TargetToDate - _comparison.TotalPaidYtd);

    private double NotYetDue => _comparison is null ? 0
        : Math.Max(0, _comparison.AnnualTarget - PaidCapped - DueUnpaid);

    // Simple run-rate projection: (paid so far ÷ quarters elapsed) × 4 —
    // pure math on _comparison's own numbers, no new data. Null before Q1
    // has even started (ThroughQuarter == 0) or once the year's fully
    // elapsed (the actual total is already the real number, no need to
    // project it).
    private int? ProjectedYearEnd => _comparison is null || ThroughQuarter is 0 or 4
        ? null
        : (int)Math.Round((double)_comparison.TotalPaidYtd / ThroughQuarter * 4);

    // The ring's <svg>/<circle> elements are written as literal markup above
    // (not via MarkupString/RenderFragment) so Blazor's CSS-isolation
    // attribute actually gets applied to them — a dynamically-injected
    // MarkupString never receives the scoped-CSS attribute, so the
    // .target-ring-* rules in the .razor.css file would silently never match.
    // Only each segment's fill length/offset is computed dynamically.
    private const double RingRadius = 82;
    private const double RingCircumference = 2 * Math.PI * RingRadius;

    // Starts false so every segment renders at 0-length on first paint; a
    // beat later (see AnimateRingsInAsync) it flips true and the CSS
    // transition on stroke-dasharray sweeps every arc out to its real length
    // at once — the "cool moving" fill-in that replays every time this
    // component (re)mounts, i.e. every time the user navigates to Statistics
    // or switches fiscal year / saves a new target.
    private bool _ringAnimateReady;

    private double SegLen(double count) => _comparison is { AnnualTarget: > 0 }
        ? RingCircumference * count / _comparison.AnnualTarget : 0;

    private string SegDashArray(double count)
    {
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        var len = _ringAnimateReady ? SegLen(count) : 0;
        return $"{len.ToString("0.##", ic)} {RingCircumference.ToString("0.##", ic)}";
    }

    private string SegDashOffset(double precedingCount)
    {
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        return (-SegLen(precedingCount)).ToString("0.##", ic);
    }

    private async Task AnimateRingsInAsync()
    {
        _ringAnimateReady = false;
        await Task.Delay(80); // let the 0-length arcs paint first, or the CSS transition has nothing to animate FROM
        _ringAnimateReady = true;
        StateHasChanged();
    }

    private static string QuarterMonthRange(int quarterIndex) => QuarterMonthRanges[quarterIndex];

    protected override async Task OnInitializedAsync()
    {
        // AuthService's role cache is populated asynchronously (from the stored
        // JWT) — without awaiting InitAsync() here, IsAdmin() can read the cache
        // before it's warmed up on a fresh page load, which is what was making
        // the Edit/Set Target button intermittently disappear for actual admins.
        await AuthService.InitAsync();
        _isAdmin = AuthService.IsAdmin();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        _previousYearComparison = null;
        try
        {
            _comparison = await Http.GetFromJsonAsync<AnnualTargetComparisonDto>($"api/AnnualGranteeTarget/{_fiscalYear}");
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load the annual target: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
            _ = AnimateRingsInAsync();
        }

        // Best-effort, same endpoint, previous year — powers the "vs last
        // year" trend chip only. Never blocks or fails the main load above;
        // if the region simply has no target on file for that year (or the
        // call errors), the chip just doesn't render.
        try
        {
            _previousYearComparison = await Http.GetFromJsonAsync<AnnualTargetComparisonDto>($"api/AnnualGranteeTarget/{_fiscalYear - 1}");
            StateHasChanged();
        }
        catch
        {
            _previousYearComparison = null;
        }
    }

    private void OpenEditor()
    {
        if (_comparison is not null)
        {
            for (int i = 0; i < 4; i++)
                _editQuarterly[i] = _comparison.Quarterly.FirstOrDefault(q => q.Quarter == i + 1)?.Target ?? 0;
        }
        _showEditor = true;
    }

    private void CloseEditor() => _showEditor = false;

    private void RequestClearAll()
    {
        _pendingAction = "clear";
        _pendingActionTitle = "Clear All Quarterly Targets?";
        _pendingActionMessage = $"This resets all 4 quarters back to 0 for FY {SelectedFiscalYear}. " +
            "Nothing is saved yet — you can still Cancel here, or Cancel out of the editor afterward without saving.";
    }

    private void RequestSave()
    {
        var total = _editQuarterly.Sum();
        _pendingAction = "save";
        _pendingActionTitle = "Save Annual Grantee Target?";
        _pendingActionMessage = $"You're about to set the FY {SelectedFiscalYear} target for " +
            $"{_comparison?.RegionName} to {total:N0} grantees for the year, split across the 4 quarters you entered. " +
            "This replaces any existing target for this region and year.";
    }

    private void CancelPendingAction() => _pendingAction = null;

    private async Task ConfirmPendingActionAsync()
    {
        if (_pendingAction == "clear")
        {
            for (int i = 0; i < 4; i++) _editQuarterly[i] = 0;
            _pendingAction = null;
            return;
        }

        await SaveTargetAsync();
        _pendingAction = null;
    }

    private async Task SaveTargetAsync()
    {
        _isSaving = true;
        try
        {
            var dto = new UpsertAnnualGranteeTargetDto
            {
                FiscalYear = _fiscalYear,
                QuarterlyTargets = _editQuarterly.ToArray()
            };

            var response = await Http.PutAsJsonAsync("api/AnnualGranteeTarget", dto);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Toast.ShowError(string.IsNullOrWhiteSpace(error) ? "Failed to save the target." : error);
                return;
            }

            Toast.ShowSuccess("Annual target saved.");
            _showEditor = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to save the target: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }
}
