@* StatisticsFilterPanel.razor — self-contained filter card for the Statistics page.
   Owns its own region/province/municipality cascading lookups and all filter state;
   emits the built StatisticsRequestDto whenever Apply or Clear is clicked so the
   parent page doesn't need to know anything about individual filter fields. *@
@using EcaInformationSystem.Client.Pages.Statistics
@using EcaInformationSystem.Client.Services
@inject HttpClient Http
@inject AuthService AuthService

<div class="sf-card">
    <div class="sf-header" @onclick="ToggleFilter">
        <div class="sf-header-left">
            <div class="sf-header-icon"><i class="bi bi-funnel"></i></div>
            <div>
                <div class="sf-header-title">Filters</div>
                <div class="sf-header-sub">Narrow down statistics</div>
            </div>
        </div>
        <i class="bi bi-chevron-up sf-chevron @(_filterExpanded ? "open" : "")"></i>
    </div>
    @if (_filterExpanded)
    {
        <div class="sf-body">
            <div class="sf-grid">
                @* ── Region ────────────────────────────────────────── *@
                <div class="sf-field">
                    <label>Region</label>
                    <select @bind="SelectedRegion" class="ff-input">
                        <option value="0">All Regions</option>
                        @foreach (var region in _regions)
                        {
                            <option value="@region.PsgcCodeRegion">@region.Name</option>
                        }
                    </select>
                </div>

                @* ── Province ────────────────────────────────────── *@
                <div class="sf-field">
                    <label>Province</label>
                    <select @bind="SelectedProvince" class="ff-input"
                            disabled="@(_selectedRegionId == 0)">
                        <option value="0">All Provinces</option>
                        @foreach (var province in _provincesForRegion)
                        {
                            <option value="@province.PsgcCodeProvince">@province.Name</option>
                        }
                    </select>
                    @if (_isLoadingProvinces)
                    {
                        <span class="sf-loading-pill">
                            <span class="spinner-border spinner-border-sm"></span> Loading...
                        </span>
                    }
                </div>

                @* ── Municipality ────────────────────────────────── *@
                <div class="sf-field">
                    <label>Municipality</label>
                    <select @bind="SelectedMunicipality" class="ff-input"
                            disabled="@(_selectedProvinceId == 0)">
                        <option value="0">All Municipalities</option>
                        @foreach (var muni in _municipalitiesForProvince)
                        {
                            <option value="@muni.PsgcCodeMunicipality">@muni.Name</option>
                        }
                    </select>
                    @if (_isLoadingMunicipalities)
                    {
                        <span class="sf-loading-pill">
                            <span class="spinner-border spinner-border-sm"></span> Loading...
                        </span>
                    }
                </div>

                @* ── Milestone Year ────────────────────────────────── *@
                <div class="sf-field">
                    <label>Milestone Year</label>
                    <select @bind="_selectedMilestoneYear" class="ff-input">
                        <option value="0">All Milestone Years</option>
                        @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>

                @* ── Milestone Age ─────────────────────────────────── *@
                <div class="sf-field">
                    <label>Milestone Age</label>
                    <select @bind="_selectedMilestone" class="ff-input">
                        <option value="0">All Ages</option>
                        <option value="80">80</option>
                        <option value="85">85</option>
                        <option value="90">90</option>
                        <option value="95">95</option>
                        <option value="100">100</option>
                    </select>
                </div>

                @* ── Payment Status ────────────────────────────────── *@
                <div class="sf-field">
                    <label>Payment Status</label>
                    <select @bind="_selectedPaymentStatus" class="ff-input">
                        <option value="-1">All</option>
                        <option value="2">Paid</option>
                        <option value="1">Unpaid</option>
                        <option value="3">Pending</option>
                        <option value="0">N/A</option>
                    </select>
                </div>
                @* ── Payroll Quarter ───────────────────────────────── *@
                <div class="sf-field">
                    <label>Payroll Quarter</label>
                    <select @bind="_selectedPayrollQuarter" class="ff-input">
                        <option value="0">All Quarters</option>
                        <option value="1">Q1</option>
                        <option value="2">Q2</option>
                        <option value="3">Q3</option>
                        <option value="4">Q4</option>
                    </select>
                </div>
                @* ── Fiscal Year ───────────────────────────────── *@
                <div class="sf-field">
                    <label>Fiscal Year</label>
                    <select @bind="_selectedFiscalYear" class="ff-input">
                        <option value="0">All Fiscal Years</option>
                        @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
            </div>

            @* ── Date Ranges ──────────────────────────────────── *@
            <div class="sf-date-ranges">
                <div>
                    <div class="sf-section-label"><i class="bi bi-calendar-plus me-1"></i>Date Added</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>From</label>
                            <input type="date" class="ff-input" @bind="_dateAddedFrom" />
                        </div>
                        <div class="sf-field">
                            <label>To</label>
                            <input type="date" class="ff-input" @bind="_dateAddedTo" />
                        </div>
                    </div>
                </div>
                <div>
                    <div class="sf-section-label"><i class="bi bi-calendar-check me-1"></i>Date Endorsed</div>
                    <div class="sf-grid">
                        <div class="sf-field">
                            <label>From</label>
                            <input type="date" class="ff-input" @bind="_dateEndorsedFrom" />
                        </div>
                        <div class="sf-field">
                            <label>To</label>
                            <input type="date" class="ff-input" @bind="_dateEndorsedTo" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="sf-actions">
                <button class="sf-btn sf-btn-clear" @onclick="ClearFiltersAsync">Clear</button>
                <button class="sf-btn sf-btn-apply" @onclick="ApplyAsync">
                    <i class="bi bi-check2"></i> Apply
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<StatisticsRequestDto> FiltersChanged { get; set; }

    private bool _filterExpanded = true;

    private List<RegionLookupDto> _regions = new();
    private List<ProvinceLookupDto> _provincesForRegion = new();
    private List<MunicipalityLookupDto> _municipalitiesForProvince = new();

    private int _selectedRegionId;
    private int _selectedProvinceId;
    private int _selectedMunicipalityId;
    private int _selectedFiscalYear;
    private int _selectedMilestoneYear;
    private int _selectedMilestone;
    private int _selectedPaymentStatus = -1;
    private int _selectedPayrollQuarter;
    private DateTime? _dateEndorsedFrom;
    private DateTime? _dateEndorsedTo;
    private DateTime? _dateAddedFrom;
    private DateTime? _dateAddedTo;

    private bool _isLoadingProvinces;
    private bool _isLoadingMunicipalities;

    private int SelectedRegion
    {
        get => _selectedRegionId;
        set
        {
            if (_selectedRegionId != value)
            {
                _selectedRegionId = value;
                _ = OnRegionChangedAsync();
            }
        }
    }

    private int SelectedProvince
    {
        get => _selectedProvinceId;
        set
        {
            if (_selectedProvinceId != value)
            {
                _selectedProvinceId = value;
                _ = OnProvinceChangedAsync();
            }
        }
    }

    private int SelectedMunicipality
    {
        get => _selectedMunicipalityId;
        set => _selectedMunicipalityId = value;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRegionsAsync();

        // Default the Region filter to the logged-in user's own registered
        // region — same pattern as BeneficiarySearchFilters.razor and
        // LiquidationSearchFilters.razor — so it doesn't need reselecting
        // every time. Admins/SuperAdmins have no Region claim (they oversee
        // every region), so GetRegionCode() returns null for them and this
        // simply no-ops, leaving "All Regions" as their starting point.
        await AuthService.InitAsync();
        var myRegion = AuthService.GetRegionCode();
        if (myRegion.HasValue)
        {
            _selectedRegionId = myRegion.Value;
            await LoadProvincesAsync(_selectedRegionId);
        }
    }

    private async Task LoadRegionsAsync()
    {
        try
        {
            _regions = await Http.GetFromJsonAsync<List<RegionLookupDto>>("api/Region") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading regions: {ex.Message}");
        }
    }

    private async Task OnRegionChangedAsync()
    {
        _selectedProvinceId = 0;
        _selectedMunicipalityId = 0;
        _provincesForRegion = new();
        _municipalitiesForProvince = new();

        if (_selectedRegionId > 0)
        {
            await LoadProvincesAsync(_selectedRegionId);
        }
        StateHasChanged();
    }

    private async Task OnProvinceChangedAsync()
    {
        _selectedMunicipalityId = 0;
        _municipalitiesForProvince = new();

        if (_selectedProvinceId > 0)
        {
            await LoadMunicipalitiesAsync(_selectedProvinceId);
        }
        StateHasChanged();
    }

    private async Task LoadProvincesAsync(int regionId)
    {
        try
        {
            _isLoadingProvinces = true;
            _provincesForRegion = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>(
                $"api/Province/by-region/{regionId}") ?? new();
        }
        finally
        {
            _isLoadingProvinces = false;
            StateHasChanged();
        }
    }

    private async Task LoadMunicipalitiesAsync(int provinceId)
    {
        try
        {
            _isLoadingMunicipalities = true;
            _municipalitiesForProvince = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>(
                $"api/Municipality/by-province/{provinceId}") ?? new();
        }
        finally
        {
            _isLoadingMunicipalities = false;
            StateHasChanged();
        }
    }

    private void ToggleFilter() => _filterExpanded = !_filterExpanded;

    private StatisticsRequestDto BuildRequest() => new()
    {
        Region = _selectedRegionId > 0 ? _selectedRegionId : null,
        Province = _selectedProvinceId > 0 ? _selectedProvinceId : null,
        Municipality = _selectedMunicipalityId > 0 ? _selectedMunicipalityId : null,
        MilestoneYear = _selectedMilestoneYear,
        MilestoneAge = _selectedMilestone,
        PaymentStatus = _selectedPaymentStatus,
        PayrollQuarter = _selectedPayrollQuarter > 0 ? _selectedPayrollQuarter : null,
        FiscalYear = _selectedFiscalYear > 0 ? _selectedFiscalYear : null,
        DateEndorsedFrom = _dateEndorsedFrom,
        DateEndorsedTo = _dateEndorsedTo,
        DateAddedFrom = _dateAddedFrom,
        DateAddedTo = _dateAddedTo
    };

    private async Task ApplyAsync() => await FiltersChanged.InvokeAsync(BuildRequest());

    private async Task ClearFiltersAsync()
    {
        _selectedRegionId = 0;
        _selectedProvinceId = 0;
        _selectedMunicipalityId = 0;
        _selectedMilestoneYear = 0;
        _selectedMilestone = 0;
        _selectedPaymentStatus = -1;
        _provincesForRegion = new();
        _municipalitiesForProvince = new();
        _selectedPayrollQuarter = 0;
        _selectedFiscalYear = 0;
        _dateEndorsedFrom = null;
        _dateEndorsedTo = null;
        _dateAddedFrom = null;
        _dateAddedTo = null;

        await FiltersChanged.InvokeAsync(BuildRequest());
    }
}
