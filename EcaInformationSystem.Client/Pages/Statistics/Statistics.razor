    // Renders a milestone-age table cell as the bracket's total count plus a
    // small Male/Female split beneath it, e.g. "12" over "M 7 · F 5" — keeps
    // the existing total visible while adding the gender breakdown requested
    // for the province table, without doubling the column count.
    private static RenderFragment AgeCell(int total, int male, int female) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "age-cell-total");
        builder.AddContent(2, total.ToString("N0"));
        builder.CloseElement();

        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "age-cell-split");
        builder.OpenElement(5, "span");
        builder.AddAttribute(6, "class", "age-split-m");
        builder.AddContent(7, $"M {male}");
        builder.CloseElement();
        builder.OpenElement(8, "span");
        builder.AddAttribute(9, "class", "age-split-f");
        builder.AddContent(10, $"F {female}");
        builder.CloseElement();
        builder.CloseElement();
    };

