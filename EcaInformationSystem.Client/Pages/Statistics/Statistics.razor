@page "/statistics"
@using Microsoft.AspNetCore.Authorization
@using EcaInformationSystem.Client.Pages.Statistics.StatisticsChildComponents
@using SharedDtos = EcaInformationSystem.Shared.DTOs
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Statistics Report</PageTitle>

<div class="content-area">
    @* ── Page Header ───────────────────────────────────────────────── *@
    <div class="page-header-bar mb-3">
        <div class="page-header-icon">
            <i class="bi bi-bar-chart-fill"></i>
        </div>
        <div>
            <div class="page-header-title">Statistics Report</div>
            <div class="page-header-sub">Generated: @DateTime.Now.ToString("MMMM dd, yyyy HH:mm")</div>
        </div>
        <div class="ms-auto d-flex gap-2">
            <button class="sys-btn sys-btn-outline" @onclick="RefreshAsync">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    @* ── Annual Grantee Target — set per-region by Admin/SuperAdmin, compares
         monthly targets against actual grantees paid (PaymentHistory.PaymentDate). ── *@
    <StatisticsAnnualTargetSection />

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted small">Loading statistics...</p>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@_loadError
            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="RefreshAsync">Retry</button>
        </div>
    }
    else
    {
        @* ── Filter Panel ──────────────────────────────────────────── *@
        <div class="sf-card">
            <div class="sf-header" @onclick="ToggleFilter">
                <div class="sf-header-left">
                    <div class="sf-header-icon"><i class="bi bi-funnel"></i></div>
                    <div>
                        <div class="sf-header-title">Filters</div>
                        <div class="sf-header-sub">Narrow down statistics</div>
                    </div>
                </div>
                <i class="bi bi-chevron-up sf-chevron @(_filterExpanded ? "open" : "")"></i>
            </div>
            @if (_filterExpanded)
            {
                <div class="sf-body">
                    <div class="sf-grid">
                        @* ── Region ────────────────────────────────────────── *@
                        <div class="sf-field">
                            <label>Region</label>
                            <select @bind="SelectedRegion" class="ff-input">
                                <option value="0">All Regions</option>
                                @foreach (var region in _regions)
                                {
                                    <option value="@region.PsgcCodeRegion">@region.Name</option>
                                }
                            </select>
                        </div>

                        @* ── Province ────────────────────────────────────── *@
                        <div class="sf-field">
                            <label>Province</label>
                            <select @bind="SelectedProvince" class="ff-input"
                                    disabled="@(_selectedRegionId == 0)">
                                <option value="0">All Provinces</option>
                                @foreach (var province in _provincesForRegion)
                                {
                                    <option value="@province.PsgcCodeProvince">@province.Name</option>
                                }
                            </select>
                            @if (_isLoadingProvinces)
                            {
                                <span class="sf-loading-pill">
                                    <span class="spinner-border spinner-border-sm"></span> Loading...
                                </span>
                            }
                        </div>

                        @* ── Municipality ────────────────────────────────── *@
                        <div class="sf-field">
                            <label>Municipality</label>
                            <select @bind="SelectedMunicipality" class="ff-input"
                                    disabled="@(_selectedProvinceId == 0)">
                                <option value="0">All Municipalities</option>
                                @foreach (var muni in _municipalitiesForProvince)
                                {
                                    <option value="@muni.PsgcCodeMunicipality">@muni.Name</option>
                                }
                            </select>
                            @if (_isLoadingMunicipalities)
                            {
                                <span class="sf-loading-pill">
                                    <span class="spinner-border spinner-border-sm"></span> Loading...
                                </span>
                            }
                        </div>

                        @* ── Milestone Year ────────────────────────────────── *@
                        <div class="sf-field">
                            <label>Milestone Year</label>
                            <select @bind="_selectedMilestoneYear" class="ff-input">
                                <option value="0">All Milestone Years</option>
                                @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>

                        @* ── Milestone Age ─────────────────────────────────── *@
                        <div class="sf-field">
                            <label>Milestone Age</label>
                            <select @bind="_selectedMilestone" class="ff-input">
                                <option value="0">All Ages</option>
                                <option value="80">80</option>
                                <option value="85">85</option>
                                <option value="90">90</option>
                                <option value="95">95</option>
                                <option value="100">100</option>
                            </select>
                        </div>

                        @* ── Payment Status — multi-select, same control as the Beneficiary
                             grid's filter (BeneficiarySearchFilters.razor) ── *@
                        <div class="sf-field">
                            <label>Payment Status</label>
                            <MultiSelectDropdown TItem="PaymentStatusOption" Items="_paymentStatusOptions"
                                                 SelectedIds="_selectedPaymentStatuses"
                                                 SelectedIdsChanged="@(ids => _selectedPaymentStatuses = ids)"
                                                 IdSelector="@(p => p.Value)" LabelSelector="@(p => p.Label)"
                                                 Placeholder="Payment Status" Disabled="@_isLoading" />
                        </div>
                        @* ── Payroll Quarter ───────────────────────────────── *@
                        <div class="sf-field">
                            <label>Payroll Quarter</label>
                            <select @bind="_selectedPayrollQuarter" class="ff-input">
                                <option value="0">All Quarters</option>
                                <option value="1">Q1</option>
                                <option value="2">Q2</option>
                                <option value="3">Q3</option>
                                <option value="4">Q4</option>
                            </select>
                        </div>
                        @* ── Fiscal Year ───────────────────────────────── *@
                        <div class="sf-field">
                            <label>Fiscal Year</label>
                            <select @bind="_selectedFiscalYear" class="ff-input">
                                <option value="0">All Fiscal Years</option>
                                @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>
                    </div>

                    @* ── Date Ranges ──────────────────────────────────── *@
                    <div class="sf-date-ranges">
                        <div>
                            <div class="sf-section-label"><i class="bi bi-calendar-plus me-1"></i>Date Added</div>
                            <div class="sf-grid">
                                <div class="sf-field">
                                    <label>From</label>
                                    <input type="date" class="ff-input" @bind="_dateAddedFrom" />
                                </div>
                                <div class="sf-field">
                                    <label>To</label>
                                    <input type="date" class="ff-input" @bind="_dateAddedTo" />
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="sf-section-label"><i class="bi bi-calendar-check me-1"></i>Date Endorsed</div>
                            <div class="sf-grid">
                                <div class="sf-field">
                                    <label>From</label>
                                    <input type="date" class="ff-input" @bind="_dateEndorsedFrom" />
                                </div>
                                <div class="sf-field">
                                    <label>To</label>
                                    <input type="date" class="ff-input" @bind="_dateEndorsedTo" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="sf-actions">
                        <button class="sf-btn sf-btn-clear" @onclick="ClearFilters">Clear</button>
                        <button class="sf-btn sf-btn-apply" @onclick="ApplyFiltersAsync">
                            <i class="bi bi-check2"></i> Apply
                        </button>
                    </div>
                </div>
            }
        </div>

        @* ── No auto-loaded overall totals on page open — that was a full
             aggregate scan nobody asked for yet. The cards/tables stay visible
             (at zero) rather than hiding behind a loading screen; this banner
             just makes clear why they're at zero and how to populate them. ── *@
        @if (!_hasLoadedReport)
        {
            <div class="alert alert-info d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <span>
                    <i class="bi bi-info-circle me-2"></i>
                    Showing zero counts — set filters above (optional) and load the report.
                </span>
                <button class="sys-btn sys-btn-save" @onclick="LoadStatisticsAsync">
                    <i class="bi bi-play-fill me-1"></i> Load Statistics
                </button>
            </div>
        }

        @* ── Summary Cards — click a count to audit exactly who's included ── *@
        <div class="dash-stat-grid dash-stat-grid--cols-5 mb-3">
            <div class="dash-stat-card dash-stat-card--navy dash-stat-card--clickable"
                 @onclick='() => OpenMembersModalAsync("all", "Total Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="dash-stat-value">@_report.TotalBeneficiaries.ToString("N0")</div>
                <div class="dash-stat-label">Total Grantees</div>
            </div>
            <div class="dash-stat-card dash-stat-card--green dash-stat-card--clickable"
                 @onclick='() => OpenMembersModalAsync("paid", "Paid Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div class="dash-stat-value">@_report.PaidCount.ToString("N0")</div>
                <div class="dash-stat-label">Paid</div>
            </div>
            <div class="dash-stat-card dash-stat-card--red dash-stat-card--clickable"
                 @onclick='() => OpenMembersModalAsync("unpaid", "Unpaid Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-x-circle-fill"></i></div>
                <div class="dash-stat-value">@_report.UnpaidCount.ToString("N0")</div>
                <div class="dash-stat-label">Unpaid</div>
            </div>
            <div class="dash-stat-card dash-stat-card--amber dash-stat-card--clickable"
                 @onclick='() => OpenMembersModalAsync("pending", "Pending Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-clock-fill"></i></div>
                <div class="dash-stat-value">@_report.PendingCount.ToString("N0")</div>
                <div class="dash-stat-label">Pending</div>
            </div>
            <div class="dash-stat-card dash-stat-card--clickable" style="background:#6c757d;"
                 @onclick='() => OpenMembersModalAsync("notapplicable", "N/A Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-dash-circle-fill"></i></div>
                <div class="dash-stat-value">@_report.NotApplicableCount.ToString("N0")</div>
                <div class="dash-stat-label">N/A</div>
            </div>
        </div>

        <div class="dash-stat-grid mb-3">
            <div class="dash-stat-card dash-stat-card--clickable" style="background:#0dcaf0;"
                 @onclick='() => OpenMembersModalAsync("paid", "Grantees Included in Total Disbursed")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div class="dash-stat-value">₱@_report.TotalDisbursement.ToString("N0")</div>
                <div class="dash-stat-label">Total Disbursed</div>
            </div>
            <div class="dash-stat-card dash-stat-card--clickable" style="background:#6f42c1;"
                 @onclick='() => OpenMembersModalAsync("male", "Male Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-gender-male"></i></div>
                <div class="dash-stat-value">@_report.TotalMale.ToString("N0")</div>
                <div class="dash-stat-label">Male</div>
            </div>
            <div class="dash-stat-card dash-stat-card--clickable" style="background:#d63384;"
                 @onclick='() => OpenMembersModalAsync("female", "Female Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-gender-female"></i></div>
                <div class="dash-stat-value">@_report.TotalFemale.ToString("N0")</div>
                <div class="dash-stat-label">Female</div>
            </div>
            <div class="dash-stat-card" style="background:#20c997;">
                <div class="dash-stat-icon"><i class="bi bi-people"></i></div>
                <div class="dash-stat-value">@((_report.TotalMale + _report.TotalFemale) > 0 ? Math.Round((double)_report.TotalFemale / (_report.TotalMale + _report.TotalFemale) * 100) : 0)%</div>
                <div class="dash-stat-label">% Female</div>
            </div>
        </div>

        @* ── Milestone Year Summary ───────────────────────────────── *@
        @if (_report.MilestoneYearSummary.Any())
        {
            <div class="sys-card mb-3">
                <div class="sys-card-header">
                    <i class="bi bi-calendar-event me-2"></i>
                    Milestone Year Summary
                </div>
                <div class="sys-card-body">
                    <div class="milestone-year-grid">
                        @foreach (var year in _report.MilestoneYearSummary.OrderByDescending(x => x.Year))
                        {
                            var maxYearCount = _report.MilestoneYearSummary.Any()
                                ? _report.MilestoneYearSummary.Max(x => x.TotalCount)
                                : 1;
                            var pct = maxYearCount > 0
                                ? (double)year.TotalCount / maxYearCount * 100
                                : 0;

                            <div class="milestone-year-card">
                                <div class="milestone-year-header">
                                    <span class="milestone-year-label">@year.Year</span>
                                    <span class="milestone-year-total">@year.TotalCount.ToString("N0")</span>
                                </div>
                                <div class="milestone-year-bar-track">
                                    <div class="milestone-year-bar milestone-year-bar--@GetYearColor(year.Year)"
                                         style="width:@pct%;">
                                    </div>
                                </div>
                                <div class="milestone-year-breakdown">
                                    <span class="badge" style="background:#0d6efd;">80: @year.Age80Count</span>
                                    <span class="badge" style="background:#198754;">85: @year.Age85Count</span>
                                    <span class="badge" style="background:#ffc107;color:#000;">90: @year.Age90Count</span>
                                    <span class="badge" style="background:#fd7e14;">95: @year.Age95Count</span>
                                    <span class="badge" style="background:#dc3545;">100: @year.Age100Count</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        @if (_report.PayrollQuarterBreakdown.Any())
        {
            <div class="sys-card mb-3">
                <div class="sys-card-header">
                    <i class="bi bi-calendar3-range me-2"></i>
                    Payroll Quarter Breakdown
                </div>
                <div class="sys-card-body p-0">
                    <table class="table table-sm mb-0 stat-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Quarter</th>
                                <th class="text-center">Count</th>
                                <th class="text-center">Paid</th>
                                <th class="text-end">Disbursed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in _report.PayrollQuarterBreakdown)
                            {
                                <tr>
                                    <td class="fw-semibold">Quarter @q.Quarter</td>
                                    <td class="text-center">@q.Count.ToString("N0")</td>
                                    <td class="text-center">@q.PaidCount.ToString("N0")</td>
                                    <td class="text-end">₱@q.TotalDisbursement.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ── Charts Row ───────────────────────────────────────────── *@
        <div class="dash-row">
            @* ── Age Distribution ────────────────────────────────── *@
            <div class="dash-card">
                <div class="dash-card-header">
                    <i class="bi bi-graph-up-arrow me-2"></i>
                    Distribution by Milestone Age
                </div>
                <div class="dash-card-body">
                    <div class="milestone-chart">
                        @foreach (var item in _report.AgeDistribution)
                        {
                            var pct = _report.TotalBeneficiaries > 0
                                ? (double)item.Count / _report.TotalBeneficiaries * 100
                                : 0;
                            <div class="milestone-bar-wrap">
                                <span class="milestone-bar-label">@item.Age</span>
                                <div class="milestone-bar-track">
                                    <div class="milestone-bar milestone-bar--@GetAgeColor(item.Age)"
                                         style="width:@Math.Max(4, pct)%;">
                                        <span class="milestone-bar-count">@item.Count</span>
                                    </div>
                                </div>
                                <span class="milestone-bar-pct">@pct.ToString("F1")%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ── Payment Status ───────────────────────────────────── *@
            <div class="dash-card">
                <div class="dash-card-header">
                    <i class="bi bi-pie-chart-fill me-2"></i>
                    Payment Status Breakdown
                </div>
                <div class="dash-card-body dash-card-body--center">
                    <div class="dash-chart">
                        @{
                            var maxPayment = Math.Max(1, new[] { _report.PaidCount, _report.UnpaidCount, _report.PendingCount, _report.NotApplicableCount }.Max());
                        }
                        <div class="dash-chart-bar-wrap">
                            <span class="dash-chart-bar-value">@_report.PaidCount.ToString("N0")</span>
                            <div class="dash-chart-bar dash-chart-bar--green"
                                 style="height:@(GetBarHeight(_report.PaidCount, maxPayment))%;">
                            </div>
                            <span class="dash-chart-bar-label">Paid</span>
                        </div>
                        <div class="dash-chart-bar-wrap">
                            <span class="dash-chart-bar-value">@_report.UnpaidCount.ToString("N0")</span>
                            <div class="dash-chart-bar dash-chart-bar--red"
                                 style="height:@(GetBarHeight(_report.UnpaidCount, maxPayment))%;">
                            </div>
                            <span class="dash-chart-bar-label">Unpaid</span>
                        </div>
                        <div class="dash-chart-bar-wrap">
                            <span class="dash-chart-bar-value">@_report.PendingCount.ToString("N0")</span>
                            <div class="dash-chart-bar dash-chart-bar--amber"
                                 style="height:@(GetBarHeight(_report.PendingCount, maxPayment))%;">
                            </div>
                            <span class="dash-chart-bar-label">Pending</span>
                        </div>
                        <div class="dash-chart-bar-wrap">
                            <span class="dash-chart-bar-value">@_report.NotApplicableCount.ToString("N0")</span>
                            <div class="dash-chart-bar dash-chart-bar--gray"
                                 style="height:@(GetBarHeight(_report.NotApplicableCount, maxPayment))%;">
                            </div>
                            <span class="dash-chart-bar-label">N/A</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Province Breakdown ───────────────────────────────────── *@
        <div class="sys-card mt-3">
            <div class="sys-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-map-fill me-2"></i>Breakdown by Province</span>
                <span class="badge bg-light text-dark">@_report.ProvinceBreakdowns.Count provinces</span>
            </div>
            <div class="sys-card-body p-0">
                <div class="age-cell-legend">
                    <span class="age-legend-item"><span class="age-legend-swatch age-legend-swatch--m"></span>Male</span>
                    <span class="age-legend-item"><span class="age-legend-swatch age-legend-swatch--f"></span>Female</span>
                    <span class="age-legend-hint">— shown under each milestone age's total</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0 stat-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Province</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">80</th>
                                <th class="text-center">85</th>
                                <th class="text-center">90</th>
                                <th class="text-center">95</th>
                                <th class="text-center">100</th>
                                <th class="text-center">M</th>
                                <th class="text-center">F</th>
                                <th class="text-end">Disbursed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _report.ProvinceBreakdowns)
                            {
                                <tr>
                                    <td class="fw-semibold">@p.ProvinceName</td>
                                    <td class="text-center">@p.TotalCount.ToString("N0")</td>
                                    <td class="text-center age-cell">@AgeCell(p.Age80Count, p.Age80MaleCount, p.Age80FemaleCount)</td>
                                    <td class="text-center age-cell">@AgeCell(p.Age85Count, p.Age85MaleCount, p.Age85FemaleCount)</td>
                                    <td class="text-center age-cell">@AgeCell(p.Age90Count, p.Age90MaleCount, p.Age90FemaleCount)</td>
                                    <td class="text-center age-cell">@AgeCell(p.Age95Count, p.Age95MaleCount, p.Age95FemaleCount)</td>
                                    <td class="text-center age-cell">@AgeCell(p.Age100Count, p.Age100MaleCount, p.Age100FemaleCount)</td>
                                    <td class="text-center">@p.MaleCount</td>
                                    <td class="text-center">@p.FemaleCount</td>
                                    <td class="text-end fw-semibold">₱@p.TotalDisbursement.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary fw-bold">
                            <tr>
                                <td>TOTAL</td>
                                <td class="text-center">@_report.TotalBeneficiaries.ToString("N0")</td>
                                <td class="text-center age-cell">@AgeCell(_report.TotalAge80, _report.ProvinceBreakdowns.Sum(p => p.Age80MaleCount), _report.ProvinceBreakdowns.Sum(p => p.Age80FemaleCount))</td>
                                <td class="text-center age-cell">@AgeCell(_report.TotalAge85, _report.ProvinceBreakdowns.Sum(p => p.Age85MaleCount), _report.ProvinceBreakdowns.Sum(p => p.Age85FemaleCount))</td>
                                <td class="text-center age-cell">@AgeCell(_report.TotalAge90, _report.ProvinceBreakdowns.Sum(p => p.Age90MaleCount), _report.ProvinceBreakdowns.Sum(p => p.Age90FemaleCount))</td>
                                <td class="text-center age-cell">@AgeCell(_report.TotalAge95, _report.ProvinceBreakdowns.Sum(p => p.Age95MaleCount), _report.ProvinceBreakdowns.Sum(p => p.Age95FemaleCount))</td>
                                <td class="text-center age-cell">@AgeCell(_report.TotalAge100, _report.ProvinceBreakdowns.Sum(p => p.Age100MaleCount), _report.ProvinceBreakdowns.Sum(p => p.Age100FemaleCount))</td>
                                <td class="text-center">@_report.TotalMale</td>
                                <td class="text-center">@_report.TotalFemale</td>
                                <td class="text-end">₱@_report.TotalDisbursement.ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        @* ── Municipality Breakdown ───────────────────────────────── *@
        @if (_report.MunicipalityBreakdowns.Any())
        {
            <div class="sys-card mt-3">
                <div class="sys-card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-building me-2"></i>Breakdown by Municipality</span>
                    <button class="btn btn-sm btn-light" @onclick="ToggleMunicipalityTable">
                        @(_showMunicipalityTable ? "Hide" : "Show")
                    </button>
                </div>
                @if (_showMunicipalityTable)
                {
                    <div class="age-cell-legend">
                        <span class="age-legend-item"><span class="age-legend-swatch age-legend-swatch--m"></span>Male</span>
                        <span class="age-legend-item"><span class="age-legend-swatch age-legend-swatch--f"></span>Female</span>
                        <span class="age-legend-hint">— shown under each milestone age's total</span>
                    </div>
                    <div class="sys-card-body p-0">
                        <div class="table-responsive hover-scroll" style="max-height:500px; overflow-y:auto;">
                            <table class="table table-hover table-sm mb-0 stat-table">
                                <thead class="table-dark position-sticky top-0" style="z-index:1;">
                                    <tr>
                                        <th>Municipality</th>
                                        <th>Province</th>
                                        <th class="text-center">Total</th>
                                        <th class="text-center">80</th>
                                        <th class="text-center">85</th>
                                        <th class="text-center">90</th>
                                        <th class="text-center">95</th>
                                        <th class="text-center">100</th>
                                        <th class="text-center">M</th>
                                        <th class="text-center">F</th>
                                        <th class="text-end">Disbursed</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in _report.MunicipalityBreakdowns.OrderBy(x => x.ProvinceName).ThenBy(x => x.MunicipalityName))
                                    {
                                        <tr>
                                            <td>@m.MunicipalityName</td>
                                            <td>@m.ProvinceName</td>
                                            <td class="text-center">@m.TotalCount.ToString("N0")</td>
                                            <td class="text-center age-cell">@AgeCell(m.Age80Count, m.Age80MaleCount, m.Age80FemaleCount)</td>
                                            <td class="text-center age-cell">@AgeCell(m.Age85Count, m.Age85MaleCount, m.Age85FemaleCount)</td>
                                            <td class="text-center age-cell">@AgeCell(m.Age90Count, m.Age90MaleCount, m.Age90FemaleCount)</td>
                                            <td class="text-center age-cell">@AgeCell(m.Age95Count, m.Age95MaleCount, m.Age95FemaleCount)</td>
                                            <td class="text-center age-cell">@AgeCell(m.Age100Count, m.Age100MaleCount, m.Age100FemaleCount)</td>
                                            <td class="text-center">@m.MaleCount</td>
                                            <td class="text-center">@m.FemaleCount</td>
                                            <td class="text-end">₱@m.TotalDisbursement.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary fw-bold">
                                    <tr>
                                        <td colspan="2">TOTAL</td>
                                        <td class="text-center">@_report.TotalBeneficiaries.ToString("N0")</td>
                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge80, _report.MunicipalityBreakdowns.Sum(m => m.Age80MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age80FemaleCount))</td>
                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge85, _report.MunicipalityBreakdowns.Sum(m => m.Age85MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age85FemaleCount))</td>
                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge90, _report.MunicipalityBreakdowns.Sum(m => m.Age90MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age90FemaleCount))</td>
                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge95, _report.MunicipalityBreakdowns.Sum(m => m.Age95MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age95FemaleCount))</td>
                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge100, _report.MunicipalityBreakdowns.Sum(m => m.Age100MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age100FemaleCount))</td>
                                        <td class="text-center">@_report.TotalMale</td>
                                        <td class="text-center">@_report.TotalFemale</td>
                                        <td class="text-end">₱@_report.TotalDisbursement.ToString("N0")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }

    }
</div>

@* ── Grantee Audit Modal — shows exactly who is included in a summary
     card's count, so figures can be verified against actual records
     instead of taken on faith. Mirrors the CGP drill-down pattern in
     LiquidationModal.razor (full name + payment history per row). ── *@
<HxModal @ref="_membersModal" Size="ModalSize.ExtraLarge">
    <HeaderTemplate>
        <h5 class="modal-title">
            <i class="bi bi-people-fill me-2"></i>
            @_membersModalTitle
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        @if (_isLoadingMembers)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 mb-0">Loading grantees...</p>
            </div>
        }
        else if (!_members.Any())
        {
            <div class="alert alert-info mb-0">No grantees found for this count.</div>
        }
        else
        {
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <span class="badge bg-primary fs-6">@_membersTotalCount Total</span>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_membersPageNumber <= 1 || _isLoadingMembers)"
                            @onclick="() => GoToMembersPageAsync(_membersPageNumber - 1)">
                        <i class="bi bi-chevron-left"></i> Prev
                    </button>
                    <span class="small text-muted">
                        Page @_membersPageNumber of @Math.Max(1, _membersTotalPages)
                        (@(((_membersPageNumber - 1) * _membersPageSize) + 1)–@Math.Min(_membersPageNumber * _membersPageSize, _membersTotalCount) of @_membersTotalCount)
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_membersPageNumber >= _membersTotalPages || _isLoadingMembers)"
                            @onclick="() => GoToMembersPageAsync(_membersPageNumber + 1)">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div style="max-height:480px; overflow-y:auto;">
                <table class="table table-sm table-bordered table-hover align-middle mb-0" style="font-size:12px;">
                    <thead class="table-dark" style="position:sticky;top:0;z-index:1;">
                        <tr>
                            <th style="width:36px;">#</th>
                            <th>Full Name</th>
                            <th style="width:60px;">Sex</th>
                            <th style="width:50px;">Age</th>
                            <th>Location</th>
                            <th>OSCA ID</th>
                            <th>Status</th>
                            <th style="min-width:260px;">Payment History</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = ((_membersPageNumber - 1) * _membersPageSize) + 1; }
                        @foreach (var m in _members)
                        {
                            <tr>
                                <td>@rowNum</td>
                                <td class="fw-semibold">@m.FullName</td>
                                <td>@(m.Sex == 1 ? "Male" : m.Sex == 2 ? "Female" : "—")</td>
                                <td>@m.Age</td>
                                <td>@m.MunicipalityName, @m.ProvinceName</td>
                                <td>@(string.IsNullOrWhiteSpace(m.OscaIdNumber) ? "—" : m.OscaIdNumber)</td>
                                <td><span class="badge @GetMemberStatusBadgeClass(m.PaymentStatus)">@GetMemberStatusLabel(m.PaymentStatus)</span></td>
                                <td>
                                    @if (!m.PaymentHistories.Any())
                                    {
                                        <span class="text-muted">No payment history yet</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var h in m.PaymentHistories)
                                            {
                                                <span class="badge @GetMemberStatusBadgeClass(h.PaymentStatus) text-start" style="font-weight:500;">
                                                    @(h.PayrollQuarter.HasValue ? $"Q{h.PayrollQuarter}" : "—")
                                                    @(h.FiscalYear.HasValue ? h.FiscalYear.ToString() : "")
                                                    — @GetMemberStatusLabel(h.PaymentStatus)
                                                    @(h.PaymentDate.HasValue ? $" ({h.PaymentDate.Value:MMM dd, yyyy})" : "")
                                                    @(h.IsCurrent ? " ★" : "")
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                            rowNum++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _membersModal.HideAsync()">Close</HxButton>
    </FooterTemplate>
</HxModal>

@code {
    private int _selectedPayrollQuarter;
    // ✅ CHANGED — starts false since nothing auto-loads on mount anymore.
    private bool _isLoading;
    // ✅ NEW — gates the summary cards/breakdowns: false until the user's
    // first explicit Apply/Refresh/Load Statistics action completes.
    private bool _hasLoadedReport;
    private string? _loadError;
    private bool _filterExpanded = true;
    private bool _showMunicipalityTable;

    private StatisticsReportDto _report = new();
    private List<RegionLookupDto> _regions = new();
    private List<ProvinceLookupDto> _provincesForRegion = new();
    private List<MunicipalityLookupDto> _municipalitiesForProvince = new();

    private int _selectedRegionId;
    private int _selectedProvinceId;
    private int _selectedMunicipalityId;
    private int _selectedFiscalYear; // 0 = all
    private int _selectedMilestoneYear;
    private int _selectedMilestone;
    // ✅ CHANGED — multi-select payment status, same as BeneficiarySearchFilters.
    // Empty = no filter (was a single int with -1 meaning "all").
    private List<int> _selectedPaymentStatuses = new();
    private record PaymentStatusOption(int Value, string Label);
    private readonly List<PaymentStatusOption> _paymentStatusOptions = new()
    {
        new(2, "Paid"),
        new(1, "Unpaid"),
        new(3, "Pending"),
        new(0, "N/A"),
    };
    private DateTime? _dateEndorsedFrom;
    private DateTime? _dateEndorsedTo;
    private DateTime? _dateAddedFrom;
    private DateTime? _dateAddedTo;

    private bool _isLoadingProvinces;
    private bool _isLoadingMunicipalities;

    // ── Grantee Audit Modal ────────────────────────────────────────────
    private HxModal _membersModal = default!;
    private string _membersModalTitle = string.Empty;
    private string _membersBucket = "all";
    private bool _isLoadingMembers;
    private List<SharedDtos.StatisticsMemberDto> _members = new();
    private int _membersPageNumber = 1;
    private const int _membersPageSize = 50;
    private int _membersTotalCount;
    private int _membersTotalPages;
    // Snapshot of the filters active when the modal was opened — pagination
    // (Prev/Next) reuses this instead of re-reading live filter state, so
    // flipping pages can't silently change what's being counted mid-browse.
    private SharedDtos.StatisticsRequestDto _membersFilterSnapshot = new();

    // ── Properties with getter/setter for cascading ──────────────────
    private int SelectedRegion
    {
        get => _selectedRegionId;
        set
        {
            if (_selectedRegionId != value)
            {
                _selectedRegionId = value;
                _ = OnRegionChangedAsync();
            }
        }
    }

    private int SelectedProvince
    {
        get => _selectedProvinceId;
        set
        {
            if (_selectedProvinceId != value)
            {
                _selectedProvinceId = value;
                _ = OnProvinceChangedAsync();
            }
        }
    }

    private int SelectedMunicipality
    {
        get => _selectedMunicipalityId;
        set
        {
            if (_selectedMunicipalityId != value)
            {
                _selectedMunicipalityId = value;
            }
        }
    }

    // ✅ CHANGED — no longer auto-runs the (unfiltered, whole-database) report
    // on every page visit. That was a full aggregate scan fired before the
    // user even touched a filter — real cost, purely for a landing screen.
    // Now only the lightweight region lookup loads on mount; the report loads
    // on the user's first explicit action (Apply/Refresh/Load Statistics).
    protected override async Task OnInitializedAsync()
    {
        await LoadRegionsAsync();
    }

    private async Task LoadRegionsAsync()
    {
        try
        {
            _regions = await Http.GetFromJsonAsync<List<RegionLookupDto>>("api/Region") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading regions: {ex.Message}");
        }
    }

    private async Task OnRegionChangedAsync()
    {
        _selectedProvinceId = 0;
        _selectedMunicipalityId = 0;
        _provincesForRegion = new();
        _municipalitiesForProvince = new();

        if (_selectedRegionId > 0)
        {
            await LoadProvincesAsync(_selectedRegionId);
        }
        StateHasChanged();
    }

    private async Task OnProvinceChangedAsync()
    {
        _selectedMunicipalityId = 0;
        _municipalitiesForProvince = new();

        if (_selectedProvinceId > 0)
        {
            await LoadMunicipalitiesAsync(_selectedProvinceId);
        }
        StateHasChanged();
    }

    private async Task LoadProvincesAsync(int regionId)
    {
        try
        {
            _isLoadingProvinces = true;
            _provincesForRegion = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>(
                $"api/Province/by-region/{regionId}") ?? new();
        }
        finally
        {
            _isLoadingProvinces = false;
            StateHasChanged();
        }
    }

    private async Task LoadMunicipalitiesAsync(int provinceId)
    {
        try
        {
            _isLoadingMunicipalities = true;
            _municipalitiesForProvince = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>(
                $"api/Municipality/by-province/{provinceId}") ?? new();
        }
        finally
        {
            _isLoadingMunicipalities = false;
            StateHasChanged();
        }
    }

    private async Task LoadStatisticsAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            var request = BuildFilterRequest();

            var response = await Http.PostAsJsonAsync("api/Statistics/report", request);

            if (response.IsSuccessStatusCode)
            {
                _report = await response.Content.ReadFromJsonAsync<StatisticsReportDto>() ?? new();
                _hasLoadedReport = true;
            }
            else
            {
                _loadError = "Failed to load statistics report. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Could not reach the server: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleFilter() => _filterExpanded = !_filterExpanded;

    private void ClearFilters()
    {
        _selectedRegionId = 0;
        _selectedProvinceId = 0;
        _selectedMunicipalityId = 0;
        _selectedMilestoneYear = 0;
        _selectedMilestone = 0;
        _selectedPaymentStatuses = new();
        _provincesForRegion = new();
        _municipalitiesForProvince = new();
        _selectedPayrollQuarter = 0;
        _selectedFiscalYear = 0; // ✅ new
        _dateEndorsedFrom = null;
        _dateEndorsedTo = null;
        _dateAddedFrom = null;
        _dateAddedTo = null;
    }

    private async Task ApplyFiltersAsync() => await LoadStatisticsAsync();
    private async Task RefreshAsync() => await LoadStatisticsAsync();

    // Single source of truth for "what's currently filtered" — used by both
    // the /report call (summary cards/breakdowns) and the /members audit call,
    // so the modal's grantee list always matches whatever the cards show.
    private SharedDtos.StatisticsRequestDto BuildFilterRequest() => new()
    {
        Region = _selectedRegionId > 0 ? _selectedRegionId : null,
        Province = _selectedProvinceId > 0 ? _selectedProvinceId : null,
        Municipality = _selectedMunicipalityId > 0 ? _selectedMunicipalityId : null,
        MilestoneYear = _selectedMilestoneYear,
        MilestoneAge = _selectedMilestone,
        PaymentStatuses = _selectedPaymentStatuses,
        PayrollQuarter = _selectedPayrollQuarter > 0 ? _selectedPayrollQuarter : null,
        FiscalYear = _selectedFiscalYear > 0 ? _selectedFiscalYear : null,
        DateEndorsedFrom = _dateEndorsedFrom,
        DateEndorsedTo = _dateEndorsedTo,
        DateAddedFrom = _dateAddedFrom,
        DateAddedTo = _dateAddedTo
    };

    private async Task OpenMembersModalAsync(string bucket, string title)
    {
        _membersModalTitle = title;
        _membersBucket = bucket;
        _membersFilterSnapshot = BuildFilterRequest();
        _membersPageNumber = 1;
        _members = new();
        _membersTotalCount = 0;
        _membersTotalPages = 0;
        await _membersModal.ShowAsync();
        await FetchMembersPageAsync();
    }

    private async Task GoToMembersPageAsync(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > _membersTotalPages || _isLoadingMembers) return;
        _membersPageNumber = pageNumber;
        await FetchMembersPageAsync();
    }

    private async Task FetchMembersPageAsync()
    {
        _isLoadingMembers = true;
        StateHasChanged();

        try
        {
            var request = new SharedDtos.StatisticsMembersRequestDto
            {
                Filter = _membersFilterSnapshot,
                Bucket = _membersBucket,
                PageNumber = _membersPageNumber,
                PageSize = _membersPageSize
            };

            var response = await Http.PostAsJsonAsync("api/Statistics/members", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SharedDtos.StatisticsMembersPagedResultDto>();
                _members = result?.Items ?? new();
                _membersTotalCount = result?.TotalCount ?? 0;
                _membersTotalPages = result?.TotalPages ?? 0;
            }
        }
        finally
        {
            _isLoadingMembers = false;
            StateHasChanged();
        }
    }

    private static string GetMemberStatusLabel(int status) => status switch
    {
        1 => "Unpaid",
        2 => "Paid",
        3 => "Pending",
        _ => "N/A"
    };

    private static string GetMemberStatusBadgeClass(int status) => status switch
    {
        1 => "bg-danger",
        2 => "bg-success",
        3 => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private void ToggleMunicipalityTable() => _showMunicipalityTable = !_showMunicipalityTable;

    private static int GetBarHeight(int value, int max) =>
        max == 0 ? 0 : Math.Max(4, (int)Math.Round((double)value / max * 100));

    // Renders a milestone-age table cell as the bracket's total count plus a
    // small Male/Female split beneath it, e.g. "12" over "M 7 · F 5" — keeps
    // the existing total visible while adding the gender breakdown requested
    // for the province table, without doubling the column count.
    private static RenderFragment AgeCell(int total, int male, int female) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "age-cell-total");
        builder.AddContent(2, total.ToString("N0"));
        builder.CloseElement();

        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "age-cell-split");
        builder.OpenElement(5, "span");
        builder.AddAttribute(6, "class", "age-split-m");
        builder.AddContent(7, $"M {male}");
        builder.CloseElement();
        builder.OpenElement(8, "span");
        builder.AddAttribute(9, "class", "age-split-f");
        builder.AddContent(10, $"F {female}");
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string GetAgeColor(int age) => age switch
    {
        80 => "80",
        85 => "85",
        90 => "90",
        95 => "95",
        100 => "100",
        _ => "80"
    };

    private static string GetYearColor(int year) => year switch
    {
        2024 => "2024",
        2025 => "2025",
        2026 => "2026",
        _ => "default"
    };

    // ── DTOs ──────────────────────────────────────────────────────────
    public class RegionLookupDto
    {
        public int PsgcCodeRegion { get; set; }
        public string? Name { get; set; }
