@page "/statistics"
@using Microsoft.AspNetCore.Authorization
@using EcaInformationSystem.Client.Pages.Statistics.StatisticsChildComponents
@using EcaInformationSystem.Client.Services
@using SharedDtos = EcaInformationSystem.Shared.DTOs
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ToastService Toast
@inject IJSRuntime JS
@inject AuthService AuthService

<PageTitle>Statistics Report</PageTitle>

<div class="content-area">
    @* ── Page Header ───────────────────────────────────────────────── *@
    <div class="page-header-bar mb-3">
        <div class="page-header-icon">
            <i class="bi bi-bar-chart-fill"></i>
        </div>
        <div>
            <div class="page-header-title">Statistics Report</div>
            <div class="page-header-sub">Generated: @DateTime.Now.ToString("MMMM dd, yyyy HH:mm")</div>
        </div>
        <div class="ms-auto d-flex gap-2">
            <button class="sys-btn sys-btn-outline stats-refresh-btn" @onclick="RefreshAsync" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise @(_isLoading ? "stats-spin" : "")"></i> Refresh
            </button>
        </div>
    </div>

    @* ── Data quality reminder — counts below are only as accurate as the
         source records. Kept as a single low-noise line so it registers at
         a glance without competing with the header or filters. ── *@
    <div class="data-quality-banner">
        <i class="bi bi-info-circle-fill"></i>
        Counts reflect data exactly as encoded. Incomplete or uncleansed records can skew these figures — please verify and cleanse data for accurate statistics.
    </div>

    @* ── Error banner — a small persistent alert instead of swapping out the
         whole page, so filters/cards stay mounted (and thus stand still)
         even when a load fails. ── *@
    @if (_loadError is not null)
    {
        <div class="alert alert-danger mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>@_loadError
            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="RefreshAsync">Retry</button>
        </div>
    }

    @* ── Filter Panel (left) + Registered Region map (right) ── Row wraps on
         narrow viewports so the map drops below the filters instead of
         squeezing them. Filter Panel is always mounted (was gated behind
         !_isLoading before, which tore down and rebuilt the ENTIRE page below
         the header on every Apply/Refresh — filters, cards, charts, tables,
         all of it — causing replaying entrance animations and a layout jump
         users found dizzying). ── *@
    <div class="stats-top-row mb-3">
        <div class="stats-top-row-main">
            <div class="sf-card">
                <div class="sf-header" @onclick="ToggleFilter">
                    <div class="sf-header-left">
                        <div class="sf-header-icon"><i class="bi bi-funnel"></i></div>
                        <div>
                            <div class="sf-header-title">Filters</div>
                            <div class="sf-header-sub">Narrow down statistics</div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-up sf-chevron @(_filterExpanded ? "open" : "")"></i>
                </div>
                <div class="sf-body-wrap @(_filterExpanded ? "sf-body-wrap--open" : "")">
                    <div class="sf-body">
                        <div class="sf-grid">
                            @* ── Region ────────────────────────────────────────── *@
                            <div class="sf-field">
                                <label>Region</label>
                                <select @bind="SelectedRegion" class="ff-input">
                                    <option value="0">All Regions</option>
                                    @foreach (var region in _regions)
                                    {
                                        <option value="@region.PsgcCodeRegion">@region.Name</option>
                                    }
                                </select>
                            </div>

                            @* ── Province ────────────────────────────────────── *@
                            <div class="sf-field">
                                <label>Province</label>
                                <select @bind="SelectedProvince" class="ff-input"
                                        disabled="@(_selectedRegionId == 0)">
                                    <option value="0">All Provinces</option>
                                    @foreach (var province in _provincesForRegion)
                                    {
                                        <option value="@province.PsgcCodeProvince">@province.Name</option>
                                    }
                                </select>
                                @if (_isLoadingProvinces)
                                {
                                    <span class="sf-loading-pill">
                                        <span class="spinner-border spinner-border-sm"></span> Loading...
                                    </span>
                                }
                            </div>

                            @* ── Municipality ────────────────────────────────── *@
                            <div class="sf-field">
                                <label>Municipality</label>
                                <select @bind="SelectedMunicipality" class="ff-input"
                                        disabled="@(_selectedProvinceId == 0)">
                                    <option value="0">All Municipalities</option>
                                    @foreach (var muni in _municipalitiesForProvince)
                                    {
                                        <option value="@muni.PsgcCodeMunicipality">@muni.Name</option>
                                    }
                                </select>
                                @if (_isLoadingMunicipalities)
                                {
                                    <span class="sf-loading-pill">
                                        <span class="spinner-border spinner-border-sm"></span> Loading...
                                    </span>
                                }
                                <span class="stats-field-hint">
                                    <i class="bi bi-info-circle"></i> Applying this will auto-navigate the map to it
                                </span>
                            </div>

                            @* ── Milestone Year ────────────────────────────────── *@
                            <div class="sf-field">
                                <label>Milestone Year</label>
                                <select @bind="_selectedMilestoneYear" class="ff-input">
                                    <option value="0">All Milestone Years</option>
                                    @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>

                            @* ── Anticipated Milestone Years — separate, additive filter: pick
                                 any of 2024/2025/2026 together to see the count of grantees
                                 turning a milestone age (80/85/90/95/100) in ANY of those years,
                                 including a milestone birthday that hasn't happened yet this
                                 year, so PDOs can anticipate upcoming milestones ahead of time
                                 instead of checking one year at a time via Milestone Year above. ── *@
                            <div class="sf-field">
                                <label>Anticipated Milestones</label>
                                <MultiSelectDropdown TItem="MilestoneYearOption" Items="_anticipatedMilestoneYearOptions"
                                                     SelectedIds="_selectedAnticipatedMilestoneYears"
                                                     SelectedIdsChanged="@(ids => _selectedAnticipatedMilestoneYears = ids)"
                                                     IdSelector="@(y => y.Value)" LabelSelector="@(y => y.Label)"
                                                     Placeholder="Anticipated Years" Disabled="@_isLoading" />
                            </div>

                            @* ── Milestone Age ─────────────────────────────────── *@
                            <div class="sf-field">
                                <label>Milestone Age</label>
                                <select @bind="_selectedMilestone" class="ff-input">
                                    <option value="0">All Ages</option>
                                    <option value="80">80</option>
                                    <option value="85">85</option>
                                    <option value="90">90</option>
                                    <option value="95">95</option>
                                    <option value="100">100</option>
                                </select>
                            </div>

                            @* ── Payment Status — multi-select, same control as the Beneficiary
                                 grid's filter (BeneficiarySearchFilters.razor) ── *@
                            <div class="sf-field">
                                <label>Payment Status</label>
                                <MultiSelectDropdown TItem="PaymentStatusOption" Items="_paymentStatusOptions"
                                                     SelectedIds="_selectedPaymentStatuses"
                                                     SelectedIdsChanged="@(ids => _selectedPaymentStatuses = ids)"
                                                     IdSelector="@(p => p.Value)" LabelSelector="@(p => p.Label)"
                                                     Placeholder="Payment Status" Disabled="@_isLoading" />
                            </div>
                            @* ── Payroll Quarter ───────────────────────────────── *@
                            <div class="sf-field">
                                <label>Payroll Quarter</label>
                                <select @bind="_selectedPayrollQuarter" class="ff-input">
                                    <option value="0">All Quarters</option>
                                    <option value="1">Q1</option>
                                    <option value="2">Q2</option>
                                    <option value="3">Q3</option>
                                    <option value="4">Q4</option>
                                </select>
                            </div>
                            @* ── Fiscal Year ───────────────────────────────── *@
                            <div class="sf-field">
                                <label>Fiscal Year</label>
                                <select @bind="_selectedFiscalYear" class="ff-input">
                                    <option value="0">All Fiscal Years</option>
                                    @for (int y = DateTime.Now.Year + 1; y >= 2024; y--)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                            @* ── Liveness ───────────────────────────────────── *@
                            <div class="sf-field">
                                <label>Liveness</label>
                                <select @bind="_selectedLiveness" class="ff-input">
                                    <option value="">All</option>
                                    <option value="verified">Verified</option>
                                    <option value="notverified">Not Verified</option>
                                </select>
                            </div>
                            @* ── EFT ────────────────────────────────────────── *@
                            <div class="sf-field">
                                <label>EFT</label>
                                <select @bind="_selectedEft" class="ff-input">
                                    <option value="">All</option>
                                    <option value="ready">Ready</option>
                                    <option value="notready">Not Ready</option>
                                </select>
                            </div>
                        </div>

                        @* ── Date Ranges ──────────────────────────────────── *@
                        <div class="sf-date-ranges">
                            <div>
                                <div class="sf-section-label"><i class="bi bi-calendar-plus me-1"></i>Date Added</div>
                                <div class="sf-grid">
                                    <div class="sf-field">
                                        <label>From</label>
                                        <input type="date" class="ff-input" @bind="_dateAddedFrom" />
                                    </div>
                                    <div class="sf-field">
                                        <label>To</label>
                                        <input type="date" class="ff-input" @bind="_dateAddedTo" />
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="sf-section-label"><i class="bi bi-calendar-check me-1"></i>Date Endorsed</div>
                                <div class="sf-grid">
                                    <div class="sf-field">
                                        <label>From</label>
                                        <input type="date" class="ff-input" @bind="_dateEndorsedFrom" />
                                    </div>
                                    <div class="sf-field">
                                        <label>To</label>
                                        <input type="date" class="ff-input" @bind="_dateEndorsedTo" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ── CO Status Dates — its own labeled row, distinct from
                             "Date Endorsed" above; CoDateEndorsed/CoDateApproved are
                             set via the CO Status bulk-update (or the post-export
                             "mark as endorsed" prompt), not the application's own
                             DateEndorsed. Kept as a separate .sf-date-ranges row
                             instead of 4-across in one — two pairs read more clearly
                             than four narrow boxes squeezed onto one line. ── *@
                        <div class="sf-date-ranges-group-label">
                            <i class="bi bi-building-check"></i> CO Status Dates
                        </div>
                        <div class="sf-date-ranges">
                            <div>
                                <div class="sf-section-label"><i class="bi bi-calendar-check me-1"></i>CO Date Endorsed</div>
                                <div class="sf-grid">
                                    <div class="sf-field">
                                        <label>From</label>
                                        <input type="date" class="ff-input" @bind="_coDateEndorsedFrom" />
                                    </div>
                                    <div class="sf-field">
                                        <label>To</label>
                                        <input type="date" class="ff-input" @bind="_coDateEndorsedTo" />
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="sf-section-label"><i class="bi bi-patch-check me-1"></i>CO Date Approved</div>
                                <div class="sf-grid">
                                    <div class="sf-field">
                                        <label>From</label>
                                        <input type="date" class="ff-input" @bind="_coDateApprovedFrom" />
                                    </div>
                                    <div class="sf-field">
                                        <label>To</label>
                                        <input type="date" class="ff-input" @bind="_coDateApprovedTo" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sf-actions">
                            <button class="sf-btn sf-btn-clear" @onclick="ClearFilters" disabled="@_isLoading">Clear</button>
                            <button class="sf-btn sf-btn-apply" @onclick="ApplyFiltersAsync" disabled="@_isLoading">
                                <i class="bi bi-check2"></i> Apply
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="stats-top-row-side">
            <StatisticsUserRegionMap @ref="_regionMap" />
        </div>
    </div>

        @* ── No auto-loaded overall totals on page open — that was a full
             aggregate scan nobody asked for yet. The cards/tables stay visible
             (at zero) until the user hits Apply in the filter panel above,
             which is the only trigger that loads the report now. ── *@
        @if (!_hasLoadedReport)
        {
            <div class="alert alert-info mb-3">
                <i class="bi bi-info-circle me-2"></i>
                Showing zero counts — set at least one filter above and click <strong>Apply</strong> to load the report.
            </div>
        }

        @* ── Report content — dimmed (not removed) while a load is in flight,
             so a refresh/re-apply reads as "updating" rather than the whole
             page vanishing and rebuilding. ── *@
        <div class="stats-report-content @(_isLoading ? "stats-report-content--loading" : "")">
        @* ── Summary Cards — click a count to audit exactly who's included ──
             Reorganized into two purpose-labeled groups (payment status vs.
             financial/demographic) instead of one undifferentiated wall of
             tiles, and each status tile now shows its share of the total
             right under the count — all derived from the same _report
             values already bound above, nothing new fetched. ── *@
        <div id="stats-countup-root">
        <div class="dash-section-label"><i class="bi bi-clipboard2-data"></i> Grantee &amp; Payment Status</div>
        <div class="dash-stat-grid dash-stat-grid--cols-5 mb-3">
            <div class="dash-stat-card dash-stat-card--navy dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("all", "Total Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="dash-stat-value" data-countup="@_report.TotalBeneficiaries">0</div>
                <div class="dash-stat-label">Total Grantees</div>
                <div class="dash-stat-sub">All records matching filters</div>
            </div>
            <div class="dash-stat-card dash-stat-card--green dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("paid", "Paid Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div class="dash-stat-value" data-countup="@_report.PaidCount">0</div>
                <div class="dash-stat-label">Paid</div>
                <div class="dash-stat-sub">@SharePct(_report.PaidCount)% of total</div>
            </div>
            <div class="dash-stat-card dash-stat-card--red dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("unpaid", "Unpaid Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-x-circle-fill"></i></div>
                <div class="dash-stat-value" data-countup="@_report.UnpaidCount">0</div>
                <div class="dash-stat-label">Unpaid</div>
                <div class="dash-stat-sub">@SharePct(_report.UnpaidCount)% of total</div>
            </div>
            <div class="dash-stat-card dash-stat-card--amber dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("pending", "Pending Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-clock-fill"></i></div>
                <div class="dash-stat-value" data-countup="@_report.PendingCount">0</div>
                <div class="dash-stat-label">Pending</div>
                <div class="dash-stat-sub">@SharePct(_report.PendingCount)% of total</div>
            </div>
            <div class="dash-stat-card dash-stat-card--gray dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("notapplicable", "N/A Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-dash-circle-fill"></i></div>
                <div class="dash-stat-value" data-countup="@_report.NotApplicableCount">0</div>
                <div class="dash-stat-label">N/A</div>
                <div class="dash-stat-sub">@SharePct(_report.NotApplicableCount)% of total</div>
            </div>
        </div>

        <div class="dash-section-label"><i class="bi bi-cash-coin"></i> Financial &amp; Demographics</div>
        <div class="dash-stat-grid dash-stat-grid--cols-2 mb-3">
            <div class="dash-stat-card dash-stat-card--cyan dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("paid", "Grantees Included in Total Disbursed")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div class="dash-stat-value" data-countup="@_report.TotalDisbursement.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-countup-prefix="₱">₱0</div>
                <div class="dash-stat-label">Total Disbursed</div>
                <div class="dash-stat-sub">@(_report.PaidCount > 0 ? $"₱{(_report.TotalDisbursement / _report.PaidCount):N0} avg. per paid grantee" : "No paid grantees yet")</div>
            </div>

            @* ── Gender Split — one card in place of the old separate Male/
                 Female/%Female tiles, with a two-color bar so the ratio reads
                 at a glance instead of three numbers the viewer has to do
                 the math on themselves. Each half stays clickable, same
                 drill-down as before. ── *@
            <div class="dash-stat-card dash-stat-card--gender dash-stat-card--anim">
                <div class="dash-stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="dash-stat-label mb-2">Gender Split</div>
                <div class="gender-split-bar-track">
                    <div class="gender-split-bar-male" style="width:@(GenderPct(_report.TotalMale))%;"
                         @onclick='() => OpenMembersModalAsync("male", "Male Grantees")' title="Male — click to view">
                    </div>
                    <div class="gender-split-bar-female" style="width:@(GenderPct(_report.TotalFemale))%;"
                         @onclick='() => OpenMembersModalAsync("female", "Female Grantees")' title="Female — click to view">
                    </div>
                </div>
                <div class="gender-split-legend">
                    <span class="gender-split-legend-item gender-split-legend-item--clickable"
                          @onclick='() => OpenMembersModalAsync("male", "Male Grantees")'>
                        <i class="bi bi-gender-male"></i> Male
                        <strong data-countup="@_report.TotalMale">0</strong>
                        <span class="gender-split-legend-pct">(@GenderPct(_report.TotalMale)%)</span>
                    </span>
                    <span class="gender-split-legend-item gender-split-legend-item--clickable"
                          @onclick='() => OpenMembersModalAsync("female", "Female Grantees")'>
                        <i class="bi bi-gender-female"></i> Female
                        <strong data-countup="@_report.TotalFemale">0</strong>
                        <span class="gender-split-legend-pct">(@GenderPct(_report.TotalFemale)%)</span>
                    </span>
                </div>
            </div>
        </div>

        @* ── Liveness & EFT ─── stays INSIDE #stats-countup-root (closes below)
             so statsCountUp.run — which only queries [data-countup] within that
             root element — actually finds and animates these two cards' numbers
             instead of leaving them stuck at their static "0" markup. ── *@
        <div class="dash-section-label"><i class="bi bi-camera-fill"></i> Liveness &amp; EFT Readiness</div>
        <div class="dash-stat-grid dash-stat-grid--cols-2 mb-3">
            <div class="dash-stat-card dash-stat-card--cyan dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("liveness", "Liveness Verified Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-camera-fill"></i></div>
                <div class="dash-stat-value" data-countup="@_report.LivenessVerifiedCount">0</div>
                <div class="dash-stat-label">Liveness Verified</div>
                <div class="dash-stat-sub">@SharePct(_report.LivenessVerifiedCount)% of total</div>
            </div>
            <div class="dash-stat-card dash-stat-card--green dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("eft", "Ready for EFT Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-bank2"></i></div>
                <div class="dash-stat-value" data-countup="@_report.ReadyForEftCount">0</div>
                <div class="dash-stat-label">Ready for EFT</div>
                <div class="dash-stat-sub">@SharePct(_report.ReadyForEftCount)% of total</div>
            </div>
        </div>

        @* ── CO Status — stays inside #stats-countup-root for the same reason
             as Liveness/EFT above (count-up only animates within that root). ── *@
        <div class="dash-section-label"><i class="bi bi-building-check"></i> CO Status</div>
        <div class="dash-stat-grid dash-stat-grid--cols-2 mb-3">
            <div class="dash-stat-card dash-stat-card--navy dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("coendorsed", "CO Endorsed Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-send-check-fill"></i></div>
                <div class="dash-stat-value" data-countup="@_report.CoEndorsedCount">0</div>
                <div class="dash-stat-label">CO Endorsed</div>
                <div class="dash-stat-sub">@SharePct(_report.CoEndorsedCount)% of total</div>
            </div>
            <div class="dash-stat-card dash-stat-card--amber dash-stat-card--clickable dash-stat-card--anim"
                 @onclick='() => OpenMembersModalAsync("coapproved", "CO Approved Grantees")' title="Click to view the grantees in this count">
                <i class="bi bi-search dash-stat-card-hint"></i>
                <div class="dash-stat-icon"><i class="bi bi-patch-check-fill"></i></div>
                <div class="dash-stat-value" data-countup="@_report.CoApprovedCount">0</div>
                <div class="dash-stat-label">CO Approved</div>
                <div class="dash-stat-sub">@SharePct(_report.CoApprovedCount)% of total</div>
            </div>
        </div>
        </div>

        <div class="sys-card mb-3">
            <div class="sys-card-header">
                <i class="bi bi-bar-chart-line-fill me-2"></i>
                Liveness &amp; EFT Readiness Chart
            </div>
            <div class="sys-card-body">
                <div style="position:relative; height:180px;">
                    <canvas id="liveness-eft-chart"></canvas>
                </div>
            </div>
        </div>

        @* ── Milestone Year Summary ───────────────────────────────── *@
        @if (_report.MilestoneYearSummary.Any())
        {
            <div class="sys-card mb-3">
                <div class="sys-card-header">
                    <i class="bi bi-calendar-event me-2"></i>
                    Milestone Year Summary
                </div>
                <div class="sys-card-body">
                    <div style="position:relative; height:220px; margin-bottom:18px;">
                        <canvas id="milestone-year-chart"></canvas>
                    </div>
                    <div class="milestone-year-grid">
                        @foreach (var year in _report.MilestoneYearSummary.OrderByDescending(x => x.Year))
                        {
                            var maxYearCount = _report.MilestoneYearSummary.Any()
                                ? _report.MilestoneYearSummary.Max(x => x.TotalCount)
                                : 1;
                            var pct = maxYearCount > 0
                                ? (double)year.TotalCount / maxYearCount * 100
                                : 0;

                            var yoy = YoYDelta(year.Year);

                            <div class="milestone-year-card">
                                <div class="milestone-year-header">
                                    <span class="milestone-year-label">@year.Year</span>
                                    <span class="milestone-year-total-wrap">
                                        <span class="milestone-year-total">@year.TotalCount.ToString("N0")</span>
                                        @if (yoy.HasValue)
                                        {
                                            <span class="milestone-year-yoy @(yoy.Value >= 0 ? "milestone-year-yoy--up" : "milestone-year-yoy--down")">
                                                <i class="bi @(yoy.Value >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                                                @Math.Abs(yoy.Value)% vs @(year.Year - 1)
                                            </span>
                                        }
                                    </span>
                                </div>
                                <div class="milestone-year-bar-track">
                                    <div class="milestone-year-bar milestone-year-bar--@GetYearColor(year.Year)"
