                    </table>
                </div>
            </div>
        }

        @* ── Charts Row ───────────────────────────────────────────── *@
        <div class="dash-row">
            @* ── Age Distribution ────────────────────────────────── *@
            <div class="dash-card">
                <div class="dash-card-header">
                    <i class="bi bi-graph-up-arrow me-2"></i>
