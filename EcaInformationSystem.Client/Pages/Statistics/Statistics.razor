</div>

@* ── Grantee Audit Modal — shows exactly who is included in a summary
     card's count, so figures can be verified against actual records
     instead of taken on faith. Mirrors the CGP drill-down pattern in
     LiquidationModal.razor (full name + payment history per row). ── *@
<HxModal @ref="_membersModal" Size="ModalSize.ExtraLarge">
    <HeaderTemplate>
        <h5 class="modal-title">
            <i class="bi bi-people-fill me-2"></i>
            @_membersModalTitle
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        @if (_isLoadingMembers)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 mb-0">Loading grantees...</p>
            </div>
        }
        else if (!_members.Any())
        {
            <div class="alert alert-info mb-0">No grantees found for this count.</div>
        }
        else
        {
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary fs-6">@_membersTotalCount Total</span>
                    <button class="btn btn-sm btn-outline-success" disabled="@_isExportingGrantees" @onclick="ExportGranteesAsync"
                            title="Download this list as Excel, including bank/payout account (Section E) details">
                        @if (_isExportingGrantees)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span><span>Downloading...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel me-1"></i><span>Download Excel</span>
                        }
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_membersPageNumber <= 1 || _isLoadingMembers)"
                            @onclick="() => GoToMembersPageAsync(_membersPageNumber - 1)">
                        <i class="bi bi-chevron-left"></i> Prev
                    </button>
                    <span class="small text-muted">
                        Page @_membersPageNumber of @Math.Max(1, _membersTotalPages)
                        (@(((_membersPageNumber - 1) * _membersPageSize) + 1)–@Math.Min(_membersPageNumber * _membersPageSize, _membersTotalCount) of @_membersTotalCount)
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_membersPageNumber >= _membersTotalPages || _isLoadingMembers)"
                            @onclick="() => GoToMembersPageAsync(_membersPageNumber + 1)">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div style="max-height:480px; overflow-y:auto;">
                <table class="table table-sm table-bordered table-hover align-middle mb-0" style="font-size:12px;">
                    <thead class="table-dark" style="position:sticky;top:0;z-index:1;">
                        <tr>
                            <th style="width:36px;">#</th>
                            <th>Full Name</th>
                            <th style="width:90px;">Milestone Year</th>
                            <th style="width:50px;">Age</th>
                            <th>Location</th>
                            <th>Batch Code</th>
                            <th>Status</th>
                            <th style="min-width:200px;">Bank / Payout Account (Section E)</th>
                            <th style="min-width:260px;">Payment History</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = ((_membersPageNumber - 1) * _membersPageSize) + 1; }
                        @foreach (var m in _members)
                        {
                            <tr>
                                <td>@rowNum</td>
                                <td class="fw-semibold">@m.FullName</td>
                                <td>@(m.MilestoneYear > 0 ? m.MilestoneYear.ToString() : "—")</td>
                                <td>@m.Age</td>
                                <td>@m.MunicipalityName, @m.ProvinceName</td>
                                <td>@(string.IsNullOrWhiteSpace(m.BatchCode) ? "—" : m.BatchCode)</td>
                                <td><span class="badge @GetMemberStatusBadgeClass(m.PaymentStatus)">@GetMemberStatusLabel(m.PaymentStatus)</span></td>
                                <td>
                                    <div class="small text-muted">@m.PreferredChannelLabel</div>
                                    @if (!string.IsNullOrWhiteSpace(m.BankOrWalletName))
                                    {
                                        <div>@m.BankOrWalletName</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(m.AccountNumber))
                                    {
                                        <div>Acct: @m.AccountNumber</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(m.GCashOrMobileNumber))
                                    {
                                        <div>Mobile: @m.GCashOrMobileNumber</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(m.BranchName))
                                    {
                                        <div class="text-muted">Branch: @m.BranchName</div>
                                    }
                                </td>
                                <td>
                                    @if (!m.PaymentHistories.Any())
                                    {
                                        <span class="text-muted">No payment history yet</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var h in m.PaymentHistories)
                                            {
                                                <span class="badge @GetMemberStatusBadgeClass(h.PaymentStatus) text-start" style="font-weight:500;">
                                                    @(h.PayrollQuarter.HasValue ? $"Q{h.PayrollQuarter}" : "—")
                                                    @(h.FiscalYear.HasValue ? h.FiscalYear.ToString() : "")
                                                    — @GetMemberStatusLabel(h.PaymentStatus)
                                                    @(h.PaymentDate.HasValue ? $" ({h.PaymentDate.Value:MMM dd, yyyy})" : "")
                                                    @(h.IsCurrent ? " ★" : "")
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                            rowNum++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _membersModal.HideAsync()">Close</HxButton>
    </FooterTemplate>
</HxModal>

@code {
    private int _selectedPayrollQuarter;
    // ✅ CHANGED — starts false since nothing auto-loads on mount anymore.
    private bool _isLoading;
    // ✅ NEW — gates the summary cards/breakdowns: false until the user's
    // first explicit Apply/Refresh/Load Statistics action completes.
    private bool _hasLoadedReport;
    private string? _loadError;
    private bool _filterExpanded = true;
    private bool _showMunicipalityTable;
    private StatisticsUserRegionMap? _regionMap;
    // Set right after a successful report load; OnAfterRenderAsync consumes
    // it once (then resets it) to trigger the stat-card count-up animation
    // exactly once per load, after the new numbers are actually in the DOM.
    private bool _shouldAnimateCounters;

    private StatisticsReportDto _report = new();
    private List<RegionLookupDto> _regions = new();
    private List<ProvinceLookupDto> _provincesForRegion = new();
    private List<MunicipalityLookupDto> _municipalitiesForProvince = new();

    private int _selectedRegionId;
    private int _selectedProvinceId;
    private int _selectedMunicipalityId;
    private int _selectedFiscalYear; // 0 = all
    private int _selectedMilestoneYear;
    // ✅ NEW — separate, additive "anticipation" filter: multi-select
    // 2024/2025/2026, independent of _selectedMilestoneYear above (which
    // stays a single-year filter with its original behavior, untouched).
    private List<int> _selectedAnticipatedMilestoneYears = new();
    private record MilestoneYearOption(int Value, string Label);
    private readonly List<MilestoneYearOption> _anticipatedMilestoneYearOptions = new()
    {
        new(2024, "2024"),
        new(2025, "2025"),
        new(2026, "2026"),
    };
    private int _selectedMilestone;
    // ✅ CHANGED — multi-select payment status, same as BeneficiarySearchFilters.
    // Empty = no filter (was a single int with -1 meaning "all").
    private List<int> _selectedPaymentStatuses = new();
    private record PaymentStatusOption(int Value, string Label);
    private readonly List<PaymentStatusOption> _paymentStatusOptions = new()
    {
        new(2, "Paid"),
        new(1, "Unpaid"),
        new(3, "Pending"),
        new(0, "N/A"),
    };
    private DateTime? _dateEndorsedFrom;
    private DateTime? _dateEndorsedTo;
    private DateTime? _dateAddedFrom;
    private DateTime? _dateAddedTo;
    // ✅ new — tri-state, empty string = no filter, same pattern as other selects here
    private string _selectedLiveness = string.Empty;
    private string _selectedEft = string.Empty;
    // ✅ new — CO Date Endorsed/Approved, distinct from _dateEndorsedFrom/To above
    private DateTime? _coDateEndorsedFrom;
    private DateTime? _coDateEndorsedTo;
    private DateTime? _coDateApprovedFrom;
    private DateTime? _coDateApprovedTo;

    private bool _isLoadingProvinces;
    private bool _isLoadingMunicipalities;

    // ── Grantee Audit Modal ────────────────────────────────────────────
    private HxModal _membersModal = default!;
    private string _membersModalTitle = string.Empty;
    private string _membersBucket = "all";
    private bool _isLoadingMembers;
    private List<SharedDtos.StatisticsMemberDto> _members = new();
    private int _membersPageNumber = 1;
    private const int _membersPageSize = 50;
    private int _membersTotalCount;
    private int _membersTotalPages;
    // Snapshot of the filters active when the modal was opened — pagination
    // (Prev/Next) reuses this instead of re-reading live filter state, so
    // flipping pages can't silently change what's being counted mid-browse.
    private SharedDtos.StatisticsRequestDto _membersFilterSnapshot = new();

    // ── Properties with getter/setter for cascading ──────────────────
    private int SelectedRegion
    {
        get => _selectedRegionId;
        set
        {
            if (_selectedRegionId != value)
            {
                _selectedRegionId = value;
                _ = OnRegionChangedAsync();
            }
        }
    }

    private int SelectedProvince
    {
        get => _selectedProvinceId;
        set
        {
            if (_selectedProvinceId != value)
            {
                _selectedProvinceId = value;
                _ = OnProvinceChangedAsync();
            }
        }
    }

    private int SelectedMunicipality
    {
        get => _selectedMunicipalityId;
        set
        {
            if (_selectedMunicipalityId != value)
            {
                _selectedMunicipalityId = value;
            }
        }
    }

    // ✅ CHANGED — no longer auto-runs the (unfiltered, whole-database) report
    // on every page visit. That was a full aggregate scan fired before the
    // user even touched a filter — real cost, purely for a landing screen.
    // Now only the lightweight region lookup loads on mount; the report loads
    // on the user's first explicit action (Apply/Refresh/Load Statistics).
    protected override async Task OnInitializedAsync()
    {
        await LoadRegionsAsync();

        // Default the Region filter to the logged-in user's own registered
        // region — same pattern as BeneficiarySearchFilters.razor — so PDOs
        // don't have to reselect it every time they open this page. Admins/
        // SuperAdmins have no Region claim (they oversee every region), so
        // GetRegionCode() returns null for them and this simply no-ops,
        // leaving "All Regions" as their starting point same as before.
        await AuthService.InitAsync();
        var myRegion = AuthService.GetRegionCode();
        if (myRegion.HasValue)
        {
            _selectedRegionId = myRegion.Value;
            await LoadProvincesAsync(_selectedRegionId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_shouldAnimateCounters) return;
        _shouldAnimateCounters = false;
        try { await JS.InvokeVoidAsync("statsCountUp.run", "stats-countup-root"); }
        catch (Exception ex) { Console.WriteLine($"statsCountUp.run failed: {ex.Message}"); }

        await RenderChartsAsync();
    }

    // Real Chart.js charts instead of the old CSS-bar approximations —
    // fired on the same trigger as the count-up animation (right after a
    // successful report load), so the charts and numbers refresh together.
    private async Task RenderChartsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("statsCharts.renderPaymentStatus", "payment-status-chart", new
            {
                paid = _report.PaidCount,
                unpaid = _report.UnpaidCount,
                pending = _report.PendingCount,
                notApplicable = _report.NotApplicableCount
            });

            await JS.InvokeVoidAsync("statsCharts.renderAgeDistribution", "age-distribution-chart",
                _report.AgeDistribution.Select(a => new { age = a.Age, count = a.Count }).ToList());

            await JS.InvokeVoidAsync("statsCharts.renderLivenessEft", "liveness-eft-chart", new
            {
                total = _report.TotalBeneficiaries,
                livenessVerified = _report.LivenessVerifiedCount,
                readyForEft = _report.ReadyForEftCount
            });

            if (_report.MilestoneYearSummary.Any())
            {
                await JS.InvokeVoidAsync("statsCharts.renderMilestoneYears", "milestone-year-chart",
                    _report.MilestoneYearSummary.OrderBy(y => y.Year).Select(y => new
                    {
                        year = y.Year,
                        age80 = y.Age80Count,
                        age85 = y.Age85Count,
                        age90 = y.Age90Count,
                        age95 = y.Age95Count,
                        age100 = y.Age100Count
                    }).ToList());
            }

            if (_report.PayrollQuarterBreakdown.Any())
            {
                await JS.InvokeVoidAsync("statsCharts.renderQuarterDisbursement", "quarter-disbursement-chart",
                    _report.PayrollQuarterBreakdown
                        .OrderBy(q => q.FiscalYear).ThenBy(q => q.Quarter)
                        .Select(q => new
                        {
                            label = $"FY{q.FiscalYear} Q{q.Quarter}",
                            disbursed = q.TotalDisbursement
                        }).ToList());
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"RenderChartsAsync failed: {ex.Message}");
        }
    }

