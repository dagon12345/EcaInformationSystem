                                <td class="text-center age-cell">@AgeCell(_report.TotalAge85, _report.ProvinceBreakdowns.Sum(p => p.Age85MaleCount), _report.ProvinceBreakdowns.Sum(p => p.Age85FemaleCount))</td>
                                <td class="text-center age-cell">@AgeCell(_report.TotalAge90, _report.ProvinceBreakdowns.Sum(p => p.Age90MaleCount), _report.ProvinceBreakdowns.Sum(p => p.Age90FemaleCount))</td>
                                <td class="text-center age-cell">@AgeCell(_report.TotalAge95, _report.ProvinceBreakdowns.Sum(p => p.Age95MaleCount), _report.ProvinceBreakdowns.Sum(p => p.Age95FemaleCount))</td>
                                <td class="text-center age-cell">@AgeCell(_report.TotalAge100, _report.ProvinceBreakdowns.Sum(p => p.Age100MaleCount), _report.ProvinceBreakdowns.Sum(p => p.Age100FemaleCount))</td>
