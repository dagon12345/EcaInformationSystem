                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge80, _report.MunicipalityBreakdowns.Sum(m => m.Age80MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age80FemaleCount))</td>
                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge85, _report.MunicipalityBreakdowns.Sum(m => m.Age85MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age85FemaleCount))</td>
                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge90, _report.MunicipalityBreakdowns.Sum(m => m.Age90MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age90FemaleCount))</td>
                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge95, _report.MunicipalityBreakdowns.Sum(m => m.Age95MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age95FemaleCount))</td>
                                        <td class="text-center age-cell">@AgeCell(_report.TotalAge100, _report.MunicipalityBreakdowns.Sum(m => m.Age100MaleCount), _report.MunicipalityBreakdowns.Sum(m => m.Age100FemaleCount))</td>
                                        <td class="text-center">@_report.TotalMale</td>
                                        <td class="text-center">@_report.TotalFemale</td>
                                        <td class="text-end">₱@_report.TotalDisbursement.ToString("N0")</td>
