                                    </div>
                                </div>
                                <div class="milestone-year-breakdown">
                                    <span class="milestone-age-chip milestone-age-chip--80">80 <strong>@year.Age80Count</strong></span>
                                    <span class="milestone-age-chip milestone-age-chip--85">85 <strong>@year.Age85Count</strong></span>
                                    <span class="milestone-age-chip milestone-age-chip--90">90 <strong>@year.Age90Count</strong></span>
                                    <span class="milestone-age-chip milestone-age-chip--95">95 <strong>@year.Age95Count</strong></span>
                                    <span class="milestone-age-chip milestone-age-chip--100">100 <strong>@year.Age100Count</strong></span>
                                </div>
                            </div>
