    // ── Presentation-only derived percentages ──────────────────────────
    // Same values already bound on the cards above — just expressed as a
    // share of the total so a viewer isn't left doing the division
    // themselves. No new data, no change to what's fetched or counted.
    private int SharePct(int count) =>
        _report.TotalBeneficiaries > 0 ? (int)Math.Round((double)count / _report.TotalBeneficiaries * 100) : 0;

    private int GenderPct(int count)
    {
        var totalGendered = _report.TotalMale + _report.TotalFemale;
        return totalGendered > 0 ? (int)Math.Round((double)count / totalGendered * 100) : 0;
    }

    // Year-over-year % change for the Milestone Year Summary cards — purely
    // derived by comparing adjacent years already present in the same
    // MilestoneYearSummary list the cards already render from (no new
    // fetch). Null when there's no prior year in the loaded set, or the
    // prior year had zero grantees (percentage change would be undefined).
    private int? YoYDelta(int year)
    {
        var current = _report.MilestoneYearSummary.FirstOrDefault(y => y.Year == year);
        var previous = _report.MilestoneYearSummary.FirstOrDefault(y => y.Year == year - 1);
        if (current is null || previous is null || previous.TotalCount == 0) return null;

        return (int)Math.Round((double)(current.TotalCount - previous.TotalCount) / previous.TotalCount * 100);
    }

