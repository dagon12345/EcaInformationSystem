                    </div>
                </div>
            </div>
        }
        @if (_report.PayrollQuarterBreakdown.Any())
        {
            <div class="sys-card mb-3">
                <div class="sys-card-header">
                    <i class="bi bi-calendar3-range me-2"></i>
                    Payroll Quarter Breakdown
                </div>
                @* ── Suggested addition: this data had a table but no chart —
                     a quick bar of disbursement per quarter/fiscal-year makes
                     "which quarter cost the most" readable at a glance instead
                     of scanning the ₱ column row by row. ── *@
                <div class="sys-card-body pb-0">
                    <div style="position:relative; height:200px;">
                        <canvas id="quarter-disbursement-chart"></canvas>
                    </div>
                </div>
                <div class="sys-card-body p-0">
                    <table class="table table-sm mb-0 stat-table">
