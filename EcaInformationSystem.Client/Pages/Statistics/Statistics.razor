    // Guards the whole point of not auto-loading on page open: without this,
    // hitting Apply/Refresh with every filter left at "All" still fires the
    // same unfiltered whole-database aggregate scan we removed the auto-load
    // for in the first place.
    private bool HasAnyFilterSet() =>
        _selectedRegionId > 0 ||
        _selectedProvinceId > 0 ||
        _selectedMunicipalityId > 0 ||
        _selectedMilestoneYear > 0 ||
        _selectedAnticipatedMilestoneYears.Count > 0 ||
        _selectedMilestone > 0 ||
        _selectedPaymentStatuses.Count > 0 ||
        _selectedPayrollQuarter > 0 ||
        _selectedFiscalYear > 0 ||
        _dateAddedFrom.HasValue ||
        _dateAddedTo.HasValue ||
        _dateEndorsedFrom.HasValue ||
        _dateEndorsedTo.HasValue ||
        !string.IsNullOrEmpty(_selectedLiveness) ||
        !string.IsNullOrEmpty(_selectedEft) ||
        _coDateEndorsedFrom.HasValue ||
        _coDateEndorsedTo.HasValue ||
        _coDateApprovedFrom.HasValue ||
        _coDateApprovedTo.HasValue;

    private async Task LoadStatisticsAsync()
    {
        if (!HasAnyFilterSet())
        {
            Toast.ShowWarning("Set at least one filter before loading — the full, unfiltered database report isn't allowed.");
            return;
        }

        // Payroll Quarter is just 1-4 and repeats every fiscal year — without
        // a Fiscal Year to pin it down, it silently matches that quarter
        // across every year and sums them together (looks like wildly wrong
        // totals, e.g. Q1 showing more than the whole region has).
        if (_selectedPayrollQuarter > 0 && _selectedFiscalYear == 0)
        {
            Toast.ShowWarning($"Select a Fiscal Year to go with Payroll Quarter Q{_selectedPayrollQuarter} — a quarter alone spans every year.");
            return;
        }

        _isLoading = true;
        _loadError = null;

        try
        {
            var request = BuildFilterRequest();

            var response = await Http.PostAsJsonAsync("api/Statistics/report", request);

            if (response.IsSuccessStatusCode)
            {
                _report = await response.Content.ReadFromJsonAsync<StatisticsReportDto>() ?? new();
                _hasLoadedReport = true;
                _shouldAnimateCounters = true;

                // If Municipality was part of what was just applied, jump the
                // region map to it — same behavior as typing it into the
                // map's own search box, just triggered by Apply instead.
                // No-ops (via FocusMunicipalityAsync's own guards) if the map
                // isn't ready yet or the name isn't in the map's own region
                // dataset (e.g. filtering a municipality outside the user's
                // registered region).
                if (_selectedMunicipalityId > 0 && _regionMap is not null)
                {
                    var municipalityName = _municipalitiesForProvince
                        .FirstOrDefault(m => m.PsgcCodeMunicipality == _selectedMunicipalityId)?.Name;
                    if (!string.IsNullOrWhiteSpace(municipalityName))
                    {
                        await _regionMap.FocusMunicipalityAsync(municipalityName);
                    }
                }
            }
            else
            {
                _loadError = "Failed to load statistics report. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Could not reach the server: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleFilter() => _filterExpanded = !_filterExpanded;

    private async Task ClearFilters()
    {
        _selectedRegionId = 0;
        _selectedProvinceId = 0;
        _selectedMunicipalityId = 0;
        _selectedMilestoneYear = 0;
        _selectedAnticipatedMilestoneYears = new();
        _selectedMilestone = 0;
        _selectedPaymentStatuses = new();
        _provincesForRegion = new();
        _municipalitiesForProvince = new();
        _selectedPayrollQuarter = 0;
        _selectedFiscalYear = 0; // ✅ new
        _selectedLiveness = string.Empty;
        _selectedEft = string.Empty;
        _dateEndorsedFrom = null;
        _dateEndorsedTo = null;
        _dateAddedFrom = null;
        _dateAddedTo = null;
        _coDateEndorsedFrom = null;
        _coDateEndorsedTo = null;
        _coDateApprovedFrom = null;
        _coDateApprovedTo = null;

        // Without this, the cards/tables kept showing the LAST loaded
        // report's numbers after Clear — stale data with no filter behind
        // it anymore — and _hasLoadedReport staying true let a card click
        // straight through the OpenMembersModalAsync guard, fetching an
        // unfiltered members list despite the filters having just been wiped.
        _report = new();
        _hasLoadedReport = false;

        // The count-up JS writes card numbers straight into the DOM text,
        // bypassing Blazor's diffing — so on the next render Blazor thinks
        // those text nodes already say "0" (that's what its own render tree
        // last recorded) and skips touching them, leaving the old numbers
        // visibly stuck even though _report is now empty. Re-running the
        // animation forces the DOM to actually resync to the real value.
        _shouldAnimateCounters = true;

        // Snap the region map back to the whole-region view and clear any
        // municipality pin FocusMunicipalityAsync left behind — otherwise
        // Clear reset every filter/number on the page except the map, which
        // stayed zoomed into whatever municipality was last applied.
        if (_regionMap is not null)
        {
            await _regionMap.ResetViewAsync();
        }
    }

    private async Task ApplyFiltersAsync() => await LoadStatisticsAsync();
    private async Task RefreshAsync() => await LoadStatisticsAsync();

    // Single source of truth for "what's currently filtered" — used by both
    // the /report call (summary cards/breakdowns) and the /members audit call,
    // so the modal's grantee list always matches whatever the cards show.
    private SharedDtos.StatisticsRequestDto BuildFilterRequest() => new()
    {
        Region = _selectedRegionId > 0 ? _selectedRegionId : null,
        Province = _selectedProvinceId > 0 ? _selectedProvinceId : null,
        Municipality = _selectedMunicipalityId > 0 ? _selectedMunicipalityId : null,
        MilestoneYear = _selectedMilestoneYear,
        AnticipatedMilestoneYears = _selectedAnticipatedMilestoneYears,
        MilestoneAge = _selectedMilestone,
        PaymentStatuses = _selectedPaymentStatuses,
        PayrollQuarter = _selectedPayrollQuarter > 0 ? _selectedPayrollQuarter : null,
        FiscalYear = _selectedFiscalYear > 0 ? _selectedFiscalYear : null,
        DateEndorsedFrom = _dateEndorsedFrom,
        DateEndorsedTo = _dateEndorsedTo,
        DateAddedFrom = _dateAddedFrom,
        DateAddedTo = _dateAddedTo,
        IsLivenessVerified = _selectedLiveness switch
        {
            "verified" => true,
            "notverified" => false,
            _ => null
        },
        IsReadyForEft = _selectedEft switch
        {
            "ready" => true,
            "notready" => false,
            _ => null
        },
        CoDateEndorsedFrom = _coDateEndorsedFrom,
        CoDateEndorsedTo = _coDateEndorsedTo,
        CoDateApprovedFrom = _coDateApprovedFrom,
        CoDateApprovedTo = _coDateApprovedTo
    };

    private bool _isExportingGrantees;

    // "Download Excel" inside the audit modal — exports exactly what the
    // modal is currently showing (same Filter + Bucket the modal's own list
    // was fetched with, see OpenMembersModalAsync/FetchMembersPageAsync),
    // not just the unpaginated page currently on screen.
    private async Task ExportGranteesAsync()
    {
        if (_isExportingGrantees) return;
        _isExportingGrantees = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Statistics/export", new SharedDtos.StatisticsMembersRequestDto
            {
                Filter = _membersFilterSnapshot,
                Bucket = _membersBucket
            });
            if (!response.IsSuccessStatusCode)
            {
                Toast.ShowError($"Export failed: {await response.Content.ReadAsStringAsync()}");
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            if (bytes.Length == 0)
            {
                Toast.ShowError("No data returned from export.");
                return;
            }

            var safeTitle = string.Join("_", _membersModalTitle.Split(System.IO.Path.GetInvalidFileNameChars()));
            await JS.InvokeVoidAsync("downloadFile", $"{safeTitle}_{DateTime.Now:yyyy-MM-dd}.xlsx", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Export failed: {ex.Message}");
        }
        finally
        {
            _isExportingGrantees = false;
        }
    }

    private async Task OpenMembersModalAsync(string bucket, string title)
    {
        // Same loophole the LoadStatisticsAsync guard closes: the cards are
        // always rendered (showing 0 before a filtered report has ever been
        // loaded), and clicking one went straight to the members endpoint
        // with whatever filter state happened to be sitting there — which,
        // before Apply, is empty. That silently pulled the entire unfiltered
        // grantee list for the clicked bucket despite the card reading "0".
        if (!_hasLoadedReport)
        {
            Toast.ShowWarning("Load a filtered report first (set at least one filter and click Apply) before drilling into a count.");
            return;
        }

        _membersModalTitle = title;
        _membersBucket = bucket;
        _membersFilterSnapshot = BuildFilterRequest();
        _membersPageNumber = 1;
        _members = new();
        _membersTotalCount = 0;
        _membersTotalPages = 0;
        await _membersModal.ShowAsync();
        await FetchMembersPageAsync();
    }

    private async Task GoToMembersPageAsync(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > _membersTotalPages || _isLoadingMembers) return;
        _membersPageNumber = pageNumber;
        await FetchMembersPageAsync();
    }

    private async Task FetchMembersPageAsync()
    {
        _isLoadingMembers = true;
        StateHasChanged();

        try
        {
            var request = new SharedDtos.StatisticsMembersRequestDto
            {
                Filter = _membersFilterSnapshot,
                Bucket = _membersBucket,
                PageNumber = _membersPageNumber,
                PageSize = _membersPageSize
            };

            var response = await Http.PostAsJsonAsync("api/Statistics/members", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SharedDtos.StatisticsMembersPagedResultDto>();
                _members = result?.Items ?? new();
                _membersTotalCount = result?.TotalCount ?? 0;
                _membersTotalPages = result?.TotalPages ?? 0;
            }
        }
        finally
        {
            _isLoadingMembers = false;
            StateHasChanged();
        }
    }

