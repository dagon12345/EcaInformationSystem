    {
        0 => "bg-warning text-dark",
        1 => "bg-success",
        2 => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetStatusLabel(int status) => status switch
    {
        0 => "Pending",
        1 => "Approved",
        2 => "Rejected",
        _ => "Unknown"
    };

    private static string GetRoleDescription(string role) => role switch
    {
        "SuperAdmin" =>
            "Full access including user management. Only one or two people should have this.",
        "Admin" =>
            "Full operational access: create, edit, delete, bulk operations, payroll.",
