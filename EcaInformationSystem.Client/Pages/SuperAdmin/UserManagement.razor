    private void OnProvinceFilterChanged()
    {
        // ── Reset municipality when province changes ──────────────────────────
        _filterMunicipality = string.Empty;
        StateHasChanged();
    }
    // ── Filtered provinces + municipalities based on search term ──────────────
    private Dictionary<string, List<(int Code, string Name)>>
        FilteredJurisdictionProvinces
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_jurSearchTerm))
                return _availableProvinces;

            var term = _jurSearchTerm.Trim().ToLower();
            var result = new Dictionary<string, List<(int Code, string Name)>>();

            foreach (var kvp in _availableProvinces)
            {
                // ── Province name matches → show all its municipalities ────────
                if (kvp.Key.ToLower().Contains(term))
                {
                    result[kvp.Key] = kvp.Value;
                    continue;
                }

                // ── Otherwise filter municipalities by name ────────────────────
                var matchedMusis = kvp.Value
                    .Where(m => m.Name.ToLower().Contains(term))
                    .ToList();

                if (matchedMusis.Any())
                    result[kvp.Key] = matchedMusis;
            }

            return result;
        }
    }

    // ── Select all currently visible (filtered) municipalities ────────────────
    private void SelectAllVisibleAsync()
    {
        foreach (var province in FilteredJurisdictionProvinces.Values)
            foreach (var muni in province)
                _selectedMunicipalities.Add(muni.Code);

        StateHasChanged();
    }
    private async Task ResetUserMfa(Guid userId, string userName)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Reset MFA for {userName}? They will need to set it up again on next login.");
        if (!confirmed) return;

        try
        {
            var response = await Http.PostAsync($"api/auth/mfa/admin-reset/{userId}", null);
            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess($"MFA reset for {userName}.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.ShowError(string.IsNullOrWhiteSpace(error) ? "Failed to reset MFA." : error);
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Error: {ex.Message}");
        }
    }

    // ── Highlight matched text in municipality names ──────────────────────────
    private MarkupString HighlightMatch(string text, string? term)
    {
        if (string.IsNullOrWhiteSpace(term))
            return new MarkupString(
                System.Web.HttpUtility.HtmlEncode(text));

        var encoded = System.Web.HttpUtility.HtmlEncode(text);
        var encodedTerm = System.Web.HttpUtility.HtmlEncode(term.Trim());

        var result = System.Text.RegularExpressions.Regex.Replace(
            encoded,
            System.Text.RegularExpressions.Regex.Escape(encodedTerm),
            m => $"<mark style='background:#fef08a; padding:0 2px; " +
                 $"border-radius:2px;'>{m.Value}</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return new MarkupString(result);
    }

    private void ClearFilters()
    {
        _searchName = string.Empty;
        _filterProvince = string.Empty;
        _filterMunicipality = string.Empty;
        _filterRegion = string.Empty; // ✅ NEW
        StateHasChanged();
    }
    private IEnumerable<UserListDto> FilteredUsers
    {
        get
        {
            var query = _activeTab switch
            {
                "Pending" => _users.Where(u => u.ApprovalStatus == 0),
                "Approved" => _users.Where(u => u.ApprovalStatus == 1),
                "Rejected" => _users.Where(u => u.ApprovalStatus == 2),
                _ => _users.AsEnumerable()
            };

            // ── Name search ───────────────────────────────────────────────────
            if (!string.IsNullOrWhiteSpace(_searchName))
            {
                var term = _searchName.Trim().ToLower();
                query = query.Where(u =>
                    (u.FullName?.ToLower().Contains(term) == true) ||
                    (u.UserName?.ToLower().Contains(term) == true) ||
                    (u.Position?.ToLower().Contains(term) == true));
            }
            // ✅ NEW
            if (!string.IsNullOrWhiteSpace(_filterRegion))
            {
                query = query.Where(u =>
                    u.RegionName?.Equals(_filterRegion, StringComparison.OrdinalIgnoreCase) == true);
            }

            // ── Province filter ───────────────────────────────────────────────
            if (!string.IsNullOrWhiteSpace(_filterProvince))
            {
                query = query.Where(u =>
                    u.Jurisdictions.Any(j =>
                        j.ProvinceName?.Equals(
                            _filterProvince,
                            StringComparison.OrdinalIgnoreCase) == true));
            }

            // ── Municipality filter ───────────────────────────────────────────
            if (!string.IsNullOrWhiteSpace(_filterMunicipality))
            {
                query = query.Where(u =>
                    u.Jurisdictions.Any(j =>
                        j.MunicipalityName?.Equals(
                            _filterMunicipality,
                            StringComparison.OrdinalIgnoreCase) == true));
            }

            return query;
        }
    }
    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitAsync();
        _authorized = AuthService.IsSuperAdmin();
        _initialized = true; // ✅ now the markup knows we've checked

        if (_authorized)
            await LoadUsersAsync();

        StateHasChanged();
    }

    // ── Data ──────────────────────────────────────────────────────────────────
    private async Task LoadUsersAsync()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            _users = await Http.GetFromJsonAsync<List<UserListDto>>(
                "api/user-management") ?? new();

            // ── Build unique province/municipality lists for filter dropdowns ─
            _filterableProvinces = _users
                .SelectMany(u => u.Jurisdictions)
                .Select(j => j.ProvinceName ?? string.Empty)
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(p => p)
                .ToList();

            _filterableMunicipalities = _users
                .SelectMany(u => u.Jurisdictions)
                .Select(j => j.MunicipalityName ?? string.Empty)
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(m => m)
                .ToList();
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to load users: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // ── Approve ───────────────────────────────────────────────────────────────
    private async Task OpenApproveModal(UserListDto user)
    {
        _selectedUser = user;
        _approveRole = user.Role;
        _approveRemarks = user.Remarks;
        await _approveModal.ShowAsync();
    }

    private async Task ConfirmApproveAsync()
    {
        if (_selectedUser is null) return;
        try
        {
            _isSaving = true;
            var response = await Http.PostAsJsonAsync(
                $"api/user-management/{_selectedUser.Id}/approve",
                new ApproveUserRequestDto
                {
                    Role = _approveRole,
                    Remarks = _approveRemarks
                });

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess(
                    $"{_selectedUser.FullName} approved as {_approveRole}.");
                await _approveModal.HideAsync();
                await LoadUsersAsync();

                // ✅ Auto-open jurisdiction modal when approving as PDO
                if (_approveRole == "PDO")
                {
                    var updated = _users.FirstOrDefault(
                        u => u.Id == _selectedUser.Id);
                    if (updated is not null)
                        await OpenJurisdictionModal(updated);
                }
            }
            else
            {
                toast.ShowError(await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { toast.ShowError($"Error: {ex.Message}"); }
        finally { _isSaving = false; }
    }

    // ── Reject ────────────────────────────────────────────────────────────────
    private async Task OpenRejectModal(UserListDto user)
    {
        _selectedUser = user;
        _rejectRemarks = null;
        await _rejectModal.ShowAsync();
    }

    private async Task ConfirmRejectAsync()
    {
        if (_selectedUser is null) return;
        try
        {
            _isSaving = true;
            var response = await Http.PostAsJsonAsync(
                $"api/user-management/{_selectedUser.Id}/reject",
