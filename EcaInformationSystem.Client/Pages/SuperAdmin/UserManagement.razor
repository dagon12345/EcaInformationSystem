    private async Task ViewResetCodeAsync(Guid id)
    {
        try
        {
            var response = await Http.GetAsync($"api/user-management/password-reset-requests/{id}/view-code");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApprovePasswordResetResultDto>();
                if (result != null)
                {
                    _generatedCode = result.Code;
                    _generatedCodeExpiresAt = result.ExpiresAt;
                    await _resetCodeModal.ShowAsync();
                }
            }
            else
