            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess($"{_selectedUser.FullName} rejected.");
                await _rejectModal.HideAsync();
                await LoadUsersAsync();
            }
            else { toast.ShowError(await response.Content.ReadAsStringAsync()); }
        }
        catch (Exception ex) { toast.ShowError($"Error: {ex.Message}"); }
        finally { _isSaving = false; }
    }

    // ── Jurisdiction ──────────────────────────────────────────────────────────
    private async Task OpenJurisdictionModal(UserListDto user)
    {
        _selectedUser = user;
        _selectedMunicipalities = new HashSet<int>(
            user.Jurisdictions.Select(j => j.PsgcCodeMunicipality));
        _availableProvinces = new();
        _isLoadingJurisdictions = true;

        await _jurisdictionModal.ShowAsync();
        StateHasChanged();

        try
        {
            var provinces = await Http.GetFromJsonAsync<List<ProvinceLookupDto>>(
                "api/Province") ?? new();

            // ── Deduplicate provinces by name ─────────────────────────────────
            var uniqueProvinces = provinces
                .GroupBy(p => p.Name?.Trim().ToUpperInvariant())
                .Select(g => g.OrderBy(p => p.PsgcCodeProvince).First())
                .OrderBy(p => p.Name)
                .ToList();

            foreach (var province in uniqueProvinces)
            {
                var munis = await Http.GetFromJsonAsync<List<MunicipalityLookupDto>>(
                    $"api/Municipality/by-province/{province.PsgcCodeProvince}")
                    ?? new();

                if (munis.Any())
                    _availableProvinces[province.Name ?? "Unknown"] = munis
                        .Select(m => (m.PsgcCodeMunicipality, m.Name ?? string.Empty))
                        .ToList();
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Failed to load municipalities: {ex.Message}");
        }
        finally
        {
            _isLoadingJurisdictions = false;
            StateHasChanged();
        }
    }
    private void ToggleMunicipality(int code)
    {
        if (!_selectedMunicipalities.Remove(code))
            _selectedMunicipalities.Add(code);
        StateHasChanged();
    }

    private void ToggleProvince(
        List<(int Code, string Name)> munis, bool check)
    {
        foreach (var m in munis)
        {
            if (check) _selectedMunicipalities.Add(m.Code);
            else _selectedMunicipalities.Remove(m.Code);
        }
        StateHasChanged();
    }

    private bool IsProvinceAllChecked(List<(int Code, string Name)> munis)
        => munis.Any() && munis.All(m => _selectedMunicipalities.Contains(m.Code));

    private void ClearAllMunicipalities()
    {
        _selectedMunicipalities.Clear();
        StateHasChanged();
    }

    private async Task SaveJurisdictionsAsync()
    {
        if (_selectedUser is null) return;
        try
        {
            _isSaving = true;
            var response = await Http.PostAsJsonAsync(
                $"api/user-management/{_selectedUser.Id}/jurisdictions",
                new AssignJurisdictionRequestDto
                {
                    MunicipalityCodes = _selectedMunicipalities.ToList()
                });

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess(
                    $"Jurisdictions saved — {_selectedMunicipalities.Count} " +
                    "municipality(ies) assigned.");
                await _jurisdictionModal.HideAsync();
                await LoadUsersAsync();
            }
            else { toast.ShowError(await response.Content.ReadAsStringAsync()); }
        }
        catch (Exception ex) { toast.ShowError($"Error: {ex.Message}"); }
        finally { _isSaving = false; }
    }
    private void SwitchToUsersTab()
    {
        _topTab = "Users";
    }

    private int PendingResetCount => _resetRequests.Count(r => r.Status == 0);

    private async Task SwitchToPasswordResetsTab()
    {
        _topTab = "PasswordResets";
        await LoadPasswordResetsAsync();
    }

    private async Task LoadPasswordResetsAsync()
    {
        try
        {
            _resetRequests = await Http.GetFromJsonAsync<List<PasswordResetRequestListDto>>(
                "api/user-management/password-reset-requests") ?? new();
