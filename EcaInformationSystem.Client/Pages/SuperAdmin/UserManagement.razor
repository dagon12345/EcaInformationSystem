    private async Task ApproveResetAsync(Guid id)
    {
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/user-management/password-reset-requests/{id}/approve",
                new ApprovePasswordResetDto());

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApprovePasswordResetResultDto>();
                if (result != null)
                {
                    _generatedCode = result.Code;
                    _generatedCodeExpiresAt = result.ExpiresAt;
                    await _resetCodeModal.ShowAsync();
                }
                await LoadPasswordResetsAsync();
            }
            else
            {
                toast.ShowError(await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task RejectResetAsync(Guid id)
    {
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/user-management/password-reset-requests/{id}/reject",
                new RejectPasswordResetDto());

            if (response.IsSuccessStatusCode)
            {
                toast.ShowSuccess("Request rejected.");
                await LoadPasswordResetsAsync();
            }
            else
            {
                toast.ShowError(await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            toast.ShowError($"Error: {ex.Message}");
        }
    }

