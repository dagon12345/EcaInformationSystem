@* Client/Pages/SuperAdmin/UserManagement.razor *@
@page "/user-management"
@attribute [Authorize]
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.DTOs.Auth
@using EcaInformationSystem.Shared.DTOs.UserManagement
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject AuthService AuthService
@inject ToastService toast
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>User Management</PageTitle>

<div class="container-fluid py-3">

    <div class="page-header-bar mb-3">
        <div class="page-header-icon">
            <i class="bi bi-people-fill"></i>
        </div>
        <div>
            <h5 class="page-header-title">User Management</h5>
            <span class="page-header-sub">
                Approve registrations, assign roles, and set PDO jurisdictions
            </span>
        </div>
    </div>

    @* ── Not yet initialized ──────────────────────────────────────────────── *@
    @if (!_initialized)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted small">Checking access...</p>
        </div>
    }
    @* ── Unauthorized ─────────────────────────────────────────────────────── *@
    else if (!_authorized)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bi bi-shield-lock fs-5"></i>
            <div>
                <strong>Access Denied</strong>
                <p class="mb-0 small">
                    This page is restricted to Super Administrators only.
                </p>
            </div>
        </div>
    }
    @* ── Loading users ────────────────────────────────────────────────────── *@
    else if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">Loading users...</p>
        </div>
    }
    @* ── Main content ─────────────────────────────────────────────────────── *@
    else
    {
        <div class="d-flex gap-2 mb-3 flex-wrap">
            <button class="btn btn-sm @(_topTab == "Users" ? "btn-primary" : "btn-outline-secondary")" @onclick="SwitchToUsersTab">
                Users
            </button>
            <button class="btn btn-sm @(_topTab == "PasswordResets" ? "btn-primary" : "btn-outline-secondary")" @onclick="SwitchToPasswordResetsTab">
                Password Resets
                @if (PendingResetCount > 0)
                {
                    <span class="badge bg-danger ms-1">@PendingResetCount</span>
                }
            </button>
        </div>

        @if (_topTab == "Users")
        {
            @* ── Filter tabs ─────────────────────────────────────────────────── *@
            <div class="d-flex gap-2 mb-3 flex-wrap">
                @foreach (var tab in new[] { "All", "Pending", "Approved", "Rejected" })
                {
                    <button class="btn btn-sm @(_activeTab == tab ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => _activeTab = tab">
                        @tab
                        @if (tab == "Pending" && PendingCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@PendingCount</span>
                        }
                    </button>
                }
            </div>
            @* ── Filter bar ──────────────────────────────────────────────────────────── *@
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-end">

                        @* Name search *@
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">
                                <i class="bi bi-search me-1"></i>Search
                            </label>
                            <input type="text" class="form-control form-control-sm" placeholder="Name, username, position..."
                                   @bind="_searchName" @bind:event="oninput" />
                        </div>
                        @* ✅ NEW — Region filter *@
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold mb-1">
                                <i class="bi bi-geo-alt-fill me-1"></i>Region
                            </label>
                            <select class="form-select form-select-sm" @bind="_filterRegion">
                                <option value="">All Regions</option>
                                @foreach (var r in _filterableRegions)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </div>

                        @* Province filter *@
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">
                                <i class="bi bi-map me-1"></i>Province
                            </label>
                            <select class="form-select form-select-sm" @bind="_filterProvince"
                                    @bind:after="OnProvinceFilterChanged">
                                <option value="">All Provinces</option>
                                @foreach (var p in _filterableProvinces)
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        </div>

                        @* Municipality filter *@
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">
                                <i class="bi bi-building me-1"></i>Municipality
                            </label>
                            <select class="form-select form-select-sm" @bind="_filterMunicipality">
                                <option value="">All Municipalities</option>
                                @foreach (var m in _filteredMunicipalityOptions)
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                        </div>

                        @* Clear button *@
                        <div class="col-md-2">
                            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="ClearFilters"
                                    disabled="@(!HasActiveFilter)">
                                <i class="bi bi-x-circle me-1"></i>Clear
                            </button>
                        </div>

                    </div>

                    @* ── Active filter summary ── *@
                    @if (HasActiveFilter)
                    {
                        <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                            <small class="text-muted">Showing</small>
                            <span class="badge bg-primary">
                                @FilteredUsers.Count() of @_users.Count user(s)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(_searchName))
                            {
                                <span class="badge bg-secondary">
                                    Name: "@_searchName"
                                    <button class="btn-close btn-close-white ms-1" style="font-size:8px;"
                                            @onclick="() => _searchName = string.Empty">
                                    </button>
                                </span>
                            }
                            @* ✅ NEW *@
                            @if (!string.IsNullOrWhiteSpace(_filterRegion))
                            {
                                <span class="badge bg-secondary">
                                    Region: @_filterRegion
                                    <button class="btn-close btn-close-white ms-1" style="font-size:8px;"
                                            @onclick="() => _filterRegion = string.Empty">
                                    </button>
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_filterProvince))
                            {
                                <span class="badge bg-secondary">
                                    Province: @_filterProvince
                                    <button class="btn-close btn-close-white ms-1" style="font-size:8px;"
                                            @onclick="() => { _filterProvince = string.Empty; _filterMunicipality = string.Empty; }">
                                    </button>
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_filterMunicipality))
                            {
                                <span class="badge bg-secondary">
                                    Municipality: @_filterMunicipality
                                    <button class="btn-close btn-close-white ms-1" style="font-size:8px;"
                                            @onclick="() => _filterMunicipality = string.Empty">
                                    </button>
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive user-tbl-wrap">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Full Name</th>
                                    <th>Username</th>
                                    <th>Position</th>
                                    <th>Region</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Requested</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in FilteredUsers)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@user.FullName</div>
                                            @if (user.Jurisdictions.Any())
                                            {
                                                <small class="text-muted">
                                                    <i class="bi bi-geo-alt me-1"></i>
                                                    @user.Jurisdictions.Count municipality(ies) assigned
                                                </small>
                                            }
                                        </td>
                                        <td><code>@user.UserName</code></td>
                                        <td>@user.Position</td>
                                        <td>
                                            @* ✅ NEW *@
                                            @if (string.IsNullOrWhiteSpace(user.RegionName) || user.RegionName == "Not set")
                                            {
                                                <span class="badge bg-secondary">Not set</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">
                                                    <i class="bi bi-geo-alt-fill me-1"></i>@user.RegionName
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @GetRoleBadgeClass(user.Role)">
                                                @user.Role
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(user.ApprovalStatus)">
                                                @GetStatusLabel(user.ApprovalStatus)
                                            </span>
                                        </td>
                                        <td>
                                            <small>
                                                @user.RequestedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1 flex-wrap">
                                                @if (user.ApprovalStatus == 0)
                                                {
                                                    <button class="btn btn-sm btn-success" @onclick="() => OpenApproveModal(user)">
                                                        <i class="bi bi-check-lg me-1"></i>Approve
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" @onclick="() => OpenRejectModal(user)">
                                                        <i class="bi bi-x-lg me-1"></i>Reject
                                                    </button>
                                                }
                                                @if (user.ApprovalStatus == 1)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenApproveModal(user)">
                                                        <i class="bi bi-pencil me-1"></i>Edit Role
                                                    </button>
                                                    @if (user.Role == "PDO")
                                                    {
                                                        <button class="btn btn-sm btn-outline-info"
                                                                @onclick="() => OpenJurisdictionModal(user)">
                                                            <i class="bi bi-geo-alt me-1"></i>Jurisdiction
                                                        </button>
                                                    }
                                                }
                                                @if (user.IsMfaEnabled)
                                                {
                                                    <button @onclick="() => ResetUserMfa(user.Id, user.UserName)" class="btn btn-sm btn-outline-warning">
                                                        Reset MFA
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!FilteredUsers.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            No users in this category.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (_topTab == "PasswordResets")
        {
            @* ── Filter bar ──────────────────────────────────────────────── *@
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-end">

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">
                                <i class="bi bi-search me-1"></i>Search
                            </label>
                            <input type="text" class="form-control form-control-sm" placeholder="Name or username..."
                                   @bind="_resetSearchName" @bind:event="oninput" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">
                                <i class="bi bi-geo-alt-fill me-1"></i>Region
                            </label>
                            <select class="form-select form-select-sm" @bind="_resetFilterRegion">
                                <option value="">All Regions</option>
                                @foreach (var r in _resetFilterableRegions)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="ClearResetFilters"
                                    disabled="@(!ResetHasActiveFilter)">
                                <i class="bi bi-x-circle me-1"></i>Clear
                            </button>
                        </div>

                    </div>

                    @if (ResetHasActiveFilter)
                    {
                        <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                            <small class="text-muted">Showing</small>
                            <span class="badge bg-primary">
                                @FilteredResetRequests.Count() of @_resetRequests.Count request(s)
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Username</th>
                                    <th>Full Name</th>
                                    <th>Region</th>
                                    <th>Status</th>
                                    <th>Requested</th>
                                    <th>Resolved</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in FilteredResetRequests)
                                {
                                    <tr>
                                        <td><code>@req.UserName</code></td>
                                        <td>@req.FullName</td>
                                        <td>
                                            <span class="badge bg-info text-dark">
                                                <i class="bi bi-geo-alt-fill me-1"></i>@req.RegionName
                                            </span>
                                        </td>
                                        <td>
                                            @if (req.Status == 1 && req.CodeExpiresAt.HasValue && req.CodeExpiresAt.Value <= DateTime.UtcNow)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-clock-history me-1"></i>Expired
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge @GetResetStatusBadgeClass(req.Status)">
                                                    @GetResetStatusLabel(req.Status)
                                                </span>
                                            }
                                        </td>
                                        <td><small>@req.RequestedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</small></td>
                                        <td>
                                            @if (req.ResolvedAt.HasValue)
                                            {
                                                <small>@req.ResolvedAt.Value.ToLocalTime().ToString("MMM dd, yyyy h:mm tt") by @req.ResolvedBy</small>
                                            }
                                        </td>
                                        <td>
                                            @if (req.Status == 0)
                                            {
                                                <button class="btn btn-sm btn-success" @onclick="() => ApproveResetAsync(req.Id)">
                                                    <i class="bi bi-check-lg me-1"></i>Approve
                                                </button>
                                                <button class="btn btn-sm btn-danger" @onclick="() => RejectResetAsync(req.Id)">
                                                    <i class="bi bi-x-lg me-1"></i>Reject
                                                </button>
                                            }
                                            else if (req.Status == 1 && req.CodeExpiresAt.HasValue && req.CodeExpiresAt.Value > DateTime.UtcNow)
                                            {
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewResetCodeAsync(req.Id)">
                                                    <i class="bi bi-eye me-1"></i>View Code
                                                </button>
                                            }
                                            else if (req.Status == 1)
                                            {
                                                @* ✅ NEW — expired, offer regenerate instead of forcing user to resubmit *@
                                                <button class="btn btn-sm btn-outline-warning" @onclick="() => RegenerateResetCodeAsync(req.Id)">
                                                    <i class="bi bi-arrow-clockwise me-1"></i>Regenerate
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!FilteredResetRequests.Any())
                                {
                                    <tr><td colspan="7" class="text-center text-muted py-4">No password reset requests match your filters.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

    }

</div>
<HxModal @ref="_resetCodeModal">
    <HeaderTemplate>
        <h5 class="modal-title text-success"><i class="bi bi-key-fill me-2"></i>Reset Code Generated</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p>Give this code to the user. It expires <strong>@_generatedCodeExpiresAt?.ToLocalTime().ToString("h:mm tt")</strong> (in 30 minutes).</p>
        <div class="text-center p-3" style="background:#f0fdf4;border:1px solid #86efac;border-radius:8px;">
            <span style="font-size:24px;font-weight:700;letter-spacing:3px;color:#166534;">@_generatedCode</span>
        </div>
        <p class="text-muted small mt-2 mb-0">This code will not be shown again. Copy it now if needed.</p>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _resetCodeModal.HideAsync()">Close</HxButton>
    </FooterTemplate>
</HxModal>

@* ── Approve / Edit Role Modal ────────────────────────────────────────────── *@
<HxModal @ref="_approveModal">
    <HeaderTemplate>
        <h5 class="modal-title">
            @(_selectedUser?.ApprovalStatus == 0 ? "Approve User" : "Edit Role")
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        @if (_selectedUser is not null)
        {
            <div class="mb-3">
                <strong>@_selectedUser.FullName</strong>
                <div class="text-muted small">
                    @_selectedUser.UserName · @_selectedUser.Position
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    Assign Role <span class="text-danger">*</span>
                </label>
                <select class="form-select" @bind="_approveRole">
                    <option value="Viewer">Viewer — view and upload only</option>
                    <option value="PDO">PDO — Project Development Officer</option>
                    <option value="Admin">Admin — full operational access</option>
                    <option value="SuperAdmin">Super Admin — user management</option>
                </select>
                <small class="text-muted mt-1 d-block">
                    @GetRoleDescription(_approveRole)
                </small>
            </div>

            <div class="mb-0">
                <label class="form-label fw-semibold">Remarks (optional)</label>
                <textarea class="form-control" rows="2" @bind="_approveRemarks"
                          placeholder="Internal notes about this approval..."></textarea>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _approveModal.HideAsync()">
            Cancel
        </HxButton>
        <HxButton Color="ThemeColor.Success" @onclick="ConfirmApproveAsync" Disabled="@_isSaving">
            <span>@(_selectedUser?.ApprovalStatus == 0 ? "Approve" : "Save Changes")</span>
        </HxButton>
    </FooterTemplate>
</HxModal>

@* ── Reject Modal ─────────────────────────────────────────────────────────── *@
<HxModal @ref="_rejectModal">
    <HeaderTemplate>
        <h5 class="modal-title text-danger">Reject Registration</h5>
    </HeaderTemplate>
    <BodyTemplate>
        @if (_selectedUser is not null)
        {
            <p>
                You are about to reject
                <strong>@_selectedUser.FullName</strong>.
                They will not be able to log in.
            </p>
            <div class="mb-0">
                <label class="form-label fw-semibold">Reason (optional)</label>
                <textarea class="form-control" rows="2" @bind="_rejectRemarks"
                          placeholder="Reason for rejection..."></textarea>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" @onclick="() => _rejectModal.HideAsync()">
            Cancel
        </HxButton>
        <HxButton Color="ThemeColor.Danger" @onclick="ConfirmRejectAsync" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <span>Yes, Reject</span>
        </HxButton>
    </FooterTemplate>
</HxModal>

@* ── Jurisdiction Modal ───────────────────────────────────────────────────── *@
<HxModal @ref="_jurisdictionModal" Size="ModalSize.ExtraLarge" Scrollable="true">
    <HeaderTemplate>
        <h5 class="modal-title">
            <i class="bi bi-geo-alt me-2"></i>
            Assign Jurisdictions — @_selectedUser?.FullName
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        @if (_isLoadingJurisdictions)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
                <p class="mt-2">Loading municipalities...</p>
            </div>
        }
        else
        {
            @* ── Sticky search + summary bar ─────────────────────────────── *@
            <div class="jur-sticky-bar">

                @* Search input *@
                <div class="input-group input-group-sm" style="max-width:260px;">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control" placeholder="Search province or municipality..."
                           @bind="_jurSearchTerm" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_jurSearchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => _jurSearchTerm = string.Empty">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>

                @* Selection summary *@
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-primary fs-6">
                        <i class="bi bi-check2-circle me-1"></i>
                        @_selectedMunicipalities.Count selected
                    </span>

                    @* Quick actions *@
                    <button class="btn btn-sm btn-outline-success" type="button" @onclick="SelectAllVisibleAsync">
                        <i class="bi bi-check-all me-1"></i>
                        Select All Visible
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="ClearAllMunicipalities"
                            disabled="@(!_selectedMunicipalities.Any())">
                        <i class="bi bi-x-circle me-1"></i>
                        Clear All
                    </button>
                </div>

            </div>

            @* ── Info text ────────────────────────────────────────────────── *@
            <p class="text-muted small mb-3">
                <i class="bi bi-info-circle me-1"></i>
                Check the municipalities this PDO is responsible for.
                They will only be able to create and edit records within these areas.
            </p>

            @* ── No results ───────────────────────────────────────────────── *@
            @if (!FilteredJurisdictionProvinces.Any())
            {
                <div class="alert alert-info py-2">
                    <i class="bi bi-search me-2"></i>
                    No provinces or municipalities match
                    <strong>"@_jurSearchTerm"</strong>.
                </div>
            }

            @* ── Province + municipality grid ─────────────────────────────── *@
            @foreach (var provinceGroup in FilteredJurisdictionProvinces)
            {
                var allMusInProvince = _availableProvinces[provinceGroup.Key];
                var visibleMunis = provinceGroup.Value;
                var selectedInProvince = visibleMunis
                    .Count(m => _selectedMunicipalities.Contains(m.Code));

                <div class="jur-province-card">

                    @* Province header *@
                    <div class="jur-province-header">
                        <input type="checkbox" class="form-check-input" id="prov-@provinceGroup.Key"
                               checked="@IsProvinceAllChecked(allMusInProvince)" @onchange="e => ToggleProvince(
                                                                                                                                                                                                               allMusInProvince,
                                                                                                                                                                                                               (bool)e.Value!)" />
<label class="jur-province-label" for="prov-@provinceGroup.Key">
                            <i class="bi bi-map me-1 text-primary"></i>
                            @provinceGroup.Key
                        </label>
                        <span class="badge bg-secondary ms-auto">
                            @selectedInProvince / @visibleMunis.Count
                            @if (!string.IsNullOrWhiteSpace(_jurSearchTerm)
                                 && visibleMunis.Count < allMusInProvince.Count)
                            {
                                <span class="ms-1 opacity-75">
                                    (filtered)
                                </span>
                            }
                        </span>
                    </div>

                    @* Municipality checkboxes *@
                    <div class="jur-muni-grid">
                        @foreach (var muni in visibleMunis.OrderBy(m => m.Name))
                        {
                            var isChecked = _selectedMunicipalities.Contains(muni.Code);
                            <div class="jur-muni-item @(isChecked ? "jur-muni-item--checked" : "")">
                                <input type="checkbox" class="form-check-input" id="muni-@muni.Code" checked="@isChecked"
                                       @onchange="() => ToggleMunicipality(muni.Code)" />
                                <label class="form-check-label" for="muni-@muni.Code">
                                    @HighlightMatch(muni.Name, _jurSearchTerm)
                                </label>
                            </div>
                        }
                    </div>

                </div>
            }
        }
    </BodyTemplate>
    <FooterTemplate>
        <div class="d-flex justify-content-between align-items-center w-100">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary">
                    @_selectedMunicipalities.Count municipality(ies) selected
                </span>
            </div>
            <div class="d-flex gap-2">
                <HxButton Color="ThemeColor.Secondary" @onclick="() => _jurisdictionModal.HideAsync()">
                    Cancel
                </HxButton>
                <HxButton Color="ThemeColor.Primary" @onclick="SaveJurisdictionsAsync" Disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <span>Save Jurisdictions</span>
                </HxButton>
            </div>
        </div>
    </FooterTemplate>
</HxModal>

