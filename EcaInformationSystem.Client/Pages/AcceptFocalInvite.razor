@page "/focal-invite/{Code}"
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs.Auth
@inject FocalInviteClientService FocalInviteClient
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Accept Invite</PageTitle>

<div class="focal-accept-page">
    <div class="focal-accept-card">
        @if (_loadingPreview)
        {
            <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
        }
        else if (_preview is null || !_preview.IsValid)
        {
            <div class="text-center py-3">
                <i class="bi bi-exclamation-circle text-danger" style="font-size:32px;"></i>
                <p class="mt-2">@(_preview?.ErrorMessage ?? "This invite link is invalid.")</p>
            </div>
        }
        else
        {
            <h5 class="mb-1">You've been invited</h5>
            <p class="text-muted small mb-3">Complete your account to be reachable by voice call in the system.</p>

            <div class="mb-2">
                <label class="form-label small fw-bold">Name</label>
                <input class="form-control" value="@_preview.FullName" disabled />
            </div>
            <div class="mb-2">
                <label class="form-label small fw-bold">Province(s)</label>
                <input class="form-control" value="@string.Join(", ", _preview.ProvinceNames)" disabled />
            </div>
            <div class="mb-2">
                <label class="form-label small fw-bold">Email address (this is your username)</label>
                <input type="email" class="form-control" @bind="_userName" @bind:event="oninput"
                       maxlength="100" placeholder="you@example.com" />
                <div class="form-text">
                    Used to sign in and lets your PDO/admin identify your account at a glance — only a real email is accepted.
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small fw-bold">Choose a password</label>
                <input type="password" class="form-control" @bind="_password" @bind:event="oninput" />
            </div>
            <div class="mb-2">
                <label class="form-label small fw-bold">Confirm password</label>
                <input type="password" class="form-control" @bind="_confirmPassword" @bind:event="oninput" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="text-danger small mb-2">@_error</div>
            }

            <button class="btn btn-primary w-100 mt-2" @onclick="SubmitAsync" disabled="@_isSubmitting">
                @(_isSubmitting ? "Creating account..." : "Activate account")
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;

    private bool _loadingPreview = true;
    private FocalInvitePreviewDto? _preview;

    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private bool _isSubmitting;

    // Simple shape check — the server re-validates with System.Net.Mail.MailAddress
    // as the authoritative guard; this is just fast client-side feedback.
    private static readonly System.Text.RegularExpressions.Regex EmailRegex =
        new(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", System.Text.RegularExpressions.RegexOptions.Compiled);

    protected override async Task OnInitializedAsync()
    {
        _preview = await FocalInviteClient.PreviewInviteAsync(Code);
        _loadingPreview = false;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        var email = _userName.Trim();

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Email and password are required.";
            return;
        }
        if (!EmailRegex.IsMatch(email))
        {
            _error = "Enter a valid email address — it's used as your username.";
            return;
        }
        if (_password != _confirmPassword)
        {
            _error = "Password and confirmation do not match.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var (success, token, fullName, userName, error) = await FocalInviteClient.AcceptInviteAsync(new AcceptFocalInviteRequest
            {
                Code = Code,
                UserName = email,
                Password = _password,
                ConfirmPassword = _confirmPassword
            });

            if (!success || string.IsNullOrWhiteSpace(token))
            {
                _error = error ?? "Failed to activate account.";
                return;
            }

            await AuthService.PersistExternalSessionAsync(token, fullName ?? _preview!.FullName, userName ?? _userName);
            Navigation.NavigateTo("/focal-home", true);
        }
        finally { _isSubmitting = false; }
    }
}
