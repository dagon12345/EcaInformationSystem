@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<div class="sidebar-brand">
       <NavLink href="" Match="NavLinkMatch.All">
             <div class="brand-icon">
                 <img src="/images/ncsc-seal.png" alt="NCSC"
                      style="width:32px;height:32px;border-radius:50%;object-fit:cover;  background: white"
                      onerror="this.style.display='none'"  />
             </div>
    </NavLink>
    <span class="brand-text">ECAReS</span>
</div>

<nav class="sidebar-nav">
    <div class="nav-section-label">Main</div>

    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
        <span class="nav-icon"><i class="bi bi-grid"></i></span>
        <span class="nav-label">Dashboard</span>
    </NavLink>

    <NavLink class="nav-item" href="beneficiary-create">
        <span class="nav-icon"><i class="bi bi-person-plus"></i></span>
        <span class="nav-label">Create Record</span>
    </NavLink>

    <NavLink class="nav-item" href="beneficiary-records">
        <span class="nav-icon"><i class="bi bi-file-text"></i></span>
        <span class="nav-label">Records</span>
    </NavLink>

    <NavLink class="nav-item" href="schedule">
        <span class="nav-icon"><i class="bi bi-calendar3"></i></span>
        <span class="nav-label">Schedule</span>
    </NavLink>

    <div class="nav-section-label mt-2">System</div>

    <NavLink class="nav-item" href="settings">
        <span class="nav-icon"><i class="bi bi-gear"></i></span>
        <span class="nav-label">Settings</span>
    </NavLink>
</nav>

<div class="sidebar-footer">
    <div class="user-card">
        <div class="avatar">@GetInitials(UserName)</div>
        <div class="user-info">
            <div class="user-name">@UserName</div>
            <div class="user-role">Welcome</div>
        </div>
    </div>
    <button class="toggle-btn" @onclick="OnToggle">
        <i class="bi @(Collapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
        <span>@(Collapsed ? "Expand" : "Collapse")</span>
    </button>
</div>

@code {
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public string UserName { get; set; } = "User";

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";

        var parts = name.Trim().Split(' ',
            StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();

        // First letter of first and last word
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}