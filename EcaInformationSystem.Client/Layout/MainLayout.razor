@using EcaInformationSystem.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@attribute [Authorize]
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="app-shell">
    <div class="sidebar @(collapsed ? "collapsed" : "")">
        <NavMenu OnToggle="ToggleSidebar" Collapsed="collapsed" UserName="@userName" />
    </div>
    <div class="main-area">
        <div class="top-navbar">
            <div class="breadcrumb-area">
                <span>ECA</span>
                <span class="separator">›</span>
                <span class="current">@currentPage</span>
            </div>
            <div class="navbar-actions">
                <AuthorizeView>
                    <Authorized>
                        <span style="font-size:12px;color:#6b7280;margin-right:8px;">
                            @context.User.Identity?.Name
                        </span>
                    </Authorized>
                </AuthorizeView>
                <button class="icon-btn" @onclick="HandleLogout" title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </div>
        </div>
        <article class="content-area">
            @Body
        </article>
    </div>
</div>


@code {
    private bool collapsed = false;
    private string userName = string.Empty;
    private string currentPage = "Dashboard";

    // Map URL segments to display names
    private static readonly Dictionary<string, string> PageNames = new()
    {
        { "",           "Dashboard" },
        { "dashboard",  "Dashboard" },
        { "beneficiary-create",   "Create Record" },
        { "beneficiary-records",    "Records" },
        { "schedule",   "Schedule" },
        { "settings",   "Settings" },
        { "help",       "Help" },
    };

    protected override void OnInitialized()
    {
        // Listen for navigation changes
        Navigation.LocationChanged += OnLocationChanged;
        UpdateCurrentPage(Navigation.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.Identity.Name ?? "User";
            StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPage(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPage(string uri)
    {
        // Extract the last segment of the URL
        var path = new Uri(uri).AbsolutePath.Trim('/').ToLower();

        // Handle nested routes like "students/create" → "Students"
        var segment = path.Split('/')[0];

        currentPage = PageNames.TryGetValue(segment, out var name)
            ? name
            : ToTitleCase(segment);
    }

    // Fallback for pages not in the dictionary
    private static string ToTitleCase(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "Dashboard";
        return char.ToUpper(text[0]) + text[1..].ToLower();
    }

    private void ToggleSidebar() => collapsed = !collapsed;

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        ((JwtAuthStateProvider)AuthStateProvider).NotifyAuthChanged();
        await Task.Delay(100);
        Navigation.NavigateTo("/login", true);
    }

    // Always unsubscribe to avoid memory leaks
    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}