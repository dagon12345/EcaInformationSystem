@using EcaInformationSystem.Client.Pages
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.DTOs.DocumentTracking
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject BeneficiaryStateService State
@inject IConfiguration Configuration
@inject ChatClientService ChatClientService
@inject DocumentTrackingClientService DocumentTrackingClientService
@inject SystemUpdateClientService SystemUpdateClientService
@inject BiometricStatusClientService BiometricStatusClientService
@inject TransactionTierClientService TierClient
@inject ToastService Toast
@inject IJSRuntime JS
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <SessionExpiryWarning />
        <div class="app-shell">
            <div class="sidebar-backdrop @(mobileOpen ? "show" : "")" @onclick="CloseMobileSidebar"></div>

            <div class="sidebar @(collapsed ? "collapsed" : "") @(mobileOpen ? "mobile-open" : "")">
                <NavMenu OnToggle="ToggleSidebar" Collapsed="collapsed" UserName="@userName" />
            </div>
            <div class="main-area">
                <div class="top-navbar">
                    <button class="mobile-menu-btn" @onclick="ToggleMobileSidebar" title="Menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="breadcrumb-area">
                        <span>ECA</span>
                        <span class="separator">›</span>
                        <span class="current">@currentPage</span>
                    </div>
                    <div class="navbar-actions">

                        @* ── Sticky Notes — floating toggle + panel, same click-to-open
                             behavior as Messages below. The Feed page (PostFeed.razor) keeps
                             its own always-visible sidebar copy; this is a second entry point
                             so the user can glimpse/manage their notes from anywhere. ── *@
                        <StickyNotesWidget />

                        @* ── Messages — floating toggle + panel (ChatWidget's non-inline mode),
                             same click-to-open behavior as the bell. Was previously an always-
                             visible sidebar on the Feed page; now it's reachable from anywhere. ── *@
                        <ChatWidget />

                        @* ── Single notification bell — duplicates, calendar, uploads ── *@
                        <UnifiedNotificationBell @ref="_notificationBell" />

                        @* ── User info + role badge — click opens a dropdown with
                             View Profile / Logout (logout no longer sits as its
                             own bare icon in the navbar). ────────────────────── *@
                        <div class="dropdown navbar-profile-dropdown me-2">
                            <button class="btn navbar-profile-toggle dropdown-toggle position-relative" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                @if (_mfaEnabled == false)
                                {
                                    <span class="navbar-profile-mfa-dot" title="Add two-factor authentication to secure your account"></span>
                                }
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex flex-column align-items-end" style="line-height:1.2; min-width:100px;">
                                        <span style="font-size:12px; color:#6b7280; font-weight:500;">
                                            @_displayFullName
                                        </span>
                                        @if (_myTier is not null)
                                        {
                                            <div class="navbar-profile-tier-progress @TierVisuals.For(_myTier.TierLevel).CssClass"
                                                 title="@TierProgressTitle()">
                                                <div class="navbar-profile-tier-progress-track">
                                                    <div class="navbar-profile-tier-progress-fill" style="width:@(_myTier.ProgressPercent.ToString("0.#"))%;"></div>
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_userRole))
                                        {
                                            <span class="badge @GetRoleBadgeClass(_userRole)"
                                                  style="font-size:9px; padding:2px 6px; margin-top:2px;">
                                                <i class="bi @GetRoleIcon(_userRole) me-1"></i>@GetRoleLabel(_userRole)
                                            </span>
                                        }
                                    </div>
                                    <div class="position-relative">
                                        @if (_currentUserId.HasValue)
                                        {
                                            <img src="@AvatarUrl(_currentUserId.Value)" alt="" class="navbar-profile-avatar avatar-img"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                            <div class="navbar-profile-avatar" style="display:none;">@GetInitials(_displayFullName)</div>
                                        }
                                        else
                                        {
                                            <div class="navbar-profile-avatar">@GetInitials(_displayFullName)</div>
                                        }
                                        @if (_myTier is not null)
                                        {
                                            <span class="tier-badge-dot @TierVisuals.For(_myTier.TierLevel).CssClass"
                                                  title="@($"{_myTier.TierName} tier — {_myTier.TransactionCount} transaction(s)")">
                                                <i class="bi @TierVisuals.For(_myTier.TierLevel).Icon"></i>
                                            </span>
                                        }
                                    </div>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/profile">
                                        @if (_currentUserId.HasValue)
                                        {
                                            <img src="@AvatarUrl(_currentUserId.Value)" alt="" class="navbar-profile-menu-avatar avatar-img me-2"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                            <div class="navbar-profile-menu-avatar me-2" style="display:none;">@GetInitials(_displayFullName)</div>
                                        }
                                        else
                                        {
                                            <div class="navbar-profile-menu-avatar me-2">@GetInitials(_displayFullName)</div>
                                        }
                                        View Profile
                                        @if (_mfaEnabled == false)
                                        {
                                            <span class="badge bg-danger ms-2" style="font-size:9px;">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Secure account
                                            </span>
                                        }
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/dar">
                                        <i class="bi bi-journal-check me-2"></i>Daily Accomplishment Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/my-dtr">
                                        <i class="bi bi-clock-history me-2"></i>My DTR
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger" @onclick="RequestLogout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                @* ── Permission denied banner ──────────────────────────────────────── *@
                @if (_showPermissionBanner)
                {
                    <div class="permission-banner permission-banner--@_bannerType" role="alert">
                        <div class="permission-banner__icon">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div class="permission-banner__body">
                            <strong>Access Restricted</strong>
                            <span>@_permissionMessage</span>
                        </div>
                        <button class="permission-banner__close" @onclick="DismissBanner" title="Dismiss">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }

                <article class="content-area">
                    @Body
                </article>
            </div>
        </div>

        @* ── Logout confirmation — reached via the profile dropdown above ── *@
        @if (_showLogoutConfirm)
        {
            <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.6); z-index:1080;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title text-warning-emphasis">
                                <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Log Out?
                            </h5>
                            <button type="button" class="btn-close" @onclick="CancelLogout"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">
                                You're about to end your current session. Any unsaved changes on this page
                                will be lost. Are you sure you want to log out?
                            </p>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CancelLogout">Cancel</button>
                            <button class="btn btn-danger" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right me-1"></i>Yes, Log Out
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool collapsed = false;
    private bool mobileOpen = false;
    private string userName = string.Empty;
    private string _displayFullName = "User";
    private string currentPage = "Dashboard";
    private string? _userRole;
    private bool _showPermissionBanner = false;
    private string _permissionMessage = string.Empty;
    private string _bannerType = "error";
    private System.Threading.CancellationTokenSource? _bannerCts;
    private UnifiedNotificationBell? _notificationBell;
    private bool _showLogoutConfirm;
    private bool? _mfaEnabled; // null = not checked yet
    private Guid? _currentUserId;
    private UserTransactionTierDto? _myTier;

    public static MainLayout? Current { get; private set; }

    private void ToggleMobileSidebar() => mobileOpen = !mobileOpen;
    private void CloseMobileSidebar() => mobileOpen = false;

    private static readonly Dictionary<string, string> PageNames = new()
    {
        { "", "Feed and Messages"    },
        { "dashboard", "Feed and Messages"    },
        { "calendar", "Calendar" }, // ← new
        { "statistics", "Statistics"  },
        { "beneficiary-create", "Create Record"},
        { "beneficiary-records", "Records"      },
        { "forms-gateway", "Files" },
        { "liquidation", "Liquidation"  },
        { "logs", "Activity Logs"   },
        { "user-management", "User Management"},
        { "chat-oversight", "Conversation Oversight" }
    };

    protected override void OnInitialized()
    {
        Current = this;
        Navigation.LocationChanged += OnLocationChanged;
        UpdateCurrentPage(Navigation.Uri);

        DocumentTrackingClientService.OnDocumentTagged += HandleDocumentTagged;
    }

    private void HandleDocumentTagged(DocumentTaggedNotificationDto notification)
    {
        Toast.ShowSuccess(
            $"{notification.TaggedByName} tagged you on a document — {notification.MunicipalityName}, {notification.ProvinceName} (Milestone {notification.MilestoneYear}).",
            "Document Tracking");
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitAsync();
        _userRole = AuthService.GetRole();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.Identity.Name ?? "User";
            var fullName = user.FindFirst("FullName")?.Value;
            _displayFullName = !string.IsNullOrWhiteSpace(fullName) ? fullName : userName;
            _currentUserId = Guid.TryParse(user.FindFirst("sub")?.Value, out var id) ? id : (Guid?)null;

            if (!ChatClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "chatHub").ToString();
                    await ChatClientService.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — widget can show disconnected state
                }
            }

            if (!DocumentTrackingClientService.IsConnected && _currentUserId.HasValue)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "documentTrackingHub").ToString();
                    await DocumentTrackingClientService.ConnectAsync(hubUrl, _currentUserId.Value);
                }
                catch
                {
                    // Non-fatal — badge just won't live-update this session
                }
            }

            if (!SystemUpdateClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "systemUpdateHub").ToString();
                    await SystemUpdateClientService.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — the update banner just won't show live this session
                }
            }

            if (!BiometricStatusClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "biometricStatusHub").ToString();
                    await BiometricStatusClientService.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — Attendance Management/My DTR fall back to their own REST fetch
                }
            }

            // ✅ Moved inside the authenticated check — anonymous visitors have
            // no notification permissions to request and no chat audio to prime.
            await JS.InvokeVoidAsync("chatInterop.primeNotificationAudio");
            await JS.InvokeVoidAsync("chatInterop.notifications.requestPermission");

            await LoadMfaStatusAsync();
            _myTier = await TierClient.GetMyTierAsync();
        }

        StateHasChanged();
    }

    public async Task ShowPermissionDeniedAsync(string? customMessage = null)
    {
        var role = _userRole ?? AuthService.GetRole() ?? "your role";
        var label = GetRoleLabel(role);

        _permissionMessage = customMessage ?? GetDefaultDeniedMessage(role, label);
        _bannerType = role == "Viewer" ? "error" : "warning";
        _showPermissionBanner = true;

        StateHasChanged();

        _bannerCts?.Cancel();
        _bannerCts = new System.Threading.CancellationTokenSource();
        var token = _bannerCts.Token;

        try
        {
            await Task.Delay(5000, token);
            if (!token.IsCancellationRequested)
                DismissBanner();
        }
        catch (TaskCanceledException) { }
    }

    private void DismissBanner()
    {
        _showPermissionBanner = false;
        StateHasChanged();
    }

    private static string GetDefaultDeniedMessage(string role, string label) => role switch
    {
        "Viewer" =>
            $"You have view-only access ({label}). " +
            "Contact an administrator to request additional permissions.",
        "PDO" =>
            $"This action is restricted to Administrators. " +
            $"Your account ({label}) does not have permission to perform this operation.",
        _ => "You do not have permission to perform this action."
    };

    private static string GetRoleBadgeClass(string role) => role switch
    {
        "SuperAdmin" => "bg-dark",
        "Admin" => "bg-danger",
        "PDO" => "bg-primary",
        "Viewer" => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string GetRoleIcon(string role) => role switch
    {
        "SuperAdmin" => "bi-shield-fill-exclamation",
        "Admin" => "bi-shield-fill-check",
        "PDO" => "bi-person-badge-fill",
        "Viewer" => "bi-eye-fill",
        _ => "bi-person-fill"
    };

    private static string GetRoleLabel(string role) => role switch
    {
        "SuperAdmin" => "Super Administrator",
        "Admin" => "Administrator",
        "PDO" => "Project Development Officer",
        "Viewer" => "Viewer",
        _ => role
    };

    private string TierProgressTitle()
    {
        if (_myTier is null) return string.Empty;

        return _myTier.NextTierMinCount.HasValue
            ? $"{_myTier.TierName} tier — {_myTier.TransactionCount:N0} transaction(s). " +
              $"{_myTier.NextTierMinCount.Value - _myTier.TransactionCount:N0} more to reach {_myTier.NextTierName}."
            : $"{_myTier.TierName} tier — {_myTier.TransactionCount:N0} transaction(s). Max tier reached!";
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPage(e.Location);
        DismissBanner();
        mobileOpen = false;
        _notificationBell?.CloseDropdown();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPage(string uri)
    {
        var path = new Uri(uri).AbsolutePath.Trim('/').ToLower();
        var segment = path.Split('/')[0];

        currentPage = PageNames.TryGetValue(segment, out var name)
            ? name
            : ToTitleCase(segment);
    }

    private static string ToTitleCase(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "Dashboard";
        return char.ToUpper(text[0]) + text[1..].ToLower();
    }

    private void ToggleSidebar() => collapsed = !collapsed;

    private void RequestLogout() => _showLogoutConfirm = true;
    private void CancelLogout() => _showLogoutConfirm = false;

    private async Task HandleLogout()
    {
        Current = null;
        State.ResetGlobalDuplicateState();
        await AuthService.LogoutAsync();
        ((JwtAuthStateProvider)AuthStateProvider).NotifyAuthChanged();
        await Task.Delay(100);
        Navigation.NavigateTo("/login", true);
    }

    // Surfaced as a red dot on the profile entry instead of a separate Feed
    // banner — one place, one action: open the profile and set it up there.
    private async Task LoadMfaStatusAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<MfaStatusResponse>("api/auth/mfa/status");
            _mfaEnabled = status?.IsMfaEnabled ?? true;
        }
        catch
        {
            _mfaEnabled = true; // fail closed — don't nag if the check itself failed
        }
    }

    private class MfaStatusResponse
    {
        public bool IsMfaEnabled { get; set; }
    }

    // Absolute URL — see Profile.razor's AvatarUrl for why a relative <img src>
    // 404s (API is on a different origin than the client).
    private string AvatarUrl(Guid userId) => $"{Http.BaseAddress}api/UserProfile/{userId}/avatar/thumb";

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    public void Dispose()
    {
        Current = null;
        _bannerCts?.Cancel();
        Navigation.LocationChanged -= OnLocationChanged;
        DocumentTrackingClientService.OnDocumentTagged -= HandleDocumentTagged;
    }
}