@using EcaInformationSystem.Client.Pages
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.DTOs.ApplicationTracking
@using EcaInformationSystem.Shared.DTOs.DocumentTracking
@using EcaInformationSystem.Shared.DTOs.Chat
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject IConfiguration Configuration
@inject ChatClientService ChatClientService
@inject VoiceCallClientService VoiceCallClientService
@inject VoiceCallStateService VoiceCallState
@inject ApplicationTrackingClientService ApplicationTrackingClientService
@inject DocumentTrackingClientService DocumentTrackingClientService
@inject LivenessNotificationClientService LivenessNotificationClientService
@inject DtrPunchRequestClientService DtrPunchRequestClientService
@inject SystemUpdateClientService SystemUpdateClientService
@inject BiometricStatusClientService BiometricStatusClientService
@inject TransactionTierClientService TierClient
@inject TransactionTierHubClientService TierHub
@inject ToastService Toast
@inject IJSRuntime JS
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <SessionExpiryWarning />
        <div class="app-shell">
            <div class="sidebar-backdrop @(mobileOpen ? "show" : "")" @onclick="CloseMobileSidebar"></div>

            <div class="sidebar @(collapsed ? "collapsed" : "") @(mobileOpen ? "mobile-open" : "")">
                <NavMenu OnToggle="ToggleSidebar" Collapsed="collapsed" />
            </div>
            <div class="main-area">
                @* ── Live leaderboard ticker — visible at every width, including
                     mobile/collapsed, sits above the navbar so the top-of-week
                     ranking never fully disappears from view no matter what page
                     you're on. Not shown to Focal accounts (they aren't ranked). ── *@
                @if (_userRole != "Focal")
                {
                    <LiveLeaderboardTicker />
                }
                <div class="top-navbar">
                    <button class="mobile-menu-btn" @onclick="ToggleMobileSidebar" title="Menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="breadcrumb-area">
                        <span>ECA</span>
                        <span class="separator">›</span>
                        <span class="current">@currentPage</span>
                    </div>
                    <div class="navbar-actions main-navbar-actions">

                        @* ── Feed — quick link back to the Feed/home page from anywhere. ── *@
                        <div class="navbar-action-labeled">
                            <a href="/" class="icon-btn navbar-feed-btn" title="Feed">
                                <i class="bi bi-house-door-fill"></i>
                            </a>
                            <span class="navbar-action-label">Feed</span>
                        </div>

                        @* ── Sticky Notes — floating toggle + panel, same click-to-open
                             behavior as Messages below. The Feed page (PostFeed.razor) keeps
                             its own always-visible sidebar copy; this is a second entry point
                             so the user can glimpse/manage their notes from anywhere. ── *@
                        <div class="navbar-action-labeled">
                            <StickyNotesWidget />
                            <span class="navbar-action-label">Sticky Notes</span>
                        </div>

                        @* ── Messages — floating toggle + panel (ChatWidget's non-inline mode),
                             same click-to-open behavior as the bell. Was previously an always-
                             visible sidebar on the Feed page; now it's reachable from anywhere. ── *@
                        <div class="navbar-action-labeled">
                            <ChatWidget />
                            <span class="navbar-action-label">Messaging</span>
                        </div>

                        @* ── Browser-to-browser voice calls between logged-in users —
                             renders incoming-call/dialing/in-call overlays globally so a
                             call can be answered from any page. ── *@
                        <VoiceCallWidget />

                        @* ── Single notification bell — duplicates, calendar, uploads ── *@
                        <div class="navbar-action-labeled">
                            <UnifiedNotificationBell @ref="_notificationBell" />
                            <span class="navbar-action-label">Notifications</span>
                        </div>

                        @* ── Transaction Leaderboard — icon that drops down into the same
                             season header / my-tier progress / rank list card that used to
                             sit permanently on the Feed page's sidebar; reachable from
                             anywhere now instead of only there. Not shown to Focal accounts
                             (they aren't ranked). ── *@
                        @if (_userRole != "Focal")
                        {
                            <div class="navbar-action-labeled">
                                <div class="dropdown navbar-leaderboard-dropdown">
                                    <button class="icon-btn navbar-leaderboard-toggle" type="button"
                                            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Transaction Leaderboard">
                                        <i class="bi bi-trophy-fill"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end navbar-leaderboard-menu">
                                        <TransactionLeaderboardWidget />
                                    </div>
                                </div>
                                <span class="navbar-action-label">Leaderboard</span>
                            </div>
                        }

                    </div>
                </div>

                @* ── Permission denied banner ──────────────────────────────────────── *@
                @if (_showPermissionBanner)
                {
                    <div class="permission-banner permission-banner--@_bannerType" role="alert">
                        <div class="permission-banner__icon">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div class="permission-banner__body">
                            <strong>Access Restricted</strong>
                            <span>@_permissionMessage</span>
                        </div>
                        <button class="permission-banner__close" @onclick="DismissBanner" title="Dismiss">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }

                <article class="content-area">
                    @Body
                </article>
            </div>
        </div>

        @* ── Tier level-up celebration — fires globally (any page) the instant
             your own activity pushes you into a new tier, not just on the Feed
             page's leaderboard card. Auto-dismisses itself. ── *@
        @if (_levelUpTier is not null)
        {
            var v = TierVisuals.For(_levelUpTier.TierLevel);
            <div class="tier-levelup-overlay" @onclick="() => _levelUpTier = null">
                <div class="tier-levelup-card @v.CssClass">
                    <span class="tier-levelup-confetti tier-levelup-confetti--1">🎉</span>
                    <span class="tier-levelup-confetti tier-levelup-confetti--2">✨</span>
                    <span class="tier-levelup-confetti tier-levelup-confetti--3">🎊</span>
                    <span class="tier-levelup-confetti tier-levelup-confetti--4">⭐</span>
                    <div class="tier-levelup-icon"><i class="bi @v.Icon"></i></div>
                    <div class="tier-levelup-label">Tier Up!</div>
                    <div class="tier-levelup-name">@_levelUpTier.TierName</div>
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool collapsed = false;
    private bool mobileOpen = false;
    private string userName = string.Empty;
    private string currentPage = "Dashboard";
    private string? _userRole;
    private bool _showPermissionBanner = false;
    private string _permissionMessage = string.Empty;
    private string _bannerType = "error";
    private System.Threading.CancellationTokenSource? _bannerCts;
    private UnifiedNotificationBell? _notificationBell;
    // Guards HandleForceLogout (a "log out other devices" push, or a
    // same-account logout elsewhere) against double-firing — see the comment
    // in AuthService.LogoutAsync for why that race could happen.
    private bool _loggingOut;
    private Guid? _currentUserId;
    private UserTransactionTierDto? _myTier;
    private UserTransactionTierDto? _levelUpTier;
    private System.Threading.CancellationTokenSource? _levelUpCts;

    public static MainLayout? Current { get; private set; }

    private void ToggleMobileSidebar() => mobileOpen = !mobileOpen;
    private void CloseMobileSidebar() => mobileOpen = false;

    private static readonly Dictionary<string, string> PageNames = new()
    {
        { "", "Feed and Messages"    },
        { "dashboard", "Feed and Messages"    },
        { "calendar", "Calendar" }, // ← new
        { "statistics", "Statistics"  },
        { "beneficiary-create", "Create Record"},
        { "beneficiary-records", "Records"      },
        { "forms-gateway", "Files" },
        { "liquidation", "Liquidation"  },
        { "logs", "Activity Logs"   },
        { "user-management", "User Management"},
        { "chat-oversight", "Conversation Oversight" }
    };

    protected override void OnInitialized()
    {
        Current = this;
        Navigation.LocationChanged += OnLocationChanged;
        UpdateCurrentPage(Navigation.Uri);

        ApplicationTrackingClientService.OnApplicationTagged += HandleApplicationTagged;
        DocumentTrackingClientService.OnDocumentTagged += HandleDocumentTagged;
        LivenessNotificationClientService.OnLivenessSubmitted += HandleLivenessSubmitted;
        ChatClientService.OnForceLogout += HandleForceLogout;
        ChatClientService.OnMessageReacted += HandleMessageReacted;
        TierHub.TransactionRecorded += HandleTransactionRecordedForLevelUp;
    }

    // Someone reacted to one of MY messages — fires from anywhere in the app,
    // not just while that chat room happens to be open, since the reaction
    // pill on the message itself only helps if you're already looking at it.
    private void HandleMessageReacted(ChatReactionNotificationDto notification)
    {
        var emoji = notification.ReactionType switch
        {
            "Like" => "👍",
            "Heart" => "❤️",
            "Haha" => "😂",
            "Clap" => "👏",
            "Wow" => "😮",
            _ => "👍"
        };

        var message = string.IsNullOrWhiteSpace(notification.MessagePreview)
            ? $"{notification.ReactorName} reacted {emoji} to your message."
            : $"{notification.ReactorName} reacted {emoji} to \"{notification.MessagePreview}\"";

        Toast.ShowSuccess(message, "Chat");
        InvokeAsync(StateHasChanged);
    }

    // Fires globally (any page, not just Feed) the instant OUR OWN activity
    // pushes us into a new tier — the push only carries a raw userName, so
    // this only reacts when it matches this account's own login username;
    // everyone else's activity is the leaderboard/ticker's job, not this.
    private void HandleTransactionRecordedForLevelUp(string updatedUserName)
    {
        if (!string.Equals(updatedUserName, userName, StringComparison.OrdinalIgnoreCase))
            return;

        _ = InvokeAsync(async () =>
        {
            var previousLevel = _myTier?.TierLevel ?? 0;
            _myTier = await TierClient.GetMyTierAsync(forceRefresh: true);

            if (_myTier is not null && _myTier.TierLevel > previousLevel && previousLevel > 0)
            {
                _levelUpTier = _myTier;
                StateHasChanged();

                _levelUpCts?.Cancel();
                _levelUpCts = new System.Threading.CancellationTokenSource();
                var token = _levelUpCts.Token;
                try
                {
                    await Task.Delay(4200, token);
                    if (!token.IsCancellationRequested)
                    {
                        _levelUpTier = null;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (TaskCanceledException) { }
            }
            else
            {
                StateHasChanged();
            }
        });
    }

    // Another of this account's own devices logged out (which cascades a
    // logout to every other device) or used "log out all other devices" —
    // this one needs to log itself out immediately too, not just next time
    // it happens to make a request.
    private async void HandleForceLogout()
    {
        if (_loggingOut) return;
        _loggingOut = true;

        try
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/features", true);
        }
        catch
        {
            // Best-effort — we're logging out either way; a failed cleanup
            // step here shouldn't block leaving the page.
            Navigation.NavigateTo("/features", true);
        }
    }

    private void HandleApplicationTagged(ApplicationTaggedNotificationDto notification)
    {
        Toast.ShowSuccess(
            $"{notification.TaggedByName} tagged you on a document — {notification.MunicipalityName}, {notification.ProvinceName} (Milestone {notification.MilestoneYear}).",
            "Application Tracking");
        InvokeAsync(StateHasChanged);
    }

    private void HandleDocumentTagged(DocumentTaggedNotificationDto notification)
    {
        Toast.ShowSuccess(
            $"{notification.TaggedByName} tagged you on a document — {notification.Title} ({notification.SerialNumber}).",
            "Document Tracking");
        InvokeAsync(StateHasChanged);
    }

    private void HandleLivenessSubmitted(LivenessSubmittedNotificationDto notification)
    {
        Toast.ShowSuccess(
            $"{notification.FullName} just submitted their liveness photo" +
            (string.IsNullOrWhiteSpace(notification.MunicipalityName) ? "." : $" ({notification.MunicipalityName}).") +
            " Review it when ready.",
            "Liveness Check");
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitAsync();
        _userRole = AuthService.GetRole();

        // Focal accounts never see the real staff shell (NavMenu's nav
        // sections, permission legend, DAR/DTR links, etc.). Server-side
        // AuthPolicies already blocks them from every controller that shell
        // links to; this redirect just keeps the UI itself honest by sending
        // them to their own FocalLayout pages instead. Every Focal-accessible
        // route is named with a "focal-" prefix (focal-home, focal-call-logs,
        // focal-beneficiaries, ...) so new ones don't need a matching edit here.
        var currentPath = new Uri(Navigation.Uri).AbsolutePath.Trim('/');
        if (_userRole == "Focal" && !currentPath.StartsWith("focal-", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/focal-home", true);
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.Identity.Name ?? "User";
            _currentUserId = Guid.TryParse(user.FindFirst("sub")?.Value, out var id) ? id : (Guid?)null;

            if (!ChatClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "chatHub").ToString();
                    await ChatClientService.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — widget can show disconnected state
                }
            }

            if (!VoiceCallClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "voiceCallHub").ToString();
                    await VoiceCallClientService.ConnectAsync(hubUrl);
                    VoiceCallState.Initialize();
                }
                catch
                {
                    // Non-fatal — voice calling just won't be available this session
                }
            }

            if (!ApplicationTrackingClientService.IsConnected && _currentUserId.HasValue)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "applicationTrackingHub").ToString();
                    await ApplicationTrackingClientService.ConnectAsync(hubUrl, _currentUserId.Value);
                }
                catch
                {
                    // Non-fatal — badge just won't live-update this session
                }
            }

            if (!DocumentTrackingClientService.IsConnected && _currentUserId.HasValue)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "documentTrackingHub").ToString();
                    await DocumentTrackingClientService.ConnectAsync(hubUrl, _currentUserId.Value);
                }
                catch
                {
                    // Non-fatal — "tagged you" toasts/badge just won't live-update this session
                }
            }

            if (!LivenessNotificationClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "livenessNotificationHub").ToString();
                    await LivenessNotificationClientService.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — "liveness submitted" toasts/badge just won't live-update this session
                }
            }

            if (!DtrPunchRequestClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "dtrPunchRequestHub").ToString();
                    await DtrPunchRequestClientService.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — DTR punch-request toasts/badge just won't live-update this session
                }
            }

            if (!SystemUpdateClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "systemUpdateHub").ToString();
                    await SystemUpdateClientService.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — the update banner just won't show live this session
                }
            }

            if (!TierHub.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "transactionTierHub").ToString();
                    await TierHub.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — level-up celebration and the top ticker just won't live-update this session
                }
            }

            if (!BiometricStatusClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "biometricStatusHub").ToString();
                    await BiometricStatusClientService.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — Attendance Management/My DTR fall back to their own REST fetch
                }
            }

            // ✅ Moved inside the authenticated check — anonymous visitors have
            // no notification permissions to request and no chat audio to prime.
            await JS.InvokeVoidAsync("chatInterop.primeNotificationAudio");
            await JS.InvokeVoidAsync("chatInterop.notifications.requestPermission");

            _myTier = await TierClient.GetMyTierAsync();
        }

        StateHasChanged();
    }

    public async Task ShowPermissionDeniedAsync(string? customMessage = null)
    {
        var role = _userRole ?? AuthService.GetRole() ?? "your role";
        var label = GetRoleLabel(role);

        _permissionMessage = customMessage ?? GetDefaultDeniedMessage(role, label);
        _bannerType = role == "Viewer" ? "error" : "warning";
        _showPermissionBanner = true;

        StateHasChanged();

        _bannerCts?.Cancel();
        _bannerCts = new System.Threading.CancellationTokenSource();
        var token = _bannerCts.Token;

        try
        {
            await Task.Delay(5000, token);
            if (!token.IsCancellationRequested)
                DismissBanner();
        }
        catch (TaskCanceledException) { }
    }

    private void DismissBanner()
    {
        _showPermissionBanner = false;
        StateHasChanged();
    }

    private static string GetDefaultDeniedMessage(string role, string label) => role switch
    {
        "Viewer" =>
            $"You have view-only access ({label}). " +
            "Contact an administrator to request additional permissions.",
        "PDO" =>
            $"This action is restricted to Administrators. " +
            $"Your account ({label}) does not have permission to perform this operation.",
        "Encoder" =>
            $"Your account ({label}) can only Create, Edit, and View grantee records. " +
            "Contact an administrator for anything beyond that.",
        _ => "You do not have permission to perform this action."
    };

    private static string GetRoleLabel(string role) => role switch
    {
        "SuperAdmin" => "Super Administrator",
        "Admin" => "Administrator",
        "PDO" => "Project Development Officer",
        "Viewer" => "Viewer",
        "Encoder" => "Encoder",
        "Focal" => "Provincial Focal",
        _ => role
    };

    private string TierProgressTitle()
    {
        if (_myTier is null) return string.Empty;

        return _myTier.NextTierMinCount.HasValue
            ? $"{_myTier.TierName} tier — {_myTier.TransactionCount:N0} transaction(s). " +
              $"{_myTier.NextTierMinCount.Value - _myTier.TransactionCount:N0} more to reach {_myTier.NextTierName}."
            : $"{_myTier.TierName} tier — {_myTier.TransactionCount:N0} transaction(s). Max tier reached!";
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPage(e.Location);
        DismissBanner();
        mobileOpen = false;
        _notificationBell?.CloseDropdown();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPage(string uri)
    {
        var path = new Uri(uri).AbsolutePath.Trim('/').ToLower();
        var segment = path.Split('/')[0];

        currentPage = PageNames.TryGetValue(segment, out var name)
            ? name
            : ToTitleCase(segment);
    }

    private static string ToTitleCase(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "Dashboard";
        return char.ToUpper(text[0]) + text[1..].ToLower();
    }

    private void ToggleSidebar() => collapsed = !collapsed;

    public void Dispose()
    {
        Current = null;
        _bannerCts?.Cancel();
        Navigation.LocationChanged -= OnLocationChanged;
        ApplicationTrackingClientService.OnApplicationTagged -= HandleApplicationTagged;
        DocumentTrackingClientService.OnDocumentTagged -= HandleDocumentTagged;
        LivenessNotificationClientService.OnLivenessSubmitted -= HandleLivenessSubmitted;
        ChatClientService.OnForceLogout -= HandleForceLogout;
        ChatClientService.OnMessageReacted -= HandleMessageReacted;
        TierHub.TransactionRecorded -= HandleTransactionRecordedForLevelUp;
        _levelUpCts?.Cancel();
    }
}