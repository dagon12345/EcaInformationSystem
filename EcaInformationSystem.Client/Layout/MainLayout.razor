@using EcaInformationSystem.Client.Pages
@using EcaInformationSystem.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@attribute [Authorize]
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject BeneficiaryStateService State
@inject IConfiguration Configuration
@inject ChatClientService ChatClientService
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <div class="sidebar-backdrop @(mobileOpen ? "show" : "")" @onclick="CloseMobileSidebar"></div>

    <div class="sidebar @(collapsed ? "collapsed" : "") @(mobileOpen ? "mobile-open" : "")">
        <NavMenu OnToggle="ToggleSidebar" Collapsed="collapsed" UserName="@userName" />
    </div>
    <div class="main-area">
        <div class="top-navbar">
            <button class="mobile-menu-btn" @onclick="ToggleMobileSidebar" title="Menu">
                <i class="bi bi-list"></i>
            </button>
            <div class="breadcrumb-area">
                <span>ECA</span>
                <span class="separator">›</span>
                <span class="current">@currentPage</span>
            </div>
            <div class="navbar-actions">

                @* ── Duplicate notification bell ─────────────────────────── *@
                <DuplicateNotificationBell @ref="_duplicateBell" />
                <UploadQueueIndicator />

                <AuthorizeView>
                    <Authorized>
                        @* ── User info + role badge ────────────────────────── *@
                        <div class="d-flex align-items-center gap-2 me-2">
                            <div class="d-flex flex-column align-items-end" style="line-height:1.2;">
                                <span style="font-size:12px; color:#6b7280; font-weight:500;">
                                    @context.User.Identity?.Name
                                </span>
                                @if (!string.IsNullOrWhiteSpace(_userRole))
                                {
                                    <span class="badge @GetRoleBadgeClass(_userRole)"
                                          style="font-size:9px; padding:2px 6px; margin-top:2px;">
                                        <i class="bi @GetRoleIcon(_userRole) me-1"></i>@GetRoleLabel(_userRole)
                                    </span>
                                }
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <button class="icon-btn" @onclick="HandleLogout" title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </div>
        </div>

        @* ── Permission denied banner ──────────────────────────────────────── *@
        @if (_showPermissionBanner)
        {
            <div class="permission-banner permission-banner--@_bannerType" role="alert">
                <div class="permission-banner__icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div class="permission-banner__body">
                    <strong>Access Restricted</strong>
                    <span>@_permissionMessage</span>
                </div>
                <button class="permission-banner__close" @onclick="DismissBanner" title="Dismiss">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        }

        <article class="content-area">
            @Body
        </article>
    </div>
</div>
<ChatWidget />
@code {
    private bool collapsed = false;
    private bool mobileOpen = false;   // ✅ new — controls mobile off-canvas drawer
    private string userName = string.Empty;
    private string currentPage = "Dashboard";
    private string? _userRole;
    // ── Permission banner state ───────────────────────────────────────────────`
    private bool _showPermissionBanner = false;
    private string _permissionMessage = string.Empty;
    private string _bannerType = "error"; // "error" | "warning"
    private System.Threading.CancellationTokenSource? _bannerCts;
    private DuplicateNotificationBell? _duplicateBell;

    // ── Expose so child components can trigger the banner ─────────────────────
    public static MainLayout? Current { get; private set; }

    private void ToggleMobileSidebar() => mobileOpen = !mobileOpen;

    private void CloseMobileSidebar() => mobileOpen = false;

    private static readonly Dictionary<string, string> PageNames = new()
    {
        { "", "Dashboard"    },
        { "dashboard", "Dashboard"    },
        { "statistics", "Statistics"  },  // ✅ ADD THIS
        { "beneficiary-create", "Create Record"},
        { "beneficiary-records", "Records"      },
        { "liquidation", "Liquidation"  },
        { "logs", "Activity Logs"   },
        { "user-management", "User Management"},
    };

    protected override void OnInitialized()
    {
        Current = this;
        Navigation.LocationChanged += OnLocationChanged;
        UpdateCurrentPage(Navigation.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitAsync();
        _userRole = AuthService.GetRole();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.Identity.Name ?? "User";

            if (!ChatClientService.IsConnected)
            {
                try
                {
                    var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                    var hubUrl = new Uri(new Uri(apiBase), "chatHub").ToString();
                    await ChatClientService.ConnectAsync(hubUrl);
                }
                catch
                {
                    // Non-fatal — widget can show disconnected state
                }
            }
        }
        // ✅ NEW — prime audio playback as soon as the app shell is up. Any
        // click the user makes anywhere in the app (navigating, clicking a
        // button, etc.) will now silently unlock notification sounds.
        await JS.InvokeVoidAsync("chatInterop.primeNotificationAudio");

        StateHasChanged();
    }

    // ── Call this from any component when a restricted button is clicked ──────
    public async Task ShowPermissionDeniedAsync(string? customMessage = null)
    {
        var role = _userRole ?? AuthService.GetRole() ?? "your role";
        var label = GetRoleLabel(role);

        _permissionMessage = customMessage
            ?? GetDefaultDeniedMessage(role, label);

        _bannerType = role == "Viewer" ? "error" : "warning";
        _showPermissionBanner = true;

        StateHasChanged();

        _bannerCts?.Cancel();
        _bannerCts = new System.Threading.CancellationTokenSource();
        var token = _bannerCts.Token;

        try
        {
            await Task.Delay(5000, token);
            if (!token.IsCancellationRequested)
                DismissBanner();
        }
        catch (TaskCanceledException) { /* dismissed early — ignore */ }
    }

    private void DismissBanner()
    {
        _showPermissionBanner = false;
        StateHasChanged();
    }

    private static string GetDefaultDeniedMessage(string role, string label) => role switch
    {
        "Viewer" =>
            $"You have view-only access ({label}). " +
            "Contact an administrator to request additional permissions.",

        "PDO" =>
            $"This action is restricted to Administrators. " +
            $"Your account ({label}) does not have permission to perform this operation.",

        _ =>
            "You do not have permission to perform this action."
    };

    private static string GetRoleBadgeClass(string role) => role switch
    {
        "SuperAdmin" => "bg-dark",
        "Admin" => "bg-danger",
        "PDO" => "bg-primary",
        "Viewer" => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string GetRoleIcon(string role) => role switch
    {
        "SuperAdmin" => "bi-shield-fill-exclamation",
        "Admin" => "bi-shield-fill-check",
        "PDO" => "bi-person-badge-fill",
        "Viewer" => "bi-eye-fill",
        _ => "bi-person-fill"
    };

    private static string GetRoleLabel(string role) => role switch
    {
        "SuperAdmin" => "Super Administrator",
        "Admin" => "Administrator",
        "PDO" => "Project Development Officer",
        "Viewer" => "Viewer",
        _ => role
    };

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPage(e.Location);
        DismissBanner();
        mobileOpen = false;   // ✅ new — close drawer after navigating
        _duplicateBell?.CloseDropdown(); //Replaces the old _showDuplicateDropdown = false
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPage(string uri)
    {
        var path = new Uri(uri).AbsolutePath.Trim('/').ToLower();
        var segment = path.Split('/')[0];

        currentPage = PageNames.TryGetValue(segment, out var name)
            ? name
            : ToTitleCase(segment);
    }

    private static string ToTitleCase(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "Dashboard";
        return char.ToUpper(text[0]) + text[1..].ToLower();
    }

    private void ToggleSidebar() => collapsed = !collapsed;

    private async Task HandleLogout()
    {
        Current = null;
        State.ResetGlobalDuplicateState(); // ✅ ADDED
        await AuthService.LogoutAsync();
        ((JwtAuthStateProvider)AuthStateProvider).NotifyAuthChanged();
        await Task.Delay(100);
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        Current = null;
        _bannerCts?.Cancel();
        Navigation.LocationChanged -= OnLocationChanged;
    }
}