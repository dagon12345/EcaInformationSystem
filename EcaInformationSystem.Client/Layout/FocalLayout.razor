@* Separate, minimal shell for "call-only" Focal accounts — deliberately not
   MainLayout.razor, which is the full staff shell (permission legend, tier
   progress, DAR/DTR links, every nav section). A Focal only ever needs the
   provincial directory and the ability to log out. *@
@using EcaInformationSystem.Client.Pages
@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs.SystemUpdate
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject VoiceCallClientService VoiceCallClientService
@inject VoiceCallStateService VoiceCallState
@inject ChatClientService ChatClientService
@inject SystemUpdateClientService SystemUpdateClient
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <SessionExpiryWarning />
        <div class="app-shell">
            <div class="sidebar-backdrop @(mobileOpen ? "show" : "")" @onclick="CloseMobileSidebar"></div>

            <div class="sidebar @(collapsed ? "collapsed" : "") @(mobileOpen ? "mobile-open" : "")">
                <FocalNavMenu OnToggle="ToggleSidebar" Collapsed="collapsed" UserName="@_displayFullName" />
            </div>
            <div class="main-area">
                <div class="top-navbar">
                    <button class="mobile-menu-btn" @onclick="ToggleMobileSidebar" title="Menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="breadcrumb-area">
                        <span>ECA</span>
                        <span class="separator">›</span>
                        <span class="current">Provincial Directory</span>
                    </div>
                    <div class="navbar-actions">
                        <ChatWidget />
                        <VoiceCallWidget />
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="RequestLogout">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    </div>
                </div>

                <article class="content-area">
                    @Body
                </article>
            </div>
        </div>

        @if (_showLogoutConfirm)
        {
            <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.6); z-index:1080;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title text-warning-emphasis">
                                <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Log Out?
                            </h5>
                            <button type="button" class="btn-close" @onclick="CancelLogout"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">You're about to end your current session. Are you sure you want to log out?</p>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CancelLogout">Cancel</button>
                            <button class="btn btn-danger" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right me-1"></i>Yes, Log Out
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ── System update prompt — Focal accounts have no notification bell,
             so an update raised by a SuperAdmin is surfaced as its own modal
             instead of a dropdown tab, with a one-click hard refresh
             (equivalent to Ctrl+Shift+R) since a plain reload won't pick up
             new cached Blazor WASM assemblies. Only appears when there's
             actually an unseen update. ── *@
        @if (_updateNotice is not null)
        {
            <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.6); z-index:1090;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="bi bi-arrow-repeat me-2 text-primary"></i>@_updateNotice.Title</h5>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted small mb-2">
                                The system was updated to <strong>v@(_updateNotice.Version)</strong>. Refresh now to load the latest version.
                            </p>
                            @foreach (var line in _updateNotice.Changes.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <div class="small">• @line</div>
                            }
                            <div class="text-muted mt-2" style="font-size:11px;">
                                <i class="bi bi-clock me-1"></i>@_updateNotice.PublishedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm") · @_updateNotice.PublishedByName
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" @onclick="DismissUpdateNotice" disabled="@_isRefreshing">Later</button>
                            <button class="btn btn-primary" @onclick="RefreshNowAsync" disabled="@_isRefreshing">
                                @if (_isRefreshing)
                                {
                                    <span>Refreshing...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-arrow-clockwise me-1"></i>Refresh Now</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool collapsed = false;
    private bool mobileOpen = false;
    private string _displayFullName = "Focal";
    private bool _showLogoutConfirm;
    private SystemUpdateNoticeDto? _updateNotice;
    private bool _isRefreshing;

    private void ToggleMobileSidebar() => mobileOpen = !mobileOpen;
    private void CloseMobileSidebar() => mobileOpen = false;
    private void ToggleSidebar() => collapsed = !collapsed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitAsync();

        // Defense in depth — a staff member navigating straight to this route
        // shouldn't see the stripped-down Focal shell either. The real
        // enforcement is server-side (AuthPolicies excludes Focal from
        // everything else); this just keeps the UI honest.
        if (AuthService.GetRole() is string role && role != "Focal")
        {
            Navigation.NavigateTo("/", true);
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var fullName = authState.User.FindFirst("FullName")?.Value;
        _displayFullName = !string.IsNullOrWhiteSpace(fullName) ? fullName : "Focal";

        if (!VoiceCallClientService.IsConnected)
        {
            try
            {
                var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                var hubUrl = new Uri(new Uri(apiBase), "voiceCallHub").ToString();
                await VoiceCallClientService.ConnectAsync(hubUrl);
                VoiceCallState.Initialize();
            }
            catch
            {
                // Non-fatal — voice calling just won't be available this session
            }
        }

        // MainLayout never renders for a Focal session (they're redirected
        // straight here), so this is the only place their chat connection
        // ever gets established — without it, <ChatWidget /> below would
        // render with no live connection behind it.
        if (!ChatClientService.IsConnected)
        {
            try
            {
                var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                var hubUrl = new Uri(new Uri(apiBase), "chatHub").ToString();
                await ChatClientService.ConnectAsync(hubUrl);
            }
            catch
            {
                // Non-fatal — the chat widget can show disconnected state
            }
        }

        // Same reasoning as chat/voice above — MainLayout never renders for a
        // Focal session, so nothing else establishes this connection or
        // surfaces a raised update for them.
        SystemUpdateClient.OnUnseenUpdate += OnUnseenSystemUpdate;
        if (!SystemUpdateClient.IsConnected)
        {
            try
            {
                var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                var hubUrl = new Uri(new Uri(apiBase), "systemUpdateHub").ToString();
                await SystemUpdateClient.ConnectAsync(hubUrl);
            }
            catch
            {
                // Non-fatal — the update prompt just won't show live this session
            }
        }

        StateHasChanged();
    }

    private void OnUnseenSystemUpdate(SystemUpdateNoticeDto notice)
    {
        _updateNotice = notice;
        InvokeAsync(StateHasChanged);
    }

    private void DismissUpdateNotice() => _updateNotice = null;

    private async Task RefreshNowAsync()
    {
        if (_isRefreshing || _updateNotice is null) return;
        _isRefreshing = true;
        StateHasChanged();

        await SystemUpdateClient.AcknowledgeAsync(_updateNotice.Version);
        await Task.Delay(350);
        // hardReload (not a plain location.reload) — forces every framework
        // file to be re-fetched bypassing the disk cache, same as Ctrl+Shift+R.
        await JS.InvokeVoidAsync("hardReload");
    }

    private void RequestLogout() => _showLogoutConfirm = true;
    private void CancelLogout() => _showLogoutConfirm = false;

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        ((JwtAuthStateProvider)AuthStateProvider).NotifyAuthChanged();
        await Task.Delay(100);
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        SystemUpdateClient.OnUnseenUpdate -= OnUnseenSystemUpdate;
    }
}
