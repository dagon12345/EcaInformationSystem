<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>
		<PublishIISAssets>true</PublishIISAssets>
		<WasmFingerprintAssets>true</WasmFingerprintAssets>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<!-- ✅ Release-only: trimming, fingerprinting, and compression only matter for the
       published artifact — none of this should run on a local F5/Ctrl+Shift+B. -->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>

	<!-- ✅ Debug-only: everything here is explicitly OFF so there's no ambiguity and
       no per-build recomputation of things that don't matter until you publish. -->
	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
		<CompressionEnabled>false</CompressionEnabled>

		<!-- ✅ NEW — skips recomputing content-hash filenames for every static asset
		 (JS/CSS/images) on every single build. Only matters for production cache-busting. -->
		<WasmFingerprintAssets>false</WasmFingerprintAssets>

		<!-- ✅ NEW — skips Roslyn analyzer execution (including ones shipped by
		 Havit.Blazor and other referenced packages) during local Debug builds.
		 Analyzers still run in the editor for live squiggles; this only
		 disables the redundant build-time re-run. -->
		<RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Havit.Blazor.Components.Web.Bootstrap" Version="4.24.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Connections.Client" Version="10.0.9" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EcaInformationSystem.Shared\EcaInformationSystem.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\audio\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Pages\BeneficiaryInformation\BeneficiaryInformationChildComponents\BeneficiaryDocumentUpload.razor.cs">
			<DependentUpon>BeneficiaryDocumentUpload.razor</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>