@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.DTOs.Activity
@using EcaInformationSystem.Shared.DTOs.SystemUpdate
@using EcaInformationSystem.Common.Enums
@using EcaInformationSystem.Client.Services
@using System.Net.Http.Json
@inject BeneficiaryStateService State
@inject ActivityClientService ActivityClient
@inject DocumentUploadQueueService UploadQueue
@inject ApplicationTrackingClientService AppTracking
@inject DocumentTrackingClientService DocTracking
@inject SystemUpdateClientService SystemUpdateClient
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject AuthService AuthService
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

@* ── Invisible full-screen catcher — sits behind the dropdown (z-index just
     under its 1400) and in front of everything else, so a click ANYWHERE
     outside the bell/dropdown closes it. The bell's own wrapper below stops
     propagation, so clicks inside never reach this. ── *@
@if (_showDropdown)
{
    <div class="notif-bell-backdrop" @onclick="CloseDropdown"></div>
}

@* ── Single bell — replaces the old separate Duplicate / Calendar / Upload icons.
     One trigger, one dropdown, tabs inside instead of three icons in the navbar. ── *@
<div class="position-relative me-2" @onclick:stopPropagation="true">
    <button class="icon-btn position-relative" @onclick="ToggleDropdown" title="Notifications">
        <i class="bi bi-bell"></i>
        @if (TotalBadgeCount > 0)
        {
            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle"
                  style="font-size:9px;">
                @TotalBadgeCount
            </span>
        }
        @if (State.TotalPendingScans > 0)
        {
            <span class="badge rounded-pill bg-warning position-absolute top-0 start-100 translate-middle"
                  style="font-size:9px; margin-left: 10px;">
                <span class="spinner-border spinner-border-sm" style="width:8px;height:8px;"></span>
            </span>
        }
    </button>

    @if (_showDropdown)
    {
        <div class="duplicate-dropdown notif-bell-dropdown" @onclick:stopPropagation="true">
            <div class="notif-bell-tabs">
                <button class="notif-bell-tab @(_activeTab == NotifTab.Duplicates ? "notif-bell-tab--active" : "")"
                        title="Duplicates" @onclick="() => _activeTab = NotifTab.Duplicates">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>Duplicates</span>
                    @if (DuplicatesBadge > 0) { <span class="notif-bell-tab-badge">@DuplicatesBadge</span> }
                </button>
                <button class="notif-bell-tab @(_activeTab == NotifTab.Calendar ? "notif-bell-tab--active" : "")"
                        title="Calendar" @onclick="() => _activeTab = NotifTab.Calendar">
                    <i class="bi bi-calendar-event"></i>
                    <span>Calendar</span>
                    @if (_todayActivities.Count > 0) { <span class="notif-bell-tab-badge">@_todayActivities.Count</span> }
                </button>
                <button class="notif-bell-tab @(_activeTab == NotifTab.Uploads ? "notif-bell-tab--active" : "")"
                        title="Uploads" @onclick="() => _activeTab = NotifTab.Uploads">
                    <i class="bi bi-cloud-upload"></i>
                    <span>Uploads</span>
                    @if (_uploadActiveCount > 0) { <span class="notif-bell-tab-badge">@_uploadActiveCount</span> }
                </button>
                <button class="notif-bell-tab @(_activeTab == NotifTab.Documents ? "notif-bell-tab--active" : "")"
                        title="Documents" @onclick="() => _activeTab = NotifTab.Documents">
                    <i class="bi bi-truck"></i>
                    <span>Documents</span>
                    @if (AppTracking.PendingForMeCount > 0) { <span class="notif-bell-tab-badge">@AppTracking.PendingForMeCount</span> }
                </button>
                <button class="notif-bell-tab @(_activeTab == NotifTab.TrackedDocuments ? "notif-bell-tab--active" : "")"
                        title="Document Tracking" @onclick="() => _activeTab = NotifTab.TrackedDocuments">
                    <i class="bi bi-send"></i>
                    <span>Tracking</span>
                    @if (DocTracking.PendingForMeCount > 0) { <span class="notif-bell-tab-badge">@DocTracking.PendingForMeCount</span> }
                </button>
                <button class="notif-bell-tab @(_activeTab == NotifTab.Updates ? "notif-bell-tab--active" : "")"
                        title="Updates" @onclick="() => _activeTab = NotifTab.Updates">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Updates</span>
                    @if (_hasUnseenUpdate) { <span class="notif-bell-tab-badge">1</span> }
                </button>
            </div>

            @if (_activeTab == NotifTab.Duplicates)
            {
                <div class="duplicate-dropdown-header">
                    <span class="fw-bold">Duplicate Scans</span>
                    @if (State.DuplicateScanNotifications.Any())
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="ConfirmClearAll" @onclick:stopPropagation="true"
                                title="Clear all notifications">
                            <i class="bi bi-trash3"></i>
                        </button>
                    }
                </div>

                <div class="duplicate-dropdown-scroll">
                    @if (!State.DuplicateScanNotifications.Any())
                    {
                        <div class="duplicate-dropdown-item duplicate-dropdown-empty">
                            <i class="bi bi-info-circle me-2"></i>
                            No duplicate scans yet
                        </div>
                    }
                    else
                    {
                        @foreach (var notification in State.DuplicateScanNotifications)
                        {
                            var unresolvedCount = UnresolvedCount(notification);

                            <div class="duplicate-dropdown-item @(notification.IsLoading ? "duplicate-dropdown-loading" :
                                                                    notification.HasError ? "duplicate-dropdown-error" :
                                                                    unresolvedCount > 0 ? "duplicate-dropdown-has-matches" :
                                                                    notification.TotalPairs > 0 ? "duplicate-dropdown-all-resolved" : "")">

                                <div class="d-flex justify-content-between align-items-start w-100">
                                    <div class="flex-grow-1" @onclick:stopPropagation="true">
                                        @if (notification.IsLoading)
                                        {
                                            <div>
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                <span class="text-muted">Scanning...</span>
                                            </div>
                                        }
                                        else if (notification.HasError)
                                        {
                                            <div>
                                                <i class="bi bi-exclamation-circle text-danger me-1"></i>
                                                <span class="text-danger">Error: @notification.ErrorMessage</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="cursor:pointer;" @onclick="() => OpenReviewModal(notification)">
                                                @if (notification.TotalPairs > 0)
                                                {
                                                    <span>
                                                        @if (unresolvedCount > 0)
                                                        {
                                                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                                                            <strong>@unresolvedCount</strong> @($"possible duplicate {MatchWord(unresolvedCount)}")
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-check-circle-fill text-success me-1"></i>
                                                            <span class="text-success">@($"All {notification.TotalPairs} {MatchWord(notification.TotalPairs)} resolved")</span>
                                                        }
                                                        @if (unresolvedCount != notification.TotalPairs)
                                                        {
                                                            <span class="text-muted small ms-1">(@notification.TotalPairs total)</span>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle text-success me-1"></i>
                                                    <span class="text-success">No duplicates</span>
                                                }
                                            </div>
                                        }

                                        <div class="duplicate-dropdown-filter">
                                            @notification.FilterDescription
                                        </div>

                                        <div class="duplicate-dropdown-time">
                                            <i class="bi bi-clock me-1"></i>
                                            @notification.ScannedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center flex-shrink-0">
                                        @if (!notification.IsLoading && !notification.HasError && notification.TotalPairs > 0)
                                        {
                                            <button class="duplicate-dropdown-expand-btn" @onclick="() => OpenReviewModal(notification)"
                                                    @onclick:stopPropagation="true" title="Review matches">
                                                <i class="bi bi-arrows-fullscreen"></i>
                                            </button>
                                        }
                                        @if (!notification.IsLoading)
                                        {
                                            <button class="duplicate-dropdown-delete-btn" @onclick="() => DeleteNotification(notification.Id)"
                                                    @onclick:stopPropagation="true" title="Remove notification">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="duplicate-dropdown-footer">
                    @if (State.DuplicateScanNotifications.Count >= 50)
                    {
                        <button class="duplicate-scan-btn-small" @onclick="ClearOld">
                            <i class="bi bi-archive me-1"></i>
                            Clear Old (keep 50)
                        </button>
                    }
                </div>
            }
            else if (_activeTab == NotifTab.Calendar)
            {
                <div class="duplicate-dropdown-header">
                    <span class="fw-bold">Today's Schedule</span>
                    <span class="text-muted" style="font-size:11px;">@DateTime.Today.ToString("MMM dd, yyyy")</span>
                </div>

                <div class="duplicate-dropdown-scroll">
                    @if (_loadingActivities)
                    {
                        <div class="duplicate-dropdown-item text-center">
                            <span class="spinner-border spinner-border-sm"></span>
                        </div>
                    }
                    else if (!_todayActivities.Any())
                    {
                        <div class="duplicate-dropdown-item duplicate-dropdown-empty">
                            <i class="bi bi-check-circle me-2"></i>
                            No activities scheduled today
                        </div>
                    }
                    else
                    {
                        @foreach (var a in _todayActivities)
                        {
                            <div class="duplicate-dropdown-item duplicate-dropdown-has-matches" style="cursor:pointer;"
                                 @onclick="GoToCalendar">
                                <div class="d-flex align-items-start gap-2">
                                    <span class="calendar-dot @PriorityCss(a.Priority)" style="margin-top:4px;"></span>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold" style="font-size:13px;">@a.Title</div>
                                        <div class="duplicate-dropdown-filter">
                                            @(a.IsAllDay ? "All day" : a.StartDate.ToString("h:mm tt"))
                                            @(!string.IsNullOrWhiteSpace(a.Location) ? $" • {a.Location}" : "")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="duplicate-dropdown-footer">
                    <button class="duplicate-scan-btn-small" @onclick="GoToCalendar">
                        <i class="bi bi-calendar3 me-1"></i>
                        View full calendar
                    </button>
                </div>
            }
            else if (_activeTab == NotifTab.Uploads)
            {
                <div class="duplicate-dropdown-header">
                    <span class="fw-bold">Upload Queue</span>
                    <span class="text-muted small">@_uploadJobs.Count job(s)</span>
                </div>

                <div class="duplicate-dropdown-scroll">
                    @if (!_uploadJobs.Any())
                    {
                        <div class="duplicate-dropdown-item duplicate-dropdown-empty">
                            <i class="bi bi-check-circle me-2"></i>
                            No pending uploads
                        </div>
                    }
                    else
                    {
                        @foreach (var job in _uploadJobs)
                        {
                            <div class="duplicate-dropdown-item @GetUploadItemClass(job.Status)">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2">
                                        @GetUploadStatusIcon(job.Status)
                                        <span class="small fw-semibold text-truncate"
                                              style="max-width:180px;" title="@job.FileName">
                                            @job.FileName
                                        </span>
                                    </div>
                                    <div class="duplicate-dropdown-filter mt-1">
                                        @GetUploadStatusText(job)
                                    </div>
                                </div>
                                @if (job.Status is UploadJobStatus.Done or UploadJobStatus.Failed)
                                {
                                    <button class="duplicate-dropdown-delete-btn"
                                            @onclick="() => DismissUploadAsync(job.JobId)"
                                            title="Dismiss">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>
            }
            else if (_activeTab == NotifTab.Documents)
            {
                <div class="duplicate-dropdown-header">
                    <span class="fw-bold">Application Tracking</span>
                    <span class="text-muted small">@AppTracking.PendingForMeCount waiting on you</span>
                </div>

                <div class="duplicate-dropdown-scroll">
                    @if (AppTracking.PendingForMeCount == 0)
                    {
                        <div class="duplicate-dropdown-item duplicate-dropdown-empty">
                            <i class="bi bi-check-circle me-2"></i>
                            Nothing tagged to you right now
                        </div>
                    }
                    else
                    {
                        <div class="duplicate-dropdown-item" style="cursor:pointer;" @onclick="GoToApplicationTracking">
                            <i class="bi bi-truck me-2 text-primary"></i>
                            <span>
                                You have <strong>@AppTracking.PendingForMeCount</strong>
                                application@(AppTracking.PendingForMeCount == 1 ? "" : "s") to accept
                            </span>
                        </div>
                    }
                </div>

                <div class="duplicate-dropdown-footer">
                    <button class="duplicate-scan-btn-small" @onclick="GoToApplicationTracking">
                        <i class="bi bi-arrow-right me-1"></i>
                        Open Application Tracking
                    </button>
                </div>
            }
            else if (_activeTab == NotifTab.TrackedDocuments)
            {
                <div class="duplicate-dropdown-header">
                    <span class="fw-bold">Document Tracking</span>
                    <span class="text-muted small">@DocTracking.PendingForMeCount waiting on you</span>
                </div>

                <div class="duplicate-dropdown-scroll">
                    @if (DocTracking.PendingForMeCount == 0)
                    {
                        <div class="duplicate-dropdown-item duplicate-dropdown-empty">
                            <i class="bi bi-check-circle me-2"></i>
                            Nothing tagged to you right now
                        </div>
                    }
                    else
                    {
                        <div class="duplicate-dropdown-item" style="cursor:pointer;" @onclick="GoToDocumentTracking">
                            <i class="bi bi-send me-2 text-primary"></i>
                            <span>
                                You have <strong>@DocTracking.PendingForMeCount</strong>
                                document@(DocTracking.PendingForMeCount == 1 ? "" : "s") to accept
                            </span>
                        </div>
                    }
                </div>

                <div class="duplicate-dropdown-footer">
                    <button class="duplicate-scan-btn-small" @onclick="GoToDocumentTracking">
                        <i class="bi bi-arrow-right me-1"></i>
                        Open Document Tracking
                    </button>
                </div>
            }
            else if (_activeTab == NotifTab.Updates)
            {
                <div class="duplicate-dropdown-header">
                    <span class="fw-bold">System Updates</span>
                    @if (_hasUnseenUpdate)
                    {
                        <span class="badge bg-danger">New</span>
                    }
                </div>

                <div class="duplicate-dropdown-scroll">
                    @if (_loadingUpdates)
                    {
                        <div class="duplicate-dropdown-item text-center">
                            <span class="spinner-border spinner-border-sm"></span>
                        </div>
                    }
                    else if (!_updateNotices.Any())
                    {
                        <div class="duplicate-dropdown-item duplicate-dropdown-empty">
                            <i class="bi bi-info-circle me-2"></i>
                            No updates published yet
                        </div>
                    }
                    else
                    {
                        @foreach (var notice in _updateNotices)
                        {
                            var isUnseen = _hasUnseenUpdate && notice == _updateNotices.First();

                            <div class="duplicate-dropdown-item @(isUnseen ? "duplicate-dropdown-has-matches" : "")">
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start w-100">
                                        <span class="fw-semibold" style="font-size:13px;">@notice.Title</span>
                                        <span class="text-muted small ms-1">v@(notice.Version)</span>
                                    </div>
                                    @foreach (var line in notice.Changes.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <div class="duplicate-dropdown-filter">• @line</div>
                                    }
                                    <div class="duplicate-dropdown-time">
                                        <i class="bi bi-clock me-1"></i>
                                        @notice.PublishedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                        · @notice.PublishedByName
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (_hasUnseenUpdate)
                {
                    <div class="duplicate-dropdown-footer">
                        <button class="duplicate-scan-btn-small" disabled="@_refreshingFromBell" @onclick="RefreshForLatestUpdate">
                            <i class="bi bi-arrow-clockwise me-1 @(_refreshingFromBell ? "spin" : "")"></i>
                            @(_refreshingFromBell ? "Refreshing..." : "Refresh Now to Apply")
                        </button>
                    </div>
                }
            }
        </div>
    }
</div>

@* ── Large review modal — one notification's full pair list, roomy layout ── *@
@if (_reviewNotification is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show" style="display:block;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-1">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Possible Duplicate Matches
                        </h5>
                        <div class="text-muted small">@_reviewNotification.FilterDescription</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseReviewModal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6">
                            @UnresolvedCount(_reviewNotification) of @_reviewNotification.TotalPairs still need review
                        </span>
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenFullComparison(_reviewNotification)">
                            <i class="bi bi-columns-gap me-1"></i>Open Full Side-by-Side Comparison
                        </button>
                    </div>

                    @if (_reviewNotification.Result?.Pairs is { Count: > 0 } pairs)
                    {
                        <div class="duplicate-pair-grid">
                            @foreach (var pair in pairs)
                            {
                                var pairKey = PairKey(pair);
                                var isBusy = _busyPairKeys.Contains(pairKey);
                                var isRemarksOpen = _activeRemarksPairKey == pairKey;

                                <div class="duplicate-pair-card @(pair.IsResolved ? "duplicate-pair-card--resolved" : "")">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            @((pair.MatchScore * 100).ToString("F0"))% match
                                        </span>
                                        @if (pair.IsResolved)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                                                <i class="bi bi-check-circle-fill me-1"></i>Resolved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Unresolved</span>
                                        }
                                    </div>

                                    <div class="duplicate-pair-compare">
                                        <div class="duplicate-pair-record">
                                            <div class="fw-semibold">@pair.Record1FullName</div>
                                            <div class="text-muted small">@pair.Record1BirthDate</div>
                                            <div class="text-muted small">
                                                @pair.Record1Municipality
                                                @if (!string.IsNullOrWhiteSpace(pair.Record1Barangay))
                                                {
                                                    <span> — @pair.Record1Barangay</span>
                                                }
                                            </div>
                                            @if (pair.Record1PaymentStatus == 2)
                                            {
                                                <span class="badge bg-success mt-1" style="font-size:9px;">Paid</span>
                                            }
                                        </div>
                                        <div class="duplicate-pair-vs">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </div>
                                        <div class="duplicate-pair-record">
                                            <div class="fw-semibold">@pair.Record2FullName</div>
                                            <div class="text-muted small">@pair.Record2BirthDate</div>
                                            <div class="text-muted small">
                                                @pair.Record2Municipality
                                                @if (!string.IsNullOrWhiteSpace(pair.Record2Barangay))
                                                {
                                                    <span> — @pair.Record2Barangay</span>
                                                }
                                            </div>
                                            @if (pair.Record2PaymentStatus == 2)
                                            {
                                                <span class="badge bg-success mt-1" style="font-size:9px;">Paid</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="duplicate-pair-reason">
                                        <i class="bi bi-info-circle me-1"></i>@pair.MatchReason
                                    </div>

                                    @if (pair.IsResolved && !string.IsNullOrWhiteSpace(pair.Remarks))
                                    {
                                        <div class="duplicate-pair-remarks-readonly">
                                            <i class="bi bi-chat-left-text me-1"></i>@pair.Remarks
                                            @if (!string.IsNullOrWhiteSpace(pair.ResolvedBy))
                                            {
                                                <span class="text-muted"> — @pair.ResolvedBy@(pair.ResolvedAt.HasValue ? $", {pair.ResolvedAt.Value.ToLocalTime():MMM dd, HH:mm}" : "")</span>
                                            }
                                        </div>
                                    }

                                    @if (isRemarksOpen)
                                    {
                                        <div class="duplicate-pair-remarks-form">
                                            <textarea class="form-control form-control-sm" rows="2"
                                                      placeholder="Optional remarks (e.g. confirmed not a duplicate)..."
                                                      @bind="_remarksDraft" @bind:event="oninput"></textarea>
                                            <div class="d-flex justify-content-end gap-2 mt-1">
                                                <button class="btn btn-sm btn-light" @onclick="CloseRemarksBox" disabled="@isBusy">Cancel</button>
                                                <button class="btn btn-sm btn-success" @onclick="() => ResolvePairAsync(pair)" disabled="@isBusy">
                                                    @if (isBusy)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                    }
                                                    else
                                                    {
                                                        <span>Confirm Resolve</span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-end mt-2">
                                            @if (pair.IsResolved)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" disabled="@isBusy" @onclick="() => UnresolvePairAsync(pair)">
                                                    @if (isBusy)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                    }
                                                    else
                                                    {
                                                        <span><i class="bi bi-arrow-counterclockwise me-1"></i>Undo</span>
                                                    }
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success" disabled="@isBusy" @onclick="() => OpenRemarksBox(pair)">
                                                    <i class="bi bi-check-lg me-1"></i>Resolve
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mb-0">
                            <i class="bi bi-check-circle-fill me-2"></i>No possible duplicates found.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseReviewModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Clear All Confirmation Modal ── *@
@if (_showClearAllModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show" style="display:block;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Clear All Notifications</h5>
                    <button type="button" class="btn-close" @onclick="() => _showClearAllModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to clear all duplicate scan notifications?</p>
                    <p class="text-muted small">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showClearAllModal = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ClearAllNotifications">Clear All</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Full-screen "activity starting now / scheduled today" interrupt ── *@
@if (_modalActivity is not null)
{
    <div class="activity-reminder-backdrop">
        <div class="activity-reminder-modal">
            <div class="activity-reminder-icon">
                <i class="bi bi-calendar-event-fill"></i>
            </div>

            <div class="activity-reminder-eyebrow">@(_modalActivity.IsAllDay ? "Scheduled Today" : "Starting now")</div>
            <h2 class="activity-reminder-title">@_modalActivity.Title</h2>

            <div class="activity-reminder-meta">
                <div class="activity-reminder-meta-row">
                    <i class="bi bi-clock"></i>
                    <span>@(_modalActivity.IsAllDay ? "All day" : _modalActivity.StartDate.ToString("h:mm tt"))</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_modalActivity.Location))
                {
                    <div class="activity-reminder-meta-row">
                        <i class="bi bi-geo-alt"></i>
                        <span>@_modalActivity.Location</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_modalActivity.Description))
                {
                    <div class="activity-reminder-desc">@_modalActivity.Description</div>
                }
            </div>

            @if (_modalQueue.Count > 0)
            {
                <div class="activity-reminder-queue-note">
                    +@_modalQueue.Count more activity@(_modalQueue.Count == 1 ? "" : "ies") starting now
                </div>
            }

            <label class="activity-reminder-dontshow">
                <input type="checkbox" @bind="_dontShowModalAgain" />
                <span>Don't show this again</span>
            </label>

            <div class="activity-reminder-actions">
                <button class="btn btn-outline-secondary" @onclick="DismissModal">Dismiss</button>
                <button class="btn btn-primary" @onclick="GoToCalendarAndDismiss">
                    <i class="bi bi-calendar3 me-1"></i> View Calendar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private enum NotifTab { Duplicates, Calendar, Uploads, Documents, TrackedDocuments, Updates }
    private NotifTab _activeTab = NotifTab.Duplicates;
    private bool _showDropdown;

    // ── Duplicates (BeneficiaryStateService-backed) ─────────────────────────
    private bool _showClearAllModal;
    private DuplicateScanNotificationDto? _reviewNotification;
    private string? _activeRemarksPairKey;
    private string _remarksDraft = string.Empty;
    private readonly HashSet<string> _busyPairKeys = new();

    private int DuplicatesBadge => State.DuplicateScanNotifications
        .Where(n => !n.IsLoading && !n.HasError)
        .Sum(UnresolvedCount);

    // ── Calendar (ActivityClientService-backed) ─────────────────────────────
    private int? _myRegionCode;
    private bool _loadingActivities = true;
    private List<ActivityDto> _todayActivities = new();
    private ActivityDto? _modalActivity;
    private readonly Queue<ActivityDto> _modalQueue = new();

    // ── Uploads (DocumentUploadQueueService-backed) ─────────────────────────
    private List<DocumentUploadJobDto> _uploadJobs = new();
    private int _uploadActiveCount;

    // ── System Updates (SystemUpdateClientService-backed) ───────────────────
    private List<SystemUpdateNoticeDto> _updateNotices = new();
    private bool _loadingUpdates = true;
    private bool _hasUnseenUpdate;
    private bool _refreshingFromBell;

    private int TotalBadgeCount => DuplicatesBadge + _todayActivities.Count + _uploadActiveCount +
        AppTracking.PendingForMeCount + DocTracking.PendingForMeCount + (_hasUnseenUpdate ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += HandleDuplicatesChange;
        State.OnDuplicateNotificationsChanged += HandleDuplicatesChange;

        await AuthService.InitAsync();
        _myRegionCode = AuthService.GetRegionCode();

        await LoadTodayActivitiesAsync();
        await ShowAllDayRemindersOnLoad();
        await ConnectRealtimeAsync();

        ActivityClient.ActivityStarting += OnActivityStarting;
        ActivityClient.ActivityChanged += OnActivityChanged;
        ActivityClient.ActivityDeleted += OnActivityDeleted;

        UploadQueue.OnChanged += OnUploadQueueChanged;
        RefreshUploadState();

        AppTracking.OnChange += HandleAppTrackingChange;
        await AppTracking.RefreshPendingCountAsync();

        DocTracking.OnChange += HandleDocTrackingChange;
        await DocTracking.RefreshPendingCountAsync();

        SystemUpdateClient.OnUnseenUpdate += OnUnseenSystemUpdate;
        await LoadUpdateNoticesAsync();
    }

    private void HandleAppTrackingChange() => InvokeAsync(StateHasChanged);

    private void GoToApplicationTracking()
    {
        _showDropdown = false;
        Navigation.NavigateTo("/application-tracking");
    }

    private void HandleDocTrackingChange() => InvokeAsync(StateHasChanged);

    private void GoToDocumentTracking()
    {
        _showDropdown = false;
        Navigation.NavigateTo("/document-tracking");
    }

    private void HandleDuplicatesChange() => InvokeAsync(StateHasChanged);

    private void ToggleDropdown()
    {
        _showDropdown = !_showDropdown;
        if (_showDropdown)
        {
            State.ClearOldDuplicateNotifications(100);
        }
    }

    public void CloseDropdown() => _showDropdown = false;

    #region Duplicates
    private static int UnresolvedCount(DuplicateScanNotificationDto notification) =>
        notification.Result?.Pairs.Count(p => !p.IsResolved) ?? notification.TotalPairs;

    private static string PairKey(PossibleDuplicatePairDto pair) => $"{pair.Record1Id}_{pair.Record2Id}";
    private static string MatchWord(int count) => count == 1 ? "match" : "matches";

    private void OpenReviewModal(DuplicateScanNotificationDto notification)
    {
        if (notification.TotalPairs == 0) return;
        _reviewNotification = notification;
        _showDropdown = false;
        _activeRemarksPairKey = null;
    }

    private void CloseReviewModal()
    {
        _reviewNotification = null;
        _activeRemarksPairKey = null;
    }

    private void OpenFullComparison(DuplicateScanNotificationDto notification)
    {
        State.GlobalDuplicateSummary = notification.Result;
        State.RequestDuplicateModalOpen();
        CloseReviewModal();

        var currentPath = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        if (!currentPath.Equals("/beneficiary-records", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/beneficiary-records");
        }
    }

    private void OpenRemarksBox(PossibleDuplicatePairDto pair)
    {
        _activeRemarksPairKey = PairKey(pair);
        _remarksDraft = string.Empty;
    }

    private void CloseRemarksBox()
    {
        _activeRemarksPairKey = null;
        _remarksDraft = string.Empty;
    }

    private async Task ResolvePairAsync(PossibleDuplicatePairDto pair)
    {
        var key = PairKey(pair);
        _busyPairKeys.Add(key);
        StateHasChanged();

        try { await State.ResolveDuplicatePairAsync(pair, _remarksDraft); }
        finally
        {
            _busyPairKeys.Remove(key);
            _activeRemarksPairKey = null;
            _remarksDraft = string.Empty;
            StateHasChanged();
        }
    }

    private async Task UnresolvePairAsync(PossibleDuplicatePairDto pair)
    {
        var key = PairKey(pair);
        _busyPairKeys.Add(key);
        StateHasChanged();

        try { await State.UnresolveDuplicatePairAsync(pair); }
        finally
        {
            _busyPairKeys.Remove(key);
            StateHasChanged();
        }
    }

    private void DeleteNotification(Guid id) => State.ClearDuplicateNotification(id);
    private void ConfirmClearAll() => _showClearAllModal = true;

    private void ClearAllNotifications()
    {
        State.ClearAllDuplicateNotifications();
        _showClearAllModal = false;
    }

    private void ClearOld() => State.ClearOldDuplicateNotifications(50);
    #endregion

    #region Calendar
    private async Task ConnectRealtimeAsync()
    {
        if (!ActivityClient.IsConnected)
        {
            try
            {
                var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                var hubUrl = new Uri(new Uri(apiBase), "activityHub").ToString();
                await ActivityClient.ConnectAsync(hubUrl);
            }
            catch { /* non-fatal */ }
        }
    }

    private void OnActivityStarting(ActivityDto activity)
    {
        if (activity.StartDate.Date != DateTime.Today) return;

        if (_myRegionCode.HasValue && activity.PsgcCodeRegion.HasValue && activity.PsgcCodeRegion != _myRegionCode)
            return;

        InvokeAsync(async () =>
        {
            if (!_todayActivities.Any(a => a.Id == activity.Id))
                _todayActivities.Add(activity);

            if (!await IsModalDismissedAsync(activity.Id))
                EnqueueModal(activity);

            StateHasChanged();
        });
    }

    private void EnqueueModal(ActivityDto activity)
    {
        if (_modalActivity is null)
            _modalActivity = activity;
        else
            _modalQueue.Enqueue(activity);
    }

    // ✅ "Don't show this again" — persisted per activity/day in localStorage
    // (survives a full page reload, unlike the static in-memory dedup below
    // which only survives component remounts within the same WASM session).
    private bool _dontShowModalAgain;

    private static string DismissedModalKey(int activityId) =>
        $"eca-dismissed-activity-modal-{activityId}-{DateTime.Today:yyyyMMdd}";

    private async Task<bool> IsModalDismissedAsync(int activityId)
    {
        try
        {
            var value = await JS.InvokeAsync<string?>("localStorage.getItem", DismissedModalKey(activityId));
            return value == "true";
        }
        catch { return false; }
    }

    private async Task MarkModalDismissedAsync(int activityId)
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", DismissedModalKey(activityId), "true"); }
        catch { /* non-fatal — worst case it just pops again next reload */ }
    }

    private void OnActivityChanged(ActivityDto activity) =>
        InvokeAsync(async () => { await LoadTodayActivitiesAsync(); StateHasChanged(); });

    private void OnActivityDeleted(int id) =>
        InvokeAsync(async () => { await LoadTodayActivitiesAsync(); StateHasChanged(); });

    private async Task DismissModal()
    {
        if (_dontShowModalAgain && _modalActivity is not null)
            await MarkModalDismissedAsync(_modalActivity.Id);

        _dontShowModalAgain = false;
        _modalActivity = _modalQueue.Count > 0 ? _modalQueue.Dequeue() : null;
    }

    private async Task GoToCalendarAndDismiss()
    {
        if (_dontShowModalAgain && _modalActivity is not null)
            await MarkModalDismissedAsync(_modalActivity.Id);

        _dontShowModalAgain = false;
        _modalActivity = null;
        _modalQueue.Clear();
        GoToCalendar();
    }

    // ✅ static — deliberately survives this component being disposed and
    // recreated within the same page load (e.g. MainLayout's <AuthorizeView>
    // remounts its Authorized content on every auth-state change). Without
    // this memory, each remount would re-run OnInitializedAsync and pop the
    // "already seen" reminder again. Resets naturally once the date rolls over.
    private static DateTime _shownAllDayRemindersDate = DateTime.MinValue;
    private static readonly HashSet<int> _shownAllDayActivityIds = new();

    private async Task ShowAllDayRemindersOnLoad()
    {
        if (_shownAllDayRemindersDate != DateTime.Today)
        {
            _shownAllDayRemindersDate = DateTime.Today;
            _shownAllDayActivityIds.Clear();
        }

        foreach (var activity in _todayActivities.Where(a => a.IsAllDay))
        {
            if (!_shownAllDayActivityIds.Add(activity.Id)) continue;
            if (await IsModalDismissedAsync(activity.Id)) continue;

            EnqueueModal(activity);
        }
    }

    private async Task LoadTodayActivitiesAsync()
    {
        _loadingActivities = true;
        try { _todayActivities = await ActivityClient.GetDayMyRegionAsync(DateTime.Today); }
        catch { _todayActivities = new(); }
        finally { _loadingActivities = false; }
    }

    private void GoToCalendar()
    {
        _showDropdown = false;
        Navigation.NavigateTo("/calendar");
    }

    private static string PriorityCss(ActivityPriority p) => p switch
    {
        ActivityPriority.Urgent => "dot-red",
        ActivityPriority.HeadsUp => "dot-amber",
        _ => "dot-green"
    };
    #endregion

    #region Uploads
    private void OnUploadQueueChanged()
    {
        RefreshUploadState();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshUploadState()
    {
        _uploadJobs = UploadQueue.Jobs.ToList();
        _uploadActiveCount = UploadQueue.ActiveCount;
    }

    private async Task DismissUploadAsync(Guid jobId) => await UploadQueue.DismissCompletedAsync(jobId);

    private static string GetUploadItemClass(UploadJobStatus status) => status switch
    {
        UploadJobStatus.Done => "duplicate-dropdown-has-matches",
        UploadJobStatus.Failed => "duplicate-dropdown-error",
        UploadJobStatus.Uploading or UploadJobStatus.Retrying => "duplicate-dropdown-loading",
        _ => string.Empty
    };

    private static RenderFragment GetUploadStatusIcon(UploadJobStatus status) => status switch
    {
        UploadJobStatus.Done => @<i class="bi bi-check-circle-fill text-success"></i>,
        UploadJobStatus.Failed => @<i class="bi bi-x-circle-fill text-danger"></i>,
        UploadJobStatus.Uploading => @<span class="spinner-border spinner-border-sm text-primary"
                                        style="width:14px;height:14px;border-width:2px;"></span>,
        UploadJobStatus.Retrying => @<i class="bi bi-arrow-repeat text-warning"></i>,
        _ => @<i class="bi bi-clock text-muted"></i>
    };

    private static string GetUploadStatusText(DocumentUploadJobDto job) => job.Status switch
    {
        UploadJobStatus.Done => "Uploaded successfully",
        UploadJobStatus.Failed => job.ErrorMessage ?? "Permanently failed",
        UploadJobStatus.Uploading => $"Uploading... (attempt {job.AttemptCount})",
        UploadJobStatus.Retrying => job.ErrorMessage ?? "Retrying...",
        UploadJobStatus.Queued => "Waiting...",
        _ => string.Empty
    };
    #endregion

    #region System Updates
    private async Task LoadUpdateNoticesAsync()
    {
        _loadingUpdates = true;
        try
        {
            _updateNotices = await Http.GetFromJsonAsync<List<SystemUpdateNoticeDto>>("api/system-updates") ?? new();
        }
        catch
        {
            _updateNotices = new();
        }
        finally
        {
            _loadingUpdates = false;
        }

        // Also settles _hasUnseenUpdate on first load (e.g. a notice was
        // published while this user wasn't connected) — the live event below
        // only fires for broadcasts that happen while the app is open.
        await SystemUpdateClient.CheckForUnseenLatestAsync();
    }

    private void OnUnseenSystemUpdate(SystemUpdateNoticeDto notice)
    {
        _hasUnseenUpdate = true;

        if (!_updateNotices.Any(n => n.Version == notice.Version))
            _updateNotices.Insert(0, notice);

        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshForLatestUpdate()
    {
        if (_refreshingFromBell) return;
        _refreshingFromBell = true;
        StateHasChanged();

        var latest = _updateNotices.FirstOrDefault();
        if (latest != null)
            await SystemUpdateClient.AcknowledgeAsync(latest.Version);

        await Task.Delay(350);
        // hardReload (not a plain location.reload) — forces every framework
        // file to be re-fetched bypassing the disk cache, same as Ctrl+Shift+R.
        await JS.InvokeVoidAsync("hardReload");
    }
    #endregion

    public async ValueTask DisposeAsync()
    {
        State.OnChange -= HandleDuplicatesChange;
        State.OnDuplicateNotificationsChanged -= HandleDuplicatesChange;

        ActivityClient.ActivityStarting -= OnActivityStarting;
        ActivityClient.ActivityChanged -= OnActivityChanged;
        ActivityClient.ActivityDeleted -= OnActivityDeleted;

        UploadQueue.OnChanged -= OnUploadQueueChanged;

        AppTracking.OnChange -= HandleAppTrackingChange;
        DocTracking.OnChange -= HandleDocTrackingChange;

        SystemUpdateClient.OnUnseenUpdate -= OnUnseenSystemUpdate;

        await Task.CompletedTask;
    }
}
