@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.DTOs.Activity
@using EcaInformationSystem.Shared.DTOs.SystemUpdate
@using EcaInformationSystem.Shared.DTOs.ApplicationTracking
@using EcaInformationSystem.Shared.DTOs.DocumentTracking
@using EcaInformationSystem.Client.Services
@using System.Net.Http.Json
@inject BeneficiaryStateService State
@inject ActivityClientService ActivityClient
@inject ApplicationTrackingClientService AppTracking
@inject DocumentTrackingClientService DocTracking
@inject LivenessNotificationClientService LivenessNotification
@inject SystemUpdateClientService SystemUpdateClient
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject AuthService AuthService
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

@* ── Invisible full-screen catcher — sits behind the dropdown (z-index just
     under its 1400) and in front of everything else, so a click ANYWHERE
     outside the bell/dropdown closes it. The bell's own wrapper below stops
     propagation, so clicks inside never reach this. ── *@
@if (_showDropdown)
{
    <div class="notif-bell-backdrop" @onclick="CloseDropdown"></div>
}

@* ── Single bell, single merged feed — Application Tracking, Document
     Tracking, Liveness submissions, and System Updates all in one
     chronological list (newest first) instead of separate tabs. Duplicates
     and Uploads live in their own bell on the Beneficiary Records grid (see
     GridViewNotificationBell) since they're specific to actions taken
     there; Calendar's "today" count moved to a badge on the sidebar's
     Calendar link (see NavMenu) since it's a standing daily count, not a
     one-off notification. ── *@
<div class="position-relative me-2" @onclick:stopPropagation="true">
    <button class="icon-btn position-relative" @onclick="ToggleDropdown" title="Notifications">
        <i class="bi bi-bell"></i>
        @if (UnseenBadgeCount > 0)
        {
            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle"
                  style="font-size:9px;">
                @UnseenBadgeCount
            </span>
        }
    </button>

    @if (_showDropdown)
    {
        <div class="duplicate-dropdown notif-bell-dropdown" @onclick:stopPropagation="true">
            <div class="duplicate-dropdown-header">
                <span class="fw-bold">Notifications</span>
                <span class="text-muted small">@Feed.Count total</span>
            </div>

            <div class="duplicate-dropdown-scroll">
                @if (Feed.Count == 0)
                {
                    <div class="duplicate-dropdown-item duplicate-dropdown-empty">
                        <i class="bi bi-check-circle me-2"></i>
                        You're all caught up
                    </div>
                }
                else
                {
                    @foreach (var item in Feed)
                    {
                        <div class="notif-feed-item notif-feed-item--@item.AccentKey" style="cursor:@(item.OnClick is null ? "default" : "pointer");"
                             @onclick="() => HandleFeedItemClick(item)">
                            <div class="d-flex align-items-start gap-2">
                                <span class="notif-feed-icon notif-feed-icon--@item.AccentKey"><i class="bi @item.Icon"></i></span>
                                <div class="flex-grow-1" style="min-width:0;">
                                    <div class="d-flex align-items-center justify-content-between gap-2">
                                        <span class="notif-feed-category notif-feed-category--@item.AccentKey">@item.Category</span>
                                    </div>
                                    <div class="fw-semibold text-truncate" style="font-size:13px;">@item.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                    {
                                        <div class="duplicate-dropdown-filter">@item.Subtitle</div>
                                    }
                                    <div class="duplicate-dropdown-time">
                                        <i class="bi bi-clock me-1"></i>
                                        @item.Timestamp.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (_hasUnseenUpdate)
            {
                <div class="duplicate-dropdown-footer">
                    <button class="duplicate-scan-btn-small" disabled="@_refreshingFromBell" @onclick="RefreshForLatestUpdate">
                        <i class="bi bi-arrow-clockwise me-1 @(_refreshingFromBell ? "spin" : "")"></i>
                        @(_refreshingFromBell ? "Refreshing..." : "Refresh Now to Apply Update")
                    </button>
                </div>
            }
        </div>
    }
</div>

@* ── Full-screen "activity starting now / scheduled today" interrupt —
     independent of the feed above; still fires the instant a calendar
     activity starts, regardless of whether the bell dropdown is open. ── *@
@if (_modalActivity is not null)
{
    <div class="activity-reminder-backdrop">
        <div class="activity-reminder-modal">
            <div class="activity-reminder-icon">
                <i class="bi bi-calendar-event-fill"></i>
            </div>

            <div class="activity-reminder-eyebrow">@(_modalActivity.IsAllDay ? "Scheduled Today" : "Starting now")</div>
            <h2 class="activity-reminder-title">@_modalActivity.Title</h2>

            <div class="activity-reminder-meta">
                <div class="activity-reminder-meta-row">
                    <i class="bi bi-clock"></i>
                    <span>@(_modalActivity.IsAllDay ? "All day" : _modalActivity.StartDate.ToString("h:mm tt"))</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_modalActivity.Location))
                {
                    <div class="activity-reminder-meta-row">
                        <i class="bi bi-geo-alt"></i>
                        <span>@_modalActivity.Location</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_modalActivity.Description))
                {
                    <div class="activity-reminder-desc">@_modalActivity.Description</div>
                }
            </div>

            @if (_modalQueue.Count > 0)
            {
                <div class="activity-reminder-queue-note">
                    +@_modalQueue.Count more activity@(_modalQueue.Count == 1 ? "" : "ies") starting now
                </div>
            }

            <label class="activity-reminder-dontshow">
                <input type="checkbox" @bind="_dontShowModalAgain" />
                <span>Don't show this again</span>
            </label>

            <div class="activity-reminder-actions">
                <button class="btn btn-outline-secondary" @onclick="DismissModal">Dismiss</button>
                <button class="btn btn-primary" @onclick="GoToCalendarAndDismiss">
                    <i class="bi bi-calendar3 me-1"></i> View Calendar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showDropdown;

    private class FeedItem
    {
        public DateTime Timestamp { get; set; }
        public string Category { get; set; } = string.Empty;
        public string AccentKey { get; set; } = string.Empty; // maps to notif-feed-item--{key} CSS
        public string Icon { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string? Subtitle { get; set; }
        public Func<Task>? OnClick { get; set; }
    }

    private List<FeedItem> Feed => BuildFeed();

    private List<FeedItem> BuildFeed()
    {
        var items = new List<FeedItem>();

        foreach (var b in AppTracking.PendingForMeItems)
        {
            items.Add(new FeedItem
            {
                Timestamp = b.CreatedAt,
                Category = "Application Tracking",
                AccentKey = "application",
                Icon = "bi-truck",
                Title = $"{b.MunicipalityName} — MY{b.MilestoneYear}",
                Subtitle = $"{b.CurrentStatusLabel} • from {b.CreatedByName}",
                OnClick = () => { GoToApplicationTracking(); return Task.CompletedTask; }
            });
        }

        foreach (var d in DocTracking.PendingForMeItems)
        {
            items.Add(new FeedItem
            {
                Timestamp = d.CreatedAt,
                Category = "Document Tracking",
                AccentKey = "document",
                Icon = "bi-send",
                Title = $"{d.Title} ({d.SerialNumber})",
                Subtitle = $"{d.StatusLabel} • from {d.CreatedByName}",
                OnClick = () => { GoToDocumentTracking(); return Task.CompletedTask; }
            });
        }

        foreach (var l in LivenessNotification.PendingItems)
        {
            items.Add(new FeedItem
            {
                Timestamp = l.SubmittedDate,
                Category = "Liveness Check",
                AccentKey = "liveness",
                Icon = "bi-camera-fill",
                Title = l.FullName,
                Subtitle = l.MunicipalityName,
                OnClick = () => { GoToLivenessReview(l); return Task.CompletedTask; }
            });
        }

        foreach (var u in _updateNotices)
        {
            var isLatestUnseen = _hasUnseenUpdate && u == _updateNotices.First();
            items.Add(new FeedItem
            {
                Timestamp = u.PublishedAt,
                Category = "System Update",
                AccentKey = "update",
                Icon = "bi-arrow-repeat",
                Title = $"{u.Title} (v{u.Version})",
                Subtitle = u.Changes.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault(),
                OnClick = isLatestUnseen ? () => RefreshForLatestUpdate() : null
            });
        }

        return items.OrderByDescending(i => i.Timestamp).ToList();
    }

    private async Task HandleFeedItemClick(FeedItem item)
    {
        if (item.OnClick is not null)
            await item.OnClick();
    }

    // ── Unseen-since-last-opened badge ───────────────────────────────────────
    // Opening the dropdown acknowledges everything currently in the feed — the
    // count then only climbs again for items that arrive AFTER that, instead
    // of nagging with the same still-pending total every time. Keyed off a
    // TIMESTAMP (not a raw count) and persisted to localStorage, so it
    // survives a page reload instead of resetting to "everything unseen"
    // every time this component remounts (a plain in-memory count would also
    // have been wrong the moment the feed's contents changed underneath it,
    // even within the same session).
    private const string LastSeenStorageKey = "eca-notif-bell-last-seen";
    private DateTime _lastAcknowledgedAt = DateTime.MinValue;
    private int UnseenBadgeCount => Feed.Count(i => i.Timestamp > _lastAcknowledgedAt);

    protected override async Task OnInitializedAsync()
    {
        await LoadLastAcknowledgedAsync();

        await AuthService.InitAsync();
        _myRegionCode = AuthService.GetRegionCode();

        await ShowAllDayRemindersOnLoad();
        await ConnectRealtimeAsync();

        ActivityClient.ActivityStarting += OnActivityStarting;

        AppTracking.OnChange += HandleFeedSourceChange;
        await AppTracking.RefreshPendingCountAsync();

        DocTracking.OnChange += HandleFeedSourceChange;
        await DocTracking.RefreshPendingCountAsync();

        LivenessNotification.OnChange += HandleFeedSourceChange;

        SystemUpdateClient.OnUnseenUpdate += OnUnseenSystemUpdate;
        await LoadUpdateNoticesAsync();
    }

    private void HandleFeedSourceChange() => InvokeAsync(StateHasChanged);

    private void ToggleDropdown()
    {
        _showDropdown = !_showDropdown;
        if (_showDropdown)
        {
            _ = AcknowledgeFeedAsync();
        }
    }

    public void CloseDropdown() => _showDropdown = false;

    private async Task AcknowledgeFeedAsync()
    {
        _lastAcknowledgedAt = DateTime.UtcNow;
        try { await JS.InvokeVoidAsync("localStorage.setItem", LastSeenStorageKey, _lastAcknowledgedAt.ToString("o")); }
        catch { /* non-fatal — worst case the badge re-shows these on next reload */ }
    }

    private async Task LoadLastAcknowledgedAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", LastSeenStorageKey);
            if (!string.IsNullOrEmpty(stored) && DateTime.TryParse(stored, null,
                    System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
            {
                _lastAcknowledgedAt = parsed;
            }
        }
        catch { /* non-fatal — defaults to "everything unseen" */ }
    }

    private void GoToApplicationTracking()
    {
        _showDropdown = false;
        Navigation.NavigateTo("/application-tracking");
    }

    private void GoToDocumentTracking()
    {
        _showDropdown = false;
        Navigation.NavigateTo("/document-tracking");
    }

    private void GoToLivenessReview(LivenessPendingReviewItemDto item)
    {
        _showDropdown = false;
        State.RequestOpenLivenessReview(item.BeneficiaryId);

        var currentPath = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        if (!currentPath.Equals("/beneficiary-records", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/beneficiary-records");
        }
    }

    #region Calendar (activity-start interrupt only — the "today" list moved to NavMenu's badge)
    private int? _myRegionCode;
    private ActivityDto? _modalActivity;
    private readonly Queue<ActivityDto> _modalQueue = new();
    private bool _dontShowModalAgain;

    private async Task ConnectRealtimeAsync()
    {
        if (!ActivityClient.IsConnected)
        {
            try
            {
                var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
                var hubUrl = new Uri(new Uri(apiBase), "activityHub").ToString();
                await ActivityClient.ConnectAsync(hubUrl);
            }
            catch { /* non-fatal */ }
        }
    }

    private void OnActivityStarting(ActivityDto activity)
    {
        if (activity.StartDate.Date != DateTime.Today) return;

        if (_myRegionCode.HasValue && activity.PsgcCodeRegion.HasValue && activity.PsgcCodeRegion != _myRegionCode)
            return;

        InvokeAsync(async () =>
        {
            if (!await IsModalDismissedAsync(activity.Id))
                EnqueueModal(activity);

            StateHasChanged();
        });
    }

    private void EnqueueModal(ActivityDto activity)
    {
        if (_modalActivity is null)
            _modalActivity = activity;
        else
            _modalQueue.Enqueue(activity);
    }

    private static string DismissedModalKey(int activityId) =>
        $"eca-dismissed-activity-modal-{activityId}-{DateTime.Today:yyyyMMdd}";

    private async Task<bool> IsModalDismissedAsync(int activityId)
    {
        try
        {
            var value = await JS.InvokeAsync<string?>("localStorage.getItem", DismissedModalKey(activityId));
            return value == "true";
        }
        catch { return false; }
    }

    private async Task MarkModalDismissedAsync(int activityId)
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", DismissedModalKey(activityId), "true"); }
        catch { /* non-fatal — worst case it just pops again next reload */ }
    }

    private async Task DismissModal()
    {
        if (_dontShowModalAgain && _modalActivity is not null)
            await MarkModalDismissedAsync(_modalActivity.Id);

        _dontShowModalAgain = false;
        _modalActivity = _modalQueue.Count > 0 ? _modalQueue.Dequeue() : null;
    }

    private async Task GoToCalendarAndDismiss()
    {
        if (_dontShowModalAgain && _modalActivity is not null)
            await MarkModalDismissedAsync(_modalActivity.Id);

        _dontShowModalAgain = false;
        _modalActivity = null;
        _modalQueue.Clear();
        _showDropdown = false;
        Navigation.NavigateTo("/calendar");
    }

    // ✅ static — deliberately survives this component being disposed and
    // recreated within the same page load (e.g. MainLayout's <AuthorizeView>
    // remounts its Authorized content on every auth-state change). Without
    // this memory, each remount would re-run OnInitializedAsync and pop the
    // "already seen" reminder again. Resets naturally once the date rolls over.
    private static DateTime _shownAllDayRemindersDate = DateTime.MinValue;
    private static readonly HashSet<int> _shownAllDayActivityIds = new();

    private async Task ShowAllDayRemindersOnLoad()
    {
        if (_shownAllDayRemindersDate != DateTime.Today)
        {
            _shownAllDayRemindersDate = DateTime.Today;
            _shownAllDayActivityIds.Clear();
        }

        List<ActivityDto> todayActivities;
        try { todayActivities = await ActivityClient.GetDayMyRegionAsync(DateTime.Today); }
        catch { todayActivities = new(); }

        foreach (var activity in todayActivities.Where(a => a.IsAllDay))
        {
            if (!_shownAllDayActivityIds.Add(activity.Id)) continue;
            if (await IsModalDismissedAsync(activity.Id)) continue;

            EnqueueModal(activity);
        }
    }
    #endregion

    #region System Updates
    private List<SystemUpdateNoticeDto> _updateNotices = new();
    private bool _hasUnseenUpdate;
    private bool _refreshingFromBell;

    private async Task LoadUpdateNoticesAsync()
    {
        try
        {
            _updateNotices = await Http.GetFromJsonAsync<List<SystemUpdateNoticeDto>>("api/system-updates") ?? new();
        }
        catch
        {
            _updateNotices = new();
        }

        // Also settles _hasUnseenUpdate on first load (e.g. a notice was
        // published while this user wasn't connected) — the live event below
        // only fires for broadcasts that happen while the app is open.
        await SystemUpdateClient.CheckForUnseenLatestAsync();
    }

    private void OnUnseenSystemUpdate(SystemUpdateNoticeDto notice)
    {
        _hasUnseenUpdate = true;

        if (!_updateNotices.Any(n => n.Version == notice.Version))
            _updateNotices.Insert(0, notice);

        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshForLatestUpdate()
    {
        if (_refreshingFromBell) return;
        _refreshingFromBell = true;
        StateHasChanged();

        var latest = _updateNotices.FirstOrDefault();
        if (latest != null)
            await SystemUpdateClient.AcknowledgeAsync(latest.Version);

        await Task.Delay(350);
        // syncReload — a plain reload is enough now that index.html/blazor.boot.json
        // are served no-cache (see wwwroot/web.config), so it always picks up
        // the new deploy without re-downloading the whole runtime.
        await JS.InvokeVoidAsync("syncReload");
    }
    #endregion

    public async ValueTask DisposeAsync()
    {
        ActivityClient.ActivityStarting -= OnActivityStarting;

        AppTracking.OnChange -= HandleFeedSourceChange;
        DocTracking.OnChange -= HandleFeedSourceChange;
        LivenessNotification.OnChange -= HandleFeedSourceChange;

        SystemUpdateClient.OnUnseenUpdate -= OnUnseenSystemUpdate;

        await Task.CompletedTask;
    }
}
