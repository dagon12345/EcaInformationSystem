<article class="about-article-wrapper">
    <div class="info-hero">
        <div class="features-hero-glow features-hero-glow--1"></div>
        <div class="features-hero-glow features-hero-glow--2"></div>

        <div class="about-article-seal">
            <img src="images/ncsc-coat-of-arms.png" alt="Coat of Arms of the Republic of the Philippines" />
            <div class="about-article-seal-text">Republika ng Pilipinas</div>
        </div>

        <div class="about-article-kicker">Get in Touch<PageViewBadge PageKey="contact" /></div>
        <h1 class="about-article-title">NCSC Regional Offices</h1>
        <p class="about-article-lede">
            Need to reach the National Commission of Senior Citizens directly? Here's every regional office's
            address, email, and contact number — the Caraga office is the one this system serves.
        </p>
    </div>

    <div class="about-article">
    <div class="offices-grid">
        @foreach (var office in _offices)
        {
            <div class="office-card @(office.Highlight ? "office-card--highlight" : "")">
                @if (office.Highlight)
                {
                    <div class="office-card-badge"><i class="bi bi-geo-alt-fill me-1"></i>Serves This System</div>
                }
                <div class="office-card-name">@office.Name</div>
                <div class="office-card-row">
                    <i class="bi bi-signpost-2"></i>
                    <span>@office.Address</span>
                </div>
                <div class="office-card-row">
                    <i class="bi bi-envelope"></i>
                    <span>@string.Join(", ", office.Emails)</span>
                </div>
                <div class="office-card-row">
                    <i class="bi bi-telephone"></i>
                    <span>@string.Join(" · ", office.Phones)</span>
                </div>
            </div>
        }
    </div>

    <div class="about-article-source">
        <i class="bi bi-info-circle me-1"></i>
        Source: <a href="https://www.ncsc.gov.ph/regional-offices" target="_blank" rel="noopener noreferrer">ncsc.gov.ph/regional-offices</a>
    </div>
    </div>
</article>

