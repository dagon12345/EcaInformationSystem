<article class="about-article">
    <div class="about-article-seal">
        <img src="images/ncsc-coat-of-arms.png" alt="Coat of Arms of the Republic of the Philippines" />
        <div class="about-article-seal-text">Republika ng Pilipinas</div>
    </div>

    <div class="about-article-kicker">Who's Who</div>
    <h1 class="about-article-title">NCSC Directory of Officials</h1>
    <p class="about-article-lede">
        The Commissioners and officials leading the National Commission of Senior Citizens, nationally and
        across every region — the Caraga entry is the one this system serves.
    </p>

    @foreach (var group in _groups)
    {
        <section class="about-section">
            <h2 class="about-section-title">@group.Title</h2>
            <div class="officials-grid">
                @foreach (var person in group.People)
                {
                    <div class="official-card @(person.Highlight ? "official-card--highlight" : "")">
                        @if (person.Highlight)
                        {
                            <div class="office-card-badge"><i class="bi bi-geo-alt-fill me-1"></i>Serves This System</div>
                        }
                        <div class="official-card-name">@person.Name</div>
                        <div class="official-card-position">@person.Position</div>
                        @if (!string.IsNullOrWhiteSpace(person.Office))
                        {
                            <div class="office-card-row">
                                <i class="bi bi-signpost-2"></i>
                                <span>@person.Office</span>
                            </div>
                        }
                        @if (person.Emails.Length > 0)
                        {
                            <div class="office-card-row">
                                <i class="bi bi-envelope"></i>
                                <span>@string.Join(", ", person.Emails)</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(person.Phone))
                        {
                            <div class="office-card-row">
                                <i class="bi bi-telephone"></i>
                                <span>@person.Phone</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <div class="about-article-source">
        <i class="bi bi-info-circle me-1"></i>
        Source: <a href="https://www.ncsc.gov.ph/directory-officials" target="_blank" rel="noopener noreferrer">ncsc.gov.ph/directory-officials</a>
    </div>
</article>

