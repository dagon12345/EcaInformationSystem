    #region Lightbox Image Zooming - Start
    private static double TouchDistance(TouchPoint a, TouchPoint b)
    {
        var dx = a.ClientX - b.ClientX;
        var dy = a.ClientY - b.ClientY;
        return Math.Sqrt(dx * dx + dy * dy);
    }

    private async Task StartLightboxPanTouch(TouchEventArgs e)
    {
        if (e.Touches.Length == 2)
        {
            _isPinching = true;
            _isPanning = false;
            var t0 = e.Touches[0];
            var t1 = e.Touches[1];
            _pinchStartDistance = TouchDistance(t0, t1);
            _pinchStartZoom = _lightboxZoom;

            var midX = (t0.ClientX + t1.ClientX) / 2;
            var midY = (t0.ClientY + t1.ClientY) / 2;
            var offset = await GetImageOffsetAsync(midX, midY);
            if (offset != null)
                _lightboxTransformOrigin = $"{offset.X.ToString(System.Globalization.CultureInfo.InvariantCulture)}px {offset.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}px";
        }
        else if (_lightboxZoom > 1 && e.Touches.Length == 1)
        {
            _isPanning = true;
            _panStartX = e.Touches[0].ClientX;
            _panStartY = e.Touches[0].ClientY;
            _panOriginX = _lightboxPanX;
            _panOriginY = _lightboxPanY;
        }
    }

    private void OnLightboxPanMoveTouch(TouchEventArgs e)
    {
        if (_isPinching && e.Touches.Length == 2)
        {
            var dist = TouchDistance(e.Touches[0], e.Touches[1]);
            if (_pinchStartDistance > 0)
            {
                var ratio = dist / _pinchStartDistance;
                _lightboxZoom = Math.Clamp(_pinchStartZoom * ratio, 1, MaxZoom);
            }
            return;
        }

        if (!_isPanning || e.Touches.Length == 0) return;
        _lightboxPanX = _panOriginX + (e.Touches[0].ClientX - _panStartX) / _lightboxZoom;
        _lightboxPanY = _panOriginY + (e.Touches[0].ClientY - _panStartY) / _lightboxZoom;
    }

    private void EndLightboxPanTouchEnd(TouchEventArgs e)
    {
        _isPanning = false;
        if (e.Touches.Length < 2)
        {
            _isPinching = false;
            if (_lightboxZoom <= 1)
            {
                _lightboxZoom = 1;
                _lightboxPanX = 0;
                _lightboxPanY = 0;
                _lightboxTransformOrigin = "center center";
            }
        }
    }
    private async Task<ImageOffset?> GetImageOffsetAsync(double clientX, double clientY)
    {
        try { return await JS.InvokeAsync<ImageOffset>("feedInterop.getImageOffset", _lightboxImageRef, clientX, clientY, _lightboxZoom); }
        catch { return null; }
    }

    private async Task OnLightboxImageClick(MouseEventArgs e)
    {
        if (_lightboxZoom <= 1)
        {
            var offset = await GetImageOffsetAsync(e.ClientX, e.ClientY);
            if (offset != null)
                _lightboxTransformOrigin = $"{offset.X.ToString(System.Globalization.CultureInfo.InvariantCulture)}px {offset.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}px";
        }
        ToggleLightboxZoom();
    }

    private void ToggleLightboxZoom()
    {
        _lightboxZoom = _lightboxZoom > 1 ? 1 : 2;
        _lightboxPanX = 0;
        _lightboxPanY = 0;
        if (_lightboxZoom == 1) _lightboxTransformOrigin = "center center";
    }
    private void AdjustLightboxZoom(double delta)
    {
        _lightboxZoom = Math.Clamp(_lightboxZoom + delta, 1, MaxZoom);
        _lightboxPanX = 0;
        _lightboxPanY = 0;
    }
    private void ResetLightboxZoom()
    {
        _lightboxZoom = 1;
        _lightboxPanX = 0;
        _lightboxPanY = 0;
    }

    private void HandleLightboxWheel(WheelEventArgs e)
    {
        var delta = e.DeltaY < 0 ? 0.25 : -0.25;
        _lightboxZoom = Math.Clamp(_lightboxZoom + delta, 1, MaxZoom);
        if (_lightboxZoom <= 1)
        {
            _lightboxZoom = 1;
            _lightboxPanX = 0;
            _lightboxPanY = 0;
        }
    }

    private void StartLightboxPan(MouseEventArgs e)
    {
        if (_lightboxZoom <= 1) return;
        _isPanning = true;
        _panStartX = e.ClientX;
        _panStartY = e.ClientY;
        _panOriginX = _lightboxPanX;
        _panOriginY = _lightboxPanY;
    }

    private void OnLightboxPanMove(MouseEventArgs e)
    {
        if (!_isPanning) return;
        // Divide by zoom so panning feels consistent regardless of zoom level
        _lightboxPanX = _panOriginX + (e.ClientX - _panStartX) / _lightboxZoom;
        _lightboxPanY = _panOriginY + (e.ClientY - _panStartY) / _lightboxZoom;
    }

    private void EndLightboxPan(MouseEventArgs e)
    {
        _isPanning = false;
    }

    private async void OpenLightbox(PostDto post, int index)
    {
        _lightboxImageIds = post.Images.OrderBy(i => i.DisplayOrder).Select(i => i.Id).ToList();
        _lightboxIndex = index;
        _lightboxImageId = _lightboxImageIds[index];
        ResetLightboxZoom();

        StateHasChanged();
        await Task.Delay(1); // let the backdrop render before focusing it
        try { await _lightboxBackdropRef.FocusAsync(); }
        catch { }
    }

    private void CloseLightbox()
    {
        _lightboxImageId = null;
        _lightboxImageIds.Clear();
    }

    private void NavigateLightbox(int delta)
    {
        var newIndex = _lightboxIndex + delta;
        if (newIndex < 0 || newIndex >= _lightboxImageIds.Count) return;
        _lightboxIndex = newIndex;
        _lightboxImageId = _lightboxImageIds[newIndex];
        ResetLightboxZoom();
    }


