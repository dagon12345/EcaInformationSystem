    #region Emoji Reaction - Start
    private void OnReactionButtonClick(PostDto post)
    {
        // If viewer already has a reaction, clicking the main button toggles it off
        // (same as before). If not, clicking opens the picker instead of instantly
        // applying "Like" — this is the actual behavior change: no reaction happens
        // on a bare click anymore, the picker decides.
        if (post.ViewerReactionType.HasValue)
        {
            _ = SetReactionAsync(post, post.ViewerReactionType.Value); // toggles off, same type clicked
            _openReactionPickerPostId = null;
        }
        else
        {
            _openReactionPickerPostId = _openReactionPickerPostId == post.Id ? null : post.Id;
        }
    }

    private async Task SetReactionAsync(PostDto post, int reactionType)
    {
        _openReactionPickerPostId = null;   // renamed

        var previous = post.ViewerReactionType;
        ApplyReactionDelta(post, previous, remove: true);
        post.ViewerReactionType = previous == reactionType ? null : reactionType;
        if (post.ViewerReactionType.HasValue)
            ApplyReactionDelta(post, post.ViewerReactionType, remove: false);
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync($"api/posts/{post.Id}/react", new SetPostReactionDto { ReactionType = reactionType });
            var result = await response.Content.ReadFromJsonAsync<ReactionResultDto>();
            if (result != null)
            {
                post.ViewerReactionType = result.ViewerReactionType;
                post.Reactions = result.Reactions;
            }
        }
        catch { }
    }

    private static void ApplyReactionDelta(PostDto post, int? t, bool remove)
    {
        if (!t.HasValue) return;
        int d = remove ? -1 : 1;
        switch (t.Value)
        {
            case 1: post.Reactions.Like = Math.Max(0, post.Reactions.Like + d); break;
            case 2: post.Reactions.Wow = Math.Max(0, post.Reactions.Wow + d); break;
            case 3: post.Reactions.Heart = Math.Max(0, post.Reactions.Heart + d); break;
            case 4: post.Reactions.Confetti = Math.Max(0, post.Reactions.Confetti + d); break;
        }
    }

    private void OnReactionUpdated(Guid postId, ReactionSummaryDto summary)
    {
        var post = _posts.FirstOrDefault(p => p.Id == postId);
        if (post != null) { post.Reactions = summary; InvokeAsync(StateHasChanged); }
    }
