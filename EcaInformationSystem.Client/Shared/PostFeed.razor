    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(MaxImages))
        {
            if (_selectedImages.Count >= MaxImages) break;
            if (file.Size > MaxImageBytes) continue; // silently skip oversized — could surface a toast if you want

            using var stream = file.OpenReadStream(MaxImageBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            _selectedImages.Add(new SelectedImage
            {
                Data = bytes,
                ContentType = file.ContentType,
                FileName = file.Name,
                PreviewDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}"
            });
        }
        _composerExpanded = true;
        StateHasChanged();
    }

