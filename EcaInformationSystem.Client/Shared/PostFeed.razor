        {
            toast.ShowError("Title is required.");
            return;
        }

        _isSavingNote = true;
        try
        {
            var (success, note, error) = await StickyNotes.UpsertAsync(_noteDraft);
            if (!success || note is null)
            {
                toast.ShowError(string.IsNullOrWhiteSpace(error) ? "Failed to save note." : error);
                return;
            }

            var existingIndex = _notes.FindIndex(n => n.Id == note.Id);
            if (existingIndex >= 0) _notes[existingIndex] = note;
            else _notes.Insert(0, note);

            _showNoteModal = false;
            toast.ShowSuccess("Note saved.");
        }
        finally
        {
            _isSavingNote = false;
        }
    }

