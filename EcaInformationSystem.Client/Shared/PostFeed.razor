    private async Task SaveEditAsync(PostDto post)
    {
        if (string.IsNullOrWhiteSpace(_editContent) && !_editingImages.Any() && !_editNewImages.Any()) return;
        _isSavingEdit = true;
        try
        {
            var removedIds = post.Images
                .Where(orig => !_editingImages.Any(kept => kept.Id == orig.Id))
                .Select(i => i.Id.ToString());

            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(_editContent ?? string.Empty), "content");
            form.Add(new StringContent(string.Join(",", removedIds)), "removeImageIds");

            foreach (var img in _editNewImages)
            {
                var byteContent = new ByteArrayContent(img.Data);
                byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(img.ContentType) ? "application/octet-stream" : img.ContentType);
                form.Add(byteContent, "newImages", img.FileName);
            }

            var request = new HttpRequestMessage(HttpMethod.Put, $"api/posts/{post.Id}") { Content = form };
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PostDto>();
                if (result != null)
                {
                    post.Content = result.Content;
                    post.EditedAt = result.EditedAt;
                    post.Images = result.Images;
                }
                CancelEdit();
            }
        }
        finally
        {
            _isSavingEdit = false;
        }
    }
