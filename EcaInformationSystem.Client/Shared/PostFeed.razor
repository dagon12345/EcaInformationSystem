    // Classic podium visual order — 2nd on the left, 1st in the middle
    // (tallest pillar), 3rd on the right. Gracefully handles seasons with
    // fewer than 3 ranked participants by just omitting the missing places.
    private static List<PodiumEntryDto> OrderForPodiumDisplay(List<PodiumEntryDto> podium)
    {
        var byRank = podium.ToDictionary(p => p.Rank);
        var ordered = new List<PodiumEntryDto>();
        foreach (var rank in new[] { 2, 1, 3 })
        {
            if (byRank.TryGetValue(rank, out var entry))
                ordered.Add(entry);
        }
        return ordered;
    }

