    private async Task SubmitPostAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPostContent) && !_selectedImages.Any()) return;
        _isPosting = true;
        try
        {
            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(_newPostContent ?? string.Empty), "content");

            foreach (var img in _selectedImages)
            {
                var byteContent = new ByteArrayContent(img.Data);
                byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(img.ContentType) ? "application/octet-stream" : img.ContentType);
                form.Add(byteContent, "images", img.FileName);
            }

            var response = await Http.PostAsync("api/posts", form);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<PostDto>();
                if (created != null)
                {
                    // If the SignalR broadcast already inserted this post (with
                    // CanDelete=false, since it's meant for OTHER viewers), replace
                    // it with the authoritative HTTP response instead of skipping.
                    var existingIndex = _posts.FindIndex(p => p.Id == created.Id);
                    if (existingIndex >= 0)
                    {
                        _posts[existingIndex] = created;
                    }
                    else
                    {
                        _posts.Insert(0, created);
                    }
                    _newCommentContent.TryAdd(created.Id, string.Empty);
                }
                _newPostContent = string.Empty;
                _selectedImages.Clear();
                _composerExpanded = false;
            }
        }
        finally
        {
            _isPosting = false;
        }
    }
