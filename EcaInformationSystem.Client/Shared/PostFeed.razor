    private async Task ToggleContentChecklistLineAsync(StickyNoteDto note, int lineIndex)
    {
        var lines = (note.Content ?? string.Empty).Replace("\r\n", "\n").Split('\n');
        if (lineIndex < 0 || lineIndex >= lines.Length) return;

        var match = ChecklistLineRegex.Match(lines[lineIndex]);
        if (!match.Success) return;

        var nowChecked = !match.Groups[1].Value.Trim().Equals("x", StringComparison.OrdinalIgnoreCase);
        lines[lineIndex] = $"- [{(nowChecked ? "x" : " ")}] {match.Groups[2].Value}";
        var updatedContent = string.Join('\n', lines);

        // Optimistic local update so the checkbox flips instantly — reverted
        // if the save turns out to fail.
        var previousContent = note.Content;
        note.Content = updatedContent;
        StateHasChanged();

        var dto = new StickyNoteUpsertDto { Id = note.Id, Title = note.Title, Content = updatedContent, Color = note.Color };
        var (success, updated, error) = await StickyNotes.UpsertAsync(dto);
        if (success && updated is not null)
        {
            var idx = _notes.FindIndex(n => n.Id == note.Id);
            if (idx >= 0) _notes[idx] = updated;
        }
        else
        {
            note.Content = previousContent;
            toast.ShowError(string.IsNullOrWhiteSpace(error) ? "Failed to update checklist item." : error);
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try { _viewerKey = await JS.InvokeAsync<string>("viewerKey.get"); }
        catch { _viewerKey = Guid.NewGuid().ToString(); }

        Http.DefaultRequestHeaders.Remove("X-Viewer-Key");
        Http.DefaultRequestHeaders.Add("X-Viewer-Key", _viewerKey);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        await LoadFeedAsync(reset: true);

        if (_isAuthenticated)
        {
            await AuthService.InitAsync();
            _isSuperAdmin = AuthService.IsSuperAdmin();
            _isFocal = AuthService.IsFocal();

            await LoadUpcomingBirthdaysAsync();

            // Focal's feed access is intentionally view/comment/like/share
            // only — skip fetching sticky notes / leaderboard / tier data
            // entirely rather than just hiding the widgets, since none of
            // those endpoints are reachable for Focal anyway (see
            // StickyNoteController / UserTransactionTierController).
            if (!_isFocal)
            {
                await LoadNotesAsync();

                // ✅ Now a persistent sidebar (like birthday/sticky-notes) instead of
                // an inline collapsed-by-default banner, so it starts expanded and
                // loads immediately rather than waiting for a header click.
                _leaderboardExpanded = true;
                await LoadLeaderboardAsync();
                _myTier = await TierClient.GetMyTierAsync();
                _seasonInfo = await TierClient.GetSeasonInfoAsync();

                await ConnectTierRealtimeAsync();
            }
        }

        // ✅ If we were opened via a shared link, ensure that post is present
        // (even if it's older than the first page) and scroll/highlight it.
        if (FocusPostId.HasValue)
        {
            await EnsureFocusedPostLoadedAsync(FocusPostId.Value);
        }

        await ConnectRealtimeAsync();
    }

    private async Task EnsureFocusedPostLoadedAsync(Guid postId)
    {
        // If it's already in the first page, no extra fetch needed.
        if (!_posts.Any(p => p.Id == postId))
        {
            try
            {
                var post = await Http.GetFromJsonAsync<PostDto>($"api/posts/{postId}");
                if (post != null)
                {
                    // Insert it at the top so it's visible without requiring "Load more" —
                    // it's out of chronological order here, but it's clearly highlighted
                    // so that's not confusing in context.
                    _posts.Insert(0, post);
                    _newCommentContent.TryAdd(post.Id, string.Empty);
                }
            }
            catch { }
        }

        _highlightedPostId = postId;
        StateHasChanged();

        await Task.Delay(50); // let the DOM render before scrolling
        try { await JS.InvokeVoidAsync("feedInterop.scrollToPost", postId.ToString()); }
        catch { }

        // Fade the highlight after a few seconds so it doesn't stay permanently marked.
        await Task.Delay(3000);
        _highlightedPostId = null;
        StateHasChanged();
    }
    private async Task CopyPostLinkAsync(Guid postId)
    {
        // Routes through the API's /share/post/{id} endpoint (SharePostController)
        // instead of linking straight into the client app — the client is a
        // static Blazor WASM SPA with no server-side rendering, so a social-media
        // crawler hitting it directly would only ever see the generic index.html
        // shell (no post-specific title/image). The API endpoint detects crawlers
        // and serves real Open Graph tags, then 302s real visitors into the app.
        var url = $"{Http.BaseAddress}share/post/{postId}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _linkCopiedPostId = postId;
            StateHasChanged();
            await Task.Delay(1800);
            _linkCopiedPostId = null;
            StateHasChanged();
        }
        catch { }
    }

