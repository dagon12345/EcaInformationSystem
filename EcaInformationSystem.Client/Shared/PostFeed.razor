@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Client.Pages
@using EcaInformationSystem.Shared.DTOs
@using EcaInformationSystem.Shared.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@implements IAsyncDisposable
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject PostsClientService PostsClient
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject StickyNoteClientService StickyNotes
@inject ToastService toast
@inject TransactionTierClientService TierClient
@inject TransactionTierHubClientService TierHub
@inject AuthService AuthService

<div class="feed-page-layout">
@if (_isAuthenticated && !_isFocal)
{
    @* ── Transaction Leaderboard — replaces the old inline chat sidebar here;
         Messages moved to a navbar icon (MainLayout) with the same click-to-open
         behavior as the notification bell. Reuses .feed-chat-sidebar's exact
         CSS (width/shrink/mobile-stacking) so the column behaves identically.
         Ranks internal staff transaction volume — not shown to Focal, whose
         feed access is intentionally view/comment/like/share only. ── *@
    <aside class="feed-chat-sidebar">
        <div class="tier-leaderboard-card">
            <div class="tier-leaderboard-header" @onclick="ToggleLeaderboard">
                <div class="tier-leaderboard-header-left">
                    <i class="bi bi-trophy-fill"></i>
                    <div>
                        <div class="tier-leaderboard-title">
                            Transaction Leaderboard
                            @if (_seasonInfo is not null)
                            {
                                <span class="tier-season-badge">Season @_seasonInfo.SeasonNumber</span>
                            }
                        </div>
                        <div class="tier-leaderboard-subtitle">
                            @if (_seasonInfo is not null)
                            {
                                <span>Resets @FormatCountdown(_seasonInfo.NextAutoResetAtUtc) — Sunday 11:59 PM</span>
                            }
                            else
                            {
                                <span>Ranked by activity across the whole system</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (_isSuperAdmin)
                    {
                        <button type="button" class="tier-reset-btn" title="End this week's season now"
                                disabled="@_isResettingSeason"
                                @onclick="OpenResetConfirm" @onclick:stopPropagation="true">
                            <i class="bi bi-arrow-repeat"></i>
                        </button>
                    }
                    <i class="bi bi-chevron-@(_leaderboardExpanded ? "up" : "down")"></i>
                </div>
            </div>

            @* ── How to climb — always visible once expanded, independent of
                 whether the viewer has a last-season result yet. This is the
                 whole point of the leaderboard: nudge people toward cleaning up
                 their grantee data, not just "do more clicks". ── *@
            @if (_leaderboardExpanded)
            {
                <div class="tier-leaderboard-tip">
                    <i class="bi bi-lightbulb-fill me-1"></i>
                    <span>
                        Correcting incomplete grantee info, following up on missing documents, and verifying
                        pending records all count toward your weekly rank.
                    </span>
                </div>
            }

            @if (_leaderboardExpanded && _myTier is not null)
            {
                var myVisual = TierVisuals.For(_myTier.TierLevel);
                <div class="tier-leaderboard-myprogress @myVisual.CssClass">
                    <div class="tier-leaderboard-myprogress-top">
                        <span><i class="bi @myVisual.Icon me-1"></i>You're <strong>@_myTier.TierName</strong> tier</span>
                        <button type="button" class="tier-info-btn" title="View the full tier list"
                                @onclick="OpenTierLadderModal">
                            <i class="bi bi-info-circle"></i>
                        </button>
                    </div>
                    <div class="tier-progress-track">
                        <div class="tier-progress-fill" style="width:@(_myTier.ProgressPercent.ToString("0.#"))%;"></div>
                    </div>
                    <div class="tier-progress-label @(_myTier.NextTierMinCount is null ? "tier-progress-label--max" : "")">
                        @if (_myTier.NextTierMinCount.HasValue)
                        {
                            <i class="bi bi-arrow-up-circle me-1"></i>
                            <strong>@((_myTier.NextTierMinCount.Value - _myTier.TransactionCount).ToString("N0"))</strong>
                            <span>@(" transaction" + (_myTier.NextTierMinCount.Value - _myTier.TransactionCount == 1 ? "" : "s")) away from <strong>@_myTier.NextTierName</strong></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill me-1"></i><span>Max tier reached!</span>
                        }
                    </div>

                    @* Last week's rank, win count, and motivation nudge now live on
                       your Profile page instead of here — click through to see them. ── *@
                    <a href="/profile" class="tier-profile-nav-link">
                        <i class="bi bi-person-badge me-1"></i>View your last season rank on your profile
                        <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            }

            @if (_leaderboardExpanded)
            {
                @if (_isLoadingLeaderboard)
                {
                    <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                }
                else if (!_leaderboard.Any())
                {
                    <div class="tier-leaderboard-empty">No activity recorded yet.</div>
                }
                else
                {
                    <div class="tier-leaderboard-list">
                        @foreach (var entry in _leaderboard)
                        {
                            var v = TierVisuals.For(entry.TierLevel);
                            var isLive = _recentlyUpdatedUserNames.Contains(entry.UserName);
                            var isRankedUp = _rankedUpUserNames.Contains(entry.UserName);
                            var isRankedDown = _rankedDownUserNames.Contains(entry.UserName);
                            var delta = _deltaByUserName.TryGetValue(entry.UserName, out var d) ? d : 0;
                            <div @key="entry.UserName" class="tier-leaderboard-row @v.CssClass @(entry.IsMe ? "tier-leaderboard-row--me" : "") @RankRowClass(entry.Rank) @(entry.UserId.HasValue ? "tier-leaderboard-row--clickable" : "") @(isLive ? "tier-leaderboard-row--live" : "") @(isRankedUp ? "tier-leaderboard-row--rank-up" : "") @(isRankedDown ? "tier-leaderboard-row--rank-down" : "")"
                                 @onclick="() => GoToProfile(entry.UserId)">
                                <span class="tier-row-sheen"></span>
                                <span class="tier-row-particle tier-row-particle--1"></span>
                                <span class="tier-row-particle tier-row-particle--2"></span>
                                <span class="tier-row-particle tier-row-particle--3"></span>
                                <span class="tier-row-particle tier-row-particle--4"></span>
                                <span class="tier-row-particle tier-row-particle--5"></span>
                                <span class="tier-row-particle tier-row-particle--6"></span>
                                @if (isLive || isRankedUp)
                                {
                                    <span class="tier-bolt-flash"></span>
                                }
                                @if (delta > 0)
                                {
                                    <span class="tier-count-delta">+@delta</span>
                                }
                                <div class="tier-leaderboard-rank">
                                    @if (entry.Rank <= 3)
                                    {
                                        <i class="bi bi-award-fill"></i>
                                    }
                                    else
                                    {
                                        <span>#@entry.Rank</span>
                                    }
                                    @if (isRankedUp)
                                    {
                                        <i class="bi bi-caret-up-fill tier-leaderboard-rank-arrow tier-leaderboard-rank-arrow--up" title="Overtook someone!"></i>
                                    }
                                    else if (isRankedDown)
                                    {
                                        <i class="bi bi-caret-down-fill tier-leaderboard-rank-arrow tier-leaderboard-rank-arrow--down" title="Got overtaken"></i>
                                    }
                                </div>

                                <div class="tier-leaderboard-avatar-fx">
                                    @if (entry.UserId.HasValue)
                                    {
                                        <img src="@AvatarUrl(entry.UserId.Value)" crossorigin="anonymous" alt="" class="tier-leaderboard-avatar avatar-img"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="tier-leaderboard-avatar tier-leaderboard-avatar-fallback" style="display:none;">@GetInitials(entry.DisplayName)</div>
                                    }
                                    else
                                    {
                                        <div class="tier-leaderboard-avatar tier-leaderboard-avatar-fallback">@GetInitials(entry.DisplayName)</div>
                                    }
                                </div>

                                <div class="tier-leaderboard-info">
                                    <div class="tier-leaderboard-name @(isLive ? "tier-leaderboard-name--live" : "")">
                                        @entry.DisplayName
                                        @if (entry.IsMe)
                                        {
                                            <span class="tier-leaderboard-you-tag">You</span>
                                        }
                                        @if (isLive)
                                        {
                                            <i class="bi bi-lightning-charge-fill tier-leaderboard-live-icon" title="Just updated"></i>
                                        }
                                    </div>
                                    <div class="tier-leaderboard-tier">
                                        <i class="bi @v.Icon"></i>@entry.TierName
                                    </div>
                                </div>

                                <div class="tier-leaderboard-count @(isLive ? "tier-leaderboard-count--live" : "")">@entry.TransactionCount.ToString("N0")</div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </aside>
}
<div class="feed-container">

    <div class="feed-header">
        <div class="feed-header-icon"><i class="bi bi-heart-fill"></i></div>
        <div>
            <div class="feed-header-title">Feed and Messages</div>
            <div class="feed-header-subtitle">Updates from NCSC Caraga Region</div>
        </div>
    </div>

    @if (_isAuthenticated && !_isFocal)
    {
        @* Focal's feed access is intentionally view/comment/like/share only —
           no ability to create new posts. ── *@
        <div class="feed-composer">
            <div class="feed-avatar feed-avatar--sm">U</div>
            <div class="feed-composer-input-wrap">
                <textarea class="feed-composer-textarea" rows="1" placeholder="Share an update..."
                          value="@_newPostContent" maxlength="2000"
                          @onfocus="() => _composerExpanded = true"
                          @oninput="OnComposerInput"
                          @ref="_composerTextareaRef"></textarea>

                @if (_selectedImages.Any())
                {
                    <div class="feed-composer-preview-grid">
                        @for (int i = 0; i < _selectedImages.Count; i++)
                        {
                            var index = i;
                            <div class="feed-composer-preview-item">
                                <img src="@_selectedImages[index].PreviewDataUrl" alt="preview" />
                                <button type="button" class="feed-composer-preview-remove" @onclick="() => RemoveSelectedImage(index)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="feed-composer-preview-count">@_selectedImages.Count / @MaxImages photos selected</div>
                }

                @if (_composerExpanded || !string.IsNullOrWhiteSpace(_newPostContent) || _selectedImages.Any())
                {
                    <div class="feed-composer-actions">
                        <InputFile OnChange="OnImagesSelected" multiple accept="image/*" class="feed-composer-file-input" id="feedImageInput" />
                        <label for="feedImageInput" class="btn btn-sm btn-outline-secondary feed-composer-image-btn">
                            <i class="bi bi-image"></i> Photo
                        </label>
                        <div class="flex-grow-1"></div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CollapseComposer">Cancel</button>
                        <button class="btn btn-sm btn-primary" @onclick="SubmitPostAsync"
                                disabled="@(_isPosting || (string.IsNullOrWhiteSpace(_newPostContent) && !_selectedImages.Any()))">
                            @(_isPosting ? "Posting..." : "Post")
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    @if (_isLoading && !_posts.Any())
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (!_posts.Any())
    {
        <div class="feed-empty">
            <i class="bi bi-inbox"></i>
            <p>No posts yet. Be the first to share an update.</p>
        </div>
    }
    else
    {
        @foreach (var post in _posts)
        {
            <div class="feed-post @(_highlightedPostId == post.Id ? "feed-post--highlighted" : "") @(post.PostType == 1 ? "feed-post--podium" : "") @(post.PostType == 2 ? "feed-post--birthday" : "")"
                 id="@($"post-{post.Id}")"
                 @onmouseenter="() => TrackViewOnce(post.Id)">
                @if (post.PostType == 2)
                {
                    <div class="birthday-banner">
                        <div class="podium-banner-actions">
                            <button class="podium-banner-action-btn" title="Copy link to this post" @onclick="() => CopyPostLinkAsync(post.Id)">
                                <i class="bi bi-link-45deg"></i>
                            </button>
                            @if (post.CanDelete)
                            {
                                <button class="podium-banner-action-btn" title="Delete post" @onclick="() => RequestDeletePost(post.Id)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            }
                        </div>
                        @if (_linkCopiedPostId == post.Id)
                        {
                            <div class="feed-link-copied-toast podium-banner-link-copied-toast">Link copied!</div>
                        }
                        <a href="@($"/profile/{post.BirthdayUserId}")" class="birthday-avatar-link" title="View profile">
                            <img src="@AvatarUrl(post.BirthdayUserId ?? Guid.Empty)" crossorigin="anonymous" alt="" class="birthday-avatar avatar-img"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="birthday-avatar birthday-avatar-fallback" style="display:none;">@GetInitials(post.BirthdayUserName ?? "?")</div>
                        </a>
                        <div class="birthday-banner-confetti">🎂 🎈 🎉</div>
                        <div class="birthday-banner-title">Happy Birthday, @post.BirthdayUserName!</div>
                        <div class="birthday-banner-subtitle">Turning @post.BirthdayTurningAge today — leave a birthday wish below 👇</div>
                    </div>

                    <div class="podium-cta">
                        <i class="bi bi-chat-heart-fill"></i> Say happy birthday in the comments!
                    </div>
                }
                else if (post.PostType == 1)
                {
                    <div class="podium-banner">
                        <div class="podium-banner-actions">
                            <button class="podium-banner-action-btn" title="Copy link to this post" @onclick="() => CopyPostLinkAsync(post.Id)">
                                <i class="bi bi-link-45deg"></i>
                            </button>
                            @if (post.CanDelete)
                            {
                                <button class="podium-banner-action-btn" title="Delete post" @onclick="() => RequestDeletePost(post.Id)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            }
                        </div>
                        @if (_linkCopiedPostId == post.Id)
                        {
                            <div class="feed-link-copied-toast podium-banner-link-copied-toast">Link copied!</div>
                        }
                        <div class="podium-banner-confetti">🎉 🏆 🎉</div>
                        <div class="podium-banner-title">Season @post.SeasonNumber Champions!</div>
                        <div class="podium-banner-subtitle">Most transactions this week — congratulate them below 👇</div>
                    </div>

                    <div class="podium-stage">
                        @foreach (var entry in OrderForPodiumDisplay(post.Podium))
                        {
                            <a href="@($"/profile/{entry.UserId}")" class="podium-place podium-place--@entry.Rank" title="View profile">
                                <div class="podium-avatar-ring podium-avatar-ring--@entry.Rank">
                                    <img src="@AvatarUrl(entry.UserId)" crossorigin="anonymous" alt="" class="podium-avatar avatar-img"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                    <div class="podium-avatar podium-avatar-fallback" style="display:none;">@GetInitials(entry.DisplayName)</div>
                                    <div class="podium-medal">@PodiumMedal(entry.Rank)</div>
                                </div>
                                <div class="podium-name">@entry.DisplayName</div>
                                <div class="podium-count">@entry.TransactionCount.ToString("N0") transactions</div>
                                <div class="podium-pillar podium-pillar--@entry.Rank">#@entry.Rank</div>
                            </a>
                        }
                    </div>

                    <div class="podium-cta">
                        <i class="bi bi-chat-heart-fill"></i> Say congrats in the comments!
                    </div>
                }
                else
                {
                    <div class="feed-post-header">
                        <a href="@($"/profile/{post.AuthorUserId}")" class="feed-avatar-link" title="View profile">
                            <img src="@AvatarUrl(post.AuthorUserId)" crossorigin="anonymous" alt="" class="feed-avatar avatar-img"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="feed-avatar" style="display:none;">@GetInitials(post.AuthorName)</div>
                        </a>
                        <div class="feed-post-header-text">
                            <div class="feed-post-author">@post.AuthorName</div>
                            <div class="feed-post-meta">
                                @if (!string.IsNullOrWhiteSpace(post.AuthorPosition))
                                {
                                    <span>@post.AuthorPosition</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(post.AuthorPosition) && !string.IsNullOrWhiteSpace(post.AuthorRegion))
                                {
                                    <span class="feed-dot">&middot;</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(post.AuthorRegion))
                                {
                                    <span>@post.AuthorRegion</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(post.AuthorPosition) || !string.IsNullOrWhiteSpace(post.AuthorRegion))
                                {
                                    <span class="feed-dot">&middot;</span>
                                }
                                <span>@post.CreatedAt.ToLocalTime().ToString("MMM dd 'at' h:mm tt")</span>
                            </div>
                        </div>

                        <div class="feed-post-header-actions">
                            <button class="feed-post-menu-btn" title="Copy link to this post" @onclick="() => CopyPostLinkAsync(post.Id)">
                                <i class="bi bi-link-45deg"></i>
                            </button>

                            @if (post.CanDelete)
                            {
                                @if (_editingPostId != post.Id)
                                {
                                    <button class="feed-post-menu-btn" title="Edit post" @onclick="() => StartEdit(post)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                <button class="feed-post-menu-btn" title="Delete post" @onclick="() => RequestDeletePost(post.Id)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            }
                        </div>

                        @if (_linkCopiedPostId == post.Id)
                        {
                            <div class="feed-link-copied-toast">Link copied!</div>
                        }
                    </div>

                    @if (_editingPostId == post.Id)
                    {
                        <div class="feed-post-edit-box">
                            <textarea class="feed-edit-textarea"
                                      value="@_editContent" maxlength="2000"
                                      @oninput="OnEditInput"
                                      @ref="_editTextareaRef"></textarea>

                            @if (_editingImages.Any())
                            {
                                <div class="feed-composer-preview-grid">
                                    @foreach (var img in _editingImages)
                                    {
                                        var imgId = img.Id;
                                        <div class="feed-composer-preview-item">
                                            <img src="@GetImageUrl(imgId, thumbnail: true)" alt="preview" />
                                            <button type="button" class="feed-composer-preview-remove" @onclick="() => RemoveExistingEditImage(imgId)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            @if (_editNewImages.Any())
                            {
                                <div class="feed-composer-preview-grid">
                                    @for (int i = 0; i < _editNewImages.Count; i++)
                                    {
                                        var index = i;
                                        <div class="feed-composer-preview-item">
                                            <img src="@_editNewImages[index].PreviewDataUrl" alt="preview" />
                                            <button type="button" class="feed-composer-preview-remove" @onclick="() => _editNewImages.RemoveAt(index)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="d-flex align-items-center gap-2 mt-2">
                                <InputFile OnChange="OnEditImagesSelected" multiple accept="image/*" class="feed-composer-file-input" id="editImageInput" />
                                <label for="editImageInput" class="btn btn-sm btn-outline-secondary feed-composer-image-btn">
                                    <i class="bi bi-image"></i> Add photo
                                </label>
                                <div class="flex-grow-1"></div>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                                <button class="btn btn-sm btn-primary" @onclick="() => SaveEditAsync(post)" disabled="@_isSavingEdit">
                                    @(_isSavingEdit ? "Saving..." : "Save")
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="feed-post-content">
                            @post.Content
                            @if (post.EditedAt.HasValue)
                            {
                                <span class="feed-post-edited-tag">(edited)</span>
                            }
                        </p>
                    }
                }

                @if (post.Images.Any() && _editingPostId != post.Id)
                {
                    <div class="feed-image-grid feed-image-grid--@Math.Min(post.Images.Count, 5)">
                        @{
                            var displayCount = Math.Min(post.Images.Count, 4);
                            var overflowCount = post.Images.Count - 4;
                        }
                        @for (int i = 0; i < displayCount; i++)
                        {
                            var img = post.Images[i];
                            var index = i;
                            var isLastTile = i == 3 && overflowCount > 0;
                            <div class="feed-image-tile" @onclick="() => OpenLightbox(post, index)">
                                <img src="@GetImageUrl(img.Id, thumbnail: true)" alt="post image" loading="lazy" />
                                @if (isLastTile)
                                {
                                    <div class="feed-image-overflow">+@overflowCount</div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_editingPostId != post.Id)
                {
                    @if (post.Reactions.Total > 0 || post.CommentCount > 0 || post.ViewCount > 0)
                    {
                        <div class="feed-post-stats">
                            <span class="feed-stats-left">
                                @if (post.Reactions.Total > 0)
                                {
                                    @foreach (var emoji in GetTopReactionEmojis(post.Reactions))
                                    {
                                        <span class="feed-stats-reaction-icon">@emoji</span>
                                    }
                                    @:@post.Reactions.Total
                                }
                            </span>
                            <span class="feed-stats-right">
                                @if (post.CommentCount > 0)
                                {
                                    <span class="feed-stats-comment-link" @onclick="() => ToggleComments(post.Id)">
                                        @post.CommentCount comment@(post.CommentCount == 1 ? "" : "s")
                                    </span>
                                }
                                <span>@post.ViewCount view@(post.ViewCount == 1 ? "" : "s")</span>
                            </span>
                        </div>
                    }

                    <div class="feed-post-actionbar">
                        <div class="feed-reaction-wrapper">
                            @if (_openReactionPickerPostId == post.Id)
                            {
                                <div class="feed-reaction-picker">
                                    <button class="feed-reaction-option" title="Like" @onclick="() => SetReactionAsync(post, 1)">👍</button>
                                    <button class="feed-reaction-option" title="Wow" @onclick="() => SetReactionAsync(post, 2)">😮</button>
                                    <button class="feed-reaction-option" title="Love" @onclick="() => SetReactionAsync(post, 3)">❤️</button>
                                    <button class="feed-reaction-option" title="Celebrate" @onclick="() => SetReactionAsync(post, 4)">🎉</button>
                                </div>
                            }
                            <button class="feed-actionbar-btn @GetReactionButtonClass(post.ViewerReactionType)"
                                    @onclick="() => OnReactionButtonClick(post)">
                                <span class="feed-reaction-current-emoji">@GetReactionEmoji(post.ViewerReactionType)</span>
                                @GetReactionLabel(post.ViewerReactionType)
                            </button>
                        </div>
                        <button class="feed-actionbar-btn" @onclick="() => ToggleComments(post.Id)">
                            <i class="bi bi-chat"></i> Comment
                        </button>
                    </div>
                }
                @if (_openReactionPickerPostId.HasValue)
                {
                    <div class="feed-reaction-backdrop" @onclick="() => _openReactionPickerPostId = null"></div>
                }
                @if (_expandedPostId == post.Id)
                {
                    <div class="feed-comments">
                        @if (_comments.TryGetValue(post.Id, out var comments))
                        {
                            @foreach (var c in comments)
                            {
                                <div class="feed-comment">
                                    <a href="@($"/profile/{c.UserId}")" class="feed-avatar-link" title="View profile">
                                        <img src="@AvatarUrl(c.UserId)" crossorigin="anonymous" alt="" class="feed-comment-avatar avatar-img"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="feed-comment-avatar" style="display:none;">@GetInitials(c.AuthorName)</div>
                                    </a>
                                    <div class="feed-comment-body">
                                        <div class="feed-comment-meta">
                                            <span class="feed-comment-author">@c.AuthorName</span>
                                            @if (c.CanEdit && _editingCommentId != c.Id)
                                            {
                                                <button class="feed-comment-edit-btn" title="Edit comment" @onclick="() => StartEditComment(c)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            }
                                            @if (c.CanDelete)
                                            {
                                                <button class="feed-comment-delete-btn" title="Delete comment"
                                                        @onclick="() => RequestDeleteComment(post.Id, c.Id)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(c.AuthorPosition) || !string.IsNullOrWhiteSpace(c.AuthorRegion))
                                        {
                                            <div class="feed-comment-subtitle">
                                                @if (!string.IsNullOrWhiteSpace(c.AuthorPosition))
                                                {
                                                    <span>@c.AuthorPosition</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(c.AuthorPosition) && !string.IsNullOrWhiteSpace(c.AuthorRegion))
                                                {
                                                    <span class="feed-dot">&middot;</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(c.AuthorRegion))
                                                {
                                                    <span>@c.AuthorRegion</span>
                                                }
                                            </div>
                                        }
                                        @if (_editingCommentId == c.Id)
                                        {
                                            <div class="feed-comment-edit-box">
                                                <textarea class="feed-comment-edit-textarea" @bind="_editCommentContent" maxlength="1000"></textarea>
                                                <div class="feed-comment-edit-actions">
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEditComment">Cancel</button>
                                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveEditCommentAsync(post.Id, c.Id)" disabled="@_isSavingCommentEdit">
                                                        @(_isSavingCommentEdit ? "Saving..." : "Save")
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="feed-comment-text">
                                                @c.Content
                                                @if (c.EditedAt.HasValue)
                                                {
                                                    <span class="feed-comment-edited-tag">(edited)</span>
                                                }
                                            </p>
                                        }
                                        <span class="feed-comment-time">@c.CreatedAt.ToLocalTime().ToString("MMM dd, h:mm tt")</span>
                                    </div>
                                </div>
                            }
                        }

                        @if (_isAuthenticated)
                        {
                            <div class="feed-comment-input-row">
                                <input class="form-control form-control-sm" placeholder="Write a comment..."
                                       value="@GetCommentDraft(post.Id)"
                                       @oninput="e => _newCommentContent[post.Id] = e.Value?.ToString() ?? string.Empty"
                                       @onkeydown="e => HandleCommentKeydown(e, post.Id)" />
                                <button class="btn btn-sm btn-primary feed-send-btn" title="Send"
                                        @onclick="() => SubmitCommentAsync(post.Id)">
                                    <i class="bi bi-send-fill"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted" style="font-size:12px;">Sign in to comment.</p>
                        }
                    </div>
                }
            </div>
        }

        @if (_hasMore)
        {
            <div class="text-center my-3">
                <button class="btn btn-outline-primary btn-sm" @onclick="LoadMoreAsync" disabled="@_isLoading">
                    @(_isLoading ? "Loading..." : "Load more")
                </button>
            </div>
        }
    }
</div>

@if (_isAuthenticated)
{
    <aside class="feed-birthday-sidebar">
        <div class="birthday-widget">

            @* Single persistent header — clickable to collapse/expand once the
               feed layout stacks into one column (narrow window/mobile); a
               plain header on wide desktop layouts, same as before. *@
            <div class="birthday-widget-header birthday-widget-header--clickable" @onclick="() => _birthdayExpanded = !_birthdayExpanded">
                <i class="bi bi-gift-fill"></i>
                <span class="flex-grow-1">Upcoming Birthdays</span>
                @if (TodaysBirthdays.Any())
                {
                    <span class="birthday-widget-today-badge">@TodaysBirthdays.Count() today</span>
                }
                <i class="bi @(_birthdayExpanded ? "bi-chevron-up" : "bi-chevron-down") birthday-widget-chevron"></i>
            </div>

            <div class="birthday-widget-body @(_birthdayExpanded ? "" : "birthday-widget-body--collapsed")">
                @if (!_upcomingBirthdays.Any())
                {
                    <div class="birthday-widget-empty">
                        <i class="bi bi-calendar-heart"></i>
                        <p>No upcoming birthdays this week.</p>
                    </div>
                }

                @{ var todays = TodaysBirthdays.ToList(); }
                @if (todays.Any())
                {
                    <div class="birthday-hero">
                        <div class="birthday-hero-confetti">🎉 🎈 🎂 🎈 🎉</div>
                        <div class="birthday-hero-title">
                            Happy Birthday@(todays.Count == 1 ? "" : "s")!
                        </div>
                        @foreach (var b in todays)
                        {
                            <a href="@($"/profile/{b.UserId}")" class="birthday-hero-person" title="View profile">
                                <img src="@AvatarUrl(b.UserId)" crossorigin="anonymous" alt="" class="birthday-hero-avatar avatar-img"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="birthday-hero-avatar birthday-hero-avatar-fallback" style="display:none;">@GetInitials(b.FullName)</div>
                                <div class="birthday-hero-name">@b.FullName</div>
                                @if (!string.IsNullOrWhiteSpace(b.Position))
                                {
                                    <div class="birthday-hero-position">@b.Position</div>
                                }
                                <div class="birthday-hero-age">Turning @b.TurningAge today 🎂</div>
                            </a>
                        }
                    </div>
                }

                @{ var later = LaterBirthdays.OrderBy(b => b.DaysUntil).ToList(); }
                @if (later.Any())
                {
                    <div class="birthday-widget-list">
                        @foreach (var b in later)
                        {
                            <a href="@($"/profile/{b.UserId}")" class="birthday-card" title="View profile">
                                <img src="@AvatarUrl(b.UserId)" crossorigin="anonymous" alt="" class="birthday-avatar avatar-img"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="birthday-avatar birthday-avatar-fallback" style="display:none;">@GetInitials(b.FullName)</div>
                                <div class="birthday-info">
                                    <div class="birthday-name">@b.FullName</div>
                                    @if (!string.IsNullOrWhiteSpace(b.Position) || !string.IsNullOrWhiteSpace(b.RegionName))
                                    {
                                        <div class="birthday-meta">
                                            @b.Position
                                            @if (!string.IsNullOrWhiteSpace(b.Position) && !string.IsNullOrWhiteSpace(b.RegionName))
                                            {
                                                <span> · </span>
                                            }
                                            @b.RegionName
                                        </div>
                                    }
                                </div>
                                <div class="birthday-badge">
                                    @b.BirthDate.ToString("MMM dd")<br />
                                    <span class="birthday-badge-days">in @b.DaysUntil day@(b.DaysUntil == 1 ? "" : "s")</span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div> 

        @if (!_isFocal)
        {
        @* Personal staff productivity tool — not part of Focal's
           intentionally minimal view/comment/like/share-only feed access. ── *@
        <div class="sticky-notes-widget" @onclick:stopPropagation="true">
            <div class="notes-widget-header notes-widget-header--clickable" @onclick="() => _notesExpanded = !_notesExpanded">
                <div class="notes-widget-title"><i class="bi bi-stickies-fill"></i><span>My Sticky Notes</span></div>
                <div class="notes-widget-header-actions">
                    <div class="notes-widget-add-wrap" @onclick:stopPropagation="true">
                        <button class="notes-add-btn" @onclick="OpenCreateNote" title="New note">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <i class="bi @(_notesExpanded ? "bi-chevron-up" : "bi-chevron-down") notes-widget-chevron"></i>
                </div>
            </div>

            <div class="notes-widget-body @(_notesExpanded ? "" : "notes-widget-body--collapsed")">
                <div class="notes-widget-filters">
                    <input type="text" class="notes-search-input" placeholder="Search notes..."
                           value="@_notesSearchTerm" @oninput="e => _notesSearchTerm = e.Value?.ToString() ?? string.Empty" />
                </div>

                <div class="notes-widget-list">
                    @if (_notesLoading)
                    {
                        <div class="notes-widget-empty"><span class="spinner-border spinner-border-sm"></span></div>
                    }
                    else if (!FilteredNotes.Any())
                    {
                        <div class="notes-widget-empty">
                            <i class="bi bi-journal-plus"></i>
                            <p>@(_notes.Any() ? "No notes match your filter." : "No notes yet — click + to add one.")</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var note in FilteredNotes)
                        {
                                <div class="sticky-note-card sticky-note--@note.Color sticky-note-card--clickable" @onclick="() => OpenEditNote(note)">
                                    <div class="sticky-note-top">
                                        <div class="sticky-note-title text-truncate" title="@note.Title">@note.Title</div>
                                        <div class="sticky-note-actions" @onclick:stopPropagation="true">
                                            @if (_confirmDeleteNoteId == note.Id)
                                            {
                                                <button class="sticky-note-icon-btn sticky-note-icon-btn--danger" title="Confirm delete" @onclick="() => ConfirmDeleteNoteAsync(note.Id)">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                                <button class="sticky-note-icon-btn" title="Cancel" @onclick="CancelDeleteNote">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="sticky-note-icon-btn sticky-note-icon-btn--danger" title="Delete" @onclick="() => AskDeleteNote(note.Id)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    @{ var noteLines = ParseNoteLines(note.Content); }
                                    @if (noteLines.Count > 0)
                                    {
                                        <div class="sticky-note-lines">
                                            @foreach (var line in noteLines)
                                            {
                                                @if (line.Kind == NoteLineKind.Checklist)
                                                {
                                                    <label class="sticky-note-checklist-item @(line.Checked ? "sticky-note-checklist-item--done" : "")" @onclick:stopPropagation="true">
                                                        <input type="checkbox" checked="@line.Checked" @onchange="() => ToggleContentChecklistLineAsync(note, line.LineIndex)" />
                                                        <span>@line.Text</span>
                                                    </label>
                                                }
                                                else if (line.Kind == NoteLineKind.Bullet)
                                                {
                                                    <div class="sticky-note-bullet-item">@line.Text</div>
                                                }
                                                else
                                                {
                                                    <p class="sticky-note-content-line">@line.Text</p>
                                                }
                                            }
                                        </div>
                                    }

                                    <div class="sticky-note-time">@GetRelativeNoteTime(note)</div>
                                </div>
                            }
                        }
                </div>
            </div>
        </div>
        }

    </aside>
}
</div>

@if (_lightboxImageId.HasValue)
{
    <div class="feed-lightbox-backdrop" tabindex="0" @ref="_lightboxBackdropRef"
         @onclick="CloseLightbox" @onkeydown="HandleLightboxKeydown">

        <div class="feed-lightbox-top-controls">
            <button class="feed-lightbox-icon-btn" title="Zoom out" @onclick:stopPropagation="true" @onclick="() => AdjustLightboxZoom(-0.5)" disabled="@(_lightboxZoom <= 1)">
                <i class="bi bi-zoom-out"></i>
            </button>
            <button class="feed-lightbox-icon-btn" title="Zoom in" @onclick:stopPropagation="true" @onclick="() => AdjustLightboxZoom(0.5)" disabled="@(_lightboxZoom >= MaxZoom)">
                <i class="bi bi-zoom-in"></i>
            </button>
            <button class="feed-lightbox-icon-btn" title="Close" @onclick:stopPropagation="true" @onclick="CloseLightbox">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (_lightboxZoom > 1)
        {
            <button class="feed-lightbox-zoom-reset" @onclick:stopPropagation="true" @onclick="ResetLightboxZoom">
                <i class="bi bi-zoom-out"></i> Reset
            </button>
        }

        @if (_lightboxHasPrev)
        {
            <button class="feed-lightbox-nav feed-lightbox-nav--prev" @onclick:stopPropagation="true" @onclick="() => NavigateLightbox(-1)">
                <i class="bi bi-chevron-left"></i>
            </button>
        }

        <div class="feed-lightbox-image-wrap" @onwheel="HandleLightboxWheel" @onwheel:preventDefault="true">
            <img class="feed-lightbox-image @(_lightboxZoom > 1 ? "feed-lightbox-image--zoomed" : "")"
                 style="transform-origin: @_lightboxTransformOrigin; transform: scale(@_lightboxZoom.ToString(System.Globalization.CultureInfo.InvariantCulture)) translate(@(_lightboxPanX)px, @(_lightboxPanY)px);"
                 src="@GetImageUrl(_lightboxImageId.Value, thumbnail: false)" alt="post image"
                 @ref="_lightboxImageRef"
                 @onclick:stopPropagation="true" @onclick="OnLightboxImageClick"
                 @onmousedown="StartLightboxPan" @onmouseup="EndLightboxPan" @onmousemove="OnLightboxPanMove"
                 @onmouseleave="EndLightboxPan"
                 @ontouchstart="StartLightboxPanTouch" @ontouchmove="OnLightboxPanMoveTouch" @ontouchmove:preventDefault="true"
                 @ontouchend="EndLightboxPanTouchEnd" />
        </div>

        @if (_lightboxHasNext)
        {
            <button class="feed-lightbox-nav feed-lightbox-nav--next" @onclick:stopPropagation="true" @onclick="() => NavigateLightbox(1)">
                <i class="bi bi-chevron-right"></i>
            </button>
        }
    </div>
}

@if (_showDeleteModal)
{
    <div class="modal-backdrop-custom" @onclick="CancelDelete"></div>
    <div class="delete-confirm-modal">
        <h5>Delete @( _deleteTargetType == DeleteTargetType.Post ? "post" : "comment" )?</h5>
        <p class="text-muted" style="font-size:13px;">This action cannot be undone.</p>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
            <button class="btn btn-sm btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_isDeleting">
                @(_isDeleting ? "Deleting..." : "Delete")
            </button>
        </div>
    </div>
}

@* ✅ Standard Bootstrap-style modal (same pattern as MainLayout's logout
   confirm) — the custom .modal-backdrop-custom/.delete-confirm-modal pair
   collides with a same-named, higher-z-index rule in calendar.css, which is
   what caused the "solid black, modal stuck behind it" bug. This pattern
   uses its own explicit z-index and no shared class names. ── *@
@if (_showResetConfirm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.6); z-index:1085;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-warning-emphasis">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>End This Week's Season Now?
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseResetConfirm"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        @if (_seasonInfo is not null)
                        {
                            <text>Season @_seasonInfo.SeasonNumber will end immediately — everyone's rank, count, and win are snapshotted onto their profile, then Season @(_seasonInfo.SeasonNumber + 1) starts right away. </text>
                        }
                        This otherwise happens automatically every Sunday 11:59 PM and cannot be undone.
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseResetConfirm" disabled="@_isResettingSeason">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmResetSeasonAsync" disabled="@_isResettingSeason">
                        @if (_isResettingSeason)
                        {
                            <span>Resetting...</span>
                        }
                        else
                        {
                            <span>Yes, End Season Now</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Tier ladder ("the legend") — modal instead of an inline expanding
   list, so opening it doesn't push the rankings list further down the
   sidebar. ── *@
@if (_showTierInfo && _myTier is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.6); z-index:1085;" @onclick="CloseTierLadderModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-list-stars me-2"></i>Tier Ladder</h5>
                    <button type="button" class="btn-close" @onclick="CloseTierLadderModal"></button>
                </div>
                <div class="modal-body">
                    <div class="tier-ladder tier-ladder--modal">
                        @foreach (var t in TransactionTierHelper.Tiers.AsEnumerable().Reverse())
                        {
                            var v = TierVisuals.For(t.Level);
                            var isCurrent = t.Level == _myTier.TierLevel;
                            <div class="tier-ladder-row @v.CssClass @(isCurrent ? "tier-ladder-row--current" : "")">
                                <i class="bi @v.Icon"></i>
                                <span class="tier-ladder-name">@t.Name</span>
                                <span class="tier-ladder-min">@t.MinCount.ToString("N0")+</span>
                                @if (isCurrent)
                                {
                                    <i class="bi bi-star-fill tier-ladder-current-mark" title="Your current tier"></i>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_showNoteModal)
{
    <div class="modal-backdrop-custom" @onclick="RequestCloseNoteModal">
    <div class="modal-panel" style="width:420px;" @onclick:stopPropagation="true">
        <div class="modal-panel-header">
            <strong>@(_noteDraft.Id.HasValue ? "Edit" : "New") Note</strong>
            <button class="btn-close" @onclick="RequestCloseNoteModal"></button>
        </div>

        <div class="mb-2">
            <label class="form-label small fw-bold">Title</label>
            <input class="form-control" @bind="_noteDraft.Title" maxlength="150" placeholder="e.g. Payroll follow-ups" />
        </div>

        <div class="mb-2">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <label class="form-label small fw-bold mb-0">Content</label>
                <div class="note-format-toolbar">
                    <button type="button" class="note-format-btn" title="Bullet list — select lines first"
                            @onclick='() => ToggleLineFormatAsync("- ")'>
                        <i class="bi bi-list-ul"></i>
                    </button>
                    <button type="button" class="note-format-btn" title="Checklist — select lines first"
                            @onclick='() => ToggleLineFormatAsync("- [ ] ")'>
                        <i class="bi bi-check2-square"></i>
                    </button>
                </div>
            </div>
            <textarea id="@_noteContentTextareaId" class="form-control" rows="6" maxlength="4000"
                      @bind="_noteDraft.Content" placeholder="Write your note — select a line and click the bullet/checklist button above to format it..."></textarea>
            <div class="note-format-hint">Select one or more lines, then click a button above to turn them into a bullet or checklist item. Click again to undo.</div>
        </div>

        <div class="mt-3">
            <label class="form-label small fw-bold d-block">Color</label>
            <div class="note-color-swatches">
                @foreach (var color in NoteColors)
                {
                    <button type="button" class="note-color-swatch note-color-swatch--@color @(_noteDraft.Color == color ? "note-color-swatch--selected" : "")"
                            title="@color" @onclick="() => _noteDraft.Color = color"></button>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <button class="btn btn-sm btn-outline-secondary" @onclick="RequestCloseNoteModal">Cancel</button>
            <button class="btn btn-sm btn-primary" @onclick="SaveNoteAsync" disabled="@_isSavingNote">
                @(_isSavingNote ? "Saving..." : "Save")
            </button>
        </div>

        @if (_showNoteDiscardConfirm)
        {
            <div class="discard-confirm-overlay" @onclick:stopPropagation="true">
                <div class="discard-confirm-box">
                    <div class="fw-semibold mb-1">Discard unsaved changes?</div>
                    <p class="text-muted small mb-2">Your note hasn't been saved.</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelNoteDiscard">Keep editing</button>
                        <button class="btn btn-sm btn-danger" @onclick="ConfirmNoteDiscard">Discard</button>
                    </div>
                </div>
            </div>
        }
    </div>
    </div>
}


@code {
    //Reaction emoji feature properties
    private static readonly Dictionary<int, string> ReactionEmojis = new()
    {
        { 1, "👍" }, { 2, "😮" }, { 3, "❤️" }, { 4, "🎉" }
    };
    private static readonly Dictionary<int, string> ReactionLabels = new()
    {
        { 1, "Like" }, { 2, "Wow" }, { 3, "Love" }, { 4, "Celebrate" }
    };

    private string GetReactionEmoji(int? t) => t.HasValue && ReactionEmojis.TryGetValue(t.Value, out var e) ? e : "👍";
    private string GetReactionLabel(int? t) => t.HasValue && ReactionLabels.TryGetValue(t.Value, out var l) ? l : "Like";
    private string GetReactionButtonClass(int? t) => t switch
    {
        1 => "feed-actionbar-btn--like",
        2 => "feed-actionbar-btn--wow",
        3 => "feed-actionbar-btn--love",
        4 => "feed-actionbar-btn--confetti",
        _ => ""
    };

    private static List<string> GetTopReactionEmojis(ReactionSummaryDto r) =>
        new List<(int, int)> { (1, r.Like), (2, r.Wow), (3, r.Heart), (4, r.Confetti) }
            .Where(x => x.Item2 > 0).OrderByDescending(x => x.Item2).Take(3)
            .Select(x => ReactionEmojis[x.Item1]).ToList();
    private Guid? _openReactionPickerPostId;
    //Lightbox state for zooming image feature.
    private double _lightboxZoom = 1;
    private double _lightboxPanX = 0;
    private double _lightboxPanY = 0;
    private bool _isPanning;
    private double _panStartX;
    private double _panStartY;
    private double _panOriginX;
    private double _panOriginY;

    private const double ZoomStep = 1;
    private const double MaxZoom = 3;

    private const int MaxImages = 10;
    private const long MaxImageBytes = 8 * 1024 * 1024; // 8MB per image, client-side guard
    private const int PageSize = 10;

    private List<PostDto> _posts = new();
    private Dictionary<Guid, List<PostCommentDto>> _comments = new();
    private Dictionary<Guid, string> _newCommentContent = new();
    private HashSet<Guid> _viewedThisSession = new();

    private Guid? _expandedPostId;
    private string _newPostContent = string.Empty;
    private string _viewerKey = string.Empty;
    private bool _composerExpanded;

    private int _pageNumber = 1;
    private bool _hasMore = true;
    private bool _isLoading;
    private bool _isPosting;
    private bool _isAuthenticated;

    // ── Edit state ──────────────────────────────────────────────────────
    private Guid? _editingPostId;
    private string _editContent = string.Empty;
    private bool _isSavingEdit;
    private List<PostImageDto> _editingImages = new();
    private List<SelectedImage> _editNewImages = new();

    // ── Image selection (composer) ──────────────────────────────────────
    private class SelectedImage
    {
