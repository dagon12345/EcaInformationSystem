@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@implements IAsyncDisposable
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject PostsClientService PostsClient
@inject IConfiguration Configuration

<div class="feed-container">

    <div class="feed-header">
        <div class="feed-header-icon"><i class="bi bi-heart-fill"></i></div>
        <div>
            <div class="feed-header-title">News Feed</div>
            <div class="feed-header-subtitle">Updates from NCSC Caraga Region</div>
        </div>
    </div>

    @if (_isAuthenticated)
    {
        <div class="feed-composer">
            <div class="feed-avatar feed-avatar--sm">U</div>
            <div class="feed-composer-input-wrap">
                <textarea class="feed-composer-textarea" rows="1" placeholder="Share an update..."
                          value="@_newPostContent" maxlength="2000"
                          @onfocus="() => _composerExpanded = true"
                          @oninput="OnComposerInput"
                          @ref="_composerTextareaRef"></textarea>

                @if (_selectedImages.Any())
                {
                    <div class="feed-composer-preview-grid">
                        @for (int i = 0; i < _selectedImages.Count; i++)
                        {
                            var index = i;
                            <div class="feed-composer-preview-item">
                                <img src="@_selectedImages[index].PreviewDataUrl" alt="preview" />
                                <button type="button" class="feed-composer-preview-remove" @onclick="() => RemoveSelectedImage(index)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="feed-composer-preview-count">@_selectedImages.Count / @MaxImages photos selected</div>
                }

                @if (_composerExpanded || !string.IsNullOrWhiteSpace(_newPostContent) || _selectedImages.Any())
                {
                    <div class="feed-composer-actions">
                        <InputFile OnChange="OnImagesSelected" multiple accept="image/*" class="feed-composer-file-input" id="feedImageInput" />
                        <label for="feedImageInput" class="btn btn-sm btn-outline-secondary feed-composer-image-btn">
                            <i class="bi bi-image"></i> Photo
                        </label>
                        <div class="flex-grow-1"></div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CollapseComposer">Cancel</button>
                        <button class="btn btn-sm btn-primary" @onclick="SubmitPostAsync"
                                disabled="@(_isPosting || (string.IsNullOrWhiteSpace(_newPostContent) && !_selectedImages.Any()))">
                            @(_isPosting ? "Posting..." : "Post")
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    @if (_isLoading && !_posts.Any())
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (!_posts.Any())
    {
        <div class="feed-empty">
            <i class="bi bi-inbox"></i>
            <p>No posts yet. Be the first to share an update.</p>
        </div>
    }
    else
    {
        @foreach (var post in _posts)
        {
            <div class="feed-post" @onmouseenter="() => TrackViewOnce(post.Id)">
                <div class="feed-post-header">
                    <div class="feed-avatar">@GetInitials(post.AuthorName)</div>
                    <div class="feed-post-header-text">
                        <div class="feed-post-author">@post.AuthorName</div>
                        <div class="feed-post-meta">
                            @if (!string.IsNullOrWhiteSpace(post.AuthorPosition))
                            {
                                <span>@post.AuthorPosition</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(post.AuthorPosition) && !string.IsNullOrWhiteSpace(post.AuthorRegion))
                            {
                                <span class="feed-dot">&middot;</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(post.AuthorRegion))
                            {
                                <span>@post.AuthorRegion</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(post.AuthorPosition) || !string.IsNullOrWhiteSpace(post.AuthorRegion))
                            {
                                <span class="feed-dot">&middot;</span>
                            }
                            <span>@post.CreatedAt.ToLocalTime().ToString("MMM dd 'at' h:mm tt")</span>
                        </div>
                    </div>

                    @if (post.CanDelete)
                    {
                        <div class="feed-post-header-actions">
                            @if (_editingPostId != post.Id)
                            {
                                <button class="feed-post-menu-btn" title="Edit post" @onclick="() => StartEdit(post)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            }
                            <button class="feed-post-menu-btn" title="Delete post" @onclick="() => RequestDeletePost(post.Id)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    }
                </div>

                @if (_editingPostId == post.Id)
                {
                    <div class="feed-post-edit-box">
                        <textarea class="feed-edit-textarea"
                                  value="@_editContent" maxlength="2000"
                                  @oninput="OnEditInput"
                                  @ref="_editTextareaRef"></textarea>

                        @if (_editingImages.Any())
                        {
                            <div class="feed-composer-preview-grid">
                                @foreach (var img in _editingImages)
                                {
                                    var imgId = img.Id;
                                    <div class="feed-composer-preview-item">
                                        <img src="@GetImageUrl(imgId, thumbnail: true)" alt="preview" />
                                        <button type="button" class="feed-composer-preview-remove" @onclick="() => RemoveExistingEditImage(imgId)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        @if (_editNewImages.Any())
                        {
                            <div class="feed-composer-preview-grid">
                                @for (int i = 0; i < _editNewImages.Count; i++)
                                {
                                    var index = i;
                                    <div class="feed-composer-preview-item">
                                        <img src="@_editNewImages[index].PreviewDataUrl" alt="preview" />
                                        <button type="button" class="feed-composer-preview-remove" @onclick="() => _editNewImages.RemoveAt(index)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <div class="d-flex align-items-center gap-2 mt-2">
                            <InputFile OnChange="OnEditImagesSelected" multiple accept="image/*" class="feed-composer-file-input" id="editImageInput" />
                            <label for="editImageInput" class="btn btn-sm btn-outline-secondary feed-composer-image-btn">
                                <i class="bi bi-image"></i> Add photo
                            </label>
                            <div class="flex-grow-1"></div>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                            <button class="btn btn-sm btn-primary" @onclick="() => SaveEditAsync(post)" disabled="@_isSavingEdit">
                                @(_isSavingEdit ? "Saving..." : "Save")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="feed-post-content">
                        @post.Content
                        @if (post.EditedAt.HasValue)
                        {
                            <span class="feed-post-edited-tag">(edited)</span>
                        }
                    </p>
                }

                @if (post.Images.Any() && _editingPostId != post.Id)
                {
                    <div class="feed-image-grid feed-image-grid--@Math.Min(post.Images.Count, 5)">
                        @{
                            var displayCount = Math.Min(post.Images.Count, 4);
                            var overflowCount = post.Images.Count - 4;
                        }
                        @for (int i = 0; i < displayCount; i++)
                        {
                            var img = post.Images[i];
                            var index = i;
                            var isLastTile = i == 3 && overflowCount > 0;
                            <div class="feed-image-tile" @onclick="() => OpenLightbox(post, index)">
                                <img src="@GetImageUrl(img.Id, thumbnail: true)" alt="post image" loading="lazy" />
                                @if (isLastTile)
                                {
                                    <div class="feed-image-overflow">+@overflowCount</div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_editingPostId != post.Id)
                {
                    @if (post.LikeCount > 0 || post.CommentCount > 0 || post.ViewCount > 0)
                    {
                        <div class="feed-post-stats">
                            <span class="feed-stats-left">
                                @if (post.LikeCount > 0)
                                {
                                    <span class="feed-stats-like-icon"><i class="bi bi-hand-thumbs-up-fill"></i></span>
                                    @:@post.LikeCount
                                }
                            </span>
                            <span class="feed-stats-right">
                                @if (post.CommentCount > 0)
                                {
                                    <span class="feed-stats-comment-link" @onclick="() => ToggleComments(post.Id)">
                                        @post.CommentCount comment@(post.CommentCount == 1 ? "" : "s")
                                    </span>
                                }
                                <span>@post.ViewCount view@(post.ViewCount == 1 ? "" : "s")</span>
                            </span>
                        </div>
                    }

                    <div class="feed-post-actionbar">
                        <button class="feed-actionbar-btn @(post.IsLikedByViewer ? "feed-actionbar-btn--active" : "")"
                                @onclick="() => ToggleLikeAsync(post)">
                            <i class="bi @(post.IsLikedByViewer ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up")"></i> Like
                        </button>
                        <button class="feed-actionbar-btn" @onclick="() => ToggleComments(post.Id)">
                            <i class="bi bi-chat"></i> Comment
                        </button>
                    </div>
                }

                @if (_expandedPostId == post.Id)
                {
                    <div class="feed-comments">
                        @if (_comments.TryGetValue(post.Id, out var comments))
                        {
                            @foreach (var c in comments)
                            {
                                <div class="feed-comment">
                                    <div class="feed-comment-avatar">@GetInitials(c.AuthorName)</div>
                                    <div class="feed-comment-body">
                                        <div class="feed-comment-meta">
                                            <span class="feed-comment-author">@c.AuthorName</span>
                                            @if (c.CanEdit && _editingCommentId != c.Id)
                                            {
                                                <button class="feed-comment-edit-btn" title="Edit comment" @onclick="() => StartEditComment(c)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            }
                                            @if (c.CanDelete)
                                            {
                                                <button class="feed-comment-delete-btn" title="Delete comment"
                                                        @onclick="() => RequestDeleteComment(post.Id, c.Id)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(c.AuthorPosition) || !string.IsNullOrWhiteSpace(c.AuthorRegion))
                                        {
                                            <div class="feed-comment-subtitle">
                                                @if (!string.IsNullOrWhiteSpace(c.AuthorPosition))
                                                {
                                                    <span>@c.AuthorPosition</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(c.AuthorPosition) && !string.IsNullOrWhiteSpace(c.AuthorRegion))
                                                {
                                                    <span class="feed-dot">&middot;</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(c.AuthorRegion))
                                                {
                                                    <span>@c.AuthorRegion</span>
                                                }
                                            </div>
                                        }
                                        @if (_editingCommentId == c.Id)
                                        {
                                            <div class="feed-comment-edit-box">
                                                <textarea class="feed-comment-edit-textarea" @bind="_editCommentContent" maxlength="1000"></textarea>
                                                <div class="feed-comment-edit-actions">
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEditComment">Cancel</button>
                                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveEditCommentAsync(post.Id, c.Id)" disabled="@_isSavingCommentEdit">
                                                        @(_isSavingCommentEdit ? "Saving..." : "Save")
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="feed-comment-text">
                                                @c.Content
                                                @if (c.EditedAt.HasValue)
                                                {
                                                    <span class="feed-comment-edited-tag">(edited)</span>
                                                }
                                            </p>
                                        }
                                        <span class="feed-comment-time">@c.CreatedAt.ToLocalTime().ToString("MMM dd, h:mm tt")</span>
                                    </div>
                                </div>
                            }
                        }

                        @if (_isAuthenticated)
                        {
                            <div class="feed-comment-input-row">
                                <input class="form-control form-control-sm" placeholder="Write a comment..."
                                       value="@GetCommentDraft(post.Id)"
                                       @oninput="e => _newCommentContent[post.Id] = e.Value?.ToString() ?? string.Empty"
                                       @onkeydown="e => HandleCommentKeydown(e, post.Id)" />
                                <button class="btn btn-sm btn-primary feed-send-btn" title="Send"
                                        @onclick="() => SubmitCommentAsync(post.Id)">
                                    <i class="bi bi-send-fill"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted" style="font-size:12px;">Sign in to comment.</p>
                        }
                    </div>
                }
            </div>
        }

        @if (_hasMore)
        {
            <div class="text-center my-3">
                <button class="btn btn-outline-primary btn-sm" @onclick="LoadMoreAsync" disabled="@_isLoading">
                    @(_isLoading ? "Loading..." : "Load more")
                </button>
            </div>
        }
    }
</div>

@if (_lightboxImageId.HasValue)
{
    <div class="feed-lightbox-backdrop" tabindex="0" @ref="_lightboxBackdropRef"
         @onclick="CloseLightbox" @onkeydown="HandleLightboxKeydown">

        <div class="feed-lightbox-top-controls">
            <button class="feed-lightbox-icon-btn" title="Zoom out" @onclick:stopPropagation="true" @onclick="() => AdjustLightboxZoom(-0.5)" disabled="@(_lightboxZoom <= 1)">
                <i class="bi bi-zoom-out"></i>
            </button>
            <button class="feed-lightbox-icon-btn" title="Zoom in" @onclick:stopPropagation="true" @onclick="() => AdjustLightboxZoom(0.5)" disabled="@(_lightboxZoom >= MaxZoom)">
                <i class="bi bi-zoom-in"></i>
            </button>
            <button class="feed-lightbox-icon-btn" title="Close" @onclick:stopPropagation="true" @onclick="CloseLightbox">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (_lightboxZoom > 1)
        {
            <button class="feed-lightbox-zoom-reset" @onclick:stopPropagation="true" @onclick="ResetLightboxZoom">
                <i class="bi bi-zoom-out"></i> Reset
            </button>
        }

        @if (_lightboxHasPrev)
        {
            <button class="feed-lightbox-nav feed-lightbox-nav--prev" @onclick:stopPropagation="true" @onclick="() => NavigateLightbox(-1)">
                <i class="bi bi-chevron-left"></i>
            </button>
        }

        <div class="feed-lightbox-image-wrap" @onwheel="HandleLightboxWheel" @onwheel:preventDefault="true">
            <img class="feed-lightbox-image @(_lightboxZoom > 1 ? "feed-lightbox-image--zoomed" : "")"
                 style="transform: scale(@_lightboxZoom.ToString(System.Globalization.CultureInfo.InvariantCulture)) translate(@(_lightboxPanX)px, @(_lightboxPanY)px);"
                 src="@GetImageUrl(_lightboxImageId.Value, thumbnail: false)" alt="post image"
                 @onclick:stopPropagation="true" @onclick="ToggleLightboxZoom"
                 @onmousedown="StartLightboxPan" @onmouseup="EndLightboxPan" @onmousemove="OnLightboxPanMove"
                 @onmouseleave="EndLightboxPan" />
        </div>

        @if (_lightboxHasNext)
        {
            <button class="feed-lightbox-nav feed-lightbox-nav--next" @onclick:stopPropagation="true" @onclick="() => NavigateLightbox(1)">
                <i class="bi bi-chevron-right"></i>
            </button>
        }
    </div>
}

@if (_showDeleteModal)
{
    <div class="modal-backdrop-custom" @onclick="CancelDelete"></div>
    <div class="delete-confirm-modal">
        <h5>Delete @( _deleteTargetType == DeleteTargetType.Post ? "post" : "comment" )?</h5>
        <p class="text-muted" style="font-size:13px;">This action cannot be undone.</p>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
            <button class="btn btn-sm btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_isDeleting">
                @(_isDeleting ? "Deleting..." : "Delete")
            </button>
        </div>
    </div>
}

@code {
    //Lightbox state for zooming image feature.
    private double _lightboxZoom = 1;
    private double _lightboxPanX = 0;
    private double _lightboxPanY = 0;
    private bool _isPanning;
    private double _panStartX;
    private double _panStartY;
    private double _panOriginX;
    private double _panOriginY;

    private const double ZoomStep = 1;
    private const double MaxZoom = 3;

    private const int MaxImages = 10;
    private const long MaxImageBytes = 8 * 1024 * 1024; // 8MB per image, client-side guard
    private const int PageSize = 10;

    private List<PostDto> _posts = new();
    private Dictionary<Guid, List<PostCommentDto>> _comments = new();
    private Dictionary<Guid, string> _newCommentContent = new();
    private HashSet<Guid> _viewedThisSession = new();

    private Guid? _expandedPostId;
    private string _newPostContent = string.Empty;
    private string _viewerKey = string.Empty;
    private bool _composerExpanded;

    private int _pageNumber = 1;
    private bool _hasMore = true;
    private bool _isLoading;
    private bool _isPosting;
    private bool _isAuthenticated;

    // ── Edit state ──────────────────────────────────────────────────────
    private Guid? _editingPostId;
    private string _editContent = string.Empty;
    private bool _isSavingEdit;
    private List<PostImageDto> _editingImages = new();
    private List<SelectedImage> _editNewImages = new();

    // ── Image selection (composer) ──────────────────────────────────────
    private class SelectedImage
    {
        public byte[] Data { get; set; } = default!;
        public string ContentType { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string PreviewDataUrl { get; set; } = string.Empty;
    }

    private List<SelectedImage> _selectedImages = new();

    // ── Lightbox ─────────────────────────────────────────────────────────
    private Guid? _lightboxImageId;
    private List<Guid> _lightboxImageIds = new();
    private int _lightboxIndex;
    private bool _lightboxHasPrev => _lightboxIndex > 0;
    private bool _lightboxHasNext => _lightboxIndex < _lightboxImageIds.Count - 1;

    // ── Delete confirmation ─────────────────────────────────────────────
    private enum DeleteTargetType { Post, Comment }
    private bool _showDeleteModal;
    private bool _isDeleting;
    private DeleteTargetType _deleteTargetType;
    private Guid _deleteTargetPostId;
    private Guid _deleteTargetCommentId;

    private ElementReference _composerTextareaRef;
    private ElementReference _editTextareaRef;
    private ElementReference _lightboxBackdropRef;

    private Guid? _editingCommentId;
    private string _editCommentContent = string.Empty;
    private bool _isSavingCommentEdit;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _viewerKey = await JS.InvokeAsync<string>("viewerKey.get");
        }
        catch
        {
            _viewerKey = Guid.NewGuid().ToString();
        }

        Http.DefaultRequestHeaders.Remove("X-Viewer-Key");
        Http.DefaultRequestHeaders.Add("X-Viewer-Key", _viewerKey);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        await LoadFeedAsync(reset: true);
        await ConnectRealtimeAsync();
    }
    #region Lightbox Image Zooming - Start
    private void ToggleLightboxZoom()
    {
        // Click cycles: 1x -> 2x -> 1x. Simple, predictable, no accidental double-zoom.
        _lightboxZoom = _lightboxZoom > 1 ? 1 : 2;
        if (_lightboxZoom == 1)
        {
            _lightboxPanX = 0;
            _lightboxPanY = 0;
        }
    }
    private void AdjustLightboxZoom(double delta)
    {
        _lightboxZoom = Math.Clamp(_lightboxZoom + delta, 1, MaxZoom);
        if (_lightboxZoom <= 1)
        {
            _lightboxZoom = 1;
            _lightboxPanX = 0;
            _lightboxPanY = 0;
        }
    }
    private void ResetLightboxZoom()
    {
        _lightboxZoom = 1;
        _lightboxPanX = 0;
        _lightboxPanY = 0;
    }

    private void HandleLightboxWheel(WheelEventArgs e)
    {
        var delta = e.DeltaY < 0 ? 0.25 : -0.25;
        _lightboxZoom = Math.Clamp(_lightboxZoom + delta, 1, MaxZoom);
        if (_lightboxZoom <= 1)
        {
            _lightboxZoom = 1;
            _lightboxPanX = 0;
            _lightboxPanY = 0;
        }
    }

    private void StartLightboxPan(MouseEventArgs e)
    {
        if (_lightboxZoom <= 1) return;
        _isPanning = true;
        _panStartX = e.ClientX;
        _panStartY = e.ClientY;
        _panOriginX = _lightboxPanX;
        _panOriginY = _lightboxPanY;
    }

    private void OnLightboxPanMove(MouseEventArgs e)
    {
        if (!_isPanning) return;
        // Divide by zoom so panning feels consistent regardless of zoom level
        _lightboxPanX = _panOriginX + (e.ClientX - _panStartX) / _lightboxZoom;
        _lightboxPanY = _panOriginY + (e.ClientY - _panStartY) / _lightboxZoom;
    }

    private void EndLightboxPan(MouseEventArgs e)
    {
        _isPanning = false;
    }

    private async void OpenLightbox(PostDto post, int index)
    {
        _lightboxImageIds = post.Images.OrderBy(i => i.DisplayOrder).Select(i => i.Id).ToList();
        _lightboxIndex = index;
        _lightboxImageId = _lightboxImageIds[index];
        ResetLightboxZoom();

        StateHasChanged();
        await Task.Delay(1); // let the backdrop render before focusing it
        try { await _lightboxBackdropRef.FocusAsync(); }
        catch { }
    }

    private void CloseLightbox()
    {
        _lightboxImageId = null;
        _lightboxImageIds.Clear();
    }

    private void NavigateLightbox(int delta)
    {
        var newIndex = _lightboxIndex + delta;
        if (newIndex < 0 || newIndex >= _lightboxImageIds.Count) return;
        _lightboxIndex = newIndex;
        _lightboxImageId = _lightboxImageIds[newIndex];
        ResetLightboxZoom();
    }


    #endregion Lightbox Image Zooming - End
    #region Comment Editing - Start
    private void StartEditComment(PostCommentDto comment)
    {
        _editingCommentId = comment.Id;
        _editCommentContent = comment.Content;
    }

    private void CancelEditComment()
    {
        _editingCommentId = null;
        _editCommentContent = string.Empty;
    }

    private async Task SaveEditCommentAsync(Guid postId, Guid commentId)
    {
        if (string.IsNullOrWhiteSpace(_editCommentContent)) return;
        _isSavingCommentEdit = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/posts/comments/{commentId}")
            {
                Content = JsonContent.Create(new EditCommentDto { Content = _editCommentContent })
            };
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PostCommentDto>();
                if (result != null && _comments.TryGetValue(postId, out var list))
                {
                    var existing = list.FirstOrDefault(c => c.Id == commentId);
                    if (existing != null)
                    {
                        existing.Content = result.Content;
                        existing.EditedAt = result.EditedAt;
                    }
                }
                CancelEditComment();
            }
        }
        finally
        {
            _isSavingCommentEdit = false;
        }
    }

    private void OnCommentEdited(Guid postId, Guid commentId, string content, DateTime? editedAt)
    {
        if (_comments.TryGetValue(postId, out var list))
        {
            var existing = list.FirstOrDefault(c => c.Id == commentId);
            if (existing != null && _editingCommentId != commentId)
            {
                existing.Content = content;
                existing.EditedAt = editedAt;
                InvokeAsync(StateHasChanged);
            }
        }
    }
    #endregion Comment Editing - End
    private void HandleLightboxKeydown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowLeft":
                NavigateLightbox(-1);
                break;
            case "ArrowRight":
                NavigateLightbox(1);
                break;
            case "Escape":
                CloseLightbox();
                break;
        }
    }
    private async Task OnComposerInput(ChangeEventArgs e)
    {
        _newPostContent = e.Value?.ToString() ?? string.Empty;
        _composerExpanded = true;
        try { await JS.InvokeVoidAsync("feedInterop.autoGrow", _composerTextareaRef); }
        catch { }
    }

    private async Task OnEditInput(ChangeEventArgs e)
    {
        _editContent = e.Value?.ToString() ?? string.Empty;
        try { await JS.InvokeVoidAsync("feedInterop.autoGrow", _editTextareaRef); }
        catch { }
    }

    private async Task ConnectRealtimeAsync()
    {
        PostsClient.PostCreated += OnPostCreated;
        PostsClient.PostDeleted += OnPostDeleted;
        PostsClient.LikeUpdated += OnLikeUpdated;
        PostsClient.ViewUpdated += OnViewUpdated;
        PostsClient.CommentAdded += OnCommentAdded;
        PostsClient.CommentDeleted += OnCommentDeleted;
        PostsClient.PostEdited += OnPostEdited;
        PostsClient.CommentEdited += OnCommentEdited;

        try
        {
            var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
            var hubUrl = new Uri(new Uri(apiBase), "postsHub").ToString();
            await PostsClient.ConnectAsync(hubUrl);
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        PostsClient.PostCreated -= OnPostCreated;
        PostsClient.PostDeleted -= OnPostDeleted;
        PostsClient.LikeUpdated -= OnLikeUpdated;
        PostsClient.ViewUpdated -= OnViewUpdated;
        PostsClient.CommentAdded -= OnCommentAdded;
        PostsClient.CommentDeleted -= OnCommentDeleted;
        PostsClient.PostEdited -= OnPostEdited;
        PostsClient.CommentEdited -= OnCommentEdited;
        await Task.CompletedTask;
    }

    private void OnPostCreated(PostDto post)
    {
        if (_posts.Any(p => p.Id == post.Id)) return;
        _posts.Insert(0, post);
        _newCommentContent.TryAdd(post.Id, string.Empty);
        InvokeAsync(StateHasChanged);
    }

    private void OnPostDeleted(Guid postId)
    {
        _posts.RemoveAll(p => p.Id == postId);
        _comments.Remove(postId);
        InvokeAsync(StateHasChanged);
    }

    private void OnLikeUpdated(Guid postId, int likeCount)
    {
        var post = _posts.FirstOrDefault(p => p.Id == postId);
        if (post != null) { post.LikeCount = likeCount; InvokeAsync(StateHasChanged); }
    }

    private void OnViewUpdated(Guid postId, int viewCount)
    {
        var post = _posts.FirstOrDefault(p => p.Id == postId);
        if (post != null) { post.ViewCount = viewCount; InvokeAsync(StateHasChanged); }
    }

    private void OnCommentAdded(Guid postId, PostCommentDto comment)
    {
        var post = _posts.FirstOrDefault(p => p.Id == postId);
        if (post == null) return;

        if (_comments.TryGetValue(postId, out var list))
        {
            if (!list.Any(c => c.Id == comment.Id))
            {
                list.Add(comment);
                post.CommentCount = list.Count;
            }
        }
        else
        {
            post.CommentCount++;
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnCommentDeleted(Guid postId, Guid commentId)
    {
        var post = _posts.FirstOrDefault(p => p.Id == postId);
        if (_comments.TryGetValue(postId, out var list))
        {
            var removed = list.RemoveAll(c => c.Id == commentId);
            if (post != null && removed > 0) post.CommentCount = list.Count;
        }
        else if (post != null)
        {
            post.CommentCount = Math.Max(0, post.CommentCount - 1);
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnPostEdited(Guid postId, string content, DateTime? editedAt, List<PostImageDto> images)
    {
        var post = _posts.FirstOrDefault(p => p.Id == postId);
        if (post != null && _editingPostId != postId) // don't clobber if this client is mid-edit
        {
            post.Content = content;
            post.EditedAt = editedAt;
            post.Images = images;
            InvokeAsync(StateHasChanged);
        }
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string GetCommentDraft(Guid postId)
        => _newCommentContent.TryGetValue(postId, out var val) ? val : string.Empty;

    private async Task HandleCommentKeydown(KeyboardEventArgs e, Guid postId)
    {
        if (e.Key == "Enter")
            await SubmitCommentAsync(postId);
    }

    private async Task LoadFeedAsync(bool reset)
    {
        _isLoading = true;
        if (reset) { _pageNumber = 1; _posts.Clear(); }
        StateHasChanged();

        try
        {
            var result = await Http.GetFromJsonAsync<PagedResultDto<PostDto>>(
                $"api/posts/feed?pageNumber={_pageNumber}&pageSize={PageSize}");

            if (result != null)
            {
                _posts.AddRange(result.Items);
                _hasMore = _posts.Count < result.TotalCount;

                foreach (var post in result.Items)
                    _newCommentContent.TryAdd(post.Id, string.Empty);
            }
        }
        catch { }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        _pageNumber++;
        await LoadFeedAsync(reset: false);
    }

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(MaxImages))
        {
            if (_selectedImages.Count >= MaxImages) break;
            if (file.Size > MaxImageBytes) continue; // silently skip oversized — could surface a toast if you want

            using var stream = file.OpenReadStream(MaxImageBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            _selectedImages.Add(new SelectedImage
            {
                Data = bytes,
                ContentType = file.ContentType,
                FileName = file.Name,
                PreviewDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}"
            });
        }
        _composerExpanded = true;
        StateHasChanged();
    }

    private void RemoveSelectedImage(int index)
    {
        _selectedImages.RemoveAt(index);
    }

    private void CollapseComposer()
    {
        _composerExpanded = false;
        _newPostContent = string.Empty;
        _selectedImages.Clear();
    }

    private async Task SubmitPostAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPostContent) && !_selectedImages.Any()) return;
        _isPosting = true;
        try
        {
            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(_newPostContent ?? string.Empty), "content");

            foreach (var img in _selectedImages)
            {
                var byteContent = new ByteArrayContent(img.Data);
                byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(img.ContentType) ? "application/octet-stream" : img.ContentType);
                form.Add(byteContent, "images", img.FileName);
            }

            var response = await Http.PostAsync("api/posts", form);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<PostDto>();
                if (created != null)
                {
                    // If the SignalR broadcast already inserted this post (with
                    // CanDelete=false, since it's meant for OTHER viewers), replace
                    // it with the authoritative HTTP response instead of skipping.
                    var existingIndex = _posts.FindIndex(p => p.Id == created.Id);
                    if (existingIndex >= 0)
                    {
                        _posts[existingIndex] = created;
                    }
                    else
                    {
                        _posts.Insert(0, created);
                    }
                    _newCommentContent.TryAdd(created.Id, string.Empty);
                }
                _newPostContent = string.Empty;
                _selectedImages.Clear();
                _composerExpanded = false;
            }
        }
        finally
        {
            _isPosting = false;
        }
    }
    private async void StartEdit(PostDto post)
    {
        _editingPostId = post.Id;
        _editContent = post.Content;
        _editingImages = post.Images.ToList();
        _editNewImages.Clear();

        await Task.Delay(1); // let the textarea render first
        try { await JS.InvokeVoidAsync("feedInterop.autoGrow", _editTextareaRef); }
        catch { }
    }

    private void CancelEdit()
    {
        _editingPostId = null;
        _editContent = string.Empty;
        _editingImages.Clear();
        _editNewImages.Clear();
    }

    private void RemoveExistingEditImage(Guid imageId)
    {
        _editingImages.RemoveAll(i => i.Id == imageId);
    }

    private async Task OnEditImagesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(MaxImages))
        {
            if (_editingImages.Count + _editNewImages.Count >= MaxImages) break;
            if (file.Size > MaxImageBytes) continue;

            using var stream = file.OpenReadStream(MaxImageBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            _editNewImages.Add(new SelectedImage
            {
                Data = bytes,
                ContentType = file.ContentType,
                FileName = file.Name,
                PreviewDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}"
            });
        }
        StateHasChanged();
    }

    private async Task SaveEditAsync(PostDto post)
    {
        if (string.IsNullOrWhiteSpace(_editContent) && !_editingImages.Any() && !_editNewImages.Any()) return;
        _isSavingEdit = true;
        try
        {
            var removedIds = post.Images
                .Where(orig => !_editingImages.Any(kept => kept.Id == orig.Id))
                .Select(i => i.Id.ToString());

            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(_editContent ?? string.Empty), "content");
            form.Add(new StringContent(string.Join(",", removedIds)), "removeImageIds");

            foreach (var img in _editNewImages)
            {
                var byteContent = new ByteArrayContent(img.Data);
                byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(img.ContentType) ? "application/octet-stream" : img.ContentType);
                form.Add(byteContent, "newImages", img.FileName);
            }

            var request = new HttpRequestMessage(HttpMethod.Put, $"api/posts/{post.Id}") { Content = form };
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PostDto>();
                if (result != null)
                {
                    post.Content = result.Content;
                    post.EditedAt = result.EditedAt;
                    post.Images = result.Images;
                }
                CancelEdit();
            }
        }
        finally
        {
            _isSavingEdit = false;
        }
    }

    private async Task ToggleLikeAsync(PostDto post)
    {
        post.IsLikedByViewer = !post.IsLikedByViewer;
        post.LikeCount += post.IsLikedByViewer ? 1 : -1;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync($"api/posts/{post.Id}/like", null);
            var result = await response.Content.ReadFromJsonAsync<LikeToggleResultDto>();
            if (result != null)
            {
                post.IsLikedByViewer = result.IsLiked;
                post.LikeCount = result.LikeCount;
            }
        }
        catch { }
    }

    private async Task TrackViewOnce(Guid postId)
    {
        if (_viewedThisSession.Contains(postId)) return;
        _viewedThisSession.Add(postId);
        try { await Http.PostAsync($"api/posts/{postId}/view", null); }
        catch { }
    }

    private async Task ToggleComments(Guid postId)
    {
        if (_expandedPostId == postId)
        {
            _expandedPostId = null;
            return;
        }

        _expandedPostId = postId;
        if (!_comments.ContainsKey(postId))
        {
            var result = await Http.GetFromJsonAsync<PagedResultDto<PostCommentDto>>(
                $"api/posts/{postId}/comments?pageNumber=1&pageSize=50");
            _comments[postId] = result?.Items?.ToList() ?? new();
        }
    }

    private async Task SubmitCommentAsync(Guid postId)
    {
        if (!_newCommentContent.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
            return;

        var response = await Http.PostAsJsonAsync($"api/posts/{postId}/comments", new CreateCommentDto { Content = content });
        if (response.IsSuccessStatusCode)
        {
            var created = await response.Content.ReadFromJsonAsync<PostCommentDto>();
            if (created != null)
            {
                if (!_comments.ContainsKey(postId)) _comments[postId] = new();

                // ✅ FIX — replace the broadcast-inserted copy (CanDelete=false) with
                // the authoritative HTTP response (CanDelete=true), instead of skipping
                // when it's already present.
                var existingIndex = _comments[postId].FindIndex(c => c.Id == created.Id);
                if (existingIndex >= 0)
                {
                    _comments[postId][existingIndex] = created;
                }
                else
                {
                    _comments[postId].Add(created);
                }
                var post = _posts.FirstOrDefault(p => p.Id == postId);
                if (post != null) post.CommentCount = _comments[postId].Count;
            }
            _newCommentContent[postId] = string.Empty;
        }
    }

    private string GetImageUrl(Guid imageId, bool thumbnail)
    {
        var apiBase = Http.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
        return thumbnail ? $"{apiBase}/api/posts/images/{imageId}/thumb" : $"{apiBase}/api/posts/images/{imageId}";
    }

    private void RequestDeletePost(Guid postId)
    {
        _deleteTargetType = DeleteTargetType.Post;
        _deleteTargetPostId = postId;
        _showDeleteModal = true;
    }

    private void RequestDeleteComment(Guid postId, Guid commentId)
    {
        _deleteTargetType = DeleteTargetType.Comment;
        _deleteTargetPostId = postId;
        _deleteTargetCommentId = commentId;
        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        if (_isDeleting) return;
        _showDeleteModal = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        _isDeleting = true;
        try
        {
            if (_deleteTargetType == DeleteTargetType.Post)
                await DeletePostAsync(_deleteTargetPostId);
            else
                await DeleteCommentAsync(_deleteTargetPostId, _deleteTargetCommentId);
        }
        finally
        {
            _isDeleting = false;
            _showDeleteModal = false;
        }
    }

    private async Task DeletePostAsync(Guid postId)
    {
        var response = await Http.DeleteAsync($"api/posts/{postId}");
        if (response.IsSuccessStatusCode)
        {
            _posts.RemoveAll(p => p.Id == postId);
            _comments.Remove(postId);
        }
    }

    private async Task DeleteCommentAsync(Guid postId, Guid commentId)
    {
        var response = await Http.DeleteAsync($"api/posts/comments/{commentId}");
        if (response.IsSuccessStatusCode)
        {
            if (_comments.TryGetValue(postId, out var list))
                list.RemoveAll(c => c.Id == commentId);

            var post = _posts.FirstOrDefault(p => p.Id == postId);
            if (post != null) post.CommentCount = Math.Max(0, post.CommentCount - 1);
        }
    }

