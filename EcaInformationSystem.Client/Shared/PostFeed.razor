    // ── Live leaderboard ─────────────────────────────────────────────────
    private HashSet<string> _recentlyUpdatedUserNames = new();
    // Rank moved up (overtook someone) vs. moved down (got overtaken) —
    // separate from _recentlyUpdatedUserNames (count pulse) so an "overtake"
    // gets its own distinct climb/drop effect instead of just the count glow.
    private HashSet<string> _rankedUpUserNames = new();
    private HashSet<string> _rankedDownUserNames = new();
    // How much a row's count just went up by — drives the floating "+N" badge.
    private Dictionary<string, int> _deltaByUserName = new(StringComparer.OrdinalIgnoreCase);

    private async Task ConnectTierRealtimeAsync()
    {
        TierHub.TransactionRecorded += OnTransactionRecorded;
        TierHub.LeaderboardReset += OnLeaderboardReset;
        try
        {
            var apiBase = Configuration["ApiBaseUrl"] ?? "https://REDACTED_INTERNAL_IP:8080/";
            var hubUrl = new Uri(new Uri(apiBase), "transactionTierHub").ToString();
            await TierHub.ConnectAsync(hubUrl);
        }
        catch { /* non-fatal — the leaderboard still works, just without live push */ }
    }

    private void OnTransactionRecorded(string userName)
    {
        _ = InvokeAsync(async () =>
        {
            var previous = _leaderboard;
            _leaderboard = await TierClient.GetLeaderboardAsync(forceRefresh: true);

            var changed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var rankedUp = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var rankedDown = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var deltas = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (var entry in _leaderboard)
            {
                var old = previous.FirstOrDefault(p => string.Equals(p.UserName, entry.UserName, StringComparison.OrdinalIgnoreCase));
                if (old is null || old.TransactionCount != entry.TransactionCount)
                {
                    changed.Add(entry.UserName);
                    var delta = entry.TransactionCount - (old?.TransactionCount ?? 0);
                    if (delta > 0) deltas[entry.UserName] = delta;
                }

                // Only flag an actual overtake — both users need to have been
                // ranked before (a brand-new leaderboard entry isn't "overtaking"
                // anyone, it's just showing up for the first time).
                if (old is not null && old.Rank != entry.Rank)
                {
                    if (entry.Rank < old.Rank) rankedUp.Add(entry.UserName);
                    else rankedDown.Add(entry.UserName);
                }
            }

            // Own badge/progress bar (NavMenu/MainLayout/Profile) reads from the
            // same cached tier — force-refresh it too when it's our own activity.
            if (changed.Any(u => string.Equals(u, userName, StringComparison.OrdinalIgnoreCase)))
                _myTier = await TierClient.GetMyTierAsync(forceRefresh: true);

            _recentlyUpdatedUserNames = changed;
            _rankedUpUserNames = rankedUp;
            _rankedDownUserNames = rankedDown;
            _deltaByUserName = deltas;
            StateHasChanged();

            await Task.Delay(2800);
            _recentlyUpdatedUserNames = new();
            _rankedUpUserNames = new();
            _rankedDownUserNames = new();
            _deltaByUserName = new(StringComparer.OrdinalIgnoreCase);
            await InvokeAsync(StateHasChanged);
        });
    }

    // Fires for EVERY connected client when a season ends — manual reset or
    // the automatic Sunday 11:59 PM job. Refreshes the board/tier/season info
    // and celebrates the top 3 so a reset doesn't just look like the board
    // silently emptying out.
    private void OnLeaderboardReset(LeaderboardResetResultDto result)
    {
        _ = InvokeAsync(async () =>
        {
            TierClient.InvalidateAfterReset();
            _leaderboard = await TierClient.GetLeaderboardAsync(forceRefresh: true);
            _myTier = await TierClient.GetMyTierAsync(forceRefresh: true);
            _seasonInfo = await TierClient.GetSeasonInfoAsync(forceRefresh: true);

            var podium = string.Join(", ", result.TopThree.Select(t => $"#{t.Rank} {t.DisplayName}"));
            toast.ShowSuccess(
                string.IsNullOrWhiteSpace(podium)
                    ? $"Season {result.EndedSeasonNumber} ended — Season {result.NewSeasonNumber} has begun!"
                    : $"Season {result.EndedSeasonNumber} ended! Top 3: {podium}. Season {result.NewSeasonNumber} has begun!",
                "Leaderboard Reset");

            StateHasChanged();
        });
    }

