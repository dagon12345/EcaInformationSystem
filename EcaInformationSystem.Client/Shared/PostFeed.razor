    private async Task SubmitCommentAsync(Guid postId)
    {
        if (!_newCommentContent.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
            return;

        var response = await Http.PostAsJsonAsync($"api/posts/{postId}/comments", new CreateCommentDto { Content = content });
        if (response.IsSuccessStatusCode)
        {
            var created = await response.Content.ReadFromJsonAsync<PostCommentDto>();
            if (created != null)
            {
                if (!_comments.ContainsKey(postId)) _comments[postId] = new();

                // ✅ FIX — replace the broadcast-inserted copy (CanDelete=false) with
                // the authoritative HTTP response (CanDelete=true), instead of skipping
                // when it's already present.
                var existingIndex = _comments[postId].FindIndex(c => c.Id == created.Id);
                if (existingIndex >= 0)
                {
                    _comments[postId][existingIndex] = created;
                }
                else
                {
                    _comments[postId].Add(created);
                }
                var post = _posts.FirstOrDefault(p => p.Id == postId);
                if (post != null) post.CommentCount = _comments[postId].Count;
            }
            _newCommentContent[postId] = string.Empty;
        }
    }

