    private async Task SaveEditCommentAsync(Guid postId, Guid commentId)
    {
        if (string.IsNullOrWhiteSpace(_editCommentContent)) return;
        _isSavingCommentEdit = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/posts/comments/{commentId}")
            {
                Content = JsonContent.Create(new EditCommentDto { Content = _editCommentContent })
            };
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PostCommentDto>();
                if (result != null && _comments.TryGetValue(postId, out var list))
                {
                    var existing = list.FirstOrDefault(c => c.Id == commentId);
                    if (existing != null)
                    {
                        existing.Content = result.Content;
                        existing.EditedAt = result.EditedAt;
                    }
                }
                CancelEditComment();
            }
        }
        finally
        {
            _isSavingCommentEdit = false;
        }
    }

    private void OnCommentEdited(Guid postId, Guid commentId, string content, DateTime? editedAt)
    {
        if (_comments.TryGetValue(postId, out var list))
        {
            var existing = list.FirstOrDefault(c => c.Id == commentId);
            if (existing != null && _editingCommentId != commentId)
            {
                existing.Content = content;
                existing.EditedAt = editedAt;
