@code {
    // Same count-up treatment as Features' live stats panel (FeaturesArticle's
    // AnimateCountUpAsync) — these numbers are static, not fetched, so the
    // animation is purely cosmetic, but it's the same "hook the reader" trick
    // and keeps the two public pages feeling consistent.
    private record HeroStat(int Target, string Suffix, string Label);
    private readonly List<HeroStat> _heroStats = new()
    {
        new(7, "+", "Years Experience"),
        new(300, "K+", "Records Managed"),
        new(6, "M+", "Payrolls Processed"),
        new(10, "", "Systems Shipped"),
        new(5, "", "Point of Sales Sold"),
    };
    private int[] _heroStatDisplay = new int[5];

    protected override async Task OnInitializedAsync()
    {
        _heroStatDisplay = new int[_heroStats.Count];
        await AnimateHeroStatsAsync();
    }

    private async Task AnimateHeroStatsAsync()
    {
        const int steps = 30;
        const int stepDelayMs = 25;

        for (int i = 1; i <= steps; i++)
        {
            var progress = (double)i / steps;
            for (int s = 0; s < _heroStats.Count; s++)
            {
                _heroStatDisplay[s] = (int)Math.Round(_heroStats[s].Target * progress);
            }
            StateHasChanged();
            await Task.Delay(stepDelayMs);
        }

        for (int s = 0; s < _heroStats.Count; s++)
        {
            _heroStatDisplay[s] = _heroStats[s].Target;
        }
        StateHasChanged();
    }

    private bool _emailHighlighted;

    // "Email Me" no longer opens the visitor's mail client (mailto: is
    // unreliable when no desktop mail app is configured) — it scrolls down
    // to the actual address in the Contact block and flashes it instead, so
    // the visitor can read/copy it directly.
    private async Task HighlightEmailAsync()
    {
        await JS.InvokeVoidAsync("scrollInterop.scrollToElement", "dev-contact-email-gmail");

        _emailHighlighted = true;
        StateHasChanged();

        await Task.Delay(2000);

        _emailHighlighted = false;
        StateHasChanged();
    }
}
