@* DeveloperArticle.razor — portfolio/resume-style "About the Developer" page.
   Wider and louder than the plain About/Regional Offices/Officials blog
   shell (see .dev-page-body/.dev-hero-banner/.dev-content-card in
   auth-shared.css) because this page has a different job: it's the one a
   recruiter or hiring manager might actually land on, so it leads with
   impact numbers and a resume-style download/contact CTA up top instead of
   burying them at the bottom. *@
@inject IJSRuntime JS

<article class="dev-article">
    <div class="dev-hero-banner">
        <div class="dev-hero-glow dev-hero-glow--1"></div>
        <div class="dev-hero-glow dev-hero-glow--2"></div>

        <div class="dev-hero-kicker">Full Stack .NET Developer<PageViewBadge PageKey="developer" /></div>

        <img src="images/developer/profile.jpg" alt="Lance Andrei Espina" class="dev-hero-photo" />

        <h1 class="dev-hero-name">Lance Andrei Espina</h1>
        <p class="dev-hero-tagline">
            7+ years building government and enterprise systems end-to-end — from
            <strong>Accenture / IRAS (Singapore)</strong> backend engineering to designing and shipping
            full-stack platforms like <strong>ECA-InFORMS</strong> solo, on Clean Architecture with
            Blazor WebAssembly, ASP.NET Core, and SQL Server.
        </p>

        <div class="dev-hero-stats">
            @for (int i = 0; i < _heroStats.Count; i++)
            {
                var idx = i;
                <div class="dev-hero-stat">
                    <div class="dev-hero-stat-value">@_heroStatDisplay[idx]@_heroStats[idx].Suffix</div>
                    <div class="dev-hero-stat-label">@_heroStats[idx].Label</div>
                </div>
            }
        </div>

        <div class="dev-hero-cta-row">
            <a href="files/Lance_Andrei_Espina_Resume.pdf" download class="dev-hero-cta dev-hero-cta--primary">
                <i class="bi bi-file-earmark-arrow-down-fill"></i> Download Resume
            </a>
            <a href="https://www.linkedin.com/in/lance-andrei-espina-6a5a99273/" target="_blank" rel="noopener noreferrer" class="dev-hero-cta">
                <i class="bi bi-linkedin"></i> LinkedIn
            </a>
            <a href="https://github.com/dagon12345" target="_blank" rel="noopener noreferrer" class="dev-hero-cta">
                <i class="bi bi-github"></i> GitHub
            </a>
            <a href="javascript:void(0)" class="dev-hero-cta" @onclick="HighlightEmailAsync" @onclick:preventDefault>
                <i class="bi bi-envelope-fill"></i> Email Me
            </a>
        </div>
    </div>

