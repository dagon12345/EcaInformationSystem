@using EcaInformationSystem.Client.Services
@using EcaInformationSystem.Shared.DTOs
@inject DocumentUploadQueueService UploadQueue
@implements IDisposable

<div class="icon-btn-wrap" style="position:relative;">
    <button class="icon-btn" @onclick="ToggleDropdown" title="Upload queue">
        @if (_isAnyActive)
        {
            <span class="spinner-border spinner-border-sm"
                  style="width:16px;height:16px;border-width:2px;color:#3b82f6;"></span>
        }
        else
        {
            <i class="bi bi-cloud-upload"></i>
        }
        @if (_activeCount > 0)
        {
            <span class="badge bg-primary position-absolute top-0 end-0"
                  style="font-size:9px;padding:2px 5px;min-width:16px;">
                @_activeCount
            </span>
        }
    </button>

    @if (_isOpen)
    {
        <div class="duplicate-dropdown" style="min-width:320px;">
            <div class="duplicate-dropdown-header">
                <span class="fw-semibold">
                    <i class="bi bi-cloud-upload me-1"></i>Upload Queue
                </span>
                <span class="text-muted small">@_jobs.Count job(s)</span>
            </div>
            <div class="duplicate-dropdown-scroll">
                @if (!_jobs.Any())
                {
                    <div class="duplicate-dropdown-empty">
                        <i class="bi bi-check-circle text-success me-1"></i>
                        No pending uploads
                    </div>
                }
                @foreach (var job in _jobs)
                {
                    <div class="duplicate-dropdown-item @GetItemClass(job.Status)">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2">
                                @GetStatusIcon(job.Status)
                                <span class="small fw-semibold text-truncate"
                                      style="max-width:180px;" title="@job.FileName">
                                    @job.FileName
                                </span>
                            </div>
                            <div class="duplicate-dropdown-filter mt-1">
                                @GetStatusText(job)
                            </div>
                        </div>
                        @if (job.Status is UploadJobStatus.Done or UploadJobStatus.Failed)
                        {
                            <button class="duplicate-dropdown-delete-btn"
                                    @onclick="() => DismissAsync(job.JobId)"
                                    title="Dismiss">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _isOpen;
    private List<DocumentUploadJobDto> _jobs = new();
    private bool _isAnyActive;
    private int _activeCount;

    protected override void OnInitialized()
    {
        UploadQueue.OnChanged += OnQueueChanged;
        RefreshState();
    }

    private void OnQueueChanged()
    {
        RefreshState();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshState()
    {
        _jobs = UploadQueue.Jobs.ToList();
        _activeCount = UploadQueue.ActiveCount;
        _isAnyActive = _activeCount > 0;
    }

    private void ToggleDropdown() => _isOpen = !_isOpen;

    public void CloseDropdown() => _isOpen = false;

    private async Task DismissAsync(Guid jobId)
    {
        await UploadQueue.DismissCompletedAsync(jobId);
    }

    private static string GetItemClass(UploadJobStatus status) => status switch
    {
        UploadJobStatus.Done => "duplicate-dropdown-has-matches",
        UploadJobStatus.Failed => "duplicate-dropdown-error",
        UploadJobStatus.Uploading or UploadJobStatus.Retrying => "duplicate-dropdown-loading",
        _ => string.Empty
    };

    private static RenderFragment GetStatusIcon(UploadJobStatus status) => status switch
    {
    UploadJobStatus.Done => @<i class="bi bi-check-circle-fill text-success"></i>,
        UploadJobStatus.Failed => @<i class="bi bi-x-circle-fill text-danger"></i>,
        UploadJobStatus.Uploading => @<span class="spinner-border spinner-border-sm text-primary"
                                        style="width:14px;height:14px;border-width:2px;"></span>,
        UploadJobStatus.Retrying => @<i class="bi bi-arrow-repeat text-warning"></i>,
        _ => @<i class="bi bi-clock text-muted"></i>
        };

    private static string GetStatusText(DocumentUploadJobDto job) => job.Status switch
    {
        UploadJobStatus.Done => "Uploaded successfully",
        UploadJobStatus.Failed => job.ErrorMessage ?? "Permanently failed",
        UploadJobStatus.Uploading => $"Uploading... (attempt {job.AttemptCount})",
        UploadJobStatus.Retrying => job.ErrorMessage ?? "Retrying...",
        UploadJobStatus.Queued => "Waiting...",
        _ => string.Empty
    };

    public void Dispose()
    {
        UploadQueue.OnChanged -= OnQueueChanged;
    }
}