@* FeaturesArticle.razor — public "what can this system do" showcase. Deliberately
   louder than About/Regional Offices/Officials (which are calm, document-style
   pages) — this one exists to make a stranger stop scrolling, so it gets its
   own hero banner, a color per category, and hover/entrance motion. *@
@using EcaInformationSystem.Shared.DTOs
@inject HttpClient Http

<div class="features-hero">
    <div class="features-hero-glow features-hero-glow--1"></div>
    <div class="features-hero-glow features-hero-glow--2"></div>
    <div class="features-hero-glow features-hero-glow--3"></div>

    <div class="features-hero-welcome">👋 Welcome to ECA-InFORMS</div>
    <div class="features-hero-badge"><i class="bi bi-stars"></i> WHAT ECA-InFORMS CAN DO</div>
    <PageViewBadge PageKey="features" />
    <h1 class="features-hero-title">
        One system. <span class="features-hero-title-accent">Every step</span> of the ECA workflow.
    </h1>
    <p class="features-hero-lede">
        Built to replace scattered spreadsheets, paper trails, and missed hand-offs with one connected system —
        ECA-InFORMS brings grantee records, document routing, finance, attendance, and your whole team into a
        single, always-on platform trusted by the National Commission of Senior Citizens, Caraga Region.
    </p>

    <div class="features-hero-stats">
        @foreach (var stat in _stats)
        {
            <div class="features-hero-stat">
                <div class="features-hero-stat-value">@stat.Value</div>
                <div class="features-hero-stat-label">@stat.Label</div>
            </div>
        }
    </div>

    <a href="login" class="features-hero-cta">
        <i class="bi bi-box-arrow-in-right me-1"></i>Sign in to explore
    </a>

    @* Quick nav row, visible at every width — PublicNavbar's own quicklinks
       row is hidden below 760px with no hamburger/dropdown to replace it on
       this shared component (Login.razor has its own separate mobile menu,
       but Features/About/Regional Offices/Developer don't), so a phone
       visitor had no way to reach the other public pages at all. These
       mirror the same set (minus "Features" itself) and stay visible on
       desktop too so it's a permanent shortcut, not just a mobile patch —
       see .features-hero-nav-links in auth-shared.css. *@
    <div class="features-hero-nav-links">
        <a href="about" class="features-hero-nav-link"><i class="bi bi-info-circle"></i> About NCSC</a>
        <a href="regional-offices" class="features-hero-nav-link"><i class="bi bi-telephone"></i> Contact</a>
        <a href="directory-officials" class="features-hero-nav-link"><i class="bi bi-people"></i> Officials</a>
        <a href="login" class="features-hero-nav-link"><i class="bi bi-broadcast"></i> Live Feed</a>
        <a href="developer" class="features-hero-nav-link"><i class="bi bi-code-slash"></i> Developer</a>
    </div>
</div>

@* Live headline numbers, straight from the database — proof this isn't a
   mockup. Sits as a "bridge" card straddling the hero/body seam, the way a
   SaaS landing page shows off real usage numbers. Counts animate up from 0
   on load for a bit of polish; if the fetch fails, the panel just doesn't
   render (same non-fatal pattern as PageViewBadge). *@
@if (_stats2 is not null)
{
    <div class="features-scale-panel">
        <div class="features-scale-inner">
            <div class="features-scale-item">
                <div class="features-scale-icon"><i class="bi bi-person-vcard-fill"></i></div>
                <div class="features-scale-value">@_granteeCountDisplay.ToString("N0")</div>
                <div class="features-scale-label">Grantee Records Managed</div>
            </div>
            <div class="features-scale-divider"></div>
            <div class="features-scale-item">
                <div class="features-scale-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                <div class="features-scale-value">@_transactionCountDisplay.ToString("N0")</div>
                <div class="features-scale-label">Transactions Logged</div>
            </div>
            <div class="features-scale-divider"></div>
            <div class="features-scale-item">
                <div class="features-scale-icon"><i class="bi bi-camera-fill"></i></div>
                <div class="features-scale-value">@_livenessCountDisplay.ToString("N0")</div>
                <div class="features-scale-label">Liveness Verified</div>
            </div>
            <div class="features-scale-divider"></div>
            <div class="features-scale-item">
                <div class="features-scale-icon"><i class="bi bi-bank2"></i></div>
                <div class="features-scale-value">@_eftCountDisplay.ToString("N0")</div>
                <div class="features-scale-label">Ready for EFT</div>
            </div>
        </div>
        <div class="features-scale-caption"><span class="features-scale-live-dot"></span>Live counts from the database — real numbers, growing every day.</div>
    </div>
}

<div class="features-body">
    @{ var delayIndex = 0; }
    @foreach (var category in _categories)
    {
        <section class="features-category features-category--@category.Accent" style="--fx-delay:@(delayIndex++ * 0.05)s;">
            <h2 class="features-category-title">
                <span class="features-category-icon"><i class="bi @category.Icon"></i></span>
                @category.Title
            </h2>
            <p class="features-category-tagline">@category.Tagline</p>
            <div class="features-grid">
                @foreach (var feature in category.Features)
                {
                    <div class="feature-card">
                        <div class="feature-card-shine"></div>
                        <div class="feature-card-icon"><i class="bi @feature.Icon"></i></div>
                        <div class="feature-card-title">@feature.Title</div>
                        <div class="feature-card-body">@feature.Body</div>
                    </div>
                }
            </div>
        </section>
    }

    <section class="features-howto" style="--fx-delay:@(delayIndex++ * 0.05)s;">
        <h2 class="features-category-title">
            <span class="features-category-icon"><i class="bi bi-camera-fill"></i></span>
            How the Liveness Verification Link Works
        </h2>
        <p class="features-category-tagline">A quick proof-of-life check the grantee completes on their own phone — no office visit needed.</p>

        <div class="features-howto-steps">
            <div class="features-howto-step">
                <div class="features-howto-step-num">1</div>
                <div class="features-howto-step-title">PDO generates the link</div>
                <div class="features-howto-step-body">From a grantee's record, click <strong>Generate Liveness Link</strong> and copy/share it with the grantee (chat, SMS, etc.). Only one link exists per grantee at a time.</div>
            </div>
            <div class="features-howto-step">
                <div class="features-howto-step-num">2</div>
                <div class="features-howto-step-title">Grantee opens it and confirms</div>
                <div class="features-howto-step-body">The link opens a simple page showing the grantee's name, birthdate, and address so they can confirm it's their own record — no login required.</div>
            </div>
            <div class="features-howto-step">
                <div class="features-howto-step-num">3</div>
                <div class="features-howto-step-title">Live photo only, timestamped</div>
                <div class="features-howto-step-body">The grantee takes a photo using their camera right there — uploading an existing picture isn't allowed. The photo is compressed automatically and the date/time is stamped directly onto it.</div>
            </div>
            <div class="features-howto-step">
                <div class="features-howto-step-num">4</div>
                <div class="features-howto-step-title">PDO reviews and verifies</div>
                <div class="features-howto-step-body">Once submitted, the PDO (or Admin) opens the photo from the grantee's record and either <strong>Verifies</strong> it — marking the grantee's liveness as confirmed — or <strong>Rejects</strong> it and generates a fresh link for a retake.</div>
            </div>
        </div>
    </section>

    <div class="features-article-cta">
        <div class="features-article-cta-glow"></div>
        <p>Ready to see it in action?</p>
        <a href="login" class="features-article-cta-btn"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in to get started</a>
    </div>
</div>

@code {
    private record Stat(string Value, string Label);
    private record Feature(string Icon, string Title, string Body);
    private record FeatureCategory(string Icon, string Title, string Accent, string Tagline, List<Feature> Features);

    private readonly List<Stat> _stats = new()
    {
        new("9", "Team Roles"),
        new("24/7", "Live Updates"),
        new("100%", "Paperless Trail"),
    };

    private PublicSystemStatsDto? _stats2;
    private int _granteeCountDisplay;
    private int _transactionCountDisplay;
    private int _livenessCountDisplay;
    private int _eftCountDisplay;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stats2 = await Http.GetFromJsonAsync<PublicSystemStatsDto>("api/public-system-stats");
            if (_stats2 is not null)
            {
                _ = AnimateCountUpAsync();
            }
        }
        catch
        {
            // Non-fatal — the panel just doesn't render if this fails.
        }
    }

    private async Task AnimateCountUpAsync()
    {
        const int steps = 30;
        const int stepDelayMs = 25;

        for (int i = 1; i <= steps; i++)
        {
            var progress = (double)i / steps;
            _granteeCountDisplay = (int)Math.Round(_stats2!.GranteeCount * progress);
            _transactionCountDisplay = (int)Math.Round(_stats2!.TransactionCount * progress);
            _livenessCountDisplay = (int)Math.Round(_stats2!.LivenessVerifiedCount * progress);
            _eftCountDisplay = (int)Math.Round(_stats2!.ReadyForEftCount * progress);
            StateHasChanged();
            await Task.Delay(stepDelayMs);
        }

        _granteeCountDisplay = _stats2!.GranteeCount;
        _transactionCountDisplay = _stats2!.TransactionCount;
        _livenessCountDisplay = _stats2!.LivenessVerifiedCount;
        _eftCountDisplay = _stats2!.ReadyForEftCount;
        StateHasChanged();
    }

