<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- ✅ stdoutLogEnabled temporarily on — the site is failing with
           HTTP 500.30 "ASP.NET Core app failed to start" and stdout
           logging was off, so the actual startup exception was never
           captured anywhere. Once the crash is diagnosed, flip this back
           to "false" (logs otherwise grow unbounded on the host). -->
      <aspNetCore processPath="dotnet" arguments=".\EcaInformationSystem.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
